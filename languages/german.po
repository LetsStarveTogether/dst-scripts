#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORGRASS"
msgid "Not at all useful."
msgstr "Überhaupt nicht nützlich."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORMARBLE"
msgid "Protects your inner workings."
msgstr "Schützt dein Innenleben."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORRUINS"
msgid "Not a bad piece of work."
msgstr "Keine schlechte Arbeit."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSKELETON"
msgid "A bit creepy, isn't it?"
msgstr "Ein bisschen gruselig, oder?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSLURPER"
msgid "So tight I barely remember the gnawing hunger!"
msgstr "So eng, dass man fast den Hunger vergisst!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSNURTLESHELL"
msgid "Go ahead, give'it a punch."
msgstr "Na los. Schlag zu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWOOD"
msgid "Punch me! It does nothing! Ha!"
msgstr "Schlag mich! Macht mir nichts aus! Ha!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_SANITY"
msgid "Soothingly unsettling."
msgstr "Wie beunruhigend."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Burnt to cinders."
msgstr "Total verbrannt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "I'll take this as a sign."
msgstr "Das deute ich als ein Zeichen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "Ich warte nur auf ein paar Zeilen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Burnt to cinders."
msgstr "Total verbrannt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "I'll take this as a sign."
msgstr "Das deute ich als ein Zeichen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "Ich warte nur auf ein paar Zeilen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.GENERIC"
msgid "Sooty."
msgstr "Rußig."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Burnt up eye stick."
msgstr "Angebrannter Augenstab."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "Burnt bits of big ol' buzzer."
msgstr "Verbrannte Überreste von dem Glommerding."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "That was a... Y'know! A thing."
msgstr "Weißt du, was das war? Ein Dings."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It's gearing up for something."
msgstr "Da ist etwas im Gange."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It won't be running again for awhile."
msgstr "Es wird eine Weile nicht mehr laufen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "I don't think we oughta be here when it goes off!"
msgstr "Ich glaube, wir sollten nicht hier sein, wenn das explodiert!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Oughta turn on somehow."
msgstr "Sollte sich irgendwie einschalten lassen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.ON"
msgid "Not sure I trust strange portals anymore."
msgstr "Ich glaube, ich traue fremden Portalen nicht mehr."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_KEY"
msgid "Some sort of old power source."
msgstr "Irgendeine alte Kraftquelle."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I think it's supposed to turn on."
msgstr "Ich denke, es soll sich einschalten."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Not sure how it works."
msgstr "Nicht sicher, wie es funktioniert."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Don't think it's supposed to look like that."
msgstr "Ich glaube nicht, dass es so aussehen soll."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "There's a picture on it of some strangely shaped people."
msgstr "Da ist ein Bild von seltsam geformten Menschen drauf."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Can't make heads or tails of this picture."
msgstr "Aus diesem Bild werd ich nicht schlau."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "The people are drowning in axle grease."
msgstr "Die Menschen ertrinken in Schmierfett."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Yuck. Something grotesque is happening in this picture."
msgstr "Pfui. In dem Bild geschieht etwas ganz Groteskes."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "A picture of a beautiful, well engineered city."
msgstr "Ein Bild einer wunderschönen, technologischen Stadt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_STATUE"
msgid "It's giving me goosebumps."
msgstr "Ich bekomme Gänsehaut."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.AXE"
msgid "I was never the \"woodsy\" type."
msgstr "Ich bin nicht so der Holzfällertyp."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "You're not too young to work."
msgstr "Du bist nicht zu jung, um zu arbeiten."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "You're too young to be lazy."
msgstr "Du bist zu jung, um faul zu sein."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BACKPACK"
msgid "I don't mind playing pack mule."
msgstr "Macht mir nicht aus, der Packesel zu sein."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BACONEGGS"
msgid "A hearty breakfast for a full day's work."
msgstr "Ein herzhaftes Frühstück ist die Basis für einen arbeitsreichen Tag."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOON"
msgid "Oh! A balloon."
msgstr "Oh! Ein Ballon."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONS_EMPTY"
msgid "No fun without Wes."
msgstr "Ohne Wes macht's keinen Spaß."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE"
msgid "Takes care of workplace injuries."
msgstr "Für Verletzungen am Arbeitsplatz."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BASALT"
msgid "Great, it's a rock."
msgstr "Super, ein Stein."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BAT"
msgid "Flyin' rodent."
msgstr "Fliegende Ratte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATBAT"
msgid "Ha! Clever."
msgstr "Ha! Wie clever!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATCAVE"
msgid "I'm gonna leave that right alone."
msgstr "Das werd ich nicht anfassen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATWING"
msgid "Surprisingly meaty."
msgstr "Überraschend fleischig."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATWING_COOKED"
msgid "Meat's meat."
msgstr "Fleisch ist fleisch."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARDHAIR"
msgid "Ha! Disgusting."
msgstr "Ha! Eklig."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER"
msgid "Bring it on, ya big lug!"
msgstr "Komm schon, Großnase!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERVEST"
msgid "One seriously cozy vest."
msgstr "Eine echt schicke Weste."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER_FUR"
