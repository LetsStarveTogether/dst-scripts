msgstr "Ein zivilisierteres Licht."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
