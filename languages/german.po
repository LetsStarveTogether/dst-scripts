#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule4
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule4"
msgid "Equip this item to change your character's background portrait.\n\nFestering with festiveness."
msgstr "Rüste dieses Element aus, um das Hintergrundporträt deiner Figur zu ändern.\n\nFestlichkeit bis zum Absturz."

#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule5
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule5"
msgid "Equip this item to change your character's background portrait.\n\nYou never know what's lurking inside."
msgstr "Rüste dieses Element aus, um das Hintergrundporträt deiner Figur zu ändern.\n\nMan weiß nie, was da drin lauert."

#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule6
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule6"
msgid "Equip this item to change your character's background portrait.\n\nThe colored lights keep the darkness at bay."
msgstr "Rüste dieses Element aus, um das Hintergrundporträt deiner Figur zu ändern.\n\nDie farbigen Lichter halten die Dunkelheit in Schach."

#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule7
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yule7"
msgid "Equip this item to change your character's background portrait.\n\nEat, drink and be merry for tomorrow you may die."
msgstr "Rüste dieses Element aus, um das Hintergrundporträt deiner Figur zu ändern.\n\nIss, trink und sei fröhlich, denn morgen kannst du schon tot sein."

