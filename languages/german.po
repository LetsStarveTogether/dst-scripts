msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_35"
msgid "I kinda wanna drink what's left, but he won't let me."
msgstr "Ich würde den Rest ja gerne trinken, aber er lässt mich nicht."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_36"
msgid "We've already got some, thanks."
msgstr "Wir haben schon, danke."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_37"
msgid "Maybe we should hide this before someone gets hurt."
msgstr "Vielleicht sollten wir das verstecken, bevor jemand verletzt wird."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_38"
msgid "Haha! Everything looks so small!"
msgstr "Haha! Alles sieht so klein aus!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_39"
msgid "That's boring."
msgstr "Das ist langweilig."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_4"
msgid "It's watching us."
msgstr "Es beobachtet uns."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_40"
msgid "Haha, it looks like a snail shell."
msgstr "Haha, es sieht aus wie eine Schneckenhaus."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_41"
msgid "Haha! Weird!"
msgstr "Haha, komisch."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_42"
msgid "Neat!!"
msgstr "Nett!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_43"
msgid "C'mon little croc! Let's adventure!"
msgstr "Los, Krokodilchen! Auf ins Abenteuer!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_44"
msgid "The plant is so pretty!"
msgstr "Die Pflanze ist so hübsch!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_45"
msgid "It doesn't get any good channels."
msgstr "Damit kommen keine guten Sender rein."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_46"
msgid "What's it for?"
msgstr "Wozu benutzt man das?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_5"
msgid "Yay, a new toy!"
msgstr "Juhu, ein neues Spielzeug!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_6"
msgid "Maybe we'll find a use for these."
msgstr "Vielleicht finden wir dafür eine Verwendung."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_7"
msgid "Another toy!"
msgstr "Ein weiteres Spielzeug!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_8"
msgid "I miss bath toys."
msgstr "Ich werde es nicht vermissen."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_9"
msgid "None of them match!"
msgstr "Nichts davon passt!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It's so puffy!"
msgstr "Er ist so geschwollen."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER"
msgid "You're always supposed to wear a jacket!"
msgstr "Du sollst immer eine Jacke tragen!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED"
msgid "Looks filling!"
msgstr "Sieht sättigend aus!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER"
msgid "We took his nose!"
msgstr "Wir haben seine Nase!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER"
msgid "He blue his nose."
msgstr "Er hat seine Nase verjubelt."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED"
msgid "Who knows what that tumbleweed has picked up."
msgstr "Wer weiß, was dieser Steppenläufer aufgesammelt hat."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BADLANDS"
msgid "Some ground that we dug up."
msgstr "Irgendein Erdboden, den wir ausgegraben haben."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CARPETFLOOR"
msgid "Carpets! Just like in our old house."
msgstr "Teppiche! Genau wie in unserem alten Haus."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CAVE"
msgid "Some pretty average earth."
msgstr "Ein ziemlich durchschnittliches Stück Erde."

