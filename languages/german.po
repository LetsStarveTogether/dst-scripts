msgctxt "STRINGS.UI.TRADESCREEN.TEMPORARILY_CLOSED_BODY"
msgid "The Trade Inn is closed for a bit.\n\nBe back soon, okay?"
msgstr "Das Tauschhaus ist eine Weile geschlossen.\n\nKomm bald wieder, ja?"

#. STRINGS.UI.TRADESCREEN.TITLE
msgctxt "STRINGS.UI.TRADESCREEN.TITLE"
msgid "Trade Inn"
msgstr "Tauschen"

#. STRINGS.UI.TRADESCREEN.TRADE
msgctxt "STRINGS.UI.TRADESCREEN.TRADE"
msgid "Trade"
msgstr "Gewerk"

#. STRINGS.UI.TRADESCREEN.WARNING
msgctxt "STRINGS.UI.TRADESCREEN.WARNING"
msgid "You won't be able to wear an item if you give your last one away! Do you really want to trade these items?"
msgstr "Wenn du dein letztes Element hergibst, kannst du keines tragen! Möchtest du diese Elemente wirklich tauschen?"

#. STRINGS.UI.TRADESCREEN.WARNING_SINGLE
msgctxt "STRINGS.UI.TRADESCREEN.WARNING_SINGLE"
msgid "You won't be able to wear an item if you give your last one away! Do you really want to trade this item?"
msgstr "Wenn du dein letztes Element hergibst, kannst du keines tragen! Möchtest du dieses Element wirklich tauschen?"

#. STRINGS.UI.UNLOCKMAXWELL.BODY1
msgctxt "STRINGS.UI.UNLOCKMAXWELL.BODY1"
msgid "The key looks like it will fit. You can free "
msgstr "Der Schlüssel sieht aus, als würde er passen. Du kannst "

#. STRINGS.UI.UNLOCKMAXWELL.BODY2
msgctxt "STRINGS.UI.UNLOCKMAXWELL.BODY2"
msgid ", but I doubt %s captors will be pleased..."
msgstr " befreien, aber ich glaube %s Entführer werden zufrieden sein."

#. STRINGS.UI.UNLOCKMAXWELL.NO
