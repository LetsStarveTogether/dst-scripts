msgstr "Ich hätte lieber etwas Kräftigeres."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUM"
