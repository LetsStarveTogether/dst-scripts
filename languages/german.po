#. STRINGS.SKIN_DESCRIPTIONS.pack_character_wortox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_character_wortox"
msgid "This Wortox Chest contains the playable character, Wortox: The Soul Starved, as well as Wortox's complete set of Survivor skin items."
msgstr "Diese Wortox-Truhe enthält den spielbaren Charakter Wortox sowie den kompletten Satz an Überlebenden-Skins für Wortox."

#. STRINGS.SKIN_DESCRIPTIONS.pack_factory_items
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_factory_items"
msgid "This Voxola Warehouse Chest contains the following skin items: Factory Signpost, Pipe Fencing, Factory Portrait, and Factory Signpost Icon."
msgstr "Diese Voxola-Lager-Truhe enthält die folgenden Skins: Fabrikschild, Rohrzaun, Fabrikporträt und Fabrikschild-Symbol."

#. STRINGS.SKIN_DESCRIPTIONS.pack_forge_armor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_forge_armor"
msgid "This chest contains all 16 Forge collection armor and headgear skin items."
msgstr "Diese Truhe enthält alle 16 Rüstungen und Kopfbedeckungen der Schmiedekollektion."

#. STRINGS.SKIN_DESCRIPTIONS.pack_forge_weapons
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_forge_weapons"
msgid "This chest contains all 7 Forge collection weapons skin items."
msgstr "Diese Truhe enthält alle 7 Waffen-Skins der Schmiedekollektion."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_all
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_all"
msgid "This Gladiator Chest contains every survivor's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält den kompletten Satz an Gladiatoren-Skins für jeden Überlebenden."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wathgrithr
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wathgrithr"
msgid "This Gladiator Chest contains Wigfrid's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält den kompletten Satz an Wigfrids Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_waxwell
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_waxwell"
msgid "This Gladiator Chest contains Maxwell's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält Maxwells kompletten Satz an Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_webber
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_webber"
msgid "This Gladiator Chest contains Webber's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält Webbers kompletten Satz an Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wendy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wendy"
msgid "This Gladiator Chest contains Wendy's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält Wendys kompletten Satz an Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wes
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wes"
msgid "This Gladiator Chest contains Wes' complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält Wes' kompletten Satz an Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wickerbottom
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wickerbottom"
msgid "This Gladiator Chest contains Wickerbottom's complete set of Gladiator skin items."
msgstr "Diese Gladiatoren-Truhe enthält Wickerbottoms kompletten Satz an Gladiatoren-Skins."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_willow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_willow"
msgid "This Gladiator Chest contains Willow's complete set of Gladiator skin items."
