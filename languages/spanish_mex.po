msgstr "Suelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_PEBBLEBEACH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_PEBBLEBEACH"
msgid "Turf."
msgstr "Suelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_ROAD"
msgid "At least this one is useful."
msgstr "Al menos este es útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_ROCKY"
msgid "Kinda rough."
msgstr "Un poco áspero."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SANDY"
msgid "Turf."
msgstr "Suelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SAVANNA"
msgid "Dirty."
msgstr "Tierra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_SINKHOLE"
msgid "Turf."
msgstr "Suelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_UNDERROCK"
msgid "Turf."
msgstr "Suelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_WOODFLOOR"
msgid "I prefer hardwoods."
msgstr "Prefiero las maderas nobles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURKEYDINNER"
msgid "How festive."
msgstr "Qué festivo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP"
msgid "It's a big, bulbous turnip."
msgstr "Un nabo grande y bulboso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP_COOKED"
msgid "Hardly improves the taste."
msgstr "Apenas mejora el sabor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURNIP_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "¿Se supone que debo plantarlas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURTILLUS"
msgid "He's rather thick-headed."
msgstr "Es bastante testarudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Oops."
msgstr "¡Uy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Bathed in fire."
msgstr "Bañado en el fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "That's not about to grow back."
msgstr "No volverá a crecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "¿Qué trajo esta aflicción a mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "The tree of an amateur."
msgstr "El árbol de un aficionado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_NUT"
msgid "I could plant it... but why?"
msgstr "Podría plantarlo... pero ¿por qué?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It's of no use in it's current state. Only time will tell."
msgstr "No sirve de nada en su estado actual. Solo el tiempo dirá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGGY_OLD"
msgid "Look at you. You're useless."
msgstr "Mírate. No sirves para nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TWIGS"
msgid "Common, but useful."
msgstr "Común, pero útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UMBRELLA"
msgid "It's crooked!"
msgstr "¡Se pliega!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UNAGI"
msgid "It will have to do."
msgstr "Espero que sirva."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.UNIMPLEMENTED"
msgid "Just what are you up to now, Charlie?"
msgstr "¿Y qué haces ahora, Charlie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VEGSTINGER"
msgid "I do enjoy a drink."
msgstr "Disfruto de una buena bebida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VOLTGOATJELLY"
msgid "Just because I'm old doesn't mean I like gelatin."
msgstr "Solo porque sea viejo no significa que me guste la gelatina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAFFLES"
msgid "An excellent start to the morning. Or evening."
msgstr "Un excelente comienzo de la mañana. O de la noche."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALKINGPLANK"
msgid "Jumping off would ruin what's left of my suit."
msgstr "Saltar de ahí arruinaría mi traje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.BURNT"
msgid "I told you so."
msgstr "Te lo dije."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.GENERIC"
msgid "It's a tinderbox."
msgstr "Es un montón de yesca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY_ITEM"
msgid "Pocket-sized wall pieces. Yup."
msgstr "Trozos de pared de bolsillo. Sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_MOONROCK"
msgid "I like to build walls between myself and the world."
msgstr "Me gustaría construir muros entre el mundo y yo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Where should I put this?"
msgstr "¿Dónde pongo esto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_RUINS"
msgid "An ancient wall."
msgstr "Un muro ancestral."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_RUINS_ITEM"
msgid "Pocket-sized wall pieces. Yup."
msgstr "Trozos de pared de bolsillo. Sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_STONE"
msgid "This will keep the riff-raff out."
msgstr "Esto mantendrá a la gentuza fuera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_STONE_ITEM"
msgid "Pocket-sized wall pieces. Yup."
msgstr "Trozos de pared de bolsillo. Sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD.BURNT"
msgid "Not tough, nor flammable."
msgstr "No es resistente, ni inflamable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Moderately tough, but flammable."
msgstr "Moderadamente resistente, pero inflamable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_WOOD_ITEM"
msgid "Pocket-sized wall pieces. Yup."
msgstr "Trozos de pared de bolsillo. Sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS"
msgid "Don't you recognize me?"
msgstr "¿No me reconoces?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUSHAT"
msgid "Made in Scotland."
msgstr "Hecho en Escocia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "I best not linger when winter comes."
msgstr "Será mejor que no me demore cuando llegue el invierno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "The Walrusser can't be far."
msgstr "Los señores morsa deben estar cerca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALRUS_TUSK"
msgid "I'll put this to better use."
msgstr "Voy a darle a esto un mejor uso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.ATTACKER"
msgid "I do not wish to quarrel!"
msgstr "¡No deseo pelear!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.FIRESTARTER"
msgid "Wasn't it you who was railing on about fire safety?"
msgstr "¿No eras tú el de los fastidiosos discursos sobre las medidas de protección contra incendios?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.GHOST"
msgid "Perhaps you can add this to your roster of ghost stories."
msgstr "Quizá puedas agregar esta situación a tu lista de historias sobre fantasmas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.MURDERER"
msgid "Interesting, %s. I didn't think you had it in you."
msgstr "Interesante, %s. No te creía capaz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTER.REVIVER"
msgid "I'm afraid I can't give you a badge, only my thanks."
msgstr "Me temo que no puedo darte una medalla. Solo puedo ofrecerte mi gratitud."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALTERHAT"
msgid "It's not quite my style."
msgstr "No es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.BURNING"
msgid "Oops."
msgstr "¡Uy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.BURNT"
msgid "Dapperness is a state of mind."
msgstr "La elegancia es un estado mental."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARDROBE.GENERIC"
msgid "Fashion without function."
msgstr "Moda sin función."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARG"
msgid "The alpha!"
msgstr "¡El alfa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.BURNT"
msgid "Burnt to cinders."
msgstr "Se quemó hasta convertirse en cenizas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.EMPTY"
msgid "It requires a torch."
msgstr "Necesita una antorcha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARGSHRINE.GENERIC"
msgid "The preparations have been made."
msgstr "Los preparativos están listos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.ATTACKER"
msgid "%s seems out of sorts today."
msgstr "%s parece estar de mal humor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.FIRESTARTER"
msgid "%s's started some suspicious fires recently."
msgstr "%s ha iniciado algunos incendios sospechosos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.GHOST"
msgid "Oh, what a shame."
msgstr "Oh. Qué pena."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.MURDERER"
msgid "Eat this!"
msgstr "¡Cómete esto!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WARLY.REVIVER"
msgid "Thank-you for the assistance, %s."
msgstr "Gracias por tu ayuda, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WASPHIVE"
msgid "That looks dangerous."
msgstr "Se ve peligroso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERBALLOON"
msgid "Do you have any idea how much this suit cost?"
msgstr "¿Tienes idea de lo que cuesta este traje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON"
msgid "It's mostly water. Fibrous, sweet water."
msgstr "Es sobre todo agua. Agua dulce y fibrosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELONHAT"
msgid "This is one way to keep cool. And sticky."
msgstr "Esta es una forma de mantenerse fresco. Y pegajoso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELONICLE"
msgid "The case is cold on the melon."
msgstr "Esta sandía está helada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON_COOKED"
msgid "Grillermelon."
msgstr "Sandía a la plancha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERMELON_SEEDS"
msgid "I could probably plant these."
msgstr "Creo que podría plantarlas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT"
msgid "I'm sure its delicate appearance is just a ruse for us to let our guard down."
msgstr "Estoy seguro de que su delicada apariencia solo es una treta para que bajemos la guardia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_BABY"
msgid "I should pluck you like the weed you are."
msgstr "Te arrancaré como la hierba mala que eres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_BOMB"
msgid "I was right."
msgstr "Tenía razón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPLANT_PLANTER"
msgid "Why would I want these to spread?"
msgstr "¿Por qué querría que estas se propagaran?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATERPUMP"
msgid "Higgsbury, I think a bucket would have sufficed..."
msgstr "Higgsbury, creo que con una cubeta hubiese bastado..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "What is %s's motivation?"
msgstr "¿Cuál es la motivación de %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "The next fire you start will be a funeral pyre."
msgstr "El siguiente fuego que empieces será una pira funeraria."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Saludos, Sra. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GHOST"
msgid "Do you desire a heart, %s?"
msgstr "¿Deseas un corazón, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Bloodthirsty warrior! This ends now!"
msgstr "¡Guerrero sediento de sangre! ¡Esto termina ahora!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s has excellent command of the spirit realm."
msgstr "%s tiene un excelente dominio del reino espiritual."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHRHAT"
msgid "Well... it's no crown."
msgstr "Bueno... no es una corona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXPAPER"
msgid "My interest in this wax paper wanes...."
msgstr "Mi interés en este papel encerado disminuye..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.ATTACKER"
msgid "I know that look, %s. What are you up to?"
msgstr "Conozco esa mirada, %s. ¿Qué pretendes hacer?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Do not blow this for us, %s."
msgstr "No nos hagas esto, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GENERIC"
msgid "What a dapper fellow!"
msgstr "¡Qué tipo tan apuesto!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GHOST"
msgid "I'll have to pay in blood to bring you back, %s."
msgstr "Tendré que pagar con sangre para traerte a la vida, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.MURDERER"
msgid "Old habits die hard... and so will you!"
msgstr "Los viejos hábitos son difíciles de eliminar... ¡al igual que tú!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.REVIVER"
msgid "Trust only yourself, hey %s?"
msgstr "¿Solo confías en ti mismo, eh, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELLJOURNAL"
msgid "I'm so sorry, Charlie."
msgstr "Lo siento, Charlie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.ATTACKER"
msgid "%s is looking downright feral..."
msgstr "%s parece francamente salvaje..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Like a moth to flame. Or a spider, maybe."
msgstr "Como una polilla a la llama. O una araña, tal vez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GHOST"
msgid "Looks like you got squashed, %s."
msgstr "Parece que te aplastaron, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.MURDERER"
msgid "So, %s, you're a monster after all!"
msgstr "Entonces, %s... eres un monstruo después de todo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.REVIVER"
msgid "This child, %s, doesn't have a mean bone in his body."
msgstr "Este niño, %s, no tiene maldad en su cuerpo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBERSKULL"
msgid "Reminds me of the good ol' days."
msgstr "Me recuerda a los buenos tiempos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Disgusting."
msgstr "Qué asco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.ATTACKER"
msgid "%s has been corrupted..."
msgstr "%s está corrupta..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.FIRESTARTER"
msgid "Don't play with fire, Ms. %s."
msgstr "No juegues con fuego, Srta. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GENERIC"
msgid "Greetings, Miss %s. How are you?"
msgstr "Saludos, Srta. %s. ¿Cómo estás?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GHOST"
msgid "%s is looking a bit too much like her sister."
msgstr "%s se parece demasiado a su hermana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.MURDERER"
msgid "Don't think I'll hesitate, murderous fiend!"
msgstr "¡No creas que dudaré, asesina!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.REVIVER"
msgid "%s is a true death defier."
msgstr "%s desafía a la muerte de verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_BEAVER"
msgid "It seems he's learning to bend the curse to his will."
msgstr "Parece que está aprendiendo a dominar esa maldición."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_GOOSE"
msgid "Ugh, it offends my eyes."
msgstr "Aj. Es ofensivo a la vista."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEREITEM_MOOSE"
msgid "Almost as powerful as it is tacky."
msgstr "Es tan poderoso como chabacano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.ATTACKER"
msgid "%s is giving me the creeps..."
msgstr "%s me está dando escalofríos..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.FIRESTARTER"
msgid "Stop burning things, mime."
msgstr "Deja de quemar cosas, mimo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GHOST"
msgid "I could get you a heart, %s... for a price."
msgstr "Te conseguiría un corazón, %s... por un precio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.MURDERER"
msgid "Murderous fiend! You cannot escape!"
msgstr "¡Demonio asesino! ¡No escaparás!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.REVIVER"
msgid "%s is an effective ally."
msgstr "%s es un aliado eficaz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETGOOP"
msgid "How uncultured."
msgstr "Qué inculto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPAPER"
msgid "It's absorbent, at any rate."
msgstr "En cualquier caso, es absorbente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPOUCH"
msgid "There's something inside it."
msgstr "Hay algo dentro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WHIP"
msgid "Makes me feel like the master again."
msgstr "Me hace sentir como el maestro otra vez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s is withholding information..."
msgstr "%s está ocultando información..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Never pinned you for the wanton destruction type."
msgstr "No te consideraba un ser destructivo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Good day, Ms. %s."
msgstr "Buenos días, Sra. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You know the price of revival as well as I do, %s."
msgstr "Sabes el precio de la resurrección tan bien como yo, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Do not start fights you cannot win!"
msgstr "¡No empieces peleas que no puedes ganar!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s has excellent command of the dark arts."
msgstr "%s tiene un excelente dominio de las artes oscuras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.ATTACKER"
msgid "%s is not my ally..."
msgstr "%s no es mi aliada..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.FIRESTARTER"
msgid "She's a firestarter. And a twisted one, at that."
msgstr "Es una pirómana. Y retorcida, además."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Saludos, Sra. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GHOST"
msgid "We will require a heart to bring you back, %s."
msgstr "Necesitaremos un corazón para devolverte a la vida, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.MURDERER"
msgid "Murderous fiend! Taste my wrath!"
msgstr "¡Asesina! ¡Prueba mi ira!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.REVIVER"
msgid "%s has bent reality to her fiery will."
msgstr "%s se doblegó a su voluntad ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.ATTACKER"
msgid "You're going off the deep end, pal."
msgstr "Vas por el mal camino, amigo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.FIRESTARTER"
msgid "The fire is supposed to go in the pit, Higgsbury."
msgstr "Se supone que el fuego tiene que estar en la hoguera, Higgsbury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GENERIC"
msgid "Err, greetings, Mr. %s."
msgstr "Eh, saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GHOST"
msgid "Are you certain you wish to return to this world?"
msgstr "¿Seguro que deseas regresar a este mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.MURDERER"
msgid "Our truce ends here, murderer!"
msgstr "¡Nuestra tregua termina aquí, asesino!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.REVIVER"
msgid "%s is a real pal..."
msgstr "%s es un verdadero amigo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.GENERIC"
msgid "We are to start dredging up what lies beneath now, are we?"
msgstr "Vamos a empezar a dragar lo que sea que haya debajo, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "Interesting."
msgstr "Interesante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "It seems I've gotten a hold of something."
msgstr "Parece que agarré algo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.ATTACKER"
msgid "%s has been roughhousing like a commoner."
msgstr "%s estuvo armando alboroto como un plebeyo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.FIRESTARTER"
msgid "You were the last one I expected to start fires, %s."
msgstr "Eras la última persona que se me habría ocurrido que provocaría incendios, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Saludos, Sra. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GHOST"
msgid "My, you're looking spirited today, %s."
msgstr "¡Vaya! Parece que hoy tienes un espíritu muy alegre, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.MURDERER"
msgid "You've engineered your own demise!"
msgstr "¡Fabricaste tu propio deceso!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.REVIVER"
msgid "%s expertly uses all tools at her disposal."
msgstr "%s usa con pericia todas las herramientas a su disposición."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "I'm going to pretend I don't see it."
msgstr "Voy a fingir que no lo veo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "Oh. What a pity."
msgstr "Ay, qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "At least she has the sense to use gems."
msgstr "Al menos está en sus cabales y usa gemas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "I think it's losing power."
msgstr "Creo que está perdiendo energía."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Magic isn't so easy, is it?"
msgstr "La magia no es tan fácil, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "I'm going to pretend I don't see it."
msgstr "Voy a fingir que no lo veo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Oh. What a pity."
msgstr "Ay, qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Where does she find the time to build all this."
msgstr "¿De dónde saca el tiempo para construir todo esto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "I think it's losing power."
msgstr "Creo que está perdiendo energía."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "See? It wasn't so great after all."
msgstr "¿Ves? No era tan genial al fin y al cabo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "I'm going to pretend I don't see it."
msgstr "Voy a fingir que no lo veo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Oh. What a pity."
msgstr "Ay, qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "I could have thought of that."
msgstr "Podría haber pensado en eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It's useless out here without power."
msgstr "Sin energía no sirve para nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "I'm going to pretend I don't see it."
msgstr "Voy a fingir que no lo veo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Oh. What a pity."
msgstr "Ay, qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Well sure, if you want to take the easy way out."
msgstr "Claro, si quieres tomar la salida fácil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "It's useless out here without power."
msgstr "Sin energía no sirve para nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERHAT"
msgid "How disappointingly rustic."
msgstr "Es tan rústico como decepcionante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.BURNT"
msgid "Who cares?"
msgstr "¿A quién le importa?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Not the most useful invention, is it?"
msgstr "No es el invento más útil, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTFUEL"
msgid "I prefer my fuel more nightmarish."
msgstr "Prefiero que mi combustible se parezca más a una pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "I do wish it would hurry up."
msgstr "Ojalá se apresurara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "What's it cooking up now?"
msgstr "¿Qué cocina ahora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Finally!"
msgstr "¡Por fin!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "Something about it... ah, I'm sure it's nothing."
msgstr "Algo sobre esto me parece... Ah, estoy seguro de que no es nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD1"
msgid "Stop looking at me, cookie fiend."
msgstr "Deja de mirarme, demonio en forma de galleta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD2"
msgid "We're celebrating freezing to death, I see."
msgstr "Claro, estamos celebrando morirnos congelados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD3"
msgid "I don't even use a cane."
msgstr "Ni siquiera uso bastón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD4"
msgid "It is unbound from time."
msgstr "Existe fuera del tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD5"
msgid "How, err... traditional."
msgstr "Qué, eh... tradicional."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD6"
msgid "It's extremely rich."
msgstr "Es extremadamente rico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD7"
msgid "Glorified apple juice."
msgstr "Jugo de manzana glorificado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD8"
msgid "Such a decadent beverage."
msgstr "Qué bebida tan decadente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD9"
msgid "My... favorite... she remembered."
msgstr "Mi comida... favorita. Se acordó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENT"
msgid "Gaudy, like the rest of this shindig."
msgstr "Vulgar como el resto de esta farsa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "What a thing to risk one's life for."
msgstr "No vale la pena arriesgar la vida por esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "A volatile decoration."
msgstr "Una decoración volátil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "There's something familiar about this..."
msgstr "Me resulta familiar..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "How frivolous."
msgstr "Que frívolo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNING"
msgid "It's a Winter's Feast miracle."
msgstr "Un milagro de la Fiesta Invernal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNT"
msgid "That's that, it seems."
msgstr "Parece que se acabó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "How wretchedly jolly."
msgstr "Qué alegre, por desgracia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Have we nothing better to do with our time?"
msgstr "¿Acaso no tenemos nada mejor que hacer con nuestro tiempo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "That's that, it seems."
msgstr "Parece que se acabó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "How repulsively festive."
msgstr "Tan festivo que me repugna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_DEN"
msgid "What manner of creature lives in there?"
msgstr "¿Qué clase de criatura vive aquí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_MOONGLASS"
msgid "They didn't look like that when I was in charge."
msgstr "No se veían así cuando yo estaba a cargo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER"
msgid "I'd prefer it without the sharp, pinching claws."
msgstr "Las prefiero sin las pinzas afiladas que pellizcan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Excellent."
msgstr "Excelente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "I forgot my bib."
msgstr "Se me olvidó la pechera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYBIG.1"
msgid "I'd rather not get hair all over my suit."
msgstr "Preferiría que no se me llenara el traje de pelos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYBIG.2"
msgid "I'd rather not get hair all over my suit."
msgstr "Preferiría que no se me llenara el traje de pelos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYSMALL.1"
msgid "She slobbers..."
msgstr "Babea..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOBYSMALL.2"
msgid "She slobbers..."
msgstr "Babea..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.ATTACKER"
msgid "The strongman %s seems a little unhinged."
msgstr "El fortachón %s parece un poco desquiciado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Did you intend to burn that, %s?"
msgstr "¿Vas a quemar eso, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GENERIC"
msgid "Good day to you, Mr. %s."
msgstr "Buenos días, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GHOST"
msgid "Let's find a heart. I'll prepare my incantations."
msgstr "Busquemos un corazón. Prepararé mis encantamientos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.MURDERER"
msgid "Murderous fiend! Behold my power!"
msgstr "¡Demonio asesino! ¡Este es mi poder!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s tethers lost spirits to this world."
msgstr "%s ata espíritus perdidos a este mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.ATTACKER"
msgid "%s is going against the grain..."
msgstr "%s va contra la corriente..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVER"
msgid "Ha! What a delightful curse."
msgstr "¡Ja! Qué maldición tan encantadora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "Yew don't look so wood."
msgstr "Pareces un poco tieso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Is it wise to start fires, given your predilections?"
msgstr "¿Es sensato comenzar incendios, dadas tus predilecciones?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GHOST"
msgid "That blockhead could use a heart."
msgstr "A ese tonto le hace falta un corazón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GOOSE"
msgid "Not the most dignified form you've taken."
msgstr "No es la forma más digna que has tomado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "It seems you've run a-fowl of something, pal."
msgstr "Parece que correr como ave de corral no te sirvió de nada, amigo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MOOSE"
msgid "Wonderful. A screw-loose moose."
msgstr "Maravilloso. Un alce loco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "I'll leave you to you moose-ings while I seek out a heart."
msgstr "Te dejaré para que sigas “alceando” mientras yo busco un corazón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MURDERER"
msgid "Fiend! Time to make like a tree...!"
msgstr "¡Demonio! ¡Ya que te gustan tanto las hachas...!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.REVIVER"
msgid "%s seems very in touch with the spirits of the forest."
msgstr "%s parece muy en contacto con los espíritus del bosque."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.DIRT"
msgid "Something stirs."
msgstr "Creo que algo se movió."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.PLANT"
msgid "You aren't fooling me, plant."
msgstr "A mí no me engañas, planta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.WORM"
msgid "I didn't make that one! Honest!"
msgstr "¡Yo no fui! ¡De verdad!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.GENERIC"
msgid "It's worse knowing what the other part looks like."
msgstr "Es peor saber a qué se parece la otra parte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.OPEN"
msgid "I assure you that it smells worse than it looks."
msgstr "Puedo asegurarte que huele peor de lo que parece."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE_LIMITED"
msgid "It looks ill."
msgstr "Parece enfermo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT"
msgid "What a neat trick."
msgstr "Qué truco tan bueno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_LESSER"
msgid "This one isn't very good."
msgstr "Este no es muy bueno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_PLANT"
msgid "You aren't fooling me, plant."
msgstr "A mí no me engañas, planta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.ATTACKER"
msgid "It's time you make like a tree and leaf."
msgstr "Es hora de que hagas como un árbol: quédate tranquilo o te talamos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s has been starting fires, now hasn't he?"
msgstr "%s ha estado incendiando cosas, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.GHOST"
msgid "What a shame. Now I'll never know what that gem does."
msgstr "Qué lástima, ahora no sabré para qué servía esa gema."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.MURDERER"
msgid "Don't worry, %s. I'll make it a clear cut."
msgstr "No te preocupes, %s. Te talaré de un solo golpe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMWOOD.REVIVER"
msgid "I suppose he has his uses."
msgstr "Supongo que sí es un poco útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.ATTACKER"
msgid "Do not make me bind you with magic, imp."
msgstr "No me hagas encantarte con magia, diablillo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Do I smell fire and brimstone?"
msgstr "¿Huelo a fuego y azufre?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Saludos, Sr. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.GHOST"
msgid "Serves you right, meddling imp."
msgstr "Lo tienes bien merecido, diablillo entrometido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.MURDERER"
msgid "Enough is enough! Prepare to be banished, imp!"
msgstr "¡Ya basta! ¡Prepárate para ser desterrado, diablillo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORTOX.REVIVER"
msgid "Hm. I'll allow you to stay on this plane awhile longer."
msgstr "Mmm. Te permitiré quedarte en esta dimensión un poco más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.ATTACKER"
msgid "This is no time for childishness!"
msgstr "¡Este no es el momento para inmadureces!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.FIRESTARTER"
msgid "Who left the tiny green demon unsupervised?!"
msgstr "¡¿Quién dejó a este pequeño demonio verde sin supervisión?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.GENERIC"
msgid "Greetings, Miss %s."
msgstr "Saludos, Srta. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.GHOST"
msgid "Oh dear, whatever will become of your kingdom now?"
msgstr "¡Oh, cielos! ¿Y ahora qué le pasará a tu reino?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.MURDERER"
msgid "%s has revealed her true nature!"
msgstr "¡%s reveló su verdadera naturaleza!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WURT.REVIVER"
msgid "Ah, thank you, %s."
msgstr "Ah, gracias, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.ATTACKER"
msgid "If you're going to attack, at least finish the job!"
msgstr "¡Si vas a atacar, por lo menos termina el trabajo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.FIRESTARTER"
msgid "Mx. %s is making good on their promises of mayhem."
msgstr "%s por fin va a cumplir su promesa de destrucción."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GENERIC"
msgid "Greetings, Mx. %s."
msgstr "Saludos, Dx. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GHOST"
msgid "A shame about your death. You were the only one I half-liked."
msgstr "Qué lamentable tu muerte. Eras el único que me agradaba medianamente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.MURDERER"
msgid "Murderous fiend! This will be your destruction!"
msgstr "¡Demonio asesino! ¡Esta será tu destrucción!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.REVIVER"
msgid "%s never did respect human mortality."
msgstr "%s nunca respetó la mortalidad humana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWAMULET"
msgid "This will make me stand out."
msgstr "Esto me hará destacar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWGEM"
msgid "I can sense magic in it."
msgstr "Noto la presencia de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWMOONEYE"
msgid "A conveniently color-coded place marker."
msgstr "Un marcador de lugar convenientemente codificado por colores."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWSTAFF"
msgid "With a bigger gem it would be so much more powerful."
msgstr "Con una gema más grande sería mucho más poderoso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "It's of no use to me like this."
msgstr "No me sirve de nada así."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It requires an offering."
msgstr "Precisa una ofrenda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "It's ready."
msgstr "Está lista."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "An underling must be able to follow directions."
msgstr "Un subordinado debe ser capaz de seguir instrucciones."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "The training seems to be progressing well."
msgstr "Parece que el entrenamiento va viento en popa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "My Carrat requires some direction."
msgstr "Mi ratahoria precisa de sentido de la orientación."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "You never know what might pop up on the race track."
msgstr "No sabes qué te puede aparecer en el circuito de carreras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Hm. I'm getting a sudden craving for popcorn..."
msgstr "Mmm... me están dando ganas de comer palomitas de maíz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "It would be prudent to place this somewhere."
msgstr "Sería prudente poner esto en algún lugar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Athletics were never my strong suit."
msgstr "Los deportes nunca fueron mi fuerte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "It's rather amusing to watch it scurry."
msgstr "Es bastante entretenido verla correr."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I should construct this, posthaste."
msgstr "Debería construirlo a toda prisa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "An exercise machine... the most dastardly of inventions."
msgstr "Equipo para hacer ejercicio... una de las invenciones más ruines."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "You will thank me for making you stronger."
msgstr "Luego me agradecerás que te haya vuelto más fuerte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "I tire of lugging this around."
msgstr "Me canso de arrastrar esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "These posts will serve as adequate route markers."
msgstr "Estos postes servirán adecuadamente como señalizadores de ruta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "The dumb little creatures would be lost without them."
msgstr "Las estúpidas criaturitas se perderían sin ellos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I've no use for it anymore."
msgstr "Ya no me sirve de nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Such frivolity."
msgstr "Qué frivolidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "I'd almost forgotten the sweet taste of victory."
msgstr "Había olvidado el dulce sabor de la victoria."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner}'s racer was... superior to mine..."
msgstr "El corredor de {winner} fue superior al mío."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "End of the line, pal."
msgstr "Es el fin, colega."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "I suppose this is what I must do for entertainment now."
msgstr "Imagino que estos son los eventos de entretenimiento a los que debo acostumbrarme."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Might as well start things off with a bang. Or a gong."
msgstr "Bien podrían comenzar todo con un gran ¡bang!... o un ¡gong!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "It's worthless now."
msgstr "Ya no sirve de nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "A disappointing performance."
msgstr "Un rendimiento decepcionante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Excellent. You've done well."
msgstr "Excelente. Lo hiciste bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "I will only accept the finest Carrat."
msgstr "Solo aceptaré bajo mi tutela a la ratahoria más fina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "It seems some assembly is required."
msgstr "Parece que hace falta que lo ensamblen."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET"
msgid "I will reap what I sow."
msgstr "Cosecharé lo que sembré."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "This should yield a higher quality crop."
msgstr "Esto debería darme una cosecha de mejor calidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD1"
msgid "Ah. I do enjoy a nice meal."
msgstr "Ah. Me encanta una buena comida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD2"
msgid "Ugh. More fit for a creature than for me."
msgstr "Agh. Esto es más para una criatura que para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTP_FOOD3"
msgid "Nothing fancy, but it will do."
msgstr "No es nada espectacular, pero servirá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC"
msgid "You tell me."
msgstr "Tú dirás."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING"
msgid "Won't be long before it lights on fire."
msgstr "No tardará mucho en encenderse."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK"
msgid "I can't see in the dark!"
msgstr "¡No puedo ver en la oscuridad!"

