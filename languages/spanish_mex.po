msgstr "¡Blut, glopi, glupsu!"

#. STRINGS.MERM_TALK_FOLLOWWILSON.3.1
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.3.1"
msgid "You help Mermfolk!"
msgstr "¡Tú ayudar a pueblo tritón!"

#. STRINGS.MERM_TALK_FOLLOWWILSON.3.2
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.3.2"
msgid "Glut Glurtsu flopt!"
msgstr "¡Glut, glupsu, flop!"

#. STRINGS.MERM_TALK_FOLLOWWILSON.4.1
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.4.1"
msgid "You okay."
msgstr "Tú ser bueno."

#. STRINGS.MERM_TALK_FOLLOWWILSON.4.2
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.4.2"
msgid "Florpy flort."
msgstr "Flopi, flot."

