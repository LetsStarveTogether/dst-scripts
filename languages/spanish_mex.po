#. STRINGS.SKIN_DESCRIPTIONS.goldenaxe_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.goldenaxe_northern"
msgid "A resplendent golden axe, its design reminiscent of days of yore."
msgstr "Un hacha dorada resplandeciente, cuyo diseño recuerda a los días de antaño."

#. STRINGS.SKIN_DESCRIPTIONS.goldenpickaxe_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.goldenpickaxe_northern"
msgid "A resplendent golden pickaxe, its design reminiscent of days of yore."
msgstr "Un pico dorado resplandeciente, cuyo diseño recuerda a los días de antaño."

#. STRINGS.SKIN_DESCRIPTIONS.goldenshovel_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.goldenshovel_northern"
msgid "A resplendent golden shovel, its design reminiscent of days of yore."
msgstr "Una pala dorada resplandeciente, cuyo diseño recuerda a los días de antaño."

#. STRINGS.SKIN_DESCRIPTIONS.greenstaff_clockwork
msgctxt "STRINGS.SKIN_DESCRIPTIONS.greenstaff_clockwork"
msgid "A construct of deconstruction."
msgstr "Una creación para la destrucción."

#. STRINGS.SKIN_DESCRIPTIONS.hambat_potroast
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hambat_potroast"
msgid "Delicious, delicious murder."
msgstr "Asesinato muy, muy delicioso."

#. STRINGS.SKIN_DESCRIPTIONS.hambat_spiralcut
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hambat_spiralcut"
msgid "This ham bat was fashioned after the scepter of the great Battlemaster Pugna."
msgstr "La inspiración para crear este bate de jamón surgió del cetro del gran maestro de batalla Pugna."

#. STRINGS.SKIN_DESCRIPTIONS.hammer_crowbar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hammer_crowbar"
msgid "A mighty man hammers with a crowbar."
msgstr "Un hombre poderoso golpea con una palanca."

#. STRINGS.SKIN_DESCRIPTIONS.hammer_forge
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hammer_forge"
msgid "Watch out for the spikey bits."
msgstr "Cuidado con los pinchos."

