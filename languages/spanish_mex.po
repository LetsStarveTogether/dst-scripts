msgstr "¡Hola, Winona! ¿Cómo lo arreglamos?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WINONA_CATAPULT.BURNING"
