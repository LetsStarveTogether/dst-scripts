msgstr "Equipa este objeto para cambiar la foto de fondo de tu personaje.\n\nUn santuario vacío necesita un sacrificio."

#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yotp2
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yotp2"
msgid "Equip this item to change your character's background portrait.\n\nThe belt color is the best indication of fighting skills."
msgstr "Equipa este objeto para cambiar la foto de fondo de tu personaje.\n\nEl color del cinturón es el mejor indicativo de tus habilidades de lucha."

#. STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yotp3
msgctxt "STRINGS.SKIN_DESCRIPTIONS.playerportrait_bg_yotp3"
