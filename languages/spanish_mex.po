msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.puppy_tzu
msgctxt "STRINGS.SKIN_DESCRIPTIONS.puppy_tzu"
msgid "This lil puppy can't see where it's going without its hair tied up. Adorable!"
msgstr "Este cachorrito no puede ver a dónde va sin que le aten el pelo. ¡Adorable!"

