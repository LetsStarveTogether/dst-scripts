msgstr "Ah. Qué lástima."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Perhaps I will try my luck?"
msgstr "Quizá lo intente."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Peso: {weight}\nAtrapado por: {owner}"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nWhat a massive morsel!"
msgstr "Peso: {weight}\nAtrapado por: {owner}\n¡Qué bocado tan gigante!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nI do have a bit of experience with fishing!"
msgstr "Peso: {weight}\nAtrapado por: {owner}\n¡Tengo un poquito de experiencia pescando!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nAh, bon! It seems I've won for now!"
msgstr "Peso: {weight}\nAtrapado por: {owner}\n¡Ah, bueno! ¡Parece que por ahora soy el ganador!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Fashionably refreshing."
msgstr "Refrescantemente moderno."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNKVEST_WINTER"
msgid "Toasty and trendy."
msgstr "Caliente y a la moda."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_COOKED"
msgid "Could use... Hm... I'm stumped..."
msgstr "Le hace falta... mmm... Estoy perplejo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_SUMMER"
msgid "This meat has a gamey odor."
msgstr "Esta carne tiene un olor fuerte."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRUNK_WINTER"
