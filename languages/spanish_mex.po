msgstr "Será mejor ponerse manos a la obra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
