msgstr "¡No te rindas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
