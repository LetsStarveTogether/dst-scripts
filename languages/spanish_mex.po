msgctxt "STRINGS.SKIN_DESCRIPTIONS.rabbithouse_carrat"
msgid "A cozy abode fashioned after the adorable Carrat."
msgstr "Una residencia acogedora inspirada en la adorable ratahoria."

#. STRINGS.SKIN_DESCRIPTIONS.rainhat_bonnet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.rainhat_bonnet"
msgid "A dear little bonnet to keep your head dry."
msgstr "Un distinguido tocado para mantener tu cabeza seca."

