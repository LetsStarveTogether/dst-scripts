msgstr "Sin importar qué, supongo que solo es una verdura con conciencia."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
