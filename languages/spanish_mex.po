msgstr "Guantes de color “amarillo sulfúrico” adecuados para todo tipo de personas, robots y monstruos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_black_scribble
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_black_scribble"
msgid "These are gloves. They cover your hands. This pair is 'scribble black' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “negro garabato”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_blue_cornflower
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_blue_cornflower"
msgid "These are gloves. They cover your hands. This pair is 'rubber glove blue' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “azul guante de goma”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_grey_dark
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_grey_dark"
msgid "These are gloves. They cover your hands. This pair is 'stormcloud gray' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “gris nube de tormenta”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_navy_midnight
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_navy_midnight"
msgid "These are gloves. They cover your hands. This pair is 'begs the question blue' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “azul pregunta obligada”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_purple_violet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_purple_violet"
msgid "These are gloves. They cover your hands. This pair is 'plethora of purple' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “plétora de morado”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_red_higgsbury
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_red_higgsbury"
msgid "These are gloves. They cover your hands. This pair is 'Higgsbury red' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “rojo Higgsbury”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_white_smoke
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_shortgloves_white_smoke"
msgid "These are gloves. They cover your hands. This pair is 'smoke white' colored."
msgstr "Unos guantes. Te cubren las manos. Este par es de color “blanco humo”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_candyman
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_candyman"
msgid "For hand-making each tasty treat with care."
msgstr "Para preparar a mano y con delicadeza todas las deliciosas botanas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_warly_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_warly_rose"
msgid "Gloved hands tend the finest roses."
msgstr "Las manos enguantadas atienden a las rosas más finas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_gladiator"
msgid "These fists are ready for glorious battle."
msgstr "Estos puños están listos para buscar la gloria en el combate."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_magma"
msgid "Battle gloves to withstand the flames that will consume this world."
msgstr "Unos guantes de batalla para resistir las llamas que consumirán este mundo."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_nature"
msgid "These wrist coverings belong to someone who is at home in the woods."
msgstr "Estas cubiertas para las muñecas pertenecen a alguien que se siente como en casa en el bosque."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_scarecrow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_scarecrow"
msgid "Straw isn't quite as good as a fist for battle... unless your enemy has hay fever."
msgstr "La paja no es tan efectiva en batalla como un puño... a menos que tu enemigo tenga la fiebre del heno."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_victorian"
msgid "A pair of thin cloth gloves, likely worn by an actress."
msgstr "Un par de finos guantes de tela que quizás haya usado una actriz."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_wrestler"
msgid "Hand wraps and padded gloves mean hands are protected for better punches."
msgstr "Con unas envolturas y guantes acolchados, las manos estarán protegidas para lograr mejores golpes."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wathgrithr_yule"
msgid "Blend in to the blue-white tundra with ease."
msgstr "Mézclate fácilmente con los tonos blanquecinos azulados de la tundra."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_formal"
msgid "White gloved hands are sometimes a symbol of deception. They're also a symbol of fashion!"
msgstr "Las manos con guantes blancos a veces son un símbolo de engaño. ¡Son también un símbolo de moda!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_gladiator"
msgid "The handwraps of an alchemist, skilled at battle."
msgstr "Los cubremanos de un alquimista hábil para el combate."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_magma"
msgid "Gloves worthy of wrathful combat."
msgstr "Unos guantes para combates feroces."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_nature"
msgid "There's a perpetual dew dotting the leaves on the back of these gloves."
msgstr "Hay un rocío perpetuo que salpica las hojas en la parte posterior de estos guantes."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_vampire
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_vampire"
msgid "A vampiric gentleman never leaves the coffin without his gloves."
msgstr "Un caballero vampírico nunca sale de su ataúd sin sus guantes."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_victorian"
msgid "A pair of white gloves for a high class snob."
msgstr "Un par de guantes blancos para un snob de clase alta."

#. STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_waxwell_yule"
msgid "Why leave the house when your riches are at home?"
msgstr "¿Por qué salir de casa si tu fortuna está en ella?"

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_gladiator"
msgid "Perhaps after battle you could take up decorative hedge trimming."
msgstr "Quizá podrías ir a clases de decoración de setos después de la batalla."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_magma"
msgid "Like little candle flames for your claws."
msgstr "Como pequeñas llamas de vela para tus garras."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_punk
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_punk"
msgid "The spikes on these cuffs look scary, but they're actually quite soft."
msgstr "Las púas de esas pulseras dan miedo, pero en realidad son bastante suaves."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_victorian"
msgid "A pair of cuffs to wear when studiously practicing the three Rs."
msgstr "Un par de puños para llevar mientras se practican estudiosamente las tres R."

#. STRINGS.SKIN_DESCRIPTIONS.hand_webber_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_webber_wrestler"
msgid "These claw-some mitts are padded so no one will really get hurt."
msgstr "Estos mitones garrudos son acolchados para que nadie salga herido."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_gladiator"
msgid "These handwraps are imbued with a quiet ferocity."
msgstr "Estos cubremanos están imbuidos con una ferocidad tremenda."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_handmedown
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_handmedown"
msgid "These carefully woven daisy bracelets remind you of brighter days."
msgstr "Estos brazaletes de margaritas cuidadosamente tejidos me hacen recordar días más felices."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_ice"
msgid "A thin pair of winter gloves."
msgstr "Un par muy fino de guantes de invierno."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_magma"
msgid "Flaming winged accessories to accompany your rebirth."
msgstr "Accesorios alados ardientes para acompañar tu renacimiento."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wendy_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wendy_victorian"
msgid "Soft gloves to hold your heartbreak."
msgstr "Guantes suaves para contener tu desamor."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_gladiator"
msgid "A light gauntlet design for an expert duelist."
msgstr "Un guantelete de luz diseñado para un duelista experto."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_magma"
msgid "Fancy fingers for fiery fighting."
msgstr "Unos dedos bonitos para una lucha ardiente."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_nature"
msgid "Gloves to paint cheery, small trees in."
msgstr "Unos guantes para pintar árboles alegres y pequeños."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_victorian"
msgid "These were white gloves when you first started in the sweep business."
msgstr "Eran guantes blancos cuando empezaste a limpiar chimeneas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_wrestler"
msgid "Your challengers can't handle how gorgeous these gloves are."
msgstr "Tus rivales no pueden soportar lo bonitos que son estos guantes."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wes_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wes_yule"
msgid "Jolliness at your finger tips!"
msgstr "¡Felicidad en la punta de tus dedos!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_gladiator"
msgid "A thin strip of cloth to protect your caster's hands."
msgstr "Una tira delgada de tela para proteger las manos del hechicero."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_ice"
msgid "Sleek arm covers that radiate cool, clear refinement."
msgstr "Tapabrazos brillantes que irradian un refinamiento claro y fresco."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_magma"
msgid "Armored gloves for handling hot magma samples."
msgstr "Unos guantes de armadura para manejar muestras de magma."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_spiderwitch
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_spiderwitch"
msgid "You'll go batty for these sleeves!"
msgstr "¡Quedarás loco como murciélago cuando uses estas mangas!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wickerbottom_victorian"
msgid "You'll be the envy of all at the luncheon in this refined number."
msgstr "Serás la envidia de todos en el almuerzo con esta prenda refinada."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_gladiator"
msgid "A fine leather set of bracers to wear into battle."
msgstr "Un conjunto atractivo de brazales de cuero para usar en la batalla."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_haunteddoll
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_haunteddoll"
msgid "This doll was found in the attic of someone's late grandmother, as all haunted dolls must legally be."
msgstr "Esta muñeca fue encontrada en el ático de la abuela fallecida de alguien, donde deben estar legalmente todas las muñecas encantadas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_ice"
msgid "Two small tufts of rabbit fur to adorn the wrists."
msgstr "Dos penachos pequeños de pelo de conejo que adornan las muñecas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_magma"
msgid "Impress a deity with these sacrificial bangles."
msgstr "Impresiona a una deidad con estos brazaletes sacrificiales."

#. STRINGS.SKIN_DESCRIPTIONS.hand_willow_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_willow_victorian"
msgid "These matchstick seller gloves do little to keep out the cold."
msgstr "Estos guantes de vendedor de cerillos apenas pueden protegerte del frío."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_formal"
msgid "These gloves will hide the chemical stains on your hands when you dress up for formal occasions."
msgstr "Estos guantes ocultan las manchas químicas de tus manos cuando te vistes para ocasiones formales."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_gladiator"
msgid "These bracers will help you look the part in the arena."
msgstr "Estos brazales te ayudan a ponerte a la altura de la arena."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_ice"
msgid "The gloves of a fellow with an icy touch."
msgstr "Los guantes de alguien que posee un toque frío."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_madscientist
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_madscientist"
msgid "Laboratory gloves imbued with mercury, to encourage madness. (Don't try this at home.)"
msgstr "Guantes de laboratorio bañados en mercurio para alentar la locura. (No intentes hacer esto en casa.)"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_magma"
msgid "Rock hard gloves, sure to intimidate."
msgstr "Unos guantes duros como una piedra que de seguro intimidan."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wilson_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wilson_victorian"
msgid "Don't worry, this won't hurt a bit!"
msgstr "¡No te preocupes! ¡Casi no te dolerá!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_factory
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_factory"
msgid "Standard issue Voxola workgloves, so you don't get fingerprints on the merchandise."
msgstr "Guantes de trabajo estándar de Voxola. Para que no dejes tus huellas en la mercancía."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_gladiator"
msgid "Any pair of gloves can be improved by brass plating."
msgstr "Cualquier par de guantes luce mejor al colocarle una placa de latón."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_magma"
msgid "Perfectly welded welding gloves."
msgstr "Unos guantes de soldadura perfectamente soldados."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_nature"
msgid "These once-thick gardening gloves are old and worn. They won't provide much protection anymore."
msgstr "Estos guantes de jardinería, en su día gruesos, ahora están viejos y gastados. Ya no proporcionarán mucha protección."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_victorian"
msgid "Thick gloves for transferring smelted metals."
msgstr "Guantes gruesos para transferir metales fundidos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_wrestler"
msgid "Awesome gloves for an awesome lady."
msgstr "Unos guantes fantásticos para una señorita fantástica."

#. STRINGS.SKIN_DESCRIPTIONS.hand_winona_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_winona_yule"
msgid "Long gloves with a wreath of showy fur."
msgstr "Guantes largos con muñequeras de pelaje ostentoso."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_gladiator"
msgid "Your mighty fists need no armor, only slight embellishment."
msgstr "Tus puños poderosos no requieren de protección alguna, sino de ornamentación."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_ice
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_ice"
msgid "These gloves fail to keep the cold out, although they inspire a feeling of coziness."
msgstr "Estos guantes no te protegerán del frío, pero al menos transmiten una sensación acogedora."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_magma"
msgid "Flaming adornments for your wrists."
msgstr "Adornos llameantes para las muñecas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_victorian"
msgid "Left hook! Right hook! Jab, jab!"
msgstr "¡Gancho de izquierda! ¡Gancho de derecha! ¡Corto, corto!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wolfgang_wrestler"
msgid "Fingerless gloves for delivering the smack down."
msgstr "Guantes sin dedos para derribar al oponente."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_gladiator"
msgid "These leather gloves have small holes cut in them for the knuckles to show through."
msgstr "Estos guantes de cuero tienen unos agujeros pequeños para que puedan apreciarse los nudillos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hockey
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_hockey"
msgid "These gloves were made to be thrown down."
msgstr "Estos guantes están hechos para quitárselos antes de una pelea."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_magma"
msgid "Studded gloves for peerless gripping of an axe."
msgstr "Unos guantes tachonados para lograr un agarre incomparable del hacha."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_nature"
msgid "These wrist bands have been delicately woven by deft hands."
msgstr "Estas muñequeras fueron delicadamente tejidas por hábiles manos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_victorian"
msgid "Keep your hands free for tanning pelts!"
msgstr "¡Mantén las manos libres para curtir pieles!"

#. STRINGS.SKIN_DESCRIPTIONS.hand_woodie_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_woodie_yule"
msgid "There are legends of a lone figure who wanders the snow-laden woods, tending to the trees with heavy, callused hands."
msgstr "Hay una leyenda que habla acerca de una figura solitaria que vaga por los bosques cubiertos de nieve, y se ocupa de los árboles con sus manos fuertes y callosas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_brown_chocolate
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_brown_chocolate"
msgid "These 'insufficient chocolate brown' colored gloves look like they should be protective, but they really aren't."
msgstr "Estos guantes de color “marrón chocolate insuficiente” parecen protectores, pero en realidad no lo son."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_grey_gainsboro
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_grey_gainsboro"
msgid "These 'silver gray' colored gloves look like they should be protective, but they really aren't."
msgstr "Estos guantes de color “gris plata” parecen protectores, pero en realidad no lo son."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_red_higgsbury
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_red_higgsbury"
msgid "These 'Higgsbury red' colored gloves look like they should be protective, but they really aren't."
msgstr "Estos guantes de color “rojo Higgsbury” parecen protectores, pero en realidad no lo son."

#. STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_tan_grass
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_workgloves_tan_grass"
msgid "These 'dry grass tan' colored gloves look like they should be protective, but they really aren't."
msgstr "Estos guantes de color “moreno hierba seca” parecen protectores, pero en realidad no lo son."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_cactus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_cactus"
msgid "Hands for prickling and tickling."
msgstr "Manos para dar pinchazos y hacer cosquillas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_mushroom
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_mushroom"
msgid "These fungal hands really grow on you."
msgstr "Les empiezas a agarrar el gusto a estas manos con hongos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_rose"
msgid "Limbs as elegant as the rose from which they grow."
msgstr "Guantes tan elegantes como la rosa de la que salieron."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wormwood_shadow"
msgid "Just one touch from these poisonous leaves could spell your doom."
msgstr "Solo un roce de estas hojas venenosas podría ser tu perdición."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_minotaur
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_minotaur"
msgid "A pair of monstrous minotaur claws sporting golden bracers."
msgstr "Un par de monstruosas garras de minotauro luciendo brazales de oro."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_original
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_original"
msgid "The fuzzy paws of a sweet forest fawn."
msgstr "Las patas peludas de un encantador cervatillo del bosque."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wortox_survivor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wortox_survivor"
msgid "Sharp goblin claws honed for wilderness survival."
msgstr "Unas afiladas garras de duende preparadas para la sobrevivencia en la naturaleza."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_cave
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_cave"
msgid "These claws were made for poking around in the dark."
msgstr "Estas garras están hechas para hurgar en la oscuridad."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_formal"
msgid "Elegant and re-finned."
msgstr "Elegantes, refinadas y “aleta-rgadas”."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_rose"
msgid "Pink and pointy pointers."
msgstr "Guantes puntiagudos y rosados."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wurt_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wurt_shadow"
msgid "Those fins look ominous..."
msgstr "Esas aletas se ven amenazantes."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_gladiator
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_gladiator"
msgid "Make them regret falling into your metallic clutches."
msgstr "Haz que se arrepientan de haber caído en tus garras metálicas."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_magma
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_magma"
msgid "Com-bust some heads in style sporting these Furnace Gloves."
msgstr "Haz que ardan algunas cabezas con estos guantes de horno."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_nature
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_nature"
msgid "Get in touch with nature with these clinging vine hand replacements."
msgstr "Entra en contacto con la naturaleza con estas manos postizas de vid."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_victorian"
msgid "These diving suit gloves are old and worn. They probably aren't waterproof anymore."
msgstr "Estos guantes de traje de buceo están viejos y desgastados. Es probable que ya no sean impermeables."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wip
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wip"
msgid "Just wires and bolts."
msgstr "No son más que cables y tornillos."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wrestler
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_wrestler"
msgid "These gears were made for grappling."
msgstr "Estos engranes fueron hechos para luchar."

#. STRINGS.SKIN_DESCRIPTIONS.hand_wx78_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hand_wx78_yule"
msgid "Wooden hands don't get quite as cold as metal ones."
msgstr "Las manos de madera no se enfrían tanto como las de metal."

#. STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_catcoon_costume"
msgid "Is that really a cap with a catcoon's face? You've gotta be kitten me!"
msgstr "¿Eso es un gorro con cara de gapache? ¿O acaso me engatusaron?"

#. STRINGS.SKIN_DESCRIPTIONS.hat_chester_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_chester_costume"
msgid "They say that imitation is the sincerest form of flattery."
msgstr "La imitación es la forma más sincera de halago."

#. STRINGS.SKIN_DESCRIPTIONS.hat_dog_helm
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_dog_helm"
msgid "BEWARE OF DOG."
msgstr "CUIDADO CON EL PERRO."

#. STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_glommer_costume"
msgid "The goopiness inside the rim makes it glom to your head that much better!"
msgstr "La viscosidad del interior hace que se pegue mejor a la cabeza."

#. STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costume
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_hutch_costume"
msgid "It's a Hutch hatch, for your head!"
msgstr "¡Es una conejera, para tu cabeza!"

#. STRINGS.SKIN_DESCRIPTIONS.hat_puppy_cap
msgctxt "STRINGS.SKIN_DESCRIPTIONS.hat_puppy_cap"
msgid "Not made of real puppies."
msgstr "No está hecho con mascotas de verdad."

#. STRINGS.SKIN_DESCRIPTIONS.heatrock_fire
msgctxt "STRINGS.SKIN_DESCRIPTIONS.heatrock_fire"
msgid "A vibrant flame extracted in crystallized form from a passionate soul."
msgstr "Una llama vibrante extraída en forma cristalizada de un alma apasionada."

#. STRINGS.SKIN_DESCRIPTIONS.icebox_coffin
msgctxt "STRINGS.SKIN_DESCRIPTIONS.icebox_coffin"
msgid "Send your food to an icy grave."
msgstr "Envía tu comida a una tumba helada."

#. STRINGS.SKIN_DESCRIPTIONS.icebox_crystal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.icebox_crystal"
msgid "As icy inside as it is outside."
msgstr "Es tan fría por dentro como por fuera."

#. STRINGS.SKIN_DESCRIPTIONS.icebox_porcelain
msgctxt "STRINGS.SKIN_DESCRIPTIONS.icebox_porcelain"
msgid "Cold and pristine, like new-fallen snow."
msgstr "Fría e inmaculada, como la nieve recién caída."

#. STRINGS.SKIN_DESCRIPTIONS.icebox_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.icebox_victorian"
msgid "A sophisticated ice box, for the sophisticated wilderness dweller."
msgstr "Una caja de hielo sofisticada para el habitante en la naturaleza sofisticado."

