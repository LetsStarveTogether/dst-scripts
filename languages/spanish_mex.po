#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Got it! What is it?"
msgstr "¡Lo tengo! ¿Qué es?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Just a little more..."
msgstr "Solo un poquito más..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Woby look! There's something in there!"
msgstr "¡Woby, mira! ¡Hay algo ahí dentro!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Got it! What is it?"
msgstr "¡Lo tengo! ¿Qué es?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Darnit, I must've done something wrong..."
msgstr "¡Rayos! Debo haber hecho algo mal."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOSQUITOS"
msgid "Zhey vant to suck our bloood!"
msgstr "¡Quierren chuparrnos la sangrre!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Oh. I think they're hurt."
msgstr "Oh. Creo que está herido."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERAFK"
msgid "No, wait! I can do this!"
msgstr "¡No, espera! ¡Puedo hacerlo!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERGIFT"
msgid "There's monsters around! I don't want to miss anything!"
msgstr "¡Hay monstruos cerca y no me los quiero perder!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSIESTA"
msgid "This isn't the best time for a siesta."
msgstr "Este no es el mejor momento para tomar una siesta."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODANGERSLEEP"
msgid "I'm not scared! I just can't sleep..."
msgstr "¡No estoy asustado! Solo no puedo dormir."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep with the sun in my eyes."
msgstr "No puedo dormir con el sol pegándome en los ojos."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I can't sleep now!"
msgstr "¡Ahora no puedo dormir!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Maybe if I have a snack first."
msgstr "Quizá podría dormir si me como una botana primero."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOHUNGERSLEEP"
msgid "I can't sleep on an empty stomach..."
msgstr "No puedo dormir con el estómago vacío."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'll have to get down first."
msgstr "Primero me tengo que bajar."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd rather just go to bed."
msgstr "Preferiría irme a la cama."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I can't rest now! There's too much to look at down here!"
msgstr "¡No puedo descansar en este momento! ¡Hay demasiadas cosas que ver aquí abajo!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Um... that's on fire."
msgstr "Mmm... eso se está quemando."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "That seems like a bad idea."
msgstr "Eso parece una mala idea."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_NO_TRAP"
msgid "Huh. I thought for sure there would be a trap."
msgstr "Ah. Estaba seguro de que habría una trampa."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Er... that was just for practice."
msgstr "Eh... esa fue de práctica."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Hey! No fair!"
msgstr "¡Oye! ¡No es justo!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Hmm-hm hmmm, hm-de-dum..."
msgstr "Mmm... mm... mmm..., mm, di, dum..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Well. I'm kind of bored."
msgstr "Bueno, estoy algo aburrido."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Do you think we should try somewhere else Woby?"
msgstr "¿Crees que deberíamos intentar en otro lado, Woby?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I wonder if fish tell scary stories about us?"
msgstr "Me pregunto si los peces contarán historias de terror sobre nosotros."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Darnit!"
msgstr "¡Rayos!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Just reel it in a little... just like they taught us..."
msgstr "Solo debo recoger el sedal un poco... como nos enseñaron."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Is that a real sea monster?"
msgstr "¿Es un monstruo marino de verdad?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PECKED"
msgid "Ouch!! Th-that hurt!"
msgstr "¡Ay! ¡Eso dolió!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PETRIFED_TREES"
msgid "I scream, you scream, the trees scream!"
msgstr "¡Helado, me como un helado y los árboles quedaron congelados!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "I'm pretty sure that's not how it's supposed to look."
msgstr "Estoy bastante seguro de que no debería verse así."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_QUAKE"
msgid "Did you feel that, Woby?"
msgstr "¿Sentiste eso, Woby?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REPELLED"
msgid "Look at those defenses! how does he do that?"
msgstr "¡Mira su defensa! ¿Cómo lo hace?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RESEARCH"
msgid "I memorized my Pinetree Pioneer handbook, I can memorize this!"
msgstr "Si memoricé el manual del Pionero Pino, ¡puedo memorizar esto!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Aaah... I don't want to do that again."
msgstr "Ahhh. No quiero hacerlo de nuevo."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "You look better already!"
msgstr "¡Ya tienes mejor aspecto!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_REVIVING_CORPSE"
msgid "Don't worry! I have a badge in first aid!"
msgstr "¡No te preocupes! ¡Tengo una medalla de primeros auxilios!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.1"
msgid "Hey! Nice crown!"
msgstr "¡Oye, bonita corona!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.2"
msgid "Your royal crowned-ness."
msgstr "Su “Coroneza” real."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_ROYALTY.3"
msgid "Your majesty."
msgstr "Su majestad."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_RUINS_RESET"
msgid "Hey Woby, look! The monsters are back!"
msgstr "¡Oye, Woby, mira, los monstruos están de vuelta!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_NO"
msgid "This thing is impossible to open!"
msgstr "¡Es imposible abrir esta cosa!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SACREDCHEST_YES"
msgid "That wasn't hard at all."
msgstr "No fue muy difícil."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SHELTER"
msgid "What would we do without trees?"
msgstr "¿Qué sería de nosotros sin los árboles?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.1"
msgid "Uh oh... I'm all out of ammo."
msgstr "Oh, oh... se me acabó la munición."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.2
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SLINGHSOT_OUT_OF_AMMO.2"
msgid "Uh... just kidding!"
msgstr "Eh... ¡solo estaba bromeando!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SNARED"
msgid "Hey!"
msgstr "¡Oye!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SOAKED"
msgid "I'm going to get all pruney!"
msgstr "¡Me va a dar un resfriado!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_SPOOKED"
msgid "Is... someone there?"
msgstr "¿Hay alguien... ahí?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_FIREWENTOUT.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_FIREWENTOUT.1"
msgid "Darnit, the fire went out right at the best part!"
msgstr "Rayos. ¡El fuego se apagó justo en la mejor parte!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_NOT_NIGHT.1
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_STORYTELLING_ABORT_NOT_NIGHT.1"
msgid "To be continued..."
msgstr "Continuará..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_THORNS"
msgid "Aaah!! Ow!! It hurts! Were those poisonous?!"
msgstr "¡¡Aaahh!! ¡Ay! ¡Duele! ¡¿Son venenosas?!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_THURIBLE_OUT"
msgid "I think it's out of fuel."
msgstr "No tiene combustible."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPED"
msgid "Darnit... he got away."
msgstr "Rayos... se escapó."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOADESCAPING"
msgid "Hey wait! Come back!"
msgstr "¡Oye, espera! ¡Vuelve!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOOL_SLIP"
msgid "I- I meant to do that!"
msgstr "¡Esa era mi intención!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TORCH_OUT"
msgid "Uh oh... this is usually the part when something bad happens."
msgstr "Oh, oh. Esta es la parte en la que pasa algo malo."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Do you think I'll be the same person when I come out the other side?"
msgstr "¿Creen que seré la misma persona cuando salga del otro lado?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_TRAP_WENT_OFF"
msgid "It looked way easier in my handbook..."
msgstr "Se veía mucho más fácil de hacer en el manual."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_UNIMPLEMENTED"
msgid "I don't think it's done yet."
msgstr "No creo que esté terminada todavía."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WASHED_ASHORE"
msgid "Woby...? Oh good, you're okay!"
msgstr "Woby... ¡Oh, excelente, estás bien!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEAK_RAT"
msgid "This Carrat doesn't look healthy..."
msgstr "Esta ratahoria no parece estar muy sana."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Peso: {weight}"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nIs there a badge for heaviest fish?"
msgstr "Peso: {weight}\n¿No dan una medalla por el pez más pesado?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WET"
msgid "This is starting to get uncomfortable."
msgstr "Esto está empezando a incomodarme."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WETTER"
msgid "Did anyone remember to pack a towel?"
msgstr "¿Alguien trajo una toalla?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Next time I'll get it!"
msgstr "¡La próxima vez lo haré bien!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "What? Nothing?"
msgstr "¿Qué? ¿Nada?"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "It almost feels like I'm back home."
msgstr "Casi se siente como si estuviera de vuelta en casa."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Well, that was fun!"
msgstr "Bueno, ¡eso fue divertido!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMHOLE"
msgid "That was amazing!!"
msgstr "¡¡Eso fue asombroso!!"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS"
msgid "Something's moving..."
msgstr "Algo se está moviendo..."

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.DEER"
msgid "Sorry deer!"
msgstr "¡Lo siento, venadito!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.GENERIC"
msgid "Sorry!!"
msgstr "¡¡Lo siento!!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.PIG"
msgid "It didn't have to be like this!"
msgstr "¡No tenía que ser así!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.PREY"
msgid "Sorry, you're going to be dinner for me and Woby!"
msgstr "¡Lo siento, pero serás comida para Woby y para mí!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER"
msgid "This wouldn't be happening if you didn't try to eat me!"
msgstr "¡Esto no hubiese sucedido si no hubieses intentado comerme!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER_WARRIOR"
msgid "Take that! And that!"
msgstr "¡Toma eso! ¡Y esto!"

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.GENERIC"
msgid "Y-yeah! You better run!"
msgstr "¡S-sí! ¡Será mejor que corras!"

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PIG"
msgid "Let's just take a minute to cool our heads."
msgstr "Vamos a tomarnos un momento para calmarnos, ¿sí?"

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PREY"
msgid "Darnit! They got away."
msgstr "¡Rayos! Se escaparon."

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER"
msgid "I didn't really want to fight them anyway."
msgstr "De todas maneras, no tenía ganas de pelear."

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Nobody likes a bully."
msgstr "A nadie le gustan los bravucones."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Tu hermana me pone los pelos de punta, ¡pero tú me caes bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Did that flower just whisper something?"
msgstr "¿Esa flor acaba de susurrar?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I'd die to find out what it does."
msgstr "Me muero por saber qué hace."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think I should hang on to this."
msgstr "Creo que no debería quedarme con esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Oh, Abigail! I didn't recognize you."
msgstr "¡Oh, Abigail! No te reconocí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "Don't eat the haunted flower, Woby!"
msgstr "¡No te comas la flor poseída, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "You're not really as spooky when you're a flower."
msgstr "No eres tan espeluznante cuando eres una flor."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It hurts my soul to look at that thing."
msgstr "Me duele el alma de mirarla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's giving me the creeps."
msgstr "Me está poniendo los pelos de punta."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something is up with that flower!"
msgstr "¡Algo le pasa a esa flor!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I love checking tasks off a list!"
msgstr "¡Me encanta tachar tareas de mi lista!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN"
msgid "I wonder if there's any squirrels around."
msgstr "Me pregunto si habrá ardillas en los alrededores."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_COOKED"
msgid "Nutty."
msgstr "Qué rico sabor a nuez."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_SAPLING"
msgid "More firewood in the making!"
msgstr "¡Es leña en crecimiento!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Don't be scared Woby, we'll do this together!"
msgstr "No tengas miedo, Woby. ¡Haremos esto juntos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.AMULET"
msgid "I'm invincible!!'"
msgstr "¡¡Soy invencible!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR"
msgid "That's another important boat part."
msgstr "Esa es otra parte importante de un bote."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR_ITEM"
msgid "I've got all the supplies ready to build an anchor."
msgstr "Tengo todos los materiales listos para construir un ancla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR"
msgid "Do you think aliens helped them make it?"
msgstr "¿Crees que los alienígenas los ayudaron a construirla?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It looks broken to me."
msgstr "A mí me parece que está roto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_STATUE"
msgid "Woah! Is this what they looked like?"
msgstr "¡Vaya! ¿Así se veían?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANIMAL_TRACK"
msgid "Tracks! They go this way!"
msgstr "¡Huellas! ¡Se fue por aquí!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTCHOVIES"
msgid "I have mixed feelings."
msgstr "Tengo sentimientos encontrados sobre esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.GENERIC"
msgid "Hi!"
msgstr "¡Hola!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's hard to read her expression..."
msgstr "Es difícil descifrar su estado de ánimo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We're becoming pals already."
msgstr "Ya nos estamos volviendo amigos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONTRINKET"
msgid "Hm, I guess I could give it away as a gift?"
msgstr "Mmm, imagino que podría regalárselo a alguien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDRAGONFLY"
msgid "I still wish we could've been friends..."
msgstr "Me hubiese gustado ser su amigo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORGRASS"
msgid "Smells like a freshly mowed lawn."
msgstr "¡Huele a césped recién cortado!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORMARBLE"
msgid "Will I be able to walk in that?"
msgstr "¿Podré caminar usando eso?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORRUINS"
msgid "Woah! It's not even heavy!"
msgstr "¡Vaya! ¡No pesa nada!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSKELETON"
msgid "Yessss bone armor!!"
msgstr "¡Sííííí! ¡¡Una armadura de hueso!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSLURPER"
msgid "The smell kind of ruins my appetite."
msgstr "El olor arruina mi apetito."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSNURTLESHELL"
msgid "I'm the terrifying snail boy! Part boy, part snail!"
msgstr "¡Soy el aterrador niño caracol! ¡Mitad niño, mitad caracol!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWOOD"
msgid "Trees are pretty useful."
msgstr "Los árboles son bastante útiles."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_BRAMBLE"
msgid "No hugging while you're wearing that."
msgstr "Nada de abrazos mientras uses eso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_SANITY"
msgid "Wait... is this dangerous?"
msgstr "Espera... ¿esto es peligroso?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Hopefully it didn't say anything important."
msgstr "Esperemos que no haya tenido información relevante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "Someone has bad handwriting."
msgstr "Alguien tiene mala caligrafía."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Well... I guess SOMETHING is in that direction."
msgstr "Bueno... creo que hay ALGO en aquella dirección."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Hopefully it didn't say anything important."
msgstr "Esperemos que no haya tenido información relevante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Someone has bad handwriting."
msgstr "Alguien tiene mala caligrafía."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Well... I guess SOMETHING is in that direction."
msgstr "Bueno... creo que hay ALGO en aquella dirección."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.GENERIC"
msgid "Did someone have a campfire without me?"
msgstr "¿Alguien hizo una fogata sin mí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Aw, I liked that thing!"
msgstr "¡Ay! ¡Me gustaba esa cosa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "Too bad."
msgstr "Qué mal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Now I'll never know what it was..."
msgstr "Ahora nunca sabré qué era esa cosa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS"
msgid "It's not my favourite."
msgstr "No es mi comida favorita."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUSSOUP"
msgid "Asparagus again? Er, not that I'm complaining..."
msgstr "¿Otra vez espárragos? Eh... no es que me esté quejando, pero..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_COOKED"
msgid "I'll eat my vegetables."
msgstr "Tengo que comerme mis verduras."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Where should we plant them, Woby?"
msgstr "¿Dónde deberíamos sembrar esto, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "I guess we'll have to wait for it to power up."
msgstr "Creo que tenemos que esperar a que se cargue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "I guess I should give it a rest for now."
msgstr "Creo que debería dejarla enfriar por ahora."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Is it supposed to be making that sound?"
msgstr "¿Debe sonar así?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It looks like it's missing a piece."
msgstr "Parece que le falta una pieza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.ON"
msgid "It's working!"
msgstr "¡Funciona!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_KEY"
msgid "It's the key to this whole mystery!"
msgstr "¡Es la llave de todo este misterio!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "There's got to be a way to turn it on."
msgstr "Tiene que haber una forma de encenderlo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Well, we got the lights working!"
msgstr "¡Bueno, ya las luces están funcionando!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "What does it mean?!"
msgstr "¡¿Qué significa eso?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It looks like things weren't going so well for the people here."
msgstr "Parece que no todo fue color de rosa para las personas de aquí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "I can't tell what's happening in this one, the picture's worn off."
msgstr "No puedo descifrar qué pasa en esta. La imagen está desgastada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "There's... a shadow? Or something... they took some artistic liberties."
msgstr "Hay una... ¿sombra?, o algo por el estilo. Se tomaron algunas libertades artísticas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Woah, looks like they all started changing."
msgstr "¡Vaya! Parece que todas empezaron a cambiar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "That must be what the city looked like a long time ago."
msgstr "Así debió verse la ciudad hace mucho tiempo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_STATUE"
msgid "If it could speak, I wonder what it would tell us."
msgstr "Me pregunto qué nos diría si pudiera hablar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.AXE"
msgid "The favoured tool of axe murderers and loggers."
msgstr "La herramienta preferida de los asesinos con hacha y de los leñadores."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Hey little guy!"
msgstr "¡Hola, pequeñín!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Shhh! Woby, they're sleeping!"
msgstr "¡Shh! Woby, están durmiendo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BACKPACK"
msgid "Perfect for carrying supplies! And bugs!"
msgstr "¡Es perfecto para cargar provisiones! ¡Y bichos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BACONEGGS"
msgid "A good camping breakfast."
msgstr "Un buen desayuno de campamento."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOON"
msgid "My keen tracking senses are telling me there's a clown nearby."
msgstr "Mis agudos sentidos de rastreo me dicen que hay un payaso cerca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONS_EMPTY"
msgid "Someone left litter here!"
msgstr "¡Alguien dejó basura aquí!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAPOP"
msgid "Those are for little kids. But bananas are healthy so I guess it's alright."
msgstr "Esos son para los bebés, pero las bananas son saludables, así que creo que está bien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE"
msgid "You can never be too prepared when you're out in the wilderness."
msgstr "Nunca se puede estar demasiado preparado cuando se está en la selva."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE"
msgid "Foraged from the sea!"
msgstr "¡Lo encontré en el mar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLEPITA"
msgid "Further proof that anything can be a sandwich."
msgstr "Otra prueba de que todo puede convertirse en un sándwich."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "Uhh Woby? Do you want this one?"
msgstr "Eh, Woby, ¿quieres esto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESUSHI"
msgid "It's... interesting."
msgstr "Es… interesante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE_COOKED"
msgid "Hmm, it's not bad!"
msgstr "Mmm, no está mal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLINGUINE"
msgid "Just about anything tastes good with pasta."
msgstr "Casi todo sabe bien con pasta."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BASALT"
msgid "I don't think we'll be able to break through that."
msgstr "No creo que podamos abrirnos camino a través de eso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BAT"
msgid "Maybe if we're lucky it'll turn into a vampire!"
msgstr "Si tenemos suerte, ¡quizá se convierta en un vampiro!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATBAT"
msgid "Bat 'er up!"
msgstr "¡Para batear y aletear!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATCAVE"
msgid "Looks like they're sleeping. Should we wake them up?"
msgstr "Parece que están dormidos. ¿Los despertamos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATHBOMB"
msgid "It smells pretty good."
msgstr "Huele muy bien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING"
msgid "Where did the rest of the bat go?"
msgstr "¿Dónde está el resto del murciélago?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING_COOKED"
msgid "Uh... Woby, do you want this?"
msgstr "Eh, Woby, ¿quieres esto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARDHAIR"
msgid "Aw, I thought it was yeti fur..."
msgstr "Ay, creí que era pelaje del hombre de las nieves..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER"
msgid "Look at those razor sharp claws! I need to get a closer view!"
msgstr "¡Miren esas afiladas garras! Tengo que echar un vistazo más de cerca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERVEST"
msgid "Hey Woby, we match!"
msgstr "¡Oye, Woby! ¡Estamos combinados!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER_FUR"
msgid "It's so soft!"
msgstr "¡Es muy suave!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_FURRY"
msgid "It feels nice, like cuddling up with Woby."
msgstr "Se siente bien, como si te acurrucaras con Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_STRAW"
msgid "You make due with what you have out in the wilderness."
msgstr "Tienes que apañártelas con lo que encuentras en la selva."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.GENERIC"
msgid "Heh... sure wish I wasn't deathly allergic to them!"
msgstr "Je, je... ¡ojalá no fuera mortalmente alérgico a ellas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.HELD"
msgid "Ha ha... you wouldn't sting me... right little guy?"
msgstr "Ja, ja... no me vas a picar... ¿verdad, amiguita?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.BURNT"
msgid "What! Who burned the hive?"
msgstr "¿Qué? ¿Quién quemó la colmena?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Look at all that honey!"
msgstr "¡Miren toda esa miel!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.GENERIC"
msgid "Oh bees, why can't we be friends..."
msgstr "Oh, abejas, ¿por qué no podemos ser amigos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.NOHONEY"
msgid "They need a bit more time."
msgstr "Necesitan un poco más de tiempo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.READY"
msgid "Look at all that honey!"
msgstr "¡Miren toda esa miel!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "They're still busy making honey."
msgstr "Todavía están ocupadas haciendo miel."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "It burned up!"
msgstr "¡Se quemó!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "M-ma'am, I think your honey is ready."
msgstr "S-señora, creo que su miel está lista."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Don't panic Walter, the bees smell your fear..."
msgstr "No te asustes, Walter. Las abejas pueden oler el miedo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "It doesn't look like they've made any honey."
msgstr "Parece que no han hecho nada de miel."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "M-ma'am, I think your honey is ready."
msgstr "S-señora, creo que su miel está lista."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "There's some honey, but not enough to be worth the stings."
msgstr "Hay algo de miel, pero no la suficiente como para que valga la pena que me piquen."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "He's almost as friendly as Woby now."
msgstr "Ahora es casi tan amigable como Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Look Woby, we made a new friend!"
msgstr "¡Mira Woby, tenemos un nuevo amigo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.GENERIC"
msgid "He's almost as big as you are, Woby!"
msgstr "¡Es casi tan grande como tú, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.NAKED"
msgid "Don't worry Woby, I'd never do that to you... unless you had mats."
msgstr "No te preocupes, Woby, nunca te haría eso... a menos que tengas pulgas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.ORNERY"
msgid "Hey, what's wrong?"
msgstr "Oye, ¿qué ocurre?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.PUDGY"
msgid "We might need to cut back on the treats..."
msgstr "Creo que vamos a tener que darle menos botanas..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.RIDER"
msgid "Wanna go for a ride?"
msgstr "¿Quieres dar un paseo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.SLEEPING"
msgid "They're snoozing."
msgstr "Está durmiendo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOHAT"
msgid "It sure smells like beefalo..."
msgstr "Sin duda huele a beefalo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOWOOL"
msgid "Sorry, beefalo."
msgstr "Lo siento, beefalo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEGUARD"
msgid "They're just trying to protect their queen."
msgstr "Solo intentan proteger a su reina."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHAT"
msgid "I can finally walk among the bees!"
msgstr "¡Por fin puedo caminar entre las abejas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHIVE"
msgid "I reeaally shouldn't get closer..."
msgstr "De verdad, no debería acercarme..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE"
msgid "W-what could go wrong?"
msgstr "¿Q-qué podría salir mal?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE_MAXWELL"
msgid "How do I get the mosquitoes out?"
msgstr "¿Cómo saco a los mosquitos de ahí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEEN"
msgid "If I make friends with their queen, maybe the bees won't sting me!"
msgstr "Si me hago amigo de su reina, ¡quizá las abejas no me piquen!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I shouldn't walk on that, I'll get my shoes sticky."
msgstr "No debería caminar sobre eso o se me empezarán a pegar los zapatos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "It looks bigger than it did yesterday..."
msgstr "Se ve más grande que ayer..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Woah, it's huge!"
msgstr "¡Vaya! ¡Es gigante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX"
msgid "It's none of my beeswax. Heh..."
msgstr "La hicieron las abejas “gro-ceras”. Je, je..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEETLETAUR"
msgid "I can smell him from here!"
msgstr "¡Puedo olerlo desde aquí!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BELL"
msgid "What if we put it on your collar Woby?"
msgstr "¿Y si te la ponemos en el collar, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_ACTIVE"
msgid "Woah! Is your bear haunted? Cursed?"
msgstr "¡Vaya! ¿Tu oso está poseído o maldito?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_BIG"
msgid "If you play with fire, you're gonna get Bernie'd. Heh..."
msgstr "Jugar con fuego no te va a “bernieficiar”. Je, je..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "I-I'm sure we can fix him."
msgstr "Estoy seguro de que podemos arreglarlo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "He burnt himself out."
msgstr "Está agotado porque QUEMÓ muchas calorías."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES"
msgid "They're not in the poisonous section of my handbook, must be safe!"
msgstr "No están en la sección de bayas venenosas de mi manual, ¡así que deben ser seguras!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_COOKED"
msgid "Well, now I have hot berries."
msgstr "Bueno, ahora tengo bayas calientes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY"
msgid "Yes! These are the best kind!"
msgstr "¡Sí! ¡Estas son las mejores!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I should eat these fast."
msgstr "Debería comérmelas rápido."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BARREN"
msgid "My handbook says some kind of fertilizer should help."
msgstr "Mi manual dice que algún tipo de fertilizante podría ser de ayuda."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BURNING"
msgid "That's not a campfire..."
msgstr "Eso no es una fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Uh, something's definitely wrong with it."
msgstr "Ah. Definitivamente le pasa algo malo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Is something wrong with it?"
msgstr "¿Le pasa algo malo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Foraging is an important wilderness skill!"
msgstr "¡Saber buscar alimentos es una habilidad importante en la naturaleza!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.PICKED"
msgid "If I wait long enough, they'll grow back."
msgstr "Si espero lo suficiente, volverán a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It's way too hot out for anything to grow."
msgstr "Hace demasiado calor para que algo pueda crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It won't be making more berries anytime soon."
msgstr "No dará bayas pronto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "That's not a campfire..."
msgstr "Eso no es una fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Uh, something's definitely wrong with it."
msgstr "Ah. Definitivamente le pasa algo malo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Is something wrong with it?"
msgstr "¿Le pasa algo malo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "They look so tasty..."
msgstr "Se ven muy deliciosas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "More will grow soon."
msgstr "Pronto crecerán más."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I guess this isn't the season for berries."
msgstr "Creo que no es la temporada de bayas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYSAUCE"
msgid "It somehow tastes even better than regular berries!"
msgstr "¡De alguna forma, sabe mejor que las bayas normales!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIBINGKA"
msgid "Woah... where did we get the shaved coconut from?"
msgstr "¡Vaya! ¿De dónde fue que sacamos el coco rallado?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIGFOOT"
msgid "I knew he was real!"
msgstr "¡Sabía que era real!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRCHNUTDRAKE"
msgid "Hey little guy! What's got you all worked up?"
msgstr "¡Hola, amiguito! ¿Por qué estás tan molesto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.DEAD"
msgid "I'm... a terrible pet owner..."
msgstr "Soy... un dueño de mascotas terrible..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Now we just need to catch a bird!"
msgstr "¡Ahora solo nos falta atrapar un ave!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "We need some bird food!"
msgstr "Necesitamos un poco de comida para aves."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Aw, you miss the trees don't you?"
msgstr "Ay. Extrañas los árboles, ¿verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Someone should bury it."
msgstr "Alguien debería enterrarlo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Are you sleeping?"
msgstr "¿Estás durmiendo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh no! Did we forget to feed you?"
msgstr "¡Oh, no! ¿Olvidamos alimentarte?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDTRAP"
msgid "A bird trap! Classic survival stuff!"
msgstr "¡Una trampa para pájaros! ¡Un truco de supervivencia clásico!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG"
msgid "Egg-cellent! Get it? Because... egg...?"
msgstr "¡Ahora sí la PUSO! ¿Entienden? ¿Porque puso... un huevo...?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG_COOKED"
msgid "Smells like breakfast is ready!"
msgstr "Huele a que el desayuno está listo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP"
msgid "It's a Martian!"
msgstr "¡Es un marciano!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ah!! Why?!"
msgstr "¡Ah! ¡¿Por qué?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Oooh, look at that! What's that stuff oozing out of it?"
msgstr "¡Oh, miren eso! ¿Qué es esa cosa que sale de él?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_FIRE"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "No es tan buena como mi resortera, pero servirá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA"
msgid "That's a weapon I could use from range."
msgstr "Podría usar esta arma a distancia."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA2"
msgid "It uses a strong blast of air to propel a projectile."
msgstr "Emplea una fuerte ráfaga de aire para propulsar un proyectil."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_PIPE"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "No es tan buena como mi resortera, pero servirá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_SLEEP"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "No es tan buena como mi resortera, pero servirá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_YELLOW"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "No es tan buena como mi resortera, pero servirá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEAMULET"
msgid "Brr... how does it stay so cold?"
msgstr "Brr... ¿cómo se mantiene tan frío?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEGEM"
msgid "A magic blue gem!"
msgstr "¡Una gema azul mágica!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEMOONEYE"
msgid "You don't come across one of these very often."
msgstr "Uno no encuentra algo así todos los días."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.COMMON"
msgid "I'm great at following directions!"
msgstr "¡Soy muy bueno siguiendo instrucciones!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.RARE"
msgid "I think I found something interesting!"
msgstr "¡Creo que encontré algo interesante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP"
msgid "I'm preeetty sure this isn't the poisonous kind..."
msgstr "Estoy casi seguro de que este no es del tipo venenoso..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP_COOKED"
msgid "Nothing ventured, nothing gained!"
msgstr "¡Si no arriesgas nada, no ganas nada!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Hm... there's no blue mushrooms in my handbook..."
msgstr "Mmm... no hay champiñones azules en mi manual."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Woby, do you think you could dig it up? Guess not."
msgstr "Woby, ¿crees que puedas desenterrarlo? Creo que no."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will grow back eventually."
msgstr "Tal vez vuelva a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARDS"
msgid "Some boards."
msgstr "Son unas tablas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARON"
msgid "I can take him!"
msgstr "¡Puedo con él!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARRIOR"
msgid "You sure are big!"
msgstr "¡Sí que eres grande!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT03"
msgid "Looks like a sea monster got them."
msgstr "Parece que un monstruo marino los atacó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT04"
msgid "Looks like a sea monster got them."
msgstr "Parece que un monstruo marino los atacó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT05"
msgid "Looks like a sea monster got them."
msgstr "Parece que un monstruo marino los atacó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH"
msgid "Better to be prepared."
msgstr "Es mejor estar preparado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ITEM"
msgid "Let's get building, Woby!"
msgstr "¡Empecemos a construir, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_LEAK"
msgid "Don't worry! I have a badge in sailing, I know what to do!"
msgstr "¡No te preocupes! ¡Tengo una medalla de navegación, sé lo que debo hacer!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESHARD"
msgid "It's a bone!"
msgstr "¡Es un hueso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESOUP"
msgid "It really fills you up."
msgstr "De verdad te llena."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESTEW"
msgid "Tasty!"
msgstr "¡Qué bueno!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BIRDS"
msgid "I don't want to brag... but I do have a badge in birdwatching."
msgstr "No es por alardear, pero tengo una medalla de avistamiento de aves."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BRIMSTONE"
msgid "Wendy already spoiled the ending for me..."
msgstr "Wendy ya me arruinó el final."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_ELEMENTAL"
msgid "I can't make out the text."
msgstr "No entiendo el texto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FOSSIL"
msgid "This'll keep those monsters held for a little while."
msgstr "Esto contendrá a esos monstruos por un rato."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_GARDENING"
msgid "I already have my gardening badge."
msgstr "Ya tengo una medalla de jardinería."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SLEEP"
msgid "My idea of a bedtime story has a lot more monsters in it..."
msgstr "Mi idea de un cuento para dormir tiene muchos más monstruos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TENTACLES"
msgid "Oooh, this reminds me of a radio play where a ship gets eaten by a giant squid!"
msgstr "Oh, ¡esto me recuerda a un radioteatro en el que a un barco se lo come un calamar gigante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOMERANG"
msgid "Fetch, Woby!"
msgstr "¡Búscalo, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BRUSH"
msgid "Woby loves getting her fur brushed."
msgstr "A Woby le encanta que le cepillen el pelaje."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUGNET"
msgid "I'm an expert at catching bugs."
msgstr "Soy un experto atrapando insectos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "It's kelp... or a sea monster DISGUISING themselves as kelp."
msgstr "Es un quelpo... o un monstruo marino DISFRAZADO de quelpo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "I guess it's just kelp."
msgstr "Creo que solo es un quelpo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_ROOT"
msgid "I could plant this back in the ocean."
msgstr "Podría replantarlo en el océano."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLE"
msgid "It's packed full of provisions."
msgstr "Está lleno de provisiones."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLEWRAP"
msgid "Efficient packing is truly an overlooked art in camping."
msgstr "Empacar eficientemente sí que es un arte subestimado cuando se acampa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYMAN"
msgid "I've never heard of the Bunnyman before! Better make a note."
msgstr "¡Nunca antes había escuchado hablar del Hombre conejo! Mejor lo anoto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Guess it wasn't a bog monster after all."
msgstr "Creo que no era un monstruo del pantano después de todo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUSHHAT"
msgid "Camouflage!"
msgstr "¡Camuflaje!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTER"
msgid "This makes far more sense, honestly."
msgstr "Esto tiene muchísimo más sentido, sinceramente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.GENERIC"
msgid "I wonder if I can catch it."
msgstr "Me pregunto si podría atraparla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.HELD"
msgid "Gotcha!"
msgstr "¡Te tengo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYMUFFIN"
msgid "I feel kind of bad about the butterfly."
msgstr "Me da un poco de lástima la mariposa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYWINGS"
msgid "Nature's pretty amazing, isn't it?"
msgstr "La naturaleza es muy impresionante, ¿verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARD"
msgid "That seems like a bad sign."
msgstr "Eso no es una buena señal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CABBAGEROLLS"
msgid "This would make great camping food!"
msgstr "¡Esto será una excelente comida de campamento!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.GENERIC"
msgid "That's one prickly plant."
msgstr "Es una planta muy espinosa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.PICKED"
msgid "You'd better be tasty."
msgstr "Será mejor que sepas delicioso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_FLOWER"
msgid "It looks nice, but getting it was a pain."
msgstr "Es bonita, pero conseguirla fue un dolor de cabeza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT"
msgid "Maybe I should take out the spines first."
msgstr "Quizá debería quitarle las espinas primero."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "At least it's safe to eat now."
msgstr "Al menos ya es seguro comérsela."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CALIFORNIAROLL"
msgid "Is that raw fish?"
msgstr "¿Es pescado crudo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "¡Necesitamos más combustible para el fuego!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "¿Alguien quiere escuchar una historia de terror?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "¡Vaya! No creo que eso sea seguro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.LOW"
msgid "It might need some more fuel."
msgstr "Probablemente necesita un poco más de combustible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.NORMAL"
msgid "It's the perfect temperature for roasting marshmallows!"
msgstr "¡Tiene la temperatura perfecta para asar malvaviscos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.OUT"
msgid "Over already?"
msgstr "¿Ya se apagó?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.GENERIC"
msgid "Did you get lost too?"
msgstr "¿También estás perdido?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.HELD"
msgid "Hey, no pecking!"
msgstr "¡Oye, no me picotees!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY_POISONED"
msgid "This bird needs first aid!"
msgstr "¡Esta ave necesita primeros auxilios!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANDYBAG"
msgid "I'm too old for that stuff. But maybe I'll help out the younger kids..."
msgstr "Soy muy mayor para esas cosas, pero quizá deba ayudar a los niños más jóvenes a comerlas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANE"
msgid "Nothing like a good walking stick! Just don't chew on it this time, Woby."
msgstr "¡No hay nada mejor que un buen bastón! Esta vez no lo vayas a morder, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.DEAD"
msgid "Poor little thing."
msgstr "Pobrecita."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.GENERIC"
msgid "Vegetables are much more interesting here than back home."
msgstr "Las verduras son mucho más interesantes aquí que en mi mundo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.HELD"
msgid "Please don't nibble a hole in my pocket."
msgstr "Por favor, no vayas a roer mi bolsillo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.SLEEPING"
msgid "What do carrots dream about?"
msgstr "¿Qué soñarán las ratahorias?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Where can I get a shadow Carrat?"
msgstr "¿Dónde puedo obtener una ratahoria de sombras?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT"
msgid "I get kind of disappointed when it doesn't turn out to be a rat."
msgstr "Me decepciona un poco cada vez que las saco y no son ratas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_COOKED"
msgid "Yup. It's a cooked carrot."
msgstr "Sí. Es una zanahoria asada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_PLANTED"
msgid "Now we'll have more carrots. Yay."
msgstr "Ahora tendremos más zanahorias. Yupi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_SEEDS"
msgid "Those look like carrot seeds."
msgstr "Parece que son semillas de zanahoria."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "That's not a proper campfire!"
msgstr "¡Así no se hace una fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Someone wasn't practicing fire safety."
msgstr "Alguien no estaba siguiendo las medidas de protección contra incendios."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "We're mapping out the wilderness!"
msgstr "¡Estamos cartografiando la selva!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOON"
msgid "You're a weird looking raccoon."
msgstr "Eres un mapache muy extraño."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Nobody's home."
msgstr "No hay nadie en casa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I think something lives in there!"
msgstr "¡Creo que ahí vive algo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONHAT"
msgid "Now this is a hat made for the wilderness!"
msgstr "¡Este sí que es un sombrero de la selva!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Come on Woby, give me a hand moving this!"
msgstr "Vamos, Woby, ayúdame a mover esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't get to it!"
msgstr "¡No lo alcanzo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA"
msgid "I wouldn't mind stopping for a snack."
msgstr "No me importaría detenerme a comer una botana."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Whoops..."
msgstr "¡Uy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Well... it's a hot banana."
msgstr "Bueno... es una banana caliente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_TREE"
msgid "I didn't know bananas could grow in caves."
msgstr "No sabía que las bananas podían crecer en las cuevas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE"
msgid "That rock's blocking the entrance!"
msgstr "¡Esa roca bloquea la entrada!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people in there... I'll just wait."
msgstr "Hay demasiadas personas ahí dentro. Esperaré un rato."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Why can't we go in?"
msgstr "¿Por qué no podemos entrar?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Come on Woby! Let's take a look around!"
msgstr "¡Vamos, Woby! ¡Echemos un vistazo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "There's probably tons of good stuff in there."
msgstr "Probablemente hay muchas cosas geniales ahí dentro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people outside... let's just wait here."
msgstr "Hay demasiadas personas ahí afuera. Esperemos aquí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Guess we're stuck here Woby."
msgstr "Creo que estamos atrapados aquí, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Alright, let's go!"
msgstr "Muy bien, ¡vámonos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN"
msgid "There's some weird plants growing down here."
msgstr "Hay unas plantas extrañas creciendo aquí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CEVICHE"
msgid "Mushy, but tasty."
msgstr "Pastoso, pero sabroso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARCOAL"
msgid "You find a lot of these in fire pits."
msgstr "Uno puedo encontrar muchos de estos en las hogueras."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK1"
msgid "I don't think they're going to get up anytime soon."
msgstr "No creo que se vaya a levantar pronto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK2"
msgid "I don't think they're going to get up anytime soon."
msgstr "No creo que se vaya a levantar pronto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK3"
msgid "I don't think they're going to get up anytime soon."
msgstr "No creo que se vaya a levantar pronto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Technically this could still work as a real anchor."
msgstr "Técnicamente, esto podría servir como una verdadera ancla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANTLION"
msgid "She really shook you up, didn't she Woby?"
msgstr "Te asustó mucho, ¿no, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER"
msgid "It looks just like him!"
msgstr "¡Es igualito al real!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "At least I'm not allergic to bees made out of stone."
msgstr "Por lo menos no soy alérgico a las abejas hechas de piedra."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Woby doesn't seem to like it."
msgstr "A Woby no le gusta."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "It's coming to life!"
msgstr "¡Está volviendo a la vida!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It's not quite as good as a real bug collection, but close!"
msgstr "¡No es tan buena como una verdadera colección de insectos, pero se acerca bastante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CARRAT"
msgid "I usually prefer badges to trophies, but I might make an exception."
msgstr "Prefiero las medallas a los trofeos, pero creo que puedo hacer una excepción."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "He wasn't a very good dog."
msgstr "No era un buen perro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "Poor Woby. She never seems to get along with the other dogs."
msgstr "Pobre Woby. Parece que nunca se lleva bien con otros perros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CRABKING"
msgid "The crabbiest sea monster I've ever met!"
msgstr "¡El monstruo marino más gruñón que he visto!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I like this one!"
msgstr "¡Esta me gusta!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "If only we could've gotten along."
msgstr "Ojalá nos hubiésemos podido llevar bien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Ugh. Who would want to be stuck wearing a suit forever?"
msgstr "Agh. ¿Quién querría usar un traje para siempre?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "I'm starting to get hungry just looking at it..."
msgstr "Me está dando hambre con solo mirarla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Aw, it reminds me of the holidays."
msgstr "Ay, me recuerda a las festividades."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "What are you so worried about Woby? It's just a statue."
msgstr "¿Qué te preocupa tanto, Woby? Solo es una estatua."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Alright Woby, I stand corrected."
msgstr "De acuerdo, Woby, me equivoqué."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "She was pretty angry at us, wasn't she Woby?"
msgstr "Estaba muy molesto con nosotros, ¿verdad, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "This statue is... a-maze-ing! Get it?"
msgstr ""

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOON"
msgid "It tells folks to be-were! Get it?"
msgstr "A algunas personas literalmente les afecta la luna. ¿Entienden?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "It's a shame things had to end the way they did."
msgstr "Es una lástima que las cosas hayan acabado como lo hicieron."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MUSE"
msgid "It's just a statue."
msgstr "Solo es una estatua."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PAWN"
msgid "Pawns don't seem like statue material."
msgstr "Los peones no parecen ser buenas estatuas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PIPE"
msgid "It looks like one of those joke pipes you can mail in for."
msgstr "Parece una de esas tuberías por las que puedes enviar correo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's so lifelike!"
msgstr "¡Es muy realista!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Hey, I think it's moving!"
msgstr "Oye, ¡creo que se está moviendo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_STALKER"
msgid "Definitely on my top five list of skeletons."
msgstr "Definitivamente está en mi lista de los mejores cinco esqueletos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least this version doesn't smell like old mushrooms."
msgstr "Por lo menos esta versión no huele a champiñones viejos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER"
msgid "Who's a good little monster? You are!"
msgstr "¿Quién es un buen monstruito? ¡Tú lo eres!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "No chewing on this bone, okay Woby?"
msgstr "No puedes mordisquear este hueso, ¿de acuerdo, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Getting some well deserved shut-eye."
msgstr "Está tomando un descanso bien merecido."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHUM"
msgid "You use it to lure the fish in."
msgstr "Lo usas para atraer a los peces."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Who's a good boy?"
msgstr "¿Quién es un buen chico?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.STATUE"
msgid "I wonder who made these statues? They look so real!"
msgstr "Me pregunto quién hizo estas estatuas. ¡Se ven muy reales!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.GENERIC"
msgid "Don't worry, I'm good with dogs!"
msgstr "No se preocupen. ¡Les agrado a los perros!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.STATUE"
msgid "Woby's sure sniffing around this statue a lot."
msgstr "Woby está oliendo mucho esta estatua."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "¡Necesitamos más combustible para el fuego!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "¿Alguien quiere escuchar una historia de terror?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "¡Vaya! No creo que eso sea seguro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.LOW"
msgid "It might need some more fuel."
msgstr "Probablemente necesita un poco más de combustible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.NORMAL"
msgid "It's the perfect temperature for... cold marshmallows?"
msgstr "Tiene la temperatura perfecta para cocinar... ¿malvaviscos helados?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.OUT"
msgid "Over already?"
msgstr "¿Ya se apagó?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "¡Necesitamos más combustible para el fuego!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "¿Alguien quiere escuchar una historia de terror?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "¡Vaya! No creo que eso sea seguro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.LOW"
msgid "I might need to feed the fire a bit"
msgstr "Creo que necesito echarle un poco de leña al fuego."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's the perfect temperature for... cold marshmallows?"
msgstr "Tiene la temperatura perfecta para cocinar... ¿malvaviscos helados?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.OUT"
msgid "The fire pit's already built, all we need is more wood!"
msgstr "El pozo de la fogata ya está listo, ¡ahora lo único que necesitamos es más madera!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Este."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.GENERIC"
msgid "The Pinetree Pioneer handbook says to always bring a compass!"
msgstr "¡El manual del Pionero Pino dice que siempre debes llevar una brújula!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Norte."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Noreste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Noroeste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Sur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Sureste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Sudoeste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Oeste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTWRAP"
msgid "Oh, uh... that's alright, I'm not hungry."
msgstr "Oh, oh. Está bien, no tengo hambre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'm good at following instructions! I have a badge for it!"
msgstr "¡Soy muy bueno siguiendo instrucciones! ¡Tengo una medalla que lo demuestra!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKBOOK"
msgid "Looks like I've got a new guide to memorize!"
msgstr ""

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMANDRAKE"
msgid "Sorry little buddy."
msgstr "Lo siento, amiguita."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMEAT"
msgid "You can't beat cooking outdoors!"
msgstr "Nada le gana a cocinar al aire libre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Is it supposed to have that weird aftertaste?"
msgstr "¿Se supone que tenga ese extraño regusto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDSMALLMEAT"
msgid "A little meat is better than none."
msgstr "Un poquito de carne es mejor que nada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTER"
msgid "They're smiling! Wait, I think I was looking at them upside-down."
msgstr "¡Está sonriendo! Espera, creo que lo estaba mirando al revés."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERHAT"
msgid "It's a shellmet! Because it's a helmet, but a shell-- you get it."
msgstr "¡Es un “casparazón”! Porque es un casco, pero también un caparazón... Ustedes entienden."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERSHELL"
msgid "These guys have tough armor!"
msgstr "¡Esas criaturas tienen una armadura muy dura!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.BURNT"
msgid "It's uh... extra done!"
msgstr "Está... ¡muy listo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This might take a while. Wanna see this cool bug I found in the meantime?"
msgstr "Esto tomará un rato. Mientras tanto, ¿quieren ver un insecto genial que encontré?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost time to eat!"
msgstr "¡Casi es hora de comer!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.DONE"
msgid "Come and get it!"
msgstr "¡Vengan a comer!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.EMPTY"
msgid "Sure wish there was food in it."
msgstr "Me encantaría que tuviese comida dentro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COONTAIL"
msgid "It's a tall tail! Or, I guess more of a bushy one... never mind."
msgstr "¡Es una cola larga! O más bien es muy frondosa... no importa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN"
msgid "Some corn on the cob sounds pretty good right about now."
msgstr "Comer elotes suena perfecto ahora mismo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_COOKED"
msgid "I don't have anything to fund-raise for out here..."
msgstr "No puedo venderlos para recoger fondos aquí, así que..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_SEEDS"
msgid "We should plant these."
msgstr "Deberíamos sembrarlas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.GENERIC"
msgid "YES!! Now that's a proper sea monster!"
msgstr "¡¡SÍ!! ¡Eso sí que es un verdadero monstruo marino!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.INERT"
msgid "Who built this giant sand castle in the middle of the ocean?"
msgstr "¿Quién construyó este castillo de arena gigante en la mitad del océano?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CLAW"
msgid "Woah! Look at the size of those claws!"
msgstr "¡Vaya! ¡Miren el tamaño de esas pinzas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTERLAB"
msgid "What's wrong Woby? Is something in there?"
msgstr "¿Qué sucede, Woby? ¿Hay algo ahí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_DRAGONLING"
msgid "Play nice with Woby, okay?"
msgstr "Sé buena con Woby, ¿de acuerdo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_GLOMLING"
msgid "It's small for a monster, but big for a bug."
msgstr "Es muy pequeña para ser un monstruo, pero muy grande para ser un insecto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_KITTEN"
msgid "I'm usually more of a dog person, but you're so cute!"
msgstr "En lo personal, me gustan más los perros, ¡pero tú eres muy lindo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LAMB"
msgid "Aww, you're like a dust bunny that came to life!"
msgstr "Aay. ¡Tú pareces una bola de lana viviente!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Mom would never let me keep a pet bug this big!"
msgstr "¡Mi mamá nunca me dejaría tener un insecto mascota así de grande!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PERDLING"
msgid "What a funny little turkey."
msgstr "Qué pavo tan chistoso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PUPPY"
msgid "You and Woby will get along great!"
msgstr "Tú y Woby se llevarán de maravilla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.GENERIC"
msgid "Finally, something I recognize from my bird guide!"
msgstr "Por fin, ¡algo que reconozco de mi guía de aves!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.HELD"
msgid "A pocket isn't really the best place for a bird."
msgstr "Un bolsillo no es el mejor lugar para tener a un ave."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRUMBS"
msgid "Maybe they dropped them to find their way home?"
msgstr "Quizá las tiraron al piso para encontrar su camino de regreso a casa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTGRASS"
msgid "Look, I can make a whistle with it! PHHWEEEE!"
msgstr "Miren, ¡puedo hacer un silbato con esto! ¡PIIIIIIIIII!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLICHEN"
msgid "This won't keep for long."
msgstr "Esto se dañará rápido."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTREEDS"
msgid "Ms. Wickerbottom might need some more... reed-ing material."
msgstr "¿La Sra. Wickerbottom tendrá algún libro sobre los tipos de juncos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTSTONE"
msgid "It wasn't too hard!"
msgstr "¡No fue tan difícil!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEADLYFEAST"
msgid "Someone could get sick from eating that!"
msgstr "¡Alguien podría enfermarse si come eso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEAD_SEA_BONES"
msgid "These are definitely sea monster bones!"
msgstr "¡Definitivamente son los huesos de un monstruo marino!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "Se supone que primero cortes el árbol ¡y LUEGO hagas la fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Ese árbol no pudo esperar a convertirse en fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Qué árbol más tocón. Je, je. Buena esa, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Did you know the word deciduous means to \"fall off\"?"
msgstr "¿Sabían que la palabra “deciduo” significa “que cae”?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Woah! I've never seen a tree with teeth before!"
msgstr "¡Vaya! ¡Nunca antes había visto un árbol con dientes!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.ANTLER"
msgid "You could poke an eye out with those! Maybe he already did?"
msgstr "¡Podrías pincharle un ojo a alguien con eso! Quizá ya lo hizo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.GENERIC"
msgid "Hey Woby, do you guys go to the same barber?"
msgstr "Oye, Woby, ¿ustedes frecuentan el mismo barbero?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS"
msgid "Woah! It's you!"
msgstr "¡Vaya! ¡Eres tú otra vez!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "At least we got this souvenir."
msgstr "Por lo menos nos llevamos esto de recuerdo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_ANTLER"
msgid "Hey, you dropped this!"
msgstr "¡Oye! Se te cayó esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_GEMMED"
msgid "It can't be comfortable having a gem stuck in your forehead."
msgstr "No debe ser muy cómodo tener una gema metida en la frente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It hasn't grown back yet."
msgstr "Todavía no ha vuelto a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DESERTHAT"
msgid "It's important to dress appropriately for the environment."
msgstr "Es importante vestirse apropiadamente para el ambiente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL"
msgid "Weird! It looks like an axe, but..."
msgstr "¡Qué raro! Parece un hacha, pero..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL_NODEV"
msgid "Guess I haven't earned that badge yet."
msgstr "Creo que aún no me he ganado esa medalla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIRTPILE"
msgid "Woby, did you dig something up?"
msgstr "Woby, ¿desenterraste algo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.COLD"
msgid "Getting colder... must've taken a wrong turn."
msgstr "Se está enfriando... creo que no es el camino correcto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.GENERIC"
msgid "Hey! This looks a lot like that radio!"
msgstr "¡Oye! ¡Se parece muchísimo a la radio de aquella vez!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.HOT"
msgid "We're hot on the trail, Woby!"
msgstr "¡Esta pista está caliente, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARM"
msgid "Getting warm..."
msgstr "Se está calentando..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARMER"
msgid "Warmer..."
msgstr "Más caliente..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "This looks important."
msgstr "Esto parece importante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.READY"
msgid "Maybe I can unlock it with something..."
msgstr "Quizá puedo abrirlo con algo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It worked!"
msgstr "¡Funcionó!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODSTART"
msgid "Hey! This looks a lot like that radio!"
msgstr "¡Oye! ¡Se parece muchísimo a la radio de aquella vez!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBODYHAT"
msgid "I think I'd be better in the lead."
msgstr "Me gusta más ir a la cabeza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONCHILISALAD"
msgid "Is it made from real dragons?"
msgstr "¿Está hecho con dragones reales?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLY"
msgid "Woah! It's a giant bug!"
msgstr "¡Vaya! ¡Es un insecto gigante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST"
msgid "We'll have to find something worthy of going in there."
msgstr "Estoy seguro de que encontraremos algo digno que meter ahí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Can I cook marshmallows over it though?"
msgstr "Pero ¿puedo asar malvaviscos ahí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "...That didn't fix it."
msgstr "... Eso no lo arregló."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Roasty!"
msgstr "¡Bien tostado!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Toasty!"
msgstr "¡Calientito!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT"
msgid "Looks tasty."
msgstr "¡Se ve deliciosa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It makes sense that Dragon Fruit tastes better with fire."
msgstr "Tiene sentido que la fruta del dragón sepa mejor con fuego."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Let's find some place to plant these."
msgstr "Busquemos un lugar para plantarlas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONHEADHAT"
msgid "I'll be the leader!"
msgstr "¡Seré el líder!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONPIE"
msgid "Is it made from actual dragons?"
msgstr "¿Está hecho con dragones de verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONTAILHAT"
msgid "I don't want the back end..."
msgstr "No quiero ser la cola."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGON_SCALES"
msgid "Was she a bug or a lizard?"
msgstr "¿Era un insecto o un lagarto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_LOG"
msgid "You'll float too, if you hold onto it!"
msgstr "Tú también flotarás, ¡si te agarras a él!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "You're supposed to make a pit, gather the firewood and THEN make a fire!"
msgstr "Se supone que primero caves el hoyo, recolectes la leña y ¡LUEGO hagas la fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "That could've been bad."
msgstr "Eso pudo haber terminado muy mal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Thanks for the firewood, tree!"
msgstr "Gracias por la leña, árbol."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "Looks kind of eerie, doesn't it?"
msgstr "Eso se ve un poco escalofriante, ¿no?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK"
msgid "Is it a good idea to eat raw meat...?"
msgstr "¿Es buena idea comer carne cruda?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK_COOKED"
msgid "That's better!"
msgstr "¡Así está mejor!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH"
msgid "Come on berry bush, we're going on an adventure!"
msgstr "Vamos, arbusto de bayas, ¡nos vamos en una aventura!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "Come on berry bush, we're going on an adventure!"
msgstr "Vamos, arbusto de bayas, ¡nos vamos en una aventura!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_GRASS"
msgid "Now I can plant it closer to camp."
msgstr "Ahora puedo sembrarla cerca del campamento."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MARSH_BUSH"
msgid "Hey Woby, do you see a good spot to plant this?"
msgstr "Oye, Woby, ¿ves algún lugar donde pueda plantar esto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_SAPLING"
msgid "Hey Woby, do you see a good spot to plant this?"
msgstr "Oye, Woby, ¿ves algún lugar donde pueda plantar esto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I'm putting them in time out."
msgstr "Haré que tome unas vacaciones de su trabajo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN"
msgid "Yuck! What is that?"
msgstr "¡Aj! ¿Qué es eso?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_COOKED"
msgid "No thank you."
msgstr "No, gracias."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_SEEDS"
msgid "Not sure if I want to grow more of those."
msgstr "No sé si quiero cultivar más de estos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EARMUFFSHAT"
msgid "Some of us don't have ear fluff of our own, Woby."
msgstr "Algunos de nosotros no tenemos orejas peluditas, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL"
msgid "Look at the teeth it has!"
msgstr "¡Miren esos dientes!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL_COOKED"
msgid "That actually smells pretty good!"
msgstr "¡Esto de hecho huele muy bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT"
msgid "Even in the wilderness you have to eat your vegetables."
msgstr "Incluso en la selva hay que comer verduras."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_COOKED"
msgid "Oh, it's much better cooked!"
msgstr "Oh. ¡Sabe mucho mejor cocida!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_SEEDS"
msgid "We should find a place to plant these."
msgstr "Debería buscar un lugar dónde plantarlas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.BURNT"
msgid "That's how forest fires get started!"
msgstr "¡Así comienzan los incendios forestales!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.EMPTY"
msgid "Hey... I think I saw something move under there."
msgstr "Oigan... creo que vi algo moviéndose ahí abajo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Ta-da! Light!"
msgstr "¡Voilà! ¡Luz!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.GENERIC"
msgid "Is somebody decorating out here?"
msgstr "¿Hay alguien decorando por aquí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Looks like we need to replace a bulb."
msgstr "Parece que tenemos que cambiar un foco."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.WILTED"
msgid "Those flowers are looking pretty sad."
msgstr "Esas flores están muy tristes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "Se supone que primero cortes el árbol ¡y LUEGO hagas la fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Ese árbol no pudo esperar a convertirse en fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Qué árbol más tocón. Je, je. Buena esa, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.GENERIC"
msgid "They're called \"evergreen\" because... well you get the idea."
msgstr "Se les llama “árboles de hoja perenne” porque... bueno, ustedes entienden."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "Se supone que primero cortes el árbol ¡y LUEGO hagas la fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Ese árbol no pudo esperar a convertirse en fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Qué árbol más tocón. Je, je. Buena esa, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "What a scraggly tree."
msgstr "Qué árbol tan desaliñado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEBRELLAHAT"
msgid "It keeps an eye on me. Get it? Because it's a giant eyeball?"
msgstr "Me está echando un ojo. ¿Entienden? Porque es un globo ocular gigante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEPLANT"
msgid "Eye bet it's friendly!"
msgstr "¡Les apuesto un ojo a que es amigable!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET"
msgid "It's keeping an eye on me! Get it? Because it's... you know..."
msgstr "Me está echando un ojo. ¿Entienden? Porque es... ya saben."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET_ITEM"
msgid "Come on Woby, let's find a good place to put this!"
msgstr "Vamos, Woby. ¡Busquemos un buen lugar para poner esto!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.BURNT"
msgid "Darnit, now I have to start all over!"
msgstr "¡Rayos! ¡Ahora tengo que comenzar de nuevo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GENERIC"
msgid "Mom never let me in her garden... not since the Slug Incident."
msgstr "Mi mamá nunca me dejaba entrar a su jardín... no después del incidente de la babosa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GROWING"
msgid "Hey! I'm pretty good at this!"
msgstr "¡Oye! Soy muy bueno en esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs something to help it grow..."
msgstr "Necesita algo para que pueda crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERFAN"
msgid "I'm a big fan of staying cool. Get it, because it's a fan?"
msgstr "Cuando juego béisbol, no me gusta abanicar, pero con esto sí. ¿Entienden? Porque es un abanico..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERHAT"
msgid "And I thought my bird watching badge was a feather in my cap!"
msgstr "Y yo que pensaba que mi medalla de avistamiento de aves no se me iba a subir a la cabeza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERPENCIL"
msgid "I feel like I should write something poetic with this..."
msgstr "Siento que debería escribir algo poético con esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CANARY"
msgid "Looks like a canary feather."
msgstr "Parece una pluma de canario."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CROW"
msgid "Looks like a black bird feather."
msgstr "Parece una pluma de un pájaro negro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN"
msgid "Looks like a redbird feather."
msgstr "Parece una pluma de petirrojo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Looks like a snowbird feather."
msgstr "Parece una pluma de pinzón de las nieves."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEM_PUPPET"
msgid "Don't worry, a Pinetree Pioneer always helps those in need!"
msgstr "¡No te preocupes! ¡Un Pionero Pino siempre ayuda a aquellos que lo necesitan!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE"
msgid "Why do we need fences? It's the great outdoors!"
msgstr "¿Por qué necesitamos vallas si estamos al aire libre?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE"
msgid "It's open-and-shut."
msgstr "Se abre y se cierra. Sencillo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE_ITEM"
msgid "I guess I should find someplace to put that."
msgstr "Creo que debería buscar un lugar para poner esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ITEM"
msgid "Why fence in nature?"
msgstr "¿Por qué poner una valla en la naturaleza?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FERTILIZER"
msgid "Plants love poop."
msgstr "Las plantas aman la caca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVEFISH"
msgid "Fish with some special seasonal seasonings."
msgstr "Pescado con un aderezo de temporada especial."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "Invoca un meteorito de los cielos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRECRACKERS"
msgid "You're not supposed to set those off in the woods."
msgstr "No debes encenderlos en los bosques."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish I had a jar."
msgstr "Ojalá tuviera un tarro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.HELD"
msgid "Hope they get along with the other bugs in my pockets."
msgstr "Espero que se lleven bien con los otros insectos que tengo en los bolsillos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREHOUND"
msgid "Who's a good boy?"
msgstr "¿Quién es un buen chico?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "¡Necesitamos más combustible para el fuego!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "¿Alguien quiere escuchar una historia de terror?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "¡Vaya! No creo que eso sea seguro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.LOW"
msgid "I might need to feed the fire a bit."
msgstr "Creo que necesito echarle un poco de leña al fuego."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.NORMAL"
msgid "It's the perfect temperature for roasting marshmallows!"
msgstr "¡Tiene la temperatura perfecta para asar malvaviscos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.OUT"
msgid "The fire pit's already built, all we need is more wood!"
msgstr "El pozo de la fogata ya está listo, ¡ahora lo único que necesitamos es más madera!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESTAFF"
msgid "I'd better keep this away from the younger kids... and Willow."
msgstr "Mejor mantengo esto alejado de los niños más pequeños... y de Willow."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "We'd better give it some more fuel."
msgstr "Quizá deberíamos echarle un poco más de combustible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "It's conserving its energy."
msgstr "Está conservando su energía."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "That should keep us from setting the camp on fire... hopefully."
msgstr "Con suerte, eso evitará que le prendamos fuego al campamento."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH"
msgid "I'm great at catching fish! I got a badge and everything!"
msgstr "¡Soy muy bueno pescando! ¡Hasta me dieron una medalla por eso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGNET"
msgid "Hey Woby, want to go fishing?"
msgstr "Oye, Woby, ¿quieres ir a pescar?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGROD"
msgid "It's a fishing rod, you use it for fishing."
msgstr "Es una caña de pescar. La usas para pescar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT"
msgid "Is it okay to eat it raw?"
msgstr "¿Es seguro comérselo crudo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_COOKED"
msgid "Catching your own fish and eating it, real survivor stuff!"
msgstr "Atrapar tu propio pescado y comértelo... ¡eso sí es de sobrevivientes!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL"
msgid "Maybe I could use it as bait for a bigger fish."
msgstr "Supongo que podría usarlo como cebo para peces más grandes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "It smells good!"
msgstr "¡Huele muy bien!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHSTICKS"
msgid "Delicious, nutritious and full of fishes."
msgstr "Deliciosos, nutritivos y llenos de pescado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHTACOS"
msgid "The s'more of fish dishes!"
msgstr "¡Minisándwiches de pescado!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_BOX"
msgid "That'll keep our fish fresh!"
msgstr "Eso mantendrá nuestros pescados frescos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_COOKED"
msgid "Catching and cooking your own fish is what camping is all about!"
msgstr "Cocinar los peces que tú atrapaste, ¡de eso se trata acampar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLINT"
msgid "This should come in handy!"
msgstr "Esto podría ser útil."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.GENERIC"
msgid "Are there any bugs on it?"
msgstr "¿Tienen algún insecto encima?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.ROSE"
msgid "Funny, this isn't the type of rose you usually see in the wild."
msgstr "Qué raro. Este no es el tipo de rosas que suelen encontrarse en la selva."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERHAT"
msgid "Hey, that looks swell!"
msgstr "¡Oigan, eso se ve muy bonito!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERSALAD"
msgid "Even scavenged leaves can be food in the wilderness!"
msgstr "Incluso las hojas recogidas del suelo pueden ser comida en la selva."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE"
msgid "Pretty swell of those flowers to light the way for us!"
msgstr "¡Es genial que esas flores nos iluminen el camino!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_EVIL"
msgid "Woby, what's wrong? It's just a flower."
msgstr "Woby, ¿qué pasa? Solo es una flor."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_WITHERED"
msgid "Should I water it more? Or water it less?!"
msgstr "¿Debería regarla más? ¿O tal vez menos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE"
msgid "This would be great for starting a campfire."
msgstr "Esto sería ideal para una fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOOTBALLHAT"
msgid "Oh, football! Yeah I'm uh... great at football..."
msgstr "¡Oh, fútbol! Sí, soy muy bueno... en el fútbol..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_PIECE"
msgid "The bones of an ancient creature!"
msgstr "¡Los huesos de una criatura antigua!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "I think we figured it out Woby!"
msgstr "¡Creo que armamos el rompecabezas, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "\"The arm bone's connected to the...\" which bone was it..."
msgstr "“El hueso del brazo se articula con el de...”. ¿Con qué hueso era que se articulaba?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "It's still missing something."
msgstr "Todavía le falta algo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRESHFRUITCREPES"
msgid "With fresh-picked wild fruits."
msgstr "Hecho con frutas del bosque recién cosechadas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.DEAD"
msgid "Poor little guy."
msgstr "Pobre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.GENERIC"
msgid "That doesn't look like the frogs in my handbook..."
msgstr "No se parece a las ranas que aparecen en mi manual."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.SLEEPING"
msgid "Have sweet, fly-filled dreams."
msgstr "Que tengas dulces sueños llenos de moscas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGFISHBOWL"
msgid "Er... maybe Woby wants some."
msgstr "Eh... quizá Woby quiera un poco."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGGLEBUNWICH"
msgid "You can make anything into a sandwich if you try hard enough."
msgstr "Puedes convertir cualquier cosa en un sándwich si lo intentas lo suficiente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS"
msgid "I don't think they're ripe yet, they're still green."
msgstr "Creo que no están maduras. Aún están verdes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS_COOKED"
msgid "It doesn't look as fancy as I imagined."
msgstr "No se ven tan sofisticadas como imaginé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "It's a little lizard thing!"
msgstr "¡Es una pequeña lagartija!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I could've sworn it was green a second ago."
msgstr "Podría jurar que era verde hace un segundo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "They're even cuter when they're sleeping."
msgstr "Son más lindas cuando están durmiendo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITMEDLEY"
msgid "It's good for you!"
msgstr "¡Es bueno para ti!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FURTUFT"
msgid "It's so soft!"
msgstr "¡Es muy suave!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GARGOYLE_HOUND"
msgid "Wouldn't it be funny if it came to life?"
msgstr "¿No sería divertido si volviera a la vida?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Don't worry Woby, it's just a statue."
msgstr "No te preocupes, Woby. Solo es una estatua."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC"
msgid "Wards off the vampires."
msgstr "Repele a los vampiros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC_COOKED"
msgid "Too bad vampires never get to enjoy it."
msgstr "Qué malo que los vampiros no puedan disfrutar de esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GARLIC_SEEDS"
msgid "Where should we plant them, Woby?"
msgstr "¿Dónde deberíamos sembrarlas, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GAZPACHO"
msgid "(Sigh) I know it's probably good for me..."
msgstr "(Suspiro) Sé que probablemente es bueno para mí, pero..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GEARS"
msgid "These don't usually occur in nature."
msgstr "Estos no suelen crecer en la naturaleza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GEMSOCKET.GEMS"
msgid "I need to put in the gems first."
msgstr "Primero tengo que incrustar las gemas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GEMSOCKET.VALID"
msgid "Ready to go."
msgstr "Está listo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GESTALT"
msgid "Are you a ghost... from the moon?"
msgstr "¿Eres un fantasma... de la luna?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOST"
msgid "Ha, and people tried to tell me ghosts aren't real."
msgstr "¡Ja! Y todos siempre intentaron convencerme de que los fantasmas no existían."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTFLOWER"
msgid "Spooky!"
msgstr "¡Escalofriante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "Ghosts can drink potions? Uh, of course I knew that!"
msgstr "¿Los fantasmas pueden beber pociones? Eh... ¡ya lo sabía, claro está!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GIFT"
msgid "A present!"
msgstr "¡Un obsequio!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GIFTWRAP"
msgid "I'm not great at wrapping things... it always ends up a crumpled ball."
msgstr "No soy tan bueno envolviendo cosas. Todo siempre me queda como una bola arrugada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADHOUSE"
msgid "What do they do when it rains?"
msgstr "¿Qué hacen cuando llueve?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADPIG"
msgid "Is that cookie alive?!"
msgstr "¡¿Esa galleta está viva?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GINGERBREADWARG"
msgid "Who's a sweet Varg? Yes you are!"
msgstr "¿Quién es un huargo muy dulce, quién? ¡Sí, eres tú!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSBLOCK"
msgid "It looks nice I guess."
msgstr "Se ve bien, supongo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSCUTTER"
msgid "Moon sword!!"
msgstr "¡¡Espada lunar!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLASSSPIKE"
msgid "It looks like a giant tooth from a glass monster!"
msgstr "¡Parece el colmillo gigante de un monstruo de vidrio!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMER.GENERIC"
msgid "Don't be jealous Woby, you'll always be my best friend."
msgstr "No te pongas celosa, Woby, tú siempre serás mi mejor amiga."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMER.SLEEPING"
msgid "He must be tired from doing... whatever he does all day."
msgstr "Debe estar cansado de pasar todo el día haciendo... lo que sea que hace."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Darnit... what did I do wrong?"
msgstr "Rayos... ¿qué hice mal?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "That flower isn't in my Pinetree Pioneer handbook."
msgstr "Esa flor no aparece en mi manual de los Pioneros Pino."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERFUEL"
msgid "Don't eat it, Woby!"
msgstr "¡No te comas eso, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOMMERWINGS"
msgid "How did he fly with these little wings?"
msgstr "¿Cómo volaba con estas alitas tan pequeñas?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GLOWBERRYMOUSSE"
msgid "Will my insides light up if I eat it?"
msgstr "¿Se me iluminará la panza si me como esto?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Oh no! You lost your horn!"
msgstr "¡Oh, no! ¡Perdiste tu cuerno!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "I sure hope your horn grows back."
msgstr "Espero que tu cuerno vuelva a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "See? We can all get along!"
msgstr "¿Lo ves? ¡Todos podemos ser amigos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL.GENERIC"
msgid "Unicorns of the sea."
msgstr "Unicornios del mar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GNARWAIL_HORN"
msgid "If they're not using it anymore, might as well keep it."
msgstr "Si ya no lo necesita, podría quedármelo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOATMILK"
msgid "I don't think milk is supposed to crackle..."
msgstr "No creo que sea normal que la leche chisporrotee..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOGGLESHAT"
msgid "I feel more  adventurous already!"
msgstr "¡Ya me siento más intrépido!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENAXE"
msgid "I feel like you could use gold for better things."
msgstr "Me parece que el oro podría usarse para algo mejor."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENPICKAXE"
msgid "It makes sense if you don't think about it."
msgstr "Tiene sentido, si no lo analizas mucho."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENPITCHFORK"
msgid "Now I can be part of a FANCY angry mob."
msgstr "Ahora puedo formar parte de una turba ELEGANTE y enojada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDENSHOVEL"
msgid "Instead of digging up gold, I can dig with gold!"
msgstr "¡En vez de excavar oro, puedo excavar con el oro!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOLDNUGGET"
msgid "Ow... I bit it, isn't that a thing people do?"
msgstr "Ay... lo mordí. ¿No es normal que la gente lo haga?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GOOSE_FEATHER"
msgid "Goosey."
msgstr "Muy “gansosa”."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.BARREN"
msgid "This grass needs something to help it grow."
msgstr "Esta hierba necesita algo que la ayude a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.BURNING"
msgid "Hey! Brush fires destroy forests!"
msgstr "¡Oye! ¡Los incendios forestales destruyen bosques!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.DISEASED"
msgid "That's... not how it's supposed to look, is it?"
msgstr "Eso... no debería verse así, ¿verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.DISEASING"
msgid "Something seems off."
msgstr "Algo anda mal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.GENERIC"
msgid "A patch of grass. With bugs in it, if we're lucky."
msgstr "Un montón de hierba. Si tenemos suerte, vendrá con insectos incluidos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.PICKED"
msgid "Can't take anymore from it."
msgstr "Ya no queda nada que arrancar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS.WITHERED"
msgid "It's too hot out for anything to grow."
msgstr "Hace demasiado calor para que algo pueda crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "Oh no... I think it's sick."
msgstr "Ay, no... creo que está enfermo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "That patch of grass is alive!"
msgstr "¡Ese montón de hierba está vivo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRASS_UMBRELLA"
msgid "Flowers actually have lots of practical uses."
msgstr "Las flores tienen muchos usos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GRAVY"
msgid "Pass it over here!"
msgstr "¡Denme un poco de eso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENAMULET"
msgid "Great for when you're low on supplies!"
msgstr "¡Es muy útil cuando te estás quedando sin provisiones!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENGEM"
msgid "It's a great green gem!"
msgstr "¡Es una gema verde y genial!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENMOONEYE"
msgid "They never taught us how to use these in the Pinetree Pioneers."
msgstr "Nunca nos enseñaron a usar esto en los Pioneros Pino."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREENSTAFF"
msgid "I wish I had this when I had to break camp in the Pinetree Pioneers..."
msgstr "Ojalá hubiese tenido esto cuando me tocaba levantar el campamento en los Pioneros Pino."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_CAP"
msgid "It's not usually smart to eat unfamiliar mushrooms."
msgstr "Por lo general, no es muy inteligente comer champiñones que no reconoces."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_CAP_COOKED"
msgid "It's probably safe now that it's cooked, right?"
msgstr "Es probable que sea seguro comerlo ahora que está cocido, ¿no?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It doesn't look like any of the mushrooms in my handbook."
msgstr "No se parece a ninguno de los champiñones de mi manual."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "There's a mushroom hiding in there!"
msgstr "¡Hay un champiñón oculto aquí!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Maybe it will grow back."
msgstr "Tal vez vuelva a crecer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GUACAMOLE"
msgid "Now all we need are some chips!"
msgstr "¡Solo nos faltan unas papas fritas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GUANO"
msgid "My Pinetree Pioneer training is telling me there's bats nearby!"
msgstr "¡Mi entrenamiento de Pionero Pino me dice que hay murciélagos por aquí cerca!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.GUNPOWDER"
msgid "I better make sure none of the younger kids play with this."
msgstr "Debo asegurarme de que los niños más pequeños no jueguen con esto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_1"
msgid "Even candy's better when it's on a stick."
msgstr "Incluso los dulces son más sabrosos si están en un palito."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_10"
msgid "Is it made with real tentacles?"
msgstr "¿Está hecho de tentáculos de verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_11"
msgid "I'm far too mature for trick or treating."
msgstr "Ya estoy muy grande para pedir dulces."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_12"
msgid "I think these might be real bugs!"
msgstr "¡Creo que estos son bichos de verdad!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_13"
msgid "Huh. It's sour."
msgstr "Mmm, es ácido."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_14"
msgid "Oh! I wasn't expecting it to actually be spicy!"
msgstr "¡Ah! ¡No esperaba que fuese picante de verdad!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_2"
msgid "A handful of candy kernels."
msgstr "Un puñado de maíz dulce."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_3"
msgid "Not very spooky, but it is tasty."
msgstr "No es muy escalofriante, pero sí está sabroso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_4"
msgid "Maybe that spider kid would like this. Or maybe not..."
msgstr "Quizás a ese chico araña le gustaría esto. O tal vez no."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_5"
msgid "It's wearing a little mask!"
msgstr "¡Tiene una mascarita puesta!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_6"
msgid "Those look suspicious."
msgstr "Se ven sospechosos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_7"
msgid "I don't know what some people's problem is, raisins are good!"
msgstr "No sé qué problema tienen algunos con las pasas. ¡Son ricas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_8"
msgid "Maybe I'll give it to the twins."
msgstr "Quizá se los dé a las gemelas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENCANDY_9"
msgid "Gummy."
msgstr "Chicloso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "So that's what \"liquid courage\" is!"
msgstr "¡Así que estas son las famosas bebidas valerosas! ¿O eran espirituosas?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Dabbling in witchcraft is fun!"
msgstr "¡Incursionar en la hechicería es divertido!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "It didn't turn out quite as well as I thought it would."
msgstr "Eso no salió tan bien como esperaba."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "It should only be handled by someone who knows fire safety. Like me!"
msgstr "De esto debería encargarse alguien que sepa sobre prevención contra incendios. Es decir, ¡alguien como yo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "What should we mutate first?"
msgstr "¿Qué deberíamos hacer mutar primero?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Spooooky!"
msgstr "¡Escalofriaaante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "This is my favourite time of year."
msgstr "Esta es mi época favorita del año."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "It's pretty good, I thought it was a real spider!"
msgstr "Qué bien quedó. ¡Creí que era una araña de verdad!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "This looks really authentic!"
msgstr "¡Esto se ve muy real!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Weird how the spiders around here only have six legs."
msgstr "Es extraño que las arañas de aquí solo tengan seis patas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "This decoration needs a tree to perch in."
msgstr "A este adorno le hace falta un árbol en el cual colgarlo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMBAT"
msgid "Don't get any ideas, Woby."
msgstr "No te vayas a poner creativa con esto, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMMER"
msgid "Sometimes you need to break stuff to make stuff."
msgstr "A veces tienes que romper cosas para hacer cosas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HAMMER_MJOLNIR"
msgid "It's a heavy hammer for hitting things."
msgstr "Un martillo pesado para golpear cosas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HAWAIIANSHIRT"
msgid "This DEFINITELY wouldn't pass uniform inspection."
msgstr "Esto JAMÁS pasaría una inspección de uniforme."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEALINGSALVE"
msgid "Never hurts to be prepared!"
msgstr "¡Nunca está de más ir preparado!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEALINGSTAFF"
msgid "It conducts regenerative energy."
msgstr "Conduce energía regenerativa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.COLD"
msgid "Ahh... nice and cold."
msgstr "Ahh... fría y refrescante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.FROZEN"
msgid "Almost as chilling as one of my campfire stories. Right?"
msgstr "Te deja casi tan helado como mis historias en la fogata. ¿No es así?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.GENERIC"
msgid "That's a nice rock."
msgstr "Qué buena roca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.HOT"
msgid "Hot! Hot rock!"
msgstr "¡Caliente! ¡Roca caliente!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HEATROCK.WARM"
msgid "Almost as good as cuddling up with Woby."
msgstr "Es casi tan bueno como acurrucarse con Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITCRAB"
msgid "Hello ma'am! Can I help you with anything?"
msgstr "¡Hola, señora! ¿Puedo ayudarla?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "A Pinetree Pioneer is always happy to help the elderly!"
msgstr "¡Un Pionero Pino siempre está feliz de ayudar a las personas mayores!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "This house could use some fixing up."
msgstr "A esta casa le vendrían bien unas reparaciones."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "Oh no, oh no no no no..."
msgstr "Ay, no. Ay, no, no, no..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HERMIT_PEARL"
msgid "I gave my Pinetree Pioneer's oath to protect it with my life!"
msgstr "¡Hice un juramento de Pionero Pino de protegerla con mi vida!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HIVEHAT"
msgid "I guess I'm the bee king now!"
msgstr "¡Supongo que ahora soy el rey abeja!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOME"
msgid "Knock, knock!"
msgstr "¡Toc, toc!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.BURNT"
msgid "Hopefully it didn't say anything important."
msgstr "Espero que no dijera nada importante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.GENERIC"
msgid "Someone has bad handwriting."
msgstr "Alguien tiene mala caligrafía."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "A blank sign... not very helpful."
msgstr "Un letrero vacío. No es muy útil."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEY"
msgid "Wish I had some toast."
msgstr "Ojalá tuviera unas tostadas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYCOMB"
msgid "Just don't use it to comb your hair."
msgstr "Asegúrate de que no te caiga en el pelo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYHAM"
msgid "Sweet pig meat!"
msgstr "¡Carne de cerdo dulce!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HONEYNUGGETS"
msgid "I loved these when I was little."
msgstr "Me encantaban cuando era pequeño."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HORN"
msgid "That'll make a decent bugle."
msgstr "Esto sería un buen clarín."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTCHILI"
msgid "Nothing warms you up like a big bowl of chili."
msgstr "Nada te calienta más el cuerpo que un buen tazón de chile con carne."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.BOMBED"
msgid "I'm sure that's safe."
msgstr "Estoy seguro de que eso es seguro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.EMPTY"
msgid "It's a crater, I guess that's pretty common on the moon."
msgstr "Es un cráter. Supongo que son muy comunes en la luna."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.GENERIC"
msgid "This would make a great swimming hole! It's even heated!"
msgstr "¡Este sería un estupendo pozo para nadar! ¡Incluso está climatizado!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOTSPRING.GLASS"
msgid "It's like it's frozen in time."
msgstr "Es como si estuviese congelado en el tiempo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUND"
msgid "Hey Woby, another dog for you to play with!"
msgstr "¡Mira, Woby, otro perro con el que puedes jugar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDBONE"
msgid "You probably shouldn't chew on those, Woby."
msgstr "Creo que no deberías estar masticando esos huesos, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Poor thing..."
msgstr "Pobrecito..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "It's a hound, of corpse!"
msgstr "¡Es un sabueso de carne y hueso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "Phew, looks like they're okay after all!"
msgstr "¡Uf! ¡Parece que sí está bien después de todo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDMOUND"
msgid "I bet there's something interesting hiding in there!"
msgstr "¡Apuesto a que ahí se oculta algo interesante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDSTOOTH"
msgid "They left a souvenir!"
msgstr "¡Dejó un recuerdo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HOUNDWHISTLE"
msgid "Woby doesn't like the sound of it."
msgstr "A Woby no le gusta cómo suena."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT"
msgid "Flesh is flesh. Where do I draw the line?"
msgstr "La carne es carne. ¿Donde trazo el límite?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT_COOKED"
msgid "Cooked nice and pink, but still morally gray."
msgstr "Cocinada tiene un bonito color rosado, pero moralmente sigue siendo gris."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUMANMEAT_DRIED"
msgid "Letting it dry makes it not come from a human, right?"
msgstr "Si se deja secar ya no procede de un humano, ¿verdad?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH"
msgid "Looks like we found another friend, Woby!"
msgstr "¡Parece que tenemos un nuevo amigo, Woby!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Aww, are you lost little guy?"
msgstr "Ay... ¿te extraviaste, amiguito?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Ah! I-I'm sure some peroxide and a bandage will fix him up."
msgstr "¡Ah! Estoy seguro de que un poco de peróxido y unas vendas lo arreglarán."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICE"
msgid "This will really give you the chills."
msgstr "Esto sí que te dará escalofríos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG.GENERIC"
msgid "Iceberg ahead!"
msgstr "¡Iceberg a la vista!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG.MELTED"
msgid "Woby likes to roll in puddles."
msgstr "A Woby le gusta meterse en los charcos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBERG_MELTED"
msgid "Woby likes to roll in puddles."
msgstr "A Woby le gusta meterse en los charcos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEBOX"
msgid "This should keep our food supplies fresh!"
msgstr "¡Esto debería mantener frescas nuestras provisiones!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICECREAM"
msgid "Don't eat too much or you'll get a stomach ache."
msgstr "No comas demasiado o te dolerá el estómago."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEHAT"
msgid "There's got to be a better way to stay cool..."
msgstr "Tiene que haber una mejor manera de mantenerse fresco."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEHOUND"
msgid "Friends of yours, Woby?"
msgstr "¿Son amigos tuyos, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICEPACK"
msgid "Now my snacks won't get stale!"
msgstr "¡Ya mis botanas no se echarán a perder!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ICESTAFF"
msgid "Ice magic!"
msgstr "¡Magia de hielo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Woah! That was crazy!"
msgstr "¡Vaya! ¡Eso fue una locura!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "That's definitely got a supernatural explanation."
msgstr "Eso definitivamente tiene una explicación sobrenatural."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.INSPECTSELF"
msgid "A Pinetree Pioneer through and through!"
msgstr "¡Un Pionero Pino de la cabeza a los pies!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.JAMMYPRESERVES"
msgid "Now we're really in a jam..."
msgstr "Que no merme la mermelada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.JELLYBEAN"
msgid "Jellybeans are for little kids..."
msgstr "Las gomitas son para bebés."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KABOBS"
msgid "Food is always better when it's on a stick."
msgstr "La comida siempre sabe mejor si está en un palito."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP"
msgid "Sea monster hair. Obviously."
msgstr "Es pelo de monstruo marino. Obviamente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KELPHAT"
msgid "Maybe if I look like a sea monster the real ones will come out."
msgstr "Quizá si me veo como un monstruo marino, los de verdad aparezcan."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP_COOKED"
msgid "It's... slimy."
msgstr "Es... viscoso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KELP_DRIED"
msgid "Crunchy and salty. It's not bad."
msgstr "Crujiente y salado. No está mal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KILLERBEE.GENERIC"
msgid "(Sigh). All bees are killer bees when you're allergic."
msgstr "(Suspiro). Todas las abejas son asesinas cuando eres alérgico."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KILLERBEE.HELD"
msgid "This is fine..."
msgstr "No pasa nada..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUS"
msgid "Woah! Who are you?"
msgstr "¡Caray! ¿Quién eres tú?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUSSACKKEY"
msgid "There's something weird about this antler."
msgstr "Este cuerno tiene algo extraño."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KLAUS_SACK"
msgid "Hey, he brought presents!"
msgstr "¡Miren, compró obsequios!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KNIGHT"
msgid "Just horsing around..."
msgstr "A caballo regalado no se le miran las tuercas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Heh, spooky!"
msgstr "¡Je, je, qué aterrador!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KOALEFANT_SUMMER"
msgid "The trail led us right to it."
msgstr "Las huellas nos llevaron hasta él."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KOALEFANT_WINTER"
msgid "So you're the one who left those tracks!"
msgstr "¡Así que tú eres el que anda dejando esas huellas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KRAMPUS"
msgid "Hey! Did you rifle through my supplies?"
msgstr "¡Oye! ¿Estuviste hurgando entre mis cosas?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.KRAMPUS_SACK"
msgid "It smells... goat-y."
msgstr "Huele como a... cabra."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LANTERN"
msgid "Light the way, lantern."
msgstr "Ilumina el camino, linterna."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LATKES"
msgid "I've never tried potatoes cooked like this before."
msgstr "Nunca había probado papas cocidas de esta forma."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "This armor has been petrified for maximum protection."
msgstr "Esta armadura fue petrificada para proporcionar máxima protección."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That's as good as it gets."
msgstr "Es lo mejor que hay."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Light, but not very durable."
msgstr "Ligera, pero no muy duradera."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Lightweight and designed for mobility."
msgstr "Ligera y diseñada para la movilidad."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It offers a decent amount of protection."
msgstr "Ofrece una cantidad decente de protección."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "That could help me hit a little harder."
msgstr "Podría ayudarme a golpear un poco más fuerte."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I'd have energy for a few more stunts wearing that."
msgstr "Si me la pongo tendría energía para unas cuantas acrobacias más."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "That should keep me safe."
msgstr "Debería protegerme."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Everyone, break the Battle Standard!"
msgstr "¡Rompan el estandarte de batalla!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BERNIE"
msgid "He might make a good distraction for us."
msgstr "Podría ser una buena distracción para nosotros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_BOARLORD"
msgid "That's the guy in charge here."
msgstr "Ese es el tipo que manda aquí."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "That could cause some major destruction."
msgstr "Podría causar una destrucción importante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "It's a rock monster!"
msgstr "¡Un monstruo de piedra!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "It has a gaze full of science."
msgstr "Tiene una mirada llena de ciencia."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Those fluffy feathers make me want to run!"
msgstr "¡Esas plumas suaves me incitan a correr!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "It smells like brimstone."
msgstr "Huele a azufre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "The blossom interacts well with healing magic."
msgstr "La flor interactúa bien con la magia curativa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "This garland will restore a bit of my vitality."
msgstr "Esta guirnalda restaurará un poco mi vitalidad."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A sharp looking instrument."
msgstr "Un instrumento afilado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It needs a key."
msgstr "Necesita una llave."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "That should do it."
msgstr "Eso servirá."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "My strikes would hurt a little more wearing that."
msgstr "Si lo llevo, mis golpes harían un poco más de daño."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_LUCY"
msgid "That weapon's for throwing."
msgstr "Esa arma es para lanzarla."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "That's how we got here. Hopefully how we get back, too."
msgstr "Así es como llegamos aquí. Espero que regresemos así también."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "I'll just be going now."
msgstr "Me iré ahora mismo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Those crystals will quicken my abilities."
msgstr "Esos cristales acelerarán mis habilidades."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_SPAWNER"
msgid "This is where those enemies are coming from."
msgstr "De aquí salen esos enemigos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "It looks like it packs a wallop."
msgstr "Parece que hace mucho daño."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Looks like it amplifies healing expertise."
msgstr "Parece que amplifica la curación."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE"
msgid "That's amazing!"
msgstr "¡Qué increíble!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_COCOON"
msgid "I think it's resting."
msgstr "Creo que está descansando."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "I can't wait for it to hatch!"
msgstr "¡No puedo esperar a que eclosione!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "It needs more warmth!"
msgstr "¡Necesita más calor!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It looks pretty cozy."
msgstr "Parece estar muy cómoda."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.CONTENT"
msgid "Aww, I think he's smiling!"
msgstr "¡Qué linda, creo que está sonriendo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.GENERIC"
msgid "You're the best grub in the whole wide world!"
msgstr "¡Eres el mejor gusano del mundo entero!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Are you hungry, little guy?"
msgstr "¿Tienes hambre, amiguita?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_PET.STARVING"
msgid "This little guy needs some food!"
msgstr "¡Esta amiguita necesita comida!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVAE_TOOTH"
msgid "Aw, they lost their first tooth!"
msgstr "¡Qué linda, se le cayó su primer diente!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVASPIT.COOL"
msgid "It's cool!"
msgstr "¡Está fresco!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVASPIT.HOT"
msgid "It's rude to spit at people!"
msgstr "¡Es de mala educación escupirles a las personas!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVA_POND"
msgid "Probably not the best swimming hole."
msgstr "Es muy probable que no sea el mejor pozo para nadar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LAVA_POND_ROCK"
msgid "Sedimentary, my dear Woby! Well, igneous actually... never mind."
msgstr "¡Una roca elemental, mi querido Woby! Bueno, es ígnea... olvídalo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFLOAF"
msgid "I guess it's one way to eat your vegetables."
msgstr "Supongo que es otra forma de comerte los vegetales."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFYMEATBURGER"
msgid "It's not quite the same."
msgstr "No sabe igual."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "I don't think we needed to get that fancy with it..."
msgstr "Creo que no era necesario preparar algo tan sofisticado con eso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LEIF"
msgid "They've come to take their revenge!"
msgstr "¡Vinieron a vengarse!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LEIF_SPARSE"
msgid "They've come to take their revenge!"
msgstr "¡Vinieron a vengarse!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LICHEN"
msgid "It grows in most caves."
msgstr "Crece en la mayoría de las cuevas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIFEINJECTOR"
msgid "This is supposed to make me healthier?"
msgstr "¿Se supone que esto incremente mi salud?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTBULB"
msgid "Will I start glowing if I eat it?"
msgstr "¿Empezaré a brillar si me lo como?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTER"
msgid "Way easier than rubbing sticks together, but not as fun."
msgstr "Es mucho más sencillo que frotar ramas, pero no tan divertido."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Did that goat just get struck by lightning?!"
msgstr "¡¿Le acaba de caer un rayo a esa cabra?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "That's a weird looking mountain goat."
msgstr "Es una cabra montañesa muy extraña."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNINGGOATHORN"
msgid "The goat gave me a souvenir."
msgstr "La cabra me dejó un recuerdo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "It's crackling with energy!"
msgstr "¡Está chisporroteando!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "That's where we keep the lightning."
msgstr "Ahí es donde guardamos los rayos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LITTLE_WALRUS"
msgid "I've never seen a real walrus up close!"
msgstr "¡Nunca antes había visto una morsa real de cerca!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGLOG"
msgid "Yep, this log's definitely haunted."
msgstr "Sí, este tronco definitivamente está embrujado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE"
msgid "Can you talk? What's it like being a tree?"
msgstr "¿Sabes hablar? ¿Qué se siente ser un árbol?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE_ROOT"
msgid "There's a tree inside just waiting to come out!"
msgstr "¡Hay un árbol ahí dentro esperando para salir!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Who couldn't love that face?"
msgstr "¿A quién no le gustaría esa carita?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOBSTERBISQUE"
msgid "It's tasty, I like it!"
msgstr "Está rico. ¡Me gusta!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOBSTERDINNER"
msgid "This seems pretty fancy for camping food."
msgstr "Esto se ve muy elegante para ser comida de campamento."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOG.BURNING"
msgid "Doing what logs do."
msgstr "Hace lo que los leños deben hacer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOG.GENERIC"
msgid "Firewood!"
msgstr "¡Leños!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOST_TOY_1"
msgid "Hey! I could've sworn I didn't see anything there a second ago!"
msgstr "¡Oye! ¡Podría jurar que no había nada ahí hace un segundo!"

