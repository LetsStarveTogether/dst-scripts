#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It's well on its way."
msgstr "Está preparándose."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Maybe I should give the old lady a hand."
msgstr "Quizá deba darle una mano a la ancianita."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MEATYSALAD"
msgid "Huh. Pretty hearty for some leafy greens."
