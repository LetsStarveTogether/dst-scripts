msgstr "Bah. Este calor no es nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE"
