msgstr "¡Es mi amigo, %s! ¡Hola!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST"
msgid "C'mon, bud, let's get you on your feet."
msgstr "Vamos, amigo, tenemos que recuperarte."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER"
msgid "You'll not strong arm me, %s!"
msgstr "¡No me ganarás en las vencidas, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s has a big, squishy heart under those muscles."
msgstr "%s esconde un gran y blando corazón debajo de esos músculos."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER"
msgid "%s isn't a true Canadian..."
msgstr "%s no es un verdadero canadiense..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER"
msgid "Been there, bud."
msgstr "Ya conozco el tema, amigo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You're gonna have one monster headache after this, buddy."
msgstr "Vas a tener un dolor de cabeza terrible después de esto, amigo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Those fires are kind of counterproductive now, eh?"
msgstr "Esos fuegos son contraproducentes ahora, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC"
msgid "%s! Fancy seeing another Canadian here."
msgstr "¡%s! Me alegro de ver a otro canadiense por aquí."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST"
msgid "Canadians gotta stick together, %s. Let's get a heart."
msgstr "Los canadienses tenemos que ayudarnos, %s. Vayamos a buscar un corazón."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSE"
msgid "Truly Canada's most ferocious beast."
msgstr "Sinceramente, es la bestia más feroz de Canadá."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Whew... I mean, let's find you a heart, eh?"
msgstr "¡Uy! Bueno, vamos a buscarte un corazón, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSE"
msgid "Yeesh, is that really what I look like?"
msgstr "¡Cielos! ¿Así me veo yo?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Hang on bud, we'll get you sorted out."
msgstr "Espera, amigo, te ayudaremos."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER"
msgid "Hey, c'mere %s! I've gotta AXE you question!"
msgstr "¡Eh, ven aquí, %s! ¡Tengo algunas preguntas CORTANTES que hacerte!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER"
msgid "%s is a Canadian patriot, eh."
msgstr "%s es un patriota canadiense, eh."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT"
msgid "Be wary of the moving ground."
msgstr "Ten cuidado con el suelo movedizo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT"
msgid "I know a plant when I see one. This's an impostor!"
msgstr "Reconozco una planta cuando la veo. Esa es una impostora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM"
msgid "WOOORM!"
msgstr "¡GUSAAANOOO!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like a bum!"
msgstr "¡Parece un trasero!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN"
msgid "I'm not sure I want to look at that, eh?"
msgstr "No sé bien si quiero ver eso, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED"
msgid "It smells a bit off, eh?"
msgstr "Huele un poquito mal, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT"
msgid "This thing will be useful."
msgstr "Esto será útil."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER"
msgid "Wrinklier than the underside of a beaver."
msgstr "Tiene más arrugas que la parte inferior de un castor."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_PLANT"
msgid "Just a regular old plant."
msgstr "Solo es una planta común."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Why don't you leaf the fighting to the professionals?"
msgstr "Si sigues peleando así, se te pueden caer las hojas."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "I thought you of all people would prevent forest fires."
msgstr "Pensé que tú, de entre todas las personas, estarías más interesado en prevenir los incendios forestales."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GENERIC"
msgid "%s, hey there budding bud!"
msgstr "¡%s! ¡Hola, mi frondoso amigo!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GHOST"
msgid "C'mon, let's getcha replanted."
msgstr "Ven, vamos a que te replanten."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.MURDERER"
msgid "I'll wear that gem like a brooch, y'hear!"
msgstr "¡Me pondré esa gema como un broche, ¿me entendiste?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.REVIVER"
msgid "You're a good sapling, %s."
msgstr "Eres un buen vástago, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER"
msgid "Trust me, you ain't got the chops, %s."
msgstr "Me tendré que poner al tajo contigo, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER"
msgid "You better not burn any of my precious trees!"
msgstr "¡Será mejor que no quemes ninguno de mis preciosos árboles!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC"
msgid "%s, buddy, hey!"
msgstr "¡%s, amigo, eh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST"
msgid "That soul sapper's lookin' like a real sap now."
msgstr "Ese zapador de almas se quedó bastante plantado."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER"
msgid "I'll hang those horns on the wall of my cabin!"
msgstr "¡Colgaré esos cuernos en la pared de mi cabaña!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER"
msgid "That was mighty kind of you, %s."
msgstr "Eso fue realmente amable de tu parte, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.ATTACKER"
msgid "Woah! Slow down there, bud!"
msgstr "¡Oye! ¡Cálmate, amiguita!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.FIRESTARTER"
msgid "Hey! What do you think you're doin?"
msgstr "¡Oye! ¿Qué crees que haces?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GENERIC"
msgid "%s! Hey little bud!"
msgstr "¡%s! ¡Hola, amiguita!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GHOST"
msgid "We'll get ya feeling right as rain in no time."
msgstr "Te haremos sentir fresca como lechuga en poco tiempo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.MURDERER"
msgid "That's it, I'm givin' you the axe!"
msgstr "¡Basta! ¡Te cortaré la cabeza!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.REVIVER"
msgid "A bit rough around the edges, but you're alright %s!"
msgstr "¡Eres un poco tosca, pero eres buena, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER"
msgid "%s is cruisin' for a bruisin'..."
msgstr "%s está dando mamporros sin parar..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER"
msgid "You're gonna singe your chassis, %s."
msgstr "Te vas a chamuscar el chasis, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC"
msgid "It's my metal buddy, %s!"
msgstr "¡Es mi compañero de metal, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST"
msgid "Huh, I guess %s had a soul after all."
msgstr "Eh, supongo que %s tenía alma al fin y al cabo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER"
msgid "It's time to power DOWN, %s!"
msgstr "¡Hora de APAGARTE, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER"
msgid "%s, you're an alright sort."
msgstr "%s, eres un buen tipo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET"
msgid "I could cut wood at night with this."
msgstr "Podría cortar madera por la noche con esto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM"
msgid "I can see the stars in it."
msgstr "Puedo ver las estrellas en ella."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE"
msgid "It's rude to stare."
msgstr "Es de mala educación quedarse mirando."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF"
msgid "Useful in a pinch!"
msgstr "¡Útil en caso de apuro!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "What a shame."
msgstr "Qué lástima."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "It needs a little something..."
msgstr "Le falta algo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "Pretty nice setup, eh?"
msgstr "Qué bonito montaje, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "You ain't gettin' far without a good sense of direction."
msgstr "No llegarás muy lejos sin un buen sentido de la orientación."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "You've got this, bud!"
msgstr "¡Tú puedes, amiguita!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "My Carrat's gonna be as quick as a Canadian summer!"
msgstr "¡Mi ratahoria va a ser tan rápida como un verano canadiense!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "Better look sharp."
msgstr "Tienes que estar avispada."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Nice reflexes!"
msgstr "¡Buenos reflejos!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "Better find a good place to put this, eh?"
msgstr "Debería buscar un buen lugar para poner esto, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Let's hit the ground running, eh?"
msgstr "Empecemos a toda marcha, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Yer doin great!"
msgstr "¡Lo estás haciendo genial!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I'd better find a place to set this up."
msgstr "Tengo que buscar un lugar donde ponerlo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Wait a minute, is that my fishing reel?"
msgstr "Espera un minuto. ¿Es el carrete de mi caña?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "There ya go!"
msgstr "¡Eso es!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "Just aboot everything I need to toughen up my Carrat."
msgstr "Tiene todo lo necesario para fortalecer a mi ratahoria."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "This marker should help 'em find the finish line."
msgstr "Este indicador debería ayudarlas a encontrar la meta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "How aboot I start settin' up the racetrack?"
msgstr "¿Qué tal si empiezo a armar el circuito?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "I guess nobody wins."
msgstr "Creo que nadie gana."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Can't have a race without a finish line."
msgstr "No puede haber una carrera sin meta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "I knew you could do it, bud!"
msgstr "¡Sabía que podías hacerlo, amiguita!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} sure gave us the run-around, eh?"
msgstr "{winner} de verdad nos hizo correr, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "Let's get this all set up!"
msgstr "¡Armemos todo esto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "How aboot a little race, eh?"
msgstr "¿Y si tenemos una carrerita, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Alright, where do we start this race?"
msgstr "Bien, ¿dónde comienza esta carrera?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Hey, it's not fire season!"
msgstr "¡Oigan, no es temporada de incendios!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "Sorry bud, looks like you need more time at the gym."
msgstr "Lo siento, amiga, creo que necesitas pasar más tiempo en el gimnasio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Not bad! Not bad at all!"
msgstr "¡No está mal! ¡No está nada mal!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "How aboot we see what our Carrat's made of, eh?"
msgstr "Probemos de qué están hechas nuestras ratahorias, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "This will help me get the measure of my racer."
msgstr "Esto me ayudará a pesar a mi corredora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET"
msgid "It's a bit of a mixed bag. Of seeds."
msgstr "Es una pequeña mezcla de semillas."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_SEEDPACKET_RARE"
