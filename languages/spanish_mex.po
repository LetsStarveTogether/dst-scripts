msgstr "¡No está nada mal!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "A float might make fishing easier."
msgstr "Una boya facilitaría la pesca."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "This world can harden the best of us, mon ami."
msgstr "Este mundo endurece hasta a los mejores, mon ami."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Feathers are surprisingly useful for fishing!"
msgstr "¡Las plumas son sorprendentemente útiles para pescar!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Feathers are surprisingly useful for fishing!"
msgstr "¡Las plumas son sorprendentemente útiles para pescar!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "I'd better handle this one carefully."
msgstr "Será mejor que tenga cuidado con esto."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
