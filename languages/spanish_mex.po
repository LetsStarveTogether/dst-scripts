msgstr "Supongo que quemó calorías y mucho más. ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
