msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.kitten_winter
msgctxt "STRINGS.SKIN_DESCRIPTIONS.kitten_winter"
msgid "Did this Kittykit just get cuter? (How's that even possible?!)"
msgstr "¿Este gatito es aún más lindo? (¡¿Cómo es eso posible?!)"

