msgstr "Parece que la fruta se ablandó un poquito."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
