msgstr "Ay, ¡debo remar en el momento correcto!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "I can bake a soufflé in the wilderness, but I can't do this?"
msgstr "Puedo hornear un suflé en la selva, pero ¿no puedo hacer esto?"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Mais non! I must try harder."
msgstr "¡Claro que non! Debo esforzarme más."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.RUMMAGE.GENERIC"
