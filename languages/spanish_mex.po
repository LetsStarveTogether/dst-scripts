msgid "I'll stop hiding your axe, promise! Hyuyu!"
msgstr "¡Dejaré de esconderte el hacha, te lo prometo! ¡Ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVER"
msgid "Hyuyu, you're so funny, %s!"
msgstr "¡Ji, ji, eres muy divertido, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "What a funny soul! I wonder what it tastes like."
msgstr "¡Qué alma tan graciosa! Me pregunto a qué sabe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.FIRESTARTER"
msgid "%s has been a bit of a prankster!"
msgstr "¡%s ha estado siendo un poco bromista!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GENERIC"
msgid "That axe of his sure can tell a joke."
msgstr "Esa hacha suya sabe cómo contar un chiste."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GHOST"
msgid "You wouldn't even noticed if I took a bite."
msgstr "Ni siquiera te darías cuenta si te diera un mordisco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSE"
msgid "What's got your feathers in a bunch? Hyuyu!"
msgstr "¿Qué te hizo erizar las plumas? ¡Ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Do goose souls taste like chicken?"
msgstr "¿Las almas de ganso saben a pollo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSE"
msgid "The curse is growing, your antlers are showing!"
msgstr "La maldición está aumentando y tus astas lo están demostrando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "You wouldn't mind if I sneak a bite, would you?"
msgstr "No te importaría si doy una probadita, ¿o sí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MURDERER"
msgid "Don't kill me, hyuyuyu!"
msgstr "¡No me mates, ji, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.REVIVER"
msgid "%s is oh so helpful!"
msgstr "¡%s es tan útil!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.DIRT"
msgid "A simple pile of dirt and muck."
msgstr "Un montón de suciedad y estiércol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.PLANT"
msgid "The shimmer of a soul lurks below."
msgstr "El brillo de un alma se esconde debajo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.WORM"
msgid "Hyuyu! What do I do??"
msgstr "¡Ji, ji! ¿Qué hago?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like it could be my ride!"
msgstr "¡Parece que podría ser mi medio de transporte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.OPEN"
msgid "Watch my impression of mortal food."
msgstr "Mira mi imitación de comida mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE_LIMITED"
msgid "I think its throat is getting sore."
msgstr "Creo que le está doliendo la garganta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT"
msgid "A glowing fruit. I am astute."
msgstr "Una fruta resplandeciente. Soy astuto y eficiente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_LESSER"
msgid "This glowy fruit is going bad."
msgstr "Esta fruta brillante se está estropeando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_PLANT"
msgid "The shimmer of a soul lurks below."
msgstr "El brillo de un alma se esconde debajo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.ATTACKER"
msgid "What a cruel trick you've played! Hyuyu!"
msgstr "¡Qué broma tan cruel llevaste a cabo! ¡Ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "Ooo, there's an ember of fun in you yet."
msgstr "¡Oh, entonces, sí tienes la chispa de la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GENERIC"
msgid "Heard any good jokes lately, %s?"
msgstr "¿Has escuchado algún buen chiste últimamente, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GHOST"
msgid "Finally, a break from his poop jokes."
msgstr "Al fin, un descanso de sus chistes sobre excremento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.MURDERER"
msgid "You've really gone and dung it this time, hyuyu!"
msgstr "Ahora sí que la embarraste, ¡ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is just too kind a soul, I suppose."
msgstr "Supongo que %s es un alma demasiado bondadosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.ATTACKER"
msgid "Hey! What's with that impish grin?"
msgstr "¡Eh! ¿Y esa sonrisa pícara?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Hyuyu! What pranks have you been playing?"
msgstr "¡Ji, ji! ¿Qué bromas has estado haciendo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GENERIC"
msgid "Oh! What a handsome devil."
msgstr "¡Oh! Qué demonio tan atractivo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GHOST"
msgid "Are you gonna eat that?"
msgstr "¿Te vas a comer eso?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.MURDERER"
msgid "He's stealing all the good souls!"
msgstr "¡Está robando todas las almas buenas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.REVIVER"
msgid "Hyuyu, I would have eaten that soul were I you."
msgstr "Ji, ji, me habría comido esa alma de ser tú."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX_SOUL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX_SOUL"
msgid "Hyuyu! It looks tasty."
msgstr "¡Ji, ji! Parece sabrosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.ATTACKER"
msgid "%s has a fiendish look in her eye."
msgstr "%s tiene un brillo diabólico en la mirada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.FIRESTARTER"
msgid "Hyuyuyu, brilliant!"
msgstr "¡Ji, ji, ji, brillante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GENERIC"
msgid "Gotten into any trouble yet today, %s?"
msgstr "¿Aún no te has metido en problemas, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GHOST"
msgid "Don't fret, I won't eat you!"
msgstr "No te preocupes, ¡no te comeré!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.MURDERER"
msgid "Surely we can sort this out, imp to shrimp?"
msgstr "Estoy seguro de que podemos resolver esto, de diablillo a pececillo, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.REVIVER"
msgid "You have a good soul, %s. I promise not to eat it."
msgstr "Tienes un alma bondadosa, %s. Prometo no comérmela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.ATTACKER"
msgid "Hoohoo, I'll stop grinding your gears! Promise!"
msgstr "¡Jo, jo, dejaré de hacer que chirríes! ¡Te lo prometo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.FIRESTARTER"
msgid "Ooo, the tin can has a sense of humor!"
msgstr "¡Oooh, la lata de hojalata tiene sentido del humor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GENERIC"
msgid "Hyuyu %s, do you have an off button?"
msgstr "Ji, ji, %s, ¿tienes un botón de apagado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GHOST"
msgid "Not so soulless after all, hyuyu!"
msgstr "¡Parece que no careces completamente de alma, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.MURDERER"
msgid "Don't kill the poor little imp!"
msgstr "¡No mates al pobre diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.REVIVER"
msgid "What a kind and noble deed!"
msgstr "¡Qué obra tan amable y noble!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWAMULET"
msgid "I'll give my brain a slight refrain."
msgstr "Le daré a mi cerebro algo muy bueno."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWGEM"
msgid "From lava floes bellow this glimmering yellow."
msgstr "De la lava fascinante sale este amarillo brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWMOONEYE"
msgid "To make our mark once we embark."
msgstr "Para dejar nuestra marca cuando subamos en el arca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWSTAFF"
msgid "It calls the sun from out the sky!"
msgstr "¡Invoca al sol desde el cielo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Well, that's that."
msgstr "Bien, se acabó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "What is it you need? Perhaps carrots and seeds?"
msgstr "¿Qué debo darte para obtener la gloria? ¿Tal vez semillas y zanahorias?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "Hyuyu, I know a trickster when I see one!"
msgstr "Ji, ji. ¡Reconozco a un bromista cuando lo veo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "That prank went a bit too far."
msgstr "Esta broma se les fue de las manos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "North, South, East, West, your sense of direction we'll put to the test!"
msgstr "Norte, sur, este y oeste, tu sentido de la orientación probaremos, cueste lo que cueste."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "Clever creature."
msgstr "Una criatura astuta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "¡Un poco de esto y aquello vamos a practicar, para a mi querida ratahoria poder entrenar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "That prank went a bit too far."
msgstr "Esta broma se les fue de las manos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "I just wanted to see how you'd react, hyuyu!"
msgstr "Solo quería ver cómo reaccionarías, ¡ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Your reflexes are quite good, for a vegetable."
msgstr "Para ser una verdura, tus reflejos son muy buenos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "¡Un poco de esto y aquello vamos a practicar, para a mi querida ratahoria poder entrenar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "That prank went a bit too far."
msgstr "Esta broma se les fue de las manos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Spin, spin, spin the wheel of fate!"
msgstr "¡Gira, gira, gira la rueda del destino!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "You're getting fast, indeed!"
msgstr "¡Te estás volviendo más rápida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "¡Un poco de esto y aquello vamos a practicar, para a mi querida ratahoria poder entrenar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "That prank went a bit too far."
msgstr "Esta broma se les fue de las manos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "My, that looks strenuous."
msgstr "Caray, eso se ve fatigante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Such determination for one so small!"
msgstr "¡Qué gran determinación para un ser tan pequeño!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "¡Un poco de esto y aquello vamos a practicar, para a mi querida ratahoria poder entrenar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "I make a point of checking checkpoints, hyuyu."
msgstr "Me gusta controlar los puntos de control, ji, ji."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "Mark the way!"
msgstr "¡Indica el camino!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "How silly!"
msgstr "¡Qué tontería!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Surely the cleverest will win."
msgstr "Es seguro que el más astuto ganará."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "We won with wit and cunning (and a little bit of running)."
msgstr "Ganamos con ingenio y sensatez, y mucho correr, como lo ves."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} put us to the test, and it turns out they're the best."
msgstr "{winner} nos puso a prueba en esta batalla y resulta que ellos sí dieron la talla."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "Where to put the finish line..."
msgstr "¿Dónde debería poner la línea de meta?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Hyuyu, what fun!"
msgstr "¡Ji, ji, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Let the races begin!"
msgstr "¡Que comience la carrera!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Hyuyu, what fun!"
msgstr "¡Ji, ji, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I think we can do better than that."
msgstr "Considero que puedo conseguir algo mejor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "A veritable virtuoso of a vegetable!"
msgstr "¡Un verdadero talento hecho vegetal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "I hope I get a high score, hyuyu!"
msgstr "¡Espero obtener una alta puntuación, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "To win the race, I need a Carrat that can keep up the pace!"
msgstr "¡Para ganar esta batalla, necesito una ratahoria que dé la talla!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET"
msgid "A packet of seeds, to do with as I please."
msgstr "Un paquete de semillas encontré. Veré qué uso les doy, quizá las sembraré."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Perhaps it contains magic beans? Hyuyu!"
msgstr "Quizá contiene frijoles mágicos, ¡ji, ji!"

