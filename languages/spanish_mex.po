msgstr "¡Qué montón de basura tan desagradable!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Ha, falling to pieces. Rookie mistake."
msgstr "¡Ja! Se está cayendo a pedazos. Un error de novato."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Heh heh. Whoops."
msgstr "Je, je. ¡Uy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Watery nerd stuff."
msgstr "Una cosa acuosa de nerdos."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEAFOODGUMBO"
msgid "Ew, what IS this?"
msgstr "¡Puaj! ¿QUÉ es esto?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEASTACK"
msgid "It's just a big boring sea rock."
msgstr "Solo es una gran roca marina aburrida."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS"
msgid "Farming is boring."
msgstr "Sembrar es aburrido."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS_COOKED"
msgid "No good for farming now."
msgstr "No muy buenas para plantarlas ahora."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SENTRYWARD
