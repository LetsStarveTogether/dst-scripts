msgctxt "STRINGS.MERM_TALK_HELP_CHOP_WOOD.1.1"
msgid "Will come with you."
msgstr "Ir contigo."

#. STRINGS.MERM_TALK_HELP_CHOP_WOOD.1.2
msgctxt "STRINGS.MERM_TALK_HELP_CHOP_WOOD.1.2"
msgid "Flort glut."
