msgstr "Un centro de mesa digno de un banquete festivo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "It looks a bit like a knight."
msgstr "Tiene cierto parecido con un caballo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Mon dieu! It's moving!"
msgstr "¡Mon dieu! ¡Se mueve!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "I hope this won't bring us ill luck at sea..."
msgstr "Espero que esto no nos traiga mala suerte en el mar."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Perhaps now you can keep watch over my crock pot."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESSPIECE_MOON"
