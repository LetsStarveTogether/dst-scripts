msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "A lot harder than it looks, eh?"
msgstr "Es más difícil de lo que parece, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE"
msgid "Maybe I can find a caribou to ride instead."
msgstr "Tal vez pueda encontrar un caribú para montarlo."

