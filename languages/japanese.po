msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Hmph. Maybe I don't got it so bad."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEARS"
