msgstr "なんて悪魔みたいな道具！"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT"
