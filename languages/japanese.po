msgstr "ミスターSandmanと呼んでくれ。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "霜で覆われている。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "青は氷をもたらす。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "頭に入っているよ…思い出せないだけでね"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "どんな悪い方向にいくというのだ？"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
