#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Let's get building."
msgstr "Pongámonos a construir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMANDRAKE"
msgid "Dead as several doornails."
msgstr "Esta muerta y requetemuerta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMEAT"
