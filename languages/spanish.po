msgstr "¡Sigue sin ser un pájaro, pero lo han rellenado como si fuera uno!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PICKED"
