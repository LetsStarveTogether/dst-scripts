msgstr "Un excelente comienzo de la mañana. O de la noche."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WALL_HAY.BURNT"
