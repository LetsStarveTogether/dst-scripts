msgstr "¡Buuum!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPAT"
msgid "I don't like your face!"
msgstr "¡No me gusta tu cara!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR"
msgid "That looks good for jabbin'!"
msgstr "¡Parece bueno para pinchar!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_GUNGNIR"
msgid "I don't want to use that."
msgstr "No quiero usar eso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_LANCE"
