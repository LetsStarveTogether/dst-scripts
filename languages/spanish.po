msgstr "Puaj. Apestas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC"
