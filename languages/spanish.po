msgstr "No son glamurosas, pero me las comeré."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS_COOKED"
