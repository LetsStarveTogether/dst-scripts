msgstr "Parece engorrosa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_WATHGRITHR"
