msgstr "Igual debería dejarla en paz."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPOILED_FOOD"
