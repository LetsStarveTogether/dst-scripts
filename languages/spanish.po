msgstr "Está totalmente seco. ¡Listo para arder!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Did I say you could stop growing?!"
msgstr "¿¡Te he dicho que puedes dejar de crecer!?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Yes!! Burn!!"
msgstr "¡¡Sí!! ¡¡Arde!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Burn the sick!"
msgstr "¡Quema lo enfermo!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Blech. You smell."
msgstr "Puaj. Apestas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Ready for picking!"
msgstr "¡Listo para la cosecha!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Make mooooore!"
msgstr "¡Haz máááááás!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It's burning up."
msgstr "Está ardiendo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT"
msgid "What in the world!"
msgstr "¡Pero qué demonios...!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE"
msgid "Aaah! Set it on fire!"
msgstr "¡Aaah! ¡Prendedle fuego!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD"
