msgstr "Oeste."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.GENERIC"
msgid "I'm pretty good with directions."
msgstr "Se me da bastante bien orientarme."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.N"
msgid "South."
msgstr "Sur."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NE"
msgid "Southwest"
msgstr "Sudoeste"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NW"
msgid "Southeast"
msgstr "Sureste"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.S"
msgid "North."
msgstr "Norte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SE"
