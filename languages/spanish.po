msgid "The luxuries of camp, on the go."
msgstr "Los lujos del campamento, sobre la marcha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT"
msgid "Seems a bit flashy for battle."
msgstr "Parece un poco llamativo para la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL"
msgid "Perhaps I'll pen a saga of my journeys!"
msgstr "¡Quizá escriba una saga de mis viajes!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY"
msgid "In remembrance of a songbird."
msgstr "En honor de un pájaro cantor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW"
msgid "A token from the ravens!"
msgstr "¡Un símbolo de los cuervos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN"
msgid "Red as my hair."
msgstr "Rojo como mi cabello."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Winter's feather."
msgstr "Pluma de invierno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET"
msgid "She looks unhappy upon her throne."
msgstr "Parece infeliz sobre su trono."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE"
msgid "Tis not my kind of fencing."
msgstr "Prefiero una defensa más activa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE"
msgid "A tiny replica of Valhalla's gates."
msgstr "Una réplica diminuta de las puertas de Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "No es una fortificación. Solamente sirve para una granja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "No es una fortificación. Solamente sirve para una granja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER"
msgid "Its stench could raise the fallen."
msgstr "Su hedor podría levantar a los caídos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF"
msgid "The gods did not mean thy magic for me."
msgstr "Los dioses no han destinado tu magia para mí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS"
msgid "To strike fear into the hearts of mine enemies!"
msgstr "¡Para sembrar el miedo en el corazón de mi enemigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC"
msgid "Tiny fairy lights aglow!"
msgstr "¡Las hadas diminutas brillan!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD"
msgid "I hold the light!"
msgstr "¡Tengo la luz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND"
msgid "The flamed one has no mercy."
msgstr "El que ha ardido no tiene piedad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS"
msgid "That fire's nearly dead."
msgstr "Este fuego está casi apagado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC"
msgid "Warm fire, warm Wigfrid."
msgstr "Fuego caliente, Wigfrid caliente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH"
msgid "The fire roars!"
msgstr "¡El fuego ruge!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW"
msgid "Fire's slowly dying."
msgstr "El fuego está muriendo lentamente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL"
msgid "Warm fire, warm Wigfrid."
msgstr "Fuego caliente, Wigfrid caliente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT"
msgid "And the light flickers out."
msgstr "Y la luz se apaga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF"
msgid "That we might become Masters of Fire!"
msgstr "¡Que seamos los maestros del fuego!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "The catapult grows weak and tired."
msgstr "La catapulta se debilita y se cansa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Time to rest, flinging warrior."
msgstr "Hora de descansar, aguerrido guerrero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Catapult engaged for battle!"
msgstr "¡Catapulta preparada para la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH"
msgid "Meat of the sea!"
msgstr "¡Carne del mar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD"
msgid "I'm a ruthless fisherwoman."
msgstr "Soy una pescadora sin escrúpulos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS"
msgid "Spears of sea meat."
msgstr "Lanzas de carne marina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS"
msgid "Fish in a blanket!"
msgstr "¡Pez envuelto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED"
msgid "Joy!"
msgstr "¡Alegría!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT"
msgid "Vital for spear construction."
msgstr "Vital para la construcción de la lanza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC"
msgid "A flower from Freya."
msgstr "Una flor de Freya."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE"
msgid "Were that I smelled half as sweet."
msgstr "Ojalá yo oliese la mitad de dulce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT"
msgid "Flimsy for the fight, enchanting on one's head."
msgstr "Débil para luchar, encantador en la cabeza de uno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD"
msgid "Leaves are for animals. Animals are for eating."
msgstr "Las hojas son para los animales. Los animales son para comérselos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE"
msgid "And it lit up the night, upon the darkest hour."
msgstr "E iluminó la noche, en la hora más oscura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL"
msgid "A terrible evil plagues this flora."
msgstr "Un terrible mal asola esta flora."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED"
msgid "Not enough time in the limelight."
msgstr "No ha estado lo suficiente a la luz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE"
msgid "A collection of ferns."
msgstr "Una colección de helechos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT"
msgid "A pig's bottom made this helmet."
msgstr "El trasero de un cerdo ha hecho este casco."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE"
msgid "Bones of a dark and ancient foe."
msgstr "Los huesos de una oscura y antigua criatura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "It looks as though it might roam the earth any moment!"
msgstr "¡Parece como si fuera a vagar por el mundo en cualquier momento!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Tis not as majestic as I once pictured."
msgstr "No es tan majestuoso como me lo imaginé."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "All that remains of a terrible beast."
msgstr "Los restos de una bestia terrible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD"
msgid "You're a bit slimy for Valhalla."
msgstr "Eres un poco babosa para Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC"
msgid "I'd like some frog boots someday."
msgstr "Me gustaría tener unas botas de rana algún día."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING"
msgid "It sleeps."
msgstr "Está dormida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH"
msgid "What a treat!"
msgstr "¡Qué banquete!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS"
msgid "Filled with rubbery protein!"
msgstr "¡Llenas de proteína carnosa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED"
msgid "I like when I can see the bones sticking out."
msgstr "Me gusta cuando veo sobresalir los huesos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY"
msgid "Ugh! Putting it into a cup doesn't fool me."
msgstr "¡Agh! Que esté en una copa no me engaña."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT"
msgid "Fur from a large beastie."
msgstr "Piel de una gran bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND"
msgid "Shed your stone form and fight, beast!"
msgstr "¡Despójate de tu forma pétrea y lucha, bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Do not cower behind your carapace of rock! Fight!"
msgstr "¡No te escondas detrás de tu caparazón de roca! ¡Lucha!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS"
msgid "Those might look nice glued to my helm."
msgstr "Podrían quedar bien pegados a mi casco."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS"
msgid "It lacks its gem."
msgstr "Le falta su gema."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID"
msgid "Showtime!"
msgstr "¡Hora del espectáculo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST"
msgid "A spirit trapped between worlds."
msgstr "Un espíritu atrapado entre dos mundos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT"
msgid "A gift! From... the gods?"
msgstr "¡Un regalo! ¿De... los dioses?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP"
msgid "I must show my allies how much they are valued!"
msgstr "¡Debo demostrarles a mis aliados lo mucho que valen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK"
msgid "Such beauty!"
msgstr "¡Qué bello!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE"
msgid "Twas forged in flame."
msgstr "Fue forjada en las llamas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER"
msgid "A majestic goober."
msgstr "Un bicho majestuoso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "It was once a wonder of the woods."
msgstr "Una vez fue una maravilla de los bosques."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "A wonder of the woods."
msgstr "Una maravilla de los bosques."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL"
msgid "This slop could be useful."
msgstr "Esta porquería podría ser útil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS"
msgid "Ohh, look what the goober left for me."
msgstr "Oh, mira qué porquería me ha dejado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK"
msgid "This is powerful milk."
msgstr "Esto es leche poderosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT"
msgid "T'would be no help in battle."
msgstr "No servirá de nada en la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE"
msgid "A tool of gold!"
msgstr "¡Una herramienta de oro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE"
msgid "Gold for gold."
msgstr "Oro para el oro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK"
msgid "A weapon of very wealthy farmers."
msgstr "Un arma de ricos agricultores."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL"
msgid "Digging like a king!"
msgstr "¡Excavando como un rey!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET"
msgid "Such a pleasing gold piece."
msgstr "Qué pieza de oro más bonita."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER"
msgid "A shieldmaiden deserves a soft bed of dunn."
msgstr "Una escudera merece una suave cama de plumas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN"
msgid "The life has gone from it."
msgstr "Se ha quedado sin vida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING"
msgid "Loge looks upon you!"
msgstr "¡Loge te mira!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED"
msgid "Disease festers within its soul."
msgstr "La enfermedad rezuma dentro de su alma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "¡Se debilita frente a mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC"
msgid "That could be useful."
msgstr "Esto podría ser útil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED"
msgid "I eagerly await the next harvest."
msgstr "Espero con impaciencia la próxima cosecha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED"
msgid "The heat has defeated this plant."
msgstr "El calor ha derrotado a esta planta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "Alas! It is stricken."
msgstr "¡Ay! Está enfermo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "What flaxen scales."
msgstr "Qué escamas tan rubias."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA"
msgid "Flowers are not befitting a warrior, but wet armor is even worse."
msgstr "La flores no son propias de un guerrero, pero aún es peor una armadura mojada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET"
msgid "Enhanced emerald crafting skills!"
msgstr "¡Habilidades de fabricación de esmeraldas mejoradas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM"
msgid "An emerald stone."
msgstr "Una piedra de esmeralda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE"
msgid "Odin gave his eye that we might see."
msgstr "Odín sacrificó un ojo para que podamos ver."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF"
msgid "Twirly green power."
msgstr "Energía verde que gira."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP"
msgid "Terrible!"
msgstr "¡Terrible!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED"
msgid "Charred by flame or not, that will not touch my lips!"
msgstr "¡Carbonizado por el fuego o no, no tocará mis labios!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It has risen!"
msgstr "¡Ha crecido!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Hide, coward."
msgstr "Escóndete, cobarde."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "I see fungal spores."
msgstr "Veo las esporas del hongo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE"
msgid "Yum, creamy!"
msgstr "¡Ñam, cremoso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO"
msgid "Hmm, dark wing turds."
msgstr "Hmm, porquería de alas oscuras."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER"
msgid "Such energy!"
msgstr "¡Cuánta energía!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1"
msgid "How sinister! I nearly mistook it for a true apple!"
msgstr "¡Qué siniestro! ¡Casi la confundo por una manzana de verdad!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10"
msgid "I shall uncover its secret center!"
msgstr "¡Descubriré su centro secreto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11"
msgid "Tis not meat, but tis close enough!"
msgstr "¡No es carne, pero sirve!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12"
msgid "They look like that which writhe and crawl."
msgstr "Parece como si se retorciesen y reptasen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13"
msgid "You shalt not break me, confection!"
msgstr "¡No me romperás, dulce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14"
msgid "Wretched Hel's fire!"
msgstr "¡Maldito fuego de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2"
msgid "A clever ruse. It is not corn at all."
msgstr "Un artimaña inteligente. No es maíz aunque lo parezca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3"
msgid "A confection to strike terror into any warrior's heart!"
msgstr "¡Un dulce para sembrar el miedo en el corazón de los guerreros!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4"
msgid "Monsters, prepare to do battle with a Viking's teeth!"
msgstr "¡Monstruos, preparaos para luchar con el diente de un vikingo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5"
msgid "The perfect treat!"
msgstr "¡El dulce perfecto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6"
msgid "What have I done to anger the gods so?"
msgstr "¿Qué he hecho para enfadar así a los dioses?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7"
msgid "That monarch swine insults me."
msgstr "Ese monarca porcino me insulta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8"
msgid "I shall uncover its secret center!"
msgstr "¡Descubriré su centro secreto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9"
msgid "The battle was mighty, yet in the end the worm was consumed!"
msgstr "¡La lucha fue tremenda, pero al final se consumió el gusano!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Tis Berserker magic."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Fortune hath smiled upon me today!"
msgstr "¡La fortuna me ha sonreído hoy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "A meager reward for my troubles."
msgstr "Una pobre recompensa para mi esfuerzo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Hel's fuel."
msgstr "El combustible de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Meant to hang from Yggdrasil's kin!"
msgstr "¡Es para colgarlo de un pariente de Yggdrasil!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Decoration! Prepare to be hung from something!"
msgstr "¡Decoración! ¡Prepárate para que te cuelgue en alguna parte!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "It shall strike fear unto the hearts of mine foes!"
msgstr "¡Sembraré el miedo en los corazones de mis enemigos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "'tis but a decoration!"
msgstr "¡No es más que una decoración!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "It shalt be hung from the highest branch!"
msgstr "¡Colgará de la rama más alta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Huginn? Or Muninn?"
msgstr "¿Para colgarlo? ¿O para que salga volando?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT"
msgid "A weapon fit for the great dining halls!"
msgstr "¡Un arma para los grandes comedores!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER"
msgid "More fit for labor than battle."
msgstr "Más apto para el trabajo que la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR"
msgid "I am worthy!"
msgstr "¡Soy digna de llevar esta arma!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT"
msgid "Flowers cannot stop a spear."
msgstr "Las flores no detendrán una lanza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE"
msgid "Be filled with life!"
msgstr "¡Llénate de vida!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF"
msgid "Blessings of magicks within."
msgstr "Hay bendiciones mágicas en su interior."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD"
msgid "The stone has taken on cold!"
msgstr "¡La piedra se ha puesto fría!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN"
msgid "Cold teeth bite at me!"
msgstr "¡Los dientes fríos me muerden!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC"
msgid "A stone of great use!"
msgstr "¡Una piedra de gran utilidad!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT"
msgid "Loge would be proud."
msgstr "Loge estaría orgulloso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM"
msgid "The stone has taken on warmth!"
msgstr "¡La piedra se ha puesto caliente!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT"
msgid "Vikings do not wear horns."
msgstr "Los vikingos no llevan cuernos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME"
msgid "Home is where the hearth is!"
msgstr "¡El hogar es donde está tu corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT"
msgid "Signs of a battle past."
msgstr "Signos de una batalla pasada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC"
msgid "A most well placed sign."
msgstr "Una señal bien colocada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "I shall write a tale of triumph!"
msgstr "¡Escribiré un relato de triunfo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY"
msgid "Sticky and gross."
msgstr "Pegajoso y asqueroso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB"
msgid "Wouldn't make much of a comb."
msgstr "Cuánta dulzura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM"
msgid "A feast!"
msgstr "¡Un banquete!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS"
msgid "A feast!"
msgstr "¡Un banquete!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN"
msgid "How I long for battle."
msgstr "Qué ganas tengo de una batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI"
msgid "A true test of willpower."
msgstr "Una verdadera prueba de fuerza de voluntad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND"
msgid "Fenrir's spawn!"
msgstr "¡Engendro de Fenrir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE"
msgid "A fallen foe."
msgstr "Un enemigo caído."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND"
msgid "These hounds are true warriors."
msgstr "Estos sabuesos son verdaderos guerreros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH"
msgid "A token of a successful conquest."
msgstr "Un símbolo de una conquista exitosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE"
msgid "It casts a spell upon the dogged beasts."
msgstr "Lanza un conjuro sobre las bestias obstinadas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH"
msgid "A loyal companion, if ever there were one."
msgstr "Un compañero fiel, si alguna vez hubo uno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "An ensconced water sprite!"
msgstr "¡Hay un espíritu de agua!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "An unfortunate casualty of battle."
msgstr "Una desafortunada víctima de la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE"
msgid "Reminds me of home."
msgstr "Me recuerda a mi hogar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX"
msgid "Winter dwells inside!"
msgstr "¡El invierno habita dentro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM"
msgid "That stuff hurts my teeth."
msgstr "Cuando lo como me duelen los dientes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT"
msgid "A chunk of cold."
msgstr "Un trozo de frío."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND"
msgid "Teeth of frost!"
msgstr "¡Dientes de las heladas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK"
msgid "A backpack of the beast."
msgstr "Una bolsa de la bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF"
msgid "A gift from Ullr!"
msgstr "¡Un regalo de Ullr!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Woah!"
msgstr "¡Ahhh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "I suspect nothing of this rock."
msgstr "No sospecho nada de esta roca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF"
msgid "Who is that incredible warrior in the mirror?"
msgstr "¿Quién es ese guerrero increíble en el espejo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES"
msgid "Sticky and gross."
msgstr "Pegajoso y asqueroso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN"
msgid "The yield of an industrious candy farmer."
msgstr "La producción de un laborioso granjero de caramelos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS"
msgid "A feast!"
msgstr "¡Un banquete!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC"
msgid "A challenger!"
msgstr "¡Una contendiente!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD"
msgid "A conquered foe."
msgstr "Un enemigo conquistado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS"
msgid "I shall free thy deer this day!"
msgstr "¡Liberaré a este ciervo hoy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY"
msgid "What wonders will you reveal?"
msgstr "¿Qué maravillas revelarás?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK"
msgid "A secret, kept under lock and key!"
msgstr "¡Un secreto, guardado bajo llave!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT"
msgid "I taste a battle on the breeze!"
msgstr "¡Percibo una batalla en la brisa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "I don't think I'd ride that horse."
msgstr "No creo que pudiera montar en ese caballo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER"
msgid "Dearest creature... I am going to eat you."
msgstr "Querida criatura... voy a comerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER"
msgid "Poor unsuspecting meat beast."
msgstr "Pobre bestia de carne incauta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS"
msgid "You don't scare me, goat!"
msgstr "¡No me asustas, cabra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK"
msgid "The sack itself is the present."
msgstr "La mochila misma es el regalo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN"
msgid "A lantern to hold back the night."
msgstr "Una linterna para alumbrar la noche."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I shall not bend to whims of my foes."
msgstr "No me doblegaré ante los caprichos de mis enemigos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Tis a worthy suit of armor."
msgstr "Es una armadura digna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "That is not fit for a warrior!"
msgstr "¡No es apropiado para un guerrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "The wearer shalt be fleet of foot."
msgstr "Quien la lleve irá muy ligero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Tis not as sturdy as a warrior would hope."
msgstr "No es lo resistente que desearía un guerrero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Makes the wearer sharp of tooth."
msgstr "Quien la lleve será muy feroz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Makes the wearer keen of mind."
msgstr "Quien la lleve tendrá una gran mente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "I shall armor myself for battle!"
msgstr "¡Me pondré una armadura para la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Let us down the enemy's standard!"
msgstr "¡Derribemos el estandarte del enemigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE"
msgid "The call of battle has arisen in thee!"
msgstr "¡La batalla te llama!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Tis a coward who watches the fight."
msgstr "Es un cobarde que observa la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Be still my heart! Tis the king of battle helms!"
msgstr "¡Calma, mi corazón! ¡Es el rey de los cascos de batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Thy fire giant shall fight by our side."
msgstr "Tu gigante de fuego luchará a nuestro lado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I'd not dabble in thy horrid magic."
msgstr "No tocaré tu horrible magia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Sleipnir bestowed it with swiftness."
msgstr "Sleipnir lo ha dotado de rapidez."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "A barrage of Hel's fire."
msgstr "Una descarga de fuego de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "A blessing from Freya is contained within."
msgstr "Hay una bendición de Freya en su interior."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Tis heavily laden with Freya's blessings."
msgstr "Está cargado de las bendiciones de Freya."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A mighty blade for a mighty battle!"
msgstr "¡Una poderosa espada para una poderosa batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "The Rainbow Bridge conceals itself."
msgstr "El puente del arco iris se oculta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "The Rainbow Bridge opens!"
msgstr "¡El puente del arco iris se abre!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Horns, sharp as the spear of the Valkyrie."
msgstr "Cuernos, afilados como la lanza de la valquiria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY"
msgid "Thy axe is filled with burning passion this day!"
msgstr "¡Tu hacha rebosa hoy una pasión ardiente!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Tis a gate betwixt realms."
msgstr "Es una puerta entre reinos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "We dive, back into the ether!"
msgstr "¡Nos sumergimos de nuevo en el éter!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Magic stone, empower my spirit!"
msgstr "¡Piedra mágica, da poder a mi espíritu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Tis most heinous magic!"
msgstr "¡Es la magia más atroz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Empower me with thy Nox strength!"
msgstr "¡Dame poder con tu fuerza de Nox!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Twas not made for a warrior."
msgstr "No se ha hecho para un guerrero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE"
msgid "A fiery foe!"
msgstr "¡Un enemigo ardiente!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON"
msgid "The best allies are made in the heat of battle."
msgstr "Los mejores aliados se hacen en el fragor de la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "A dragon egg!"
msgstr "¡Un huevo de dragón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "This egg looks chilly."
msgstr "Este huevo parece frío."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It's warm and toasty."
msgstr "Está calentito."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It glows contentedly."
msgstr "Brilla contento."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC"
msgid "A faithful, fiery friend."
msgstr "Un amigo fiel y ardiente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "You must eat to keep your fires burning."
msgstr "Debes comer para mantener tu fuego ardiendo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING"
msgid "Its fires are dying out."
msgstr "Su fuego se está apagando."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH"
msgid "A fearsome eggy fang!"
msgstr "¡Un temible colmillo en un huevo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL"
msgid "It's not very scary now, is it?"
msgstr "Ahora no da mucho miedo, ¿verdad?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT"
msgid "Your fiery pools are no match for me!"
msgstr "¡Tus pozos de lava no son rival para mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND"
msgid "I shall not surrender to the fiery pits!"
msgstr "¡No me rendiré a los fosos ardientes!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK"
msgid "Stone belched forth by the earth's fiery heart!"
msgstr "¡Piedra salida del corazón ardiente de la tierra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF"
msgid "That is an ancient woodland being."
msgstr "Es un antiguo ser del bosque."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE"
msgid "That is an ancient woodland being."
msgstr "Es un antiguo ser del bosque."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN"
msgid "Sky blue nonsense plant."
msgstr "Planta tonta del cielo azul."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR"
msgid "This will return me to top form."
msgstr "Esto me devolverá a la plena forma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB"
msgid "Glow!"
msgstr "¡Brilla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER"
msgid "It lights the fires of mine heart!"
msgstr "¡Enciende el fuego de mi corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "The lightning has made you a unicorn warrior!"
msgstr "¡El rayo te ha convertido en un guerrero unicornio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "May I call you Unicorn?"
msgstr "¿Puedo llamarte unicornio?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN"
msgid "This could deal a lasting blow."
msgstr "Esto podría dar un golpe duradero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Oh, great lightning!"
msgstr "¡Oh, gran relámpago!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Bring with you lightning, Donner!"
msgstr "¡Trae contigo el relámpago, Donner!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS"
msgid "A spawn of the evil toothed seal."
msgstr "Un engendro de la malvada foca con dientes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG"
msgid "Burning such magic would seem a waste."
msgstr "Quemar esta magia parece un desperdicio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE"
msgid "A tree of life, but it is not Yggdrasil."
msgstr "Un árbol de la vida, pero no es Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT"
msgid "I hath birthed the root of terror!"
msgstr "¡Esta es la raíz del terror!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It bears the promise of horridness!"
msgstr "¡Lleva la promesa de lo horrendo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING"
msgid "Flaming log!"
msgstr "¡Tronco en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC"
msgid "Wood is always of value."
msgstr "La madera siempre es de valor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "The unicorn smiles upon me this day!"
msgstr "¡El unicornio me sonríe hoy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY"
msgid "It's nice, but it's no spear."
msgstr "Es bonita, pero no es una lanza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING"
msgid "It brings shame to the might of Yggdrasil."
msgstr "Avergüenza el gran poder de Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT"
msgid "Finally! A useful vegetable."
msgstr "¡Por fin! Un vegetal útil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I will be a meat farmer after all!"
msgstr "¡Tal vez seré una granjera de carne después de todo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB"
msgid "Be there method to this madness?"
msgstr "¿Es aquí donde se crea esta locura?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET"
msgid "He looks unhappy upon his throne."
msgstr "Parece infeliz en su trono."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE"
msgid "The corpse of the rutabaga still retains its magic."
msgstr "El cadáver del colinabo conserva su magia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP"
msgid "A stew of magic!"
msgstr "¡Un guiso de magia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE"
msgid "She just wants to go on a rutabaga saga."
msgstr "Quiere reunir una saga de colinabos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED"
msgid "Grilled rutabaga."
msgstr "Colinabo a la plancha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED"
msgid "A rutabaga!"
msgstr "¡Un colinabo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL"
msgid "The fuzzy trophy of a successful battle."
msgstr "El trofeo peludo de una batalla exitosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL"
msgid "Mayhaps the ink is invisible!"
msgstr "¡Tal vez la tinta sea invisible!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE"
msgid "The warrior stone!"
msgstr "¡La piedra del guerrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN"
msgid "Fee fi fo fum!"
msgstr "¡Clin, clin, clin!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "How dost thou grow?"
msgstr "¿Hasta dónde crecerás?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR"
msgid "Fit for a palace!"
msgstr "¡Perfecta para un palacio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB"
msgid "Tis a shrub of stone!"
msgstr "¡Un arbusto de piedra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE"
msgid "Even the winds cannot knock this tree down."
msgstr "Ni siquiera los vientos derribarán a este árbol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Hot log!"
msgstr "¡Tronco caliente!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A shrub on guard."
msgstr "Un arbusto en guardia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED"
msgid "What a nuisance."
msgstr "Qué fastidio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT"
msgid "Pond foliage."
msgstr "Follaje de estanque."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING"
msgid "It's ablaze!"
msgstr "¡Está ardiendo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT"
msgid "Burnt."
msgstr "Quemado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Another must be planted to maintain the balance of this realm."
msgstr "Es necesario plantar otro para mantener el equilibrio de este reino."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A warrior tree."
msgstr "Un árbol guerrero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL"
msgid "Arrg! Is that the antagonist to my saga?!"
msgstr "¡Arrg! ¿¡Es el antagonista de mi saga!?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD"
msgid "I can see into his pores."
msgstr "Puedo ver a través de sus poros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT"
msgid "Dark magic lives here."
msgstr "La magia oscura vive aquí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK"
msgid "Shall I unlock it?"
msgstr "¿Lo abro?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "A mechanical songstress."
msgstr "Una cantante mecánica."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE"
msgid "I prefer to roam free, my unicorn and I."
msgstr "Prefiero vagar libre, mi unicornio y yo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT"
msgid "The true fruit of the earth!"
msgstr "¡La verdadera fruta de la tierra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS"
msgid "Tiny feast balls."
msgstr "Bolas de banquete diminutas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT"
msgid "Such a shame."
msgstr "Una pena."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE"
msgid "Let's eat!"
msgstr "¡A comer!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING"
msgid "It's being prepared just the way I like it."
msgstr "Está quedando como me gusta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "All this rain isn't helping."
msgstr "Esta lluvia no ayuda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC"
msgid "Ah! A dangly rack for my meats!"
msgstr "¡Ah! ¡Un estante colgante para mi carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED"
msgid "Excellent battle provisions."
msgstr "Provisiones para la batalla excelentes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM"
msgid "Die soggy beast fish!"
msgstr "¡Muere, pez bestia empapado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT"
msgid "Beheaded. Burnt. Stinky."
msgstr "Decapitada. Quemada. Apestosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC"
msgid "I could smell it from back there!"
msgstr "¡Podría olerla desde allí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT"
msgid "I won't miss it."
msgstr "No me lo perderé."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Is this dwelling made of fish?"
msgstr "¿Es esta vivienda hecha de pescado?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT"
msgid "A lighted helm! For the darkness."
msgstr "¡Un casco con luz! Para la oscuridad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN"
msgid "The chilling breeze reminds me of my frigid home."
msgstr "La brisa fría me recuerda a mi hogar gélido."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC"
msgid "The runes hath been drawn!"
msgstr "¡Las runas están escritas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Tis blank as the cloudless sky."
msgstr "Está en blanco como el cielo despejado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM"
msgid "A surface on which to inscribe ancient runes."
msgstr "Una superficie en la que escribir runas antiguas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR"
msgid "What wonders. Let us duel!"
msgstr "Qué maravilla. ¡Retémonos a un duelo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST"
msgid "The conquest chest!"
msgstr "¡El cofre de la conquista!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN"
msgid "Can I add it to my helmet?"
msgstr "¿Puedo añadirlo a mi casco?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND"
msgid "He burrows with reckless abandon."
msgstr "Excava con un abandono imprudente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD"
msgid "A friend for my pocket."
msgstr "Un amigo para mi bolsillo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND"
msgid "Who's under there?"
msgstr "¿Quién está ahí debajo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT"
msgid "It's best to use every part of the animal."
msgstr "Es mejor utilizar cada parte del animal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL"
msgid "Something fiendish lives down there."
msgstr "Algo diabólico vive ahí abajo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY"
msgid "I don't trust you."
msgstr "No me fío de ti."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL"
msgid "What horrors dwell within?"
msgstr "¿Qué maravillas habrá dentro?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA"
msgid "Monster casserole."
msgstr "Guiso de monstruo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT"
msgid "Meat of the dark beasts."
msgstr "Carne de las bestias oscuras."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED"
msgid "All dried up."
msgstr "Se ha secado del todo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN"
msgid "Perhaps it crashed from the heavens."
msgstr "Tal vez ha caído de los cielos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC"
msgid "What dost thou want, altar?"
msgstr "¿Qué es lo que quieres, altar?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "It feeds from the power of Mani!"
msgstr "¡Se alimenta del poder de Máni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED"
msgid "Prepare for glorious battle!"
msgstr "¡Prepárate para la gloriosa batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "This shall not please the gods."
msgstr "Esto disgustará a los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE"
msgid "Mani cannot see us here."
msgstr "Máni no puede vernos aquí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC"
msgid "Mani's visage remains, even in the light of day."
msgstr "El rostro de Máni se ve incluso a la luz del día."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Mani claims the skies!"
msgstr "¡Máni conquista los cielos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Mani's retired to her realm for the eve."
msgstr "Máni se ha retirado a su reino durante la noche."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "Mani's power is on the wane."
msgstr "El poder de Máni está menguando."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "Mani's power grows!"
msgstr "¡El poder de Máni crece!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER"
msgid "Mani's gift may have some use yet!"
msgstr "¡El obsequio de Máni puede que aún siga siendo útil!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL"
msgid "I shall make an offering!"
msgstr "¡Haré una ofrenda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET"
msgid "A gift from Mani."
msgstr "Un regalo de Máni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED"
msgid "It hath knowledge within!"
msgstr "¡Alberga conocimiento en su interior!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES"
msgid "It has faced Mani's wrath."
msgstr "Se ha enfrentado a la ira de Máni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE"
msgid "I wish I could ride it into battle."
msgstr "Ojalá pudiera montar en él para luchar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG"
msgid "Something is bouncing around inside."
msgstr "Algo está rebotando dentro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "A nest of adorable villainy."
msgstr "Un nido de villanía adorable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC"
msgid "Ugh! These things are useless!"
msgstr "¡Aghh! ¡Estas cosas son inútiles!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD"
msgid "Settle demon fury!"
msgstr "¡Detén la furia del demonio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK"
msgid "The blood will make me strong."
msgstr "La sangre me hará más fuerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING"
msgid "You are not large enough to be a steed."
msgstr "No eres lo bastante grande como para ser un corcel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG"
msgid "Loot trumped desecration!"
msgstr "¡Profanación de botín!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC"
msgid "Are there treasures beneath the gravestones?"
msgstr "¿Hay tesoros debajo de las lápidas?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "It makes me long for the stage!"
msgstr "¡Me hace desear el escenario!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "It hath a glow about it."
msgstr "Desprende un resplandor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "A warrior's tool!"
msgstr "¡Una herramienta de guerrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB"
msgid "Defend thyselves, my allies!"
msgstr "¡Defendeos, mis aliados!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT"
msgid "This helm runs flush with the forest's magic!"
msgstr "¡Este casco contiene la magia del bosque!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Naught but ash."
msgstr "Nada más que ceniza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Destroy the source of its unholy power!"
msgstr "¡Destruye el origen de este poder impío!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Twas consumed by a mighty inferno!"
msgstr "¡Lo ha consumido un temible infierno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "An empty home for forest sprites."
msgstr "Un hogar vacío para los duendes del bosque."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It is growing strong and hearty."
msgstr "Están creciendo fuertes y vigorosos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "A blight has beset this log. Another!"
msgstr "Una plaga ha asolado este tronco. ¡Otro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Not all can withstand the frost giant's touch."
msgstr "No todo puede resistir la mano del gigante de escarcha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The forest sprite has taken root."
msgstr "El duende del bosque ha echado raíces."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "The forest sprite has returned a glorious bounty!"
msgstr "¡El duende del bosque ha producido un botín glorioso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Laid to waste."
msgstr "Ahora es inservible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "A gift from the earth."
msgstr "Un obsequio de la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Tis a spotted spotlight!"
msgstr "¡Una luz moteada!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Twas consumed by Hel's fire."
msgstr "Lo ha consumido el fuego de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I demand strong, passionate colors. Red!"
msgstr "Exijo colores fuertes y apasionados. ¡Rojo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Behold! It blazes bright!"
msgstr "¡Contemplad! ¡Arde con brillo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "What a great effect!"
msgstr "¡Qué gran efecto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "I do like its glow."
msgstr "Me gusta su brillo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "I'll fight alongside you any day!"
msgstr "¡Lucharé a tu lado cualquier día!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I don't care for mushrooms."
msgstr "Me dan igual los champiñones."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "An enthusiastic performance!"
msgstr "¡Una actuación entusiasta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "What magic is this?"
msgstr "¿Qué clase de magia es esta?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "This mushroom needs to be retired."
msgstr "Hay que arrancar este hongo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT"
msgid "I'm more comfortable around my own fire."
msgstr "Estoy más cómoda cerca de mi propio fuego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL"
msgid "The fuel of darkness!"
msgstr "¡El combustible de la oscuridad!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT"
msgid "It harnesses dark powers from beneath."
msgstr "Aprovecha los poderes oscuros de abajo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Nothing stirs."
msgstr "Nada se mueve."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Barely any magic remains."
msgstr "Apenas queda nada de magia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The magic slumbers far from here."
msgstr "La magia duerme desde aquí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The magic power holds steady."
msgstr "La magia guarda energía constante."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "It's starting to retreat!"
msgstr "¡Está empezando a retirarse!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's starting..."
msgstr "Está empezando..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The magic is heightening!"
msgstr "¡La magia se está acentuando!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK"
msgid "A weapon worthy of Thor."
msgstr "Un arma digna de Thor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD"
msgid "It takes a brave warrior to wield this sword."
msgstr "Hace falta un valiente guerrero para empuñar esta espada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE"
msgid "It contains explosive components."
msgstr "Contiene componentes explosivos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE"
msgid "Perhaps a sword-wielding maiden lies beneath."
msgstr "Tal vez se esconda debajo una doncella con espada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND"
msgid "Sing with me! We are the guardians of Asgard!"
msgstr "¡Canta conmigo! ¡Somos los guardianes de Asgard!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM"
msgid "The spoils of war!"
msgstr "¡Los botines de la guerra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF"
msgid "It weaves the cold from thin air!"
msgstr "¡Teje el frío de la nada!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET"
msgid "Gathering has never been so easy."
msgstr "Reunir esto nunca ha sido tan fácil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM"
msgid "A stone of orange."
msgstr "Una piedra de color naranja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE"
msgid "May Odin guide us."
msgstr "Que Odín nos guíe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF"
msgid "A staff of magical movement."
msgstr "Un báculo de movimiento mágico."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST"
msgid "It contains a mystery."
msgstr "Contiene un misterio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE"
msgid "I prefer to face my enemies awake."
msgstr "Prefiero enfrentarme a mis enemigos despiertos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS"
msgid "May it carry forth the record of my saga."
msgstr "Que continúe con el registro de mi saga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK"
msgid "You will be felled this day."
msgstr "Caerás hoy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN"
msgid "Birds of the sea, come from afar."
msgstr "Aves del mar, procedentes de lejos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD"
msgid "You cannot run forever!"
msgstr "¡No puedes correr para siempre!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN"
msgid "Tis a fan for mine hand."
msgstr "Un abanico para mi mano."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT"
msgid "Laid to waste."
msgstr "Ahora es inservible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We must give it the gift of life."
msgstr "Debemos darle el regalo de la vida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC"
msgid "What treasures shall I bestow upon thee?"
msgstr "¿Con qué tesoros te obsequiaré?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES"
msgid "Pockets of meat."
msgstr "Bolsillos de carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS"
msgid "Thank you Froh for this gift!"
msgstr "¡Gracias por este regalo, Froh!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL"
msgid "These were not made by Froh."
msgstr "Estos no los hizo Froh."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "¡Mi mera presencia ha sembrado el terror en sus corazones de árbol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM"
msgid "The secretions of a terrible beast!"
msgstr "¡Las secreciones de una terrible bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE"
msgid "A trusty tool for securing spear and helm materials."
msgstr "Una herramienta fiable para conseguir materiales de lanza y yelmo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1"
msgid "The warrior spirit runs deep within him."
msgstr "El espíritu guerrero corre en su interior."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2"
msgid "He rages with berserker fury."
msgstr "Ruge con furia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3"
msgid "He shall not soil mine warrior reputation!"
msgstr "¡No manchará mi reputación de guerrera!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4"
msgid "Hath the strength of Yggdrasil."
msgstr "Tiene la fuerza de Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD"
msgid "He is battle ready, I can tell."
msgstr "Está listo para batalla, lo noto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK"
msgid "The pig died with honor, then gave to me this pack."
msgstr "El cerdo murió con honor y me dio esta mochila."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT"
msgid "Normally I like a good roast, but this is not right."
msgstr "Normalmente me gusta un buen asado, pero esto no es correcto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC"
msgid "This is savagery."
msgstr "Esto es salvajismo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT"
msgid "Loge did not smile upon you this day."
msgstr "Loge no te ha sonreído hoy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL"
msgid "Come out and go to war with me!"
msgstr "¡Salid y venid a la guerra conmigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC"
msgid "I did not think pigs could make houses."
msgstr "No sabía que los cerdos pudieran hacer casas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Do you not hunger for battle, pig?"
msgstr "¿No tienes hambre de batalla, cerdo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING"
msgid "Is it pig-Odin?"
msgstr "¿Es el cerdo-Odín?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD"
msgid "He died with honor."
msgstr "Murió con honor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER"
msgid "We ride to battle!"
msgstr "¡Nos dirigimos a la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC"
msgid "Will you fight alongside me, pig?"
msgstr "¿Lucharás conmigo, cerdo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD"
msgid "That pig looks brave."
msgstr "Ese cerdo parece valiente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG"
msgid "It has been tainted by Fenrir."
msgstr "Ha sido mancillado por Fenrir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "Ahora es inservible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Like me, it hungers only for meat."
msgstr "Al igual que yo, solo tiene hambre de carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC"
msgid "'Tis a tribute worthy of the Pig Gods."
msgstr "Es un homenaje digno de los dioses cerdo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN"
msgid "The hide of a pig creature."
msgstr "La piel de un cerdo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT"
msgid "It smells of breakfast!"
msgstr "¡Huele a desayuno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH"
msgid "Do these pigs worship Loge?"
msgstr "¿Adoran estos cerdos a Loge?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN"
msgid "The belt of a mighty pig warrior."
msgstr "El cinturón de un poderoso guerrero cerdo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE"
msgid "This baby tree is well protected by spiky armor."
msgstr "Este árbol bebé está bien protegido por una armadura de pinchos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING"
msgid "It has shed its armor. Grow, baby tree!"
msgstr "Se ha despojado de su armadura. ¡Crece, árbol bebé!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK"
msgid "A weapon for farmers."
msgstr "Un arma para los agricultores."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT"
msgid "I suppose it's close enough."
msgstr "Supongo que está lo suficientemente cerca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED"
msgid "Still green, but it'll do."
msgstr "Todavía está verde, pero servirá."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "A plant."
msgstr "Una planta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "I am a shieldmaiden, not a farmer!"
msgstr "¡Soy una escudera, no una granjera!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY"
msgid "Ugh, vegetables. I'm not sure what I expected..."
msgstr "Agh, verduras. No sé bien lo que esperaba..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Bested by the sun."
msgstr "Derrotada por el sol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER"
msgid "If %s is looking for trouble, I shall give it to them!"
msgstr "¡Si %s está en busca de problemas, los tendrá!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Forged in flame!"
msgstr "¡Forjado en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC"
msgid "Good health to you, %s!"
msgstr "¡Que tengas buena salud, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "El espíritu inquieto de %s podría revivirse con un corazón."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! To battle!"
msgstr "¡Asesino! ¡A luchar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER"
msgid "Freya smiles on %s."
msgstr "Freya sonríe a %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE"
msgid "Fruity flesh."
msgstr "Carne con sabor a fruta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED"
msgid "Seared fruit flesh."
msgstr "Carne de fruta a la plancha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Tiny nature bits."
msgstr "Pedacitos pequeños de la naturaleza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND"
msgid "Something lurks in the deep."
msgstr "Algo acecha en las profundidades."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE"
msgid "Ancient flora."
msgstr "Flora antigua."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP"
msgid "If only I could use it as camouflage from predators."
msgstr "Ojalá pudiera usarlo como camuflaje contra los depredadores."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN"
msgid "What are you meant to do with such a thing?"
msgstr "¿Qué pretendes hacer con eso?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE"
msgid "What in the name of the unicorn is this?"
msgstr "¿Qué es esto, en el nombre del unicornio?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN"
msgid "It might make a good bludgeon, at least."
msgstr "Podría ser un buen garrote, por lo menos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE"
msgid "Baked all the life out of it."
msgstr "Se le ha quitado toda la vida cocinándola."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED"
msgid "Piping hot orange mush."
msgstr "Papilla naranja ardiendo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN"
msgid "Do you wish to fight, vegetable?"
msgstr "¿Quieres luchar, vegetal?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS"
msgid "Tiny nature bits."
msgstr "Pedacitos pequeños de la naturaleza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET"
msgid "An amulet of dark powers."
msgstr "Un amuleto de poderes oscuros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM"
msgid "It is clouded by a mysterious energy."
msgstr "Está nublada por una energía misteriosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE"
msgid "Odin's eye guides our path."
msgstr "El ojo de Odín nos guía el camino."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "Accept my offering, oh mighty gods."
msgstr "Aceptad mi ofrenda, oh, poderosos dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "The beast grows restless when tis not fed."
msgstr "La bestia se inquieta cuando no se la da de comer."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "'Tis a post. Unworthy of mine attention."
msgstr "Un poste. Indigno de mi atención."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "It climbeth the walls."
msgstr "Ha escalado las paredes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A colossal queen."
msgstr "Una reina colosal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Servant of a terrible god."
msgstr "Un siervo de un dios terrible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "'Tis dedicated to its god."
msgstr "Está dedicada a su dios."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Its days of war are past."
msgstr "Sus días de guerra han terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "'Tis barren."
msgstr "Es estéril."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "'Tis a fancy bowl."
msgstr "Es un cuenco bonito."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "It will hold much meat."
msgstr "Tendrá mucha carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "A container for food."
msgstr "Un recipiente para alimentos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1"
msgid "Treasure!"
msgstr "¡Un tesoro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2"
msgid "Coin! Prepare to be spent!"
msgstr "¡Moneda! ¡Prepárate para ser gastada!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3"
msgid "Fortune is mine!"
msgstr "¡La fortuna es mía!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4"
msgid "I have earned the god's favor!"
msgstr "¡Me he ganado el favor del dios!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "T'would be an honor to be fed to the sky god, beast."
msgstr "Sería un honor ser alimentada al dios del cielo, bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Tis a delicacy!"
msgstr "¡Qué manjar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "It doth trap sea-meat."
msgstr "Atrapa carne marina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN"
msgid "Tis not food fit for a god."
msgstr "Esta comida no es digna de un dios."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR"
msgid "The wheat hath fallen in battle."
msgstr "El trigo ha caído en la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "This is certain to anger the god."
msgstr "Esto seguramente enfadará al dios."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I shall offer it to the great god!"
msgstr "¡Lo ofreceré al gran dios!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This shall quench the god's appetite."
msgstr "Esto saciará el apetito del dios."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "'Tis what the Gnaw desires, paltry though it is."
msgstr "Es lo que desea la Roedora, por miserable que sea."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "The Gnaw desires... not this."
msgstr "La Roedora desea... otra cosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Consumed by Hel's fire."
msgstr "Fue consumido por el fuego de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Foul ingredient for sacrificial foods!"
msgstr "¡Ingrediente asqueroso para comidas de ofrenda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "The stench!"
msgstr "¡Qué hedor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID"
msgid "Ah, the sweet innocence of youth."
msgstr "Ah, la dulce inocencia de la juventud."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "It came from an animal, yet is still not meat!"
msgstr "¡Ha salido de un animal, pero no es carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "A woman of good taste, like mineself!"
msgstr "Una mujer de buen gusto, ¡como yo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL"
msgid "It touches meat with the fires of Hel."
msgstr "Toca la carne con el fuego de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "An instrument of the savory."
msgstr "Un instrumento de lo sabroso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "It touches meat with the fires of Hel."
msgstr "Toca la carne con el fuego de Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "It doth not work like this."
msgstr "No funciona así."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE"
msgid "Tis a farming weapon."
msgstr "Un arma de cultivo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY"
msgid "'Tis the key to treasure!"
msgstr "¡Es la llave del tesoro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "Tis the key to Valhalla's gates."
msgstr "Es la llave a las puertas de Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Tis a magic light, surely."
msgstr "Una luz mágica, seguramente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "'Tis a magic light of short stature."
msgstr "Es una luz mágica de corta estatura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "A weapon for wheat!"
msgstr "¡Un arma para el trigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "What horrid home!"
msgstr "¡Qué casa tan horrible!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "'Tis full of goods."
msgstr "Está lleno de productos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "'Tis full of goods."
msgstr "Está lleno de productos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Non-meat, I shall not consume thee!"
msgstr "¡Alimento sin carne, no te consumiré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Growing non-meat fungus."
msgstr "Un hongo sin carne en crecimiento."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "'Tis vanquished."
msgstr "Ha sido derrotado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION"
msgid "I dare thee, provoke tears from mine eyes!"
msgstr "¡Te reto a que me provoques lágrimas en los ojos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "The gods shall deal with thee!"
msgstr "¡Los dioses se ocuparán de ti!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN"
msgid "I shall cook things in thee!"
msgstr "¡Cocinaré cosas ahí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "'Tis an instrument to vanquish food."
msgstr "Un instrumento para derrotar a la comida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "'Tis a fencing spear."
msgstr "Una lanza de valla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "'Tis a Valkyrie."
msgstr "Es una valquiria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "'Tis a Valkyrie."
msgstr "Es una valquiria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Water of life! But no water!"
msgstr "¡El agua de la vida! ¡Pero sin agua!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Valhalla's gate is opened to me."
msgstr "La puerta de Valhalla se abre para mí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Thou shalt not keep me out!"
msgstr "¡No me dejarás aquí fuera!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "'Tis a runestone."
msgstr "Una piedra rúnica."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Remnants of a Viking funeral."
msgstr "Los restos de un funeral vikingo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Thou cannot hide from me!"
msgstr "¡No puedes esconderte de mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Tis slain."
msgstr "Está muerto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "Be you tasty?"
msgstr "¿Estás sabroso?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It slumbers soundly."
msgstr "Duerme profundamente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "'Tis a fancy plate."
msgstr "Un plato bonito."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Be it a hot spring?"
msgstr "¿Eres un manantial?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Tis closed to us."
msgstr "Está cerrado para nosotros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "'Tis the key to another world."
msgstr "Es la llave a otro mundo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT"
msgid "Room for more meat!"
msgstr "¡Sitio para más carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO"
msgid "Vileness emerged from the earth."
msgstr "La vileza ha surgido de la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Useful only for sacrifice."
msgstr "Útil solo para el sacrificio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "It hangeth pots."
msgstr "Cuelga ollas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "'Tis no use to me in this form."
msgstr "No me sirve en esta forma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "We shall fill thee with meat!"
msgstr "¡Te llenaremos con carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "For the making of godly nectars!"
msgstr "¡Para elaborar néctares divinos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "T'would never grace a hall in Valhalla."
msgstr "Esto nunca estaría en un banquete en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "A felled metal steed."
msgstr "Un corcel de metal caído."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Twas pillaged long ago."
msgstr "Se saqueó hace mucho tiempo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Twas the site of a vicious raid."
msgstr "Fue el lugar de un asalto terrible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It hath fallen."
msgstr "Ha caído."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Nothing of value remains."
msgstr "No queda nada de valor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "The time is nigh!"
msgstr "¡Ya casi es la hora!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The time is nigh!"
msgstr "¡Ya casi es la hora!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Pillaged. But by what?"
msgstr "Saqueado. Pero ¿quién ha sido?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "If only they'd had a warrior to fight for them."
msgstr "Ojalá hubieran tenido un guerrero para luchar por ellos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "What foul being caused such destruction?"
msgstr "¿Qué mal ha causado esta destrucción?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It once led to adventure. Alas, no more."
msgstr "Una vez conducía a aventuras. Pero, ay, ya no."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It offers no sanctuary."
msgstr "No ofrece ningún santuario."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Twas left by cities past."
msgstr "Pertenece a alguna ciudad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Tis sealed away from prying eyes and prying hands."
msgstr "Está cerrada ante ojos curiosos y manos curiosas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON"
msgid "Tis a most delicious fish!"
msgstr "¡Es un pescado muy delicioso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "A feast from the sea."
msgstr "Un festín del mar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT"
msgid "Twill make the meat even more divine."
msgstr "Hará que la carne sea aún más divina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Tis the salt of the earth."
msgstr "Es la sal de la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "An ally to meat!"
msgstr "¡Un aliado de carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "'Tis ready to be pillaged!"
msgstr "¡Está listo para ser saqueado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "I shall put thee to good use."
msgstr "Te aprovecharé bien."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP"
msgid "Nectar of the gods."
msgstr "El néctar de los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "For pillaging from the trees."
msgstr "Para saquear a los árboles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING"
msgid "'Twill never again grow to its former glory."
msgstr "Nunca volverá a alcanzar a su antigua gloria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Alas, the nectar 'tis no longer sweet!"
msgstr "¡Ay, su néctar ya no es dulce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Baby non-meats."
msgstr "Alimentos sin carne bebé."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "'Tis a weapon of beastly slaughter!"
msgstr "¡Es un arma de matanza bestial!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "It contains the flavoring!"
msgstr "¡Contiene el sabor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Spice for the fanciest of foods."
msgstr "Especia para los alimentos más bonitos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Thine growing taketh too long!"
msgstr "¡Tu crecimiento tarda mucho!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "'Tis a flavoring sprig."
msgstr "Una ramita para dar sabor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "The nectar of the gods dwells within."
msgstr "El néctar de los dioses habita dentro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It has been chopped."
msgstr "Lo han cortado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "It hath been fouled by tiny beasts!"
msgstr "¡Lo han arruinado bestias diminutas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "I've no patience for thee, sap!"
msgstr "¡No tengo paciencia para ti, savia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I have acquired the nectar!"
msgstr "¡He adquirido el néctar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It hath been wounded!"
msgstr "¡Lo han herido!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "You would make a most honorable warrior."
msgstr "Serías un guerrero muy honorable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Your liege."
msgstr "Tu vasallo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It slumbers soundly."
msgstr "Duerme profundamente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Lodgings of mine enemy."
msgstr "El hogar de mi enemigo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Laid to ruin."
msgstr "Arruinada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Nectar of the gods, for the gods."
msgstr "El néctar de los dioses, para los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Will this not anger the gods?"
msgstr "¿No enfadará esto a los dioses?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "Sus entrañas son rojas, ¡pero aun así no es carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Prepare to barter!"
msgstr "¡Prepárate para el trueque!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "'Tis a jaunty-hatted beast."
msgstr "Es una bestia desenfadada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP"
msgid "The gods have strange tastes."
msgstr "Los dioses tienen unos gustos extraños."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "¡Puaj! ¡No te comeré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT"
msgid "O, glorious wheat!"
msgstr "¡Oh, glorioso trigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Un puñado de semillas, no dan carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC"
msgid "Jump into my mouth!"
msgstr "¡Salta en mi boca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD"
msgid "There is no escape!"
msgstr "¡No hay escapatoria!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Showtime, rabbits!"
msgstr "¡Hora del espectáculo, conejos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING"
msgid "It must be intermission for the rabbits."
msgstr "Debe ser el intermedio para los conejos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Good riddance, giant carrot."
msgstr "Hasta nunca, zanahoria gigante."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "What's to be done with a carrot that big?"
msgstr "¿Para qué sirve una zanahoria tan grande?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT"
msgid "Armor for rain."
msgstr "Armadura para la lluvia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT"
msgid "We will fight in the rain."
msgstr "Lucharemos en la lluvia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT"
msgid "Its prophecy days are done."
msgstr "Sus días de profecías han terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC"
msgid "It foretells the coming of rains."
msgstr "Predice la llegada de lluvia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE"
msgid "A pile of vegetables. No thanks."
msgstr "Un montón de verduras. No, gracias."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR"
msgid "A small blade, but a blade nonetheless."
msgstr "Un filo pequeño, pero un filo al fin y al cabo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM"
msgid "It is hot to the touch."
msgstr "Es caliente al tacto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN"
msgid "A lucky ward to guard against the night."
msgstr "Un amuleto para protegernos de la noche."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE"
msgid "Odin's eye, grant us wisdom!"
msgstr "¡Ojo de Odín, confiérenos sabiduría!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH"
msgid "A blessing of good fortune!"
msgstr "¡Una bendición de buena fortuna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP"
msgid "Umami or not, I don't want it."
msgstr "Umami o no, no lo quiero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED"
msgid "I don't want it, but I'm glad it survived trial by fire."
msgstr "No lo quiero, pero me alegro de que haya sobrevivido a la prueba del fuego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "At least it's got a nice color."
msgstr "Al menos tiene un color bonito."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "And stay down there!"
msgstr "¡Y no salgas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Good riddance."
msgstr "Hasta nunca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING"
msgid "See you in Asgard, reeds!"
msgstr "¡Nos vemos en Asgard, cañas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC"
msgid "Those are some hardy reeds."
msgstr "Estas cañas son fuertes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED"
msgid "Cut down in their prime."
msgstr "Cortadas cuando estaban en la flor de la vida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST"
msgid "Ha! The sun is no warrior if it cannot penetrate this."
msgstr "¡Ja! El sol no es ningún guerrero si no puede penetrar esto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC"
msgid "Fit for Asgard."
msgstr "Sirve para Asgard."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Ashes to ashes."
msgstr "Cenizas a las cenizas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I prefer battle to science."
msgstr "Prefiero la batalla a la ciencia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Dust to dust."
msgstr "Polvo al polvo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Perhaps science can enhance my combat skills."
msgstr "Tal vez la ciencia pueda mejorar mis habilidades de combate."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Its strange power did not protect it from fire."
msgstr "Su extraño poder no me protegió del fuego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "A mystical thing."
msgstr "Una cosa mística."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "No more meat will come from here!"
msgstr "¡De aquí no saldrá más carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "It is an absurd machine that makes meat."
msgstr "Una máquina absurda que hace carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Valhalla, we come!"
msgstr "¡Allá vamos, Valhalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Might the gods witness this visage and offer protection."
msgstr "Que los dioses sean testigos de este rostro y ofrezca su protección."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE"
msgid "It holds me back from Valhalla."
msgstr "Me protege de Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER"
msgid "Feel the passion inside!"
msgstr "¡Siente la pasión dentro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL"
msgid "Thy machismo frighten me not!"
msgstr "¡Tu machismo no me asusta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC"
msgid "Red like blood."
msgstr "Rojo como la sangre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD"
msgid "I prefer your black brethren."
msgstr "Prefiero a tus hermanos negros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This bird knows about the cold."
msgstr "Este pájaro conoce el frío."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Such fluffy feathers."
msgstr "Qué plumas tan suaves."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET"
msgid "A prisoner!"
msgstr "¡Un preso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK"
msgid "Smash!"
msgstr "¡Aplastar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS"
msgid "Some pretty normal rocks."
msgstr "Algunas rocas bastante normales."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY"
msgid "He may be a worthy combat comrade."
msgstr "Puede ser un digno compañero de combate."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A miniature frozen mountain."
msgstr "Una montaña congelada de miniatura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED"
msgid "Poor glacier!"
msgstr "¡Pobre glaciar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED"
msgid "Poor glacier!"
msgstr "¡Pobre glaciar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The lava crust is firm."
msgstr "La corteza de lava está dura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava crust is reforming."
msgstr "La corteza de lava se está rompiendo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Beautiful light!"
msgstr "¡Hermosa luz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks delicate."
msgstr "Parece delicada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON"
msgid "A gift from Mani."
msgstr "Un regalo de Máni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "¡Mi mera presencia ha sembrado el terror en sus corazones de árbol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "¡Mi mera presencia ha sembrado el terror en sus corazones de árbol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK"
msgid "Chaaaarge!"
msgstr "¡A la cargaaaaa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE"
msgid "You don't frighten me!"
msgstr "¡No me asustas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE"
msgid "Strong enough to bind the sails of my longship."
msgstr "Bastante fuerte para atar las velas de mi drakar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG"
msgid "Ruined for eating, but primed for battle."
msgstr "Arruinado por comer, pero preparado para la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY"
msgid "To absorb the felled queen's power!"
msgstr "¡Para absorber el poder de la reina caída!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE"
msgid "A pile of ancient rocks."
msgstr "Un montón de rocas antiguas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT"
msgid "A crown... that fights!"
msgstr "¡Una corona... que lucha!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT"
msgid "A warrior's wand!"
msgstr "¡La varita de un guerrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE"
msgid "Its days are not done."
msgstr "Sus días aún no han terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "What foul manner of chest is this?"
msgstr "¿Qué clase inmunda de cofre es este?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "I shall submit to the gods' judgment."
msgstr "Lo dejaré a juicio de los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN"
msgid "Mighty steeds can be unsaddled with this."
msgstr "Con esto se pueden desmontar poderosos corceles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC"
msgid "Now to find a faithful steed."
msgstr "Ahora a encontrar un fiel corcel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE"
msgid "Oh to fly on the wings of Valkyrie!"
msgstr "¡Oh, para volar en las alas de la valquiria!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR"
msgid "I ride to victory or death!"
msgstr "¡Cabalgo hasta la victoria o la muerte!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK"
msgid "Minerals, not meat."
msgstr "Minerales, no carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK"
msgid "Tis a castle of sand!"
msgstr "¡Un castillo de arena!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE"
msgid "The earth itself dares to fight me!"
msgstr "¡La propia tierra osa luchar conmigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I do not think I can best this rock in combat."
msgstr "No creo que pueda vencer a esta roca en combate."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Clever rock, you cannot surprise a warrior!"
msgstr "¡Roca lista, no puedes sorprender a una guerrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING"
msgid "Nooo! My spears!"
msgstr "¡Nooo! ¡Mis lanzas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED"
msgid "Disease festers within its soul."
msgstr "La enfermedad rezuma dentro de su alma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "¡Se debilita frente a mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC"
msgid "It longs to be a spear."
msgstr "Anhela ser una lanza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED"
msgid "The small tree has been slain!"
msgstr "¡El pequeño árbol ha muerto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED"
msgid "It has been shriveled by the heat."
msgstr "Se ha encogido por el calor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING"
msgid "The scarecrow burns."
msgstr "El espantapájaros está ardiendo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow dost yearn for nothing, now."
msgstr "El espantapájaros ya no espanta nada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC"
msgid "Dost thou yearn for a brain?"
msgstr "¿Ansías un cerebro?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON"
msgid "Rest easy, spirit. Your fight is over."
msgstr "Descansa, espíritu. Tu lucha ha terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "May the muses guide our hands!"
msgstr "¡Que las musas guíen nuestras manos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Lain to waste."
msgstr "Es inservible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A transformative altar for the stone gods."
msgstr "Un altar transformador para los dioses pétreos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "The muses have been kind this day."
msgstr "Las musas han sido amables hoy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "More apt for the halls of Valhalla."
msgstr "Más apto para las salas de Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Will this please the gods? Or anger them?"
msgstr "¿Agradará esto a los dioses? ¿O los enfadará?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "¡La bestia se ha despertado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "We've freed the figure slumbering in the stone."
msgstr "Hemos liberado a la figura que estaba durmiendo en la piedra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "A follower of Mimir, mayhaps?"
msgstr "¿Un seguidor de Mimir, tal vez?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "An abandoned monument to the gods?"
msgstr "¿Un monumento abandonado para los dioses?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Might we come to regret this action?"
msgstr "¿Lamentaremos esta acción?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "¡La bestia se ha despertado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "An icon of evil, surely!"
msgstr "¡Un icono del mal, sin duda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Dost thou yearn for a body?"
msgstr "¿Ansías un cuerpo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Warriors are not concerned with decorative sculptures."
msgstr "A los guerreros no les preocupan las esculturas decorativas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Gods help us on Mani's night."
msgstr "Los dioses nos ayudan en la noche de Máni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "¡La bestia se ha despertado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "I fear we've unleashed a great evil."
msgstr "Me temo que hemos desatado un gran mal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "It has strayed from the warrior's path."
msgstr "Se ha apartado del camino del guerrero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS"
msgid "Tiny nature bits."
msgstr "Pedacitos pequeños de la naturaleza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED"
msgid "Tiny nature bits, cooked to death."
msgstr "Pequeños trozos de naturaleza, cocinados hasta la muerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD"
msgid "May the secrets of this land be divulged by the gods."
msgstr "Que los dioses divulguen los secretos de esta tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT"
msgid "I am no seamstress, but repairs are sometimes necessary."
msgstr "No soy costurera, pero las reparaciones a veces son necesarias."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE"
msgid "Luckily I need be no seamstress with this!"
msgstr "¡Por suerte, no hace falta que sea costurera!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER"
msgid "I hope this serf is being treated with dignity."
msgstr "Espero que se trate a este siervo con dignidad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART"
msgid "Blackest hearts. Darkest omens."
msgstr "Los corazones más negros. Los presagios más negros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL"
msgid "I'd prefer a ship burial, though this might have its uses."
msgstr "Preferiría un entierro del barco, aunque esto puede tener sus usos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN"
msgid "A trophy of our battles!"
msgstr "¡Un trofeo de nuestras batallas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT"
msgid "It has been razed."
msgstr "Ha sido destruida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A place to rest one's battle-weary head."
msgstr "Un lugar para descansar la cabeza cansada por la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK"
msgid "Useful for binding, and for remembering victories past."
msgstr "Útil para tejer, y para recordar victorias pasadas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON"
msgid "Rest easy in Valhalla."
msgstr "Descansa bien en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT"
msgid "Immortal's sight was not meant for thee."
msgstr "La visión de los inmortales no era para ti."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s was felled by %s. Live on in Valhalla."
msgstr "%s ha perdido a manos de %s. Vive en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s was felled by %s. She will live on in Valhalla."
msgstr "%s ha perdido a manos de %s. Vivirá en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s was felled by %s. He will live on in Valhalla."
msgstr "%s ha perdido a manos de %s. Vivirá en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s was felled by %s. They will live on in Valhalla."
msgstr "%s ha perdido a manos de %s. Vivirá en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH"
msgid "The muses' knowledge, inscribed upon an ancient scroll!"
msgstr "¡El conocimiento de las musas, grabado en un antiguo pergamino!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST"
msgid "Ah, that was a good battle."
msgstr "Ah, ha sido una buena batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB"
msgid "Those who enter thy circle shalt know rest."
msgstr "Aquellos que entren en tu círculo conocerán el descanso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER"
msgid "The fur foe thinks she's a hat!"
msgstr "¡El enemigo peludo cree que es un sombrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT"
msgid "I do love furs."
msgstr "Me encantan las pieles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT"
msgid "I do love furs."
msgstr "Me encantan las pieles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE"
msgid "You are an angel. Of nasty."
msgstr "Eres un ángel. Desagradable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT"
msgid "A fine battle helm!"
msgstr "¡Un buen casco de batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE"
msgid "Not where I'd choose to hang my helm."
msgstr "No es donde elegiría colgar mi casco."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME"
msgid "Yes. Slime."
msgstr "Sí. Baba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "They're smashed up good."
msgstr "Han quedado bien destrozadas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC"
msgid "You are not fierce yet, bird."
msgstr "Tú aún no eres feroz, pájaro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You must eat to grow strong."
msgstr "Debes comer para crecer fuerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING"
msgid "The small bird looks famished."
msgstr "El pequeño pájaro parece estar muerto de hambre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT"
msgid "A nice meaty snack."
msgstr "Un delicioso bocado carnoso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED"
msgid "A small provision for a long campaign."
msgstr "Una pequeña provisión para una larga campaña."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER"
msgid "I shall best you, foe!"
msgstr "¡Te derrotaré, enemigo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE"
msgid "I like his helmet."
msgstr "Me gusta su casco."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT"
msgid "How much meat is hiding under there?"
msgstr "¿Cuánta carne se esconde ahí debajo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR"
msgid "That is not my favored spear, but it will do the trick."
msgstr "No es mi lanza preferida, pero servirá."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR"
msgid "The weapon of a brazen Valkyrie!"
msgstr "¡El arma de una valquiria descarada!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE"
msgid "Tis a divine spear!"
msgstr "¡Una lanza divina!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR"
msgid "My comrade in arms!"
msgstr "¡Mi compañero de armas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD"
msgid "Cut down in battle, like so many before it."
msgstr "Aplastada en la batalla, como muchas otras antes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC"
msgid "Eight legs and still no match for me!"
msgstr "¡Ocho patas y todavía no son rival para mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING"
msgid "I will give it a fair fight by waiting til it awakes."
msgstr "Permitiré que la batalla sea justa y esperaré hasta que despierte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN"
msgid "Crush them at the source!"
msgstr "¡Aplástalas todas de donde salen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK"
msgid "Squashing these would be a waste of future battles."
msgstr "Aplastarlos sería un desperdicio para futuras batallas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND"
msgid "Ripped from the abdomen of a slain spider."
msgstr "Arrancada del abdomen de una araña muerta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT"
msgid "A perfect way to infiltrate the enemy camp."
msgstr "Una manera perfecta de infiltrarse en el campamento enemigo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE"
msgid "Webbing. Never a good sign."
msgstr "Telarañas. Nunca una buena señal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK"
msgid "Webbing. Never a good sign."
msgstr "Telarañas. Nunca una buena señal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN"
msgid "Finally, a true test of my abilities."
msgstr "Por fin, una verdadera prueba de mis habilidades."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER"
msgid "You are so sneaky!"
msgstr "¡Eres tan astuto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER"
msgid "I'll smash you!"
msgstr "¡Te aplastaré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER"
msgid "That one's feisty."
msgstr "Esta es aguerrida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Victory once again!"
msgstr "¡Victoria una vez más!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "The champion of the spiders. To battle!"
msgstr "El campeón de las arañas. ¡A la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "It is cowardly to attack a sleeping enemy."
msgstr "Es cobarde atacar a un enemigo dormido."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD"
msgid "Age has only made this food gross, not wise."
msgstr "El tiempo solo ha convertido esta comida en más asquerosa, no más sabia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "At peace, benevolent flame spirit."
msgstr "Un espíritu de llama benévolo y en paz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I'll direct this light where I please."
msgstr "Dirigiré esta luz donde me plazca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "At peace, benevolent forest spirit."
msgstr "Un espíritu forestal benévolo y en paz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Dirigiré esta luz donde me plazca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC"
msgid "At peace, benevolent river spirit."
msgstr "Un espíritu de río benévolo y en paz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Dirigiré esta luz donde me plazca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT"
msgid "Frigid as a frost giant's heart."
msgstr "Frío como el corazón de un gigante de escarcha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT"
msgid "Behold! A gift from Wotan!"
msgstr "¡He aquí un regalo de Wotan!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO"
msgid "A storm of pain."
msgstr "Una tormenta de dolor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE"
msgid "Keep thy hand from out mine fires!"
msgstr "¡Aleja tus manos de mis fuegos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING"
msgid "Merely a table."
msgstr "No es más que una mesa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE"
msgid "Cave boulder."
msgstr "Roca de cueva."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL"
msgid "A pointy rock of sorts."
msgstr "Una especie de roca puntiaguda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER"
msgid "It lives to battle once more!"
msgstr "¡Vive para luchar de nuevo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM"
msgid "Tis no mindless beast!"
msgstr "¡No es una bestia tonta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION"
msgid "A fiend woven from the night!"
msgstr "¡Un demonio salido de la noche!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "That wasn't very respectful."
msgstr "Eso no ha sido muy respetuoso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "A curious homage to the gods."
msgstr "Un curioso homenaje a los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP"
msgid "It must be Gunnar. The snakes took his head."
msgstr "Debe ser Gunnar. Las serpientes se llevaron su cabeza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL"
msgid "The villain turns hero!"
msgstr "¡El villano se convierte en héroe!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Delicate appearance, but hard as stone. Admirable."
msgstr "Una apariencia delicada, pero dura como la piedra. Admirable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "What plagues you, fair maiden?"
msgstr "¿Qué mal te asola, hermosa doncella?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Tis a stone basin!"
msgstr "¡Un cuenco de piedra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL"
msgid "It could easily best regular wool in combat."
msgstr "Podría fácilmente ser mejor que la lana normal en combate."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER"
msgid "The sword on the back of a bee."
msgstr "La espada en la parte trasera de una abeja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT"
msgid "A hat for cooling after a raucous battle."
msgstr "Un sombrero para refrescarse después de una batalla feroz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT"
msgid "Filling the vegetable does not make it meat."
msgstr "Rellenar la verdura no la convierte en carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED"
msgid "Tis not foodstuff."
msgstr "Esto no es comida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT"
msgid "Hearty greenery."
msgstr "Una planta suculenta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED"
msgid "A feast for mine eyes!"
msgstr "¡Un festín para mis ojos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKBOAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKBOAT"
msgid "No wonder it sank. It is not a longship."
msgstr "No me extraña que se haya hundido. Ya no es un drakar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST"
msgid "It is a handsome vest, but it offers no protection."
msgstr "Es un hermoso chaleco, pero no ofrece ninguna protección."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY"
msgid "Long will the saga of this taffy be told."
msgstr "Se contará durante mucho tiempo la historia de este caramelo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD"
msgid "A fearsome bird! But I am not afraid."
msgstr "¡Un pájaro temible! Pero no tengo miedo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG"
msgid "It will grow into a formidable foe."
msgstr "Crecerá hasta convertirse en un enemigo formidable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It was you or me, bird."
msgstr "Era o tú o yo, pájaro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "This egg would not survive a Norse winter."
msgstr "Este huevo no sobreviviría a un invierno nórdico."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Fight your way out, bird!"
msgstr "¡Lucha para salir, pájaro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Borne of flame! Unless it cooks to death."
msgstr "¡Soporta el fuego! Al menos hasta que se cocina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "A time remains before this bird is to be born."
msgstr "Queda un poco antes de que nazca este pájaro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "It will soon wake to this world."
msgstr "Pronto despertará en este mundo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "A feathered warrior lurks inside."
msgstr "Un guerrero emplumado se esconde dentro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "A young bird of war will soon be born."
msgstr "Una joven ave de guerra pronto nacerá."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC"
msgid "You are not yet ready for battle, bird."
msgstr "Todavía no estás listo para la batalla, ave."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY"
msgid "I hope you like vegetables... the meat is for me."
msgstr "Espero que te gusten las verduras... la carne es para mí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING"
msgid "To enter battle with me is your choice, bird."
msgstr "Entablar batalla conmigo es cosa tuya, ave."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS"
msgid "It requires purple gems."
msgstr "Requiere gemas moradas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID"
msgid "It will harness my awesome speed."
msgstr "Aprovechará mi velocidad impresionante."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "To Asgard!"
msgstr "¡A Asgard!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "A bridge to another world."
msgstr "Un puente a otro mundo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "The bridge is unstable yet."
msgstr "El puente aún es inestable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "The bridge is incomplete."
msgstr "El puente está incompleto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX"
msgid "Perhaps it holds the secret to this land's Bifrost."
msgstr "Tal vez guarde el secreto del Bifröst de esta tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK"
msgid "A sturdy crank."
msgstr "Una manivela resistente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO"
msgid "No decency. It's not even metal meat."
msgstr "No hay decencia. No es ni siquiera carne de metal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING"
msgid "It appears to be similar to the Bifrost."
msgstr "Parece similar al Bifröst."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF"
msgid "Ride through the air and the sea!"
msgstr "¡Cabalga por el aire y el mar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT"
msgid "It has been razed."
msgstr "Ha sido destruida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC"
msgid "Sleep this night, and prepare for battle on the morrow."
msgstr "Duerme esta noche y prepárate para la batalla a la mañana siguiente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE"
msgid "It looks fierce. Into the fray!"
msgstr "Parece feroz. ¡A la refriega!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE"
msgid "Gooey, but dangerous. I like it."
msgstr "Viscoso, pero peligroso. Me gusta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS"
msgid "A tough hide."
msgstr "Una piel resistente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN"
msgid "I will thrust my spear into that mass of tentacles!"
msgstr "¡Embestiré con mi lanza contra esa masa de tentáculos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR"
msgid "A towering tentacled foe."
msgstr "Un enemigo con un tentáculo imponente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "A gross, grasping appendage."
msgstr "Un apéndice para agarrar asqueroso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "The lair of my tallest foe!"
msgstr "¡La guarida de mi enemigo más alto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE"
msgid "This material possesses gargantuan strength!"
msgstr "¡Este material posee una fuerza gigantesca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES"
msgid "Looks like shiny popped corn."
msgstr "Parece brillante maíz estallado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE"
msgid "Tis Loki's frost giant lure."
msgstr "El cebo de gigantes de escarcha de Loki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Ha! Finally, a worthy foe!"
msgstr "¡Ja! ¡Por fin un enemigo digno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE"
msgid "Give me your best shot, I'll not hold back!"
msgstr "¡Dame tu mejor golpe, no flaquearé!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "A cleft in the earth."
msgstr "Una grieta en la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "You will bend to my blade, toadstool!"
msgstr "¡Te doblegarás ante mi espada, fungusapo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Something emerges!"
msgstr "¡Algo está emergiendo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT"
msgid "It doesn't match my costume."
msgstr "No hace juego con mi traje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH"
msgid "Perfect for a nighttime assault."
msgstr "Perfecta para un asalto nocturno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "By the power of the sand!"
msgstr "¡Por el poder de la arena!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "To save my allies the journey."
msgstr "Para ahorrarles el viaje a mis aliados."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I shall desert this foul place!"
msgstr "¡Abandonaré este lugar inmundo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "A present from the mighty lion!"
msgstr "¡Un regalo del poderoso león!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX"
msgid "Meat of the nut is not true meat."
msgstr "La carne de un fruto seco no es verdadera carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS"
msgid "Let us battle with honor!"
msgstr "¡Luchemos con honor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR"
msgid "A marvel of science."
msgstr "Una maravilla de la ciencia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP"
msgid "A well constructed trap. Tonight we feast!"
msgstr "Una trampa bien construida. ¡Esta noche tendremos un festín!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH"
msgid "A treacherous trap."
msgstr "Una trampa traicionera."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "An excellent mace wasted, buried in the ground."
msgstr "Una maza excelente desperdiciada, enterrada en el suelo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT"
msgid "Its walls were torn down by fire."
msgstr "Sus paredes fueron derribadas por el fuego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A place to store my helm and spear whilst I rest."
msgstr "Un lugar para guardar mi yelmo y la lanza mientras descanso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP"
msgid "I am always ready."
msgstr "Siempre estoy lista."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP"
msgid "A dead end! I must stand and fight."
msgstr "¡Un callejón sin salida! Debo ser valiente y luchar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1"
msgid "Toys do not interest a great warrior such as I."
msgstr "Los juguetes no le interesan a una gran guerrera como yo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10"
msgid "A token of victory."
msgstr "Un símbolo de la victoria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11"
msgid "A warrior encased in armor. I'm told its name is \"Hal.\""
msgstr "Un guerrero en una armadura. Me ha dicho que se llama \"Hal\"."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12"
msgid "Remnants of Ms. Wicker's summons? Truly a fierce woman."
msgstr "¿Los restos de la batalla de la Sra. Wicker? Ciertamente una mujer feroz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13"
msgid "A small, peculiar woman."
msgstr "Una mujer pequeña y peculiar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14"
msgid "Tea is a luxury that warriors cannot afford."
msgstr "El té es un lujo que no pueden permitirse los guerreros."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15"
msgid "A noble fighter."
msgstr "Un luchador noble."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16"
msgid "A noble fighter."
msgstr "Un luchador noble."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17"
msgid "A poor weapon."
msgstr "Una pobre arma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18"
msgid "I must mentor the young one in battle strategy."
msgstr "Debo enseñar a los jóvenes la estrategia de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19"
msgid "A useless toy."
msgstr "Un juguete inútil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2"
msgid "Accompaniment for my ballad of triumphs."
msgstr "Un acompañamiento para la balada de mis triunfos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20"
msgid "Finally, a safe weapon with which to spar with my new allies."
msgstr "Por fin un arma segura con la que entrenar con mis nuevos aliados."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21"
msgid "Cooking utensils do not interest me."
msgstr "Los utensilios de cocina no me interesan."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22"
msgid "It won't stand up to the rigors of battle."
msgstr "No soportará los rigores de la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23"
msgid "Not as useful as a battle horn."
msgstr "No es tan útil como un cuerno de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24"
msgid "Grant me luck on the battlefield!"
msgstr "¡Dame suerte en el campo de batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25"
msgid "Perhaps the stench will drive the enemy away."
msgstr "Tal vez el hedor ahuyente al enemigo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26"
msgid "My allies will appreciate the survival training I've bestowed."
msgstr "Mis aliados apreciarán el entrenamiento de supervivencia que he tenido."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27"
msgid "This weak, flimsy wire reminds me... I must toughen Maxwell up!"
msgstr "Este alambre débil me recuerda que... ¡Debo fortalecer a Maxwell!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Hasta los débiles pueden lidiar temibles batallas en el tablero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Hasta los débiles pueden lidiar temibles batallas en el tablero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3"
msgid "Even my spear cannot undo this knot."
msgstr "Ni siquiera mi lanza puede deshacer este nudo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30"
msgid "Tis not a unicorn."
msgstr "Esto no es un unicornio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31"
msgid "Tis not a unicorn."
msgstr "Esto no es un unicornio."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32"
msgid "Reveal mine destiny, oh great fates!"
msgstr "¡Reveladme mi destino, oh, grandes Parcas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33"
msgid "The creature has been forever imprisoned upon the ring."
msgstr "La criatura ha estado siempre encerrada en el anillo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34"
msgid "Begone, foul magic!"
msgstr "¡Fuera de aquí, magia nauseabunda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35"
msgid "Twas a poison, most assuredly."
msgstr "Era un veneno, casi con total seguridad."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36"
msgid "Evidence of the undead. Stay wary, my allies!"
msgstr "Indicios de muertos vivientes. ¡Sed precavidos, mis aliados!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37"
msgid "For warding off Loki's minions."
msgstr "Para protegerse de los esbirros de Loki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38"
msgid "There is a tiny world trapped within!"
msgstr "¡Hay un mundo diminuto atrapado dentro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39"
msgid "To arms! The gauntlet has been thrown down!"
msgstr "¡A las armas! ¡Nos han retado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4"
msgid "A small, peculiar man."
msgstr "Un hombrecillo peculiar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40"
msgid "I have no use for such things."
msgstr "Estas cosas no me sirven."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41"
msgid "Perhaps some sort of elixir lies within?"
msgstr "¿Quizás haya algún tipo de elixir dentro?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42"
msgid "Tis no foe worthy of I."
msgstr "No es un enemigo digno de mí."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43"
msgid "What manner of creature be this?"
msgstr "¿Qué clase de criatura es esta?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44"
msgid "It has fallen in battle."
msgstr "Ha caído en la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45"
msgid "What stories might you tell, trapped spirit?"
msgstr "¿Qué historias podrías contar, espíritu atrapado?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46"
msgid "Tis a suspicious contraption!"
msgstr "¡Es un artilugio sospechoso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5"
msgid "Will it take me to Asgard?"
msgstr "¿Me llevará a Asgard?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6"
msgid "Useless technology."
msgstr "Tecnología inútil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7"
msgid "No time for games! I must train my new allies!"
msgstr "¡No hay tiempo para juegos! ¡Debo entrenar a mis nuevos aliados!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8"
msgid "It would make an okay weapon in a pinch."
msgstr "Sería una buena arma si fuera necesario."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9"
msgid "No decent armor could be made with these."
msgstr "Con esto no se puede hacer ninguna armadura decente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It will not suffice in the frozen wastes."
msgstr "No será suficiente en los páramos congelados."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER"
msgid "The warm pelt of a bested creature. A fine garment."
msgstr "La piel caliente de una criatura vencida. Una prenda fina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED"
msgid "A juicy reward after a hard battle."
msgstr "Una jugosa recompensa después de una dura batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER"
msgid "A powerful trunk of a fallen not-so-hairy beast."
msgstr "Una poderosa trompa de un una bestia caída no muy peluda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER"
msgid "A powerful trunk of a fallen hairy beast."
msgstr "Una poderosa trompa de un una bestia caída peluda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED"
msgid "Flee, bouncing coward!"
msgstr "¡Huye, cobarde planta andante!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR"
msgid "It soaks up the blood of battle."
msgstr "Absorbe la sangre de la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Fancy floor."
msgstr "Suelo elegante."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY"
msgid "A warm piece of the battlefield."
msgstr "Una pieza cálida del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MUD"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROAD"
msgid "The road to battle leads wherever we will it."
msgstr "El camino a la batalla conduce donde nosotros queramos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROCKY"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SANDY"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SAVANNA"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SINKHOLE"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_UNDERROCK"
msgid "A piece of the battlefield."
msgstr "Una pieza del campo de batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR"
msgid "Wooden flooring, a fine surface for mortal combat."
msgstr "Suelo de madera, una superficie elegante para el combate mortal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER"
msgid "A true feast."
msgstr "Un verdadero banquete."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS"
msgid "Your armor shalln't stop my spear."
msgstr "Tu armadura no detendrá mi lanza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING"
msgid "The wood's ablaze!"
msgstr "¡La madera está ardiendo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Loge took that one."
msgstr "Se lo ha llevado Loge."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Chopped by the warrior in the woods!"
msgstr "¡Talado por el guerrero de los bosques!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Disease festers within its soul."
msgstr "La enfermedad rezuma dentro de su alma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Triumph will accompany its many resources."
msgstr "El triunfo acompañará a sus múltiples recursos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT"
msgid "It will one one day rival Yggdrasil!"
msgstr "¡Un día se enfrentará a Yggdrasil!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "Grow tall and strong."
msgstr "Crece alto y fuerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD"
msgid "It will soon return to the earth."
msgstr "Pronto regresará a la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS"
msgid "Good for making spears."
msgstr "Buenas para fabricar lanzas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA"
msgid "Rain protection made from the trophy of a hunt."
msgstr "Protección contra la lluvia hecho con el trofeo de una caza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI"
msgid "No need for food to be so fancy."
msgstr "No hace falta que la comida sea tan bonita."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED"
msgid "A mysterious relic, sure to contain great power."
msgstr "Una misteriosa reliquia, seguro que contiene un gran poder."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES"
msgid "Waffles are no way to prepare for battle!"
msgstr "¡Los gofres no sirven para prepararse para la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT"
msgid "That won't do at all."
msgstr "Esto no bastará."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC"
msgid "A minor deterrent to attackers."
msgstr "Un pequeño elemento disuasivo para los atacantes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM"
msgid "Perhaps my foes will get lost in this hay."
msgstr "Tal vez mis enemigos se perderán en este heno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK"
msgid "Wholly impregnable, a worthy fortification!"
msgstr "¡Completamente inexpugnable, una fortificación digna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Our fortress shall be impenetrable!"
msgstr "¡Nuestra fortaleza será impenetrable!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS"
msgid "Nigh impenetrable."
msgstr "Casi impenetrable."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM"
msgid "Only the finest barriers for my fort."
msgstr "Solo las mejores barreras para mi fuerte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE"
msgid "My enemies will dash themselves on these rocks."
msgstr "Mis enemigos se aplastarán contra estas rocas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM"
msgid "A sturdy wall, fashioned from the earth."
msgstr "Una pared sólida hecha con el suelo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT"
msgid "Fire, wood's only weakness!"
msgstr "¡Fuego, la madera se debilita!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC"
msgid "It may impale a foe."
msgstr "Puede empalar un enemigo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM"
msgid "A mediocre fortification."
msgstr "Una fortificación mediocre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS"
msgid "Those tusks could pierce even the finest armor."
msgstr "Esos colmillos podrían perforar incluso la mejor armadura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT"
msgid "Highland filth!"
msgstr "¡Alta suciedad!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "They have departed for a great journey."
msgstr "Han partido para un gran viaje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "A proper winter camp."
msgstr "Un campamento de invierno como es debido."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK"
msgid "Rended from the mouth of the sea beast."
msgstr "Arrancado de la boca de la bestia marina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING"
msgid "No, my furs and cloaks!"
msgstr "¡No, mis pieles y abrigos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT"
msgid "No use crying over burnt pelts."
msgstr "No vale la pena llorar por pieles quemadas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC"
msgid "That's where I keep my furs and cloaks."
msgstr "Ahí es donde guardo mis pieles y abrigos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG"
msgid "Be that you, Fenrir?"
msgstr "¿Eres tú, Fenrir?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "Ahora es inservible."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY"
msgid "What doth thou need?"
msgstr "¿Qué necesitas?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC"
msgid "The gods are pleased!"
msgstr "¡Los dioses están contentos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE"
msgid "Bees of war!"
msgstr "¡Abejas de la guerra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON"
msgid "Prepare to engage in water-y battle!"
msgstr "¡Prepárate para participar en una batalla de agua!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON"
msgid "It makes a good sound when you hit it."
msgstr "Hace un buen sonido cuando la golpeas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT"
msgid "It's almost like wearing a pelt."
msgstr "Es casi como llevar un pellejo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE"
msgid "You cannot fool me by hiding in frozen fruit, stick."
msgstr "No puedes engañarme escondiéndote en fruta congelada, palo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED"
msgid "Warm and red, but it doesn't flow."
msgstr "Cálida y roja, pero no fluye."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS"
msgid "Seedy."
msgstr "Semillas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s is tempting fate."
msgstr "%s está tentando al destino."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "A fellow Viking, forged in flames!"
msgstr "¡Un compañero vikingo, forjado en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hail, %s, fellow shieldmaiden!"
msgstr "¡Salve, %s, compañera escudera!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST"
msgid "You'll not away to Valhalla yet, %s. A heart!"
msgstr "Aún no irás a Valhalla, %s. ¡Toma un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER"
msgid "There can be only one!"
msgstr "¡Solo puede haber una!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s, the perfect warrior!"
msgstr "¡%s, la guerrera perfecta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT"
msgid "The power of the unicorn is great."
msgstr "El poder del unicornio es grande."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER"
msgid "Waxen to the touch."
msgstr "Cera al tacto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER"
msgid "I sense Loki's influence in %s."
msgstr "Percibo la influencia de Loki en %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Loki has brought %s into a world of flame."
msgstr "Loki ha traído a %s a un mundo de llamas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC"
msgid "Greetings, %s, my ally!"
msgstr "¡Saludos, %s, mi aliado!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST"
msgid "A heart could return %s to this realm if we so wished."
msgstr "Un corazón podría devolver a %s a este reino si lo deseáramos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER"
msgid "%s! Back to your old tricks, I see!"
msgstr "¡%s! ¡Vuelves con tus viejos trucos, ya veo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER"
msgid "%s has uncovered the kindness buried within his heart."
msgstr "%s ha descubierto la amabilidad enterrada en su corazón."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL"
msgid "A tragic tale of woe and misery!"
msgstr "¡Una trágica historia de dolor y miseria!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER"
msgid "There's a new hunger in %s's eyes."
msgstr "Hay un hambre renovada en los ojos de %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER"
msgid "His flames are as open as his heart."
msgstr "Sus llamas están abiertas como su corazón."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC"
msgid "Blessings upon you, spiderchild %s!"
msgstr "¡Mis bendiciones, hijo de la araña %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST"
msgid "Return with Sleipnir's swiftness, many-legged one."
msgstr "Regresa con la rapidez de Sleipnir, ser con muchas patas."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER"
msgid "I've felled greater monsters than you, %s!"
msgstr "¡He derribado a monstruos más grandes que tú, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER"
msgid "%s's spirit burns brighter than Sol."
msgstr "El espíritu de %s arde con más brillo que Sol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL"
msgid "He fought boldly, but his burial will not be that of a Viking."
msgstr "Luchó con valentía, pero su entierro no será el de un vikingo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "I see naught but allies."
msgstr "No veo más que aliados."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER"
msgid "Do not test me, fair maiden!"
msgstr "¡No me pongas a prueba, valiente doncella!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER"
msgid "Ah. Have you singed your dress, fair maiden?"
msgstr "Ah, ¿te has quemado el vestido, valiente doncella?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC"
msgid "Spirits be with you, %s!"
msgstr "¡Que los espíritus estén contigo, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "El espíritu inquieto de %s podría revivirse con un corazón."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER"
msgid "%s, your body is weak but your heart is strong! Fight!"
msgstr "¡%s, tu cuerpo es débil pero tu corazón es fuerte! ¡Lucha!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER"
msgid "%s is channeling the spirit of Eir."
msgstr "%s está canalizando el espíritu de Eir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER"
msgid "Do you bite your thumb at me, mime?"
msgstr "¿Te ha mordido la lengua el gato, mimo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER"
msgid "Don't ruin your fair makeup with ashes, %s."
msgstr "No estropees tu bonito maquillaje con las cenizas, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC"
msgid "Good health to you, %s!"
msgstr "¡Que tengas buena salud, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST"
msgid "Meditate on Hoenir's blessings, %s. I'll find a heart."
msgstr "Medita sobre las bendiciones de Hoenir, %s. Te encontraré un corazón."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER"
msgid "May we meet again in Valhalla!"
msgstr "¡Hasta que nos encontremos de nuevo en Valhalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER"
msgid "%s has Hoenir's blessing."
msgstr "%s tiene la bendición de Hoenir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP"
msgid "Slop."
msgstr "Porquería."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER"
msgid "Tis drenched."
msgstr "Está empapado."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH"
msgid "A treasure lies within!"
msgstr "¡Hay un tesoro!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP"
msgid "Loud and powerful!"
msgstr "¡Fuerte y poderoso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "If %s is looking for trouble, I shall oblige!"
msgstr "¡Si %s está buscando problemas, se los daré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "I'll not question your wisdom, %s."
msgstr "No cuestionaré tu sabiduría, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Good health and wisdom to you, elder %s!"
msgstr "¡Que tengas buena salud y sabiduría, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "A heart! A heart! My base for a heart!"
msgstr "¡Un corazón! ¡Un corazón! ¡Mi base por un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Murderer! Face me in battle!"
msgstr "¡Asesino! ¡Enfréntate a mí en combate!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "The wisdom of Wotan dwells within you, %s."
msgstr "La sabiduría de Wotan habita dentro de ti, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER"
msgid "Should it come to blows, may the best maiden triumph."
msgstr "Si al final todo se decide en una lucha, que gane la mejor doncella."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER"
msgid "%s has more fire in her eyes than usual."
msgstr "%s tiene más fuego en sus ojos que de costumbre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC"
msgid "Greetings, %s, the Inflammable!"
msgstr "¡Saludos, %s, la inflamable!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST"
msgid "A heart shall wrench %s back from the jaws of death!"
msgstr "¡Un corazón sacará a %s de las fauces de la muerte!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER"
msgid "My spear was forged in passionate fires, %s!"
msgstr "¡Mi lanza se forjó con fuego apasionado, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER"
msgid "%s has a noble heart."
msgstr "%s tiene un corazón noble."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER"
msgid "Your honor wavers, %s."
msgstr "Tu honor se tambalea, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER"
msgid "Hm. I worry about you sometimes, %s."
msgstr "Hmm. A veces me preocupas, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC"
msgid "Wisdom guide you, %s!"
msgstr "¡Que la sabiduría te guía, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST"
msgid "The fate of the Draugr is not yours, %s. A heart!"
msgstr "El destino del Draugr no es tuyo, %s. ¡Un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER"
msgid "%s! Let us settle this in battle!"
msgstr "¡%s! ¡Dirimamos esto en la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER"
msgid "%s protects our people."
msgstr "%s protege nuestra gente."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER"
msgid "Dost thou test me, %s?"
msgstr "¿Me estás poniendo a prueba, %s?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s's flames could temper steel."
msgstr "Las llamas de %s podrían templar el acero."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC"
msgid "Greetings, brave %s!"
msgstr "¡Saludos, valiente %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST"
msgid "%s hath fallen! A heart!"
msgstr "¡%s ha caído! ¡Un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER"
msgid "I shall unleash Ragnarok upon thee!"
msgstr "¡Desataré el Ragnarok sobre ti!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER"
msgid "%s is guided by Brokkr."
msgstr "A %s lo guía Brokkr."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Tis engulfed in flame!"
msgstr "¡Está envuelto en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "¡Lo ha devorado el fuego de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Tis fueled by glorious magic."
msgstr "Está alimentado por una magia gloriosa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "¡No aguantará mucho más!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "It hath lost its incredible power!"
msgstr "¡Ha perdido su increíble poder!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Tis engulfed in flame!"
msgstr "¡Está envuelto en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "¡Lo ha devorado el fuego de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "The tinkerer hath many tricks."
msgstr "La manitas tiene muchos trucos."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "¡No aguantará mucho más!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "It hath lost its incredible power!"
msgstr "¡Ha perdido su increíble poder!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "¡Está envuelta en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "¡La ha devorado el fuego de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Reinforcements hath arrived! To battle!"
msgstr "¡Han llegado refuerzos! ¡A luchar!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It has no fighting spirit."
msgstr "No tiene espíritu de lucha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "¡Está envuelto en llamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "¡Lo ha devorado el fuego de Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "It can't get enough of me!"
msgstr "¡No se cansa de mí!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "It has no fighting spirit."
msgstr "No tiene espíritu de lucha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT"
msgid "Warm, but not suited for combat."
msgstr "Caliente, pero no adecuado para el combate."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT"
msgid "The measuring device has been slain by Loge."
msgstr "El dispositivo de medición ha sido asesinado por Loge."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC"
msgid "If only it measured the heat of battle."
msgstr "Ojalá midiera el calor de la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1"
msgid "How dost I free you from the bread, man of ginger??"
msgstr "¿Cómo te liberaré de la galleta, hombre de jengibre?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2"
msgid "Like a snowflake, it is a gift from the heavens!"
msgstr "¡Como un copo de nieve, es un regalo de los cielos!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3"
msgid "T'would look as divine on the tree as in mine mouth!"
msgstr "¡Esto quedará igual de divino en el árbol que en mi boca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4"
msgid "Stay back, foul creation!"
msgstr "¡Atrás, creación inmunda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5"
msgid "We feast tonight!"
msgstr "¡Esta noche tendremos un banquete!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6"
msgid "Twas plucked straight from my nightmares!"
msgstr "¡Me lo han arrancado de mis pesadillas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7"
msgid "Something so foul shall never pass my lips!"
msgstr "¡Algo tan inmundo jamás me tocará los labios!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8"
msgid "Warms the soul."
msgstr "Calienta el alma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9"
msgid "Imbibable eggs!"
msgstr "¡Unos huevos bebibles!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT"
msgid "A fragile beauty that must be protected."
msgstr "Una belleza frágil que debe ser protegida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Tis not a celebration without a good battle!"
msgstr "¡No hay celebración sin una buena batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Hath been forged in fires."
msgstr "Se ha forjado en el fuego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "It feeds the festive spirit."
msgstr "Alimenta el espíritu festivo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Tis a light enchantment, trapped inside a glass ball."
msgstr "Un encantamiento de luz, atrapado en una bola de cristal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING"
msgid "Woe! Misery!"
msgstr "¡Ay! ¡Qué desgracia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Su belleza vive en nuestros corazones."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "A majestic pine, worthy of celebration!"
msgstr "¡Un pino majestuoso, digno de celebración!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Grow strong, young one! It is your destiny!"
msgstr "¡Crece fuerte, retoño! ¡Es tu destino!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Su belleza vive en nuestros corazones."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "It awaits a grand tree!"
msgstr "¡Pronto será un gran árbol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s packs a punch to rival a frost giant."
msgstr "%s es un rival temible para un gigante de escarcha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "%s seems to have mistakenly fumbled a torch."
msgstr "%s parece que ha tirado por accidente una antorcha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC"
msgid "Health and strength to you, %s!"
msgstr "¡Que tengas salud y fuerza, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST"
msgid "A valiant warrior should not be wasted. A heart, a heart!"
msgstr "Un valiente guerrero no debe echarse a perder. ¡Un corazón, un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER"
msgid "You will pay for your heinous deeds, brute!"
msgstr "¡Pagarás por tus actos atroces, bruto!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s, son of Magni."
msgstr "%s, hijo de Magni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER"
msgid "I could fell you like so many trees, %s."
msgstr "Noto que te gustan mucho los árboles, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER"
msgid "I did not know %s possessed such power!"
msgstr "¡No sabía que %s poseyese tal poder!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You went out in a blaze of glory, %s."
msgstr "Has ardido envuelto en llamas, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Did he mistake \"Loge\" for \"log\"?"
msgstr "¡Que Loge te proteja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC"
msgid "May Yggdrasil bind us as the nine worlds, %s!"
msgstr "¡Que Yggdrasil nos una como los nueve mundos, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST"
msgid "The worldtree watches over you, %s."
msgstr "El árbol del mundo te vigila, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER"
msgid "By Yggdrasil, I will cut you down!"
msgstr "¡Por Yggdrasil, te derribaré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER"
msgid "%s's heart is as mighty as his beard."
msgstr "El corazón de %s es tan poderoso como su barba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT"
msgid "What's under that dirt?"
msgstr "¿Qué hay debajo de la tierra?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT"
msgid "I smell a trap."
msgstr "Huelo una trampa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM"
msgid "A snake beast from the depths!"
msgstr "¡Una bestia serpiente de las profundidades!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC"
msgid "Does it swallow those fallen in battle?"
msgstr "¿Se traga a aquellos caídos en batalla?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN"
msgid "Its maw welcomes me."
msgstr "Sus fauces me dan la bienvenida."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED"
msgid "It is sickly and weak."
msgstr "Es enfermizo y débil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT"
msgid "Glowing treasure, I can't resist!"
msgstr "¡Tesoro brillante, no puedo resistir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER"
msgid "Glow! Glow with all your might!"
msgstr "¡Brilla! ¡Brilla con toda tu fuerza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT"
msgid "I smell a trap."
msgstr "Huelo una trampa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER"
msgid "Back! Back, beast!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER"
msgid "%s stepped forth from Hel's flames!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC"
msgid "Hail, fire giant %s!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST"
msgid "An honorable Viking leaves no one behind!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER"
msgid "%s will pay for his trespasses!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER"
msgid "%s abides by a warrior's code."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER"
msgid "%s! You insult my honor!"
msgstr "¡%s! ¡Insultas mi honor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER"
msgid "That metal warrior would see this world burn."
msgstr "Ese guerrero de metal verá este mundo arder."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC"
msgid "May Thor's bolts energize you, %s!"
msgstr "¡Que los rayos de Thor te den energía, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST"
msgid "Metal warrior, it is not your time. A heart!"
msgstr "Guerrero de metal, no es tu momento. ¡Un corazón!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER"
msgid "We shall see whose steel is stronger, %s!"
msgstr "¡Veremos de quién es el acero más fuerte, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER"
msgid "%s is brimming with honor."
msgstr "%s rebosa honor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWAMULET"
msgid "A star, captured within an amulet."
msgstr "Una estrella capturada en un amuleto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWGEM"
msgid "A yellow beauty."
msgstr "Una belleza amarilla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWMOONEYE"
msgid "Odin, lend us your sight!"
msgstr "¡Odín, préstanos tu vista!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWSTAFF"
msgid "It summons the stars!"
msgstr "¡Invoca las estrellas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD1"
msgid "A meaty feast!"
msgstr "¡Un festín de carne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD2"
msgid "'Tis fit only for the beasts."
msgstr "Un festín solo para bestias."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD3"
msgid "I shall consume it!"
msgstr "¡Me lo comeré!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_GENERIC"
msgid "It is an artifact of this realm."
msgstr "Es un artefacto de este reino."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_SMOLDERING"
msgid "Flames will soon consume it."
msgstr "Las llamas lo consumirán pronto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_TOODARK"
msgid "Too dark, even for battle."
msgstr "Demasiado oscuro incluso para la batalla."

#. STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "Bones and all."
msgstr "Huesos y todo."

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_LOSE"
msgid "The god of the sky has been angered!"
msgstr "¡El dios del cielo se ha enfadado!"

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Alas! If I'd only grabbed it sooner."
msgstr "¡Ay! Si la hubiera comido antes."

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "T'were not meant to be a meal."
msgstr "Esto no era una comida."

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_WIN"
msgid "We shall live to fight another day!"
msgstr "¡Viviremos para luchar otro día!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "I shall have to find the key."
msgstr "Tendré que encontrar la llave."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I must wait and regain my strength."
msgstr "Debo esperar y recobrar mis fuerzas."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.HASPET"
msgid "One pet is enough responsibility."
msgstr "Una mascota es mucha responsabilidad."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.MOUNTED"
msgid "Even with my long arms, I still can't reach."
msgstr "Incluso con mis largos brazos, no alcanzo."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Oh. There go all my good pocket squares."
msgstr "Oh, ahí van todas mis posesiones."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "How could you improve on perfection?"
msgstr "¿Cómo puedes mejor la perfección?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE"
msgid "They're in much more dire need of it."
msgstr "Lo necesita mucho más."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "Well I need something to build with."
msgstr "Bueno, necesito materiales con los que construir."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "I don't like sharing."
msgstr "No me gusta compartir."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "It needs completely different plans."
msgstr "Necesita planos completamente diferentes."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That's the wrong part."
msgstr "Es la parte equivocada."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC"
msgid "Nothing ever goes as planned."
msgstr "Nunca nada sale como estaba previsto."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE"
msgid "Hmph. You're adding too much salt."
msgstr "Bah. Estás añadiendo demasiada sal."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR"
msgid "I must get closer."
msgstr "Tengo que acercarme."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE"
msgid "My memory isn't good enough to draw from it."
msgstr "Mi memoria no es lo bastante buena para dibujar de memoria."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "I had to try."
msgstr "Tuve que probar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY"
msgid "It's busy, currently."
msgstr "Ahora mismo está ocupado."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "It refuses to bend to my will."
msgstr "Se niega a doblegarse a mi voluntad."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD"
msgid "The dead have no need of such things."
msgstr "Los muertos no tienen necesidad de estas cosas."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE"
msgid "That can already be made here."
msgstr "Eso ya se puede crear aquí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL"
msgid "We've already placed something on the altar."
msgstr "Ya hemos colocado algo en el altar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC"
msgid "I should think not."
msgstr "Creo que no debería."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "I don't think so. They might still be mad."
msgstr "Creo que no. Puede que aún esté demente."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "A living log would be more suited to this."
msgstr "Un tronco vivo sería más adecuado."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "A mushroom would be more suited to this."
msgstr "Un hongo sería más adecuado."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON"
msgid "It's not going to work in here."
msgstr "No va a funcionar aquí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH"
msgid "That wouldn't be a very good sacrifice, now would it?"
msgstr "No sería un sacrificio muy bueno, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM"
msgid "Even The Amazing Maxwell couldn't wring magic from that."
msgstr "Ni el increíble Maxwell podría obtener magia de ahí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "That is certainly not for sculpting with."
msgstr "Esto ciertamente no es para esculpir."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "Hm. No, that's not right."
msgstr "Hmm. No, esto no funciona."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "I have bigger things to worry about right now."
msgstr "Tengo cosas más importantes de las que preocuparme ahora."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Ugh. I'm not doing anything in that mess."
msgstr "Agh. No pienso hacer nada con ese desorden."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "It's much too late for that."
msgstr "Es demasiado tarde para eso."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING"
msgid "It's thoroughly unconscious."
msgstr "Está totalmente inconsciente."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Occupied."
msgstr "Ocupado."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM"
msgid "That would be an amateurish misuse of its magic."
msgstr "Sería un mal uso poco profesional de su magia."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "The bones were too amateurishly assembled."
msgstr "Los huesos se han unido de forma muy poco profesional."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Cuando tengas un momento."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Los muertos no tienen necesidad de estas cosas."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "No tiene sentido darles más de lo que pueden llevar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Ehh... Te dejaré descansar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Cuando tengas un momento."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Los muertos no tienen necesidad de estas cosas."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "No tiene sentido darles más de lo que pueden llevar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Ehh... Te dejaré descansar."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE"
msgid "Once again the seat of power is stolen from me!"
msgstr "¡Una vez más me han robado mi asiento de poder!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Probablemente debería alejarme."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE"
msgid "It's unavailable."
msgstr "No está disponible."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I have no use of such things."
msgstr "No me sirven estas cosas."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "I could have told you that wouldn't fit."
msgstr "Te podría haber dicho que eso no iba ahí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Clearly this is the wrong dish."
msgstr "Claramente es el plato equivocado."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I've already put this on a dish."
msgstr "Ya lo he puesto en un plato."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Curses."
msgstr "Maldiciones."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE"
msgid "I'm quite adept at waiting. I've had a lot of practice."
msgstr "Soy bastante experto en esperar. He tenido mucha práctica."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Probablemente debería alejarme."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I don't think she'd take kindly to that."
msgstr "No creo que le vaya a gustar mucho esa idea."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC"
msgid "To what end?"
msgstr "¿Con qué fin?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS"
msgid "But it's already as smooth as a baby's rear end."
msgstr "Pero ya es tan suave como el trasero de un bebé."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC"
msgid "It wouldn't fit."
msgstr "No cabe ahí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE"
msgid "Worry not, pal. I've the patience of a saint."
msgstr "No te preocupes, amigo. Tengo la paciencia de un santo."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That can't go in there."
msgstr "Esto no entra ahí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN"
msgid "There's a lesson to be learned about tampering with secret knowledge."
msgstr "Se debe aprender una lección sobre manipular los conocimientos secretos."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN"
msgid "I am far too advanced for this."
msgstr "Soy demasiado avanzado para esto."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I seem to be in the wrong place to use this."
msgstr "Parece que estoy en el lugar equivocado para usar esto."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "I'll not be done in by an overgrown Krampus."
msgstr "No me derrotará un Krampus enorme."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "It appears there's another key around here."
msgstr "Parece que hay otra llave por aquí."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Blast! Wrong key."
msgstr "¡Diablos! Llave equivocada."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I don't know what to wrap."
msgstr "No sé qué envolver."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC"
msgid "I'm unable to do that right now."
msgstr "Ahora mismo no puedo hacer eso."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE"
msgid "I can wait... it's the courteous thing to do."
msgstr "Puedo esperar... Es lo más cortés."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC"
msgid "That didn't work."
msgstr "Eso no ha funcionado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT"
msgid "I need to pass the time somehow."
msgstr "Tengo que pasar el tiempo de alguna manera."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "Ah. The satisfaction of a job well done."
msgstr "Ah. La satisfacción de un trabajo bien hecho."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL"
msgid "I of all people should be able to do this."
msgstr "Yo de entre toda la gente debería ser capaz de hacer esto."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "My world is crumbling!"
msgstr "¡Mi mundo se está derrumbando!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "I am attacked by my own world!"
msgstr "¡Mi propio mundo me ataca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "An earthquake!"
msgstr "¡Un terremoto!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "May this tribute sate the beast."
msgstr "Que este tributo sacie a la bestia."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Does this entertain you, beast?"
msgstr "¿Te gusta este tributo, bestia?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "What a chore."
msgstr "Qué lata."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Dark magics are returning."
msgstr "La magia oscura regresa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Here we go again."
msgstr "Otra vez."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "The power's growing."
msgstr "El poder crece."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST"
msgid "oOooooOO!!"
msgstr "¡¡oOooOooo!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES"
msgid "Killing me won't bring back your honey!"
msgstr "¡Se me matáis no podré ir a por vuestra miel!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG"
msgid "Ow! Blasted... clumsy hands!"
msgstr "¡Ay! ¡Malditas... manos torpes!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION"
msgid "I was never really scared of those trees anyhow."
msgstr "En realidad nunca me dieron miedo esos árboles."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT"
msgid "It burns!"
msgstr "¡Arde!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "\n¡Creo que puedo arreglarlo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN"
msgid "The ceiling is going to collapse!"
msgstr "¡El techo va a derrumbarse!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE"
msgid "Charlie? It's me! Maxwell!"
msgstr "¿Charlie? ¡Soy yo! ¡Maxwell!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! Be gentle, Charlie!"
msgstr "¡Ay! ¡Charlie, sé amable!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD"
msgid "My heart grows cold."
msgstr "Mi corazón se enfría."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT"
msgid "The compass has fallen to pieces."
msgstr "La brújula está completamente rota."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL"
msgid "Er... I can't do that."
msgstr "Eh... No puedo hacer eso."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP"
msgid "Damp is not dapper."
msgstr "La humedad no es elegante."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS"
msgid "I hear one of them coming."
msgstr "Oigo venir a uno de ellos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN"
msgid "Say, pal, I don't look so good..."
msgstr "Colega, no tengo muy buen aspecto..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That takes care of that."
msgstr "Asunto resuelto."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK"
msgid "It'll be dark soon. Charlie will be waking up."
msgstr "Pronto se hará oscuro. Charlie se despertará."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC"
msgid "(Gulp!)"
msgstr "(¡Glub!)"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID"
msgid "I won't let that anywhere near my mouth."
msgstr "No dejaré que eso se acerque a mi boca."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL"
msgid "Ow! That hurt my mouth!"
msgstr "¡Ay! ¡Me he hecho daño en la boca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED"
msgid "That was putrid."
msgstr "Eso estaba podrido."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE"
msgid "That was past its expiration date."
msgstr "Esto ha caducado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY"
msgid "A civilized man does not eat such things."
msgstr "Un hombre civilizado no come ese tipo de cosas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1"
msgid "Reduced... to this..."
msgstr "Reducido... a esto..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2"
msgid "Huff... huff..."
msgstr "Uff... uff..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3"
msgid "This is... peasant... work..."
msgstr "Esto es... trabajo de esclavos..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4"
msgid "Oh... my back..."
msgstr "Ah... me duele la espalda..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5"
msgid "I wasn't... built for this..."
msgstr "No he nacido... para esto..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6"
msgid "All my joints... are cracking!"
msgstr "¡Todas las articulaciones... me crujen!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7"
msgid "I... was a king, you know..!"
msgstr "Fui... rey... ¡ya sabes!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK"
msgid "That smell... both nostalgic and terrifying!"
msgstr "¡Ese olor... es nostálgico y aterrador!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT"
msgid "Thank goodness for the light."
msgstr "Gracias a Dios por la luz."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT"
msgid "There goes my respite."
msgstr "Qué respiro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "¡Libertad, por fin!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "¡Susurran hasta el centro de mi mente...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "¡Mi cerebro crece con el poder!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "¡Mi corazón no puede soportar el calor!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Los sabuesos están cada vez más inquietos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "Estoy vacío por dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Huelo el estiércol y el sudor de la bestia."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "¡Maldición! Se ha escapado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "¡No puede seguirlo en estas condiciones!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Ha crecido solo un poquito."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Mis bolsillos están llenos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "The coward has summoned its minions."
msgstr "El cobarde ha invocado a sus esbirros."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to beat a hasty retreat!"
msgstr "¡Hora de batirse en rápida retirada!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its true power has been unlocked!"
msgstr "¡Su verdadero poder se ha desbloqueado!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh. My head hurts."
msgstr "Uf. Me duele la cabeza."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LEAVE_MINIGAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LEAVE_MINIGAME"
msgid "I don't need this anymore."
msgstr "Ya no necesito esto."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Can't touch this!"
msgstr "¡No toques esto!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Eso no ha sido muy informativo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS"
msgid "What annoying little bugs."
msgstr "Que bichitos más molestos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Say, pal, you don't look so good."
msgstr "Colega, no tienes muy buena pinta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERAFK"
msgid "I must be ever vigilant!"
msgstr "¡Debo estar muy atento!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT"
msgid "That's a terrible idea right now."
msgstr "Esa es una idea terrible ahora mismo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA"
msgid "They're hot on my heels!"
msgstr "¡Están pisando mis talones!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP"
msgid "Not while there's danger afoot!"
msgstr "¡No mientras haya peligro cerca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep during daylight hours."
msgstr "No puedo dormir durante el día."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Sleeping now would mess up my sleep schedule!"
msgstr "¡Si duermo ahora arruinaré mi patrón de sueño!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOFUEL"
msgid "I need some nightmare fuel."
msgstr "Necesito un poco de combustible de pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA"
msgid "Traditionally, a siesta comes after eating, not before."
msgstr "Tradicionalmente, una siesta viene después de comer, no antes."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry. I can't sleep."
msgstr "Tengo mucha hambre. No puedo dormir."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'm not opening that on top of this thing."
msgstr "No voy a abrir eso sobre esta cosa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA"
msgid "It's sleep time, not siesta time."
msgstr "Es hora de dormir, no hora de la siesta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "It's a bit creepy out for that."
msgstr "Es un poco espeluznante ahí afuera."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSANITY"
msgid "I have the worst headache!"
msgstr "¡Tengo un dolor de cabeza horrible!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE"
msgid "That might not be the best idea."
msgstr "Quizá no sea la mejor idea."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE"
msgid "You're kidding right?"
msgstr "Estás de broma, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP"
msgid "Odd. They forgot to set it."
msgstr "Qué raro. Se han olvidado de ponerla."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED"
msgid "Have patience!"
msgstr "¡Ten paciencia!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES"
msgid "Oh, this should be good."
msgstr "Oh, esto debe ser bueno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "How putrid!"
msgstr "¡Qué pútrido!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE"
msgid "That rumbling can't be good."
msgstr "Ese ruido no puede ser bueno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "¡Qué clase de artimaña es esta!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH"
msgid "Knowledge is power. And power is... well, power."
msgstr "El conocimiento es poder. Y el poder es... poder."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "That was simply undignified."
msgstr "Era simplemente indigno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "No need to thank me."
msgstr "No hace falta que me des las gracias."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE"
msgid "Allow me to assist."
msgstr "Deja que te ayude."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET"
msgid "The cycle begins again."
msgstr "El ciclo comienza de nuevo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO"
msgid "It's deemed me unworthy."
msgstr "Me considera indigno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES"
msgid "Was there ever a doubt?"
msgstr "¿Había atisbo de duda?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWSTRIKE_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWSTRIKE_ATTACK"
msgid "Shadow Strike!"
msgstr "¡Golpe sombrío!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER"
msgid "Protect me, cursed tree!"
msgstr "¡Protégeme, árbol maldito"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED"
msgid "How dare you!"
msgstr "¡Cómo te atreves!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED"
msgid "Wetter than water itself."
msgstr "Más húmedo que el agua sí misma."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED"
msgid "Quite an expert illusion."
msgstr "Una ilusión bastante experta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS"
msgid "I scratched my arms up doing that."
msgstr "Me he arañado los brazos haciendo esto."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT"
msgid "A shame."
msgstr "Una pena."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED"
msgid "It fled back into the earth."
msgstr "Se ha escondido de nuevo en la tierra."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING"
msgid "Now is the time to strike!"
msgstr "¡Ahora es el momento de atacar!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP"
msgid "Drat."
msgstr "Maldición."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOMANYBIRDS"
msgid "There are plenty of birds here already."
msgstr "Aquí ya hay muchos pájaros."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT"
msgid "Curses. Another light down."
msgstr "Maldita sea. Otra antorcha apagada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "It's about time."
msgstr "Ya es hora."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF"
msgid "Ack!"
msgstr "¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED"
msgid "Hmm, not quite done."
msgstr "Hmm, aún no está terminado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WAYTOOMANYBIRDS"
msgid "I must wait before I summon the birds again."
msgstr "Debo esperar antes de invocar a los pájaros de nuevo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET"
msgid "Water'll ruin a good suit, you know?"
msgstr "El agua arruinará un buen traje, ¿sabes?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER"
msgid "I don't think I'll ever be dry again."
msgstr "No creo que me vaya a secar nunca."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE"
msgid "Yech. It's horrible in there."
msgstr "Ay. Qué horrible es estar ahí."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS"
msgid "Oh dear. I know what's making that sound."
msgstr "Oh, no. Sé lo que está haciendo ese sonido."

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER"
msgid "You do not belong in MY world!"
msgstr "¡No perteneces a MI mundo!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC"
msgid "To arms!"
msgstr "¡A las armas!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG"
msgid "Brains over brawn!"
msgstr "¡Más vale maña que fuerza!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY"
msgid "Sacrifice yourself for my comfort!"
msgstr "¡Sacrifícate por mi comodidad!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER"
msgid "I'll not be made a fool of!"
msgstr "¡No haré el ridículo!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR"
msgid "You've forced my hand!"
msgstr "¡Has provocado a mi mano!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC"
msgid "And stay away!"
msgstr "¡Y no te acerques!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG"
msgid "Next time, pig!"
msgstr "¡La próxima vez, cerdo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY"
msgid "You're not worth my time!"
msgstr "¡No eres digno de mi tiempo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER"
msgid "I won't be made a fool of... next time!"
msgstr "¡La próxima vez... no me dejarás en ridículo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time the gloves come off!"
msgstr "¡La próxima vez me quitaré los guantes!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL"
msgid "Why won't these mortals just stay dead?"
msgstr "¿Por qué estos mortales no se pueden quedar muertos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Hm? What a familiar presence."
msgstr "¿Hmm? Qué presencia tan familiar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "It demands a sacrifice."
msgstr "Exige un sacrificio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I should quit toying with this now."
msgstr "Debería dejar de jugar con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I can sense strong magic within it."
msgstr "Noto una fuerte presencia de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "This enchantment is not of my doing."
msgstr "Este encantamiento no es cosa mía."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Whatever it is will be arriving soon."
msgstr "Sea lo que sea, llegará pronto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Even They couldn't build something so devious."
msgstr "Ni siquiera Ellos podrían construir algo tan retorcido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Un tipo al que le guste más la naturaleza podría hacer algo con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED"
msgid "Over an open fire."
msgstr "Sobre el fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Ah, parece que pertenece a la tierra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL"
msgid "So that's where I left that thing!"
msgstr "¡Así que ahí es donde dejé esa cosa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET"
msgid "It channels the darkest energies of the universe."
msgstr "Canaliza las energías más oscuras del universo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR"
msgid "Where are their gods now?"
msgstr "¿Dónde están sus dioses ahora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This can be partially restored."
msgstr "Esto puede ser restaurado parcialmente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE"
msgid "A once proud race."
msgstr "Una raza antaño orgullosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK"
msgid "Some dumb beast passed through here."
msgstr "Alguna bestia tonta pasó por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC"
msgid "Have you no pride?"
msgstr "¿Es que no tienes orgullo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's going to wreak havoc on my world."
msgstr "Va a causar el caos en mi mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We've placated it for now."
msgstr "Lo hemos placado por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET"
msgid "I'll cross it off my bucket list."
msgstr "Lo tacharé de mi lista de deseos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY"
msgid "That's some fly mail."
msgstr "Un dragón volador."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS"
msgid "Direct confrontation is quite gauche."
msgstr "La confrontación directa es bastante torpe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE"
msgid "That really isn't my style."
msgstr "Ese realmente no es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS"
msgid "Thulecite meshes so well with nightmare fuel."
msgstr "La tulecita se mezcla muy bien con el combustible de pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON"
msgid "Like all things, it craves the fuel."
msgstr "Como todas las cosas, tiene sed de combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER"
msgid "Wet, soggy, and oddly filling."
msgstr "Húmedo, empapado y con un relleno extraño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL"
msgid "That is not dapper at all."
msgstr "No es pulcra en absoluto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD"
msgid "Ugh. I'm not typically one for vulgar fisticuffs."
msgstr "Uf. A mí estas vulgares armaduras no me van."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY"
msgid "Wrap yourself in the nightmare. Embrace it."
msgstr "Déjate envolver por la pesadilla. Abrázala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Somehow, it says even less now."
msgstr "De alguna manera, dice incluso menos ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "\"Por ahí\"... ¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "This requires profundity."
msgstr "Esto requiere profundidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Somehow, it says even less now."
msgstr "De alguna manera, dice incluso menos ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "\"Por ahí\"... ¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "This requires profundity."
msgstr "Esto requiere profundidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC"
msgid "A fine powder that smells of destruction."
msgstr "Un polvo fino que huele a destrucción."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Don't worry. There will be more Chesters."
msgstr "No te preocupes. Habrá más Chesters."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "There's always another Glommer."
msgstr "Siempre hay otro Glommer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "My trip through the portal made it unrecognizable."
msgstr "Mi viaje a través del portal lo ha hecho irreconocible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is feeding off the dark energy."
msgstr "Se está alimentando de la energía oscura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Best not to overuse this power."
msgstr "Será mejor no abusar de su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Now we've gone and done it."
msgstr "La que hemos liado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It lacks a key."
msgstr "Le hace falta una llave."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON"
msgid "This is a most wretched idea."
msgstr "Es la peor idea del mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY"
msgid "It's strange to see it."
msgstr "Es extraño verla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No fuel, no power."
msgstr "Sin combustible, no hay luz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "It feeds off the nightmare."
msgstr "Se alimenta de la pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I can't believe I've forgotten how to read this."
msgstr "No me puedo creer que se me haya olvidado cómo leerlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of the city, before the fuel."
msgstr "Una pintura de la ciudad antes de la llegada del combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "We all know what happens next."
msgstr "Todos sabemos lo que ocurre a continuación."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They gained such an enviable power..."
msgstr "Han ganado un poder envidiable..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "I know why you led me back here."
msgstr "Sé por qué me has traído otra vez aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "But it won't work."
msgstr "Pero no funcionará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE"
msgid "There's a dreamlike quality to the material."
msgstr "El material tiene una cualidad irreal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE"
msgid "Sometimes the direct approach is best."
msgstr "A veces, el método directo es el mejor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "They're even ugly as infants."
msgstr "Son feos hasta de bebés."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Seems we've a few hours of reprieve."
msgstr "Parece que tenemos algunas horas de tregua."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK"
msgid "I wish there were porters around here."
msgstr "Ojalá hubiera mozos por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS"
msgid "Now that is a proper breakfast."
msgstr "Esto sí que es un desayuno en condiciones."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON"
msgid "This seems out of place here. Too cheery."
msgstr "Parece fuera de lugar aquí. Demasiado alegre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY"
msgid "Those look much too jovial for my liking."
msgstr "Son demasiado alegres para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE"
msgid "Sticky and gooey and good for putting on booboos."
msgstr "Pegajosa y empalagosa y buena para poner en las heridas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT"
msgid "I made a rock so heavy that even I can't lift it."
msgstr "He hecho una roca tan pesada que ni siquiera yo puedo levantarla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT"
msgid "Ugh. Ugly beasts."
msgstr "Uf. Bestias feas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT"
msgid "Violence has never felt better."
msgstr "La violencia nunca se ha sentido mejor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE"
msgid "Ugh. It stinks."
msgstr "Agh. Apesta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING"
msgid "I'm not eating that."
msgstr "No me voy a comer eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED"
msgid "I'm still not eating that."
msgstr "No pienso comerme esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR"
msgid "Hirsute."
msgstr "Hirsuto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER"
msgid "Take whatever you want."
msgstr "Llévate lo que quieras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST"
msgid "See my vest."
msgstr "Mira mi chaleco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR"
msgid "This would make a nice rug."
msgstr "Esto haría una bonita alfombra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY"
msgid "At least they're good for something."
msgstr "Al menos son buenos para algo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW"
msgid "I don't like sleeping rough."
msgstr "No me gusta dormir a la intemperie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC"
msgid "They work so hard, the fools."
msgstr "Trabajan muy duro, las pobres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD"
msgid "Now what do I do with it?"
msgstr "¿Ahora qué hago con ella?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT"
msgid "Honey roasted."
msgstr "Miel asada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So tempting, but so full of bees."
msgstr "Muy tentadora, pero tan llena de abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC"
msgid "It holds the bees."
msgstr "Guarda las abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "¿Por qué las abejas no están a mi servicio?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY"
msgid "So tempting, but so full of bees."
msgstr "Muy tentadora, pero tan llena de abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Debería esperar un poco más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like a creature that knows its place."
msgstr "Me gustan las criaturas que conocen su lugar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Aw nuts, it's following me."
msgstr "Ay, idiota, me está siguiendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC"
msgid "Just look at that stupid beast."
msgstr "Fíjate en esa bestia estúpida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED"
msgid "Now it looks dumb AND pathetic."
msgstr "Ahora parece estúpido Y patético."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY"
msgid "Yes, you understand how this works."
msgstr "Sí, entiendes cómo funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY"
msgid "I suppose some people might find that charming."
msgstr "Supongo que algunas personas lo encontrarían encantador."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER"
msgid "I'd only ride you if I was desperate."
msgstr "Solo me montaría en ti si estuviera desesperado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's only marginally less stupid when it's asleep."
msgstr "Es solo un poco menos estúpido cuando está dormido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT"
msgid "How unfashionable."
msgstr "Qué pasado de moda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL"
msgid "It smells like a barn."
msgstr "Huele a establo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD"
msgid "Keep your backside to yourself, madam!"
msgstr "¡No me interesa su trasero, señora!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT"
msgid "I'll wear it if I have to."
msgstr "Lo llevaré si tengo que hacerlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE"
msgid "Not the bees!"
msgstr "¡Las abejas no!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE"
msgid "They wait so patiently."
msgstr "Esperan tan pacientemente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL"
msgid "Maybe I shouldn't have put that there."
msgstr "Tal vez no debería haber puesto eso ahí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN"
msgid "I didn't make that one! Really!"
msgstr "¡Yo no he sido! ¡De verdad!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I am not getting that on my shoes."
msgstr "No pienso ponerse eso en los zapatos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Now what are those bees up to?"
msgstr "¿Qué traman esas abejas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "I don't see what all the buzz is about."
msgstr "No sé a qué viene tanto revuelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX"
msgid "I miss sealing a good letter."
msgstr "Echo de menos sellar una buena carta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR"
msgid "Back to the dungeons with you!"
msgstr "¡Vuelve a las mazmorras!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL"
msgid "More bell."
msgstr "Otra campana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE"
msgid "Just what am I looking at here?"
msgstr "¿Qué es lo que estoy mirando aquí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It's seen better days."
msgstr "Ha visto días mejores."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It makes me a little nostalgic."
msgstr "Me hace sentir un poco nostálgico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES"
msgid "Sigh. If I have to."
msgstr "Ay. Si tengo que hacerlo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY"
msgid "Delightfully sweet with a subtle hint of tartness."
msgstr "Deliciosamente dulce con un sutil toque de acidez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're quite delicious, actually."
msgstr "Están bastante deliciosas, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs manure."
msgstr "Necesita estiércol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING"
msgid "It better not start talking to me."
msgstr "Será mejor que no me empiece a hablar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "¿Qué ha traído esta aflicción a mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Parece que está un poco pocho, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Reduced to eating berries. Sigh."
msgstr "Obligado a comer bayas. Ay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED"
msgid "And now we wait."
msgstr "Y ahora a esperar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot for that little bush."
msgstr "Demasiado calor para un arbusto tan pequeño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It looks to be in need of assistance. Fertilizer, perhaps?"
msgstr "Parece necesitar ayuda. ¿Fertilizante, tal vez?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It better not start talking to me."
msgstr "Será mejor que no me empiece a hablar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "¿Qué ha traído esta aflicción a mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Parece que está un poco pocho, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The berries will stay fresh as long as I leave them there."
msgstr "Las bayas se mantendrán frescas siempre y cuando las deje allí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "I fear I'll have to wait."
msgstr "Me temo que tendré que esperar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I know the feeling."
msgstr "Conozco la sensación."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT"
msgid "Now that is surely fuel for nightmares."
msgstr "Sin duda es material para pesadillas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE"
msgid "A nut with legs! How terrifying!"
msgstr "¡Un fruto seco con patas! Aterrador!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD"
msgid "That's a deep sleep."
msgstr "Eso sí que es un sueño profundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC"
msgid "You'll never get me behind bars again."
msgstr "Nunca volveré a estar entre rejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about, feathers?"
msgstr "¿A qué viene tanto revuelo, plumas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "I feel for ya, feathers."
msgstr "Lo siento por vosotras, plumas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Maybe he wasn't sleeping."
msgstr "Igual no estaba durmiendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You'll still be in there when you wake up."
msgstr "Aún estarás ahí cuando despiertes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh, come on. I fed you last week."
msgstr "Ah, venga. Te di de comer la semana pasada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP"
msgid "They keep falling for it!"
msgstr "¡Siguen cayendo en la trampa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG"
msgid "I like to think of it as baby bird prison."
msgstr "Me gusta pensar en esto como una prisión para pajaritos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side up."
msgstr "La parte amarilla hacia arriba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP"
msgid "I'm especially proud of that piece."
msgstr "Estoy especialmente orgulloso de esa pieza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "How DARE you!"
msgstr "¡Cómo te ATREVES!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE"
msgid "They degrade without proper upkeep."
msgstr "Se degradan sin un mantenimiento adecuado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE"
msgid "Just make sure to breathe out."
msgstr "Solo asegúrate de exhalar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA"
msgid "That is not my style."
msgstr "Ese no es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2"
msgid "I'm no blowhard."
msgstr "No soy ningún fanfarrón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE"
msgid "A glorious tube of pain!"
msgstr "¡Un tubo glorioso de dolor!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP"
msgid "Call me \"Mr. Sandman\"."
msgstr "Llamadme el \"Arenero\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr "Nunca golpea dos veces en el mismo sitio, excepto cuando lo hace."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "Está gélido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "El azul atrae al hielo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr "¡Eso me recuerda que debo practicar mi mirada fría esta noche!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "Lo sé todo sobre eso. Pero... se me ha olvidado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr "Un plano raro, sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "¿Qué podría salir mal?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
msgid "Umami!"
msgstr "¡Umami!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "The blue ones are good for, uh, something."
msgstr "Los azules son buenos para, eh, algo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's not ready."
msgstr "No está listo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Another time, maybe?"
msgstr "¿En otro momento, tal vez?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS"
msgid "Roughly hewn."
msgstr "Ásperamente tallados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON"
msgid "Begone, swine."
msgstr "Largo, cerdo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR"
msgid "Well he's certainly no slouch."
msgstr "Bueno, tampoco es manco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT"
msgid "It's not going anywhere."
msgstr "No irá a ninguna parte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD"
msgid "Grind them bones."
msgstr "Muele los huesos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW"
msgid "Leave no scrap unused."
msgstr "Hay que aprovechar todos los despojos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS"
msgid "What a wasteful misuse of magic."
msgstr "Qué desmedido abuso de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE"
msgid "I've had enough fire and brimstone for one eternity."
msgstr "Ya he tenido suficiente fuego y azufre por una eternidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL"
msgid "The words within evoke an unknown force."
msgstr "Las palabras que contiene evocan una fuerza desconocida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL"
msgid "I could stop a fiend in its tracks with this."
msgstr "Podría detener a un demonio con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "No es aconsejable jugar con fuerzas que están más allá de tu comprensión."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP"
msgid "I haven't had a real sleep in... ages."
msgstr "No he dormido en condiciones desde hace... siglos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES"
msgid "What horrors shall be summoned from the depths?"
msgstr "¿Qué horrores saldrán de las profundidades?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG"
msgid "Beats getting your hands dirty."
msgstr "Es mejor que ensuciarse las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH"
msgid "It's like showing affection, without actually touching it."
msgstr "Es como mostrar afecto, sin realmente tocarla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET"
msgid "Good for capturing defenseless insects."
msgstr "Útil para capturar insectos indefensos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE"
msgid "Nice and snug."
msgstr "Cómodo y acogedor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP"
msgid "I guess we could wrap a few things up."
msgstr "Supongo que podría envolver algunas cosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN"
msgid "It reminds me of my old act."
msgstr "Me recuerda a mí antes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Utterly destroyed."
msgstr "Completamente destruido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT"
msgid "There's room in there for me."
msgstr "Hay espacio ahí para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER"
msgid "Some puns are irresistible."
msgstr "Algunos juegos de palabras son irresistibles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It's a flying flower."
msgstr "Es una flor voladora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD"
msgid "It would be a shame if someone ripped the wings off of it."
msgstr "Sería una pena si alguien le arrancara las alas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN"
msgid "That should stop its incessant flapping."
msgstr "Eso debería detener su incesante aleteo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS"
msgid "Ha ha ha. I got him!"
msgstr "Ja, ja, ja. ¡La atrapé!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD"
msgid "Carrion connoisseur."
msgstr "Conocedor de la carroña."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC"
msgid "Puffer plant."
msgstr "Planta hinchada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED"
msgid "Cactus? More like flat-tus!"
msgstr "¿Cactus? ¡Más bien planitus!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER"
msgid "This part of the cactus is always nice."
msgstr "Esta parte del cactus es siempre bonita."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT"
msgid "It would be unwise to put that in my mouth."
msgstr "Sería imprudente metérmelo en la boca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Cactus comestible."
msgstr "Cactus comestible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Voy a perderlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC"
msgid "How comforting."
msgstr "Qué reconfortante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Eso mantendrá a Charlie lejos por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs fuel."
msgstr "Necesita combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Fiery."
msgstr "Ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT"
msgid "That's not coming back."
msgstr "No regresará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC"
msgid "How do these things keep getting into my world?"
msgstr "¿Cómo siguen apareciendo estos bichos en mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD"
msgid "Bait."
msgstr "Cebo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED"
msgid "You look atrocious."
msgstr "Tienes una pinta atroz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG"
msgid "That's our sugar-sack."
msgstr "La bolsa de azúcar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE"
msgid "It has pictures of fast things carved into it."
msgstr "Tiene imágenes de cosas talladas en él."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT"
msgid "I'm not a fan of vegetables."
msgstr "No me gustan las verduras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED"
msgid "How mundane."
msgstr "Qué mundano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Such directionless destruction."
msgstr "Qué destrucción sin sentido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Mapmaking is a soothing pastime. Methodical."
msgstr "La cartografía es un pasatiempo relajante. Metódico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON"
msgid "Catty vermin."
msgstr "Alimaña felina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Vermin housing."
msgstr "Vivienda de alimañas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT"
msgid "Dead head."
msgstr "Cabeza muerta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Well it's not going to move itself."
msgstr "Bueno, no se va a mover sola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must deal with the others first."
msgstr "Primero debemos ocuparnos de las demás."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA"
msgid "Ashes in one's mouth."
msgstr "Cenizas en mi boca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I refuse to be held responsible for that."
msgstr "Me niego a ser responsable de eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Even worse than raw."
msgstr "Aún peor que crudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE"
msgid "It looks like a banana, but I'm not buying it."
msgstr "Parece un plátano, pero no me lo creo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE"
msgid "I plugged it a long time ago."
msgstr "La tapé hace mucho tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "When it's less claustrophobic, perhaps."
msgstr "Cuando sea menos claustrofóbico, tal vez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "That was not a good idea!"
msgstr "¡No ha sido una buena idea!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Off to plunder the depths."
msgstr "A saquear las profundidades."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Probably shouldn't venture any deeper."
msgstr "Probablemente no debería avanzar más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'd rather stay here than mingle with the crowds above."
msgstr "Prefiero quedarme aquí que mezclarme con la muchedumbre de arriba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Get me out of here!"
msgstr "¡Sacadme de aquí!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Onward to the next thing."
msgstr "Hacia la próxima aventura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN"
msgid "I'd like to step on it."
msgstr "Me gustaría entrar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL"
msgid "Nothing will steal my carbon!"
msgstr "¡Nada robará mi carbón!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1"
msgid "There's a reason I never finished that."
msgstr "Hay una razón por la que nunca he terminado eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2"
msgid "That one was a jerk."
msgstr "Ese era un estúpido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3"
msgid "Didn't like that one's face."
msgstr "No me gustaba su cara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER"
msgid "A brute."
msgstr "Un bruto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Could use a few more mechanical bits in my opinion."
msgstr "Le harían falta algunas piezas mecánicas más, en mi opinión."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "¡Las piezas se están moviendo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It's quite fetching."
msgstr "Es bastante irresistible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "What a gruesome maw."
msgstr "Qué fauces tan horribles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I don't like winters."
msgstr "No me gustan los inviernos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "It never stood a chance."
msgstr "Nunca tuvo nada que hacer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "What a well-dressed figure!"
msgstr "¡Qué figura tan bien vestida!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "This seems cruel."
msgstr "Parece cruel."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A dreadful lack of accordions."
msgstr "Qué pena que le falte el lomo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "And I thought chivalry was dead!"
msgstr "¡Y yo que pensaba que la caballería ya no existía!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE"
msgid "What an imbecilic expression."
msgstr "Qué expresión tan imbécil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE"
msgid "Must everything be about my shortcomings?"
msgstr "¿Tendrá todo que ver con mis defectos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN"
msgid "I have no idea what that is."
msgstr "No tengo ni idea de lo que es esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE"
msgid "Ceci n'est pas une pipe. Pity."
msgstr "Ceci n'est pas une pipe. Qué pena."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's nice, but where's the rust? The exhaust pipes?"
msgstr "Es bonita, pero ¿dónde está la oxidación? ¿Los tubos de escape?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "¡Las piezas se están moviendo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER"
msgid "Annoying little monster. Has his uses, though."
msgstr "Pequeño monstruo fastidioso. Sin embargo, es útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Stop looking at me!"
msgstr "¡Deja de mirarme!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "What is it waiting for?"
msgstr "¿A qué está esperando?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I was wise to be suspicious."
msgstr "Fui sensato al sospechar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE"
msgid "I don't trust it."
msgstr "No me fío de esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC"
msgid "This earthen beast's all fired up."
msgstr "Esta bestia terrenal está encolerizada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE"
msgid "How delightfully disconcerting."
msgstr "Qué deliciosamente desconcertante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Voy a perderlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC"
msgid "How comforting."
msgstr "Qué reconfortante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Eso mantendrá a Charlie lejos por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW"
msgid "It needs fuel."
msgstr "Necesita combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL"
msgid "Cold and fiery."
msgstr "Frío y ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT"
msgid "That's not coming back."
msgstr "No regresará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Someone should attend to that."
msgstr "Debería ocuparme de esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Una hoguera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A roaring, cold fire."
msgstr "Un fuego frío y crepitante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Se está apagando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's cold."
msgstr "Está frío."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT"
msgid "It's gone warm."
msgstr "Se ha puesto caliente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Este."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC"
msgid "I've lost my way."
msgstr "Me he perdido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Norte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Nordeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Noroeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Sur."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Sureste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Sudoeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Oeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I suppose I should build this."
msgstr "Supongo que debería construir esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE"
msgid "It has lost a lot of its power."
msgstr "Ha perdido gran parte de su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT"
msgid "It smells less like barnyard, now."
msgstr "Ahora huele menos a corral."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still filthy."
msgstr "Aún sigue siendo asquerosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT"
msgid "Well, at least it's not moving anymore."
msgstr "Bueno, al menos ya no volverá a moverse."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Demasiado hecho para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG
