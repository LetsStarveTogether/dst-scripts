msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.ATTACKER"
msgid "I'm gonna roll up a papyrus newspaper, just in case."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.FIRESTARTER"
msgid "We need to have a group meeting about fire safety."
msgstr "Necesitamos tener una reunión sobre seguridad contra incendios."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.GENERIC"
msgid "Good day, %s!"
msgstr "¡Buenos días, %s!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.GHOST"
msgid "%s is really buggin' me for a heart."
msgstr "%s está deseando que le dé un corazón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.MURDERER"
msgid "Murderer! I'll squash you, %s!"
msgstr "¡Asesino! ¡Te aplastaré, %s!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER.REVIVER"
msgid "%s is playing well with others."
msgstr "%s está jugando bien con los demás."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBERSKULL"
msgid "Poor little guy. He deserves a proper funeral."
msgstr "Pobrecillo. Se merece un entierro de verdad."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WEBBER_SPIDER_MINION"
