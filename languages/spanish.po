msgstr "Es repugnante. Debería matarla."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.SLEEPING"
