msgstr "Parece que está bien por el momento."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.OUT"
msgid "That's that."
msgstr "Se acabó."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "On its last legs."
msgstr "Está en las últimas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "It makes cold fire? I don't quite get it."
msgstr "¿Hace fuego frío? No lo entiendo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Properly roaring."
msgstr "Está crepitando debidamente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's gonna go out soon."
msgstr "Se va a apagar pronto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Doin' okay."
msgstr "Está bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.OUT"
msgid "Out, for now."
msgstr "Está apagado, por ahora."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.E"
