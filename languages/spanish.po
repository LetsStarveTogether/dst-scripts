msgid "We'll leave this sign for someone else."
msgstr "Dejaremos esta señal para otra persona."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "We're invincible!"
msgstr "¡Somos invencibles!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH"
msgid "That might've taught a toddler something."
msgstr "Eso podría haber enseñado algo a un niño."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "¡Chupa la sangre de otra persona!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "¡Nuestro amigo peludo está herido!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERAFK"
msgid "Can't! There's scary-biteys about!"
msgstr "¡No puedo! ¡Hay monstruos por ahí!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "¡Lo abriremos más adelante como celebración por sobrevivir a esto!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "¡No se puede dormir la siesta con monstruos cerca!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "¡No puedo dormir con monstruos cerca!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Es de día, no la hora de dormir."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "No estamos listos para ir a la cama."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "No podré echarme la siesta con la tripa sonando."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "Nuestro estómago hace ruido, no podemos dormir."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "¡Te prometo que volveré a montar sobre ti después de abrir mi regalo!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "¡No podemos echarnos una siesta, es de noche!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "¡Nada de siestas hasta el amanecer!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Mamá siempre decía \"No duermas en un edificio en llamas\"."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "¡No puedo! ¡Está ardiendo!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Chupado."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "¡Pájaro malo!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "¡Los árboles nos están gritando!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "¡Qué asco!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "No creo que eso fuese nuestra barriga."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "No podemos golpearlo."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "Es casi como volver al colegio."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "¡Ahora mucho mejor!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "¡Ya está!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "¡Aguanta, te ayudaremos!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "¡Todo ha vuelto!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "¡Pero eran regalos!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "¡Nos gusta!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "¡Protégenos, árbol!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "¡Eh! ¡No seas malo!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "¡Estamos empapados!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Are we seeing things?!"
msgstr "¿¡Vemos cosas!?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "¡Ayyy!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ah, era nuestro señuelo."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "¡Ay, la rana se ha ido!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "Está buscando una salida."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "¡Eh! ¡Estábamos usando eso!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "¡Ahhh, se nos ha apagado la luz!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "¡Estamos aquí!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "¡Puaj!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "¡Bah! Necesita más tiempo."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET"
msgid "We're unpleasantly moist."
msgstr "Estamos desagradablemente húmedos."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER"
msgid "Wet as a bathtub we can't crawl out of."
msgstr "Tan húmedo como una bañera de la que no podemos salir."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE"
msgid "That was a scary hole!"
msgstr "¡Qué miedo daba el agujero!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS"
msgid "Ohhh nooo. We're not friends with worms!"
msgstr "Ohhh, nooo. ¡No nos llevamos bien con los gusanos!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER"
msgid "Hopefully we're venomous!"
msgstr "¡Espero que seamos venenosos!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC"
msgid "En garde!"
msgstr "¡En guardia!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG"
msgid "We hate it! Horrible pig!"
msgstr "¡Lo odiamos! ¡Cerdo horrible!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY"
msgid "We will put you in our web!"
msgstr "¡Te pondremos en nuestra red!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER"
msgid "Hey, wanna play?"
msgstr "Eh, ¿quieres jugar?"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR"
msgid "Why can't we just get along?!"
msgstr "¿¡Por qué no nos podemos llevar bien!?"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC"
msgid "Well, we would have won!"
msgstr "¡Bueno, nos habría ganado!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG"
msgid "Another day, pig."
msgstr "Otro día, cerdo."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY"
msgid "Speedy thing!"
msgstr "¡Qué rapidez!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER"
msgid "We didn't actually want to hurt you."
msgstr "No queríamos hacerte daño."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Simmer down, friend."
msgstr "Relájate, amigo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL"
msgid "That's no party poltergeist!"
msgstr "¡No es ninguna fiesta de poltergeist!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Pretty petals!"
msgstr "¡Pétalos bonitos!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Scary blossoms!"
msgstr "¡Flores aterradoras!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Put it down! Put it down!"
msgstr "¡Suéltala! ¡Suéltala!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I think it's listening to us!"
msgstr "¡Creo que nos escucha!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's getting creepy!"
msgstr "¡Cada vez da más miedo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It gives us itches and skritches up our spine!"
msgstr "¡Nos da escalofríos por todo el cuerpo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It gives me a goal in life."
msgstr "Me da una meta en la vida."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN"
msgid "Tree or food, there's something inside."
msgstr "Árbol o alimentos, hay algo dentro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED"
msgid "Roasted on an open fire."
msgstr "Asado en un fuego abierto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING"
msgid "May you have a long and free life."
msgstr "Que tengas una vida larga y libre."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Something wicked this way comes."
msgstr "Algo malvado viene por aquí."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET"
msgid "It's a fine necklace, I suppose."
msgstr "Es un collar elegante, supongo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR"
msgid "Old and full of mysteries."
msgstr "Antiguo y lleno de misterios."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It's been busted up."
msgstr "Se ha hecho añicos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE"
msgid "It's throbbing strangely."
msgstr "Está latiendo de manera extraña."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK"
msgid "Whatever it is, it travels single file."
msgstr "Sean lo que sean, viajan en fila india."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC"
msgid "You're fuzzy. We like that."
msgstr "Tienes mucho pelo. Nos gusta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY"
msgid "I think it's upset."
msgstr "Creo que está molesta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It's always nice to have more bug friends."
msgstr "Siempre es bueno tener más amigos insectos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET"
msgid "Sand castles!!"
msgstr "¡¡Castillos de arena!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDRAGONFLY"
msgid "Another creature casing."
msgstr "Otro cuerpo de criatura."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORGRASS"
msgid "It just feels like more hair."
msgstr "Es como tener un poco más de pelo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORMARBLE"
msgid "Marbelous protection!"
msgstr "¡Protección maravillosa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORRUINS"
msgid "Nice and lightweight."
msgstr "Agradable y ligera."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSKELETON"
msgid "Rattle rattle."
msgstr "Qué traqueteo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSLURPER"
msgid "Squeeze our tummy tight!"
msgstr "¡Aprieta el abdomen apretado!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSNURTLESHELL"
msgid "It didn't protect the last guy."
msgstr "No protegió al último que la llevó."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWOOD"
msgid "Wood you like to fight?"
msgstr "¡Más madera!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_SANITY"
msgid "It's a bit uneasy wearing this, but so effective."
msgstr "Es un poco incómodo llevar esto, pero es eficaz."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "The lettering burnt off."
msgstr "Las letras se han quemado."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "We could write on that if only we had a pen!"
msgstr "¡Podríamos escribir ahí si tuviéramos un lápiz!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Ooooh, what should we say?"
msgstr "¿Ooooh, qué escribimos?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "The lettering burnt off."
msgstr "Las letras se han quemado."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "We could write on that if only we had a pen!"
msgstr "¡Podríamos escribir ahí si tuviéramos un lápiz!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Ooooh, what should we say?"
msgstr "¿Ooooh, qué escribimos?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC"
msgid "Funk to funky."
msgstr "Muy funky."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone didn't survive the trip."
msgstr "El hueso con ojo no sobrevivió al viaje."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower didn't make it."
msgstr "La flor no lo ha logrado."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Whatever it was, it's gone back to the earth."
msgstr "Fuera lo que fuese, ha regresado a la tierra."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "What's it doing?"
msgstr "¿Qué está haciendo?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It wasn't a way home, anyway."
msgstr "De todos modos, no era un camino a casa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "It looks like it's gonna blow up!"
msgstr "¡Parece que va a explotar!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF"
