msgstr "Este no me da buena espina."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PAWN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PAWN.GENERIC"
