msgstr "\"Las sombras son solo llamas invertidas\"."

#. STRINGS.SKIN_QUOTES.willow_survivor
msgctxt "STRINGS.SKIN_QUOTES.willow_survivor"
msgid "\"Surviving just requires strength of will. (And fire.)\""
msgstr "\"Sobrevivir solo requiere fuerza de voluntad. (Y fuego)\"."

#. STRINGS.SKIN_QUOTES.willow_victorian
msgctxt "STRINGS.SKIN_QUOTES.willow_victorian"
