msgstr "Me gusta mi barba."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.GENERIC"
