msgstr "No, esto así no es."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "Not today."
msgstr "Hoy no."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "That needs a magic log, eh?"
msgstr "Necesita un tronco mágico, ¿eh?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
