msgstr "Ох! Оно и должно так вонять?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
