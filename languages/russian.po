msgstr "Большая, как моя голова!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PUMPKINCOOKIE"
