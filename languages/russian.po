msgstr "Следующий костер, который ты разведешь, будет погребальным."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Приветствую, мисс %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.GHOST"
msgid "Do you desire a heart, %s?"
msgstr "Желаешь ли ты получить сердце, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Bloodthirsty warrior! This ends now!"
msgstr "Кровожадный воин! Этому придет конец!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s has excellent command of the spirit realm."
msgstr "%s отлично управляется с царством духов."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WATHGRITHRHAT"
msgid "Well... it's no crown."
msgstr "Ну… это не корона, конечно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXPAPER"
msgid "My interest in this wax paper wanes...."
msgstr "Я начинаю терять интерес к этой восковой бумаге…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.ATTACKER"
msgid "I know that look, %s. What are you up to?"
msgstr "Я знаю этот взгляд, %s. Что ты задумал?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Do not blow this for us, %s."
msgstr "Давай не будем раздувать, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GENERIC"
msgid "What a dapper fellow!"
msgstr "Какой щеголь!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.GHOST"
msgid "I'll have to pay in blood to bring you back, %s."
msgstr "Мне придется заплатить кровью, чтобы вернуть тебя, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.MURDERER"
msgid "Old habits die hard... and so will you!"
msgstr "Старые привычки тяжело искоренить… и тебя тоже!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELL.REVIVER"
msgid "Trust only yourself, hey %s?"
msgstr "Доверяешь лишь себе самому, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAXWELLJOURNAL"
msgid "I'm so sorry Charlie."
msgstr "Прости меня, Чарли."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.ATTACKER"
msgid "%s is looking downright feral..."
msgstr "%s выглядит совершенно диким…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Like a moth to flame. Or a spider, maybe."
msgstr "Как мотылек на пламя. Или паук."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Приветствую, мистер %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.GHOST"
msgid "Looks like you got squashed, %s."
msgstr "Похоже, тебя кто-то усмирил, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.MURDERER"
msgid "So, %s, you're a monster after all!"
msgstr "Значит, %s, ты все-таки чудовище!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER.REVIVER"
msgid "This child, %s, doesn't have a mean bone in his body."
msgstr "Этот малыш, %s, не имеет ни капли жестокости."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBERSKULL"
msgid "Reminds me of the good ol' days."
msgstr "Напоминает мне о старых добрых днях."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Disgusting."
msgstr "Отвратительно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.ATTACKER"
msgid "%s has been corrupted..."
msgstr "%s такая испорченная…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.FIRESTARTER"
msgid "Don't play with fire, Ms. %s."
msgstr "Не играйте с огнем, мисс %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GENERIC"
msgid "Greetings, Ms. %s. How are you?"
msgstr "Приветствую, мисс %s. Как ваши дела?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.GHOST"
msgid "%s's looking a little too much like her sister. Needs a heart."
msgstr "%s выглядит слишком похожей на сестру. Нужно сердце."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.MURDERER"
msgid "Don't think I'll hesitate, murderous fiend!"
msgstr "Не надейтесь, что я стану медлить, враг-убийца!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WENDY.REVIVER"
msgid "%s is a true death defier."
msgstr "%s — настоящий борец со смертью."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.ATTACKER"
msgid "%s is giving me the creeps..."
msgstr "%s вызывает у меня мурашки…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.FIRESTARTER"
msgid "Stop burning things, mime."
msgstr "Прекрати поджигать все подряд, мим."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Приветствую, мистер %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.GHOST"
msgid "I could get you a heart, %s... for a price."
msgstr "Я бы достал тебе сердце, %s… но не бесплатно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.MURDERER"
msgid "Murderous fiend! You cannot escape!"
msgstr "Враг-убийца! Тебе не убежать!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WES.REVIVER"
msgid "%s is an effective ally."
msgstr "%s — полезный союзник."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETGOOP"
msgid "How uncultured."
msgstr "Как некультурно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPAPER"
msgid "It's absorbent, at any rate."
msgstr "Впитывает все, абсолютно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WETPOUCH"
msgid "There's something inside it."
msgstr "Там внутри что-то есть."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WHIP"
msgid "Makes me feel like the master again."
msgstr "С ним я снова чувствую себя хозяином положения."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s is withholding information..."
msgstr "%s что-то скрывает…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Never pinned you for the wanton destruction type, Ms."
msgstr "Никогда бы не подумал, что у вас такая страсть к разрушениям, мисс."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Good day, Ms. %s."
msgstr "Доброго дня, мисс %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You know the price of revival as well as I do, %s."
msgstr "Вы не хуже меня знаете цену возрождения, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Do not start fights you cannot win!"
msgstr "Не начинай битву, которую не можешь выиграть!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s has excellent command of the dark arts."
msgstr "%s отлично управляется с темными искусствами."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.ATTACKER"
msgid "%s is not my ally..."
msgstr "%s — не мой союзник…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.FIRESTARTER"
msgid "She's a firestarter. And a twisted one, at that."
msgstr "Она — поджигатель. И совершенно повернута на этом."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Приветствую, мисс %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.GHOST"
msgid "We will require a heart to bring you back, %s."
msgstr "Понадобится сердце, чтобы вернуть тебя, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.MURDERER"
msgid "Murderous fiend! Taste my wrath!"
msgstr "Враг-убийца! Почувствуй мой гнев!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILLOW.REVIVER"
msgid "%s has bent reality to her fiery will."
msgstr "%s подчинила реальность своей огненной воле."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.ATTACKER"
msgid "You're going off the deep end, pal."
msgstr "Ты теряешь контроль над собой, приятель."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.FIRESTARTER"
msgid "The fire is supposed to go in the pit, Higgsbury."
msgstr "Огонь должен попасть в лунку, Хиггсбери."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GENERIC"
msgid "Err, greetings, Mr. %s."
msgstr "Эм-м, приветствую, мистер %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.GHOST"
msgid "Are you certain you wish to return to this world, %s?"
msgstr "Уверен, что хочешь вернуться в этот мир, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.MURDERER"
msgid "Our truce ends here, murderer!"
msgstr "Наше перемирие на этом заканчивается, убийца!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WILSON.REVIVER"
msgid "%s is a real pal..."
msgstr "%s — настоящий друг…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.ATTACKER"
msgid "%s has been roughhousing like a commoner."
msgstr "%s так ворвалась, где манеры?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.FIRESTARTER"
msgid "You were the last one I expected to start fires, %s."
msgstr "Уж от тебя-то страсти к поджогам точно никто не ждал, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GENERIC"
msgid "Greetings, Ms. %s."
msgstr "Приветствую, мисс %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.GHOST"
msgid "My, you're looking spirited today, %s."
msgstr "Боже, выглядишь такой оживленной, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.MURDERER"
msgid "You've engineered your own demise!"
msgstr "Ты сама спроектировала свою кончину!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINONA.REVIVER"
msgid "%s expertly uses all tools at her disposal."
msgstr "%s мастерски использует все предметы в ее распоряжении."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTERHAT"
msgid "How disappointingly rustic."
msgstr "К сожалению, выглядит по-деревенски."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.BURNT"
msgid "Who cares?"
msgstr "Кому вообще есть дело до него?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Not the most useful invention, is it?"
msgstr "Не самое полезное изобретение, не так ли?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD1"
msgid "Stop looking at me, cookie fiend."
msgstr "Не смотри на меня так, печенька-демон."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD2"
msgid "We're celebrating freezing to death, I see."
msgstr "Мы празднуем смертельный холод, ясненько."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD3"
msgid "I don't even use a cane."
msgstr "Я ведь даже не использую трость."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD4"
msgid "It is unbound from time."
msgstr "Оно свободно от оков времени."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD5"
msgid "How, err... traditional."
msgstr "Как, э-э-э… традиционно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD6"
msgid "It's extremely rich."
msgstr "Невероятно сдобно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD7"
msgid "Glorified apple juice."
msgstr "Славный яблочный сок."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD8"
msgid "Such a decadent beverage."
msgstr "Какой же декадентский напиток."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_FOOD9"
msgid "My... favorite... she remembered."
msgstr "Мое… любимое… она помнит."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENT"
msgid "Gaudy, like the rest of this shindig."
msgstr "Ярко, как и все остальное веселье."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "What a thing to risk one's life for."
msgstr "Вещь, ради которой стоило рисковать жизнью."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "How frivolous."
msgstr "Как легкомысленно."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNING"
msgid "It's a Winter's Feast miracle."
msgstr "Это волшебство Зимнего Праздника."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.BURNT"
msgid "That's that, it seems."
msgstr "Вот и все, похоже."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "How wretchedly jolly."
msgstr "Из рук вон весело."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Have we nothing better to do with our time?"
msgstr "Могли ли мы заняться чем-то подобным в наше время?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "That's that, it seems."
msgstr "Вот и все, похоже."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "How repulsively festive."
msgstr "Какая неприятная праздничность."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.ATTACKER"
msgid "The strongman %s seems a little unhinged."
msgstr "Силач %s слегка не в себе."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Did you intend to burn that, %s?"
msgstr "Ты хотел поджечь это, %s?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GENERIC"
msgid "Good day to you, Mr. %s."
msgstr "Доброго тебе дня, мистер %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.GHOST"
msgid "Let's find a heart, %s. I'll prepare my incantations."
msgstr "Давай найдем сердце, %s. Приготовлю свои чары."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.MURDERER"
msgid "Murderous fiend! Behold my power!"
msgstr "Враг-убийца! Узри мою силу!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s tethers lost spirits to this world."
msgstr "%s не дает заблудшим душам покинуть этот мир."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.ATTACKER"
msgid "%s is going against the grain..."
msgstr "%s идет против шерсти…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVER"
msgid "Ha! What a delightful curse."
msgstr "Ха! Какое чудесное проклятие."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "Yew don't look so wood."
msgstr "Теперь-то ты не такой дубина, как раньше."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Is it wise to be starting fires, given your predilections?"
msgstr "Разумно ли разжигать огонь, учитывая твои наклонности?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GENERIC"
msgid "Greetings, Mr. %s."
msgstr "Приветствую, мистер %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.GHOST"
msgid "That blockhead could use a heart."
msgstr "Этому дубине помогло бы сердце."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.MURDERER"
msgid "Fiend! Time to make like a tree...!"
msgstr "Враг! Пора притвориться деревом…!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WOODIE.REVIVER"
msgid "%s seems very in touch with the spirits of the forest."
msgstr "%s, кажется, очень близок к духам леса."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.DIRT"
msgid "Something stirs."
msgstr "Что-то шевелится."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.PLANT"
msgid "You aren't fooling me, plant."
msgstr "Ты не обманешь меня, растение."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORM.WORM"
msgid "I didn't make that one! Honest!"
msgstr "Этого я не создавал! Честное слово!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.GENERIC"
msgid "It's worse knowing what the other part looks like."
msgstr "Еще хуже — знать, на что похожа другая сторона."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE.OPEN"
msgid "I assure you that it smells worse than it looks."
msgstr "Уверяю тебя, что на запах она еще хуже, чем выглядит."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMHOLE_LIMITED"
msgid "It looks ill."
msgstr "Выглядит вяло."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT"
msgid "What a neat trick."
msgstr "Какая изящная вещица."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_LESSER"
msgid "This one isn't very good."
msgstr "Этот не очень хороший."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WORMLIGHT_PLANT"
msgid "You aren't fooling me, plant."
msgstr "Ты не обманешь меня, растение."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.ATTACKER"
msgid "If you're going to attack, at least finish the job!"
msgstr "Если собираешься нападать, хотя бы закончи начатое!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.FIRESTARTER"
msgid "Mx. %s is finally making good on their promise of mayhem."
msgstr "Мкс. %s наконец-то успешно устраивает хаос, как и задумывалось."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GENERIC"
msgid "Greetings, Mx. %s."
msgstr "Приветствую Мкс. %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.GHOST"
msgid "A shame about your death, %s. You were the only one I half-liked."
msgstr "Как печально, что ты погиб, %s. Ты был единственным, кто мне хотя бы наполовину нравился."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.MURDERER"
msgid "Murderous fiend! This will be your destruction!"
msgstr "Враг-убийца! Я тебя уничтожу!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78.REVIVER"
msgid "%s never did respect human mortality."
msgstr "%s никогда не уважал человеческую смертность."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWAMULET"
msgid "This will make me stand out."
msgstr "Он поможет мне выделиться."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWGEM"
msgid "I can sense magic in it."
msgstr "Я чувствую в нем магию."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWMOONEYE"
msgid "A conveniently color-coded place marker."
msgstr "Удобный окрашенный указатель."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YELLOWSTAFF"
msgid "With a bigger gem it would be so much more powerful."
msgstr "А с камнем побольше посох станет гораздо мощнее."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_GENERIC"
msgid "You tell me."
msgstr "Расскажи-ка мне."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_SMOLDERING"
msgid "Won't be long before it lights on fire."
msgstr "Это все быстро прогорит."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE_TOODARK"
msgid "I can't see in the dark!"
msgstr "В темноте я ничего не вижу!"

#. STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "That tasted about as good as you'd expect."
msgstr "На вкус было так же хорошо, как и ожидалось."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_LOSE"
msgid "This may be the end."
msgstr "Возможно, это конец."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Curses! Too slow."
msgstr "Проклятье! Слишком медленно."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "This combination of food was ill-advised."
msgstr "Такое сочетание еды не рекомендуется."

#. STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.QUAGMIRE_ANNOUNCE_WIN"
msgid "The Gateway is ready!"
msgstr "Портал готов!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Aww. We want in there."
msgstr "О... Мы хотим сюда."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "We don't feel so good right now. Maybe later?"
msgstr "Мы сейчас себя не очень хорошо чувствуем. Может, попозже?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.HASPET"
msgid "I like the pet we've got."
msgstr "Мне нравится этот питомец."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.BUILD.MOUNTED"
msgid "All our arms can't quite reach from up here."
msgstr "Мы не можем ничего достать отсюда нашими ручками."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Woah! Hot fashions!"
msgstr "Ого! Горячая мода!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "Not right now, we're comfy."
msgstr "Не сейчас, нам и так удобно."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.CHANGEIN.INUSE"
msgid "We'll give them some privacy while they change."
msgstr "Мы дадим им немного личного времени на переодевание."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.GENERIC"
msgid "I don't want to. Mom always said the kitchen was dangerous!"
msgstr "Мне не хочется. Мама всегда говорила, что на кухне находиться опасно!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.INUSE"
msgid "Ooo, make something tasty!"
msgstr "Ооо, приготовь что-нибудь вкусное!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.COOK.TOOFAR"
msgid "Let's scurry closer!"
msgstr "Давай подбежим поближе!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.DRAW.NOIMAGE"
msgid "But what should we draw?!"
msgstr "Но что же нам рисовать?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "Wendy would've been so happy if it worked."
msgstr "Венди была бы так рада, если бы это сработало."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.BUSY"
msgid "We can try again when it's finished."
msgstr "Мы попробуем еще раз, когда он освободится."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "It's not waking up."
msgstr "Она не проснется."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DEAD"
msgid "Um. We should probably keep it."
msgstr "Эм. Думаю, нам стоит оставить это себе."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We don't need two!"
msgstr "Нам две штуки не надо!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.FOODFULL"
msgid "It's still working on the first one."
msgstr "Он еще занят предыдущей порцией."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GENERIC"
msgid "Nope, don't think so!"
msgstr "Не-а, я так не думаю!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "We don't think we even want them to come back."
msgstr "Не думаем, что нам бы хотелось, чтобы они возвращались."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "It needs a special kind of log!"
msgstr "Тут надо особенное полено!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "It needs a mushroom!"
msgstr "Тут нужен гриб!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTDISH"
msgid "I don't think we should offer that."
msgstr "Не думаю, что это стоит предлагать."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTGEM"
msgid "It doesn't fit right!"
msgstr "Он вообще сюда не подходит!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "Eight legs isn't nearly enough to sculpt with THAT."
msgstr "Даже восемь ножек недостаточно, чтобы слепить ТАКОЕ."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "I think that'd make it angry."
msgstr "Думаю, это его разозлило."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLEEPING"
msgid "Aww... It's sleepy-snoozy right now!"
msgstr "Оу… Он же сейчас спит!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Mom said to always finish my plate before seconds."
msgstr "Мне мама говорила, что перед вторым блюдом я должен скушать первое."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGGEM"
msgid "We'd rather keep this one for ourselves."
msgstr "Лучше бы нам придержать его пока при себе."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "We put the bones together wrong."
msgstr "Мы складываем косточки неправильно."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "We have something for you!"
msgstr "У нас для тебя кое-что есть!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "Um. We should probably keep it."
msgstr "Эм. Думаю, нам стоит оставить это себе."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "Hey! Make room!"
msgstr "Эй! Нужно свободное место!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Aww... They're getting their snoozies right now!"
msgstr "Оу… Они сейчас дрыхнут!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "We have something for you!"
msgstr "У нас для тебя кое-что есть!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "Um. We should probably keep it."
msgstr "Эм. Думаю, нам стоит оставить это себе."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "Hey! Make room!"
msgstr "Эй! Нужно свободное место!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Aww... They're getting their snoozies right now!"
msgstr "Оу… Они сейчас дрыхнут!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.INUSE"
msgid "We didn't climb into the saddle in time!"
msgstr "Я не можем забраться на это седло вовремя!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "It's too angry!"
msgstr "Он такой злой!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.INUSE"
msgid "Oops. Someone else is using that."
msgstr "Ой. Это уже кто-то использует."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "We don't want to use that."
msgstr "Мы не хотим это использовать."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "This two piece puzzle sure is hard!"
msgstr "Эта мозаика из двух деталек какая-то сложная!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Hmmm... I think we need a different dish for this."
msgstr "Хм-м-м… Кажется, для этого нам нужно другое блюдо."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "We already put this on a dish."
msgstr "Мы уже положили это на блюдо."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "That's off-limits."
msgstr "Попытки закончились."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.RUMMAGE.INUSE"
msgid "It's okay, we can wait for you to finish!"
msgstr "Все хорошо, мы подождем, пока ты закончишь!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "It's too angry!"
msgstr "Он такой злой!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "It's hairy like us, but I don't think it likes shaving."
msgstr "Он такой же волосатый, как и мы, но не думаю, что ему нравится бриться."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.GENERIC"
msgid "It's not shaving time!"
msgstr "Не время бриться!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.SHAVE.NOBITS"
msgid "Clean as a whistle."
msgstr "Лысый, как коленка."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.GENERIC"
msgid "All full!"
msgstr "Тут места нет!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.INUSE"
msgid "Are you finding everything okay in there?"
msgstr "Как здесь что-нибудь найти?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That's against the rules."
msgstr "Это против правил."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.CANTLEARN"
msgid "Ms. Wickerbottom will have to explain this one."
msgstr "Мисс Уикерботтом придется нам это объяснить."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.KNOWN"
msgid "I'm pretty sure one of us knows that one."
msgstr "Уверен, никто из нас этого не знал."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "Is it upside down? Nope. It's just wrong."
msgstr "Тут что ли все наоборот? Нет. Просто все неправильно."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "It's too dangerous!"
msgstr "Оно все еще опасное!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "Aw...It's the wrong one."
msgstr "А… Это не то, что нужно."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That doesn't go there!"
msgstr "Это сюда не подходит!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "But what should we wrap up?"
msgstr "Но что же нам заворачивать?"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.GENERIC"
msgid "We can't write on that now."
msgstr "Мы не можем здесь ничего писать."

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL.WRITE.INUSE"
msgid "We'll get our crayons ready while they finish up!"
msgstr "Мы достанем наши карандаши, когда они закончат!"

#. STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ACTIONFAIL_GENERIC"
msgid "Mom told me never to do that."
msgstr "Мама мне говорила никогда так не делать."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT"
msgid "We're so capable!"
msgstr "А мы можем!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "We're a super hero!"
msgstr "Мы супергерои!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ADVENTUREFAIL"
msgid "Play time is over."
msgstr "Время игр окончилось."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "The ground's giving way!"
msgstr "Земля дает нам дорогу!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "It's rumble-y!"
msgstr "Как громыхает!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "What's that?"
msgstr "Что это?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "For you!"
msgstr "Это тебе!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Maybe it'll be happier now."
msgstr "Надеюсь, он станет счастливее."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "I hope you like our tribute!"
msgstr "Надеюсь, тебе понравится наша дань!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "That gateway did something weird."
msgstr "Эти ворота какие-то странные."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Something's happening."
msgstr "Что-то происходит."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Let's get out of here."
msgstr "Давай отсюда выбираться."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BECOMEGHOST"
msgid "oOooOooO!!"
msgstr "o-O-o-о-O-o-o-o!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BEES"
msgid "Flying ouchies!"
msgstr "Лечучие кусаки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BOOMERANG"
msgid "It hurts us when we don't catch it."
msgstr "Когда мы его не ловим, он больно бьется."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_BURNT"
msgid "Jeepers, that was hot!"
msgstr "Мамочки, было горячо!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CANFIX"
msgid "\nWe can repair it."
msgstr "\nМы сможем это починить."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CAVEIN"
msgid "I think the sky is falling!"
msgstr "Кажется, на нас небо падает!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE"
msgid "Is somebody there?!"
msgstr "Там кто-нибудь есть?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CHARLIE_ATTACK"
msgid "Aah! Monsters in the dark!"
msgstr "Ааа! Монстры в темноте!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COLD"
msgid "Brrr... spider hair isn't very warm."
msgstr "Бр-р-р… паучья шкура не такая уж и теплая."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_COMPASS_OUT"
msgid "Uh oh, I broke it."
msgstr "Ой-ой, я сломал."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_CRAFTING_FAIL"
msgid "We're missing something."
msgstr "Нам чего-то здесь не хватает."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DAMP"
msgid "Splishy splashy."
msgstr "Шлеп-шлеп."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DEERCLOPS"
msgid "That sounded like a big meanie."
msgstr "Судя по звукам, это какая-то здоровенная злюка!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Doesn't that feel better!"
msgstr "Разве так не лучше!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_DUSK"
msgid "Almost time for bed."
msgstr "Уже почти время идти спать."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.GENERIC"
msgid "Yummy in our tummy!"
msgstr "Нашему животику вкусно!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.INVALID"
msgid "That doesn't look like food to us."
msgstr "Не похоже на еду, которую мы можем съесть."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.PAINFUL"
msgid "Our tummy hurts."
msgstr "Нашему животику больно."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.SPOILED"
msgid "Past its date."
msgstr "Срок истек."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.STALE"
msgid "Stale like mum's leftovers."
msgstr "Черствые, как мамины объедки."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EAT.YUCKY"
msgid "We can't, we won't, we refuse to eat that."
msgstr "Мы не можем и не будем, мы отказываемся это есть."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.1"
msgid "Ughh!"
msgstr "Фу-у-х!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.2"
msgid "So heavy...!"
msgstr "Так тяжело!.."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.3"
msgid "Left foot... Right foot..."
msgstr "Левая ножка… Правая ножка…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.4"
msgid "We... can do it!"
msgstr "У нас… получится!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.5"
msgid "Are... we there yet..."
msgstr "Мы… не закончили еще…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.6"
msgid "Chugga chugga chugga chugga..."
msgstr "Чух-чух-чух-чух…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.7"
msgid "Not enough... legs... to lift..."
msgstr "Не хватает… ножек… не поднять…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.8"
msgid "Hhhhfn!"
msgstr "Хм-м-ф-ф-ф!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENCUMBERED.9"
msgid "Oof...!"
msgstr "У-уф!.."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_DARK"
msgid "We can't see! I want my nightlight."
msgstr "Мы не видим! Я хочу свой ночник."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT"
msgid "Phew, light!"
msgstr "Фух, свет!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT"
msgid "Aaw, the twirly is gone."
msgstr "Оу, крутилка кончилась."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM"
msgid "We made it!"
msgstr "Мы справились!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN"
msgid "We're becoming... even more monstrous!"
msgstr "Мы становимся… еще более чудовищными!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH"
msgid "I'm learning so much!"
msgstr "Я многому учусь!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT"
msgid "Hot as heck!"
msgstr "Ох, какой острый, не порезаться бы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS"
msgid "Doggies are coming!"
msgstr "Сюда бегут собачки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY"
msgid "It's time for a snack!"
msgstr "Время перекусить!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Fresh tracks!"
msgstr "Свежие следы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Animal went bye-bye."
msgstr "Животное помахало нам лапкой."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "It's too muddy to track."
msgstr "Слишком грязно, чтобы идти по следу."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Not good enough for you, plant?"
msgstr "Недостаточно для тебя хорошо, растение?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL"
msgid "Our pockets are full!"
msgstr "Наши карманы полны!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Uh-oh, its got friends coming!"
msgstr "Ой-ой, его друзья сейчас прибегут!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE"
msgid "Ah! I'm sorry we killed your deer!!"
msgstr "Ай! Прости, что мы убили твоего оленя!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its belly looks hungry!"
msgstr "Похоже, его животик голоден!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT"
msgid "Ow, our head!"
msgstr "Ой, наша голова!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "We're invincible!"
msgstr "Мы неуязвимы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH"
msgid "That might've taught a toddler something."
msgstr "Это может научить мелкого чему-нибудь."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Сосите кровь у кого-нибудь другого!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Наш волосатый друг ранен!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERAFK"
msgid "Can't! There's scary-biteys about!"
msgstr "Не могу! Там снаружи страшные кусаки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "Мы откроем его позже, как бы празднуя наше спасение!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "Мы не можем дремать, пока монстры поблизости!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "Мы не можем спать, пока монстры поблизости!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Мне днем не спится."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "Мы еще не готовы идти в кровать."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "Мы не можем спать с урчащим животиком."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "Наш животик урчит, и мы не можем спать!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "Обещаю, я еще покатаюсь на тебе после того, как открою подарок!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "Мы не можем просто вздремнуть, тут ночь на дворе!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "Никаких дремов до рассвета!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Мама всегда говорила \"Не спи в горящем здании.\""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "Я не могу! Тут все горит!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Легкотня."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "Плохая птичка!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "Деревья на нас кричат!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "Буэ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "Не думаю, что это урчал наш животик."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "Мы не можем это ударить."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "Все равно, что вернуться обратно в школу."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "Уже лучше!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "Так-то!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "Держись, мы поможем!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "Все возвращается!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "Но ведь там были подарки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "Мы ему нравимся!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "Дерево, защити нас!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "Эй! Придира!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "Мы насквозь промокли!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "Ай!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ох, он нас так манит."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "Ну-у, лягушка убежала!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "Она ищет, куда бы спрятаться."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "Эй! Мы же ей пользуемся!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "Уа-а-а, свет погас!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "Мы тут!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Ой!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "Ауч! Требуется больше времени."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET"
msgid "We're unpleasantly moist."
msgstr "Нам мокро и неприятно."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER"
msgid "Wet as a bathtub we can't crawl out of."
msgstr "Тут мокро, как в ванной, мы не можем выбраться."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE"
msgid "That was a scary hole!"
msgstr "Какая страшная дыра!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS"
msgid "Ohhh nooo. We're not friends with worms!"
msgstr "Оу-у-у-у-у, нееет. Мы не дружим с червяками!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER"
msgid "Hopefully we're venomous!"
msgstr "Надеюсь, мы ядовитые."

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC"
msgid "En garde!"
msgstr "Защищайся!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PIG"
msgid "We hate it! Horrible pig!"
msgstr "Мы это ненавидим! Жуткая свинья!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.PREY"
msgid "We will put you in our web!"
msgstr "Ты попадешь в наши сети!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER"
msgid "Hey, wanna play?"
msgstr "Эй, хочешь поиграть?"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.SPIDER_WARRIOR"
msgid "Why can't we just get along?!"
msgstr "Почему бы нам не подружиться?"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.GENERIC"
msgid "Well, we would have won!"
msgstr "Ну, мы бы победили!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PIG"
msgid "Another day, pig."
msgstr "В другой раз, свинья."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.PREY"
msgid "Speedy thing!"
msgstr "Быстрая штука!"

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER"
msgid "We didn't actually want to hurt you."
msgstr "Мы на самом деле нечаянно."

#. STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Simmer down, friend."
msgstr "Не кипятись, друг."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL"
msgid "That's no party poltergeist!"
msgstr "Это не дух вечеринки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Pretty petals!"
msgstr "Красивые лепестки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Scary blossoms!"
msgstr "Страшное цветение!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Put it down! Put it down!"
msgstr "Верни на место! Верни на место!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I think it's listening to us!"
msgstr "Мне кажется, он нас слушает!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's getting creepy!"
msgstr "Становится жутко!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It gives us itches and skritches up our spine!"
msgstr "От него у нас все чешется, особенно спина!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It gives me a goal in life."
msgstr "Это дает мне цель в жизни."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN"
msgid "Tree or food, there's something inside."
msgstr "Дерево или еда, там что-то есть внутри."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED"
msgid "Roasted on an open fire."
msgstr "Пожарено на открытом огне."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING"
msgid "May you have a long and free life."
msgstr "Живи долгой и свободной жизнью."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Something wicked this way comes."
msgstr "Тут происходит что-то нечистое."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET"
msgid "It's a fine necklace, I suppose."
msgstr "Видимо, это зящное украшение на шею."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR"
msgid "Old and full of mysteries."
