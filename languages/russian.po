msgstr "Эх! Как же медленно растет!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PLANT_NORMAL.READY"
