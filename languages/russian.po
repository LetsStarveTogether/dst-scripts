msgstr "Мы определенно любим блестяшки."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.GOOSE_FEATHER"
