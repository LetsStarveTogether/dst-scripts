msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GHOST"
msgid "Poor %s! He died of loneliness!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.MURDERER"
