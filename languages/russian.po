msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
