msgstr "Ты жуткий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
