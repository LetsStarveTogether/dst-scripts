msgstr "Горит, горит, горит!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNT"
msgid "We can't hide in there any more."
msgstr "Больше мы не можем тут прятаться."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.GENERIC"
msgid "We like to pop out and scare our friends sometimes. Haha!"
msgstr "Мы любим иногда выскакивать и пугать наших друзей. Хаха!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARG"
msgid "I don't think that puppy is very happy."
msgstr "Кажется, это не очень веселый щеночек."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.BURNT"
msgid "The fire destroyed it."
msgstr "Огонь его уничтожил."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Let's put the torch in!"
msgstr "Давайте-ка вставим факел."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.GENERIC"
msgid "It wants to give us presents!"
msgstr "Похоже, нам хотят раздать подарки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.ATTACKER"
msgid "%s, don't you think you should say sorry?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.FIRESTARTER"
msgid "We don't think you were supposed to start that fire."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GENERIC"
msgid "Hey %s! Do you have any snacks?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GHOST"
msgid "Oh no, %s is hurt!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.MURDERER"
msgid "We thought you were nice!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.REVIVER"
msgid "Thanks a bunch, %s!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WASPHIVE"
