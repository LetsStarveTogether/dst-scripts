msgstr "Надеюсь, где-нибудь там внизу есть лава."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS"
