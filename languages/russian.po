msgstr "Ничего не вижу!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENTER_LIGHT"
msgid "Whew! I can see!"
msgstr "Фух! Я снова могу видеть!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_FAN_OUT
