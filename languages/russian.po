msgstr "Устроить бы кому-нибудь жаркий допрос!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_GRILL_SMALL"
