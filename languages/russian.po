msgstr "Хо-хо, покатай меня!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SADDLE_RACE"
msgid "Let's fly! Hyuyu!"
msgstr "Полетели! Хо-хо!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SADDLE_WAR"
