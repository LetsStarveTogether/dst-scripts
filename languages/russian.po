msgstr "Мне кажется, или эти деревья более тенистые?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING"
