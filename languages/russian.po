msgstr "Могу поспорить, это нам пригодится."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_KEY_PARK"
