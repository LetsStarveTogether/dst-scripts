msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
