msgstr "Зачем надевать большую ледышку на голову?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ICEHOUND"
