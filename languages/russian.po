msgstr "Могучее растение еще не умерло."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SUCCULENT_PLANT"
msgid "Is tough plant."
msgstr "Могучее растение."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SUCCULENT_POTTED"
