msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
