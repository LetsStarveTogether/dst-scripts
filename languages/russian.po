msgstr "Какая-то поверхность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_SINKHOLE"
msgid "Some ground."
msgstr "Какая-то поверхность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_UNDERROCK"
msgid "Some ground."
msgstr "Какая-то поверхность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_WOODFLOOR"
msgid "Some ground."
msgstr "Какая-то поверхность."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURKEYDINNER"
msgid "Who's gobbling now?"
msgstr "Чего не кулдыкаешь?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURTILLUS"
msgid "You cannot shield yourself from this world."
msgstr "Тебе не отгородиться от этого мира."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.BURNING"
msgid "It's burning brightly."
msgstr "Как ярко горит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Used up and done for."
msgstr "Использовано и брошено."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Everything dies."
msgstr "Все умирает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It's not long for this world..."
msgstr "Не жить ему на белом свете…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "How all must toil for the necessities of life."
msgstr "Все должно прилагать большие усилия, чтобы жить."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_NUT"
msgid "It's sad it's not in the earth."
msgstr "Оно печалится, что оно не в земле."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It looks so innocent."
msgstr "Он так невинно выглядит."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGGY_OLD"
msgid "Thin. Sad. Shriveled."
msgstr "Тощее. Печальное. Высохшее."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TWIGS"
msgid "Plucked from the ground before their prime."
msgstr "Вырваны прежде, чем смогли вдохнуть эту жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.UMBRELLA"
msgid "The clouds weep."
msgstr "Облака рыдают."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.UNAGI"
msgid "It looks more appetizing this way."
msgstr "Так выглядит даже более аппетитно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.UNIMPLEMENTED"
msgid "It's not done, like life."
msgstr "Несовершенен, прямо как вся жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAFFLES"
msgid "They're definitely waffles."
msgstr "Да, это определенно вафли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY.BURNT"
msgid "Defenses down."
msgstr "И нет защиты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY.GENERIC"
msgid "That is a mere suggestion of defense."
msgstr "Простое решение защиты."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_HAY_ITEM"
msgid "Their defensive value is questionable."
msgstr "Их защитные свойства сомнительны."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_MOONROCK"
msgid "The moon... she whispers promises of protection to me."
msgstr "Луна… она шепчет мне обещания защитить меня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "This gift from above should not go to waste."
msgstr "Этот дар свыше не должен быть потрачен впустую."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_RUINS"
msgid "These didn't protect the ancients, now did they!"
msgstr "Они ведь не защитили древний мир!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_RUINS_ITEM"
msgid "Are the very stones haunted?"
msgstr "Все ли камни обладают душой?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_STONE"
msgid "What will protect me from what's inside?"
msgstr "А что защитит меня от того, что внутри?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_STONE_ITEM"
msgid "These won't protect from the demons within."
msgstr "От внутренних демонов не спасет."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD.BURNT"
msgid "The inevitable is coming."
msgstr "Неизбежное близко."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD.GENERIC"
msgid "It will only delay the inevitable."
msgstr "Это просто отсрочит неизбежное."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALL_WOOD_ITEM"
msgid "Bundled logs."
msgstr "Охапка дров."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS"
msgid "An old man of the sea."
msgstr "Морской старик."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUSHAT"
msgid "What feverish thoughts transpired beneath this?"
msgstr "Какие беспокойные мысли могут посетить тебя через нее?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "If they are not in there, where are they?"
msgstr "Если их тут нет, то где же они тогда?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "This home is not a happy one, I fear."
msgstr "Боюсь, в этом доме нет места для радости."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WALRUS_TUSK"
msgid "I gnash at thee."
msgstr "Я тоже умею зубами щелкать."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.BURNING"
msgid "Soon it will be nothing but ashes."
msgstr "Вскоре от него не останется ничего, кроме пепла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.BURNT"
msgid "Now it doesn't remind me of anything."
msgstr "Теперь не напоминает."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARDROBE.GENERIC"
msgid "It reminds me of a story I used to read with Abigail."
msgstr "Напоминает мне о сказке, которую я когда-то читала Абигейл."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARG"
msgid "A true bastion of evil."
msgstr "Истинный оплот зла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.BURNT"
msgid "Dust to dust."
msgstr "Пыль к пыли."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.EMPTY"
msgid "We must light a fire to honor the hound."
msgstr "Мы должны зажечь огонь в честь этой гончей."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WARGSHRINE.GENERIC"
msgid "The hounds are baying."
msgstr "Гончие лают."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WASPHIVE"
msgid "They hide in their fortress of hate."
msgstr "Они прячутся в своей крепости ненависти."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERBALLOON"
msgid "At any moment it could pop and spill its guts."
msgstr "В любой момент он может лопнуть, и все внутренности выльются."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON"
msgid "It's mostly water. What's the big deal?"
msgstr "Почти вода. Что в этом такого?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELONHAT"
msgid "It makes the wearer's head sticky. Yuck."
msgstr "От него голова становится липкой. Фи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELONICLE"
msgid "The melon is in stasis."
msgstr "Арбуз в стазисе."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON_COOKED"
msgid "Now it's warm water."
msgstr "Теперь это теплая вода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATERMELON_SEEDS"
msgid "Perfectly shaped for spitting."
msgstr "Идеальной формы для плевания."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s... she's bloodthirsty."
msgstr "%s… она кровожадная."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "Do the Norse have a god of fire, %s?"
msgstr "У скандинавов есть бог огня, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.GHOST"
msgid "Come back, %s... Take my heart..."
msgstr "Вернись, %s… Возьми мое сердце…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.MURDERER"
msgid "It'll all be over soon, %s."
msgstr "Скоро все закончится, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHR.REVIVER"
msgid "It seems your heart is strong too, %s..."
msgstr "Кажется, твое сердце тоже сильное, %s…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WATHGRITHRHAT"
msgid "I've never seen her take it off before..."
msgstr "Никогда не видела, чтобы она снимала ее…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXPAPER"
msgid "It feels so... nostalgic."
msgstr "Это вызывает чувство… ностальгии."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.ATTACKER"
msgid "I don't think I trust %s yet."
msgstr "Не думаю, что я уже доверяю %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Are you trying to kindle a bad reputation?"
msgstr "Ты пытаешься заслужить плохую репутацию?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.GENERIC"
msgid "How are you coping, %s?"
msgstr "Как справляешься, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.GHOST"
msgid "Should I revive you, %s? Hmm..."
msgstr "Должна ли я тебя воскрешать, %s? Хмм…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.MURDERER"
msgid "Cursed villain!"
msgstr "Проклятый негодяй!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELL.REVIVER"
msgid "He's gone from Sisyphus to Lazarus."
msgstr "Ну, он дает! От Сизифа — к Лазарю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WAXWELLJOURNAL"
msgid "Do you want me to read you a story, Abigail?"
msgstr "Хочешь, я почитаю тебе, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.ATTACKER"
msgid "%s, are you friend... or foe?"
msgstr "%s, так ты друг… или враг?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.FIRESTARTER"
msgid "%s, let's find a game that doesn't involve fire."
msgstr "%s, давай придумаем игру, в которой можно обойтись без огня."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.GENERIC"
msgid "Hey, %s!"
msgstr "Эй, %s!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.GHOST"
msgid "A heart could bring back my friend, %s..."
msgstr "Сердце может вернуть моего друга, %s…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.MURDERER"
msgid "Don't worry, %s. This won't hurt a bit."
msgstr "Не волнуйся, %s. Будет не больно."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER.REVIVER"
msgid "You could never be a monster, %s."
msgstr "И ты можешь не становиться чудовищем, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBERSKULL"
msgid "He's better this way."
msgstr "Так он выглядит лучше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Webber seems proud of them."
msgstr "Кажется, Веббер гордится ими."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.ATTACKER"
msgid "%s... she's no sister of mine."
msgstr "%s… Не сестра она мне."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.FIRESTARTER"
msgid "Fire probably isn't the method I would choose..."
msgstr "Огонь — явно не совсем подходящий способ…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.GENERIC"
msgid "She looks sad..."
msgstr "Она выглядит печальной…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.GHOST"
msgid "At least a heart could return one sister to this world..."
msgstr "Сердце может вернуть хотя бы одну сестру в этот мир…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.MURDERER"
msgid "Have we not seen enough death, %s?"
msgstr "Разве мы недостаточно смертей повидали, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WENDY.REVIVER"
msgid "I hope Abigail doesn't like you more than me..."
msgstr "Надеюсь, Абигейл не любит тебя больше, чем меня…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.ATTACKER"
msgid "There's something you're not telling us..."
msgstr "Ты чего-то не договариваешь…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.FIRESTARTER"
msgid "There are other ways to express yourself, %s."
msgstr "Есть и другие способы самовыражения, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.GHOST"
msgid "You won't leave us if I get you a heart, right?"
msgstr "Ты ведь не оставишь нас, если я добуду тебе сердце, правда?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.MURDERER"
msgid "%s, this is the end... for you!"
msgstr "%s, это твой… конец!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WES.REVIVER"
msgid "Abigail says she understands you, %s."
msgstr "Абигейл говорит, что понимает тебя, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WETGOOP"
msgid "A miserable mess, just like life."
msgstr "Жалкая грязь. Прямо как жизнь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WETPAPER"
msgid "Yuck."
msgstr "Фи."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WETPOUCH"
msgid "It came from the depths."
msgstr "Вышел из глубин."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WHIP"
msgid "It only provides the illusion of control."
msgstr "Он создает лишь видимость контроля."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "Ms. %s... do you turn your wits against us?"
msgstr "Мисс %s… Вы решили направить свое остроумие против нас?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Ms. %s, wreathed in flames."
msgstr "Мисс %s, окруженная пламенем."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "How do you do, Ms. %s?"
msgstr "Как поживаете, мисс %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "Everyone that leaves takes a piece of my heart..."
msgstr "Все, кто уходит, забирают кусочек моего сердца…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "\"Murder\", she wrote."
msgstr "Она написала \"Убийство\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "Abigail likes you, Ms. %s."
msgstr "Вы нравитесь Абигейл, мисс %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.ATTACKER"
msgid "%s is a madwoman."
msgstr "%s — сумасшедшая."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Let's watch the world burn together, %s."
msgstr "Давай вместе будем наблюдать за тем, как горит этот мир, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.GHOST"
msgid "Say hi to Abigail while I get you a heart, %s."
msgstr "Передавай привет Абигейл, пока я ищу для тебя сердце, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.MURDERER"
msgid "You've made a terrible error, %s."
msgstr "Ты совершила ужасную ошибку, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILLOW.REVIVER"
msgid "Abigail likes you, %s. Do you like her?"
msgstr "Ты нравишься Абигейл, %s. А она тебе нравится?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.ATTACKER"
msgid "%s is unstable."
msgstr "%s непостоянен."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.FIRESTARTER"
msgid "Douse your fires, %s."
msgstr "Потуши свое пламя, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.GHOST"
msgid "That was a bad experiment, %s..."
msgstr "Это был неудачный эксперимент, %s…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.MURDERER"
msgid "You've gone mad, scientist."
msgstr "Ученый, ты спятил."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WILSON.REVIVER"
msgid "Abigail likes you, %s."
msgstr "Ты нравишься Абигейл, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.ATTACKER"
msgid "There is anger in %s's heart."
msgstr "%s носит гнев в своем сердце."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.FIRESTARTER"
msgid "Is fire important in your line of work...?"
msgstr "Так ли необходим тебе огонь?.."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.GHOST"
msgid "You can't escape that way, %s. I've tried."
msgstr "Так ты никуда не убежишь, %s. Я пыталась."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.MURDERER"
msgid "Abigail and I will have fun with you!"
msgstr "Мы с Абигейл поиграемся с тобой!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINONA.REVIVER"
msgid "Hi %s. Abigail says \"thank-you\"."
msgstr "Привет, %s. Абигейл просила тебе передать «спасибо»."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTERHAT"
msgid "It helps stave off the encroaching cold."
msgstr "Помогает уберечься от надвигающегося холода."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTEROMETER.BURNT"
msgid "Does that mean my day to die is here?"
msgstr "Означает ли это, что пришел мой час?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTEROMETER.GENERIC"
msgid "Why do I feel that it is measuring our mortality?"
msgstr "Почему мне кажется, что он измеряет нашу смертность?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD1"
msgid "I'm going to eat you."
msgstr "Я собираюсь съесть тебя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD2"
msgid "Not nearly sweet enough to balance out this bitter world."
msgstr "Его сахара не хватит, чтобы сделать этот горький мир чуть слаще."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD3"
msgid "If you eat it right... the end gets sharp..."
msgstr "Если ты ешь правильно… конец леденца станет острым…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD4"
msgid "It is filled with chunks of evil."
msgstr "Нафарширован кусочками зла."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD5"
msgid "It tastes okay, but I've grown tired of logs..."
msgstr "Это вкусно, но я уже так устала от деревяшек…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD6"
msgid "I'm going to lick all the icing off..."
msgstr "Я собираюсь съесть всю глазурь…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD7"
msgid "I don't want Winter's Feast to end..."
msgstr "Мне не хочется, чтобы Праздник Зимы заканчивался…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD8"
msgid "I missed cocoa."
msgstr "Я скучала по какао."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_FOOD9"
msgid "So aggressively delicious. You can't help but feel better."
msgstr "Так агрессивно вкусно. Ты не можешь не чувствовать себя лучше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENT"
msgid "Do you like this one, Abigail?"
msgstr "А вот это тебе нравится, Абигейл?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "This is one of my favorites."
msgstr "Это одно из моих любимых."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Bright lights... Cold nights..."
msgstr "Яркие огоньки… Холодные ночи…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.BURNING"
msgid "Oh."
msgstr "Ой."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.BURNT"
msgid "Death comes for all of us..."
msgstr "Смерть ждет каждого из нас…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Oh, joy."
msgstr "Ой, прелесть."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREE.YOUNG"
msgid "It's not ready yet."
msgstr "Оно еще не готово."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Death comes for all of us..."
msgstr "Смерть ждет каждого из нас…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "We can plant a Winter's Feast tree."
msgstr "Мы можем посадить Праздничную Ель."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.ATTACKER"
msgid "I don't trust %s. Fear makes people dangerous."
msgstr "Я не доверяю %s. Страх делает людей опасными."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Fire won't protect you, %s."
msgstr "Пламя тебя не защитит, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.GENERIC"
msgid "Hi %s. Why are you shaking?"
msgstr "Привет %s. Почему ты трясешься?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.GHOST"
msgid "%s... Everyone leaves..."
msgstr "%s… Все уходят…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.MURDERER"
msgid "Strength is meaningless if you can't catch me..."
msgstr "Твоя сила бесполезна, если ты не можешь меня поймать…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOLFGANG.REVIVER"
msgid "Don't be scared, %s. Abigail just wants to be friends."
msgstr "Не пугайся, %s. Абигейл просто хочет подружиться."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.ATTACKER"
msgid "%s is plotting something dastardly with that axe."
msgstr "%s замышляет какую-то подлость с этим топором."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.BEAVER"
msgid "He pinky-promised I'd get to ride on his shoulders. Such lies."
msgstr "Он поклялся на мизинчиках, что покатает меня на плечах в следующий раз. Какая ложь."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "The curse haunts you even in death, %s?"
msgstr "Проклятие преследует тебя даже после смерти, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Fire setting does not seem in your best interest..."
msgstr "Разжечь огонь — не в твоих интересах…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.GHOST"
msgid "We'll get a heart, but are you sure you want to come back, %s?"
msgstr "Мы достанем тебе сердце, но ты уверен, что хочешь вернуться, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.MURDERER"
msgid "I'll send you someplace much nicer than this, %s."
msgstr "Я отправлю тебя в лучшее место, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WOODIE.REVIVER"
msgid "Abigail likes you, %s. But she likes Lucy more."
msgstr "Ты нравишься Абигейл, %s. Но Люси ей нравится больше."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.DIRT"
msgid "Is something there?"
msgstr "Там что-то есть внутри?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.PLANT"
msgid "It seems out of place."
msgstr "Будто бы не на своем месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORM.WORM"
msgid "It comes from the depths."
msgstr "Оно выходит из глубин."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE.GENERIC"
msgid "Life doesn't always make sense."
msgstr "Жизнь не всегда обладает смыслом."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE.OPEN"
msgid "No matter what it consumes, it is never satisfied."
msgstr "Неважно, что оно потребляет, оно никогда не насытится."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMHOLE_LIMITED"
msgid "It will soon give up."
msgstr "Скоро он сдастся."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT"
msgid "There's a slight humming coming from it."
msgstr "От него исходит странный гул."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT_LESSER"
msgid "Better the worm's light than its tongue."
msgstr "Лучше уж червивый свет, чем хвост."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WORMLIGHT_PLANT"
msgid "It seems out of place."
msgstr "Будто бы не на своем месте."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.ATTACKER"
msgid "Do you have a conscience, %s?"
msgstr "У тебя совесть есть, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.FIRESTARTER"
msgid "I'd begun to think you were all talk, %s."
msgstr "Мне уж показалось, что ты только и умеешь, что болтать, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.GENERIC"
msgid "How do you do, %s?"
msgstr "Как поживаешь, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.GHOST"
msgid "Say \"Pretty Please\" and I might get you a heart, %s."
msgstr "Скажи \"Ну пожалуйста\", и я, быть может, достану тебе сердце, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.MURDERER"
msgid "None of us are above death, %s!"
msgstr "Никто из нас не выше смерти, %s!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78.REVIVER"
msgid "Abigail likes you, %s."
msgstr "Ты нравишься Абигейл, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWAMULET"
msgid "A brief light in a dark life."
msgstr "Проблеск света в моей темной жизни."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWGEM"
msgid "It reminds me of my mother."
msgstr "Он напоминает мне о моей матери."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWMOONEYE"
msgid "What color were mother's eyes?"
msgstr "Какого цвета были глаза мамы?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWSTAFF"
msgid "The stick is as twisted as my soul."
msgstr "Эта палка так же скрючена, как моя душа."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_GENERIC"
msgid "Sigh... I don't know."
msgstr "Эх… Не знаю."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_SMOLDERING"
msgid "It's about to be swallowed by flames."
msgstr "Его сейчас поглотит пламя."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_TOODARK"
msgid "The darkness! It is too dark!"
msgstr "Тьма! Темень-тьмушечка!"

#. STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WENDY.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "I spared it the torment of living."
msgstr "Я спасла его от участи существования."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_LOSE"
msgid "What a horrible place to have a curse."
msgstr "Ужасное место, чтобы быть под проклятием."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "It's ruined."
msgstr "Все испорчено."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Those foods weren't meant to be together."
msgstr "Этим продуктам не стоит быть вместе."

#. STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WENDY.QUAGMIRE_ANNOUNCE_WIN"
msgid "Let us depart this terrible place."
msgstr "Пора нам покинуть это ужасное место."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "I appears to be locked."
msgstr "Похоже, закрыто."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I'm feeling too ill for that."
msgstr "Я чувствую себя не очень хорошо для этого."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.HASPET"
msgid "One domestic creature is enough for me."
msgstr "Одного домашнего питомца мне достаточно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.BUILD.MOUNTED"
msgid "In this elevated position, I can't reach the ground."
msgstr "С такой возвышенной позиции я не могу дотянуться до земли."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.BURNING"
msgid "No more changes for me. It's gone up in flames."
msgstr "Хватит с меня изменений. Все сгинуло в пламени."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "I think I look pretty smart already."
msgstr "Думаю, что я и без того достаточно умна."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.CHANGEIN.INUSE"
msgid "If I could use that after you, dear."
msgstr "Я смогу его использовать после тебя, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.GENERIC"
msgid "Perhaps later. Not all old ladies enjoy cooking, you know."
msgstr "Возможно, позже. Не все почтенные дамы в восторге от готовки, знаете ли."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.INUSE"
msgid "Mmm, smells lovely, dear."
msgstr "Ммм, пахнет мило, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.COOK.TOOFAR"
msgid "It is not within my reach."
msgstr "Это вне моей досягаемости."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.DRAW.NOIMAGE"
msgid "An example of what I should diagram would be helpful."
msgstr "Мне бы пригодилась схема того, что мне нужно изобразить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "Her spirit is already bound to something in this world."
msgstr "Ее дух уже пересек границы этого мира."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try again when it's done."
msgstr "Я попробую потом, когда все будет готово."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Conditions are not right."
msgstr "Условия неподходящие."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DEAD"
msgid "That would be a waste."
msgstr "Это будет расточительно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We've already taken note of this recipe."
msgstr "У нас уже есть этот рецепт."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.FOODFULL"
msgid "I'll be around when you're ready for seconds, dear."
msgstr "Если захочешь добавки, я тут рядом, дружок."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GENERIC"
msgid "I don't think so, dear."
msgstr "Я так не думаю, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "I'll not be meddling in that business."
msgstr "Я не буду вмешиваться в эти дела."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "It needs a log, imbued with magical properties."
msgstr "Необходимо полено, обладающее магическими свойствами."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "Goodness no, it needs a fresh mushroom."
msgstr "О Боже мой, нет, здесь понадобится свежий гриб."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTDISH"
msgid "That food is simply not suitable."
msgstr "Эта пища попросту не подходит."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTGEM"
msgid "Don't be silly, dear."
msgstr "Не глупи, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "No one ought to sculpt with that, dear."
msgstr "Никто не должен лепить с этим, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "This is not the staff I seek."
msgstr "Это не тот предмет, который я ищу."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLEEPING"
msgid "It appears to be sleeping."
msgstr "Похоже, спит."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Let's finish what's on our plate first, shall we?"
msgstr "Сперва разберемся с тем, что есть, ладно?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGGEM"
msgid "This gemstone's properties are incorrect for my purposes."
msgstr "Свойства этого самоцвета не подходят для моих целей."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "The skeletal anatomy is incorrect."
msgstr "Анатомия скелета не соблюдена."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "I'll try again when they're free."
msgstr "Я попробую снова, когда они освободятся."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "That would be a waste."
msgstr "Это будет расточительно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "They're already heavily burdened."
msgstr "Они уже слишком перегружены."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "They've entered REM sleep. No need to disturb them."
msgstr "Они вошли в фазу быстрого сна. Не нужно их беспокоить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "I'll try again when they're free."
msgstr "Я попробую снова, когда они освободятся."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "That would be a waste."
msgstr "Это будет расточительно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "They're already heavily burdened."
msgstr "Они уже слишком перегружены."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "They've entered REM sleep. No need to disturb them."
msgstr "Они вошли в фазу быстрого сна. Не нужно их беспокоить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.INUSE"
msgid "Patience is required. I can ride this beefalo later."
msgstr "Требуется терпение. Я могу прокатиться на этом бифало позже."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "It would be ill-advised to approach that scuffle."
msgstr "Будет дурным тоном вмешиваться в эту драку."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.INUSE"
msgid "It's already in use."
msgstr "Уже используется."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "That's not my area of expertise."
msgstr "Я в этом не эксперт."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.GENERIC"
msgid "Other matters await."
msgstr "Другие вещи ждут."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.READ.NOBIRDS"
msgid "The birds are not keen on this weather."
msgstr "Птицам такая погода не нравится."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "That is clearly the incorrect piece."
msgstr "Эта часть определенно не подходит."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.MISMATCH"
msgid "That's not the proper dinnerware for this food."
msgstr "Неподобающая сервировка для этой еды."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "It's already on the proper dinnerware."
msgstr "Оно уже на подобающем блюде."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "I've other things on my mind currently."
msgstr "Есть еще много других вещей у меня в уме."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.RUMMAGE.INUSE"
msgid "Be sure to sort by color and weight, dear."
msgstr "Не забудь все отсортировать по цвету и по весу, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "It would be ill-advised to approach that scuffle."
msgstr "Будет дурным тоном вмешиваться в эту драку."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I think he might object to that."
msgstr "Я думаю, он будет против."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.GENERIC"
msgid "I would really rather not."
msgstr "Предпочитаю этого не делать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.SHAVE.NOBITS"
msgid "It's already smooth, dear."
msgstr "Уже гладко, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.GENERIC"
msgid "It's full to the brim, I'm afraid."
msgstr "Боюсь, уже до краев."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.INUSE"
msgid "I do hope you're keeping organized, my dear."
msgstr "Надеюсь, у тебя все разложено максимально рационально, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.STORE.NOTALLOWED"
msgid "Nonsense."
msgstr "Ерунда."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.CANTLEARN"
msgid "A piece of knowledge I cannot grasp... Intriguing!"
msgstr "Это знание я не могу постичь… Интригует!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.KNOWN"
msgid "Please. That knowledge is child's play."
msgstr "Я вас умоляю. Это даже детям известно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "This map is for some other location."
msgstr "Эта карта отображает другую местность."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "The beast must first be defeated."
msgstr "Сперва нужно одолеть зверя."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "I'll have to find the right key."
msgstr "Мне надо найти подходящий ключ."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That may have been the wrong implement."
msgstr "Возможно, это неподходящий предмет."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I have to know what to wrap, dear."
msgstr "Мне нужно знать, что в него заворачивать, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.GENERIC"
msgid "I'd rather write in my own books."
msgstr "Я лучше напишу в своих книгах."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL.WRITE.INUSE"
msgid "When you're done, dear."
msgstr "Только после тебя, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ACTIONFAIL_GENERIC"
msgid "It seems I can't do that."
msgstr "Похоже, я не могу этого сделать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT"
msgid "It's not there yet!"
msgstr "Еще не готово!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "File that under completed!"
msgstr "Все выполнено!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ADVENTUREFAIL"
msgid "We must learn from our failures."
msgstr "Мы должны учиться на своих ошибках."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "The ground will soon give way."
msgstr "Земля скоро разверзнется."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Not the work of tectonic plates."
msgstr "Это не из-за тектонических плит."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "A six on the Richter scale."
msgstr "Шесть баллов по шкале Рихтера."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "For you, great Panthera auropunctata."
msgstr "Это для тебя, великая Panthera auropunctata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "It ought to be more docile now."
msgstr "Теперь он должен присмиреть."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "The great Panthera auropunctata is tamed."
msgstr "Великая Panthera auropunctata приручена."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "I do believe it's time to go."
msgstr "Я считаю, пора уходить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "It's dangerous to be here."
msgstr "Здесь опасно находиться."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Goodness gracious!"
msgstr "Боже милостивый!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BECOMEGHOST"
msgid "oOoooOoO!!"
msgstr "o-O-o-о-O-o-o-o!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BEES"
msgid "Stinging nasties!"
msgstr "Отвратительные жалящие создания!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BOOMERANG"
msgid "I misjudged the timing of its return."
msgstr "Я неверно оценила время возвращения."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_BURNT"
msgid "First degree, at least!"
msgstr "Первая степень, наконец-то!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CANFIX"
msgid "\nI do believe I can repair this."
msgstr "\nЯ уверена, что ремонт в моих силах."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CAVEIN"
msgid "The rocks above will soon give way."
msgstr "Камни наверху вот-вот обвалятся."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE"
msgid "A noise! And a distinctly floral scent?"
msgstr "Шум! И отчетливый цветочный запах?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CHARLIE_ATTACK"
msgid "OUCH! Who dares?!"
msgstr "АЙ! Кто посмел?!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COLD"
msgid "The ambient temperature is low."
msgstr "Температура окружающей среды низка."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_COMPASS_OUT"
msgid "My compass has become demagnetized."
msgstr "Мой компас размагнитился."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_CRAFTING_FAIL"
msgid "I can't make that now."
msgstr "Сейчас это мне не под силу."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DAMP"
msgid "The layer of water begins to build up."
msgstr "Уровень воды начинает подниматься."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DEERCLOPS"
msgid "That sounds quite large!"
msgstr "Звуки огромной особи!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Caught it just in time. The roots were nearly rotten."
msgstr "Поймали как раз вовремя. Корни уже чуть было не начали гнить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_DUSK"
msgid "Night will be here soon."
msgstr "Скоро наступит ночь."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.GENERIC"
msgid "Yum!"
msgstr "Вкуснятина!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.INVALID"
msgid "This cannot be consumed."
msgstr "Это употреблять нельзя."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.PAINFUL"
msgid "I should not have ingested that."
msgstr "Не стоило мне это глотать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.SPOILED"
msgid "That was partially decomposed."
msgstr "Оно частично разложилось."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.STALE"
msgid "That was not at optimal freshness."
msgstr "Не оптимальной свежести."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_EAT.YUCKY"
msgid "Ingesting this would be ill-advised."
msgstr "Будет большой ошибкой глотать это."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.1"
msgid "It's all in the legs."
msgstr "При помощи ног таскать проще."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.2"
msgid "Goodness..."
msgstr "Боже мой…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.3"
msgid "Dear me..."
msgstr "Господи…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.4"
msgid "I've got it, dear."
msgstr "Все в порядке, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.5"
msgid "I'm more spry than I look!"
msgstr "Я намного живее, чем выгляжу на самом деле!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.6"
msgid "You just need to know how to lift!"
msgstr "Просто нужно знать, как это поднять!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.7"
msgid "No sweat off my back! Ho ho!"
msgstr "Моя спина не должна потеть! О нет!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.8"
msgid "How invigorating!"
msgstr "Воодушевляет!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENCUMBERED.9"
msgid "This gets the blood pumping!"
msgstr "Помогает раскачивать кровь по телу!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK"
msgid "I am in the dark."
msgstr "Я в темноте."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_LIGHT"
msgid "It is bright enough to see."
msgstr "Сейчас довольно светло."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FAN_OUT"
msgid "This fragile device has decayed."
msgstr "Это хрупкое устройство разрушилось."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_FREEDOM"
msgid "Freedom! I'll find a good book and tuck in."
msgstr "Свобода! Найду хорошую книгу и уткнусь в нее."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_GHOSTDRAIN"
msgid "My humanity... it's slipping."
msgstr "Моя человечность… она ускользает."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HIGHRESEARCH"
msgid "My my, that was extremely interesting!"
msgstr "Ну и ну, вот это было крайне познавательно!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOT"
msgid "The ambient temperature is high."
msgstr "Температура окружающей среды высока."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HOUNDS"
msgid "Something is approaching."
msgstr "Что-то надвигается."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNGRY"
msgid "Librarian needs food."
msgstr "Библиотекарю нужна пища."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "The appearance of this track indicates recent activity."
msgstr "Появление следов свидетельствует о деятельности."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "The trail is no longer distinguishable."
msgstr "След более не распознаваем."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The trail's been washed away by the precipitation."
msgstr "След смыло этими осадками."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It needs just a touch more fecal assistance, I'd say."
msgstr "Ему бы не помешала небольшая фекальная поддержка, скажем так."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_INV_FULL"
msgid "I can't carry anything more."
msgstr "Я больше ничего не могу нести!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Careful! It has summoned lesser Krampii."
msgstr "Осторожней! Он призвал Крампи-младшего."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_ENRAGE"
msgid "No sense throwing one's life away. Fall back!"
msgstr "Незачем так губить свою жизнь. Отступаем!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Whatever enchantment restrained it has been undone."
msgstr "Неважно, какая магия тут кроется, ее больше нет."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_KNOCKEDOUT"
msgid "Oof, that's one way to get some rest, I suppose."
msgstr "У-уф, я полагаю, это один из верных способов передохнуть."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Thank goodness for this non-conductive clothing!"
msgstr "Спасибо, господи, за непроводящую одежду!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_LOWRESEARCH"
msgid "Not a great resource, but there were useful bits."
msgstr "Не лучший ресурс, но кое-что полезное есть."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOSQUITOS"
msgid "Cursed bloodsuckers!"
msgstr "Проклятые кровопийцы!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "My mount requires attention of the medical variety."
msgstr "Только под наблюдением врача."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERAFK"
msgid "Were I to lose focus now I'd be sure to sustain bodily injury."
msgstr "Кажется, я немного задумалась, потому что не помню, чтобы я получала эти повреждения."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERGIFT"
msgid "Presents are not a top survival priority at this moment."
msgstr "Подарки сейчас имеют второстепенную важность для выживания."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSIESTA"
msgid "I can't lie down when I'm in danger!"
msgstr "Я не могу прилечь, когда я в опасности!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODANGERSLEEP"
msgid "I can barely sleep even when I'm not in danger!"
msgstr "Я едва могу заснуть даже в безопасности!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP"
msgid "I can hardly get to sleep at night, nevermind during the day."
msgstr "Я едва могу спать ночью, не говоря уже о дневном времени суток."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "These caves don't make it any easier to sleep."
msgstr "Эти пещеры не создают условия для сна."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSIESTA"
msgid "My hunger won't make relaxing any easier!"
msgstr "Голод не дает мне расслабиться!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOHUNGERSLEEP"
msgid "I can barely sleep even when I'm not starving!"
msgstr "Я едва могу заснуть, даже когда не голодаю!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I do believe I should dismount first."
msgstr "Я уверена, что для начала мне нужно слезть."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA"
msgid "I can't sleep, no matter where I lie down."
msgstr "Я не могу заснуть, где бы я ни легла."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I couldn't possibly relax in these caves."
msgstr "Я никак не могу расслабиться в этих пещерах."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOSLEEPONFIRE"
msgid "Even if I could sleep, these temperatures are highly unsafe."
msgstr "Даже если я усну, подобные температуры будут крайне небезопасны."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NOWARDROBEONFIRE"
msgid "As you can plainly see, it is ablaze."
msgstr "Как вы сейчас можете видеть, оно в огне."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_NO_TRAP"
msgid "A cinch!"
msgstr "Вот так!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PECKED"
msgid "Settle down, this instant!"
msgstr "Угомонись! Немедленно!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PETRIFED_TREES"
msgid "The chemical reaction has been catalyzed..."
msgstr "Химическая реакция была катализирована…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "This plant is exhibiting concerning signs."
msgstr "Это растение пытается нам что-то сказать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_QUAKE"
msgid "A tremor! At least magnitude seven on the Richter scale."
msgstr "Толчки! Тут магнитуда не менее семи по шкале Рихтера."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REPELLED"
msgid "There's magic at work here."
msgstr "Здесь не обошлось без магии."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RESEARCH"
msgid "No information should go to waste, no matter how trivial."
msgstr "Никакие факты нельзя игнорировать, даже очевидные."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Oof! Back on my feet!"
msgstr "Уф! Я снова на ногах!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Off you go now."
msgstr "Теперь уходи."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on a moment, dear."
msgstr "Погоди-ка минутку, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET"
msgid "Careful, the monsters are back."
msgstr "Осторожно, чудовища возвращаются."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO"
msgid "Shoot. I thought I had it."
msgstr "Черт. Я думала, сработает."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES"
msgid "That did the trick."
msgstr "Сработало."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHELTER"
msgid "Ah, a welcome respite."
msgstr "Ах, долгожданная передышка."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SNARED"
msgid "You can't hold me for long, dear."
msgstr "Тебе не удержать меня надолго, дорогуша."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SOAKED"
msgid "Positively soaked."
msgstr "Определенно промокло."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THORNS"
msgid "Dang spinose structure!"
msgstr "Проклятая колючая структура!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_THURIBLE_OUT"
msgid "That's that."
msgstr "Вот и все."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPED"
msgid "It has burrowed away."
msgstr "Она спряталась в норе."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOADESCAPING"
msgid "It will need to burrow soon to rehydrate its skin."
msgstr "Скоро нужно будет рыть нору, чтобы увлажнить ее кожу."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOL_SLIP"
msgid "My grip!"
msgstr "Под мою руку!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOOMANYBIRDS"
msgid "It doesn't work as well with this many birds around."
msgstr "Оно не будет работать, покуда здесь так много птиц."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TORCH_OUT"
msgid "I need another light."
msgstr "Мне нужен другой свет."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Goodness! That's one way to travel."
msgstr "Боже мой! Вот как можно путешествовать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Ой!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_UNIMPLEMENTED"
msgid "Tut tut, I don't think it's quite ready."
msgstr "Ту-ту! Не думаю, что это готово."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WAYTOOMANYBIRDS"
msgid "The sky is out of birds for now."
msgstr "Пока что в небе нет птиц."

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WET"
msgid "I wonder what my body's saturation point is..."
msgstr "Интересно, какова мера насыщения моего тела…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WETTER"
msgid "Wet, wet, wet!"
msgstr "Мокро, мокро, мокро!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMHOLE"
msgid "A detailed lesson in biology!"
msgstr "Подробный урок по биологии!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WORMS"
msgid "Something nasty intends to rear its head."
msgstr "Нечто мерзкое пытается поднять голову."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.DEER"
msgid "This will be easy."
msgstr "Это будет легко."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.GENERIC"
msgid "Combat!"
msgstr "В бой!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PIG"
msgid "Foul cad!"
msgstr "Дрянное создание!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.PREY"
msgid "Just give up."
msgstr "Просто сдайся."

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER"
msgid "Behave!"
msgstr "Веди себя прилично!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.BATTLECRY.SPIDER_WARRIOR"
msgid "Respect your elders!"
msgstr "Уважай старших!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.GENERIC"
msgid "Well, that's over."
msgstr "Ну, все кончено."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PIG"
msgid "Oh dear."
msgstr "О боже."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.PREY"
msgid "I must reassess the situation."
msgstr "Я должна переоценить ситуацию."

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER"
msgid "I must read up on this!"
msgstr "Я должна об этом прочитать!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Back to the drawing board!"
msgstr "Ну-ка назад, к доске!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL"
msgid "Fascinating. Can you speak, specter?"
msgstr "Очаровательно. Дух, ты можешь говорить?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Ah... I'm not familiar with this strain of flower."
msgstr "Ах… Мне незнакома этот вид цветка."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Does it expect something of me?"
msgstr "Он чего-то от меня ждет?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I feel I should set it down now."
msgstr "Думаю, мне нужно его посадить."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Odd..."
msgstr "Странно…"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's emitting a strange energy."
msgstr "От него исходит странная энергия."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "The flower's energy is growing powerful."
msgstr "Энергия цветка растет."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I feel a compulsive urge to activate it, again and again."
msgstr "У меня непреодолимое желание активировать его вновь и вновь."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN"
msgid "Deciduous seeds encased in a Pericarp."
msgstr "Семена лиственных, находящиеся в Перикарпии."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_COOKED"
msgid "The poison has been successfully cooked out of them."
msgstr "Яд успешно выпарился из них."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ACORN_SAPLING"
msgid "Deciduous seeds approaching maturity."
msgstr "Семена лиственных подступают ко взрослой стадии."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ADVENTURE_PORTAL"
msgid "That violates some pretty fundamental physical laws."
msgstr "Это нарушает некоторые довольно фундаментальные законы физики."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AMULET"
msgid "A relic from another time."
msgstr "Реликвия из иного времени."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR"
msgid "A monument to some long dead god."
msgstr "Памятник какому-то длинному мертвому божеству."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Parts of this are missing."
msgstr "Здесь чего-то не хватает."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANCIENT_STATUE"
msgid "This seems mystically aligned to the world."
msgstr "Кажется, они мистически связаны с этим миром."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANIMAL_TRACK"
msgid "A sign of animal activity. Leads away."
msgstr "Признак животной активности. Ведет прочь отсюда."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.GENERIC"
msgid "Ah. You must be behind all the seismic activity."
msgstr "Ага. Должно быть, это ты вызываешь сейсмическую активность."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.UNHAPPY"
msgid "Panthera auropunctata is looking irritable."
msgstr "Panthera auropunctata выглядит раздраженно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It has been mollified with tributes."
msgstr "Ему понравилось подношение."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ANTLIONTRINKET"
msgid "It appears to be a child's plaything."
msgstr "Похоже, это детская игрушка."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORDRAGONFLY"
msgid "Pyrotechnic armor!"
msgstr "Пиротехническая броня!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORGRASS"
msgid "Surprisingly effective with enough layers."
msgstr "Удивительно эффективный, если слоев достаточно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORMARBLE"
msgid "An interesting choice of materials."
msgstr "Занятный выбор материала."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORRUINS"
msgid "A hardy Thulecite armor."
msgstr "Закаленная тулецитовая броня."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSKELETON"
msgid "Now it's an exoskeleton. Ho ho!"
msgstr "Теперь это экзоскелет. Хо-хо!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSLURPER"
msgid "A disgusting and magical garment."
msgstr "Отвратительное и колдовское одеяние."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORSNURTLESHELL"
msgid "It is quite capacious."
msgstr "Довольно просторно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMORWOOD"
msgid "Crude plate mail cobbled together from log sections."
msgstr "Грубо сделанный из кусков бревен пластинчатый доспех."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARMOR_SANITY"
msgid "A protective shroud that transfers attacks to another dimension."
msgstr "Защитное полотно, которое перемещает все атаки в иное измерение."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Not much of an aid now."
msgstr "Не слишком много помощи теперь от него."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Помощь в навигации. \"Воттудавота\""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Возможность задать верный путь."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Not much of an aid now."
msgstr "Не слишком много помощи теперь от него."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A navigational aid. \"Thataway\"."
msgstr "Помощь в навигации. \"Воттудавота\""

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Возможность задать верный путь."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.GENERIC"
msgid "Some non-aqueous residue remains after the fire."
msgstr "Безводный остаток после огня."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone seems to have been burned entirely."
msgstr "Костеглаз, кажется, полностью сгорел."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower appears to have been completely burned up."
msgstr "Этот цветок, похоже, полностью сгорел."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "This used to be something, but now it's just a pile of ash."
msgstr "Раньше это было чем-то, теперь это просто кучка пепла."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is storing power."
msgstr "Там накапливается сила."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "We must be patient."
msgstr "Нам нужно набраться терпения."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "We'd best not be around when it goes off."
msgstr "Лучше нам быть подальше отсюда, когда оно взорвется."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Now where might that lead?"
msgstr "И куда же это заведет?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's taken care of."
msgstr "О них уже позаботились."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_KEY"
msgid "The key to that old gateway."
msgstr "Ключ к тем старым вратам."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I suspect it is powered by that horrible fuel."
msgstr "Подозреваю, что здесь нужно то ужасное топливо."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Indeed. It gained power from the key."
msgstr "И правда. Ключ пригодился."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It would take much too long to decipher."
msgstr "Расшифровка заняла бы куда больше времени."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "An ancient mural of a non-mammalian civilization."
msgstr "Древняя стена немлекопитающей цивилизации."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This mural panel is too eroded to decipher."
msgstr "Эта плита слишком эродирована, чтобы ее расшифровать."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "A dark shadow, or perhaps a substance, overtakes the civilization."
msgstr "Мрачная тень или вещество захватывает цивилизацию."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The citizens molt from their exoskeletons in this panel."
msgstr "А здесь жители сбрасывают свои экзоскелеты."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "The city appears exponentially more prosperous."
msgstr "Город экспоненциально становится весьма процветающим."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ATRIUM_STATUE"
msgid "It refuses to comply with this world's laws."
msgstr "Она отказывается подчиняться законам этого мира."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.AXE"
msgid "A dual inclined plane attached to a lever."
msgstr "Обоюдоострое полотно, установленное на рычаг."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Look at his widdle face! (Ahem!)"
msgstr "Посмотрите на его миленькую мордашку! (Кхм!)"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "He's even more darling in sleep."
msgstr "Во сне он даже милее."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACKPACK"
msgid "That could carry so many books."
msgstr "Здесь можно унести так много книг."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BACONEGGS"
msgid "Blue eggs and bacon!"
msgstr "Синие яйца и бекон!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOON"
msgid "Could serve as a suitable diversion."
msgstr "Можно использовать для отвлечения внимания."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BALLOONS_EMPTY"
msgid "These seem frivolous."
msgstr "Они смотрятся слишком несерьезно."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BANDAGE"
msgid "Medicinal dressings."
msgstr "Медицинский перевязочный материал."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BASALT"
msgid "Material of great density!"
msgstr "Материал высокой плотности!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BAT"
msgid "A flying mammal."
msgstr "Летающее млекопитающее."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATBAT"
msgid "Interesting. This weapon appears to be alive."
msgstr "Интересно. Это оружие, кажется, живое."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BATCAVE
