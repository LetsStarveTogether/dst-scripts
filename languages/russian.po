msgstr "Сожжено до пепла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
