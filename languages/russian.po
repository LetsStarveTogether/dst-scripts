msgstr "Бросаешь — и пора баиньки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPER"
msgid "No! No! Stay off head!"
msgstr "Нет! Нет! Только не на голову!"

