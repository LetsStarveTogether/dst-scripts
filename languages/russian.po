#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL"
msgid "I'm not too interested in rocks."
msgstr "Камни — не мое."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER
