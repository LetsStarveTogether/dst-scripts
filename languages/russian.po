msgstr "Мы призываем тебя, теплый шар света!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
