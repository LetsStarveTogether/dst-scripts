#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROOK_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "Эй! Не обижай беса!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROPE"
