msgstr "Кухонная утварь."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FERN"
msgid "Probably chock full of vitamins."
msgstr "Наверняка витаминов в нем под завязку."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Ready for baking."
msgstr "Бери и пеки."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "We cooked the foliage."
msgstr "Мы приготовили листву."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
