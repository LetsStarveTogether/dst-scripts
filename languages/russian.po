msgstr "Маленькое деревце!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGGY_OLD"
msgid "It's too flimsy to climb."
msgstr "Оно слишком хрупкое, чтобы на него взбираться."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TWIGS"
