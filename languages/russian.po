msgstr "Фу-у-у, у нее головы нет!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN"
