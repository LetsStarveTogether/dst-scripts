msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.GENERIC"
