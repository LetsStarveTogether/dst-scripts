#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
