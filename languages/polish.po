msgstr "To dość wulgarne!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY"
msgid "Rein in that attitude before I rein in you!"
msgstr "Uspokójcie się, bo ja was uspokoję!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY"
msgid "You're getting soft!"
msgstr "Mięciutki się robisz!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER"
msgid "Wow! You're in top form!"
msgstr "Łał! Jesteś w wyśmienitej formie!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING"
msgid "Lazy."
msgstr "Kawał lenia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT"
msgid "Seem secretive."
msgstr "Jakże tajemniczy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL"
msgid "Smelly, but warm."
msgstr "Trochę śmierdzi, ale wspaniale grzeje."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD"
msgid "Monarchy is an outdated ruling system!"
msgstr "Monarchia to przestarzały system rządów!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT"
msgid "Respecting bees means respecting stingers."
msgstr "Szacunek do pszczół to szacunek do żądeł."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE"
msgid "Hard at work."
msgstr "Ciężko pracują."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE"
msgid "Sounds like the hum of an engine."
msgstr "Jak pomruk silnika."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL"
msgid "That guy's got no concern for others. Pfft."
msgstr "Ten człowiek zupełnie nie przejmuje się innymi. Pff."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN"
msgid "It's the queen of bees!"
msgstr "To królowa pszczół!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Sticky. I'd rather not walk on it."
msgstr "Lepko. Wolałabym się tu nie kręcić."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "I swear that thing's gotten bigger."
msgstr "Głowę dam, że to coś stało się większe."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Yeesh! I'd take a hammer to that."
msgstr "Raju! Młotkiem bym tłukła."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX"
msgid "It smells kinda alright."
msgstr "Pachnie całkiem w porządku."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR"
msgid "Go back to your cage."
msgstr "Wracaj do swojej klatki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL"
msgid "There's always a stampede when the quittin' bell rings."
msgstr "Gdy przychodzi fajrant, zawsze robi się zamieszanie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL_BLUEPRINT"
msgid "Ahh, interesting!"
msgstr "Ach! Interesujące!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE"
msgid "Is he clockwork? Can I peek inside?"
msgstr "Jaki mechanizm go napędza? Mogę zajrzeć do środka?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He's a bit of a fixer-upper."
msgstr "Przydałaby mu się wizyta w warsztacie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "This little guy's been well loved."
msgstr "Ten koleżka zaznał wiele miłości."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES"
msgid "A handful of loose berries."
msgstr "Garść jakichś porzeczek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED"
msgid "A bit charred in places, but I don't mind."
msgstr "Miejscami nieco spopielone, ale mi to nie wadzi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY"
msgid "They're so juicy!"
msgstr "Ale soczyste!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're still pretty darn juicy."
msgstr "Wciąż całkiem soczyste."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN"
msgid "Needs something from a beast's backside."
msgstr "Trzeba tu produktów ubocznych zwierząt."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING"
msgid "Not much I can do now."
msgstr "Teraz za dużo nie zrobię."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Może weź wolne, co?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Yeuch! Is it supposed to smell like that?"
msgstr "Uch! Czy to powinno tak śmierdzieć?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Can I eat those?"
msgstr "Mogę je zjeść?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED"
msgid "Picked it right clean."
msgstr "Wyzbierane do ostatniej sztuki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED"
msgid "You've obviously never worked a boiler room."
msgstr "Ewidentnie nie masz doświadczenia w pracy w kotłowni."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Totally pooped. Or unpooped?"
msgstr "Kamieni kupa. Tylko kupy brak."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Not much I can do now."
msgstr "Teraz za dużo nie zrobię."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Może weź wolne, co?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Yeuch! Is it supposed to smell like that?"
msgstr "Uch! Czy to powinno tak śmierdzieć?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Looks tasty. Hope they're not poison."
msgstr "Wyglądają smakowicie. Mam nadzieję, że nie są trujące."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Picked it right clean."
msgstr "Wyzbierane do ostatniej sztuki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Pssh. This heat's nothing."
msgstr "Gadanie. Wcale nie jest tak gorąco."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT"
msgid "At least it doesn't have steel-toed workboots!"
msgstr "Przynajmniej nie nosi obuwia ochronnego!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE"
msgid "Shoo! Get outta here!"
msgstr "Sio! Wynocha stąd!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD"
msgid "I think it was my turn to feed her."
msgstr "To była chyba moja kolej, aby dać żarełko."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "That's some proper metalwork."
msgstr "I to się nazywa fachowa obróbka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Hey! Is it my turn to feed the bird?"
msgstr "Hej? Czy to moja kolej, aby nakarmić ptaka?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "She was just a patsy."
msgstr "Płaci cenę za swoją naiwność."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Let's uh... just sweep that under the rug."
msgstr "No tak... To może zamiećmy to pod dywan."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Why are you tired? Your life is so cushy."
msgstr "Co cię tak zmęczyło? Przecież twoje życie to bajka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING"
msgid "This poor bird's a bag of bones."
msgstr "Ten ptak to sama skóra i kości."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP"
msgid "Birds of a feather get trapped together."
msgstr "Pułapka na ptaki. Dla niepoznaki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG"
msgid "Breakfast."
msgstr "Śniadanie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED"
msgid "I always get bits of shell in there by accident."
msgstr "Nigdy nie udaje mi się go dobrze obrać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP"
msgid "How industrial."
msgstr "Jakież to industrialne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Yeow!"
msgstr "Auć!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "You look awful!"
msgstr "Wyglądasz okropnie!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE"
msgid "Simple, but effective."
msgstr "Proste, ale skuteczne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA"
msgid "Efficient, and painful!"
msgstr "Tyle skuteczne, co bolesne!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2"
msgid "That's right up my alley!"
msgstr "To w sam raz w moim stylu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "Tfu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP"
msgid "Inflicts the very worst thing... laziness."
msgstr "Wywołuje najgorszy ze stanów... Lenistwo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW"
msgid "I'm gonna shoot this at the bot's butt."
msgstr "Postrzelę robota w tyłek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET"
msgid "Now I don't have to take breaks to cool off."
msgstr "Teraz nie muszę już robić sobie przerw, aby ochłonąć."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM"
msgid "It's a gem. A gem that's blue."
msgstr "Klejnot. Klejnot koloru niebieskiego."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE"
msgid "It saw me standing alone."
msgstr "Spogląda na wskroś przez moją samotność."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT"
msgid "Blueprint paper just smells right."
msgstr "Nic nie pachnie tak dobrze, jak papier milimetrowy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP"
msgid "Yep. Blue mushroom."
msgstr "Aha. Niebieski grzyb."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED"
msgid "Well, I don't THINK it's poison."
msgstr "Ja na ten przykład nie UWAŻAM, że jest trujący."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's some sorta blue mushroom."
msgstr "To jakiś niebieski muchomor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Leniwy grzyb."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Got'er done."
msgstr "Zebrany."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS"
msgid "Oh, the possibilities."
msgstr "Ach, cały świat możliwości."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON"
msgid "Who's ready fer some bacon?!"
msgstr "Kto ma ochotę na nieco bekonu?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR"
msgid "Let's cut him down to size!"
msgstr "Ależ żeś się rozrósł!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD"
msgid "Whew. These got crunched real good."
msgstr "Łał. Ale schrupane."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW"
msgid "Hearty."
msgstr "Porządna wyżerka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS"
msgid "I was never much of a book learner."
msgstr "Nigdy nie ciągnęło mnie zbytnio do książek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE"
msgid "I prefer hands-on learning."
msgstr "Wolę wiedzę praktyczną."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL"
msgid "I ain't too well read."
msgstr "Niezbyt jestem oczytana."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL"
msgid "I ain't much of a bookworm."
msgstr "Marny ze mnie mól książkowy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING"
msgid "I prefer to learn from experience."
msgstr "Wolę uczyć się z doświadczenia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP"
msgid "I already know how to sleep, thanks."
msgstr "Już umiem spać. Dzięki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES"
msgid "I'm not really a \"book smarts\" kind of gal."
msgstr "Nie jestem typowym molem książkowym. Nietypowym też nie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG"
msgid "It's great at comebacks. Ha!"
msgstr "Ma świetne riposty. Ha!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH"
msgid "Repetitive tasks are soothing."
msgstr "Mechaniczne zajęcia są bardzo kojące."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET"
msgid "Wish we had mosquito netting."
msgstr "Szkoda, że nie mamy tu siatki na komary."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE"
msgid "That oughta keep everything nice and fresh."
msgstr "Teraz wszystko powinno być suche i bezpieczne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP"
msgid "We could wrap stuff up for later."
msgstr "Można zawinąć rzeczy na później."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN"
msgid "You really oughta get some sun."
msgstr "Naprawdę przydałoby ci się trochę słońca."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Right to a crisp."
msgstr "Jak skwarka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT"
msgid "Just, y'know. Strap a bush on your head."
msgstr "Tak jakby, wiesz. Zakładasz krzak i jedziesz."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER"
msgid "This makes everything better."
msgstr "Od razu lepiej."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It has no work or responsibilities. Poor thing."
msgstr "Nie ma żadnych obowiązków. Biedactwo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD"
msgid "How you doin' in there?"
msgstr "Jak się tam trzymasz?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Never liked having butterflies in my stomach."
msgstr "Nigdy nie lubiłam, jak mi motyle latały w brzuchu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS"
msgid "There's no flight in their future."
msgstr "Ich przyszłość nie uwzględnia lotu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD"
msgid "It lives off the hard work of others."
msgstr "Żyje z ciężkiej pracy innych."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC"
