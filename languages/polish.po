msgstr "O rany..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOTAMMO_ROCK"
