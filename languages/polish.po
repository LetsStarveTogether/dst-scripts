#. STRINGS.SKIN_DESCRIPTIONS.puppy_winter
msgctxt "STRINGS.SKIN_DESCRIPTIONS.puppy_winter"
msgid "Looks like this adorable little lump grew his winter coat in. Good boy, Vargling!"
msgstr "Wygląda na to, że ta mała kuleczka szczęścia wyhodowała zimowe futerko. Brawo, warguś!"

