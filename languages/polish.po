msgstr "Chyba potrzebuje paliwa."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "It, oh, it appears to be on fire."
msgstr "Chyba... chyba się przypala."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Crisp, non?"
msgstr "Przysmażone, non?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "I feel so safe now."
msgstr "Czuję się teraz bezpiecznie."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It's not on."
msgstr "Nie jest włączona."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "It, oh, it appears to be on fire."
msgstr "Chyba... chyba się przypala."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Crisp, non?"
msgstr "Przysmażone, non?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Oh good. I don't much like the dark out here."
msgstr "Dobrze, nie lubię, jak jest ciemno."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Is it out of power?"
msgstr "Rozładowało się?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTERHAT"
