msgstr "Czas spać."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLINGSHOT"
