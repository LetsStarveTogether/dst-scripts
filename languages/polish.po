#. STRINGS.MESSAGEBOTTLE_NOTES.1
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.1"
msgid "\"I know you're still out there, my dear. I won't ever give up.\""
msgstr "\"Wiem, że wciąż gdzieś tam jesteś, kochanie. Nigdy nie przestanę cię szukać\"."

#. STRINGS.MESSAGEBOTTLE_NOTES.2
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.2"
msgid "\"I'm waiting for you. At the spot where we first met. I've been waiting so long...\""
msgstr "\"Czekam na ciebie. Tam, gdzie się poznaliśmy. Czekam już od tak dawna...\"."

#. STRINGS.MESSAGEBOTTLE_NOTES.3
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.3"
msgid "\"Please come home. I miss you so much.\""
msgstr "\"Błagam, wróć do domu. Tak bardzo za tobą tęsknię\"."

#. STRINGS.MESSAGEBOTTLE_NOTES.4
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.4"
msgid "\"I still have the last gift you gave me. \"A pearl for Pearl\"... remember?\""
msgstr "\"Wciąż mam ostatni prezent od ciebie. Perełka dla Perełki... pamiętasz?\""

#. STRINGS.MESSAGEBOTTLE_NOTES.5
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.5"
msgid "\"I'll keep sending messages, until one reaches you...\""
msgstr "\"Będę wysyłać te wiadomości tak długo, aż w końcu któraś z nich do ciebie trafi...\""

#. STRINGS.MESSAGEBOTTLE_NOTES.6
msgctxt "STRINGS.MESSAGEBOTTLE_NOTES.6"
msgid "\"Have you found your treasure yet? When you do, will you come home?\""
msgstr "\"Czy znalazłeś już swój skarb? Czy kiedy ci się uda, wrócisz do domu?\""

#. STRINGS.MODS.VERSIONING.OUT_OF_DATE
