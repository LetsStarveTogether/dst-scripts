msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT"
msgid "They are at least warm."
msgstr "Przynajmniej są ciepłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL"
msgid "It slithers all the way down."
msgstr "Ślisko ślizga się ciałem obślizgłym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED"
msgid "Still rather grotesque."
msgstr "Wciąż zgoła groteskowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT"
msgid "Just another boring plant."
msgstr "Kolejna nudna roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT"
msgid "That was uncalled for."
msgstr "To nie było potrzebne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Puste naczynie czekające na dekorację lub światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Tymczasowy odpoczynek od mroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC"
msgid "Purely decorative."
msgstr "Ma walory czysto dekoracyjne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Teraz Willsona kolej, żeby zdobyć żarówki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Każdy kwiat, nawet najpiękniejszy, kiedyś więdnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT"
msgid "Bathed in fire."
msgstr "Skąpane w ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED"
msgid "That's not about to grow back."
msgstr "Raczej nie odrośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC"
msgid "An acquaintance of mine describes them as \"piney\"."
msgstr "Pewien mój znajomy zwykłe opisywać je jako „liściaste”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Dust to dust."
msgstr "Z prochu powstałeś i w proch się obrócisz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "I put it out of its misery."
msgstr "Skróciłem jego męki na tym świecie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Nie wygląda zdrowo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT"
msgid "Eye to the sky."
msgstr "Zwróć oko ku niebu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT"
msgid "The Meat Bulb's pawns."
msgstr "Sługa mięśniaka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET"
msgid "Some of my better work."
msgstr "Jedno z moich lepszych dzieł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM"
msgid "Now it just needs to be set up."
msgstr "Teraz trzeba ją tylko rozstawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT"
msgid "A harvest of ashes."
msgstr "Ognisty plon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC"
msgid "Do I look like a farmer?"
msgstr "Wyglądam na rolnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING"
msgid "I have better things to do than watch plants grow."
msgstr "Mam lepsze rzeczy do roboty niż patrzenie, jak rosną rośliny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs to be... refreshed."
msgstr "Trzeba je trochę... odświeżyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN"
msgid "Is it windy out or is it just this fan?"
msgstr "Tak bardzo wieje, czy to tylko przez ten wiatrak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT"
msgid "I always considered myself the peacock of people."
msgstr "Zawsze widzałem się jako pawia mego ludu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL"
msgid "Not as elegant as a quill and inkwell, but it'll do."
msgstr "Nie tak elegancki jak pióro i atrament, ale może być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY"
msgid "Yellow is the color of naivety."
msgstr "Żółty to kolor naiwności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW"
msgid "Black is the color of sleep."
msgstr "Czerń to kolor snu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN"
msgid "Red is the color of fire."
msgstr "Czerwony to kolor ognia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Grey is the color of pain."
msgstr "Szary to kolor cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET"
msgid "Better her than me."
msgstr "Lepiej ona niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE"
msgid "My life is one obstacle after another."
msgstr "Moje życie jest pełne przeszkód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE"
msgid "When one gate closes..."
msgstr "Gdy jedna brama się zamyka..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM"
msgid "A gate for your pocket."
msgstr "Kieszonkowa furtka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM"
msgid "A fence for your pocket."
msgstr "Kieszonkowy płot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER"
msgid "It's not gentlemanly to carry manure in one's hands."
msgstr "Noszenie w rękach łajna nie przystoi dżentelmenom."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF"
msgid "A staff after my own heart!"
msgstr "To to ja rozumiem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS"
msgid "Great for magic tricks."
msgstr "Doskonałe do magicznych sztuczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC"
msgid "How pretty."
msgstr "Przepiękne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD"
msgid "I could squish them if I wanted to."
msgstr "Mógłbym je rozgnieść, gdybym tylko chciał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND"
msgid "I put fire gems in there as a joke."
msgstr "Dodałem do nich ogniste klejnoty, tak dla żartu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS"
msgid "I should attend to that."
msgstr "Powinienem się nim zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Palenisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH"
msgid "A roaring fire."
msgstr "Szalejący ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Zaczyna przygasać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL"
msgid "It's hot."
msgstr "Gorące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT"
msgid "It's gone cold."
msgstr "Zgasło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF"
msgid "A basic enchantment, but effective."
msgstr "Podstawowe zaklęcie, ale bardzo skuteczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Not much fuel left."
msgstr "Zostało mało paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet before the storm."
msgstr "Cisza przed burzą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Begone, fire!"
msgstr "Przepadnij, ogniu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH"
msgid "Fresh from the murky depths."
msgstr "Prosto z mokrych otchłani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD"
msgid "I will eat for a lifetime."
msgstr "Najem się po wsze czasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS"
msgid "These should tide me over."
msgstr "Niewyrafinowane, ale bardzo przyzwoite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS"
msgid "Cooked fish in a crunchy shell."
msgstr "Smaczna rybka w chrupiącym kocyku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED"
msgid "It still stinks."
msgstr "Wciąż śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT"
msgid "Ow! I cut my finger!"
msgstr "Auć! Zaciąłem się w palec!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC"
msgid "I am filled with the irrational urge to stomp upon it."
msgstr "Czuję niewytłumaczalną potrzebę zadeptania go na śmierć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE"
msgid "This is wrong."
msgstr "To nie w porządku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT"
msgid "Definitely not my style."
msgstr "Zdecydowanie nie moje klimaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD"
msgid "Leafy goodness."
msgstr "Liściaste błogosławieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE"
msgid "It's so dark down here."
msgstr "Ależ tu ciemno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL"
msgid "I like that flower."
msgstr "Podoba mi się ten kwiat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED"
msgid "It got what it deserved."
msgstr "Zasłużył sobie na to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE"
msgid "A meal fit for a peasant."
msgstr "Posiłek dla prostaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT"
msgid "Ready for the scrimmage."
msgstr "Gotów do szarpaniny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE"
msgid "Perhaps it is best left in pieces."
msgstr "Może lepiej zostawić w kawałkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Was it wise to unleash this upon the world?"
msgstr "Rozsądnym było wypuszczenie go na świat?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "It will be the laughingstock of the demon community."
msgstr "Będzie pośmiewiskiem w demoniej społeczności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "The beginnings of some demonic beast."
msgstr "Początek jakiejś demonicznej bestii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Już jej nie do śmiechu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC"
msgid "It jumps and licks things."
msgstr "Skacze i liże wszystko dokoła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING"
msgid "It looks tired."
msgstr "Wygląda na zmęczoną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH"
msgid "Has a bit of a kick to it."
msgstr "Potrafi dać niezłego kopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS"
msgid "Muscular."
msgstr "Nieźle umięśnione."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED"
msgid "Stringy."
msgstr "Trochę żylaste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
msgid "This would be great with a simple cheese plate."
msgstr "Świetnie pasowałyby do deski serów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT"
msgid "Not quite enough for a rug."
msgstr "Na chodnik nie starczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND"
msgid "Try and get me now. Ha!"
msgstr "Spróbuj mnie teraz dorwać. Ha!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Not so tough."
msgstr "Jednak nie taki z ciebie twardziel!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS"
msgid "My pets! What has become of you?"
msgstr "Moi drodzy! Cóż się z wami stało?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS"
msgid "The fuel needs a focus."
msgstr "Paliwo potrzebuje skupienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID"
msgid "This one's ready."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST"
msgid "It remembers me!"
msgstr "Pamięta mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFT"
msgid "An elegantly wrapped social obligation."
msgstr "Elegancko opakowane zobowiązanie społeczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFTWRAP"
msgid "For wrapping odds and ends..."
msgstr "Do pakowania różnych takich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSBLOCK"
msgid "Not the castle I had in mind for myself."
msgstr "Nie o takiej fortecy myślałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSSPIKE"
msgid "I hope I'm not so transparent."
msgstr "Mam nadzieję, że ja nie jestem aż tak transparentny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER"
msgid "A flying goop factory."
msgstr "Latająca fabryka śluzu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Flower power forever."
msgstr "Flower power na wieki wieków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "Flower power."
msgstr "Flower power."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFUEL"
msgid "Well, that's rank."
msgstr "Ale śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERWINGS"
msgid "They're sticky."
msgstr "Trochę się kleją."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOATMILK"
msgid "It's charged with nutrients."
msgstr "Pełne składników odżywczych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOGGLESHAT"
msgid "Not my sort of fashion."
msgstr "To nie mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENAXE"
msgid "It gets sharper with every cut."
msgstr "Z każdym ciosem robi się ostrzejsza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPICKAXE"
msgid "This must be game logic."
msgstr "To jakaś logika z gier."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPITCHFORK"
msgid "I'm not sure this was a good investment."
msgstr "Nie jestem pewien, czy to dobra inwestycja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENSHOVEL"
msgid "This shovel is worth a princely sum."
msgstr "Ta łopata warta jest ładną sumkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDNUGGET"
msgid "This was important to me once."
msgstr "Kiedyś było to dla kogoś bardzo cenne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOOSE_FEATHER"
msgid "I could use a pillow filled with these."
msgstr "Przydałaby mi się poduszka z takimi piórami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BARREN"
msgid "Needs manure."
msgstr "Potrzeba obornika."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.GENERIC"
msgid "Tufty."
msgstr "Trawka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.PICKED"
msgid "Nothing to harvest."
msgstr "Nie ma czego zbierać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.WITHERED"
msgid "You'd think grass could withstand this heat..."
msgstr "Spodziewałbym się, że trawa przetrwa takie temperatury..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It's sickly and frail."
msgstr "Słabowity i mizerny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "I'm sure its tail grows back."
msgstr "Ciekawe, czy odrasta mu ogon..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS_UMBRELLA"
msgid "It's more \"pretty\" than \"dapper\"."
msgstr "Raczej ładna niż wytworna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENAMULET"
msgid "A crutch for pitiful mortals without godlike powers. What?"
msgstr "Podpora dla żałosnych śmiertelników bez mocy godnych bogów. Co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENGEM"
msgid "Only the nightmare fuel will unlock its true potential."
msgstr "Jedynie koszmarne paliwo może uwolnić jego prawdziwy potencjał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENMOONEYE"
msgid "It's useful for keeping in contact with my... acquaintances."
msgstr "Pomoże mi utrzymać kontakt z moimi... znajomymi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENSTAFF"
msgid "It is a focusing tool."
msgstr "Narzędzie skupiające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP"
msgid "I should eat it."
msgstr "Powinienem go zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP_COOKED"
msgid "Salty!"
msgstr "Słony!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Green fungus."
msgstr "Zielony grzyb."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "When do those ones come up?"
msgstr "Kiedy one wyłażą?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Been there. Done that."
msgstr "Załatwiony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUACAMOLE"
msgid "There's a mole in the mix."
msgstr "Co za kretyn to wymyślił."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUANO"
msgid "Disgusting!"
msgstr "Obrzydliwe!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUNPOWDER"
msgid "Now THIS I like."
msgstr "TO mi się podoba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_1"
msgid "Oh good, it's solid candy. I feared something healthy had snuck in."
msgstr "Och, porządny cukierek. Już się bałem, że wkradło się tu coś zdrowego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_10"
msgid "No one is above enjoying a good lollipop."
msgstr "Wszyscy lubią lizaki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_11"
msgid "Eating them makes me feel powerful."
msgstr "Dzięki nim rosnę w siłę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_12"
msgid "Ah, maggots... how novel."
msgstr "Ach, robactwo... Jakże zaskakujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_13"
msgid "It's not terrible."
msgstr "To nie takie straszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_14"
msgid "Only ruffians enjoy torturing themselves like this."
msgstr "Li tylko awanturnicy zwykli torturować się w ten sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_2"
msgid "Waxy, just like me."
msgstr "No to hop."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_3"
msgid "Who is making all this candy, exactly?"
msgstr "Kto robi te wszystkie słodycze?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_4"
msgid "Black licorice, my favorite."
msgstr "Lukrecja. Moja ulubiona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_5"
msgid "Almost endearing. Almost."
msgstr "Prawie uroczy. Prawie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_6"
msgid "A mystery I'm not keen on solving."
msgstr "Tajemnica, której nie mam ochoty odkrywać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_7"
msgid "I am much more disappointed than I thought I'd be."
msgstr "Jestem dużo bardziej rozczarowany, niż się spodziewałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_8"
msgid "No one is above enjoying a good lollipop."
msgstr "Wszyscy lubią lizaki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_9"
msgid "How the tables have turned, worm."
msgstr "Popatrz, jak los może się odwrócić, robaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Takes away the horrors. But who would want that?"
msgstr "Odgania koszmary. Ale kto by chciał coś takiego?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Ah. This'll do the trick."
msgstr "Ach, to powinno pomóc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Could be a little stronger."
msgstr "Przydałoby się coś mocniejszego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Might as well throw it in the fire."
msgstr "Można równie dobrze cisnąć nimi w ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Oh joy. Is there really need for decoration?"
msgstr "Och, radości. Czy naprawdę musimy uciekać się do dekoracji?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Such a burden to carry it. If only there were a place to leave it."
msgstr "Jakaż to szkoda, aby nosić taką ozdobę ze sobą. Gdybym tylko mógł gdzieś ją zostawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "I like the real ones better."
msgstr "Wolę prawdziwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Shouldn't it be hanging from somewhere."
msgstr "Nie powinnaś gdzieś wisieć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Ugh. These guys again."
msgstr "No nie. Znowu oni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Why do I hear \"Nevermore\"?"
msgstr "Czemu słyszę „Kres i krach”?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMBAT"
msgid "An undignified weapon for a less refined time."
msgstr "Nieelegancka broń na mniej cywilizowane czasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER"
msgid "It feels good to undo the work of others."
msgstr "Niweczenie pracy innych daje całkiem sporo satysfakcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER_MJOLNIR"
msgid "I would never resort to something so brutish."
msgstr "Nigdy nie odważyłbym się na taką toporność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAWAIIANSHIRT"
msgid "The dapperest of them all."
msgstr "Najwytworniejsza ze wszystkich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSALVE"
msgid "Just a bit of venom and some dirty old ash."
msgstr "Trochę jadu i starego popiołu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSTAFF"
msgid "I could be persuaded to dabble in white magicks."
msgstr "W sumie nie mam tak wiele przeciwko białej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.COLD"
msgid "Pleasantly cool."
msgstr "Przyjemnie chłodny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.FROZEN"
msgid "It's almost too cold to hold."
msgstr "Jest tak zimny, że ledwo mogę go utrzymać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.GENERIC"
msgid "A pocketful of stone and temperature."
msgstr "Kieszonkowa grzałka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.HOT"
msgid "It's almost too hot to hold."
msgstr "Jest tak gorący, że ledwo mogę go utrzymać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.WARM"
msgid "Comfortably lukewarm."
msgstr "Przyjemnie ciepły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIVEHAT"
msgid "Makes one feel like royalty."
msgstr "Czuję się normalnie jak król."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOME"
msgid "There's no place like it."
msgstr "Wszędzie dobrze, ale tam najlepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.GENERIC"
msgid "\"You are here\"... I wish I wasn't!"
msgstr "„Jesteś tutaj”... No więc wolałbym tu nie być!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEY"
msgid "Sticky and sweet."
msgstr "Słodki i klejący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYCOMB"
msgid "It's full of bee maggots."
msgstr "Pełny pszczelich larw."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYHAM"
msgid "Tender."
msgstr "Kruchutka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYNUGGETS"
msgid "These look childish, but they're delicious."
msgstr "Wyglądają dziecinnie, ale są przepyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HORN"
msgid "Call forth the beasts!"
msgstr "Wezwijcie bestie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTCHILI"
msgid "Hot as heck!"
msgstr "Gorąco jak w garnku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUND"
msgid "They don't recognize me!"
msgstr "Nie rozpoznają mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDBONE"
msgid "Hungry devils, aren't they?"
msgstr "Głodne z nich bestie, co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDMOUND"
msgid "It's a tunnel down to the hounds' nest."
msgstr "Tunel prowadzący do nory ogarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDSTOOTH"
msgid "It could be used for fashion."
msgstr "Można by go wykorzystać z modzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDWHISTLE"
msgid "Howl I ever find a use for this?"
msgstr "Na co mogłoby mi się to kiedykolwiek przydać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH"
msgid "Stick your tongue in. You're getting slobber on my pantlegs."
msgstr "Schowaj język. Chlapiesz mi na nogawki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Better him in that bowl than me."
msgstr "Lepiej on niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "His spirit is free now."
msgstr "Jego dusza jest wreszcie wolna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICE"
msgid "Baby glaciers."
msgstr "Małe lodowce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBOX"
msgid "A little piece of winter in a box."
msgstr "Kawałek zimy w pudełku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICECREAM"
msgid "Sundae, sundae, sundae!"
msgstr "Na poprawę humoru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHAT"
msgid "Strap some ice on your head."
msgstr "Przytwierdź sobie lód do głowy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHOUND"
msgid "I had a lot of surplus gems!"
msgstr "Miałem sporą nadwyżkę klejnotów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEPACK"
msgid "Its contents are hibernating."
msgstr "Komora hibernacyjna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICESTAFF"
msgid "Cool staff."
msgstr "Wieje chłodem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "I can see its true nature now!"
msgstr "Teraz dostrzegam jego prawdziwą naturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It only half-exists on this plane."
msgstr "Tak naprawdę w tej płaszczyźnie istnieje tylko w połowie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSPECTSELF"
msgid "I still look dapper, right? As if I need to check."
msgstr "Wciąż wyglądam wytwornie, prawda? Jakbym się w ogóle musiał upewniać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JAMMYPRESERVES"
msgid "It's soiled my good gloves."
msgstr "Pobrudziłem najlepsze rękawiczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBEAN"
msgid "I think there's seventeen in there."
msgstr "Jest ich chyba z siedemnaście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KABOBS"
msgid "Cooked to perfection."
msgstr "Przyrządzony wręcz idealnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.GENERIC"
msgid "What is that bee so angry about?"
msgstr "O co ten szerszeń się tak wścieka?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.HELD"
msgid "I've caught a tiger by the tail."
msgstr "Złapałem tygrysa za ogon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS"
msgid "My, what a magnificently horrific creature."
msgstr "Ależ cudownie straszliwe stworzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUSSACKKEY"
msgid "Magic has done things to this beast's horn."
msgstr "W porożu tego stworzenia widać wyraźne ślady działania magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS_SACK"
msgid "What dark treasures lie within?"
msgstr "Ciekawe, jakież mroczne skarby czekają w środku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT"
msgid "Such quality workmanship!"
msgstr "Fachowa robota!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks beyond repair."
msgstr "Tego nie da się już naprawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_SUMMER"
msgid "A distant cousin of the beefalo."
msgstr "Daleki kuzyn wołka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_WINTER"
msgid "It has its winter coat on."
msgstr "Ma na sobie zimowe wdzianko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS"
msgid "You won't catch me!"
msgstr "Nie złapiesz mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS_SACK"
msgid "It's really light."
msgstr "Jest naprawdę lekki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LANTERN"
msgid "I hope it keeps Them away."
msgstr "Mam nadzieję, że to Ich powstrzyma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Quite a clunky looking thing."
msgstr "Jakieś to takie nieporęczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Seems heavy."
msgstr "Ciężka rzecz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "It is nearly useless."
msgstr "W zasadzie bezużyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Swiftly useless."
msgstr "Błyskawicznie bezużyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It offers a serviceable amount of protection."
msgstr "Oferuje ochronę na znośnym poziomie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "This was intended for someone physically-inclined."
msgstr "Okrycie zaprojektowane z myślą o kimś o dużej sile."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Decent protection that will enhance my power."
msgstr "Znośna ochrona, która wzmacnia moją moc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "A little extra armor never hurt."
msgstr "Nieco pancerza jeszcze nikomu nie zaszkodziło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "We must destroy that Battle Standard."
msgstr "Musimy zniszczyć tę chorągiew."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BERNIE"
msgid "That thing's still shambling about, I see."
msgstr "Widzę, że to coś wciąż miota się w tę i nazad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BOARLORD"
msgid "You seem severely deluded, good sir."
msgstr "Zdaje się, że nie masz wszystkich w domu, dobry człowieku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "You'd need a thick neck to wear such a thing."
msgstr "Noszenie tego dodatku wymagałoby naprawdę grubej szyi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "You shall serve us."
msgstr "Będziesz nam służyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I must have it."
msgstr "Muszę to zdobyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Horsefeathers."
msgstr "Końskie pióra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Not really my style."
msgstr "To nie do końca mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "I could use the invigoration."
msgstr "Przydałoby mi się nieco energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Self sufficiency in wreath form."
msgstr "Samowystarczalność w formie wieńca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "Too brutish for my tastes."
msgstr "Zbyt brutalne narzędzie jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "A key is key."
msgstr "Klucz to klucz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Right as rain."
msgstr "Co ma nie pasować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "That is not suited to me."
msgstr "To nie dla mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LUCY"
msgid "I have no desire to use that."
msgstr "Nie mam najmniejszej ochoty brać w tym udziału."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Meddling with it will only cause further trouble."
msgstr "Dalsze kombinacje mogą wyłącznie pogorszyć sprawę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Let us end this chapter of our journey."
msgstr "Zakończmy więc ten rozdział naszej podróży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "It will quickly restore my powers."
msgstr "Szybko odzyskam w nim siły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPAWNER"
msgid "It's a one-way portal."
msgstr "To portal w jedną stronę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'd never wear such an undapper thing."
msgstr "W życiu nie włożyłbym czegoś równie nieeleganckiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "A decent wreath, should I feel like healing."
msgstr "Niezgorszy wieniec, gdybym potrzebował leczenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE"
msgid "Foul beast! Know your place!"
msgstr "Podła bestia! Znaj swoje miejsc!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_COCOON"
msgid "It's no threat in this state."
msgstr "W takiej formie nie stanowi zagrożenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "It's alive in there."
msgstr "W środku jest coś żywego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "I knew I would make a terrible pa-pa."
msgstr "Wiedziałem, że byłby ze mnie fatalny opiekun."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "I can say with pride that it is comfy and cozy."
msgstr "Mogę z dumą stwierdzić, iż jest mu wygodnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It's happy with me, and I with it."
msgstr "On lubi mnie, a ja lubię jego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.GENERIC"
msgid "You're not a hellbeast, are you? Nooo. Just misunderstood!"
msgstr "Wcale nie jesteś bestią z piekła rodem, prawda? Nieee. Nikt cię po prostu nie rozumie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "It's hungry. Why is it hungry?"
msgstr "Jest głodny. Dlaczego jest głodny?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.STARVING"
msgid "I think it's going to die!"
msgstr "Chyba zaraz sczeźnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_TOOTH"
msgid "The lavae's baby tooth."
msgstr "Ząb małego lawowca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.COOL"
msgid "It's cold and dry now."
msgstr "Zimna i sucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.HOT"
msgid "Spitfire."
msgstr "Ogień z pyska."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND"
msgid "A touch hot, but it could cook my food in a pinch."
msgstr "Kapkę gorąca, ale w mig ugotuję na niej jedzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND_ROCK"
msgid "With each day I get a little boulder."
msgstr "Każdego dnia stajemy się twardsi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF"
msgid "Disgusting creature!"
msgstr "Odrażające stworzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF_SPARSE"
msgid "Disgusting creature!"
msgstr "Odrażające stworzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LICHEN"
msgid "This fungus survived the downfall."
msgstr "Ten grzyb przetrwałby nawet kataklizm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIFEINJECTOR"
msgid "Who would put this filth in their veins?"
msgstr "Któż chciałby wtłoczyć to ścierwo w swe żyły?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTBULB"
msgid "It will run out eventually."
msgstr "W końcu się wypali."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTER"
msgid "It does the job, I suppose."
msgstr "Działa adekwatnie do rozmiaru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Chaaarge!"
msgstr "Ataaaak!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "What's it always chewing on?"
msgstr "Co on tak ciągle przeżuwa?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It'd make a nice horn."
msgstr "Można by na nim zagrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Energy flows through it."
msgstr "Przepływa przez nią strumień energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "A little bit of protection."
msgstr "Odrobina ochrony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LITTLE_WALRUS"
msgid "A chip off the old block."
msgstr "Pomiot szatańskiego stworzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGLOG"
msgid "I like the noise they make when you burn them."
msgstr "Lubię dźwięki, które wydają, jak się palą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE"
msgid "It's got a face."
msgstr "To drzewo ma twarz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_ROOT"
msgid "Ah. A chance to grow something horrible."
msgstr "Ach. Szansa na wyhodowanie czegoś okropnego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Just days away from dreadful."
msgstr "Ledwie dni dzielą cię od pełnej okropności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.BURNING"
msgid "Well. That was fun while it lasted."
msgstr "Cóż. Było fajnie, ale się skończyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.GENERIC"
msgid "It's a piece of wood. What more is there to say?"
msgstr "Kawałek drewna. Co tu więcej gadać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Gold's gold as far as I'm concerned."
msgstr "Złoto jak złoto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCY"
msgid "Ah. How have you been, Lucy?"
msgstr "Ach. Gdzie też się podziewałaś, Lucy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUMPY_SAPLING"
msgid "Where did this appear from?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANT"
msgid "A vicious plant."
msgstr "Złośliwa roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I can use this to my advantage."
msgstr "Chyba mógłbym ją jakoś wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MADSCIENCE_LAB"
msgid "How maddening."
msgstr "Oszaleć można."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALE_PUPPET"
msgid "Better him than me."
msgstr "Lepiej on niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE"
msgid "My ears are still ringing."
msgstr "W uszach wciąż mi dzwoni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKESOUP"
msgid "There'll be no more crying out of you."
msgstr "Koniec tego darcia papy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Oh shut UP, will you?"
msgstr "Może się już zamkniesz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_COOKED"
msgid "Looks like I got the last meep."
msgstr "Już się więcej nie odezwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_PLANTED"
msgid "What a disturbing root."
msgstr "Co za wnerwiający korzeń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANRABBIT_TAIL"
msgid "Silly rabbit."
msgstr "Głupi królik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAPSCROLL"
msgid "There's nothing to be gleaned from this."
msgstr "Nic się z tego nie dowiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLE"
msgid "It's strong stuff."
msgstr "Wytrzymałe to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN"
msgid "Let me guess, it grows a marble stalk?"
msgstr "Niech zgadnę – wyrasta z niej marmurowa łodyga?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "Stone cold growth."
msgstr "Zimna jak głaz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEPILLAR"
msgid "I've always wondered who built those."
msgstr "Zawsze się zastanawiałem, kto to zbudował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLESHRUB"
msgid "I've found a shrubbery."
msgstr "Dobrze, że nie ma kolców."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLETREE"
msgid "How whimsical."
msgstr "Ale dziwne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNING"
msgid "I should ask it questions."
msgstr "Powinienem zadawać mu pytania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "It's twisted and prickly, just like me!"
msgstr "Pokręcony i ostry. Zupełnie jak ja!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.PICKED"
msgid "That was painful."
msgstr "To bolało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_PLANT"
msgid "What a generic little plant."
msgstr "Zupełnie zwyczajna roślinka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNING"
msgid "There it goes."
msgstr "I po drzewie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNT"
msgid "It's no use to anyone now."
msgstr "Teraz już się nikomu nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Tree 0, Maxwell 1."
msgstr "Drzewo 0, Maxwell 1."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A tree with a foul demeanor."
msgstr "Niegrzeczne drzewo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL"
msgid "Looking good!"
msgstr "Przystojniak!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD"
msgid "Hey, handsome."
msgstr "Hej, przystojniaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT"
msgid "Aw, it remembers me."
msgstr "Ach, pamięta mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK"
msgid "It keeps the master in the chair."
msgstr "Trzyma mistrza na jego miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "That accursed thing!"
msgstr "Przeklęte pudło!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE"
msgid "It's less painful than it looks. Barely."
msgstr "Jest mniej bolesny, niż wygląda. Ale tylko odrobinę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT"
msgid "I'm used to much finer fare."
msgstr "Przywykłem do trochę większych porcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS"
msgid "My compliments to the chef!"
msgstr "Wyrazy uznania dla kucharza!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT"
msgid "It's too brittle to hang meat on now."
msgstr "Trochę za krucha, żeby powiesić na niej mięso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE"
msgid "Like the desert."
msgstr "Lepsze niż deser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING"
msgid "Still moist."
msgstr "Jeszcze wilgotne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Moist and staying that way."
msgstr "Jest wilgotne i na razie takie zostanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC"
msgid "It can dry meats so they'll last longer."
msgstr "Można suszyć tu mięso, dzięki czemu na dłużej pozostanie przydatne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM"
msgid "They were already here when I arrived."
msgstr "Byli tu, gdy się tu znalazłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.BURNT"
msgid "Roasted merm head. Delicious."
msgstr "Pieczona głowa merma. Pychota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.GENERIC"
msgid "The eyes follow you around."
msgstr "Ciężko się uwolnić od ich wzroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.BURNT"
msgid "Well, it burns just as well as the pigs' version."
msgstr "Pali się podobnie do chat prosiaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.GENERIC"
msgid "They copied the pigs, but they're even less intelligent."
msgstr "Starają się naśladować świnie, ale są jeszcze głupsi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINERHAT"
msgid "Eventually the firefly will starve."
msgstr "Świetliki kiedyś umrą z głodu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFAN"
msgid "This pathetic device... gets the job done."
msgstr "Żałosne ustrojstwo... Ale może być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.GENERIC"
msgid "It was drawn in a steady hand."
msgstr "Widać pewną rękę autora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.UNDRAWN"
msgid "There's nothing on it, currently."
msgstr "Nic tu jeszcze nie ma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN_ITEM"
msgid "A sign is useless if it has nothing to mark."
msgstr "Znak musi coś zaznaczać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAUR"
msgid "My my, the fuel has changed you."
msgstr "Proszę, proszę, paliwo zupełnie cię odmieniło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURCHEST"
msgid "It's almost like he's still alive."
msgstr "Czuję się, jakby wciąż żył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURHORN"
msgid "A regrettable end, my old friend."
msgstr "Smutny koniec, stary przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.ABOVEGROUND"
msgid "I'll take that as a \"yes\"."
msgstr "Rozumiem, że odpowiedź brzmi „tak”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.HELD"
msgid "End of the line."
msgstr "Koniec tego grzebania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.UNDERGROUND"
msgid "Are you picking up what I'm putting down? Do you dig it?"
msgstr "Wykopujesz to, co ja zakopię?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHAT"
msgid "No wonder they can dig for hours."
msgstr "Nic dziwnego, że potrafią kopać godzinami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHILL"
msgid "Burrow deep, I'm coming for you."
msgstr "Skryj się głęboko. Idę po ciebie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEY"
msgid "I don't have time for you!"
msgstr "Nie mam czasu na wygłupy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEYBARREL"
msgid "What a disgusting home."
msgstr "Ale paskudne mieszkanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERLASAGNA"
msgid "It would be unwise to ingest this."
msgstr "Włożenie tego do ust nie byłoby rozsądne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT"
msgid "How revolting."
msgstr "Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.BROKEN"
msgid "Ruins of an ancient relic."
msgstr "Pozostałość po pradawnym relikcie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.GENERIC"
msgid "I had thought these all destroyed eons ago."
msgstr "Myślałem, że wszystkie zostały zniszczone już wieku temu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The staff is powered by the \"moon's\" energy."
msgstr "Kostur czerpiący energię z „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.STAFFED"
msgid "Something magic-y needs to happen, I think."
msgstr "Chyba powinna wydarzyć się coś magicznego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Waste of a good staff."
msgstr "Szkoda dobrego kostura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.CAVE"
msgid "The cave provides sanctuary from the \"moon's\" prying eyes."
msgstr "Jaskinia zapewnia schronienie przed wścibskimi oczami „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.GENERIC"
msgid "The gem conjures water springs in conjunction with the \"moon's\" cycles."
msgstr "Klejnot korzysta z energii strumieni i cykli „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "The \"moon\" is full in the sky."
msgstr "„Księżyc” jest dziś w pełni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "The... \"moon\"... has retreated for now."
msgstr "„Księżyc”... na razie się schował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The \"moon\" is on the wane."
msgstr "„Księżyc” się zmniejsza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The \"moon\" is waxing."
msgstr "„Księżyc „się powiększa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKCRATER"
msgid "This will make a decent magical vessel."
msgstr "Będzie z niego doskonały nośnik magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKIDOL"
msgid "They always need an offering."
msgstr "Zawsze potrzebna jest jakaś ofiara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKNUGGET"
msgid "\"Moon\" rock."
msgstr "Kawałek „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKSEED"
msgid "Oooh, some new knowledge."
msgstr "Oooch, nowa wiedza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCK_PIECES"
msgid "This might be bad."
msgstr "To się może źle skończyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE"
msgid "It's definitely from the North, whatever that is."
msgstr "Ma północny rodowód, cokolwiek to jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSEEGG"
msgid "Ride the lightning, you big egg."
msgstr "Elektryzujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.GENERIC"
msgid "Bloody bloodsucking bloodsuckers."
msgstr "Przeklęci krwiopijcy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.HELD"
msgid "I got him."
msgstr "Mam go!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITOSACK"
msgid "A bloody sack. With blood in it."
msgstr "Krwawy pęcherz. Pełen krwi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSSLING"
msgid "That's a fluffy... thing."
msgstr "Puchate... coś."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.DUG"
msgid "That one's already been done in."
msgstr "Nic tu się więcej nie da zrobić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.GENERIC"
msgid "What lies beneath?"
msgstr "Cóż się tam kryje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Always did have a flair for the dramatic..."
msgstr "Zawsze uwielbiałem dramatyzm..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "A bit ominous looking."
msgstr "Nieco złowieszczo wygląda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "The duality of mine."
msgstr "Ach. Dwoistość rzeczy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMBOMB"
msgid "It's gonna blow!"
msgstr "Zaraz wybuchnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMHAT"
msgid "It possesses a spritely magic."
msgstr "Jest przepełniony zarodnikową magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Singing it released the toxic cloud!"
msgstr "Uwolniła się jakaś toksyczna chmura!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "I don't like how much magic is collecting in that."
msgstr "Nie podoba mi się ilość magii, która się w tym gromadzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Only ash and ruin remain here."
msgstr "Został jedynie popiół i szczątki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Smells... \"piney\"."
msgstr "Śmierdzi jakoś tak... iglaście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "The mushrooms have really taken to the log."
msgstr "Grzybki nie próżnowały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Rotten, all the way through. I relate."
msgstr "Przegniła na wskroś. Wiem coś o tym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Nothing grows in these frigid wastes."
msgstr "Nic nie urośnie na tym mroźnym pustkowiu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "They seem to be doing well."
msgstr "Chyba nieźle sobie radzą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "It's so full it's almost obscene."
msgstr "Jest tak pełna, że to aż nieprzyzwoite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "C'est la vie."
msgstr "C'est la vie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "I suppose we're decorating with fungus now."
msgstr "Grzyby są teraz trendy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "A rather pale light."
msgstr "Trochę słabe to światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Who ordered the mushroom flambe?"
msgstr "Ktoś zamawiał pieczone grzyby?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I'm partial to the lavender shade, myself."
msgstr "Wolę odcienie lawendy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "A light to repel the encroaching shadow."
msgstr "Światło, które odegna skradający się mrok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "I hope I'm not standing next to it when it goes off."
msgstr "Mam nadzieję, że będę daleko, gdy wybuchnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Where's Waldo?"
msgstr "Gdzie jest Wally?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Oh fine, do what you like."
msgstr "Cokolwiek. Rób, co chcesz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Ugh, it smells bad."
msgstr "Ugh. Nie pachnie zbyt dobrze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "It's spawning."
msgstr "Mnoży zarodniki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "It smells of rot and failure."
msgstr "Śmierdzi zgnilizną i porażką."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "Could it get any less appealing?"
msgstr "Czy mogłoby wyglądać choć trochę mniej nieprzyjaźnie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTLIGHT"
msgid "It burns with a beautiful glow."
msgstr "Tworzy piękną poświatę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREFUEL"
msgid "Ahhh. Refreshing."
msgstr "Aaach. Odświeżające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARELIGHT"
msgid "The overuse of fuel was their downfall."
msgstr "Ich największą wadą było duże zapotrzebowanie na paliwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "The heart of the city is still."
msgstr "Serce miasta jest spokojne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "It calms once more."
msgstr "Znów się uspokaja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The pulse has no influence here."
msgstr "Puls nie ma wpływu na to miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The pulse is holding steady."
msgstr "Puls jest wyrównany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "The pulse is waning."
msgstr "Puls słabnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It beats once again."
msgstr "Znów zaczyna bić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The pulse is quickening."
msgstr "Puls zaczyna rosnąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSTICK"
msgid "Good morning."
msgstr "Dzień dobry."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSWORD"
msgid "Snicker-snack!"
msgstr "Na pohybel draniom!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NITRE"
msgid "One third of the way there..."
msgstr "Brakuje jeszcze dwóch składników..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE"
msgid "Didn't think I'd ever come back here."
msgstr "Nie myślałem, że kiedykolwiek tu wrócę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONEMANBAND"
msgid "It has a good beat, and you can dance to it."
msgstr "Dobry bit! Zapraszam do tańca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALPRECIOUSGEM"
msgid "A sizable magic gem."
msgstr "Całkiem sporawy klejnot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALSTAFF"
msgid "The charge has made it incredibly powerful."
msgstr "Ładunek sprawił, że jest niezwykle potężny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEAMULET"
msgid "Simple magic is often the best."
msgstr "Prosta magia często najlepiej zdaje egzamin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEGEM"
msgid "This will be quite powerful with some fuel."
msgstr "Odrobina paliwa i będzie naprawdę potężny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEMOONEYE"
msgid "I have a feeling of being watched, even from a considerable distance away."
msgstr "Czuję, że coś mnie obserwuje, i to nawet z bardzo daleka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGESTAFF"
msgid "It's a focusing tool."
msgstr "Służy do skupiania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANDORASCHEST"
msgid "It's a trap."
msgstr "To pułapka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANFLUTE"
msgid "I'm going to sing a song of madness."
msgstr "Zaniosę pieśń szaleństwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAPYRUS"
msgid "A blank canvas."
msgstr "Czyste płótno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEGHOOK"
msgid "I should like to avoid a pinch from that, I think."
msgstr "Lepiej będzie chyba, jeśli będę trzymał się z dala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PENGUIN"
msgid "Nice tux."
msgstr "Niezgorszy smoking."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERD"
msgid "It is addicted to fermented berries."
msgstr "Jest uzależniony od sfermentowanych porzeczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDFAN"
msgid "Now I'll have no problem keeping my cool."
msgstr "Teraz upały mi nie straszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.BURNT"
msgid "It's no use to anyone now."
msgstr "Teraz już się nikomu nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Something else seems to be required."
msgstr "Chyba trzeba tu czegoś jeszcze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.GENERIC"
msgid "It seems my fortune's changing."
msgstr "Mój los zdaje się odmieniać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEROGIES"
msgid "They look superb."
msgstr "Smakowicie się prezentują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS"
msgid "I've a habit of destroying beautiful things, don't I?"
msgstr "Mam chyba nawyk niszczenia ładnych rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS_EVIL"
msgid "It's dripping with nightmare essence."
msgstr "Aż spływa z nich esencja koszmaru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETRIFIED_TREE"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PHLEGM"
msgid "I need to put on gloves for this."
msgstr "Potrzebne mi będę do tego rękawiczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKAXE"
msgid "Everybody loves a little mining."
msgstr "Każdy lubi czasem trochę pokopać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE1"
msgid "He's a slippery fellow."
msgstr "Śliski typ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE2"
msgid "A fiery one."
msgstr "Jakiś taki zapalczywy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE3"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE4"
msgid "Rotten to the core."
msgstr "Skażony do cna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGUARD"
msgid "Blech. Disgusting brute."
msgstr "Bleee. Odrażający typ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGYBACK"
msgid "Oh, that's just demeaning."
msgstr "Poniżające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.BURNT"
msgid "Pig roast!"
msgstr "Pieczona wieprzowina!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.GENERIC"
msgid "Er... charming."
msgstr "Eee... urocze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.BURNT"
msgid "Let's see you hide in there now."
msgstr "Zobaczmy, czy teraz się schowasz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.FULL"
msgid "I'd go inside too, if I was him."
msgstr "Też bym się schował, gdybym był na jego miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.GENERIC"
msgid "It is not a sound structure."
msgstr "Nie imponuje odpornością."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "I'll huff and I'll puff!"
msgstr "Będę chuchał i dmuchał!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGKING"
msgid "That's a man with his priorities in order!"
msgstr "Ten to się umie ustawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.DEAD"
msgid "I dub thee, \"Bacon\"."
msgstr "Nazwę cię „Bekon”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.FOLLOWER"
msgid "He's simple, but he's mine."
msgstr "Jest prymitywny, ale jest mój."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GENERIC"
msgid "What a slobbering fool."
msgstr "Co za uśliniony głupiec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GUARD"
msgid "They're starting to organize."
msgstr "Zaczynają się organizować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.WEREPIG"
msgid "That one's gone feral."
msgstr "Ten trochę zdziczał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.BURNT"
msgid "Not useful like this."
msgstr "Na nic nie przyda się w tym stanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs some kind of meat."
msgstr "Potrzeba tu jakiegoś mięsa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.GENERIC"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSKIN"
msgid "It was him or me."
msgstr "Albo on, albo ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTENT"
msgid "That's just nasty."
msgstr "Okropieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTORCH"
msgid "Great. Now they have fire."
msgstr "Świetnie. Teraz maja ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_TOKEN"
msgid "Those pigs are getting more and more clever."
msgstr "Te świnie stają się coraz bardziej przebiegłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Ktoś bardziej miłujący przyrodę może byłby w stanie do czegoś ją wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Hmm, wygląda na to, że powinna być w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PITCHFORK"
msgid "The tool of choice for perfectionists."
msgstr "Narzędzie perfekcjonisty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT"
msgid "A feeble attempt to trick the weak minded."
msgstr "Marna próba oszukania mniej wprawnego umysłu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT_COOKED"
msgid "The heat has made this a suitable meal."
msgstr "Ciepło sprawiło, że nada się do spożycia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "That is a generic plant."
msgstr "Zupełnie zwyczajna roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It's growing."
msgstr "Jeszcze rośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.READY"
msgid "It's ready."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It wasn't hardy enough for the heat."
msgstr "Upał zwyciężył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.ATTACKER"
msgid "%s seems untrustworthy..."
msgstr "%s to chyba nie jest ktoś, komu można zaufać..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s has been lighting fires."
msgstr "%s sporo tu podpala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GENERIC"
msgid "Greetings, %s."
msgstr "Witaj, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GHOST"
msgid "%s needs heart-shaped assistance."
msgstr "%s cierpi na niedobór serca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.MURDERER"
msgid "Murderous fiend! I'll stop at nothing!"
msgstr "Złowrogi morderca! Dopadnę cię!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.REVIVER"
msgid "%s tethers lost spirits to this world."
msgstr "%s przywołuje zagubione dusze na powrót do świata żywych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE"
msgid "Usually I'd get someone to seed this for me."
msgstr "Normalnie dałbym go komuś, żeby mi wydłubał nasiona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND"
msgid "I can see my face reflected off the top."
msgstr "Widzę swoje odbicie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND_ALGAE"
msgid "It's some algae."
msgstr "Jakieś algi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POOP"
msgid "It's the way of all mortal life."
msgstr "Takie są uroki życia śmiertelników."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTTEDFERN"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POWCAKE"
msgid "What foul manifestation of evil is this?"
msgstr "Zło przybiera najróżniejsze formy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN"
msgid "Hallowe'en was always my favorite."
msgstr "Zawsze uwielbiałem Halloween."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINCOOKIE"
msgid "It's been eons since I had a good biscuit."
msgstr "Wieki minęły, od kiedy jadłem dobre ciastko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_LANTERN"
msgid "Why hello, Mr. Crane."
msgstr "Witam pana, panie dynio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEAMULET"
msgid "It speaks with the shadow."
msgstr "Pozwala rozmawiać z krainą cienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEGEM"
msgid "Purple brings great power."
msgstr "Fiolet jest źródłem potężnej mocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEMOONEYE"
msgid "A decent enough use of the gem's power, I suppose."
msgstr "Całkiem sensowne wykorzystanie potęgi klejnotu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "I'm not sure how it draws magic from this."
msgstr "Nie wiem, skąd bierze magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Best offer it something if we enjoy living."
msgstr "Najlepiej złożyć w ofierze coś, co chcemy, aby żyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "It's a post."
msgstr "To słupek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Creeping ivy."
msgstr "Bluszcz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A bit excessive..."
msgstr "Trochę za mocne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "I do like a good statue."
msgstr "Nie ma to jak dobra statua."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Misdirected dedication."
msgstr "Niewłaściwie ukierunkowane poświęcenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "It's seen better days."
msgstr "Nie jest w najlepszej formie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those are never growing back."
msgstr "Już nigdy nie odrosną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Refined dishware."
msgstr "Wyrafinowane nakrycie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "Homey."
msgstr "Jak w domu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "A tiny bit of domestication."
msgstr "Niewielka porcja nostalgii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN1"
msgid "Well, well, well..."
msgstr "Proszę, proszę, proszę..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN2"
msgid "I'll have use for this."
msgstr "Wiem, jak tego użyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN3"
msgid "On my way up in the world."
msgstr "Pnę się w górę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN4"
msgid "We may wyrm our way out of this predicament yet."
msgstr "Może jeszcze da się okupić jakoś przetrwanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Ah, how refined."
msgstr "Ach, jakże wykwintne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Perfect with a bit of butter."
msgstr "Doskonałe z odrobiną masła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Dinner should be arriving any moment."
msgstr "Kolacja powinna być gotowa za moment."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FERN"
msgid "Perhaps it has some flavor to it."
msgstr "Być może nieźle smakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I suppose one could make baked goods with this."
msgstr "Chyba może posłużyć do wypieków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "I ought to mix it in with something else."
msgstr "Muszę to z czymś wymieszać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's see how the wyrm likes this."
msgstr "Zobaczmy, co powie na to głodna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This is exactly what the wyrm wants."
msgstr "Oto, czego życzy sobie głodna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Well, I suppose it will tide the wyrm over."
msgstr "Cóż, miejmy nadzieję, że głodna bestia tym nie wzgardzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Nope. It won't eat that."
msgstr "Nie. To się nie nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "I didn't cook that one."
msgstr "To nie moja wina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Zakładam, że to dlatego nie ma tu żadnych wampirów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Ciekawe, czy nadal ma moc odpędzania umarłych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATKID"
msgid "He has no future ahead of him. A shame."
msgstr "Nie ma dlań przyszłości. Co za szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "My bones are naturally fragile, I'm afraid."
msgstr "Obawiam się, że moje kości są z natury łamliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "May I peruse your wares, ma'am?"
msgstr "Czy mogę tak przejrzeć pani towary?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL"
msgid "I believe I can barbeque."
msgstr "Sądzę, że potrafię grillować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "No use to me here."
msgstr "Nie ma tu zeń pożytku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "I'd prefer a larger grill."
msgstr "Wolę większe grille."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "At least it's portable."
msgstr "Przynajmniej jest przenośny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_HOE"
msgid "This is so very beneath me."
msgstr "To naprawdę poniżej mojego poziomu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY"
msgid "And they thought their things were safe."
msgstr "A myśleli, że ich rzeczy są bezpieczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "This should open some doors."
msgstr "To powinno otworzyć kilka drzwi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "A touch of civility."
msgstr "Odrobina kultury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "A little civility."
msgstr "Odrobina kultury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "This looks like it requires hard labor."
msgstr "Wygląda, jakby wymagał ciężkiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "The stinking abode of those filthy fish creatures."
msgstr "Obleśne domostwo obmierzłych rybo-stworzeń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Let's see what they have today."
msgstr "Zobaczmy, co dziś tu mamy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Well what do we have here?"
msgstr "Co my tu mamy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Fungus has its uses."
msgstr "Grzyb ma swoje zastosowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "I could, perhaps, produce a makeshift garnish."
msgstr "Mógłbym zmajstrować zeń szybkie przybranie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "It's as hollow as this withered world."
msgstr "Nie ma tu nic ciekawego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION"
msgid "It's a pungent onion."
msgstr "Śmierdząca cebula."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Take that, onion."
msgstr "A masz, cebulo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN"
msgid "This makes things much more convenient."
msgstr "To wiele ułatwia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "It's an oven. For cooking."
msgstr "To piecyk. Do gotowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Spikey. Like me."
msgstr "Ma ostre końce. Jak ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Some kind of gargoyle."
msgstr "To jakiś gargulec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Well that's attractive."
msgstr "Bardzo uroczy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Just useless rubble now."
msgstr "Bezużyteczna sterta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Seems we've got it open."
msgstr "Stoi otworem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It needs a key."
msgstr "Wymaga klucza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's a monument to death."
msgstr "Monument ku czci śmierci."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Yes yes, ashes to ashes and all that."
msgstr "Tak, tak. Z prochu w proch i tak dalej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "You can't hide from me."
msgstr "Nie uciekniesz przede mną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It is no more."
msgstr "Było i nie ma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "How are birds getting in here?"
msgstr "Jak te ptaki się tutaj dostają?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Fast asleep."
msgstr "Twardzo śpi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Suitable lavishness."
msgstr "Stosowny przepych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Brackish."
msgstr "Słonawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Nobody listens to me."
msgstr "Nikt mnie nie słucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Good. I can get out of here."
msgstr "Dobrze. Mogę się stąd wydostać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT"
msgid "Magic could bring it to a boil faster, you know."
msgstr "Magia mogłaby sprawić, że szybciej by się zagotowało. Tylko mówię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO"
msgid "It is in the nightshade family, you know."
msgstr "Należy do rodziny psiankowatych. Warto wiedzieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "The potato may be eaten now."
msgstr "Ziemniak może zostać skonsumowany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "I can put this to good use."
msgstr "Może być zeń pożytek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Well I'M not setting it up."
msgstr "No cóż, JA nie będe tego rozstawiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "I shalln't let it speak with the kettle."
msgstr "Nie pozwolę, aby przyganiał kotłowi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "I need to sweeten the pot."
msgstr "Czas tu trochę osłodzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Foul."
msgstr "Paskudztwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "A bicycle built askew."
msgstr "Rower nędznej roboty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Carriage carnage."
msgstr "Kraksa karocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "They didn't pray hard enough."
msgstr "Nie modlili się dość żarliwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Something has happened here."
msgstr "Coś tu zaszło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Nobody has kept up with repairs."
msgstr "Nikt tu nic nie naprawiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Time's up."
msgstr "Czas minął."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "A late clocktower."
msgstr "Spóźnia się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "No one's living there anymore."
msgstr "Nikt już tu nie mieszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Such destruction."
msgstr "Co za zniszczenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Nothing like the decline of a civilization."
msgstr "Nie ma to jak upadek cywilizacji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "If only it lead somewhere."
msgstr "Gdyby jeszcze gdzieś tak wiodły..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It's no longer over anyone's head."
msgstr "Już nikt pod nim nie mieszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Now for some expert-level rummaging."
msgstr "Czas zabrać się za szperanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I cannot open it."
msgstr "Nie mogę go otworzyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON"
msgid "Foul smelling, but delicious."
msgstr "Śmierdzi okrutnie, ale jest pyszny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "I do enjoy a good smoked salmon."
msgstr "Przepadam za wędzonym łososiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT"
msgid "Adding too much is an a-salt on the senses."
msgstr "Lepiej nie przesolić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It must be ground down before we use it."
msgstr "Trzeba ją wpierw zetrzeć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Any method to improve the food around here is welcome."
msgstr "Każdy sposób na ulepszenie lokalnej żywności jest wart wypróbowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Ah. It's ready."
msgstr "Ach. Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "Just useless sticks until we assemble it."
msgstr "Do chwili, gdy nie zostaną zmotnowane, to jedynie sterta patyków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP"
msgid "I would rather not get that on my gloves."
msgstr "Wolałbym nie uwalać sobie rękawic."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's already sticky."
msgstr "Już się lepi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I don't have time to watch twigs grow."
msgstr "Nie mam czasu patrzeć, jak rosną gałązki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Bittersweet."
msgstr "Słodko-gorzki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Instruments of toil."
msgstr "Element ciężkiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't mind getting my hands dirty with this."
msgstr "Nie mam nic przeciwko temu, aby pobrudzić sobie ręce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spicy."
msgstr "Ostre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Aromatic."
msgstr "Aromatyczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back anytime soon."
msgstr "Nie odrośnie zbyt szybko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "That will spice things up."
msgstr "To powinno dodać nieco smaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "A sickly sweet aroma wafts from its branches."
msgstr "Jego gałązki rozsiewają słodki zapach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It won't produce sap now."
msgstr "Nie ma co liczyć teraz na żywicę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Well it's ruined now."
msgstr "No cóż. Już się nie uratuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It is filling. Ever so slowly."
msgstr "Napełnia się. Kropla po kropli."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "The sap is ready for collection."
msgstr "Żywica gotowa do zebrania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "This tree has seen better days."
msgstr "To drzewo pamięta lepsze dni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Don't touch the suit."
msgstr "Nie pognieć mi garnituru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Charmed, I'm sure."
msgstr "Mi też jest bardzo miło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Fast asleep."
msgstr "Twardzo śpi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It could use renovations."
msgstr "Przydałby się tu remont."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "It's been a long time since this stood properly."
msgstr "Już od dawna nie stoi prosto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Cooking syrup. Of course."
msgstr "Syrop do gotowania. Oczywiście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's a red, red tomato."
msgstr "Czerwony. Czerwony jak pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It's a red, red roasted tomato."
msgstr "To czerwony, smażony pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Good day to you, sir."
msgstr "Dzień dobry panu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "I tip my hat to you sir."
msgstr "Kłaniam się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a big, bulbous turnip."
msgstr "Wielka, nabrzmiała rzepa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Hardly improves the taste."
msgstr "Wciąż podle smakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT"
msgid "This would be more useful as flour."
msgstr "Chyba lepiej przerobić je na mąkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam je posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC"
msgid "I've been here too long... it actually looks tasty."
msgstr "Za długo tu jestem.... Wyglądają nawet smacznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD"
msgid "Don't worry, rabbit. Everything is under control."
msgstr "Nie martw się, króliczku. Wszystko pod kontrolą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC"
msgid "There's a world going on under there."
msgstr "To jak wejście do nowego świata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING"
msgid "The entrance has collapsed in on itself."
msgstr "Wejście samo się zapadło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Cleverness killed the carrot."
msgstr "Spryt zgładził marchewkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Oh, isn't that clever."
msgstr "Och, bardzo sprytne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT"
msgid "Out, out rain!"
msgstr "Precz! Precz, deszczu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT"
msgid "Not the most dapper of hats, but quite necessary."
msgstr "Może nie najwytworniejszy, ale nie można się bez niego obyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT"
msgid "The rain did not come in time."
msgstr "Deszcz nie nadszedł na czas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC"
msgid "I could just look up and learn the same thing."
msgstr "Wystarczy spojrzeć w górę, żeby stwierdzić to samo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE"
msgid "Roughage."
msgstr "Kto wymyśla te nazwy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR"
msgid "If only the world had a single neck."
msgstr "Gdybyż tylko świat miał szyję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM"
msgid "Red brings fire."
msgstr "Czerwień zwiastuje ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN"
msgid "Not having a light would certainly be unlucky."
msgstr "Bez światła byłaby bieda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE"
msgid "Its aura can be felt from anywhere. Quite useful."
msgstr "Jego aurę da się wyczuć wszędzie. Użyteczna rzecz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH"
msgid "A spot of luck."
msgstr "Miejsce pełne szczęścia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP"
msgid "I forget what this one does."
msgstr "Zawsze zapominam, który jak działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED"
msgid "Kind of bitter."
msgstr "Trochę gorzki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a red mushroom."
msgstr "Czerwony grzyb."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It'll have to come back for it."
msgstr "Będę musiał po niego wrócić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "It's all used up."
msgstr "Zupełnie zużyty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC"
msgid "There's wind in them there willows."
msgstr "Pamiętasz miła, tę noc w tataraku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED"
msgid "No more tubes."
msgstr "Użyteczne rurki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST"
msgid "Safety before dapperness."
msgstr "Bezpieczeństwo ponad elegancję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC"
msgid "Remnants of an extinct civilization."
msgstr "Pozostałości po starożytnej cywilizacji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT"
msgid "The fire learned how to burn it down."
msgstr "Ogień nauczył się, jak puścić ją z dymem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I can't believe I forgot how to build those things."
msgstr "Nie mogę wręcz uwierzyć, że zapomniałem, jak to wszystko zbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Flames have swallowed it whole."
msgstr "Ogień go pochłonął."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "It unlocks recipes of middling utility."
msgstr "Odblokowuje receptury o średniej przydatności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Research complete."
msgstr "Badanie zakończone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "This is where I do my own personal research."
msgstr "Tutaj prowadzę swoje badania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "That was its final act."
msgstr "To już koniec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Quite a dapper machine."
msgstr "Całkiem elegancka maszyna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "No one will be using that any longer."
msgstr "Nikt już więcej z ciebie nie skorzysta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "I'm not above using this."
msgstr "Mógłbym tego użyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE"
msgid "There's a story behind that..."
msgstr "Do dłuższa historia..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER"
msgid "I'm not sure I really want to give this up."
msgstr "Nie jestem pewien, czy jestem gotów przestać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL"
msgid "Brutish grotesquerie."
msgstr "Brutalistyczna groteska."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC"
msgid "The redbird comes from the fire lands."
msgstr "Kardynały pochodzą z ognistych krain."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD"
msgid "Silence, bird!"
msgstr "Cisza, ptaku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "You're new."
msgstr "My się chyba nie znamy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Nothing up my sleeve..."
msgstr "Nie wiem, co powiedzieć..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET"
msgid "Better them than me."
msgstr "Lepiej on, aniżeli ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK"
msgid "It's a rock."
msgstr "Kamień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS"
msgid "Hmmm. Now what do I do with them?"
msgstr "Hmm. I co mam z nimi zrobić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY"
msgid "I banished these guys down here for a reason."
msgstr "Nie bez powodu umieściłem je w tym miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC"
msgid "I could get a chip of ice off the old block."
msgstr "Ofiara efektu cieplarnianego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED"
msgid "It's just a puddle."
msgstr "Zwykła kałuża."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED"
msgid "It's just a puddle."
msgstr "Zwykła kałuża."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The top of this lava pit has cooled into a fine crust."
msgstr "Powierzchnia wystygła, tworząc równą skorupę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The fires are cooling."
msgstr "Te płomienie zdają się być chłodne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "It's hot."
msgstr "Gorące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks harmless."
msgstr "Wygląda niegroźnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON"
msgid "\"Moon\" rock."
msgstr "Kawałek „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK"
msgid "A castle for my home."
msgstr "Kawałek zamku. Mógłbym w nim zamieszkać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE"
msgid "The builders have left it in a state of abandonment."
msgstr "Budowniczy zostawili ją tu na pastwę koszmarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE"
msgid "You'd think this would have more uses."
msgstr "Spodziewałbym się, że będzie miała więcej zastosowań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG"
msgid "Disgusting. Why keep this around?"
msgstr "Obrzydliwość? Po co to trzymać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY"
msgid "Unsettlingly wobbly."
msgstr "Strasznie się trzęsie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE"
msgid "Everything eventually turns to dust."
msgstr "Wszystko obraca się z czasem w pył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT"
msgid "Fuel must flow."
msgstr "Coś w sam raz dla mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT"
msgid "The fuel runs deep in this."
msgstr "Paliwo jest w nim silne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE"
msgid "A broken relic."
msgstr "Zepsuty relikt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "A relic best forgotten."
msgstr "Relikt, o którym najlepiej będzie zapomnieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It seems I am to be judged."
msgstr "Zdaje się, iż jestem oceniany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN"
msgid "And I may never put it back on."
msgstr "I już nigdy więcej go nie założę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC"
msgid "But that means I'd have to touch the smelly thing."
msgstr "Ale to by znaczyło, że musiałbym się babrać z tą śmierdzącą bestią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE"
msgid "But is it fast enough to escape the judgmental stares?"
msgstr "Ale czy jest dość szybkie, by umknąć przed oskarżycielskimi spojrzeniami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR"
msgid "At least it affords some dignity to the rider."
msgstr "Zapewnia swemu użytkownikowi choć odrobinę godności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK"
msgid "So salty."
msgstr "Ale słone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK"
msgid "Impressive."
msgstr "Imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE"
msgid "That was quite impolite."
msgstr "Było to raczej nieeleganckie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I can see its true nature now!"
msgstr "Teraz dostrzegam jego prawdziwą naturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE"
msgid "There are two ways to see that obstacle."
msgstr "Są dwa sposoby patrzenia na tą przeszkodę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC"
msgid "A supple, woody stem."
msgstr "Miękka, drewniana łodyżka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED"
msgid "It'll grow back."
msgstr "Odrośnie"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED"
msgid "Nothing survives in this heat."
msgstr "Nic nie przetrwa w tym upale."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING"
msgid "Nothing is safe."
msgstr "Nikt nie jest bezpieczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow has gone to a place where there is no fear."
msgstr "Udał się do miejsca, gdzie strach nie istnieje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC"
msgid "It's an empty shell of a man."
msgstr "Pusta skorupa człowieka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON"
msgid "At least the fire cut down on the smell."
msgstr "Przynajmniej ogień zdusi nieco ten odór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "How I've missed the act of creation."
msgstr "Brakowało mi pracy stwórczej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "To sculpt, to carve, no more."
msgstr "Koniec rzeźbienia, koniec tworzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A block of marble might suffice."
msgstr "Kawałek marmuru powinien wystarczyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Ah, yes. Not terrible."
msgstr "Ach, tak.. Nie najgorzej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Hmph. I was never a fan of the Grecian look."
msgstr "Hmm. Greckie rysy nigdy mnie nie przekonywały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "That looks much better."
msgstr "Wygląda znacznie lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Come now! I liked that one."
msgstr "No proszę! Wygląda całkiem nieźle."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I've seen that head before... but never in marble."
msgstr "Widziałem już kiedyś tę głowę... ale nigdy w marmurze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Waste of good marble if you ask me."
msgstr "Moim zdaniem szkoda dobrego marmuru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Back as intended."
msgstr "No, tak jak miało być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "My creations! How rude."
msgstr "Moje dzieła! Ale toporne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That looks... familiar..."
msgstr "Wygląda jakoś... znajomo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Some truly questionable taste in decor."
msgstr "Ktoś ma bardzo dziwny gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Doesn't that feel better now?"
msgstr "Tak chyba lepiej, co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Why would anyone want to cover this up?"
msgstr "Dlaczego ktoś chciałbym to zakrywać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "That's quite the schnozz."
msgstr "Ale kinol!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS"
msgid "I suppose these won't plant themselves."
msgstr "Same się pewnie nie zasieją."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED"
msgid "Broiled the life out of 'em."
msgstr "Wygotowałem z nich wszelkie życie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD"
msgid "This is a conduit for strong revelatory magicks."
msgstr "To przekaźnik silnej, nowatorskiej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT"
msgid "A fine and noble endeavor."
msgstr "Zaprawdę szlachetna czynność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE"
msgid "The wilderness is tough on a tailor made suit."
msgstr "Dzikie odstępy nie pomagają elegancji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER"
msgid "I'm a shadow of myself. Ha-ha!"
msgstr "Jestem cieniem samego siebie. Ha-ha!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART"
msgid "A pulse of malice and betrayal beats within."
msgstr "Wewnątrz słychać puls zła i zdrady."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL"
msgid "This is some real advanced technology."
msgstr "To jakaś zaawansowana technologia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN"
msgid "I hope the warts are not contagious."
msgstr "Mam nadzieję, że te brodawki nie są zaraźliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT"
msgid "So much for the shade thing."
msgstr "No i nie ma cienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Rustic, but excellent shade."
msgstr "Trochę prymitywne wykonanie, ale działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK"
msgid "Despite its origin, it could make some fine garments."
msgstr "Pomimo parszywego pochodzenia może posłużyć do stworzenia naprawdę przyzwoitych ubrań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON"
msgid "Ha! I remember that one."
msgstr "Ha! Pamiętam go."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT"
msgid "A most tragic and unfitting end."
msgstr "Tragiczny i niestosowny kres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "A pity, %s. So ill-prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "A pity, %s. She was not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "A pity, %s. He was not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "A pity, %s. They were not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKETCH"
msgid "I'll need somewhere to sculpt it."
msgstr "Potrzebuję jakiegoś miejsca do rzeźbienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKULLCHEST"
msgid "That chest is calling to me."
msgstr "Ta skrzynia mnie wzywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLEEPBOMB"
msgid "It appears to be a sleeping bag."
msgstr "Jakby śpiwór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER"
msgid "Simple creatures. They exist only to sleep and feed."
msgstr "Prymitywne istoty. Żyją tylko po to, by jeść i spać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPERPELT"
msgid "In death, this creature will serve me!"
msgstr "Nawet po śmierci to stworzenie gotowe jest mi służyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER_PELT"
msgid "In death, this creature will serve me!"
msgstr "Nawet po śmierci to stworzenie gotowe jest mi służyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE"
msgid "I don't remember those..."
msgstr "Nie pamiętam ich..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHAT"
msgid "This will keep me standing, if I need to fight."
msgstr "Postawi mnie na nogi. Muszę walczyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHOLE"
msgid "That's revolting."
msgstr "Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLESLIME"
msgid "There must be a better way."
msgstr "Musi być jakiś lepszy sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Some cracks can't be mended."
msgstr "Niektóre rany nigdy się nie zabliźnią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.GENERIC"
msgid "What!? What do you want?"
msgstr "Co? Czego chcesz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You want some food?"
msgstr "Chcesz jeść?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.STARVING"
msgid "He's so hungry!"
msgstr "Jest strasznie głodny!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT"
msgid "This is barely a mouthful."
msgstr "Ledwo wystarczy na jednego gryza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAPPER"
msgid "I don't fear you, scoundrel."
msgstr "Nie lękam się ciebie, szujo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNURTLE"
msgid "That's strange. They must be new."
msgstr "Dziwne. Są chyba jakieś nowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPAT"
msgid "Ornery and tough as nails."
msgstr "Twarde i wytrzymałe zwierzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR"
msgid "It's a spear. Yup."
msgstr "Dzida składa się z przeddzidzia dzidy, śróddzidzia dzidy i zadzidzia dzidy. Przeddzidzie dzidy składa się z przeddzidzia przeddzidzia dzidy, śróddzidzia przeddzidzia dzidy i zadzidzia przeddzidzia dzidy. I tak dalej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_GUNGNIR"
msgid "I would never stoop to such things."
msgstr "Nie zniżyłbym się do takich działań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_LANCE"
msgid "How churlish."
msgstr "Jakież to prostackie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_WATHGRITHR"
msgid "I can appreciate a finely crafted weapon."
msgstr "Potrafię docenić solidny oręż."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.DEAD"
msgid "Splat."
msgstr "Pac."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.GENERIC"
msgid "It's mostly digestive system."
msgstr "W większości składa się z układu trawiennego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.SLEEPING"
msgid "Shhhh! It will wake up hungry."
msgstr "Ciii! Obudzi się głodny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERDEN"
msgid "They grow big here."
msgstr "Dobrze im tutaj."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDEREGGSACK"
msgid "Squishy."
msgstr "Ale mięciutkie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERGLAND"
msgid "Distasteful."
msgstr "Paskudztwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHAT"
msgid "Spiders have such malleable wills."
msgstr "Pająki mają tak łatwo formowalną wolę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE"
msgid "How did that get down here?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE_ROCK"
msgid "How did that get down here?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERQUEEN"
msgid "Maybe I'll just get out of her way."
msgstr "Może po prostu zejdę jej z drogi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_DROPPER"
msgid "Creatures in this world evolve at a terrifying rate."
msgstr "Stworzenia w tym świecie ewoluują w zastraszającym tempie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_HIDER"
msgid "It's a tricky one."
msgstr "Sprytny jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_SPITTER"
msgid "Aggressive little thing, isn't it?"
msgstr "Agresywny typ, co nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Splat."
msgstr "Pac."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "It's a specialized form."
msgstr "Wyspecjalizowany podgatunek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "I don't want to wake that one."
msgstr "Nie chcę go obudzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FOOD"
msgid "That used to be food until I wasted it."
msgstr "Kiedyś było jedzeniem, ale się sfilcowało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Magical red, and yet it holds no power of use to me."
msgstr "Ta magiczna czerwień jest tak intensywna, a jednak pozostaje dla mnie wciąż bezużyteczna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surdutu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "Hateful, ambulatory whimsy."
msgstr "Nienawistny, laboratoryjny kaprys."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surdutu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.GENERIC"
msgid "How can a seed be so cheerful?"
msgstr "Jakiż powód do zadowolenia może mieć nasiono?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surdutu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFCOLDLIGHT"
msgid "An impressively condensed point of freezing magic."
msgstr "Niesamowicie skoncentrowany ośrodek mroźnej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFLIGHT"
msgid "That should chase the shadows away."
msgstr "Teraz cienie powinny się stąd wynieść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFF_TORNADO"
msgid "Wind power."
msgstr "Potęga wiatru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.AWAKE"
msgid "Hmph. Impressive sleight of hand."
msgstr "Hmm. Ktoś tu ma dobrą rękę do wystroju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.HIDING"
msgid "This must be the work of an unseen hand."
msgstr "To sprawka jakiej niewidzialnej dłoni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE"
msgid "Rocks. How dull."
msgstr "Kamienie. Co za nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_TALL"
msgid "Stalagmite. How dull."
msgstr "Stalagmit. Co za nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER"
msgid "There is no limit to the power of shadows."
msgstr "Potęga cieni jest niezmierzona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_ATRIUM"
msgid "The Atrium's power restored his mind."
msgstr "Potęga serca przywróciła mu zmysły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_MINION"
msgid "A being of living fuel."
msgstr "Twór z żyjącego paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "The fewer statues the better, I say."
msgstr "Myślę, że im mniej pomników, tym lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "Thank goodness, I thought it was another wretched statue of me."
msgstr "Cóż za ulga. Bałem się to kolejny, przeklęty pomnik mojego imienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEHARP"
msgid "Not my best work."
msgstr "Jedno z moich mniej udanych dzieł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEMAXWELL"
msgid "It seems silly now..."
msgstr "Teraz zdaje się to takie śmieszne..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Hm. Stately."
msgstr "Hmm. Robi wrażenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Her tragedy does not define her."
msgstr "Jej tragedia nie stanowi o jej charakterze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "She's still in there somewhere. I know it."
msgstr "Wciąż gdzieś tam jest. Wiem to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEELWOOL"
msgid "Someone should use this to clean something."
msgstr "Można by nią coś wyczyścić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STINGER"
msgid "It's dripping with venom."
msgstr "Aż ocieka toksynami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STRAWHAT"
msgid "A hat fit for a peasant."
msgstr "Kapelusz godny wieśniaka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFEDEGGPLANT"
msgid "A meal fit for a king... or at least someone with a throne."
msgstr "Posiłek godny króla... A przynajmniej kogoś, kto ma tron."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PICKED"
msgid "It didn't put up much of a fight."
msgstr "Niezbyt chwacko się broniło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PLANT"
msgid "Doesn't look that succulent to me."
msgstr "Nie wygląda mi na zbyt soczyste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_POTTED"
msgid "You're hard to kill. I respect that."
msgstr "Ciężko cię zabić. Szanuję to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKBOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKBOAT"
msgid "That's not how you use a boat!"
msgstr "Jak nie korzystać z łodzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEATERVEST"
msgid "It's no three-piece, but it's dapper enough."
msgstr "Garnitur to to nie jest, ale daje radę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAFFY"
msgid "It's almost entirely sugar."
msgstr "Sto procentu cukru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRD"
msgid "These were a failed experiment."
msgstr "Nie udał mi się ten eksperyment."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG"
msgid "Tallbirds are territorial because of these things."
msgstr "Przez nie duptaki są bardzo terytorialne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It tastes like broken dreams."
msgstr "Smakuje zrujnowanymi marzeniami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "It's getting tepid."
msgstr "Zaczyna się wychładzać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "We've got a live one here."
msgstr "Coś się tu rusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Hot enough for ya?"
msgstr "Dość ciepło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "It's going to be a while."
msgstr "Trochę to potrwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Any moment now..."
msgstr "Już za chwileczkę..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "Well. That's tempting."
msgstr "Cóż... kuszące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "It's made of dirty beefalo hair."
msgstr "Uplecione z brudnych kłaków wołka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.GENERIC"
msgid "It's less cute now that it's grown up."
msgstr "Wyrośnięty już nie jest taki uroczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.HUNGRY"
msgid "They sure do eat a lot."
msgstr "Potrafią nieźle zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.STARVING"
msgid "A hungry beast is a dangerous beast."
msgstr "Głodna bestia to niebezpieczna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.GEMS"
msgid "The fuel needs more focal points."
msgstr "Paliwo potrzebuje więcej punktów skupienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.VALID"
msgid "That should do the trick."
msgstr "To powinno wystarczyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "It's alive!"
msgstr "Działa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "My beautiful machine is in pieces!"
msgstr "Moja piękna maszyna w kawałkach!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Now to turn it on."
msgstr "Teraz trzeba go włączyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "It is still incomplete."
msgstr "Wciąż czegoś brakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BOX"
msgid "This is a box full of sadness and woe."
msgstr "Pudełko pełne smutku i rozpaczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_CRANK"
msgid "This is used to agitate the humors."
msgstr "Można by tym coś nakręcić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_POTATO"
msgid "The gears in here are so small they turn the fabric of reality."
msgstr "Zębatki są tu tak małe, że zakrzywiają powłokę rzeczywistości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_RING"
msgid "This is the quantum field guard band."
msgstr "Pas ochronny pola kwantowego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELESTAFF"
msgid "Magic can do amazing things, when funneled through the right channels."
msgstr "Magia potrafi dokonać wielkich rzeczy, jeśli się ją odpowiednio ukierunkuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.BURNT"
msgid "That's a bit burned for my taste."
msgstr "Trochę zbyt przypieczony, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.GENERIC"
msgid "That's a bit rustic for my taste."
msgstr "Trochę zbyt rustykalny, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE"
msgid "I'm glad the rest of it is still down there."
msgstr "Dobrze, że reszta jest wciąż pod ziemią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPIKE"
msgid "Ugh. This is so revolting."
msgstr "Ugh. Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPOTS"
msgid "This is how they reproduce."
msgstr "Tak się rozmnażają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_GARDEN"
msgid "This one is odd."
msgstr "Dziwny twór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR"
msgid "How deep does this go?"
msgstr "Ciekawe, jak głęboko sięga."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Babies?"
msgstr "Młode?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Ugh! How can it live down there?"
msgstr "Uff! Jak tutaj można żyć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE"
msgid "An exceedingly rare but useful material."
msgstr "Niezwykle rzadki, ale użyteczny materiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE_PIECES"
msgid "Several of these piles could be combined to form a bigger piece."
msgstr "Można by tak zgarnąć te kupki na jedną stertę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THURIBLE"
msgid "Curious. It smells like roses."
msgstr "Osobliwe. Wyczuwam woń róży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.GENERIC"
msgid "What an abomination!"
msgstr "Co za paskudztwo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.RAGE"
msgid "It is coursing with fungal power!"
msgstr "Emanuje grzybną mocą!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "It's a dirt hole."
msgstr "Dziura w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Pitiful. I'll make short work of that 'shroom."
msgstr "Żałosne. Załatwię tego grzyba w mgnieniu oka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "That looks filthy."
msgstr "Wygląda obrzydliwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOPHAT"
msgid "Some fine haberdashery."
msgstr "Fachowa robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TORCH"
msgid "It keeps Charlie at bay."
msgstr "Charlie będzie trzymać się z dala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "The magic beckons!"
msgstr "Magia wzywa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Walking gets tiresome, you know."
msgstr "Wędrówki potrafią być męczące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "The magic beckons!"
msgstr "Magia wzywa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "An impure orange gem."
msgstr "Uszkodzony pomarańczowy klejnot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILMIX"
msgid "Nuts and berries. No bolts."
msgstr "Owoce i orzechy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILS"
msgid "What a brute!"
msgstr "Co za siłacz!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRANSISTOR"
msgid "I don't understand how it works, but it does."
msgstr "Nie wiem, jak to działa, ale działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP"
msgid "Only the dumbest animals will fall for this."
msgstr "Tylko najgłupsze zwierzaki dadzą się na to nabrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH"
msgid "This one packs a wallop."
msgstr "Potrafi zaboleć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "I'm... sure I had my reasons when I placed this."
msgstr "Jestem... Hm. Jestem pewien, iż miałem swe powody, gdy to rozstawiłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.BURNT"
msgid "It won't store anything now."
msgstr "Teraz niczego już nie przechowa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A place to store loot."
msgstr "Miejsce na łupy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST_TRAP"
msgid "Hmmm. Looks suspicious."
msgstr "Hmm. Wygląda podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREECLUMP"
msgid "I can't get through there."
msgstr "Tędy nie przejdę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREEGUARD"
msgid "Stop this ridiculous charade, beast."
msgstr "Zaprzestań twych głupawych gierek, bestio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_1"
msgid "These must have been heated to an incredible temperature."
msgstr "Musiały się rozgrzać do niewyobrażalnej temperatury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_10"
msgid "Is that a crack about my age?"
msgstr "To aluzja do mego wieku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_11"
msgid "I'm not listening."
msgstr "Nie słucham cię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_12"
msgid "I'm not touching that without several pairs of gloves."
msgstr "Nie dotknę tego bez kilku par rękawiczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_13"
msgid "Don't look at me like that."
msgstr "Nie patrz na mnie w ten sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_14"
msgid "Perhaps I'll invite the librarian for a nice mandrake tea."
msgstr "Może by tak zaprosić bibliotekarkę na herbatkę z mandragory?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_15"
msgid "Charlie was the only one who ever kept me in check."
msgstr "Tylko Charlie potrafiła utrzymać mnie w ryzach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_16"
msgid "Charlie was the only one who ever kept me in check."
msgstr "Tylko Charlie potrafiła utrzymać mnie w ryzach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_17"
msgid "The product of a very immature magician, perhaps."
msgstr "Czyżby dzieło niedojrałego magika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_18"
msgid "A metaphor, perhaps."
msgstr "Czyżby metafora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_19"
msgid "Admittedly, it's difficult to maintain balance when you're on top."
msgstr "Prawdą jest, iż ciężko zachować równowagę, gdy jest się na szczycie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_2"
msgid "A complete and utter fraud..."
msgstr "Totalne fałszerstwo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_20"
msgid "Eliminates the use of the phrase \"You scratch my back, I'll scratch yours.\""
msgstr "Sprawia, iż to, co dotąd nieosiągalne, może zostać podrapane!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_21"
msgid "I know when I've been beaten."
msgstr "Wiem, kiedy jestem pokonany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_22"
msgid "The monster child gets tangled in this frequently."
msgstr "Potworne dziecię często się w to zaplątuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_23"
msgid "I was looking for that."
msgstr "Właśnie tego szukałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_24"
msgid "It's been beheaded."
msgstr "Dekapitacja dokonana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_25"
msgid "The strongman's wardrobe is brimming with them, judging from the odor."
msgstr "Sądząc po odorze, to coś wprost z szafy siłacza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_26"
msgid "This was important to one very specific person once."
msgstr "Onegdaj było dla pewnego szczególnego kogoś bardzo ważne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_27"
msgid "Finally. My suits were getting wrinkles. Wrinkles!"
msgstr "Nareszcie. Moje garnitury zaczynały się gnieść. Gnieść!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28"
msgid "It is still beholden to the king."
msgstr "Wciąż należy do króla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29"
msgid "It is still beholden to the king."
msgstr "Wciąż należy do króla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3"
msgid "A tangled mess. Like life."
msgstr "Pomieszanie z poplątaniem. Metafora ludzkiego życia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30"
msgid "Not a pawn, but still a minion."
msgstr "Nie pionek, ale jednak wciąż sługa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31"
msgid "Not a pawn, but still a minion."
msgstr "Nie pionek, ale jednak wciąż sługa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32"
msgid "Amateur magic for children."
msgstr "Jarmarczne sztuczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33"
msgid "The opposite of dapper."
msgstr "Przeciwieństwo elegancji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34"
msgid "I'm done tampering with magical oddities, thank-you."
msgstr "Mam już dość magicznych sztuczek. Dzięki bardzo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35"
msgid "I'm not in the habit of imbibing strange liquids."
msgstr "Nie mam w zwyczaju spijać nieznanych płynów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36"
msgid "Permanently bared."
msgstr "Zawsze na wierzchu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_37"
msgid "I told you people, I am *not* a vampire!"
msgstr "Ciągle powtarzam ludziom, że *nie jestem* wampirem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_38"
msgid "You are all ants in my eyes already."
msgstr "W mych oczach jesteście wszyscy mrówkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_39"
msgid "What a tacky glove."
msgstr "Co za tandeta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_4"
msgid "Don't look at me like that."
msgstr "Nie patrz tak na mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_40"
msgid "One hundred percent to scale."
msgstr "Rozmiary w stu procentach zgodne z oryginałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_41"
msgid "I've no idea what that is."
msgstr "Pojęcia nie mam, na co tu patrzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_42"
msgid "It looks cheap."
msgstr "Ale taniocha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_43"
msgid "What use would I have of such a thing?"
msgstr "Co mi po tym?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_44"
msgid "Rosebud."
msgstr "Pąk róży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_45"
msgid "At least it's not ragtime."
msgstr "Tyle dobrego, że to nie ragtime."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_46"
msgid "Some harebrained invention of the scientist's, perhaps?"
msgstr "Czyżby jakiś chory produkt akademickiego umysłu?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_5"
msgid "A toy for a child's mind."
msgstr "Zabawka dla małego geniusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_6"
msgid "I might hide those in the robot's bedroll if I get bored."
msgstr "Może schowam je w śpiworze robota, gdy najdzie mnie nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_7"
msgid "Not something a grown man should be caught playing with."
msgstr "Wolałbym, żeby mnie z tym nie widziano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_8"
msgid "I'd prefer a pocketwatch on a chain."
msgstr "Wolałbym zegarek kieszonkowy na łańcuszku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_9"
msgid "My suits don't deserve to be defaced with these tacky atrocities."
