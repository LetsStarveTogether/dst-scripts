msgstr "W sam raz na gorące letnie dni."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_COOKED"
