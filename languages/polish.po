msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CALIFORNIAROLL"
msgid "Oh, goody. Fish rolled in seaweed."
msgstr "O raju! Ryba zawinięta w wodorosty."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Oj... Zaraz zgaśnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I like fire."
msgstr "Lubię ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "PŁOŃ! PŁOŃ MOCNIEJ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW"
msgid "This fire is small and boring."
msgstr "Mały, nudny ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Burn!"
msgstr "Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT"
msgid "Awww. It's all over."
msgstr "Ach. Skończyło się."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC"
msgid "If it kicks the bucket I'm outta here."
msgstr "Jak zdechnie, spadam stąd."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD"
msgid "You still breathing? Just checking."
msgstr "Oddychasz jeszcze? Tylko sprawdzam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED"
msgid "Is that infectious? We should burn it."
msgstr "To zaraźliwe? Trzeba go chyba spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG"
msgid "I'm gonna stuff so much candy in there!"
msgstr "Ale napcham tu słodyczy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE"
msgid "It's way easier to cover ground with this!"
msgstr "Teraz łatwiej jest przemieszczać się po okolicy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.DEAD"
msgid "Ew, it's dead."
msgstr "Fuj, nie żyje."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.GENERIC"
msgid "I wanna roast it!"
msgstr "Chcę ją upiec!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.HELD"
msgid "It keeps squirming."
msgstr "Cały czas się wierci."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT.SLEEPING"
msgid "It's snoring."
msgstr "Chrapie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARRAT_GHOSTRACER"
msgid "That's a weird looking Carrat."
msgstr "Dziwnie wygląda ta myszomarchew."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT"
msgid "Yuck. It's all vegetabley."
msgstr "Fuj. Żarcie dla królików."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_COOKED"
msgid "Still vegetabley, but better for having been in fire."
msgstr "Wciąż bardzo warzywna, ale ogień trochę poprawił smak."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_PLANTED"
msgid "Maybe its special carrot friend is in the ground."
msgstr "Może znajdzie w ziemi swojego marchewkowego przyjaciela."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_SEEDS"
msgid "Seeds for a yucky orange vegetable."
msgstr "Nasiona pomarańczowego obrzydlistwa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Yes!!"
msgstr "Tak!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Scouts don't need maps, anyway."
msgstr "Skauci i tak nie potrzebują mapy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I guess I could show everyone where I've been."
msgstr "Będę mogła wszystkim pokazać, gdzie byłam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOON"
msgid "Here, kitty!"
msgstr "Kici, kici, koteczku!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.EMPTY"
msgid "It's all dried up and ready for burning."
msgstr "Puściutki i gotowy do palenia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I wouldn't burn it while someone lives there."
msgstr "Nie mogłabym go podpalić, dopóki ktoś w nim mieszka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONHAT"
msgid "Cuddly hat."
msgstr "Przytulaśna czapa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Let's just smash it up."
msgstr "Po prostu to rozwalmy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't get up there!"
msgstr "Nie mogę się tam dostać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA"
msgid "Bananas!"
msgstr "Banany!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_BURNT"
msgid "That's all I wanted!"
msgstr "To mi się podoba!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Yum!"
msgstr "Mniam!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_TREE"
msgid "Looks burnable!"
msgstr "Chyba dałoby się go podpalić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE"
msgid "Who plugged that hole?"
msgstr "Kto zatkał tę dziurę?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people down there."
msgstr "Za dużo tu ludzi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I don't want to go in that gross hole!"
msgstr "Nie zamierzam włazić do tej dziury obrzydliwości!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "I hope there's lava down there somewhere."
msgstr "Mam nadzieję, że gdzieś tam w dole jest lawa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Who plugged that hole?"
msgstr "Kto zatkał tę dziurę?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people up there."
msgstr "Za dużo tam luda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "It's cooler down here, anyway."
msgstr "Przynajmniej jest chłodniej."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.OPEN"
msgid "It's too dark and stuffy down here."
msgstr "Ciemno tu i duszno."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_FERN"
msgid "Looks flammable."
msgstr "Wygląda łatwopalnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CEVICHE"
msgid "It's still slimy."
msgstr "Ale oślizgłe..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHARCOAL"
msgid "Mmmm. Smells like fire."
msgstr "Mmm. Pachnie ogniem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK1"
msgid "Dead windup horsey."
msgstr "Martwy nakręcany konik."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK2"
msgid "Dead windup priest."
msgstr "Martwy nakręcany posłaniec."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK3"
msgid "Dead windup castle."
msgstr "Martwy nakręcany zamek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "It's hard to burn stuff at sea."
msgstr "Ciężko się wznieca ogień na morzu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Can't shake anything up like that."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Those are some pointy teeth."
msgstr "Ale ma zębiska."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Took the sting out of her stinger."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Just some dumb bishop piece."
msgstr "Jakiś głupi goniec."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "Wolę chyba nie wiedzieć, co z tego wyjdzie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Meh. I can't even burn it."
msgstr "Meh. Nawet się nie da tego spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Now all I can think of is roasted carrots."
msgstr "Jedyne, o czym teraz myślę, to pieczone marchewki."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It almost looks friendly."
msgstr "Prawie przyjazny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It doesn't look so tough now."
msgstr "Tak strasznie teraz nie wygląda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Was the treasure worth it?"
msgstr "Czy ten skarb był tego wart?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "We kicked its butt."
msgstr "Skopaliśmy mu tyłek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "I think... I think I understand art."
msgstr "Myślę, że… Myślę, że rozumiem sztukę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_FORMAL"
msgid "I'm not afraid of that guy. He doesn't even have arms!"
msgstr "Nie boję się go. Nie ma nawet rąk!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Ouchhh! I think I chipped a tooth."
msgstr "Auć! Chyba złamałam ząb!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Haha, you can't get me now."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A horse with no butt."
msgstr "Koń bez tyłka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "Wolę chyba nie wiedzieć, co z tego wyjdzie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "She was a pretty tough old bird."
msgstr "To był mocny, stary ptak."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOON"
msgid "I guess it's nice."
msgstr "Chyba całkiem fajny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Looks as dumb as the real thing."
msgstr "Wygląda równie głupio jak w rzeczywistości."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MUSE"
msgid "Ewww, she doesn't have a head!"
msgstr "Fuj, nie ma głowy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN"
msgid "What sort of peasant doesn't have a torch?!"
msgstr "Jaki wieśniak chodzi bez pochodni?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PIPE"
msgid "I prefer smokey fires."
msgstr "Wolę ogniska."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "That one looks like it could do some damage."
msgstr "Wygląda dość niebezpiecznie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "Wolę chyba nie wiedzieć, co z tego wyjdzie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_STALKER"
msgid "Not so tough now, are you?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "What are you looking at?"
msgstr "Na co tak spoglądasz?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER"
msgid "He's so fuzzy!"
msgstr "Ale włochata!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's rude to stare."
msgstr "Niegrzecznie jest się gapić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "At least it's not looking at me anymore."
msgstr "Przynajmniej już się na mnie nie gapi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHUM"
msgid "Ew, fish eat that nasty stuff?"
msgstr "Fuj, ryby jedzą takie obrzydlistwo?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.GENERIC"
msgid "This dog is stone cold!"
msgstr "Ten pies jest skamieniały na kamień!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.STATUE"
msgid "Welp, that's a weird shape for a rock."
msgstr "Przedziwny kształt dla skały."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.GENERIC"
msgid "How'd you get your eyes to do that?!"
msgstr "Jak robisz tak oczami?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.STATUE"
msgid "Did someone carve this thing?"
msgstr "Czyżby ktoś to wyrzeźbił?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Oj... Zaraz zgaśnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.GENERIC"
msgid "I like fire of all kinds."
msgstr "Lubię ogień pod każdą postacią."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.HIGH"
msgid "BURN! BURN FASTER! AND BLUER!"
msgstr "PŁOŃ! PŁOŃ MOCNIEJ I NIEBIEŚCIEJ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.LOW"
msgid "This fire is small and boring."
msgstr "Mały, nudny ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.NORMAL"
msgid "Burn!"
msgstr "Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.OUT"
msgid "Awww. It's all over."
msgstr "Ach. Skończyło się."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Oj... Zaraz zgaśnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "I could watch it for hours, even though it's cold."
msgstr "Mogłabym go oglądać godzinami, mimo że jest zimny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.HIGH"
msgid "BURN! BURN FASTER! AND BLUER!"
msgstr "PŁOŃ! PŁOŃ MOCNIEJ I NIEBIEŚCIEJ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.LOW"
msgid "This fire is small and boring. And blue."
msgstr "Mały, nudny, niebieski ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Burn!"
msgstr "Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.OUT"
msgid "Make the fire come back!"
msgstr "Gdzie jest ogień? Wróć, ogniu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.E"
msgid "East!"
msgstr "Wschód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC"
msgid "Can't get a reading."
msgstr "Nie mam żadnych odczytów."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "Północ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "Północny wschód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "Północny zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "Południe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "Południowy wschód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "Południowy zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W"
msgid "West..."
msgstr "Zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTWRAP"
msgid "That's disgusting!"
msgstr "Obrzydliwe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'd rather burn things down than build them up."
msgstr "Wolę palić niż budować."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE"
msgid "The fire didn't get rid of its face. Gives me the willies."
msgstr "Ogień nie pozbył się tej twarzy. Trochę to straszne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT"
msgid "Unseasoned meat... great."
msgstr "Niedoprawione mięso... super."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still gross."
msgstr "Wciąż jest ohydne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT"
msgid "Gonna need a lot of appetizers to survive out here!"
msgstr "Będę potrzebowała dużo przekąsek, aby tutaj przetrwać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTER"
msgid "Hey! What are you lookin' at?!"
msgstr "Ej! Co się gapisz?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTERHAT"
msgid "Matches my prickly personality."
msgstr "Pasuje do mojego kąśliwego charakteru."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTERSHELL"
msgid "Ha, I stole its house."
msgstr "Ha, ukradłam mu dom."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.BURNT"
msgid "At least it went out in a blaze of glory."
msgstr "Przynajmniej odszedł w płomieniach chwały."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "The fire still has quite a bit of work to do."
msgstr "Ogień ma jeszcze trochę do zrobienia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "The fire is doing its thing!"
msgstr "Ogień ciężko pracuje!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.DONE"
msgid "Fire makes everything better. Mmm!"
msgstr "Ogień sprawia, że wszystko staje się lepsze. Mhmm!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY"
msgid "All food must be cleansed with fire."
msgstr "Wszelka żywność musi zostać oczyszczona w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COONTAIL"
msgid "I've kept stranger things than that."
msgstr "Nie takie rzeczy widziałam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN"
msgid "A sweet vegetable, yum!"
msgstr "Słodkie warzywo, mniam!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_COOKED"
msgid "Ooh, this one explodes when it goes in fire!"
msgstr "Och! W ogniu eksploduje!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_SEEDS"
msgid "Seeds for my favorite explosive vegetable."
msgstr "Nasionka mojego ulubionego wybuchowego warzywa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.GENERIC"
msgid "He doesn't look too happy..."
msgstr "Nie wygląda na zbyt szczęśliwego..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING.INERT"
msgid "I think it could use something glittery."
msgstr "Myślę, że przydałaby mu się jakaś błyskotka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRABKING_CLAW"
msgid "Keep your claws off my boat!"
msgstr "Trzymaj szczypce z dala od mojej łodzi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB"
msgid "Is there anything cute in there??"
msgstr "Jest tu jakiś słodziak?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING"
msgid "We were made for each other."
msgstr "Jesteśmy dla siebie stworzeni."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING"
msgid "Aww, I could just squish your gross lil face!"
msgstr "Ale bym wycałowała tą słodką mordkę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN"
msgid "You're the perfect lapwarmer."
msgstr "Idealny grzejnik kolanowy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB"
msgid "Look at those creepy little eyes. Aww."
msgstr "Popatrz na te małe dziwne oczka! Jakie słodkie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "She loves flames!"
msgstr "Uwielbia płomienie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING"
msgid "I could just eat you up."
msgstr "Mogłabym cię schrupać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY"
msgid "Hah, you don't even know you're smelly."
msgstr "Ha, nawet nie wiesz, jak brzydko pachniesz!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC"
msgid "I think it's waiting for me to die."
msgstr "Chyba czeka, aż umrę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD"
msgid "Not so smart now, are you?"
msgstr "Wcale nie taki sprytny z ciebie ptaszek, co?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRUMBS"
msgid "Haha. That little guy is losing his parts."
msgstr "Ha, ha. Ten mały ludek gubi kawałki."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for burning. Or maybe crafting."
msgstr "Ścięta trawa, gotowa do spalenia. Ewentualnie do jakiegoś rzemiosła."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN"
msgid "Blah, tastes like sawdust."
msgstr "Ble. Smakuje jak trociny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for burning. Or maybe crafting."
msgstr "Cięty tatarak, gotowy do spalenia. Ewentualnie do jakiegoś rzemiosła."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE"
msgid "Perfectly squared for maximum enjoyment."
msgstr "Idealnie ociosany dla maksimum przyjemności."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST"
msgid "Fire didn't cure this dish of being nasty."
msgstr "Ogień nie pomógł. I tak jest obrzydliwa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEAD_SEA_BONES"
msgid "GROSS! What if I'd stepped on it by accident?"
msgstr "OBRZYDLIWE! Co by było, gdybym przypadkiem na tym stanęła?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "YES! BURN!"
msgstr "TAK! PŁOŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I wish it was still burning."
msgstr "Szkoda, że już nie płonie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "One less tree in the world."
msgstr "Jedno drzewo mniej na świecie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It looks like it would burn well."
msgstr "Na pewno znakomicie się pali."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "A fire would set'em straight."
msgstr "Ogień postawiłby go do pionu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER"
msgid "Don't think that horn makes you special, deer."
msgstr "Nie myśl, że te przez te rogi jesteś jakiś wyjątkowy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC"
msgid "I wish everyone'd stop fawning over that smelly thing!"
msgstr "Ale z ciebie jeleń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS"
msgid "Holy crap!"
msgstr "O rety!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Stop staring at me!"
msgstr "Przestań się na mnie gapić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER"
msgid "It's a big, weird antler."
msgstr "Dziwne, wielkie rogi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED"
msgid "Marginally better smelling than most animals here."
msgstr "Pachnie drobinę lepiej niż większość zwierzaków w tym lesie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "What a sorry looking piece of... grass?"
msgstr "Cóż za żałosna... kępka trawy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT"
msgid "Not very stylish."
msgstr "Niezbyt stylowe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE"
msgid "Who just leaves dirt lying around in the forest?"
msgstr "Kto w ogóle zostawia w lesie jakąś ziemię?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD"
msgid "It's making some kind of noise."
msgstr "Wydaje jakieś ciche dźwięki."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC"
msgid "It's full of electrical junk."
msgstr "Elektryczne ustrojstwo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT"
msgid "Gah! Enough with the beeping!"
msgstr "Wystarczy tego pikania!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM"
msgid "This thing is getting noisier."
msgstr "Robi się coraz głośniejsza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be close!"
msgstr "Musimy być blisko!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Not sure what this does. Doesn't seem like it's fiery things."
msgstr "Nie wiem, co to robi. Chyba nie ma nic wspólnego z ogniem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY"
msgid "Just needs to be unlocked with a key. Not fire, unfortunately."
msgstr "Trzeba to otworzyć. Niestety kluczem, a nie ogniem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It's whirring now!"
msgstr "Zaczęło się kręcić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART"
msgid "I'll make something out of it."
msgstr "Coś się z tego wymyśli."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT"
msgid "Aww, I always get caught in the middle!"
msgstr "Ach, zawsze utknę gdzieś w środku!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONCHILISALAD"
msgid "I can't wait to eat it."
msgstr "Nie mogę się doczekać, żeby ją zjeść."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY"
msgid "It's filled with fire!"
msgstr "Jest przepełniona ogniem!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST"
msgid "I'm not sure why you'd want something that DOESN'T burn..."
msgstr "Nie wiem, po co komuś coś, czego NIE DA się podpalić..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Let's turn it back on!"
msgstr "Włączmy go z powrotem!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "That's certainly a look."
msgstr "No jest to jakiś pomysł."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "I think I'm in love."
msgstr "Chyba się zakochałam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Stick another gem in there!"
msgstr "Wetknijmy tam jeszcze jeden klejnot!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT"
msgid "It looks sort of like a fire!"
msgstr "Wygląda trochę jak ogień!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It looks more like a fruit that's been in a fire now."
msgstr "Teraz bardziej wygląda na owoc, który był w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Seeds for that fire-looking fruit."
msgstr "Nasiona tego ognistego owocu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT"
msgid "Sooo ferocious!"
msgstr "Ale dzikość!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE"
msgid "Fire fruit in a pie? Oh boy!"
msgstr "Ciasto z ognistymi owocami? O raju!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT"
msgid "I wanna be the caboose!"
msgstr "Zostałam tyłkiem!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES"
msgid "Oooooooh! I LIKE those."
msgstr "Oooooch! PODOBAJĄ MI SIĘ."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_LOG"
msgid "Perfect for burning."
msgstr "Doskonały do palenia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "YES!"
msgstr "TAK!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Well, that was fun."
msgstr "To było całkiem zabawne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "I could still burn the stump."
msgstr "Mogę jeszcze spalić pniak."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree looks super weird."
msgstr "To drzewo wygląda strasznie dziwnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK"
msgid "Bang on the drum all day!"
msgstr "Kurczę pieczone!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hmm... Satisfy hunger, or bang on the drum?"
msgstr "Zabić głód, czy kogoś?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH"
msgid "What's the matter, got no dirt?"
msgstr "Co jest? Brakuje ci ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "What's the matter, got no dirt?"
msgstr "Co jest? Brakuje ci ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS"
msgid "What's the matter, got no dirt?"
msgstr "Co jest? Brakuje ci ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH"
msgid "What's the matter, got no dirt?"
msgstr "Co jest? Brakuje ci ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING"
msgid "What's the matter, got no dirt?"
msgstr "Co jest? Brakuje ci ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I knew I didn't like you."
msgstr "Wiedziałam, że mi się nie spodobasz."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN"
msgid "Ew, stinky!"
msgstr "Ale śmierdziel!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED"
msgid "Yuck, it smells just as bad cooked!"
msgstr "Fuj! Ugotowany śmierdzi równie paskudnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS"
msgid "Smelly seeds for a smelly fruit."
msgstr "Śmierdzące nasiona śmierdzącego owocu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT"
msgid "Smells like rabbit butt."
msgstr "Śmierdzą jak tyłek królika."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL"
msgid "I don't like the look it's giving me!"
msgstr "Nie podoba mi się jego spojrzenie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED"
msgid "Fire improves everything."
msgstr "Ogień uszlachetnia wszystko."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT"
msgid "Definitely not a bird."
msgstr "Ma jakąś taką obślizgłą nazwę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED"
msgid "Using fire on it made it a tastier eggplant."
msgstr "Ogień znacznie pomógł."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS"
msgid "Will these seeds make a plant or baby bird?"
msgstr "Nasiona dziwnego warzywa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT"
msgid "Alright, alright, so I was wrong about the hand!"
msgstr "OK, dobra, myliłam się co do tej ręki!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY"
msgid "I'm telling you, there's a monsterhand under that thing!"
msgstr "Mówię wam, że pod tym stołem czai się ręka potwora!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Not as good as a fire, but at least we won't be in the dark."
msgstr "Nie to co ogień, ale przynajmniej nie będziemy siedzieć w ciemności."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC"
msgid "Just a bunch of dumb flowers."
msgstr "Wiącha głupich kwiatów."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We're gonna be in the dark soon."
msgstr "Zaraz będziemy siedzieć w ciemności."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED"
msgid "Those need replacing."
msgstr "Trzeba je wymienić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING"
msgid "YES! BURN!"
msgstr "TAK! PŁOŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT"
msgid "I wish it was still burning."
msgstr "Szkoda, że już nie płonie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED"
msgid "One less tree in the world."
msgstr "Jedno drzewo mniej na świecie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC"
msgid "It looks like it would burn well."
msgstr "Na pewno znakomicie się pali."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "YES! BURN!"
msgstr "TAK! PŁOŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "I wish it was still burning."
msgstr "Szkoda, że już nie płonie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "One less tree in the world."
msgstr "Jedno drzewo mniej na świecie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Die in a fire!"
msgstr "Giń w ogniu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT"
msgid "Keeps the rain out your eyes and in someone else's."
msgstr "Nie pozwala, aby padało ci w oczy, i sprawia, że na innych pada bardziej."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT"
msgid "They spread like fire."
msgstr "Rozprzestrzeniają się jak ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET"
msgid "I wish it lit stuff on fire."
msgstr "Szkoda, że nie miota ogniem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM"
msgid "It's no good until it's been placed."
msgstr "Na nic się nie przyda, dopóki nie zostanie rozstawiona."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT"
msgid "It was a nice finale."
msgstr "Nienajgorsze widowisko."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC"
msgid "Sigh. It's a pile of dirt."
msgstr "Ech. Kupa ziemi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING"
msgid "Hurry up, dirtpile. Feed me!"
msgstr "No dalej, kupo ziemi. Nakarm mnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "Stupid thing needs poop."
msgstr "Głupie pole potrzebuje nawozu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN"
msgid "I dunno... it could put out some fires..."
msgstr "Hmm... Nie wiem... Może dałoby się tym ugasić jakiś ogień..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT"
msgid "A phoenix reborn!"
msgstr "Feniks odrodzony!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL"
msgid "So what does the feather do again?"
msgstr "Po co było to pióro?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY"
msgid "Canary feather. It probably smells terrible on fire."
msgstr "Pióro kanarka. Pewnie strasznie śmierdzi w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW"
msgid "Black bird feather. It probably smells terrible on fire."
msgstr "Pióro czarnego ptaka. Pewnie okropnie śmierdzi, gdy się je podpali."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN"
msgid "Redbird feather. It probably smells terrible on fire."
msgstr "Pióro kardynała. Pewnie strasznie śmierdzi w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Snowbird feather. It probably smells terrible on fire."
msgstr "Pióro śnieżyka. Pewnie strasznie śmierdzi w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET"
msgid "She looks scared half to death."
msgstr "Chyba się boi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE"
msgid "I'm not painting that."
msgstr "Nie będę tego malować."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE"
msgid "I guess we could pen stuff in with it."
msgstr "Można by zrobić jakaś zagrodę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "Nie ma sensu zostawiać tego na ziemi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "Nie ma sensu zostawiać tego na ziemi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER"
msgid "A bucket full of nasty."
msgstr "Wiaderko obrzydliwości."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FESTIVEFISH"
msgid "It's just so festive!"
msgstr "Wygląda bardzo świątecznie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF"
msgid "So I just wave it and FIRE APPEARS?"
msgstr "Więc wystarczy, że machnę i POJAWI SIĘ OGIEŃ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS"
msgid "Light'em up!"
msgstr "No to ognia!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish they didn't run away!"
msgstr "Szkoda, że tak uciekają!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD"
msgid "They're like little fires in my pocket!"
msgstr "Są jak małe ogniki w kieszeni!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND"
msgid "I actually kind of like that one."
msgstr "W sumie to te nawet mi się podobają..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Oj... Zaraz zgaśnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC"
msgid "I could watch it for hours."
msgstr "Mogłabym się w nie wpatrywać godzinami."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "PŁOŃ! PŁOŃ MOCNIEJ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW"
msgid "This fire is small and boring."
msgstr "Mały, nudny ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL"
msgid "Burn!"
msgstr "Płoń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT"
msgid "Make the fire come back!"
msgstr "Gdzie jest ogień? Wróć, ogniu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF"
msgid "That's my absolute favorite toy."
msgstr "To moja najulubieńsza zabawka na calutkim świecie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Almost out."
msgstr "Bliski końca."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "And stay off!"
msgstr "I więcej się nie włączaj!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I wish you'd shut your lid and stop putting out fires."
msgstr "Mógłbyś się już zamknąć i przestać gasić ogień?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH"
msgid "Slippery fishy!"
msgstr "Ryba wpływa na wszystko!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGNET"
msgid "I love throwing things to catch other things!"
msgstr "Uwielbiam rzucać rzeczy, żeby złapać w nie inne rzeczy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD"
msgid "Fishing for the answer with a hook, line and sinker."
msgstr "Wędkowanie wcale nie jest takie proste."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT"
msgid "Needs fire!"
msgstr "Potrzeba... ognia!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_COOKED"
msgid "Less slippery now that it's found fire."
msgstr "Po spotkaniu z ogniem nie jest już taka śliska."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL"
msgid "I like sushi, but I prefer it flame-broiled."
msgstr "Lubię sushi... ale wolę opiekane w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "Fish and fire go well together."
msgstr "Ryby i ogień to doskonałe połączenie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS"
msgid "What you see is what you get. Sticks of fish."
msgstr "Jesteś tym, co jesz. Teraz będę rybnym paluchem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS"
msgid "Convenient taco-grip."
msgstr "Wygodny taco-chwyt!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_BOX"
msgid "Did we just... put a hole in the boat?"
msgstr "Czyżbyśmy właśnie... zrobili dziurę w łódce?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED"
msgid "Less slippery now that it's found fire."
msgstr "Po spotkaniu z ogniem nie jest już taka śliska."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT"
msgid "The poor man's fire-starter."
msgstr "Zapalniczka dla ubogich."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC"
msgid "I don't have time to waste on flowers."
msgstr "Nie mam czasu na jakieś kwiatki."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE"
msgid "I'd like to burn this flower in particular."
msgstr "A ten konkretny kwiatek chciałabym spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT"
msgid "A halo of flowers. Too bad it's not a burning halo of flowers."
msgstr "Aureola z kwiatków. Szkoda, że nie jest to płonąca aureola z kwiatków."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD"
msgid "I'd rather a bowl of flames."
msgstr "Wolałabym miskę płomieni."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE"
msgid "It's burning inside."
msgstr "Płonie od wewnątrz."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL"
msgid "Ugh, that smells terrible."
msgstr "Śmierdzi paskudnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED"
msgid "Looks like good kindling."
msgstr "Może być z ciebie niezła podpałka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE"
msgid "Fuel for the fire."
msgstr "Paliwo dla ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "Sport nie jest łatwy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE"
msgid "It's just nasty old bits of bones!"
msgstr "Kawałki paskudnych kości!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Looks passable."
msgstr "Chyba może być."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That looks absolutely ridiculous."
msgstr "Wygląda przezabawnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Needs more gross old bits."
msgstr "Potrzeba więcej tych starych kawałków."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRESHFRUITCREPES"
msgid "Ooo la la."
msgstr "O, la, la."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD"
msgid "Showed him!"
msgstr "No i ma nauczkę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC"
msgid "He's too damp to burn."
msgstr "Zbyt wilgotna, żeby się zapalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING"
msgid "They're cute when they're sleeping."
msgstr "Są takie urocze, jak śpią."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGFISHBOWL
