msgstr "Wspomnienia sprzed czasów rożna."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GLOMMER"
