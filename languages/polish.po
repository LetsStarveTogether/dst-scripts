msgctxt "STRINGS.SKIN_DESCRIPTIONS.minisign_pickettan"
msgid "Add that personalized touch."
msgstr "Nadaje osobistego akcentu."

#. STRINGS.SKIN_DESCRIPTIONS.minisign_pickettan_drawn
msgctxt "STRINGS.SKIN_DESCRIPTIONS.minisign_pickettan_drawn"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.minisign_pickettan_item
