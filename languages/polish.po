msgstr "Poczekajmy, aż trochę się tu uspokoi, tak?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
