msgstr "Nie mogę teraz spać. Robota czeka!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "No way I'm falling asleep here."
msgstr "Nie ma mowy, aby poszła tutaj spać."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'd rather whip up some grub."
msgstr "Raczej bym coś zjadła."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOHUNGERSLEEP"
msgid "Not without supper first."
msgstr "Nie bez kolacji."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I can't open anything up here."
msgstr "Nic tu nie mogę otworzyć."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd rather sleep than nap."
msgstr "Wolę spać niż drzemać."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "Sleeping down here ain't a bright idea."
msgstr "Spoczynek w tym miejscu nie byłby rozsądny."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOSLEEPONFIRE"
msgid "That's NOT fine."
msgstr "To NIE jest w porządku."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Uh. It's on fire."
msgstr "Ups. Pali się."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_NO_TRAP"
msgid "That was a cinch."
msgstr "Betka."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Practice makes perfect!"
msgstr "Trening czyni mistrza!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Guess I've got to brush up on my technique."
msgstr "Zdaje się, że muszę popracować nad techniką."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I'm not a fan of just sittin' around..."
msgstr "Nie przepadam za bezczynnym siedzeniem..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Maybe I could invent something quicker."
msgstr "Może mogłabym wynaleźć coś szybszego."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Come on fish, let's get a move on!"
msgstr "Dalej, ryby, do roboty!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I'm starting to feel a bit antsy."
msgstr "Robię się nerwowa."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "You rascal!"
msgstr "Ty draniu!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
