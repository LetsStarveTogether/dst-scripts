msgstr "Torebka pełna kucharskich sztuczek!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SPICE_CHILI"
msgid "My own special recipe."
msgstr "Mój własny przepis."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SPICE_GARLIC"
