msgstr "Ej! Odczep się!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PETRIFED_TREES"
msgid "Do these trees seem shadier?"
msgstr "Czyżby te drzewa były jakieś ciemniejsze?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Whew! If that isn't the mightiest smell."
msgstr "O raju! Trochę zajeżdża."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_QUAKE"
msgid "Earthquake!"
msgstr "Trzęsienie ziemi!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REPELLED"
msgid "It's protected!"
msgstr "Ma zabezpieczenie!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_RESEARCH"
msgid "I can build even MORE things!"
msgstr "Mogę wybudować jeszcze WIĘCEJ rzeczy!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "I'm back on the clock!"
msgstr "Zaczynamy nową zmianę!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_REVIVED_OTHER_CORPSE"
