msgstr "Dzięki za pomoc!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_REVIVED_OTHER_CORPSE"
