#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMHOUSE.GENERIC"
msgid "I could disassemble that."
msgstr "Mogłabym to rozłożyć na części."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.FULL"
msgid "It's packed. I'll stay put."
msgstr "Zajęte. Muszę poczekać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.GENERIC"
msgid "Hellooo? Anyone in there?"
msgstr "Halooo? Jest tam kto?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.OPEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGRATION_PORTAL.OPEN"
msgid "Make way! I'm coming through!"
msgstr "Zróbcie miejsce! Przechodzę!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT"
msgid "I put that behind me."
msgstr "Rzuciłam to zajęcie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN"
msgid "Swirly."
msgstr "Zakręcony."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC"
msgid "Cutesy little drawing."
msgstr "Ale uroczy obrazek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN"
msgid "What good's a blank sign?"
msgstr "Na co komu znak bez napisów?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM"
msgid "I hate handmade stuff."
msgstr "Nie cierpię domowego majsterkowania."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR"
msgid "I've had about enough of terrible beasts!"
msgstr "Dość już mam tych obmierzłych bestii!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST"
msgid "Maybe there's loot inside."
msgstr "Może w środku są jakieś łupy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN"
msgid "That's a doozy!"
msgstr "Ale wielki!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Taking a break from the mines?"
msgstr "Odpoczywamy po szychcie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD"
msgid "I love it."
msgstr "Uwielbiam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND"
msgid "Dutiful little miner."
msgstr "Ale z niego pilny górnik."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT"
msgid "A real strange contraption."
msgstr "Bardzo dziwne ustrojstwo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL"
msgid "The excavation crew's down there."
msgstr "Na dole trwają wykopaliska."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY"
msgid "No monkeying around on the job."
msgstr "Nie ma co pajacować przy pracy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL"
msgid "Ha! Smells like me after a full shift!"
msgstr "Ha! Śmierdzi jak ja po całym dniu pracy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA"
msgid "Not sure meat's supposed to be that color."
msgstr "Mięso chyba nie powinno mieć takiego koloru."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT"
msgid "Hooboy! Is that even meat?"
msgstr "O raju! To w ogóle jest mięso?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Drying didn't help none."
msgstr "Suszenie niewiele tu pomogło."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN"
msgid "In need of a good fixin'!"
msgstr "Wymaga porządnej naprawy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC"
msgid "I don't think it's done yet."
msgstr "Chyba nie jest wciąż gotowe!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Moonlight's good for the complexion, hey?"
msgstr "Światło księżyca dobrze robi na cerę, co nie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED"
msgid "Job well done! Now what?"
msgstr "Dobra robota! To co teraz?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hm. This wasn't assembled right."
msgstr "Hm. Źle to wszystko poskładałam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE"
msgid "It was impractical to build this here."
msgstr "Budowa w tym miejscu była złym pomysłem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC"
msgid "Must be broke. I can still see the moon."
msgstr "Nie działa. Wciąż nie widzę księżyca."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Full as can be."
msgstr "Pełnia w pełni."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Brand spanking new moon."
msgstr "Księżyc w nowiu. Totalna nowość."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's waning."
msgstr "Księżyc ubywający."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing."
msgstr "Księżyc przybywający."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER"
msgid "A rock with a hole in it."
msgstr "Skała z wgłębieniem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL"
msgid "Do I gotta offer it up to something?"
msgstr "Czy muszę to złożyć czemuś w ofierze?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET"
msgid "Woah! What an odd texture."
msgstr "Raju! Ale dziwna konsystencja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED"
msgid "I could learn a thing or two from this."
msgstr "Mogłabym się tego i owego nauczyć."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES"
msgid "That's... strange."
msgstr "Hmm... Dziwne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE"
msgid "Oh, mama!"
msgstr "Och, mamo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG"
msgid "Animals don't build things well."
msgstr "Zwierzęta kiepsko sobie radzą z budowlanką."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "That's where the mom keeps her babies."
msgstr "Mama trzyma tutaj swoje młode."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC"
msgid "Once you've dealt with bedbugs, mosquitoes aren't so bad."
msgstr "Jak człowieka oblezą raz pluskwy, to nagle komary nie są takie złe."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD"
msgid "Stop wriggling, it's gross."
msgstr "Przestań się wić. To obleśne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK"
msgid "Ha. That's real gross."
msgstr "Ha. Ale ohyda."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING"
msgid "Don'tcha just wanna noogie it?"
msgstr "Aż mnie korci, aby cię tak lekko zdzielić."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG"
msgid "Just a hole now."
msgstr "Teraz to zwykła dziura."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC"
msgid "Anything good in there, ya think?"
msgstr "Myślisz, że jest tam coś ciekawego?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "That was a one-way ticket."
msgstr "To była podróż w jedną stronę."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Wow. Can't even see the weld joints."
msgstr "Nieźle. Nawet nie widać spawów."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "That's really not my forte."
msgstr "To naprawdę nie jest moją mocną stroną."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB"
msgid "Fire in the hole!"
msgstr "Kryć się!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT"
msgid "Really?"
msgstr "Serio?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "All burned up."
msgstr "Wszystko poszło z dymem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Nothing yet."
msgstr "Wciąż nic."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Looks like a pretty good yield."
msgstr "Całkiem niezły zbiór."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Not much use with a dead log."
msgstr "Bez sensu. Sama zgnilizna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "It's real cold out."
msgstr "Strasznie dziś zimno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "We've got our first mushrooms!"
msgstr "Mamy nasze pierwsze grzyby!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Lookit all that fungus."
msgstr "Patrzcie państwo na tego grzyba."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Roasted."
msgstr "Pieczeń."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Where's the plug?"
msgstr "Gdzie jest kabel?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "How's it work without circuitry?"
msgstr "Jak to może działać bez kabli?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Roasted."
msgstr "Pieczeń."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Is there an \"on\" switch?"
msgstr "Jest tu gdzieś włącznik?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "It lights up, even without filament."
msgstr "Światło bez żarników. Niesamowite."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "Stink."
msgstr "Śmierdzi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "That's a big mushroom!"
msgstr "To ci dopiero kawał grzyba!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Not a fan of the smell."
msgstr "Nie przepadam za tym zapachem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I guess they grow better down here?"
msgstr "Rozumiem, że tutaj lepiej rosną?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Whew. That's an odor."
msgstr "Raju, co za smród..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "It's huge!"
msgstr "Ale ogromna!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "There's spiders in the crawlspace."
msgstr "Roi się tam od pająków."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTLIGHT"
msgid "Creepy to the core."
msgstr "Przerażająco upiorne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREFUEL"
msgid "I don't trust that stuff."
msgstr "Nie ufam mu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARELIGHT"
msgid "I regret poking my nose so far down here."
msgstr "Żaluję, że wtykałam tam swój nos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Nothing out of place here."
msgstr "Wszystko w porządku."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "I'm feeling much better."
msgstr "Czuję się znacznie lepiej."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "Things seem pretty normal."
msgstr "Wszystko wydaje się być dość normalne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It can't possibly get worse."
msgstr "Gorzej być już nie może."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "My head's starting to clear a bit."
msgstr "Zaczyna przejaśniać mi się w głowie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I feel uneasy for some reason."
msgstr "Czuję dziwne zaniepokojenie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The air's all prickly."
msgstr "Powietrze aż iskrzy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSTICK"
msgid "Electricity at my fingertips."
msgstr "Elektryczność pod moją kontrolą."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSWORD"
msgid "Not too keen on touching that."
msgstr "Wolałabym go nie dotykać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE"
msgid "I got some plans in mind for that."
msgstr "Mam co do ciebie pewne plany..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.EMPTY"
msgid "There used to be water there."
msgstr "Kiedyś była tu woda."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC"
msgid "Never seen such a clear lake before."
msgstr "To najczystsza woda, jaką kiedykolwiek widziałam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND"
msgid "I ain't musically inclined."
msgstr "Nigdy nie ciągnęło mnie do muzyki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM"
msgid "Pretty! Pretty useless."
msgstr "Całkiem, całkiem! Całkiem bezużyteczny."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF"
msgid "Did it just get chillier?"
msgstr "Czyżby nagle zrobiło się zimno?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET"
msgid "For those with a lackluster work ethic."
msgstr "Dla tych, którym obca jest etyka w miejscu pracy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM"
msgid "I don't like it."
msgstr "Nie lubię."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE"
msgid "You lookin' at me?"
msgstr "Na mnie zerkasz?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF"
msgid "For people who fear good, honest work."
msgstr "Dla tych, co lękają się uczciwej pracy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST"
msgid "Best not open that."
msgstr "Lepiej jej nie otwierać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE"
msgid "Let's see if I can't play a little ditty."
msgstr "Zobaczmy, czy dam radę coś zagrać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS"
msgid "I don't have much use for that, personally."
msgstr "Osobiście nie potrzebuję za bardzo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK"
msgid "That acid stuff burns!"
msgstr "Ale ten kwas żre!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN"
msgid "I don't mix well with the upper class."
msgstr "Nie przepadam za burżuazją."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD"
msgid "The light's on but no one's home."
msgstr "Pali się światło, ale nikogo nie ma w domu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN"
msgid "It's a big fan made of tailfeathers."
msgstr "Wachlarz z piór ogonowych."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT"
msgid "Smells like burnt gobbler."
msgstr "Zajeżdża spalenizną."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We oughta put a bush in there."
msgstr "Zasadźmy tu jakiś krzew."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I feel luckier already."
msgstr "Od razu czuję, że mam większe szczęście."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES"
msgid "You work up a mighty appetite at the factory."
msgstr "Po pełnej zmianie w fabryce człowiek zjadły konia z kopytami."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS"
msgid "Don't see a whole lotta use for these."
msgstr "Nie widzę dla nich większego zastosowania."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL"
msgid "They seem mean-spirited."
msgstr "Robią na mnie nieprzyjemne wrażenie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE"
msgid "Solid stone."
msgstr "Twardy kamień."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM"
msgid "Please. I hock bigger loogies in my sleep."
msgstr "Proszę. Potrafię lepiej pluć przez sen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE"
msgid "Not my preferred kind of manual labor."
msgstr "Nie przepadam za tym zajęciem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1"
msgid "Swell tattoos you got there."
msgstr "Eleganckie dziary."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2"
msgid "Chill out, red."
msgstr "Się wyluzuj, czerwony."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3"
msgid "He's giving me a dirty look."
msgstr "Zerka na mnie tymi swoimi świńskimi oczkami."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4"
msgid "Stand still so I can hit you with a sign."
msgstr "Stój spokojnie, abym mogła cię palnąć."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD"
msgid "You don't look so tough."
msgstr "Nie wyglądasz mi na twardziela."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK"
msgid "Makes everything smell like pig."
msgstr "Sprawia, że wszystko zajeżdża wieprzowiną."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT"
msgid "What a waste of materials."
msgstr "Co za  marnotrawstwo materiałów."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC"
msgid "I should hammer down that eyesore."
msgstr "Lepiej będzie, jak się jej pozbędę."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT"
msgid "That's a shame."
msgstr "Szkoda."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL"
msgid "Fuller than a downtown tenement house."
msgstr "Tłok jak na stancji jesienią."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC"
msgid "No way that's up to code."
msgstr "Na pewno nie spełnia wymagań."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Hey! I just want some light!"
msgstr "Hej! Potrzebuję trochę światła!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING"
msgid "Those hooves've never seen a day of work."
msgstr "Nawet nie wie, co to praca racic."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD"
msgid "That threw a wrench into his plans."
msgstr "W machinie jego planów zagnieździły się chochliki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Chummy fellow!"
msgstr "Przyjazny ziomek!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC"
msgid "Hey there, ya lug!"
msgstr "Hej, głupolu!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD"
msgid "Don't want no trouble."
msgstr "Nie szukam kłopotów."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG"
msgid "I have no idea what's going on!"
msgstr "Nie rozumiem, co się tu dzieje!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT"
msgid "No good now."
msgstr "Na nic się nie nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY"
msgid "I gotta find some meat for it."
msgstr "Muszę znaleźć jakieś mięso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A bunch of things to build."
msgstr "Sterta rzeczy do budowy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN"
msgid "The backside of an oinker."
msgstr "Świńska skórka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH"
msgid "Kitschy."
msgstr "Ale kicz."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN"
msgid "Too big for me to wear."
msgstr "Za duże to dla mnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE"
msgid "That's a pine cone."
msgstr "Jest to szyszka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING"
msgid "It can handle itself from here."
msgstr "Teraz poradzi już sobie samodzielnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK"
msgid "It's so... rural."
msgstr "Siejskie i wiejskie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT"
msgid "This is beyond confusing."
msgstr "Nie do pojęcia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED"
msgid "It cooked up pretty good."
msgstr "Nieźle się ugotowało."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "It's a plant."
msgstr "Zwykła roślina."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It's hard at work."
msgstr "Ciężko pracuje."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY"
msgid "Good to go."
msgstr "Wszystko gotowe."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's a bit hot out."
msgstr "Fakt, jest dość ciepło."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER"
msgid "Hands to yourself, bucko!"
msgstr "Łapy przy sobie, koleś!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER"
msgid "You better not have singed any of my projects, %s."
msgstr "Mam nadzieję, że nie próbujesz pokrzyżować mi planów, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC"
msgid "Hey, %s! How ya doin'?"
msgstr "Hey, %s! Jak się masz?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST"
msgid "Stop whinin', %s, it's just a scratch!"
msgstr "Już tak nie narzekaj, %s. To tylko draśnięcie!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! Get'em!"
msgstr "Mordestwo! Łapać zbója!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER"
msgid "You're good people, %s."
msgstr "Jesteś w porządku, %s."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE"
msgid "Eat that and you're stuck here forever!"
msgstr "Zjedz kawałek, a nigdy się stąd nie wydostaniesz!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_COOKED"
msgid "It does look pretty tempting."
msgstr "Wygląda dość kusząco."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Some pomegranate seeds."
msgstr "Nasiona granatu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POND"
msgid "I can't see the bottom."
msgstr "Nie widać dna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE"
msgid "Ha! Gross."
msgstr "Ha! Ale obleśna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP"
msgid "Nothing to be ashamed of."
msgstr "Nie ma się czego wstydzić."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTTEDFERN"
msgid "That's my kind of decor. Simple."
msgstr "Takie dekoracje to ja lubię. Proste."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POWCAKE"
msgid "Gotta eat what you can around here."
msgstr "Człowiek je co się da."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN"
msgid "Hey there, pumpkin."
msgstr "Siemanko, dynio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE"
msgid "Gotta indulge sometimes, hey?"
msgstr "Czasami trzeba zrobić sobie prezent, co nie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED"
msgid "Not bad! Kind of sweet."
msgstr "Niezła! Taka jakby słodka."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN"
msgid "It's childish, but in a nice way."
msgstr "To dziecinada, ale w pozytywnym sensie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS"
msgid "Some pumpkin seeds."
msgstr "Nasiona dyni."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET"
msgid "It's, uh, a purple necklace."
msgstr "To taki fioletowy naszyjnik."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM"
msgid "A little snooty gem."
msgstr "Mały klejnot."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE"
msgid "That's amore."
msgstr "Czy to oko może kłamać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "That should keep it busy fer a bit."
msgstr "Póki co powinien być zajęty."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Moss has grown over some sorta socket in the base."
msgstr "Strasznie zarosło tutaj mchem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Nice metalwork."
msgstr "Niezgorsza robota."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "That stuff can ruin good architecture."
msgstr "Te krzaki mogą rozsadzić każdy mur."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Woo-wee. Impress-ive."
msgstr "Kurka wodna, robi wrażenie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It probably looked real nice once."
msgstr "Kiedyś musiała być bardzo ładna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "I wonder who chiseled that."
msgstr "Ciekawe, kto to wyrzeźbił."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Take it easy. You don't looks so good."
msgstr "Nie przemęczaj się. Nie wyglądasz najlepiej."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Nothing in that bush anymore."
msgstr "Na tym krzaczku już nic nie ma."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Fancy lookin' but it still just holds food."
msgstr "Wygląda elegancko, ale nie zmienia to faktu, że służy jedynie do serwowania jedzenia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Nie mam pojęcia, co z nich wyrośnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I'll need to bake it."
msgstr "Trzeba będzie to jakoś upiec."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making little stews and stuff."
msgstr "Do robienia takich małych przekąsek i w ogóle."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1"
msgid "A lucky coin."
msgstr "Moneta na szczęście."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2"
msgid "Save this for a rainy day."
msgstr "Zachowam go na czarną godzinę."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3"
msgid "Gotta watch I don't turn into a rich dope."
msgstr "Muszę uważać, żeby nie przerodzić się w bogatego snoba."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4"
msgid "We could bust outta here with enough of these."
msgstr "Jakby znaleźć ich więcej, moglibyśmy się stąd wykupić."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "I get crabby when I'm hungry. Ha!"
msgstr "Też mnie szczypie, jak zgłodnieję. Ha!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's a big lump of cooked crab."
msgstr "Kawał gotowanego kraba."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Here lil crabby crab."
msgstr "Taś, taś, krabie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN"
msgid "Fresh roughage."
msgstr "Świeży błonnik."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I ain't much of a baker."
msgstr "Marny ze mnie piekarz."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked roughage."
msgstr "Gotowany błonnik."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's throw it up on that altar, hey?"
msgstr "Wrzućmy to po prostu na ołtarz, co nie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Perfect."
msgstr "Doskonale."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the right food, but it don't look too filling."
msgstr "Jedzenie jest odpowiednie, ale ta ilość jest dość śmieszna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Well this ain't right."
msgstr "To nie jest w porządku."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "It's a little toastier than normal."
msgstr "Trochę bardziej chrupiące niż zwykle."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Makes everything taste better."
msgstr "Dzięki niemu wszystko smakuje lepiej."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
