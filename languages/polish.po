msgstr "Auć! Szczypie!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_THURIBLE_OUT"
