msgstr "Tak wysokie tony, że aż mi w uszach dzwoni!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.GENERIC"
msgid "A touching tribute to a treasured twin."
msgstr "Poruszający hołd dla zmarłej bliźniaczki."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
