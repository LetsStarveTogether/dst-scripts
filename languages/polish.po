msgstr "Biedne małe drzewko."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.WITHERED"
