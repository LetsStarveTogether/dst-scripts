msgstr "Przepraszam, nie ta myszomarchew!"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
