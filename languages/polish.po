msgstr "Ta koszula barwy czystej bieli sprawia, że jej użytkownik czuje się niczym pączek w maśle."

#. STRINGS.SKIN_DESCRIPTIONS.body_suspenders_yellow_flax
msgctxt "STRINGS.SKIN_DESCRIPTIONS.body_suspenders_yellow_flax"
msgid "Wearing this 'follicle yellow' colored shirt makes you feel like the cat's pajamas."
msgstr "Ta koszula barwy włoskowatej żółci sprawia, że jej użytkownik czuje się niczym pączek w maśle."

#. STRINGS.SKIN_DESCRIPTIONS.body_sweatervest_blue_snowbird
msgctxt "STRINGS.SKIN_DESCRIPTIONS.body_sweatervest_blue_snowbird"
msgid "An 'electrolytic blue' colored vest made of the finest beefalo wool. Unfortunately, it's not actually warm."
msgstr "Kamizelka w kolorze elektrolitycznego błękitu, wykonana z najlepszej wołkowej wełny. Niestety, słabo chroni przed zimnem."

#. STRINGS.SKIN_DESCRIPTIONS.body_sweatervest_brown_beaver
msgctxt "STRINGS.SKIN_DESCRIPTIONS.body_sweatervest_brown_beaver"
msgid "A 'werebeaver brown' colored vest made of the finest beefalo wool. Unfortunately, it's not actually warm."
msgstr "Kamizelka w kolorze brązu bobrołaka, wykonana z najlepszej wołkowej wełny. Niestety, słabo chroni przed zimnem."

