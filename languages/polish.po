msgstr "Szkoda, że to niejadalne..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOBSTER_SHELLER"
