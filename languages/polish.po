msgstr "Spłonął zdecydowanie za szybko."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "It looks sharp."
msgstr "Te kolce wyglądają na ostre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Those thorns hurt!"
msgstr "Ale kłuje!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_PLANT"
msgid "It's all plant-y."
msgstr "Zwykła roślina."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNING"
msgid "YES! BURN!"
msgstr "TAK! PŁOŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNT"
msgid "I wish it was still burning."
msgstr "Szkoda, że już nie płonie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Not so spiky now, are you?"
msgstr "Ha! I gdzie są teraz twoje kolce?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.GENERIC"
msgid "It looks dangerous!"
msgstr "Wygląda groźnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASHEDPOTATOES"
msgid "I LOVE mashed potatoes."
msgstr "KOCHAM purée ziemniaczane."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST"
msgid "Are we allowed to climb it?"
msgstr "Można na niego wejść?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Alternatively, I could just set the mast on fire."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "That's where the lightning goes."
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_ITEM"
msgid "You can't call it \"sailing\" if you don't have a sail."
msgstr "Nie można mówić o żeglowaniu, jeśli nie ma się żagla."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_MALBATROSS"
msgid "Just think how much cooler it'd look if I set it on fire."
msgstr "Wyglądałby nieporównywalnie fajniej, gdybym go podpaliła."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "You can really make a sail out of anything."
msgstr "Żagiel można zrobić naprawdę ze wszystkiego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELL"
msgid "He's so condescending."
msgstr "Jest taki protekcjonalny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLHEAD"
msgid "He sure likes to talk."
msgstr "Zdecydowanie lubi dużo gadać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLIGHT"
msgid "These are no fun. They light themselves."
msgstr "Wcale nie są fajne. Same się zapalają."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLOCK"
msgid "It just needs a key."
msgstr "Brakuje tylko klucza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "I like more exciting music."
msgstr "Wolę trochę żywszą muzykę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLTHRONE"
msgid "Looks sticky."
msgstr "Wygląda na klejący."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT"
msgid "This could be made better with FIRE!"
msgstr "Wiesz, co by tu pomogło? OGIEŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATBALLS"
msgid "Meat made into spheres and improved with fire."
msgstr "Mięso uformowane w kulki i udoskonalone ogniem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.BURNT"
msgid "Maybe the fire wasn't the best drying method..."
msgstr "Może ogień nie jest jednak najlepszym przyjacielem suszenia..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE"
msgid "It's ready!"
msgstr "Gotowe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "It's ready!"
msgstr "Gotowe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING"
msgid "Come on meat, dry already!"
msgstr "No dalej, mięsko. Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Forget the rain! Dry!"
msgstr "Olej deszcz! Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Forget the rain! Dry!"
msgstr "Olej deszcz! Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "How long does it take this stuff to dry?!"
msgstr "Ile można czekać, żeby się wysuszyło?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC"
msgid "I want to hang some meat!"
msgstr "Mam ochotę coś tu zawiesić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Maybe the fire wasn't the best drying method..."
msgstr "Może ogień nie jest jednak najlepszym przyjacielem suszenia..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Hey lady, your jerky's ready!"
msgstr "Halo, paniusiu, mięso ci się ususzyło!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "It's ready!"
msgstr "Gotowe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Come on meat, dry already!"
msgstr "No dalej, mięsko. Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "Forget the rain! Dry!"
msgstr "Olej deszcz! Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "Forget the rain! Dry!"
msgstr "Olej deszcz! Schnij!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "How long does it take this stuff to dry?!"
msgstr "Ile można czekać, żeby się wysuszyło?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Maybe I'll leave some meat here before I leave..."
msgstr "Może zostawię tu trochę mięsa, zanim sobie pójdę..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATYSALAD"
msgid "Wait... what ARE these leaves?"
msgstr ""

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT_DRIED"
msgid "Chewy, but satisfying."
msgstr "Trochę gumowe, ale może być."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM"
msgid "Eww, it's all swampy."
msgstr "Fuj, co za oślizgłe paskudztwo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMGUARD"
msgid "I can't tell which way it's looking."
msgstr "Nie wiem, w którą stronę on patrzy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHAT"
msgid "Yuck, who'd want a face like that?"
msgstr "Fuj, kto by chciał mieć taką twarz?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.BURNT"
msgid "Double whammy!"
msgstr "Tutaj nawet ogień nie pomoże."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.GENERIC"
msgid "That's what you get for being so stinky!"
msgstr "I widzisz, co cię spotkało przez ten smród?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.BURNT"
msgid "It's true, no one cares."
msgstr "Rzeczywiście, nikomu nie żal."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.GENERIC"
msgid "No one would care if this burned down."
msgstr "Nikomu nie byłoby żal, gdyby stanął w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "I feel a little bad... actually, no I don't."
msgstr "Trochę mam wyrzuty sumienia... żartuję, w ogóle nie mam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "Looks just as flammable as the old ones."
msgstr "Wyglądają na równie łatwopalne co te poprzednie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMKING"
msgid "Are you supposed to be important or something?"
msgstr "Że niby jesteś jakiś ważny, czy coś?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE.BURNT"
msgid "Did I do that? It's hard to keep track."
msgstr "To moja sprawka? Tracę już rachubę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE.GENERIC"
msgid "I shouldn't burn it... but I want to..."
msgstr "Nie powinnam tego palić... Ale tak bym chciała..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Hahaha-! Uh, I mean, oh no..."
msgstr "Ha, ha, ha! Znaczy się, o nie..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "What's all this stuff for?"
msgstr "Po co są te wszystkie rzeczy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "I bet that would catch fire reeeal easy."
msgstr "Założę się, że zajęłaby się baaardzo szybko."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Ugh, the SMELL coming from that thing!"
msgstr "Fuj, co za SMRÓD!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM_PRINCE"
msgid "What makes that guy so special?"
msgstr "Co sprawia, że niby jest taki wyjątkowy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLE"
msgid "Hey! It's a bottle of emergency kindling!"
msgstr "Hej! Butelka z zapasową podpałką!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "Just a boring old bottle."
msgstr "Nudna, stara butelka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINERHAT"
msgid "It's not real fire, but it's still pretty fun."
msgstr "Ogień to to nie jest, ale i tak mi się podoba."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIBOATLANTERN"
msgid "Ha! Fire beats water!"
msgstr "Ha! Ogień wygrywa z wodą!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFAN"
msgid "No fun, making me exercise to stay cool!"
msgstr "To nie w porządku tak mnie zmuszać do ćwiczeń!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFLARE"
msgid "I can't WAIT to light it!"
msgstr "Nie mogę się doczekać, kiedy ją podpalę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.GENERIC"
msgid "Haha oh man, who drew THAT?"
msgstr "Ha, ha! Kto to narysował?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Looks kinda bare."
msgstr "Wygląda jakoś pusto."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN_ITEM"
msgid "It's like a sign, but smaller."
msgstr "Taka jakby tabliczka, tylko mniejsza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAUR"
msgid "Poor thing. Trapped in this maze."
msgstr "Biedaczek. Utknął w labiryncie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURCHEST"
msgid "I want big horns like that!"
msgstr "Też chcę takie rogi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURHORN"
msgid "I wonder if the rings are an indication of age."
msgstr "Ciekawe, czy te pierścienie wskazują wiek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Coming up for a peek!"
msgstr "Podglądacz!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.HELD"
msgid "Out of the ground, into the fire."
msgstr "Spod ziemi prosto do ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.UNDERGROUND"
msgid "Hiding from the light, huh?"
msgstr "Chowamy się przed słoneczkiem?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHAT"
msgid "I'm not sure about this..."
msgstr "Jakoś nie jestem przekonana..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHILL"
msgid "It burrows away from the sun's skyfire. Unnatural."
msgstr "Chowa się przed ogniem słońca. Dziwne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEY"
msgid "Joke's on you! I can burn this poo."
msgstr "I kto się śmieje ostatni?! Mogę podpalić tę kupę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEYBARREL"
msgid "What a wonderfully flammable home."
msgstr "Ale cudownie łatwopalny domek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERLASAGNA"
msgid "Noodles, meat and clumps of hair. Nasty."
msgstr "Makaron, mięso i kępki włosów. Obrzydliwe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT"
msgid "Gross. It's full of hairs."
msgstr "Pełno tu włosów. Ohyda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT_DRIED"
msgid "It's dry and smells strange."
msgstr "Jest suche i dziwnie pachnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERTARTARE"
msgid "Gross!"
msgstr "Ohyda!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.BROKEN"
msgid "Oh look, a bunch of smashed up rocks!"
msgstr "O, kupa rozbitych kamieni!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.GENERIC"
msgid "It's expecting something from me."
msgstr "Chyba czegoś ode mnie chce."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Ughh! It's doing the exact opposite of burning!"
msgstr "Ugh, to zaprzeczenie ognia!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.STAFFED"
msgid "Hurry up already, stupid rock!"
msgstr "No szybko, głupi kamieniu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "That's obviously completely wrong."
msgstr "To oczywiście nie pasuje."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Hey, come back here!"
msgstr "Hej, wracaj tu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Got you now."
msgstr "Mam cię."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "They came off a dead butterfly, gross."
msgstr "Odpadły ze zdechłego motyla, ohyda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "Just an un-burned baby tree."
msgstr "Małe, niespalone drzewo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.CAVE"
msgid "Doesn't work down here."
msgstr "Tutaj nie zadziała."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.GENERIC"
msgid "What the heck? I can still see the moon!"
msgstr "Co jest, do diaska? Wciąż widzę księżyc!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "That's as full as it gets."
msgstr "Pełniejszy nie będzie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A new moon! Great, I hated the old one!"
msgstr "Nowy księżyc! Świetnie, nie cierpiałam tamtego!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon's outta here!"
msgstr "Księżyc się wynosi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing, unlike me."
msgstr "Księżyc rośnie, w przeciwieństwie do mnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS"
msgid "What do we need glass for anyway?"
msgstr "A w ogóle to po co nam szkło?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASSAXE"
msgid "The moon HATES trees."
msgstr "Księżyc NIENAWIDZI drzew."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS_ROCK"
msgid "That's a big chunk of glass!"
msgstr "Wielki kawał szkła!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "We should try smoking them out."
msgstr "Powinniśmy spróbować je wypalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER"
msgid "Great. A rock with a hole in it."
msgstr "Świetnie. Kamień z dziurą."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKIDOL"
msgid "Looks like a jerk."
msgstr "Wygląda jak jakiś drań."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKNUGGET"
msgid "Just another rock to me."
msgstr "Wygląda mi to na kamień...."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED"
msgid "Well I can't burn it."
msgstr "Cóż, nie da się jej spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCK_PIECES"
msgid "Oh look! ROCKS! Ughhhhh!"
msgstr "Oooo! KAMIENIE! Ale frajda..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONSPIDERDEN"
msgid "I hope it burns."
msgstr "Mam nadzieję, że będzie się dobrze palić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Doesn't it feel nice to be back in one piece?"
msgstr "Prawda, że to miłe uczucie, być znowu w jednym kawałku?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Almost done, I swear."
msgstr "Już prawie gotowe, daję słowo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "Why do I get the feeling we aren't done yet?"
msgstr "Dlaczego mam wrażenie, że jeszcze nie skończyliśmy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Y'know, this would be a lot easier if you weren't so heavy."
msgstr "Wiesz, byłoby dużo łatwiej, gdybyś nie był taki ciężki."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Yeah, of course I'll lug you over there."
msgstr "No jasne, że cię tam przytaszczę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Okay, let me take you home."
msgstr "No dobrze, odstawię cię do domu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Something inside is calling for me."
msgstr "Coś mnie wzywa z wnętrza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Something inside is calling for me."
msgstr "Coś mnie wzywa z wnętrza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Something inside is calling for me."
msgstr "Coś mnie wzywa z wnętrza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_ALTAR_SEED"
msgid "Where do you want to go?"
msgstr "Gdzie mam cię umieścić?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Ew, I think it's whispering to me."
msgstr "Fuj, chyba coś do mnie szepcze."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Iunno, maybe we can jam stuff in it."
msgstr "No nie wiem, może trzeba tam wsadzić jakieś rzeczy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Ohh, so that's how she keeps those creeps away."
msgstr "Aha, czyli to w taki sposób trzyma tych świrów z daleka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.BURNING"
msgid "HAHA, YES!"
msgstr "HA, HA, TAK!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.BURNT"
msgid "I don't feel as bad as I thought I would."
msgstr "Nie mam takich wyrzutów sumienia, jakich się spodziewałam."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.CHOPPED"
msgid "It's not gonna grow back."
msgstr "Już nie odrośnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE.GENERIC"
msgid "It's so pretty, I might actually feel bad burning it!"
msgstr "Jest takie ładne, że mogę mieć wyrzuty sumienia, jak je spalę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "This would look even prettier if it was on fire."
msgstr "Wyglądałby jeszcze ładniej w ogniu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE"
msgid "What in the world..."
msgstr "Co do diabła..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSEEGG"
msgid "It's huuuuge!"
msgstr "Ale ogroooomne!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Ugh, it smells like bird butts!"
msgstr "Śmierdzi ptasim zadkiem!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOQUECA"
msgid "It looks soooo good!"
msgstr "Wygląda taaaak dobrze!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.GENERIC"
msgid "So annoying!"
msgstr "Ale są denerwujące!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.HELD"
msgid "Keep that mouth away from me!"
msgstr "Trzymaj tę gębę z dala ode mnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITOSACK"
msgid "Blood must bubble in currents muggy and thick."
msgstr "Mam krew na rękach."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSSLING"
msgid "Its feathers are frazzled."
msgstr "Ma przypalone piórka."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.DUG"
msgid "Better it than me."
msgstr "Lepiej on niż ja."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.GENERIC"
msgid "It's full of dead stuff, I bet."
msgstr "Pewnie jest pełny martwych rzeczy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULLEDDRINK"
msgid "Ahh, it's like there's a warm fire in my belly."
msgstr "Ach, czuję się, jakbym miała brzuszek pełen ciepłego ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "The vines coil away from my lighter... weird!"
msgstr "Pędy uciekają przed mą zapalniczką... Ciekawe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "It's made of some kind of jerk rock I can't burn."
msgstr "Tego drania nie da się spalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It's so useful!"
msgstr "Przydatna rzecz!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMBOMB"
msgid "She's gonna blow!"
msgstr "Zaraz wybuchnie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMHAT"
msgid "I don't like having my head messed with."
msgstr "Nie lubię, jak ktoś próbuje mieszać mi w głowie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "How could that not work?!"
msgstr "Jakim cudem to nie zadziałało?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "A big gross mushroom! Burn it!"
msgstr "Wielki obleśny grzyb. Spalić go!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Mold problem's taken care of."
msgstr "Problem z grzybami rozwiązany."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It's just a dumb log."
msgstr "Zwykła głupia kłoda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Gross, they're taking over!"
msgstr "Ohyda! Zaczynają się panoszyć!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Nasty. Let's burn the rot out."
msgstr "Ble. Trzeba wypalić tę zgniliznę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "I'm sure fire would fix that."
msgstr "Ogień na pewno by to naprawił."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "There's mushrooms growing in it now."
msgstr "Rosną w niej grzyby."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Geez, who even needs that many mushrooms?"
msgstr "Raju, po co komu tyle grzybów?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "C'mon, you saw that coming."
msgstr "No co? To się musiało kiedyś stać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "This dumb mushroom's not lighting up."
msgstr "Głupi grzyb nie chce się świecić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Not as nice as a warm fire."
msgstr "Nie to co przyjemny ogień."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Now what?"
msgstr "I co teraz?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I've got a few ideas on how to light it. Heh heh."
msgstr "Mam pewien pomysł, co zrobić, żeby się zaświecił. He, he."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Pfft, well that was a bright idea."
msgstr "Pfft, jasny umysł rodzi genialne pomysły."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "It's spreading junk everywhere."
msgstr "Rozrzuca wszędzie jakieś śmieci."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Gross. It smells like leprechaun butt."
msgstr "Wstrętne. Śmierdzi jak tyłek kobolda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Ew, I don't want to get too close."
msgstr "Nie chcę mieć z nim nic wspólnego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Gross. It's all mushroomy."
msgstr "Okropieństwo. Jakieś takie całe grzybowe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Ack! It stinks!"
msgstr "Uff! Ale smród!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "Gross. This tree is sick all over."
msgstr "Okropieństwo. To drzewo jest chore."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "That one got what it deserves."
msgstr "Dostał, na co zasłużył."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "Good riddance."
msgstr "Do widzenia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "YUCK! What is that?!"
msgstr "FUJ! Co to w ogóle jest?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Ewww I can see it breathing."
msgstr "Bleee, widać, jak oddycha."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Ew, it's dead."
msgstr "Fuj, nie żyje."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "BURN IT."
msgstr "SPALIĆ GO."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "I don't wanna wake it."
msgstr "Nie chcę go budzić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT"
msgid "It's like fire, but purple!"
msgstr "Trochę jak ogień, tylko fioletowy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL"
msgid "Eww, it's still warm!"
msgstr "Fuj! Jeszcze ciepłe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT"
msgid "Light without fire is unnatural."
msgstr "Światło bez ognia. To sprzeczne z naturą."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREPIE"
msgid "I'm sure he wouldn't mind if I stole a nibble."
msgstr "Na pewno nie będzie miał nic przeciwko, jak sobie odrobinkę zwędzę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Looks normal to me."
msgstr "Wygląda całkiem normalnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "I guess it's nearly over."
msgstr "Chyba już mija."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "I don't think it's working."
msgstr "Chyba nie działa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It's almost humming."
msgstr "Sytuacja jest stabilna."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "I think it's turning off."
msgstr "Chyba się wyłącza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's warning me."
msgstr "Ostrzega mnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The fuel is coming to life!"
msgstr "Paliwo powstaje do życia!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK"
msgid "It'd be way cooler if it was on fire..."
msgstr "Byłaby znacznie fajniejsza, gdyby płonęła."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD"
msgid "It's like dreams that can hurt real things!"
msgstr "Jest trochę jak sny, którymi można ranić prawdziwe rzeczy!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NITRE"
msgid "There are tiny explosions trapped inside."
msgstr "Wewnątrz kryją się małe eksplozje."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OAR"
msgid "Rowing's dumb. Why don't we just use a sail?"
msgstr "Wiosłowanie jest głupie. Nie moglibyśmy po prostu postawić żagla?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OAR_DRIFTWOOD"
msgid "Ugh. Can it be someone else's turn to row?"
msgstr "Ech. Może ktoś inny teraz powiosłować?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE.EMPTY"
msgid "It's a bunch of dirt."
msgstr "Sporo tu ziemi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE.GENERIC"
msgid "It's a bunch of water."
msgstr "Sporo tu wody."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OCEANFISHABLEFLOTSAM"
