msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "You're a big guy, hey?"
msgstr "Ale z ciebie kawał chłopa, nie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Sleeping on the job."
msgstr "Śpi w pracy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Plain shoddy worksmanship."
msgstr "Partacka chałtura."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "It might have been a house, once."
msgstr "To był dom. Kiedyś."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SYRUP"
msgid "It's like honey from a tree."
msgstr "Jak miód, ale z drzewa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Gotta appreciate havin' fresh vegetables."
msgstr "Szanuję świeże warzywa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "I prefer'em fried and green."
msgstr "Wolę, jak są zielone i smażone."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Nie mam pojęcia, co z nich wyrośnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "What'a ya got?"
msgstr "Co tam masz?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Got anything good?"
msgstr "Masz coś dobrego?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP"
msgid "A fresh, ripe turnip."
msgstr "Świeża, dojrzała rzepa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "I'd rather not eat them on their own."
msgstr "Wolałabym je raczej zjeść z czymś."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Nie mam pojęcia, co z nich wyrośnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_WHEAT"
msgid "I go against the grain whenever possible. Ha!"
msgstr "Osobiście nigdy nie dam się zmielić. Ha!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Nie mam pojęcia, co z nich wyrośnie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBIT.GENERIC"
msgid "Running after it would be pointless."
msgstr "Nie ma sensu nawet próbować go złapać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBIT.HELD"
msgid "It's skittish."
msgstr "Ale płochliwy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Lots of excavation work around here."
msgstr "Sporo tu prac wydobywczych."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOLE.SPRING"
msgid "Guess it wasn't structurally sound."
msgstr "Ściany nośne nie były dość mocne."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Welp."
msgstr "No cóż."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "How'd they build these with no thumbs?"
msgstr "Jak one to wybudowały bez kciuków?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINCOAT"
msgid "Very practical."
msgstr "Praktyczne rozwiązanie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINHAT"
msgid "Dry as a daisy. That's the phrase, right?"
msgstr "Sucho jak w korcu maku. Tak to się mówi, co nie?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.BURNT"
msgid "Must fire take everything I love?"
msgstr "Czy ogień musi pożerać wszystko, co kocham?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAINOMETER.GENERIC"
msgid "That's a mighty fine gadget."
msgstr "Bardzo przydatny gadżet."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RATATOUILLE"
msgid "Lots of fresh veggies."
msgstr "Całe mnóstwo świeżych warzyw."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RAZOR"
msgid "Never hurts to have more tools."
msgstr "Od nadmiaru narzędzi jeszcze nikt nie umarł."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REDGEM"
msgid "Glitter doesn't really appeal to me."
msgstr "Nie przepadam za świecidełkami."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REDLANTERN"
msgid "Nothing luckier around here than a light."
msgstr "Światło jest tu na wage złota."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REDMOONEYE"
msgid "You get sawdust in your eye?"
msgstr "Trociny ci wpadły do oka?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REDPOUCH"
msgid "Seems my fortune's changin'."
msgstr "Mój los chyba się odmienia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP"
msgid "Let Max try it first."
msgstr "Niech Max spróbuje pierwszy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_CAP_COOKED"
msgid "Not too interested in trying that."
msgstr "Nie mam ochoty próbować."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's some sorta red mushroom."
msgstr "To jakiś rodzaj czerwonego grzyba."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Leniwy grzyb."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Picked clean. Gotta wait."
msgstr "Wyzbierane do czysta. Trzeba poczekać."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.BURNING"
msgid "Uh..."
msgstr "Uch..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.GENERIC"
msgid "Looks like they're hollow inside."
msgstr "Są puste w środku."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REEDS.PICKED"
msgid "It's on break."
msgstr "Ma przerwę."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REFLECTIVEVEST"
msgid "Workplace safety is a top priority."
msgstr "Przepisy BHP są najważniejsze."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RELIC.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RELIC.BROKEN"
msgid "Broken and waiting for a handywoman to come along."
msgstr "Zepsuty i wymagający uwagi specjalistki."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RELIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RELIC.GENERIC"
msgid "Hand craftsmanship is old hat. Mass production is the future."
msgstr "Manufaktury są reliktem przeszłości. Jutro należy do produkcji masowej!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Can I make the next one?"
msgstr "Mogę zbudować nowe?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "Rickety, but I can use it to build things."
msgstr "Trochę to wszystko koślawe, ale grunt, że działa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Now we get to make another!"
msgstr "Teraz możemy zbudować nowe!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "I guess proximity activates the whirlygigs?"
msgstr "Czyli, że te wihajstry działają zbliżeniowo?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Let's make another."
msgstr "Zbudujmy nowe."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "Not sure how it works, but I'm gonna find out."
msgstr "Nie do końca rozumiem, jak to wszystko działa, ale się dowiem."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "The next one we make'll be better."
msgstr "Następne laboratorium będzie jeszcze lepsze!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESEARCHLAB4.GENERIC"
