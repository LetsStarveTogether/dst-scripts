#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_cave
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_cave"
msgid "This Chest contains Wurt's complete set of Abyssal skin items."
msgstr "Ta skrzynia zawiera wszystkie elementy skórki głębinowej dla Wurt."

#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_deluxe
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_deluxe"
msgid "This Deluxe Chest contains the playable character, Wurt: The Half-Pint, and her complete set of Triumphant, Guest of Honor, and Abyssal skin items."
msgstr "Ta skrzynia luksusowa zawiera grywalną postać - Wurt Małolatę, a także kompletne zestawy skórek: zwycięskiej, wizytowej i głębinowej dla tej postaci."

#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_deluxealt
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_deluxealt"
msgid "This Deluxe Wardrobe contains the Wurt's complete set of Triumphant, Guest of Honor, and Abyssal skin items."
msgstr "Ta szafa luksusowa zawiera kompletne zestawy skórek: zwycięskiej, wizytowej i głębinowej dla Wurt."

#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_formal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_formal"
msgid "This Chest contains Wurt's complete set of Guest of Honor skin items."
msgstr "Ta skrzynia zawiera wszystkie elementy skórki wizytowej dla Wurt."

#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_rose"
msgid "This Chest contains Wurt's complete set of Roseate skin items."
msgstr ""

#. STRINGS.SKIN_DESCRIPTIONS.pack_wurt_shadow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_wurt_shadow"
msgid "This Chest contains Wurt's complete set of Triumphant skin items."
msgstr "Ta skrzynia zawiera wszystkie elementy skórki zwycięskiej dla Wurt."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yotc_builders
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yotc_builders"
msgid "This Chest contains a plethora of belonging skins to remodel your base with."
msgstr "Ta skrzynia zawiera mnóstwo skórek do dobytku, które pozwolą ci odmienić swoją bazę."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yotc_bundle
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yotc_bundle"
msgid "This Chest contains all the belonging skins from the Builder's Belongings Chest, the Fledgling's Belongings Chest, and the Survivalist's Belongings Chest."
msgstr "Ta skrzynia zawiera skórki do dobytku ze skrzyni budowniczego z dobytkiem, skrzyni żółtodzioba z dobytkiem i skrzyni surwiwalowej z dobytkiem."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yotc_fledgling
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yotc_fledgling"
msgid "This Chest contains a myriad of belonging skins to start your adventures with."
msgstr "Ta skrzynia jest pełna skórek do dobytku, z którymi rozpoczniesz swoją przygodę."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yotc_survivalist
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yotc_survivalist"
msgid "This Chest contains a myriad of belonging skins for experienced survivors to equip themselves with."
msgstr "Ta skrzynia jest pełna skórek do dobytku dla doświadczonych surwiwalistów."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_all
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_all"
msgid "This Merrymaker Chest contains the complete survivors Merrymaker series. Contains skins for: Maxwell, Wes, Wigfrid, Winona, Woodie, and WX-78."
msgstr "Ta świąteczna skrzynia zawiera wszystkie zestawy świątecznego rozbitka. Zawiera skórki dla Maxwella, Wesa, Wigfrydy, Winony, Woodiego i WX-78."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_bundle
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_bundle"
msgid "This Merrymaker Chest contains the complete Merrymaker series of survivor and belonging skins."
msgstr "Ta skrzynia świąteczna zawiera kompletne zestawy skórek i dobytku z serii świątecznej."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_items
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_items"
msgid "This Merrymaker Chest contains following skin items: Gingerbread Gate, Gingerbread Fence, Candy Cane, Fluffy Deermuffs, Festive Fungal Lamp."
msgstr "Skrzynia świąteczna zawiera następujące przedmioty do skórek: furtkę z piernika, płot z piernika, słodką laseczkę, puchate jelenauszniki i świąteczną, grzybową lampę."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_wathgrithr
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_yule_wathgrithr"
msgid "This Chest contains Wigfrid's complete set of Merrymaker skin items."
msgstr "Ta skrzynia zawiera wszystkie elementy skórki świątecznej dla Wigfrydy."

#. STRINGS.SKIN_DESCRIPTIONS.pack_yule_waxwell
