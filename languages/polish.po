msgstr "Dzieje się tu coś bardzo dziwnego..."

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_PICK_DISEASE_WARNING"
