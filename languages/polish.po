msgstr "Wszystko można ugotować!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERMELON_SEEDS"
