msgstr "Musisz zrobić wpierw miejsce, tak?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Let them get some shut eye."
msgstr "Czasami trzeba się wyspać."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "No sense having two of the same recipe."
msgstr "Bez sensu mieć dwie takie same receptury."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "How aboot we try that again?"
msgstr "To może spróbujemy jeszcze raz?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "No makin' fun of me, Lucy."
msgstr "Lucy, nie śmiej się ze mnie."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "A lot harder than it looks, eh?"
msgstr "To trudniejsze, niż wygląda, nie?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE"
msgid "Maybe I can find a caribou to ride instead."
msgstr "Może dałoby się znaleźć zamiast tego jakieś karibu?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
