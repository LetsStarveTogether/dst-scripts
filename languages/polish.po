#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_10"
msgid "Only a sucker wouldn't love this."
msgstr "Nie dla mięczaków."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_11"
msgid "Much better tasting than the real thing."
msgstr "Smakują lepiej niż prawdziwe."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_12"
msgid "Did that candy just move?"
msgstr "Czy ten cukierek przypadkiem się nie poruszył?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_13"
msgid "Oh, my poor jaw."
msgstr "Moja biedna szczęka."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_14"
msgid "I don't do well with spice."
msgstr "Źle przyswajam przyprawy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_2"
msgid "What corruption of science grew these?"
msgstr "Dzieło szatańskiej nauki."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_3"
msgid "It's... corn."
msgstr "Czy to... kukurydza?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_4"
msgid "They wriggle on the way down."
msgstr "Łaskoczą w przełyk."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_5"
msgid "My teeth are going to have something to say about this tomorrow."
msgstr "Ciekawe, co moje zęby powiedzą na to jutro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_6"
msgid "I... don't think I'll be eating those."
msgstr "Hmm... Wolę chyba nie próbować."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_7"
msgid "Everyone'll be raisin' a fuss over these."
msgstr "Brakuje tylko sernika."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_8"
msgid "Only a sucker wouldn't love this."
msgstr "Nie dla mięczaków."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENCANDY_9"
msgid "Sticks to your teeth."
msgstr "Klei się do zębów."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Full of grit."
msgstr "Solidna porcja odwagi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "A potent potion."
msgstr "Potężna mikstura."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "I was hoping for something bigger."
msgstr "Nieco mniejszy rozmiar niż można byłoby się spodziewać."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Crystallized inferno."
msgstr "Skrystalizowane piekło."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Infused with transforming such-and-such."
msgstr "Nasycony przemianą taką a śmaką."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "A spectornament I could hang in a tree."
msgstr "Można powiesić sobie taki duchornament na drzewie."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Completely batty decoration."
msgstr "Wielce posępna dekoracja."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "This wood look good hanging somewhere."
msgstr "To drewno w sam raz do tego, aby gdzieś je powiesić."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Almost i-tentacle to the real ones."
msgstr "Macki estetyki są niestrudzone."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Eight-armed adornment."
msgstr "Ozdoba o ośmiu ramionach."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Everyone's raven about tree decorations these days."
msgstr "Każdy stroszy dziś pióra o dobre dekoracje."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMBAT"
msgid "This seems unsanitary."
msgstr "Trochę to chyba niehigieniczne."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER"
msgid "Stop! It's time! To hammer things!"
msgstr "A gdybym był młotkowym?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR"
msgid "It's a heavy hammer for hitting things."
msgstr "Ciężki młot do tłuczenia rzeczy."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT"
msgid "It's not lab-safe!"
msgstr "Do laboratorium się nie nadaje!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE"
msgid "The stinging means that it's working."
msgstr "Piecze, to znaczy, że działa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF"
msgid "It conducts regenerative energy."
msgstr "Przewodzi uzdrawiającą energię."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD"
msgid "That's a cold stone."
msgstr "Zimny kamień."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN"
msgid "It's colder than ice."
msgstr "Zimniejszy niż lód."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC"
msgid "I could manipulate its temperature."
msgstr "Mógłbym zmienić jego temperaturę."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT"
msgid "Nice and toasty hot!"
msgstr "Miły i cieplutki."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM"
msgid "It's quite warm and cuddly... for a rock!"
msgstr "Całkiem ciepły i milutki... jak na kamień!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB"
msgid "Living by yourshellf must get abalonely."
msgstr "Musisz czuć się samotnie w tej pustelni."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "It just needed a little love."
msgstr "Wystarczyło trochę miłości."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "It's just an empty shell of a house."
msgstr "Pusta skorupa po domu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMIT_CRACKED_PEARL"
