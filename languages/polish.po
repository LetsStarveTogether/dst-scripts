msgstr "Ogień, szynka i miód – doskonałe połączenie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYNUGGETS"
msgid "Honey-covered morsels that have met my friend, fire."
msgstr "Pokryte miodem kąski po spotkaniu z moim najlepszym przyjacielem."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORN"
msgid "I can hear those hairy beasts inside."
msgstr "Słyszę wewnątrz te włochate bestie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOTCHILI"
msgid "Now that's my kind of heat!"
msgstr "Takie ciepło lubię!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUND"
msgid "What a jerk!"
msgstr "Co za wredne zwierzę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDBONE"
msgid "Gross."
msgstr "Obrzydliwe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDMOUND"
msgid "Uh oh, I don't like the look of that."
msgstr "Uj... Nie podoba mi się to."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDSTOOTH"
msgid "It's sharp. I like it!"
msgstr "Ostry! Podoba mi się!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE"
msgid "Heh heh. STAY."
msgstr "Heh heh. SIAD."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH"
msgid "What's your angle?"
msgstr "Jakie widzisz poszlaki?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It's too wet to burn."
msgstr "Za dużo wody, by podalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It's still too wet to burn."
msgstr "Wciąż za dużo wody, by podpalić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE"
msgid "Chilly."
msgstr "Zimnawy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEBOX"
msgid "That is the opposite of fire."
msgstr "Odwrotność ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICECREAM"
msgid "Well, soooometimes cold things are okay."
msgstr "No cóż, niektóre zimne rzeczy też są fajne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT"
msgid "It's a real mood dampener."
msgstr "Potrafi schłodzić atmosferę."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND"
msgid "Gross! Cold!"
msgstr "Obrzydliwy! I zimny!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK"
msgid "Fuzzy backpack!"
msgstr "Futrzasty plecak!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF"
msgid "Booooring."
msgstr "Nuuuuuda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Am I seeing things?"
msgstr "Zaczynam mieć zwidy?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "Doesn't look flammable. How boring."
msgstr "Wygląda na zupełnie niepalny. Ale nuda."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF"
msgid "Why didn't anyone tell me I had ashes on my face?"
msgstr "Dlaczego nikt mi nie mówił, że jestem usmarowana popiołem?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.JAMMYPRESERVES"
msgid "Wham, bam, jam! Thank you, ma'am."
msgstr "Marmelada!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.JELLYBEAN"
msgid "Nothing better than a handful of jellybeans."
msgstr "Nie ma to jak garść fasolek."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KABOBS"
msgid "Meat and fire, now with a stick!"
msgstr "Mięso i ogień. I patyczek!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.GENERIC"
msgid "I like the cut of that bee's jib."
msgstr "Fajny ma kolec."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.HELD"
msgid "Buzz!"
msgstr "Bzzz!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS"
msgid "A lump of coal would be really useful, actually!"
msgstr "Przydałby się kawałek węgla!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY"
msgid "Ha! I wouldn't wanna get smacked with that thing!"
msgstr "Ha! Wolałabym tym nie dostać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK"
msgid "Nothing says \"Open Me\" quite like a lock!!"
msgstr "Nic tak nie woła „otwórz mnie!”, jak zamknięty zamek!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT"
msgid "It's a pony!"
msgstr "Kucyk!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks pretty worn down."
msgstr "Trochę się zużył."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER"
msgid "We will be great friends!"
msgstr "Będziemy dobrymi przyjaciółmi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER"
msgid "He sure looks warm..."
msgstr "Wygląda cieplutko..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS"
msgid "Stay back, you big jerk!"
msgstr "Trzymaj się z dala, wredny paskudzie!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS_SACK"
msgid "The holidays came early this year!"
msgstr "Święta przyszły wcześniej w tym roku!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LANTERN"
msgid "Fire is not meant to be contained like this!"
msgstr "Ognia nie można tak ograniczać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Nothing's gonna get through that!"
msgstr "Nic się go nie ima!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That armor looks pretty safe."
msgstr "Ten pancerz wygląda dość bezpiecznie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "This armor isn't very good."
msgstr "Ten pancerz nie jest najlepszy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "It barely does anything."
msgstr "Praktycznie nic nie pomaga."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "This armor will stop a blow or two."
msgstr "Ten pancerz pewnie zatrzyma cios albo dwa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Good for smackin' stuff."
msgstr "W sam raz do obijania się."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I could do neat stuff more often with that."
msgstr "Mogłabym dzięki temu przyrządowi częściej robić fajne rzeczy."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Woohoo! I should put that on."
msgstr "Super! Powinnam się przebrać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Kill that flag!"
msgstr "Zabić tę flagę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE"
msgid "You're always there for me, Bernie."
msgstr "Zawsze mogę na ciebie liczyć, Bernie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Pfft, I bet he can't even fight."
msgstr "Pffff, założę się, że nie umie się nawet bić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Dibs!"
msgstr "Moje!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Woah! I love it!"
msgstr "Łaaa! Ale super!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, gimme!"
msgstr "Dawaj, dawaj!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "It's a feather crown!"
msgstr "Korona z piór!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "FIRE! FIRE! FIRE!"
msgstr "OGIEŃ! OGIEŃ! OGIEŃ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "That's a great wreath!"
msgstr "Ale świetny wieniec!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "I don't even wanna burn it!"
msgstr "Nawet nie mam ochoty go spalić!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "No way I can use that!"
msgstr "Nie ma szans, abym mogła dobyć tego miecza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "There's no key in it."
msgstr "Brakuje klucza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Looks good."
msgstr "Wygląda świetnie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "So pointy!"
msgstr "Ale kolczasty!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LUCY"
msgid "That's Woodie's axe."
msgstr "To siekiera Woodiego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "This is WAY better than our gate back home!"
msgstr "Ta brama jest ZNACZNIE lepsza od naszej!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Time to go."
msgstr "Czas się zbierać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Ohh, I want it!"
msgstr "Ooooch, ja chcę! Ja!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Jerks come out of it."
msgstr "Wyłażą z niego palanci."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'd wear it if I felt like hitting stuff."
msgstr "Gdybym miała ochotę uderzać w rzeczy, to bym go nosiła."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Comes with a matching staff!"
msgstr "No i jest jeszcze kostur do kompletu!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE"
msgid "Why can't we be friends?"
msgstr "Może zostaniemy przyjaciółmi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_COCOON"
msgid "Aw, it lost its fiery personality."
msgstr "Ach, ten ognisty temperament."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "I think a fire is trying to escape."
msgstr "Ogień chyba próbuje się wydostać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "It has a chill."
msgstr "Zimny drań."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "That egg looks happy."
msgstr "Wygląda na szczęśliwe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.CONTENT"
msgid "My own little burninator."
msgstr "Mój własny ognioinator."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.GENERIC"
msgid "She's... perfect."
msgstr "Jest... idealny."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "I think she wants some burnings."
msgstr "Chyba potrzebuje ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.STARVING"
msgid "I can see her ribs!"
msgstr "Widać mu żeberka!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_TOOTH"
msgid "I hope she's not a biter."
msgstr "Mam nadzieję, że nie gryzie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.COOL"
msgid "Cool drool, literally."
msgstr "Zimna pluja."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.HOT"
msgid "The coolest drool!"
msgstr "Gorąca pluja."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND"
msgid "Yes! Yessss!"
msgstr "Tak! Takkkk!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND_ROCK"
msgid "Oh great, another stinkin' rock!"
msgstr "Świetnie. Kolejny śmierdzący kamlot!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF"
msgid "He looks flammable!"
msgstr "Na pewno jest łatwopalny!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF_SPARSE"
msgid "He looks flammable!"
msgstr "Na pewno jest łatwopalny!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LICHEN"
msgid "A gross, crusty plant."
msgstr "Obrzydliwa, łamliwa roślina."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIFEINJECTOR"
msgid "Don't you dare stick that in me!"
msgstr "Nie waż się mnie tym kłuć!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTBULB"
msgid "It's called a \"lightbulb\" but it's kinda heavy."
msgstr "Wkładanie żarówek do buzi podobno może skończyć się tragicznie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTER"
msgid "It's my lucky lighter!"
msgstr "Moja ukochana zapalniczka!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "You're crazy!"
msgstr "Wariat!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "Bouncy goat."
msgstr "Skoczna koza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOATHORN"
msgid "I heard lightning when I held it to my ear."
msgstr "Słyszałam ryk gromu, gdy przytknęłam go do ucha."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Aww, all glow but no fire."
msgstr "Ooo, świeci, a nie ma ognia."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "All the lightning goes here!"
msgstr "Zapraszamy wszystkie błyskawice tutaj!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LITTLE_WALRUS"
msgid "He looks tasty."
msgstr "Wygląda smacznie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGLOG"
msgid "It looks upset."
msgstr "Wygląda na zdenerwowaną."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE"
