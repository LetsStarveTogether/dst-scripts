msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Do you want us to help clean up?"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURPER"
