msgstr "Koniec tego lenistwa! Pora nawijać!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
