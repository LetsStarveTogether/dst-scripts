msgstr "Ale się świeci!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.WARM"
