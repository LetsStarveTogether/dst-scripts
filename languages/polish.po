msgstr "Wierny kompan wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_KITTEN"
msgid "She is a magnificent hunter!"
msgstr "Wspaniały łowca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LAMB"
msgid "I wouldst turn farmer for thee."
msgstr "Dla ciebie mogłabym zostać rolnikiem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Mine lunar friend!"
msgstr "Moja księżycowa przyjaciółka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PERDLING"
msgid "Not a raven, but wise nonetheless."
msgstr "Kruk to to nie jest, ale robi wrażenie bystrego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PUPPY"
msgid "I shall defend this hound to the death."
msgstr "Będę bronić tego psiaka do śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.GENERIC"
msgid "Raven friend!"
msgstr "Mój ptasi przyjacielu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.HELD"
msgid "Together again."
msgstr "Znowu razem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRUMBS"
msgid "Telltale spoor left by a festive foe."
msgstr "Trop charakterystyczny dla świątecznego przeciwnika."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTGRASS"
msgid "A craftwoman's most elemental resource."
msgstr "Najważniejszy surowiec każdej zręcznej kobiety."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLICHEN"
msgid "Even if I ate plants, I wouldn't eat THAT plant."
msgstr "Nawet, gdybym jadała rośliny, nie zjadłabym TEJ rośliny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTREEDS"
msgid "I cleaned all the bugs out! Then I ate them."
msgstr "Pozbyłam się wszelkich robali! A potem je zjadłam."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTSTONE"
msgid "Solid stone!"
msgstr "Twardy kamień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEADLYFEAST"
msgid "A most potent dish."
msgstr "Najpotężniejsze z dań."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEAD_SEA_BONES"
msgid "Njord's depths hold many secrets."
msgstr "Głębiny Njordu skrywają wiele tajemnic."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "The wood's ablaze!"
msgstr "Las płonie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Loge took that one."
msgstr "Loge zabrał go w Zaświaty."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "Ścięty przez prawdziwego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Future firewood!"
msgstr "Czeka go wspaniała kariera drewna na ognisko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "This firewood will take a bit of extra work."
msgstr "To drewno na opał będzie wymagało dodatkowej obróbki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.ANTLER"
msgid "Skadi has bestowed a gift on Freya's creature."
msgstr "Skadi złożyła dar stworzeniu Frei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.GENERIC"
msgid "The beauty of Freya dwells in all creatures!"
msgstr "Piękno Frei mieszka we wszystkich stworzeniach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS"
msgid "Rays will shine through my spear and poke out your eyeball!"
msgstr "Promienie słońca oświetlą mą włócznię. A potem wydłubię ci to oko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Delicious! I should like to share it with my new allies."
msgstr "Wyborne jadło! Podzielę się nim z mymi towarzyszami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_ANTLER"
msgid "The unicorn's horn, in the flesh!"
msgstr "Róg jednorożca! Prawdziwy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_GEMMED"
msgid "Tis a magical woodland creature!"
msgstr "Magiczne leśne stworzenie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's probably a tuft of grass."
msgstr "To chyba zwykła kępka trawy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DESERTHAT"
msgid "Tis no helm."
msgstr "Toć to żaden hełm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL"
msgid "It smells of bacon!"
msgstr "Pachnie boczkiem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL_NODEV"
msgid "I'm not strong enough to wield it."
msgstr "Nie jestem dość potężna, by dzierżyć coś takiego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIRTPILE"
msgid "A small hill of earth."
msgstr "Mała górka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.COLD"
msgid "All is quiet."
msgstr "Cisza i spokój."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.GENERIC"
msgid "A mechanical hunting hound. For the hunt."
msgstr "Mechaniczny psie myśliwski, ruszajmy na polowanie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.HOT"
msgid "Sound the horns! We've arrived!"
msgstr "Zadmijcie w rogi, albowiem jesteśmy na miejscu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARM"
msgid "We've got the scent!"
msgstr "Mamy trop!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARMER"
msgid "The hound is excited. We're getting close."
msgstr "Pies jest podekscytowany. Jesteśmy coraz bliżej."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "What cryptic ruins."
msgstr "Ale straszne ruiny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.READY"
msgid "Seems it's missing a piece..."
msgstr "Chyba czegoś brakuje..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ready! The saga continues!"
msgstr "Gotowe! Saga musi trwać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODSTART"
msgid "This mysterious sword feels important."
msgstr "Ten tajemniczy miecz wydaje się niezwykle ważny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBODYHAT"
msgid "It's the beast's back."
msgstr "Z oskórowanej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONCHILISALAD"
msgid "Yeuch! I was promised a feast!"
msgstr "Uch! Obiecano mi godziwą ucztę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLY"
msgid "Ah, dragon! At last we meet!"
msgstr "Wreszcie się spotykamy, smoku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST"
msgid "This chest is worthy of my weapons."
msgstr "Skrzynia godna opieki nad moim orężem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "It retains the heat of the fallen beast."
msgstr "Utrzymuje ciepło poległej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It has seen much battle."
msgstr "Był świadkiem wielu bitew."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Its belly is alight with fearsome dragonfire."
msgstr "Jego serce wypełnione jest straszliwym smoczym ogniem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "A small inferno burns within."
msgstr "Wewnątrz szaleje małe inferno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT"
msgid "It's very fancy."
msgstr "Niezwykły owoc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Grilled fancy fruit."
msgstr "Pieczony niezwykły owoc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONHEADHAT"
msgid "The head of a great and merciful beast!"
msgstr "Głowa potężnej, lecz łagodnej bestii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONPIE"
msgid "Why isn't this a meat pie? Meat, meeeat!"
msgstr "Dlaczego nie ma w tym mięsa? Mięęęęsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONTAILHAT"
msgid "A beast is no beast without a tail."
msgstr "Bestia bez ogona to nie bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGON_SCALES"
msgid "Mystical scales."
msgstr "Mityczne łuski."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_LOG"
msgid "'Tis wood, forged in the sea's depths!"
msgstr "Drewno pochodzące z morskich głębin!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Tis consumed by flame!"
msgstr "Strawił je ogień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Consumed by Hel's flames."
msgstr "Pochłonęły je płomienie Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Thank you for your bounty, tree."
msgstr "Dziękuję ci za twój dar, drzewo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "A rare beauty to be sure, but tis no Yggdrasil."
msgstr "Nie można odmówić mu piękna, ale daleko mu do Yggdrasila."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK"
msgid "Leg of beastie."
msgstr "Noga bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hooooot meat!"
msgstr "Goooorące mięsko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH"
msgid "I should like to see that returned to the earth goddess."
msgstr "Należy zwrócić to bogini ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I should like to see that returned to the earth goddess."
msgstr "Należy zwrócić to bogini ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_GRASS"
msgid "I should like to see that returned to the earth goddess."
msgstr "Należy zwrócić to bogini ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MARSH_BUSH"
msgid "I should like to see that returned to the earth goddess."
msgstr "Należy zwrócić to bogini ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_SAPLING"
msgid "I should like to see that returned to the earth goddess."
msgstr "Należy zwrócić to bogini ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_TRAP_STARFISH"
msgid "A most wicked trap I could set for my foes."
msgstr "Najbardziej zdradliwa pułapka, jaką można zastawić."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN"
msgid "Smells like my battle boots."
msgstr "Śmierdzi jak moje buty po bitwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_COOKED"
msgid "What was the purpose of cooking this?"
msgstr "Po cóż to piec?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EARMUFFSHAT"
msgid "Yes, most practical!"
msgstr "Tak, to mi się podoba!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL"
msgid "Delicious slimy snake fish."
msgstr "Pyszna, śliska wężowa ryba"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL_COOKED"
msgid "Hot eel!"
msgstr "Gorący węgorz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT"
msgid "Purple and bulbous."
msgstr "Fioletowy i bulwowaty."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_COOKED"
msgid "Food for the weak."
msgstr "Strawa dla słabeuszy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.BURNT"
msgid "It was no challenge at all."
msgstr "Nawet się nie zmęczyłam."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.EMPTY"
msgid "There is no beast beneath."
msgstr "Niczego tu nie ma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "The light burns bright."
msgstr "Światło świeci jasno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.GENERIC"
msgid "Tis a tribute to Freya's beauty."
msgstr "Hołd na cześć piękna Frei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "The light wanes."
msgstr "Światło gaśnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.WILTED"
msgid "Their beauty fades."
msgstr "Ich piękno gaśnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNING"
msgid "The wood's ablaze!"
msgstr "Las płonie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNT"
msgid "Loge took that one."
msgstr "Loge zabrał go w Zaświaty."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "Ścięty przez prawdziwego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.GENERIC"
msgid "I feel at home in the woods."
msgstr "W lesie czuję się jak w domu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "The wood's ablaze!"
msgstr "Las płonie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Loge took that one."
msgstr "Loge zabrał go w Zaświaty."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "Ścięty przez prawdziwego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A good sturdy tree."
msgstr "Porządne drzewo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEBRELLAHAT"
msgid "Don't get rain in your eye!"
msgstr "Nie pozwól, by deszcz napadał ci do oczu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEPLANT"
msgid "Don't point your eyeball at me, foliage!"
msgstr "Nie waż się na mnie patrzeć, roślino!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET"
msgid "The eye of the laser god stares into my soul."
msgstr "Patrzy na mnie oko laserowego boga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET_ITEM"
msgid "An ancient eyeball of protection!"
msgstr "Pradawne oko obronne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.BURNT"
msgid "Serves you right for not growing meats!"
msgstr "I dobrze ci tak. Za to, że nie dajesz mięsa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GENERIC"
msgid "I can't grow meat, what's the point?"
msgstr "Mięsa nie wyhoduję, więc po co to wszystko?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GROWING"
msgid "They're growing stronger."
msgstr "Rosną w siłę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It wants a turd feast."
msgstr "Chce papu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERFAN"
msgid "The luxuries of camp, on the go."
msgstr "Luksusy obozowiska, ale w podróży."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT"
msgid "Seems a bit flashy for battle."
msgstr "Trochę za krzykliwy do bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL"
msgid "Perhaps I'll pen a saga of my journeys!"
msgstr "Może napiszę sagę na podstawie moich przygód!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY"
msgid "In remembrance of a songbird."
msgstr "Pamiątka po pierzastym śpiewaku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW"
msgid "A token from the ravens!"
msgstr "Prezent od kruków!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN"
msgid "Red as my hair."
msgstr "Czerwone jak me włosy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Winter's feather."
msgstr "Zimowe pióro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET"
msgid "She looks unhappy upon her throne."
msgstr "Wygląda dość nieszczęśliwie na swym tronie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE"
msgid "Tis not my kind of fencing."
msgstr "Wolę szranki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE"
msgid "A tiny replica of Valhalla's gates."
msgstr "Mała replika bram Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "Żadnej wartości obronnej. Zwykły pasterski płot."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "Żadnej wartości obronnej. Zwykły pasterski płot."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER"
msgid "Its stench could raise the fallen."
msgstr "Ten smród mógłby ożywić truposza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVEFISH"
msgid "Let us celebrate the season by feasting on fish flesh!"
msgstr "Rybna uczta na cześć świąt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF"
msgid "The gods did not mean thy magic for me."
msgstr "Nie dla mnie bogowie moc twą ukuli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS"
msgid "To strike fear into the hearts of mine enemies!"
msgstr "Zasieją strach w sercach moich wrogów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC"
msgid "Tiny fairy lights aglow!"
msgstr "Małe wróżkowe światełka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD"
msgid "I hold the light!"
msgstr "Jestem panią światła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND"
msgid "The flamed one has no mercy."
msgstr "Płomienisty stwór nie zna litości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS"
msgid "That fire's nearly dead."
msgstr "Ogień już prawie zgasł."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC"
msgid "Warm fire, warm Wigfrid."
msgstr "Ciepły ogień, ciepła Wigfryda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH"
msgid "The fire roars!"
msgstr "Ogień szaleje!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW"
msgid "Fire's slowly dying."
msgstr "Ogień powoli przygasa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL"
msgid "Warm fire, warm Wigfrid."
msgstr "Ciepły ogień, ciepła Wigfryda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT"
msgid "And the light flickers out."
msgstr "Światłość ustępuje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF"
msgid "That we might become Masters of Fire!"
msgstr "Moc ognia nareszcie opanowana!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "The catapult grows weak and tired."
msgstr "Katapulta zaczyna słabnąć!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Time to rest, flinging warrior."
msgstr "Czas odpocząć, mój miotający wojowniku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Catapult engaged for battle!"
msgstr "Katapulta gotowa do walki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH"
msgid "Meat of the sea!"
msgstr "Mięso z morza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGNET"
msgid "I shall feed all my allies for a day!"
msgstr "Moi towarzysze będą syci choć przez jeden dzień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD"
msgid "I'm a ruthless fisherwoman."
msgstr "Jestem bezwzględną wędkarką!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT"
msgid "This sea meat will serve me well."
msgstr "Nie pogardzę morskim mięsem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_COOKED"
msgid "Joy!"
msgstr "Raduje się serce moje!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL"
msgid "This sea meat will serve me well."
msgstr "Nie pogardzę morskim mięsem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "This meat will swim in my belly!"
msgstr "Zaraz będzie pływać w moim brzuchu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS"
msgid "Spears of sea meat."
msgstr "Włócznie z morskiego mięsa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS"
msgid "Fish in a blanket!"
msgstr "Rybka w kocyku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_BOX"
msgid "Meat is best when it's fresh!"
msgstr "Najlepsze jest świeże mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED"
msgid "Joy!"
msgstr "Raduje się serce moje!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT"
msgid "Vital for spear construction."
msgstr "Niezbędny do budowy włóczni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC"
msgid "A flower from Freya."
msgstr "Podarunek Frei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE"
msgid "Were that I smelled half as sweet."
msgstr "Gdybym to ja choć w połowie tak słodko pachniała..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT"
msgid "Flimsy for the fight, enchanting on one's head."
msgstr "Bezużyteczny w boju, lecz czarujący na czyjejś głowie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD"
msgid "Leaves are for animals. Animals are for eating."
msgstr "Liście są dla zwierząt. A zwierzęta są do jedzenia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE"
msgid "And it lit up the night, upon the darkest hour."
msgstr "I jasność rozbłysła w najczarniejszą godzinę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL"
msgid "A terrible evil plagues this flora."
msgstr "Jakieś zło zatruwa te rośliny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED"
msgid "Not enough time in the limelight."
msgstr "Brak mu blasku sławy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE"
msgid "A collection of ferns."
msgstr "Jakieś zielsko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT"
msgid "A pig's bottom made this helmet."
msgstr "Ten hełm zmajstrowała jakaś świńska rzyć."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE"
msgid "Bones of a dark and ancient foe."
msgstr "Kości mrocznego, pradawnego wroga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "It looks as though it might roam the earth any moment!"
msgstr "Wygląda, jakby w każdej chwili mógł się obudzić!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Tis not as majestic as I once pictured."
msgstr "Nie tak majestatyczny jak sobie wyobrażałam."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "All that remains of a terrible beast."
msgstr "Wszystko, co pozostało po niegdyś straszliwej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRESHFRUITCREPES"
msgid "So light and airy!"
msgstr "Cudownie lekkie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD"
msgid "You're a bit slimy for Valhalla."
msgstr "Trochę zbyt oślizgła, żeby dostać się do Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC"
msgid "I'd like some frog boots someday."
msgstr "Chciałabym mieć buty z żabiej skóry."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING"
msgid "It sleeps."
msgstr "Śpi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGFISHBOWL"
msgid "My ally is a god among men."
msgstr "Mój towarzysz jest bogiem kroczącym pośród śmiertelników."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH"
msgid "What a treat!"
msgstr "Ale pycha!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS"
msgid "Filled with rubbery protein!"
msgstr "Pełne gumowatych protein!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED"
msgid "I like when I can see the bones sticking out."
msgstr "Lubię widok wystających kości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Meat impostor!"
msgstr "Oszukane mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I have no need for your fake meat."
msgstr "Nie chcę twojego udawanego mięsa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "Czas na spoczynek!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY"
msgid "Ugh! Putting it into a cup doesn't fool me."
msgstr "Forma podania nie ratuje zawartości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT"
msgid "Fur from a large beastie."
msgstr "Futro potężnej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND"
msgid "Shed your stone form and fight, beast!"
msgstr "Zrzuć swą kamienną zasłonę i stań do walki, bestio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Do not cower behind your carapace of rock! Fight!"
msgstr "Nie chowaj się za kamienną tarczą! Walcz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC"
msgid "Foul ingredient!"
msgstr "Paskudztwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_COOKED"
msgid "The stench!"
msgstr "Cóż za odór!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GAZPACHO"
msgid "My mind doth question Warly's allegiances."
msgstr "Mój umysł podaje w wątpliwość lojalność Warly'ego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS"
msgid "Those might look nice glued to my helm."
msgstr "Wyglądałyby paradnie na mym hełmie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS"
msgid "It lacks its gem."
msgstr "Brakuje klejnotu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID"
msgid "Showtime!"
msgstr "Przedstawienie czas zacząć!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT"
msgid "Goddess of the moon, shine thy smile upon me!"
msgstr "Bogini księżyca, obdarz mnie swym łaskawym uśmiechem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST"
msgid "A spirit trapped between worlds."
msgstr "Dusza uwięziona pomiędzy światami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWER"
msgid "Tis all that remains."
msgstr "To wszystko, co pozostało."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "Tis a powerful elixir!"
msgstr "Potężny eliksir!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT"
msgid "A gift! From... the gods?"
msgstr "To dar! Od... bogów?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP"
msgid "I must show my allies how much they are valued!"
msgstr "Muszę pokazać sojusznikom, jak bardzo ich cenię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADHOUSE"
msgid "Neither a house nor a meal I will enjoy."
msgstr "Ani to dom, ani posiłek."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADPIG"
msgid "You shall not escape me!!"
msgstr "Nie uciekniesz mi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADWARG"
msgid "I will fight thee for defying thy meaty origins."
msgstr "Wyzywam cię do walki za odrzucenie twego mięsnego pochodzenia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK"
msgid "Such beauty!"
msgstr "Cóż za piękno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSCUTTER"
msgid "T'will win any battle, surely!"
msgstr "Dzięki temu z pewnością wygram każdą bitwę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE"
msgid "Twas forged in flame."
msgstr "Artefakt wykuty w płomieniach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.GENERIC"
msgid "A majestic goober."
msgstr "Majestatyczny robal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.SLEEPING"
msgid "It slumbers."
msgstr "Drzemie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "It was once a wonder of the woods."
msgstr "Kiedyś był prawdziwym leśnym cudem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "A wonder of the woods."
msgstr "Prawdziwy leśny cud."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL"
msgid "This slop could be useful."
msgstr "Ta maź może się przydać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS"
msgid "Ohh, look what the goober left for me."
msgstr "Och, popatrz, co ten paskud mi zostawił."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOWBERRYMOUSSE"
msgid "A repulsive vegetable concoction."
msgstr "Odrażająca warzywna mikstura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "The beast's been disarmed!"
msgstr "Bestia rozbrojona!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "You are still a great warrior!"
msgstr "Wciąż jesteś wspaniałym wojownikiem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "Tis a fair and noble beast!"
msgstr "To godziwa i szlachetna bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.GENERIC"
msgid "Draw your weapon and fight me, beastie!"
msgstr "Dobądź swej broni i walcz ze mną, bestyjo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL_HORN"
msgid "A fine horn, indeed!"
msgstr "Zaiste, to wspaniały róg!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK"
msgid "This is powerful milk."
msgstr "Mleko pełne mocy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT"
msgid "T'would be no help in battle."
msgstr "Nie pomoże mi w walce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE"
msgid "A tool of gold!"
msgstr "Narzędzie ze złota!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE"
msgid "Gold for gold."
msgstr "Złoto za złoto."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK"
msgid "A weapon of very wealthy farmers."
msgstr "Broń bardzo bogatych kmieci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL"
msgid "Digging like a king!"
msgstr "Będę kopać jak królowa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET"
msgid "Such a pleasing gold piece."
msgstr "Zadowalająca grudka złota."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER"
msgid "A shieldmaiden deserves a soft bed of dunn."
msgstr "Wojowniczka zasługuje na miękkie łoże z pierza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN"
msgid "The life has gone from it."
msgstr "Życie z niej uciekło."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING"
msgid "Loge looks upon you!"
msgstr "Loge spojrzał na ciebie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED"
msgid "Disease festers within its soul."
msgstr "Jej duszę toczy choroba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "Słabnie na moich oczach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC"
msgid "That could be useful."
msgstr "Może się przydać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED"
msgid "I eagerly await the next harvest."
msgstr "Czekam na nowe zbiory."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED"
msgid "The heat has defeated this plant."
msgstr "Upał dał się jej we znaki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "Alas! It is stricken."
msgstr "Niestety! Leży bez siły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "What flaxen scales."
msgstr "Ale ma delikatne łuski."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA"
msgid "Flowers are not befitting a warrior, but wet armor is even worse."
msgstr "Kwiaty nie przystoją wojowniczce. Ale mokra zbroja tym bardziej."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVY"
msgid "A sauce worthy of the gods themselves!"
msgstr "Sos godny samych bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET"
msgid "Enhanced emerald crafting skills!"
msgstr "Szafirowa biegłość w rzemiośle!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM"
msgid "An emerald stone."
msgstr "Szmaragdowy kamień."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE"
msgid "Odin gave his eye that we might see."
msgstr "Odyn oddał swe oko, byśmy mogli przejrzeć."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF"
msgid "Twirly green power."
msgstr "Zielona moc zniszczenia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP"
msgid "Terrible!"
msgstr "Okropieństwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED"
msgid "Charred by flame or not, that will not touch my lips!"
msgstr "Oczyszczony w płomieniach czy nie, nie dotknie moich ust!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It has risen!"
msgstr "Podniósł łeb!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Hide, coward."
msgstr "Chowaj się do woli, tchórzu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "I see fungal spores."
msgstr "Widzę jego grzybne zarodniki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE"
msgid "Yum, creamy!"
msgstr "Mmm, ale kremowe!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO"
msgid "Hmm, dark wing turds."
msgstr "Hmm, bobki mrocznoskrzydłych."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER"
msgid "Such energy!"
msgstr "Cóż za moc!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1"
msgid "How sinister! I nearly mistook it for a true apple!"
msgstr "Co za diabelstwo! Prawie bym je pomyliła z prawdziwym jabłkiem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10"
msgid "I shall uncover its secret center!"
msgstr "Muszę odkryć jego tajemny środek!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11"
msgid "Tis not meat, but tis close enough!"
msgstr "Mięso to to nie jest, ale całkiem blisko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12"
msgid "They look like that which writhe and crawl."
msgstr "Wyglądają jak to, co pełza i się wije."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13"
msgid "You shalt not break me, confection!"
msgstr "Nie pokonacie mnie, słodycze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14"
msgid "Wretched Hel's fire!"
msgstr "Ogień upiornej Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2"
msgid "A clever ruse. It is not corn at all."
msgstr "Może trafię na mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3"
msgid "A confection to strike terror into any warrior's heart!"
msgstr "Zasieje strach w sercu każdego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4"
msgid "Monsters, prepare to do battle with a Viking's teeth!"
msgstr "Potwory! Przygotujcie się do walki z zębami wikinga!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5"
msgid "The perfect treat!"
msgstr "Słodycz idealna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6"
msgid "What have I done to anger the gods so?"
msgstr "Czymże tak rozwścieczyłam bogów?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7"
msgid "That monarch swine insults me."
msgstr "Wyglądają jak kozie bobki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8"
msgid "I shall uncover its secret center!"
msgstr "Muszę odkryć jego tajemny środek!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9"
msgid "The battle was mighty, yet in the end the worm was consumed!"
msgstr "Walka była zacięta, ale ostatecznie robal został pożarty!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Tis Berserker magic."
msgstr "Toż to magia berserków."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Fortune hath smiled upon me today!"
msgstr "Los zesłał dziś na mnie swój uśmiech!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "A meager reward for my troubles."
msgstr "Nędzna nagroda za moje wysiłki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Hel's fuel."
msgstr "Paliwo Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Changeling elixir."
msgstr "Eliksir przemiany."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Meant to hang from Yggdrasil's kin!"
msgstr "Do wieszania na gałęziach braci Yggdrasila!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Decoration! Prepare to be hung from something!"
msgstr "Dekoracjo! Gotuj się na to, aby gdzieś zawisnąć!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "It shall strike fear unto the hearts of mine foes!"
msgstr "Zasieje lęk w sercach moich wrogów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "'tis but a decoration!"
msgstr "To jeno dekoracja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "It shalt be hung from the highest branch!"
msgstr "Zawiśnie na najwyższym z konarów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Huginn? Or Muninn?"
msgstr "Przytulanie czy zgniatanie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT"
msgid "A weapon fit for the great dining halls!"
msgstr "Broń godna wielkich biesiadnych komnat!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER"
msgid "More fit for labor than battle."
msgstr "Lepszy do pracy niż do walki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR"
msgid "I am worthy!"
msgstr "Jestem godna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT"
msgid "Flowers cannot stop a spear."
msgstr "Kwiaty nie powstrzymają włóczni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE"
msgid "Be filled with life!"
msgstr "Niech wypełni cię życie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF"
msgid "Blessings of magicks within."
msgstr "Błogosławieństwo kryjącej się wewnątrz magii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD"
msgid "The stone has taken on cold!"
msgstr "Kamień zrobił się zimny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN"
msgid "Cold teeth bite at me!"
msgstr "Kąsają mnie zęby mrozu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC"
msgid "A stone of great use!"
msgstr "Niezwykle użyteczny kamień."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT"
msgid "Loge would be proud."
msgstr "Loge byłby dumny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM"
msgid "The stone has taken on warmth!"
msgstr "Kamień zrobił cię ciepły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB"
msgid "Be ye a sea witch? Or just an old crone?"
msgstr "Jestżeś wiedźmą morską? Czy zwykłą staruchą?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "The old crone resides here?"
msgstr "Czy mieszka tutaj starucha?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "The sea witch seems to be pleased with it."
msgstr "Wiedźma morska zdaje się być z tego zadowolona."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "The battle is won, but at what cost?"
msgstr "Bitwa wygrana, ale jakim kosztem?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_PEARL"
msgid "I shall protect it with my life!"
msgstr "Będę tego bronić kosztem własnego życia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT"
msgid "Vikings do not wear horns."
msgstr "Wikingowie nie noszą rogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME"
msgid "Home is where the hearth is!"
msgstr "Ogień jest tam, gdzie palenisko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT"
msgid "Signs of a battle past."
msgstr "Znak minionej bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC"
msgid "A most well placed sign."
msgstr "Właściwy znak we właściwym miejscu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "I shall write a tale of triumph!"
msgstr "Miejsce na opowieść o mych przewagach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY"
msgid "Sticky and gross."
msgstr "Klejąca obrzydliwość."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB"
msgid "Wouldn't make much of a comb."
msgstr "Kiepski byłby z niego plaster."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM"
msgid "A feast!"
msgstr "Ale wyżerka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS"
msgid "A feast!"
msgstr "Ale wyżerka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN"
msgid "How I long for battle."
msgstr "Mam ochotę na porządną bitwę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI"
msgid "A true test of willpower."
msgstr "Prawdziwa próba siły woli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.BOMBED"
msgid "'Tis imbued with the power of the moon!"
msgstr "Nasycone księżycową mocą!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.EMPTY"
msgid "Odd, I do not see the fire giant..."
msgstr "Dziwne, nigdzie nie widzę ognistego giganta..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GENERIC"
msgid "Perhaps a fire giant slumbers beneath!"
msgstr "Może pod spodem drzemie ognisty gigant!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GLASS"
msgid "Oh no! The giant is trapped!"
msgstr "Och, nie! Gigant został uwięziony!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND"
msgid "Fenrir's spawn!"
msgstr "Pomiot Fenrira!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE"
msgid "A fallen foe."
msgstr "Poległy nieprzyjaciel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Burial by fire."
msgstr "Ciałopalenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "Rest well, fallen foe."
msgstr "Spoczywaj w pokoju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "The dead walk again!"
msgstr "Umarli znów chodzą pośród żywych!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND"
msgid "These hounds are true warriors."
msgstr "Te ogary to prawdziwi wojownicy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH"
msgid "A token of a successful conquest."
msgstr "Świadectwo pomyślnych łowów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE"
msgid "It casts a spell upon the dogged beasts."
msgstr "Rzuca urok na psowate maszkary."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH"
msgid "A loyal companion, if ever there were one."
msgstr "Wierny towarzysz, jeśli takowi istnieją."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "An ensconced water sprite!"
msgstr "Co to za wodny duszek?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "An unfortunate casualty of battle."
msgstr "Nieszczęsna ofiara boju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE"
msgid "Reminds me of home."
msgstr "Przypomina mi się dom."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.GENERIC"
msgid "A trap left by the dastardly ice giants, no doubt."
msgstr "Ani chybi to pułapka zastawiona przez tych zdradliwych lodowych gigantów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.MELTED"
msgid "Twas no match for this great heat."
msgstr "Nie miała szans z tym żarem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG_MELTED"
msgid "Twas no match for this great heat."
msgstr "Nie miała szans z tym żarem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX"
msgid "Winter dwells inside!"
msgstr "W środku mieszka zima."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM"
msgid "That stuff hurts my teeth."
msgstr "Bolą mnie od tego zęby."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT"
msgid "A chunk of cold."
msgstr "Na gorącą głowę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND"
msgid "Teeth of frost!"
msgstr "Zębiska mrozu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK"
msgid "A backpack of the beast."
msgstr "Plecak bestii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF"
msgid "A gift from Ullr!"
msgstr "Podarunek Ullra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Woah!"
msgstr "Wow!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "I suspect nothing of this rock."
msgstr "Wygląda na normalny kamień."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF"
msgid "Who is that incredible warrior in the mirror?"
msgstr "Kimże jest ta powalająca wojowniczka w lustrze?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES"
msgid "Sticky and gross."
msgstr "Klejąca obrzydliwość."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN"
msgid "The yield of an industrious candy farmer."
msgstr "Plon przedsiębiorczego hodowcy słodyczy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS"
msgid "A feast!"
msgstr "Wyżerka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP"
msgid "Ridiculous sea vegetable."
msgstr "Głupia morska jarzyna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELPHAT"
msgid "I'd never trade mine helm for this."
msgstr "Nigdy nie wymienię swego hełmu na to coś."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_COOKED"
msgid "Tis even worse than before."
msgstr "Jeszcze gorsze niż przedtem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_DRIED"
msgid "I despise it."
msgstr "Gardzę tym."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC"
msgid "A challenger!"
msgstr "Oto wyzwanie dla wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD"
msgid "A conquered foe."
msgstr "Pokonany nieprzyjaciel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS"
msgid "I shall free thy deer this day!"
msgstr "Dzisiaj twój jeleń będzie chodził wolno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY"
msgid "What wonders will you reveal?"
msgstr "Jakieś cudowności przede mną odkryjesz?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK"
msgid "A secret, kept under lock and key!"
msgstr "Tajemnica, zamknięta na klucz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT"
msgid "I taste a battle on the breeze!"
msgstr "Wiatr niesie ze sobą smak bitwy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "I don't think I'd ride that horse."
msgstr "Wolałabym na niego nie wsiadać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER"
msgid "Dearest creature... I am going to eat you."
msgstr "Najsłodsza istoto... Zamierzam pożreć twe ciało."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER"
msgid "Poor unsuspecting meat beast."
msgstr "Biedna, nieświadoma mięsna bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS"
msgid "You don't scare me, goat!"
msgstr "Nie boję się ciebie, koźle."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK"
msgid "The sack itself is the present."
msgstr "To worek jest prezentem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN"
msgid "A lantern to hold back the night."
msgstr "Latarnia, która powstrzyma mrok."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LATKES"
msgid "My eyes see foul potatoes, but the taste of meat is unmistakable!"
msgstr "Me oczy widzą nikczemne pyry, lecz niechybnie czuję mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I shall not bend to whims of my foes."
msgstr "Nie nagnę się do kaprysów mych wrogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Tis a worthy suit of armor."
msgstr "Zacna zbroja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "That is not fit for a warrior!"
msgstr "Przyodziewek niegodny wojowniczce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "The wearer shalt be fleet of foot."
msgstr "Kto go przywdzieje, cieszyć się będzie znaczną szybkością."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Tis not as sturdy as a warrior would hope."
msgstr "Nie tak odporny, jak można by się spodziewać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Makes the wearer sharp of tooth."
msgstr "Dodaje użytkownikowi chwackości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Makes the wearer keen of mind."
msgstr "Dodaje użytkownikowi siły umysłu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "I shall armor myself for battle!"
msgstr "Przysposobię się do boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Let us down the enemy's standard!"
msgstr "Powalmy no chorągiew wroga!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE"
msgid "The call of battle has arisen in thee!"
msgstr "Poczuj w sercu żar boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Tis a coward who watches the fight."
msgstr "Jeno tchórze zwykli przyglądać się walkom."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Be still my heart! Tis the king of battle helms!"
msgstr "Spokojnie, me serce! Toż to najprzedniejszy z hełmów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Thy fire giant shall fight by our side."
msgstr "Twój płomienny gigant stanie u mego boku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I'd not dabble in thy horrid magic."
msgstr "Wolałabym nie tykać tej magii straszliwej."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Sleipnir bestowed it with swiftness."
msgstr "Sleipnir nasycił go chyżością."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "A barrage of Hel's fire."
msgstr "Szalejący ogień Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "A blessing from Freya is contained within."
msgstr "Freja pobłogosławiła to nakrycie głowy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Tis heavily laden with Freya's blessings."
msgstr "Przesycają go błogosławieństwa Frei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A mighty blade for a mighty battle!"
msgstr "Potężne ostrze dla potężnego boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "The Rainbow Bridge conceals itself."
msgstr "Gdzież podział się tęczowy most..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "The Rainbow Bridge opens!"
msgstr "Tęczowy most ukazuje się mym oczom!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Horns, sharp as the spear of the Valkyrie."
msgstr "Rogi. Ostre niczym włócznia walkirii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY"
msgid "Thy axe is filled with burning passion this day!"
msgstr "Jakże bije zeń paląca pasja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Tis a gate betwixt realms."
msgstr "To brama pomiędzy krainami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "We dive, back into the ether!"
msgstr "Wkroczmy na nowo w eter!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Magic stone, empower my spirit!"
msgstr "Magiczny kamień co przepełnia mą duszę mocą!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Tis most heinous magic!"
msgstr "Odrażające zaklęcia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Empower me with thy Nox strength!"
msgstr "Użycz mi mocy herosów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Twas not made for a warrior."
msgstr "Toż to nie dla wojowniczki rekwizyt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE"
msgid "A fiery foe!"
msgstr "Płomienisty nieprzyjaciel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON"
msgid "The best allies are made in the heat of battle."
msgstr "Najlepszych przyjaciół poznaje się w walce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "A dragon egg!"
msgstr "Smocze jajo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "This egg looks chilly."
msgstr "Chyba można je dotknąć."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It's warm and toasty."
msgstr "Ciepłe. Smaczne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It glows contentedly."
msgstr "Płonie z zadowoleniem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC"
msgid "A faithful, fiery friend."
msgstr "Dzielny, płomienisty przyjaciel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "You must eat to keep your fires burning."
msgstr "Musisz jeść, aby utrzymywać płomienie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING"
msgid "Its fires are dying out."
msgstr "Jego płomienie gasną."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH"
msgid "A fearsome eggy fang!"
msgstr "Straszliwy kieł!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL"
msgid "It's not very scary now, is it?"
msgstr "Nie jest wcale taki straszny, prawda?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT"
msgid "Your fiery pools are no match for me!"
msgstr "Niestraszne mi ogniste kałuże!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND"
msgid "I shall not surrender to the fiery pits!"
msgstr "Nie poddam się mocy ognistych rozpadlin!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK"
msgid "Stone belched forth by the earth's fiery heart!"
msgstr "Kamień wyrzygany wprost z płomienistego serca ziemi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFLOAF"
msgid "It has a suspiciously non-meat smell to it."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATBURGER"
msgid "This will suffice until I find real meat."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "A nightmarish vision... but food nonetheless."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF"
msgid "That is an ancient woodland being."
msgstr "Pradawne leśne stworzenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE"
msgid "That is an ancient woodland being."
msgstr "Pradawne leśne stworzenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN"
msgid "Sky blue nonsense plant."
msgstr "Bezsensowna niebieska roślina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR"
msgid "This will return me to top form."
msgstr "Dzięki temu szybko wrócę do świetnej formy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB"
msgid "Glow!"
msgstr "Świeć!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER"
msgid "It lights the fires of mine heart!"
msgstr "Czuję ogień w mym sercu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "The lightning has made you a unicorn warrior!"
msgstr "Błyskawica zamieniła cię w jednorożca wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "May I call you Unicorn?"
msgstr "Mogę cię nazywać jednorożcem?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN"
msgid "This could deal a lasting blow."
msgstr "Można by nim komuś nieźle przywalić."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Oh, great lightning!"
msgstr "Och, wspaniale, wielka błyskawico!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Bring with you lightning, Donner!"
msgstr "Okiełznaj potęgę błyskawicy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS"
msgid "A spawn of the evil toothed seal."
msgstr "Pomiot straszliwej zębatej foki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG"
msgid "Burning such magic would seem a waste."
msgstr "Szkoda byłoby spalić tak wspaniałe magiczne dzieło."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE"
msgid "A tree of life, but it is not Yggdrasil."
msgstr "Drzewo życia. Choć nie jest to Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT"
msgid "I hath birthed the root of terror!"
msgstr "Oto korzenie wszelkiego zła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It bears the promise of horridness!"
msgstr "Niesie ze sobą obietnicę zła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERBISQUE"
msgid "That's more like it."
msgstr "To jest to!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERDINNER"
msgid "I triumphed over my wobster foe."
msgstr "Zwyciężyłam mego wroga!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING"
msgid "Flaming log!"
msgstr "Płonie ognisko w lesie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC"
msgid "Wood is always of value."
msgstr "Drewno zawsze się przyda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_1"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_10"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_11"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_14"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_18"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7"
msgid "It hath the stench of death upon it."
msgstr "Czuć odór śmierci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "The unicorn smiles upon me this day!"
msgstr "Dzisiaj uśmiechnął się do mnie jednorożec!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY"
msgid "It's nice, but it's no spear."
msgstr "Ładna. Ale nie jest włócznią."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING"
msgid "It brings shame to the might of Yggdrasil."
msgstr "To potwarz dla potęgi Yggdrasilu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT"
msgid "Finally! A useful vegetable."
msgstr "Nareszcie! Warzywo, które się do czegoś nadaje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I will be a meat farmer after all!"
msgstr "Może jednak będę rolniczką. Będę uprawiać mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK"
msgid "A true Viking delicacy!"
msgstr "Przysmak wikingów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB"
msgid "Be there method to this madness?"
msgstr "Gdzież metoda w tym szaleństwie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS"
msgid "I will slay the four-winged beast!"
msgstr "Zgładzę tę czteroskrzydłą bestię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK"
msgid "A trophy from my victory!"
msgstr "Dowód mego zwycięstwa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER"
msgid "The plume of a fallen foe."
msgstr "Pióro poległego nieprzyjaciela."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "A bolt of thine finest bird-cloth!"
msgstr "Bela najlepszego, ptasiego materiału!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET"
msgid "He looks unhappy upon his throne."
msgstr "Nie wygląda na szczęśliwego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE"
msgid "The corpse of the rutabaga still retains its magic."
msgstr "Zwłoki brukwi wciąż przepełnione są magiczną mocą."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP"
msgid "A stew of magic!"
msgstr "Potrawka z magii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE"
msgid "She just wants to go on a rutabaga saga."
msgstr "Szykuje się na brukwiową wyprawę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED"
msgid "Grilled rutabaga."
msgstr "Grillowana brukiew!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED"
msgid "A rutabaga!"
msgstr "Brukiew!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL"
msgid "The fuzzy trophy of a successful battle."
msgstr "Futrzaste trofeum z udanej bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAPSCROLL"
msgid "Mayhaps the ink is invisible!"
msgstr "Może została narysowana atramentem sympatycznym!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLE"
msgid "The warrior stone!"
msgstr "Kamień dla wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN"
msgid "Fee fi fo fum!"
msgstr "Sposób na kamienne bąki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "How dost thou grow?"
msgstr "Jakim cudem rośniesz, kamienna istoto?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLEPILLAR"
msgid "Fit for a palace!"
msgstr "W sam raz do pałacu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLESHRUB"
msgid "Tis a shrub of stone!"
msgstr "Krzew z kamienia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARBLETREE"
msgid "Even the winds cannot knock this tree down."
msgstr "Nawet wiatr nie pokona tego drzewa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Hot log!"
msgstr "Płonący krzak."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.BURNT"
msgid "Burnt down to nothing."
msgstr "Wszystko spalone na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A shrub on guard."
msgstr "Krzew wartownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_BUSH.PICKED"
msgid "What a nuisance."
msgstr "A to pech."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_PLANT"
msgid "Pond foliage."
msgstr "Wodne zielsko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNING"
msgid "It's ablaze!"
msgstr "Pali się!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.BURNT"
msgid "Burnt."
msgstr "Spaliło się."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Another must be planted to maintain the balance of this realm."
msgstr "Trzeba posadzić nowe, aby zachowana została równowaga tych ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A warrior tree."
msgstr "Drzewiasty wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASHEDPOTATOES"
msgid "I'll not be fooled by your new mash-ed form, vegetable!"
msgstr "Nie dam się zwieść twojej nowej postaci, jarzyno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST"
msgid "T'will harness Njord's mighty breath."
msgstr "Pozwoli mi ujarzmić siłę potężnego tchu Njorda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "We shall keep the flame burning bright!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "You may do your worst, oh mighty Thor!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_ITEM"
msgid "To harness the winds upon mine vessel!"
msgstr "Aby ujarzmić potęgę wiatru!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS"
msgid "Let us be off, with the speed of the Valkyrie!"
msgstr "Ruszajmy chyżo niczym Walkiria!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "A winged sail for my vessel."
msgstr "Skrzydlaty żagiel dla mej łodzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELL"
msgid "Arrg! Is that the antagonist to my saga?!"
msgstr "Arrg! Czy to mój nemezis w tej opowieści?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLHEAD"
msgid "I can see into his pores."
msgstr "Widzę jego myśli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLIGHT"
msgid "Dark magic lives here."
msgstr "Tutaj mieszka czarna magia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLLOCK"
msgid "Shall I unlock it?"
msgstr "Mam go otworzyć?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "A mechanical songstress."
msgstr "Mechaniczna śpiewaczka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAXWELLTHRONE"
msgid "I prefer to roam free, my unicorn and I."
msgstr "Wolę wędrować swobodnie, mój jednorożec i ja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT"
msgid "The true fruit of the earth!"
msgstr "Prawdziwy owoc ziemi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATBALLS"
msgid "Tiny feast balls."
msgstr "Mięsne kulki rozkoszy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.BURNT"
msgid "Such a shame."
msgstr "Co za szkoda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE"
msgid "Let's eat!"
msgstr "Czas na żarcie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Tis as dry as an empty well!"
msgstr "Suche jak wiór!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING"
msgid "It's being prepared just the way I like it."
msgstr "Będzie jedzonko. Właśnie takie, jak lubię."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "All this rain isn't helping."
msgstr "Ten deszcz nie pomaga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "All this rain isn't helping."
msgstr "Ten deszcz nie pomaga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "It's drying out nicely."
msgstr "Pięknie się suszy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK.GENERIC"
msgid "Ah! A dangly rack for my meats!"
msgstr "Ach! Źródło smakołyków!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Such a shame."
msgstr "Co za szkoda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The moisture has been vanquished!"
msgstr "Wilgoć poniosła klęskę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Tis as dry as an empty well!"
msgstr "Suche jak wiór!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "It's being prepared just the way I like it."
msgstr "Będzie jedzonko. Właśnie takie, jak lubię."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "All this rain isn't helping."
msgstr "Ten deszcz nie pomaga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "All this rain isn't helping."
msgstr "Ten deszcz nie pomaga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It's drying out nicely."
msgstr "Pięknie się suszy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "I'd be cantankerous too if I were left without meat!"
msgstr "Też byłabym zrzędliwa, gdyby zabrakło mi mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATYSALAD"
msgid "My instincts scream against this."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED"
msgid "Excellent battle provisions."
msgstr "Znakomity prowiant na wojnę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM"
msgid "Die soggy beast fish!"
msgstr "Giń, mokra rybia bestio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD"
msgid "A formidable warrior, to be sure."
msgstr "Ani chybi to groźny wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHAT"
msgid "Tis a deceitful mask."
msgstr "Zwodnicza maska."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT"
msgid "Beheaded. Burnt. Stinky."
msgstr "Bezgłowy. Spalony. Śmierdzący."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC"
msgid "I could smell it from back there!"
msgstr "Czuć go aż stamtąd!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT"
msgid "I won't miss it."
msgstr "Nie będę za nią tęsknić."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Is this dwelling made of fish?"
msgstr "Mieszkanie zrobione z ryb?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Tis the way of things."
msgstr "Takiż to porządek rzeczy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "A home fit for a fish beast."
msgstr "Dom godzien rybiej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING"
msgid "Lord of the fish beasts!"
msgstr "Władca rybich bestii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT"
msgid "The throne hath been set ablaze!"
msgstr "Tron stanął w płomieniach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Have you chosen a chieftain?"
msgstr "Czy wybraliście jarla?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Tis a sad day for the fish beasts."
msgstr "To zły dzień dla rybich bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "The little beast toils away."
msgstr "Mała bestyjka się trudzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "They are lost without their chieftain."
msgstr "Są zagubieni bez swego jarla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Tis a fine fortress for a fish beast."
msgstr "Forteca godna rybiej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_PRINCE"
msgid "Thou art certain he is fit to be leader?"
msgstr "Czy on nada się na jarla?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLE"
msgid "What's this? Battle plans?"
msgstr "Cóż to? Plan bitwy?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "This vessel might have some use."
msgstr "Ta łódź może się do czegoś przydać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT"
msgid "A lighted helm! For the darkness."
msgstr "Świetlisty hełm! Na pohybel ciemności."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIBOATLANTERN"
msgid "The small vessel shall light my way."
msgstr "Mała łódź będzie oświetlać mą drogę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN"
msgid "The chilling breeze reminds me of my frigid home."
msgstr "Ów mróz przejmujący przywodzi mi na myśl dom mój skuty lodem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFLARE"
msgid "Never split thy party!"
msgstr "Nigdy nie rozdzielaj swej drużyny!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC"
msgid "The runes hath been drawn!"
msgstr "Chyba będę potrzebowała okularów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Tis blank as the cloudless sky."
msgstr "Czysty jak bezchmurne niebo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM"
msgid "A surface on which to inscribe ancient runes."
msgstr "Powierzchnia do zapisania pradawnymi runami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR"
msgid "What wonders. Let us duel!"
msgstr "Cóżeś za jeden? Stawaj do walki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST"
msgid "The conquest chest!"
msgstr "Skrzynia podboju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN"
msgid "Can I add it to my helmet?"
msgstr "Czy mogę przystroić nim mój hełm?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND"
msgid "He burrows with reckless abandon."
msgstr "Kopie jak szaleniec."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD"
msgid "A friend for my pocket."
msgstr "Przyjaciel do kieszonki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND"
msgid "Who's under there?"
msgstr "Kto tam jest?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT"
msgid "It's best to use every part of the animal."
msgstr "Potrafię wykorzystać każdą część zwierzęcia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL"
msgid "Something fiendish lives down there."
msgstr "Coś tam mieszka. Coś diabelskiego!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY"
msgid "I don't trust you."
msgstr "Nie ufam ci."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL"
msgid "What horrors dwell within?"
msgstr "Jakież maszkary tam mieszkają?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA"
msgid "Monster casserole."
msgstr "Zapiekanka z potwora."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT"
msgid "Meat of the dark beasts."
msgstr "Mięso mrocznej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED"
msgid "All dried up."
msgstr "Wyschło do cna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERTARTARE"
msgid "Still quivering."
msgstr "Wciąż się trzęsie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN"
msgid "Perhaps it crashed from the heavens."
msgstr "Pewnie spadła z nieba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC"
msgid "What dost thou want, altar?"
msgstr "Czego chcesz, przedziwny ołtarzu?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "It feeds from the power of Mani!"
msgstr "Czerpie moc od Maniego!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED"
msgid "Prepare for glorious battle!"
msgstr "Przygotuj się do wielkiej bitwy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "This shall not please the gods."
msgstr "To nie zadowoli bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Tis light as a feather on the breeze!"
msgstr "Lekki jak piórko na wietrze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "It is my ward, now."
msgstr "To teraz moja podopieczna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Fare thee well, little moth."
msgstr "Żegnaj, mała ćmo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "Tis but a small tree."
msgstr "To jeno małe drzewko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE"
msgid "Mani cannot see us here."
msgstr "Mani nas tu nie widzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC"
msgid "Mani's visage remains, even in the light of day."
msgstr "Oblicze Maniego widoczne jest nawet w świetle dnia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Mani claims the skies!"
msgstr "Mani przejmuje władzę na niebiesiech!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Mani's retired to her realm for the eve."
msgstr "Mani wróciła do swojej krainy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "Mani's power is on the wane."
msgstr "Moc Maniego słabnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "Mani's power grows!"
msgstr "Mani rośnie w siłę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS"
msgid "Tis a most divine substance."
msgstr "Boski materiał."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASSAXE"
msgid "Spirits of the woods stand no chance against me."
msgstr "Duchy lasu nie mają ze mną szans."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_ROCK"
msgid "Mani sent it down himself."
msgstr "Dar Maniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "That must be their fortress."
msgstr "To musi być ich twierdza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER"
msgid "Mani's gift may have some use yet!"
msgstr "Dar Maniego może się na coś przydać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL"
msgid "I shall make an offering!"
msgstr "Złożę ofiarę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET"
msgid "A gift from Mani."
msgstr "Upominek od Maniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED"
msgid "It hath knowledge within!"
msgstr "Wewnątrz skrywała się wiedza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES"
msgid "It has faced Mani's wrath."
msgstr "Musiał zmierzyć się z gniewem Maniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSPIDERDEN"
msgid "I sense battle on the horizon."
msgstr "Czuję, że nadchodzi czas bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Tis a direct line to Mani himself!"
msgstr "Bezpośrednie połączenie z Manim!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "You shall soon be complete once more."
msgstr "Wkrótce ponownie staniesz się całością."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "It is grateful, but my work is not yet done."
msgstr "Jest wdzięczny, ale moja praca jeszcze nieukończona."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_CROWN"
msgid "I wonder how that creature got his claws on this?"
msgstr "Ciekawe, jak ta kreatura to zdobyła?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_GLASS"
msgid "What doth thou want, fair jewel?"
msgstr "Czegóż pragniesz, o piękny klejnocie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Make thy will known to me, idol!"
msgstr "Zdradź mi swą wolę, bożku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "The gods call me to it, I shall not resist."
msgstr "Bogowie mnie wzywają, muszę ich usłuchać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "The gods call me to it, I shall not resist."
msgstr "Bogowie mnie wzywają, muszę ich usłuchać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "The gods call me to it, I shall not resist."
msgstr "Bogowie mnie wzywają, muszę ich usłuchać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_SEED"
msgid "The gods commune to me through thee."
msgstr "Bogowie mówią do mnie przez ciebie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "An eternal light shines from within!"
msgstr "Wnętrze jaśnieje wiecznym światłem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "But a crack in the earth."
msgstr "Zwykła dziura w ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "The old crone has been waging war against the moon's apparitions."
msgstr "Stara wiedźma toczyła bój z księżycowymi zjawami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNING"
msgid "Tis consumed by flame!"
msgstr "Strawił je ogień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNT"
msgid "This tree, twas burnt to the ground."
msgstr "To drzewo spaliło się na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "Ścięty przez prawdziwego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.GENERIC"
msgid "Tis lovely as Yggdrasil's picture in my mind."
msgstr "Piękne niczym Yggdrasil."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Tis most beauteous in the moonlight."
msgstr "Światło księżyca wydobywa jego piękno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE"
msgid "I wish I could ride it into battle."
msgstr "Chciałabym pojechać na takiej do bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG"
msgid "Something is bouncing around inside."
msgstr "Coś się tam w środku rusza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "A nest of adorable villainy."
msgstr "Siedlisko uroczej podłości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOQUECA"
msgid "A treat for mine senses!"
msgstr "Uczta dla zmysłów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC"
msgid "Ugh! These things are useless!"
msgstr "Ugh! Te paskudy są kompletnie bezużyteczne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD"
msgid "Settle demon fury!"
msgstr "Furia poskromiona!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK"
msgid "The blood will make me strong."
msgstr "Krew mnie wzmocni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING"
msgid "You are not large enough to be a steed."
msgstr "Jesteś za mały, żeby być wierzchowcem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG"
msgid "Loot trumped desecration!"
msgstr "Chciwość przezwyciężyła lęk przed bogami!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC"
msgid "Are there treasures beneath the gravestones?"
msgstr "Czyżby pod ziemią zostały jakieś skarby?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULLEDDRINK"
msgid "Ha ha! Another!"
msgstr "Ha, ha! Jeszcze jednego!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "It makes me long for the stage!"
msgstr "Sposób na bohaterskie wyjście."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "It hath a glow about it."
msgstr "Co za piękny blask."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "A warrior's tool!"
msgstr "Narzędzie wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB"
msgid "Defend thyselves, my allies!"
msgstr "Brońcie się, towarzysze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT"
msgid "This helm runs flush with the forest's magic!"
msgstr "Hełm przepełniony magią lasu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Naught but ash."
msgstr "Kupa popiołu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Destroy the source of its unholy power!"
msgstr "Trzeba zniszczyć źródło tej nieczystej mocy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Twas consumed by a mighty inferno!"
msgstr "Pochłonięta przez potężne inferno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "An empty home for forest sprites."
msgstr "Pusty dom leśnych chochlików."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It is growing strong and hearty."
msgstr "Rosną silne i zdrowe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "A blight has beset this log. Another!"
msgstr "Zaraz dopadła tę kłodę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Not all can withstand the frost giant's touch."
msgstr "Nie każdy zdolny jest przetrwać dotyk mroźnego olbrzyma."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The forest sprite has taken root."
msgstr "Leśny chochlik zapuścił korzenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "The forest sprite has returned a glorious bounty!"
msgstr "Leśny chochlik przyniósł obfity łup!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Laid to waste."
msgstr "I wszystko na marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "A gift from the earth."
msgstr "Dar ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Tis a spotted spotlight!"
msgstr "Światełko w lesie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Twas consumed by Hel's fire."
msgstr "Strawione przez ogień piekielny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I demand strong, passionate colors. Red!"
msgstr "Żądam wyrazistych, płomiennych kolorów. Żądam czerwieni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Behold! It blazes bright!"
msgstr "Strzeżcie się, albowiem płomień sięga niebios!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "What a great effect!"
msgstr "Wspaniały efekt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "I do like its glow."
msgstr "Podoba mi się ta poświata."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "I'll fight alongside you any day!"
msgstr "W blasku twym walczyć będę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I don't care for mushrooms."
msgstr "Grzyby mam gdzieś."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "An enthusiastic performance!"
msgstr "Radosne przedstawienie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "What magic is this?"
msgstr "Co to za magiczne sztuczki?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "This mushroom needs to be retired."
msgstr "Czas, aby ten grzyb przeszedł na zasłużoną emeryturę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "May you find rest."
msgstr "Obyś odnalazł spokój."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "What infernal creature doth mine eyes see!"
msgstr "Cóż to za piekielną istotę widzą moje oczy?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "The beast slumbers soundly."
msgstr "Bestia chrapie równo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Rest well, wicked spirit."
msgstr "Spoczywaj w pokoju, podłe stworzenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Hel's influence has corrupted thee, no doubt!"
msgstr "Ani chybi skaził cię wpływ Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "It slumbers soundly."
msgstr "Drzemie równo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT"
msgid "I'm more comfortable around my own fire."
msgstr "Dużo pewniej się czuję przy własnym ognisku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL"
msgid "The fuel of darkness!"
msgstr "Paliwo ze świata mroku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT"
msgid "It harnesses dark powers from beneath."
msgstr "Czerpie mroczną energię z podziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREPIE"
msgid "I am wary of this pie."
msgstr "Budzi we mnie niepokój."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Nothing stirs."
msgstr "Spokój i cisza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Barely any magic remains."
msgstr "Cała magia uleciała..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The magic slumbers far from here."
msgstr "Magia szybuje gdzieś daleko stąd."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The magic power holds steady."
msgstr "Poziom magii wydaje się stabilny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "It's starting to retreat!"
msgstr "Zaczyna się przerzedzać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's starting..."
msgstr "Zaczyna się..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The magic is heightening!"
msgstr "Magia gęstnieje!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK"
msgid "A weapon worthy of Thor."
msgstr "Broń godna Thora."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD"
msgid "It takes a brave warrior to wield this sword."
msgstr "Potrzeba dzielnego wojownika, by dzierżyć taki miecz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE"
msgid "It contains explosive components."
msgstr "Zawiera wybuchowe pierwiastki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR"
msgid "The Norseman's way to sail!"
msgstr "Tak żegluje Lud Północy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_DRIFTWOOD"
msgid "Back to the sea!"
msgstr "Z powrotem do morza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.EMPTY"
msgid "Naught but a barren basin."
msgstr "Jeno pusta miednica."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.GENERIC"
msgid "Perhaps a sword-wielding maiden lies beneath."
msgstr "Być może odnajdę tam dziewicę w miecz ostry zbrojną."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Tis naught but a clump of mud and grass!"
msgstr "To jeno gruda błota i trawy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "My keen hunter's eyes can detect the smallest nibble!"
msgstr "Moje bystre oczy łowczyni wypatrzą najmniejszy ruch!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "Fly straight and true!"
msgstr "Leć prosto do celu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "Fly straight and true!"
msgstr "Leć prosto do celu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "Njoror, guide my line!"
msgstr "Njororze, kieruj mą żyłką!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "Njoror, guide my line!"
msgstr "Njororze, kieruj mą żyłką!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "The line hath need of a float."
msgstr "Żyłce trzeba spławika."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "My keen hunter's eyes can detect the smallest nibble!"
msgstr "Moje bystre oczy łowczyni wypatrzą najmniejszy ruch!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Fly straight and true!"
msgstr "Leć prosto do celu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Fly straight and true!"
msgstr "Leć prosto do celu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "It doth feel a bit like cheating..."
msgstr "To trochę nieczysta zagrywka..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "Only the greatest of fish will dare take a bite!"
msgstr "Jedynie największe ryby odważą się tego skosztować!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "The old crone has enchanted it to work best in the rain."
msgstr "Stara wiedźma zaczarowała to tak, by sprawdzało się podczas deszczu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "The old crone has enchanted it to work best in the snow."
msgstr "Stara wiedźma zaczarowała to tak, by sprawdzało się podczas opadu śniegu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "A cunning ruse, indeed."
msgstr "Zaiste, przebiegły fortel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "A cunning ruse, indeed."
msgstr "Zaiste, przebiegły fortel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "A cunning ruse, indeed."
msgstr "Zaiste, przebiegły fortel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "This should attract their attention!"
msgstr "To powinno przyciągnąć ich uwagę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "This should attract their attention!"
msgstr "To powinno przyciągnąć ich uwagę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "This should attract their attention!"
msgstr "To powinno przyciągnąć ich uwagę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD"
msgid "Tremble before me, creatures of the deep!"
msgstr "Drżyjcie przede mną, stworzenia z głębin!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Meat is meat."
msgstr "Mięso to mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "You will make a fine meal!"
msgstr "Będzie z ciebie pyszny obiad!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "The beastie put up an admirable fight."
msgstr "Bestyjka dzielnie walczyła."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "There's an air of ill luck around this one..."
msgstr "Roztacza pechową aurę..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "This looks suspiciously veggie-like."
msgstr "Podejrzanie przypomina warzywo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Your bad luck is my good fortune, beastie."
msgstr "Twój pech jest moim szczęściem, bestyjo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Your bad luck is my good fortune, beastie."
msgstr "Twój pech jest moim szczęściem, bestyjo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It must hail from the icy waters of Niflheim."
msgstr "Pewno przybyła z lodowatych wód Niflheimu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_1"
msgid "Tis barely a morsel!"
msgstr "Ledwie starczy na jeden kęs!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_2"
msgid "There's barely any meat on these fishbones!"
msgstr "Na tych ościach prawie nie ma mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_3"
msgid "Tis only a wee beastie."
msgstr "To tylko mała bestyjka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_4"
msgid "This amount of meat will hardly satisfy a Viking!"
msgstr "Tyle mięsa ledwie starczy dla wikinga!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Tis naught but a small snack."
msgstr "Jeno mała przekąska."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_6"
msgid "It is suspiciously leafy."
msgstr "Podejrzanie liściasta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Are ye fish or flower?"
msgstr "Ty żeś ryba li kwiat?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_8"
msgid "By Sól! It wields the power of the sun!"
msgstr "Na Sol! Posiada moc słońca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_9"
msgid "You dare spit at a Viking warrior?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND"
msgid "Sing with me! We are the guardians of Asgard!"
msgstr "Śpiewaj ze mną! Jesteśmy strażnikami Asgardu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION"
msgid "I dare thee, provoke tears from mine eyes!"
msgstr "Wyzywam cię! Wyciśnij łzy z mych oczu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_COOKED"
msgid "It has been vanquished with fire."
msgstr "Została pokonana przez ogień."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM"
msgid "The spoils of war!"
msgstr "Wojenne łupy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF"
msgid "It weaves the cold from thin air!"
msgstr "Wydobywa chłód z powietrza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET"
msgid "Gathering has never been so easy."
msgstr "Zbieranie przedmiotów jeszcze nigdy nie było tak proste."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM"
msgid "A stone of orange."
msgstr "Kamień pomarańczowej barwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE"
msgid "May Odin guide us."
msgstr "Niech Odyn nas prowadzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF"
msgid "A staff of magical movement."
msgstr "Berło magicznego przeniesienia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST"
msgid "It contains a mystery."
msgstr "Skrzynia tajemnic."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANETTONE"
msgid "My eyes doth deceive me, tis surely meat."
msgstr "Oczy mnie mylą, to ani chybi mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE"
msgid "I prefer to face my enemies awake."
msgstr "Wolę walczyć z przytomnymi rywalami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS"
msgid "May it carry forth the record of my saga."
msgstr "Niechaj nosi świadectwo mych dokonań."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAVLOVA"
msgid "Once the berries hath been removed, tis a fine dessert indeed."
msgstr "Po wyjęciu porzeczek robi się jadalna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK"
msgid "You will be felled this day."
msgstr "Nadszedł dzień twego kresu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN"
msgid "Birds of the sea, come from afar."
msgstr "Nadmorski ptak z hen, hen daleka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER"
msgid "Its mere presence offends me."
msgstr "Sama jej obecność jest dla mnie obelgą."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPERPOPPER"
msgid "Back, vile vegetables!"
msgstr "Cofnijcie się, nikczemne jarzyny!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_COOKED"
msgid "It is not worthy of my consumption."
msgstr "Nie jest godna, bym ją spożyła."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_SEEDS"
msgid "Smaller versions of vegetables still offend me."
msgstr "Nawet takie pomniejszone warzywa wciąż są obelżywe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD"
msgid "You cannot run forever!"
msgstr "Nie możesz wiecznie uciekać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN"
msgid "Tis a fan for mine hand."
msgstr "Pióro w sam raz do mej ręki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT"
msgid "Laid to waste."
msgstr "I wszystko na marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We must give it the gift of life."
msgstr "Musimy dać mu dar życia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC"
msgid "What treasures shall I bestow upon thee?"
msgstr "Jakie skarby mam ci ofiarować?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES"
msgid "Pockets of meat."
msgstr "Mięsne kieszonki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS"
msgid "Thank you Froh for this gift!"
msgstr "Dzięki ci, Frohu, za te dary!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL"
msgid "These were not made by Froh."
msgstr "Nie są dziełem Froha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "Sama ma obecność wystarczy, by zasiać panikę w ich drewnianych sercach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM"
msgid "The secretions of a terrible beast!"
msgstr "Wydzielina straszliwego stwora!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE"
msgid "A trusty tool for securing spear and helm materials."
msgstr "Wyśmienite narzędzie do pozyskiwania składników hełmów i włóczni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKLEDHERRING"
msgid "A briny taste of the sea!"
msgstr "Słony posmak morza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1"
msgid "The warrior spirit runs deep within him."
msgstr "Jego członki nasyca wojownicza dusza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2"
msgid "He rages with berserker fury."
msgstr "Płonie furią berserka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3"
msgid "He shall not soil mine warrior reputation!"
msgstr "Nie pozwolę ci zszargać mej reputacji nieustraszonej wojowniczki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4"
msgid "Hath the strength of Yggdrasil."
msgstr "Bije zeń siła godna Yggdrasilu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER1"
msgid "The warrior spirit runs deep within him."
msgstr "Jego członki nasyca wojownicza dusza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER2"
msgid "He rages with berserker fury."
msgstr "Płonie furią berserka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER3"
msgid "He shall not soil mine warrior reputation!"
msgstr "Nie pozwolę ci zszargać mej reputacji nieustraszonej wojowniczki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER4"
msgid "Hath the strength of Yggdrasil."
msgstr "Bije zeń siła godna Yggdrasilu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD"
msgid "He is battle ready, I can tell."
msgstr "Gotowy do walki, to jasne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK"
msgid "The pig died with honor, then gave to me this pack."
msgstr "Prosiak poległ z honorem i podarował mi ten plecak."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT"
msgid "Normally I like a good roast, but this is not right."
msgstr "Lubię dobrze wypieczone, ale to już przesada."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC"
msgid "This is savagery."
msgstr "Co za barbarzyństwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT"
msgid "Loge did not smile upon you this day."
msgstr "Nie zyskałeś dziś łaski Loge'a."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL"
msgid "Come out and go to war with me!"
msgstr "Wyjdź i wyrusz ze mną na wojnę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC"
msgid "I did not think pigs could make houses."
msgstr "Nie wiedziałam, że świnie potrafią budować domy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Do you not hunger for battle, pig?"
msgstr "Nie pragniesz ruszyć do bitwy, prosiaku?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING"
msgid "Is it pig-Odin?"
msgstr "Czy to Świnodyn?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD"
msgid "He died with honor."
msgstr "Zginął z honorem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER"
msgid "We ride to battle!"
msgstr "Idziemy na wojnę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC"
msgid "Will you fight alongside me, pig?"
msgstr "Czy staniesz do walki u mego boku, prosiaczku?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD"
msgid "That pig looks brave."
msgstr "Ten prosiak wygląda na odważnego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG"
msgid "It has been tainted by Fenrir."
msgstr "Został odmieniony przez Fenrira."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "I wszystko na marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Like me, it hungers only for meat."
msgstr "Tak, jak i ja, pragnie zatopić zęby w mięsiwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC"
msgid "'Tis a tribute worthy of the Pig Gods."
msgstr "Oto ofiara godna Świńskich Bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN"
msgid "The hide of a pig creature."
msgstr "Skóra zdarta ze świniaka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT"
msgid "It smells of breakfast!"
msgstr "Pachnie śniadaniem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH"
msgid "Do these pigs worship Loge?"
msgstr "Czy te prosiaki czczą Loge'a?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_COIN"
msgid "The king of pigs hath granted me this favor."
msgstr "Król świń mi to podarował."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN"
msgid "The belt of a mighty pig warrior."
msgstr "Pas potężnego wojownika prosiaków."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE"
msgid "This baby tree is well protected by spiky armor."
msgstr "Małe drzewko doskonale chronione kolczastym pancerzem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING"
msgid "It has shed its armor. Grow, baby tree!"
msgstr "Zrzuciło pancerz. Rośnij, drzewko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK"
msgid "A weapon for farmers."
msgstr "Broń dla rolników."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT"
msgid "I suppose it's close enough."
msgstr "Chyba może być..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED"
msgid "Still green, but it'll do."
msgstr "Wciąż jest zielone, ale powinno dać radę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "A plant."
msgstr "Roślina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "I am a shieldmaiden, not a farmer!"
msgstr "Jestem wojowniczką, nie rolniczką!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY"
msgid "Ugh, vegetables. I'm not sure what I expected..."
msgstr "Ugh. Warzywa. Nie wiem, czego się spodziewałam..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Bested by the sun."
msgstr "Słońce zwyciężyło."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER"
msgid "If %s is looking for trouble, I shall give it to them!"
msgstr "Jeśli %s szuka zwady, ma ja dlań zwadę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Forged in flame!"
msgstr "Zahartowane ogniem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC"
msgid "Good health to you, %s!"
msgstr "Końskiego zdrowia, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "%s potrzebuje serca. To ożywi ducha i ciało."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! To battle!"
msgstr "Morderstwo! Do broni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER"
msgid "Freya smiles on %s."
msgstr "%s cieszy się przychylnością Frei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKET_SCALE"
msgid "How did I fare with my catch?"
msgstr "Jak mi poszło?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLISHCOOKIE"
msgid "My nose shall not be deceived, these are surely meat!"
msgstr "Mojego nosa nie można zwieść, to ani chybi mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE"
msgid "Fruity flesh."
msgstr "Owocowe mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED"
msgid "Seared fruit flesh."
msgstr "Pieczone mięso owocu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND"
msgid "Something lurks in the deep."
msgstr "Coś się czai w głębinach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDEEL"
msgid "Delicious slimy snake fish."
msgstr "Pyszna, śliska wężowa ryba"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDFISH"
msgid "Pond meat!"
msgstr "Mięso ze stawu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE"
msgid "Ancient flora."
msgstr "Pradawna roślina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP"
msgid "If only I could use it as camouflage from predators."
msgstr "Gdybym tylko mogła wykorzystać je jako kamuflaż przed drapieżnikami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "It does battle with food."
msgstr "Toczy bój z jedzeniem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "My belly rumbles... make haste, cookpot!"
msgstr "Burczy mi w brzuchu... chyżo, garnku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "This will be done swiftly!"
msgstr "Wkrótce będzie gotowe!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Is there meat to be consumed?"
msgstr "Czy jest tu jakieś mięso?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Not even a morsel left inside..."
msgstr "Nie zostały nawet okruszki..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Cooking, a noble profession."
msgstr "Gotowanie, szlachetna profesja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Its task has come to an end."
msgstr "Wykonał swe zadanie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "A formidable weapon against bad meals."
msgstr "Potężna broń przeciwko mdłej strawie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT"
msgid "Tis a finely made shelter indeed!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT_ITEM"
msgid "My talent lies in battle, not in building."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO"
msgid "Vileness emerged from the earth."
msgstr "Wcielenie zła, które wyłoniło się z gleby."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSOUFFLE"
msgid "What treachery is this?"
msgstr "Cóż to za sztuczki?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOTORNADO"
msgid "Blech."
msgstr "Ble."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_COOKED"
msgid "It is of no use to me."
msgstr "Na nic mi się nie zda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN"
msgid "What are you meant to do with such a thing?"
msgstr "Cóż począć z tym ustrojstwem?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE"
msgid "What in the name of the unicorn is this?"
msgstr "Na galopujące jednorożce, co to takiego?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.GENERIC"
msgid "Cutest flying meat."
msgstr "Śliczne latające mięsko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.HELD"
msgid "Thou art safe with me, sea meat."
msgstr "Jesteś ze mną bezpieczne, morskie mięsko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "Czas na spoczynek!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN"
msgid "It might make a good bludgeon, at least."
msgstr "Byłaby z niej nie najgorsza maczuga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE"
msgid "Baked all the life out of it."
msgstr "Wypiekłam z nich całe życie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINPIE"
msgid "Tis surely a delicious meat pie in disguise!"
msgstr "Zapiekanka mięsna w przebraniu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED"
msgid "Piping hot orange mush."
msgstr "Gorąca pomarańczowa papka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN"
msgid "Do you wish to fight, vegetable?"
msgstr "Chcesz się bić, warzywo?!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET"
msgid "An amulet of dark powers."
msgstr "Amulet pełen mrocznej mocy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM"
msgid "It is clouded by a mysterious energy."
msgstr "Spowija ją tajemnicza energia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE"
msgid "Odin's eye guides our path."
msgstr "Oko Odyna wskazuje nam drogę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "Accept my offering, oh mighty gods."
msgstr "Przyjmijcie mą ofiarę, o potężni bogowie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "The beast grows restless when tis not fed."
msgstr "Głód bestii rośnie, gdy ta nie jest karmiona."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "'Tis a post. Unworthy of mine attention."
msgstr "Toż to słupek. Nie jest wart mej uwagi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "It climbeth the walls."
msgstr "Pnie się po murach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A colossal queen."
msgstr "Gigantyczna królowa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Servant of a terrible god."
msgstr "Sługa okrutnego boga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "'Tis dedicated to its god."
msgstr "Poświęcona swemu bóstwu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Its days of war are past."
msgstr "Jego dni wojny minęły już dawno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "'Tis barren."
msgstr "Jałowe strony."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "'Tis a fancy bowl."
msgstr "Urokliwa to miska."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "It will hold much meat."
msgstr "Zmieści się tu wiele miejsce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "A container for food."
msgstr "Pojemnik na jedzenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1"
msgid "Treasure!"
msgstr "Skarb!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2"
msgid "Coin! Prepare to be spent!"
msgstr "Monety! Zostaniecie wkrótce wydane!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3"
msgid "Fortune is mine!"
msgstr "Fortuna uśmiecha się do mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4"
msgid "I have earned the god's favor!"
msgstr "Zasłużyłam sobie na przychylność bogów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "T'would be an honor to be fed to the sky god, beast."
msgstr "Jakimż zaszczytem musi być możliwość nakarmienia bóstwa niebios, zwierzu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Tis a delicacy!"
msgstr "Cóż za przysmak!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "It doth trap sea-meat."
msgstr "W trzewiach jej morskie mięso ginie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN"
msgid "Tis not food fit for a god."
msgstr "Nie jest to żywność godna boga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR"
msgid "The wheat hath fallen in battle."
msgstr "Zboże, które upadło w boju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "This is certain to anger the god."
msgstr "Z pewnością rozeźli boga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I shall offer it to the great god!"
msgstr "Złożę je w ofierze wielkiemu bogu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This shall quench the god's appetite."
msgstr "Zaspokoi głód boga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "'Tis what the Gnaw desires, paltry though it is."
msgstr "Oto, czego chce Gryzień, chociaż jest to marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "The Gnaw desires... not this."
msgstr "Gryzień żąda... No, nie tego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Consumed by Hel's fire."
msgstr "Pochłonął je ogień Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Foul ingredient for sacrificial foods!"
msgstr "Podły składnik ofiarnych dań!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "The stench!"
msgstr "Cóż za odór!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID"
msgid "Ah, the sweet innocence of youth."
msgstr "Ach, słodka niewinność młodości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "It came from an animal, yet is still not meat!"
msgstr "Z ciała zwierzęcego zrodzone, a mięsem nie jest!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "A woman of good taste, like mineself!"
msgstr "Kobieta o wyszukanym smaku. Tak, jak ja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL"
msgid "It touches meat with the fires of Hel."
msgstr "Smaga mięso płomieniami Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "An instrument of the savory."
msgstr "Narzędzie smakosza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "It touches meat with the fires of Hel."
msgstr "Smaga mięso płomieniami Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "It doth not work like this."
msgstr "To tak nie działa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE"
msgid "Tis a farming weapon."
msgstr "To przyrząd rolniczy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY"
msgid "'Tis the key to treasure!"
msgstr "Oto klucz do skarbów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "Tis the key to Valhalla's gates."
msgstr "To klucz do bram Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Tis a magic light, surely."
msgstr "To magiczny blask. Bez ochyby."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "'Tis a magic light of short stature."
msgstr "Oto magiczny blask o haniebnej mocy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "A weapon for wheat!"
msgstr "Młot na zboże!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "What horrid home!"
msgstr "Cóż za obmierzła chata!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "'Tis full of goods."
msgstr "Pełen skarbów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "'Tis full of goods."
msgstr "Pełen skarbów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Non-meat, I shall not consume thee!"
msgstr "Nie-mięso, nie pożrę cię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Growing non-meat fungus."
msgstr "Do rozwoju grzyba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "'Tis vanquished."
msgstr "Wróg pokonany."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION"
msgid "I dare thee, provoke tears from mine eyes!"
msgstr "Wyzywam cię! Wyciśnij łzy z mych oczu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "The gods shall deal with thee!"
msgstr "Bogowie się z tobą rozprawią!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN"
msgid "I shall cook things in thee!"
msgstr "Upiekę w twych trzewiach jadło!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "'Tis an instrument to vanquish food."
msgstr "Przyrząd do walki z jedzeniem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "'Tis a fencing spear."
msgstr "Toż to włócznia parkowa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "'Tis a Valkyrie."
msgstr "To walkiria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "'Tis a Valkyrie."
msgstr "To walkiria."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Water of life! But no water!"
msgstr "Woda życia! Ale brak tu wody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Valhalla's gate is opened to me."
msgstr "Wrota Walhalli stoją przede mną otworem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Thou shalt not keep me out!"
msgstr "Nie powstrzymasz mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "'Tis a runestone."
msgstr "To kamień runiczny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Remnants of a Viking funeral."
msgstr "Pozostałość po pogrzebie wikinga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Thou cannot hide from me!"
msgstr "Nie skryjesz się przede mną!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Tis slain."
msgstr "Nie żyje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "Be you tasty?"
msgstr "Jak smakujesz?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It slumbers soundly."
msgstr "Drzemie równo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "'Tis a fancy plate."
msgstr "Elegancka patera."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Be it a hot spring?"
msgstr "Czyżby gorące źródło?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Tis closed to us."
msgstr "Niedostępny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "'Tis the key to another world."
msgstr "To klucz do innego świata."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT"
msgid "Room for more meat!"
msgstr "Miejsce na więcej mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO"
msgid "Vileness emerged from the earth."
msgstr "Wcielenie zła, które wyłoniło się z gleby."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Useful only for sacrifice."
msgstr "Nadaje się wyłącznie do ofiar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "It hangeth pots."
msgstr "Do wieszania garnków."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "'Tis no use to me in this form."
msgstr "W tej formie na nic mi się nie zda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "We shall fill thee with meat!"
msgstr "Wypełnię cię mięsem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "For the making of godly nectars!"
msgstr "Służy do produkcji boskich nektarów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "T'would never grace a hall in Valhalla."
msgstr "Niegodne to wspaniałych komnat Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "A felled metal steed."
msgstr "Pokonany wierzchowiec z metalu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Twas pillaged long ago."
msgstr "Zrabowano ją dawno temu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Twas the site of a vicious raid."
msgstr "Miał tu miejsce bestialski najazd."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It hath fallen."
msgstr "Upadł."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Nothing of value remains."
msgstr "Nie ma tu nic wartościowego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "The time is nigh!"
msgstr "Nadchodzi kres!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The time is nigh!"
msgstr "Nadchodzi kres!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Pillaged. But by what?"
msgstr "Splądrowane. Ale przez kogo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "If only they'd had a warrior to fight for them."
msgstr "Ach, gdyby tak znalazł się wśród nich choć jeden wojownik..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "What foul being caused such destruction?"
msgstr "Cóż za zło sprowadziło w to miejsce takie zniszczenia?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It once led to adventure. Alas, no more."
msgstr "Niegdyś prowadziły do świata przygód. Niestety, już nie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It offers no sanctuary."
msgstr "Nie daje żadnego schronienia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Twas left by cities past."
msgstr "Pozostałość dawnych miast."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Tis sealed away from prying eyes and prying hands."
msgstr "Zawartość jego jest skryta przed ciekawskimi oczami i lepkimi paluchami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON"
msgid "Tis a most delicious fish!"
msgstr "Nader wyborna ryba!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "A feast from the sea."
msgstr "Uczta z morskiej toni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT"
msgid "Twill make the meat even more divine."
msgstr "Sprawia, iż smak mięsiwa jest nawet bardziej wyborny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Tis the salt of the earth."
msgstr "Sól ziemi. Tej ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "An ally to meat!"
msgstr "Może wspomóc mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "'Tis ready to be pillaged!"
msgstr "Gotowe do zrabowania!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "I shall put thee to good use."
msgstr "Dobrze cię wykorzystam."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP"
msgid "Nectar of the gods."
msgstr "Nektar bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "For pillaging from the trees."
msgstr "Do rabowania drzew."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING"
msgid "'Twill never again grow to its former glory."
msgstr "Nigdy już nie odrośnie i nie odzyska swej dawnej chwały."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Alas, the nectar 'tis no longer sweet!"
msgstr "Żal! Nektar ten nie jest już słodki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Baby non-meats."
msgstr "Małe nie-mięsa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "'Tis a weapon of beastly slaughter!"
msgstr "Oto narzędzie bestialskiego mordu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "It contains the flavoring!"
msgstr "Przyprawy korzenne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Spice for the fanciest of foods."
msgstr "Przyprawy do najprzedniejszych z dań."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Thine growing taketh too long!"
msgstr "Czemuż rośniesz tak długo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "'Tis a flavoring sprig."
msgstr "Wonna gałązka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "The nectar of the gods dwells within."
msgstr "Wewnątrz kryje się nektar bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It has been chopped."
msgstr "Porąbane."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "It hath been fouled by tiny beasts!"
msgstr "Zbrukane przez obleśne żyjątka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "I've no patience for thee, sap!"
msgstr "Brak mi do ciebie cierpliwości, żywico!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I have acquired the nectar!"
msgstr "Nektar gotowy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It hath been wounded!"
msgstr "Jest ranne!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "You would make a most honorable warrior."
msgstr "Byłby z ciebie honorowy wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Your liege."
msgstr "Wasza miłość."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It slumbers soundly."
msgstr "Drzemie równo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Lodgings of mine enemy."
msgstr "Stancja mego wroga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Laid to ruin."
msgstr "W ruinie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Nectar of the gods, for the gods."
msgstr "Nektar bogów, a nie dla bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Will this not anger the gods?"
msgstr "Czyż nie rozsierdzi to bogów?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "Flaki twe tak czerwone, a jednak nie jesteś z mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Prepare to barter!"
msgstr "Gotuj się na handel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "'Tis a jaunty-hatted beast."
msgstr "Bestia w zawadiackim kapeluszu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP"
msgid "The gods have strange tastes."
msgstr "Bogowie mają dziwne gusta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "Ach! Nie pożrę cię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT"
msgid "O, glorious wheat!"
msgstr "Och, chwalebne zboże!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC"
msgid "Jump into my mouth!"
msgstr "Wskocz mi do buzi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD"
msgid "There is no escape!"
msgstr "Nie ma ucieczki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Showtime, rabbits!"
msgstr "Czas na zabawę, króliczki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING"
msgid "It must be intermission for the rabbits."
msgstr "Króliki mają przerwę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Good riddance, giant carrot."
msgstr "Do widzenia, wielka marchewo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "What's to be done with a carrot that big?"
msgstr "Cóż począć z marchwią takich rozmiarów?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT"
msgid "Armor for rain."
msgstr "Pancerz do walki z deszczem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT"
msgid "We will fight in the rain."
msgstr "Będziemy walczyć w deszczu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT"
msgid "Its prophecy days are done."
msgstr "Dni jego proroczej świetności przeminęły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC"
msgid "It foretells the coming of rains."
msgstr "Potrafi przepowiedzieć nadejście deszczu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE"
msgid "A pile of vegetables. No thanks."
msgstr "Sterta warzyw? Podziękuję."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR"
msgid "A small blade, but a blade nonetheless."
msgstr "Małe ostrze, ale jednak ostrze."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM"
msgid "It is hot to the touch."
msgstr "Jest gorący w dotyku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN"
msgid "A lucky ward to guard against the night."
msgstr "Strzeże nas przed nocą."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE"
msgid "Odin's eye, grant us wisdom!"
msgstr "Oko Odyna, dodaj nam mądrości!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH"
msgid "A blessing of good fortune!"
msgstr "Bogowie obdarzyli nas szczęściem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP"
msgid "Umami or not, I don't want it."
msgstr "Jadalne czy niejadalne, nie chcę tego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED"
msgid "I don't want it, but I'm glad it survived trial by fire."
msgstr "Nie pragnę go, lecz cieszę się, iż przetrwał chrzest ognia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "At least it's got a nice color."
msgstr "Przynajmniej ma ładny kolor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "And stay down there!"
msgstr "Siedź tam i nie wychodź!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Good riddance."
msgstr "Do widzenia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING"
msgid "See you in Asgard, reeds!"
msgstr "Do zobaczenia w Asgardzie, tataraku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC"
msgid "Those are some hardy reeds."
msgstr "Naprawdę porządny tatarak."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED"
msgid "Cut down in their prime."
msgstr "Ścięte u szczytu kariery."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST"
msgid "Ha! The sun is no warrior if it cannot penetrate this."
msgstr "Ha! Marny ze słońca wojownik, jeśli nie potrafi przebić prostej kamizelki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC"
msgid "Fit for Asgard."
msgstr "Nadawałby się do Asgardu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Ashes to ashes."
msgstr "Wiedza poszła z dymem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I prefer battle to science."
msgstr "Wolę się bić, niż prowadzić eksperymenty naukowe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Dust to dust."
msgstr "Z prochu powstałeś i w proch się obrócisz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Perhaps science can enhance my combat skills."
msgstr "Całkiem możliwe, że nauka może wspomóc moje bitewne zdolności."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Its strange power did not protect it from fire."
msgstr "Jego przedziwna moc nie uchroniła go przed ogniem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "A mystical thing."
msgstr "Tajemnicza konstrukcja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "No more meat will come from here!"
msgstr "Więcej mięsa już z tego nie będzie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "It is an absurd machine that makes meat."
msgstr "Absurdalna maszyneria zdolna tworzyć mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL"
msgid "In the blink of an eye, what once was is no more!"
msgstr "Przeminęło w mgnieniu oka!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Valhalla, we come!"
msgstr "Walhallo, nadchodzimy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Might the gods witness this visage and offer protection."
msgstr "Niechaj bogowie przychylnie spojrzą na to oblicze i otoczą je swą opieką."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE"
msgid "It holds me back from Valhalla."
msgstr "Zamyka mi bramy do Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER"
msgid "Feel the passion inside!"
msgstr "Poczuj pasję drzemiącą wewnątrz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL"
msgid "Thy machismo frighten me not!"
msgstr "Twoja samcza siła nie przeraża mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY"
msgid "A glorious feast indeed!"
msgstr "Zaiste, wspaniała to uczta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC"
msgid "Red like blood."
msgstr "Czerwony niczym krew."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD"
msgid "I prefer your black brethren."
msgstr "Wolę twoich czarnych pobratymców."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This bird knows about the cold."
msgstr "Ten ptak wie, co to mróz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Such fluffy feathers."
msgstr "Ale puchate piórka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET"
msgid "A prisoner!"
msgstr "Więzień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK"
msgid "Smash!"
msgstr "Łubudu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS"
msgid "Some pretty normal rocks."
msgstr "Zupełnie zwyczajne kamienie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY"
msgid "He may be a worthy combat comrade."
msgstr "Może być z niego godny rywal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "Tis barren as the rainless desert."
msgstr "Spustoszone."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Tis consumed by flame!"
msgstr "Strawił je ogień!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "The plague hath overwhelmed it completely!"
msgstr "Powaliła je choroba!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "A plague festers within it!"
msgstr "Dręczy je uwiąd!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "Hark, be wary! Tis fruit I see."
msgstr "Strzeż się! Owoc widzą me oczy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It hath been stripped of its bounty."
msgstr "Zostało pozbawione swoich darów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It had not the strength to withstand this heat."
msgstr "Nie miało dość sił, by oprzeć się żarowi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "Tis either a rock or vegetable. Neither are food."
msgstr "To albo kamień, albo roślina. W żadnym wypadku nie jest jedzeniem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "Yuck."
msgstr "Fuj."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "I shall not eat that."
msgstr "Nie pożywię się tym."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "The rock veggie is sprouting."
msgstr "Kamienna roślina puściła pędy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A miniature frozen mountain."
msgstr "Małe lodowe góry."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED"
msgid "Poor glacier!"
msgstr "Biedny lodowiec!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED"
msgid "Poor glacier!"
msgstr "Biedny lodowiec!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The lava crust is firm."
msgstr "Magmowa powłoka jest dość solidna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava crust is reforming."
msgstr "Magmowa powłoka się odnawia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Beautiful light!"
msgstr "Piękne światło!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks delicate."
msgstr "Wygląda bardzo krucho."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON"
msgid "A gift from Mani."
msgstr "Upominek od Maniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "Sama ma obecność wystarczy, by zasiać panikę w ich drewnianych sercach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "Sama ma obecność wystarczy, by zasiać panikę w ich drewnianych sercach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK"
msgid "Chaaaarge!"
msgstr "Ataaaaak!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE"
msgid "You don't frighten me!"
msgstr "Nie przestraszysz mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE"
msgid "Strong enough to bind the sails of my longship."
msgstr "Dość silna, by utrzymać żagle mego okrętu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG"
msgid "Ruined for eating, but primed for battle."
msgstr "Do jedzenia się już nie nada, ale do walki jak najbardziej."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY"
msgid "To absorb the felled queen's power!"
msgstr "Żeby tak posiąść siłę poległej królowej!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE"
msgid "A pile of ancient rocks."
msgstr "Kupa starożytnych kamieni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT"
msgid "A crown... that fights!"
msgstr "Korona... Która walczy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT"
msgid "A warrior's wand!"
msgstr "Berło wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE"
msgid "Its days are not done."
msgstr "Jego dni jeszcze nie przeminęły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "What foul manner of chest is this?"
msgstr "Cóż to za bezecna skrzynia?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "I shall submit to the gods' judgment."
msgstr "Poddam się osądowi bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN"
msgid "Mighty steeds can be unsaddled with this."
msgstr "Można rozsiodłać tym potężne wierzchowce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC"
msgid "Now to find a faithful steed."
msgstr "Trzeba mi teraz wiernego wierzchowca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE"
msgid "Oh to fly on the wings of Valkyrie!"
msgstr "Ach, wzbić się w niebiosa na skrzydłach walkirii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR"
msgid "I ride to victory or death!"
msgstr "Ku zwycięstwu lub ku śmierci!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA"
msgid "A disappointing mush."
msgstr "Jakaś mamałyga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX"
msgid "A fine place to store meats!"
msgstr "Miejsce na mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK"
msgid "Minerals, not meat."
msgstr "Minerały to nie mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK"
msgid "It hath a strange shape to it."
msgstr "Ma dziwny kształt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC"
msgid "Tis the form of a sea nymph!"
msgstr "Ma postać wodnej nimfy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING"
msgid "Formed as if by Odin's hand!"
msgstr "Wygląda, jakby sam Odyn przyłożył do tego rękę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Naught but a stump!"
msgstr "Został jeno pieniek!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK"
msgid "Tis a castle of sand!"
msgstr "Toż to prawdziwa forteca z piasku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE"
msgid "The earth itself dares to fight me!"
msgstr "Sama ziemia odważa się stawać przeciwko mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I do not think I can best this rock in combat."
msgstr "Nie wiem, czy dałabym radę pokonać ten kamień w uczciwej walce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Clever rock, you cannot surprise a warrior!"
msgstr "Wojownika nie zaskoczysz, przebiegły kamieniu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING"
msgid "Nooo! My spears!"
msgstr "Nie! Moje włócznie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED"
msgid "Disease festers within its soul."
msgstr "Duszę jej toczy choroba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "Słabnie na moich oczach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC"
msgid "It longs to be a spear."
msgstr "Pragnie stać się włócznią"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED"
msgid "The small tree has been slain!"
msgstr "To niewielkie drzewo zostało ubite!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED"
msgid "It has been shriveled by the heat."
msgstr "Upał dał się jej we znaki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING"
msgid "The scarecrow burns."
msgstr "Płonący strach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow dost yearn for nothing, now."
msgstr "Niczego już nie chce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC"
msgid "Dost thou yearn for a brain?"
msgstr "Czyż nie chciałbyś mieć mózgu?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON"
msgid "Rest easy, spirit. Your fight is over."
msgstr "Spoczywaj w spokoju, duchu. Twoja walka dobiegła końca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "May the muses guide our hands!"
msgstr "Niech muzy prowadzą twe dłonie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Lain to waste."
msgstr "Wszystko na marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A transformative altar for the stone gods."
msgstr "Zmienny ołtarz kamiennych bogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "The muses have been kind this day."
msgstr "Tego dnia muzy były w dobrym humorze."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "More apt for the halls of Valhalla."
msgstr "Bardziej pasowałby do komnat Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Will this please the gods? Or anger them?"
msgstr "Czy to zadowoli bogów? Czy ich rozwścieczy?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Wewnątrz czai się bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "We've freed the figure slumbering in the stone."
msgstr "Uwolniliśmy istotę uśpioną w kamieniu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "A follower of Mimir, mayhaps?"
msgstr "Wyznawca Mimira?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "An abandoned monument to the gods?"
msgstr "Zapomniany posąg na cześć bogów?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Might we come to regret this action?"
msgstr "Będziemy tego żałować?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Wewnątrz czai się bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "An icon of evil, surely!"
msgstr "Uosobienie zła, bez dwóch zdań!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Dost thou yearn for a body?"
msgstr "Czyż nie pragniesz mieć ciała?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Warriors are not concerned with decorative sculptures."
msgstr "Wojownicy nie zwracają uwagi na dekoracje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Gods help us on Mani's night."
msgstr "Wspomóżcie nas, bogowie, w noc Maniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Wewnątrz czai się bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "I fear we've unleashed a great evil."
msgstr "Obawiam się, że uwolniliśmy wielkie zło."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "It has strayed from the warrior's path."
msgstr "Zabłąkał się na drodze wojownika."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Tis no more."
msgstr "Nie ma i już."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "A seafaring Viking is keen of mind and sharp of wit."
msgstr "Wiking ma bystry umysł i ostry dowcip."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO"
msgid "A meal fit for a Viking queen."
msgstr "Posiłek godzien królowej wikingów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK"
msgid "I shall not dash mine ship upon thee!"
msgstr "Nie roztrzaskam swej łodzi na tobie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS"
msgid "Tiny nature bits."
msgstr "Małe okruchy przyrody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED"
msgid "Tiny nature bits, cooked to death."
msgstr "Małe okruchy przyrody, uprażone na śmierć."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD"
msgid "May the secrets of this land be divulged by the gods."
msgstr "Niech bogowie ujawnią tajemnice tej krainy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT"
msgid "I am no seamstress, but repairs are sometimes necessary."
msgstr "Nie jestem krawcową, ale każdy musi umieć przyszyć guzik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE"
msgid "Luckily I need be no seamstress with this!"
msgstr "Na szczęście nie trzeba tu krawcowej!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER"
msgid "I hope this serf is being treated with dignity."
msgstr "Ufam, iż jeniec traktowany jest z należnym szacunkiem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART"
msgid "Blackest hearts. Darkest omens."
msgstr "Najczarniejsze serca. Najmroczniejsze znaki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK"
msgid "Do you come to challenge me, sea beast?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER"
msgid "Tis naught but a clump of shells."
msgstr "To jeno trochę muszli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL"
msgid "I'd prefer a ship burial, though this might have its uses."
msgstr "Wolałabym, by pochowano mnie na okręcie, ale łopata też może się przydać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN"
msgid "A trophy of our battles!"
msgstr "Trofeum na dowód naszych przewag!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT"
msgid "It has been razed."
msgstr "Został starty z powierzchni ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A place to rest one's battle-weary head."
msgstr "Miejsce, by złożyć zmęczoną bojem głowę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK"
msgid "Useful for binding, and for remembering victories past."
msgstr "Kleista pajęcza wydzielina."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "{note}? I expected it to sound more like a war bugle."
msgstr "{note}? Myślałam, że to dźwięk rogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "It sings a siren's song. In {note}."
msgstr "Syreni śpiew. W tonacji {note}."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "{note}... an impressively high register for a wee sea beast."
msgstr "{note}... nadzwyczaj wysoki rejestr jak na tak mało bestyjkę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC"
msgid "A small langhús for the ghostly warrior to regain her strength."
msgstr "Mały langhús dla widmowej wojowniczki, by mogła odzyskać siły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "Tis a fine monument indeed."
msgstr "Zaiste wspaniały monument."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Flowers doth please this spirit."
msgstr "Kwiaty radują tego ducha."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON"
msgid "Rest easy in Valhalla."
msgstr "Niech otworzą się przed tobą bramy Vahalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT"
msgid "Immortal's sight was not meant for thee."
msgstr "Nie tobie pisany był wieczny wzrok."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s was felled by %s. Live on in Valhalla."
msgstr "%s został pobity. Powód? %s. Niech Walhalla będzie ci domem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s was felled by %s. She will live on in Valhalla."
msgstr "%s została pobita. Powód? %s. Niech Walhalla będzie ci domem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s was felled by %s. He will live on in Valhalla."
msgstr "%s został pobity. Powód? %s. Niech Walhalla będzie ci domem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s was felled by %s. They will live on in Valhalla."
msgstr "%s został pobity. Powód? %s. Niech Walhalla będzie ci domem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH"
msgid "The muses' knowledge, inscribed upon an ancient scroll!"
msgstr "Wiedza muz przeniesiona na pradawny zwój!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST"
msgid "Ah, that was a good battle."
msgstr "Ach, to była dobra bitwa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB"
msgid "Those who enter thy circle shalt know rest."
msgstr "Ci, co wejdą w twój okrąg, poznają odpoczynek."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT"
msgid "I prefer weapons at close range."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "I could do without the stench..."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "What fun is a battle without hand to hand combat?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER"
msgid "The fur foe thinks she's a hat!"
msgstr "Futrzany nieprzyjaciel myśli, że jest czapką!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT"
msgid "I do love furs."
msgstr "Lubię futra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT"
msgid "I do love furs."
msgstr "Lubię futra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE"
msgid "You are an angel. Of nasty."
msgstr "Jesteś aniołem. Aniołem obrzydliwości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT"
msgid "A fine battle helm!"
msgstr "Zacny hełm bojowy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE"
msgid "Not where I'd choose to hang my helm."
msgstr "Za nic nie włożę tam głowy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME"
msgid "Yes. Slime."
msgstr "Ślimak, ślimak, pokaż rogi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "They're smashed up good."
msgstr "Nieźle im ktoś przywalił."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC"
msgid "You are not fierce yet, bird."
msgstr "Jeszcze nie jesteś agresywny, ptaszku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You must eat to grow strong."
msgstr "Musisz jeść, żebyś urósł silny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Rest now, young one."
msgstr "Spocznij, maluchu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING"
msgid "The small bird looks famished."
msgstr "Ptaszek wygląda na zagłodzonego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLGHOST"
msgid "Such a wee specter!"
msgstr "Cóż za malutkie widmo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT"
msgid "A nice meaty snack."
msgstr "Wspaniała mięsna przekąska."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED"
msgid "A small provision for a long campaign."
msgstr "Mała przekąska na dłuższe wyprawy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER"
msgid "I shall best you, foe!"
msgstr "Pokonam cię, zbóju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE"
msgid "I like his helmet."
msgstr "Fajny ma hełm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT"
msgid "How much meat is hiding under there?"
msgstr "Ileż mięsa się tam kryje?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR"
msgid "That is not my favored spear, but it will do the trick."
msgstr "Nie jest to ma ulubiona włócznia, ale nada się."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR"
msgid "The weapon of a brazen Valkyrie!"
msgstr "Oręż mężnej walkirii!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE"
msgid "Tis a divine spear!"
msgstr "Boska włócznia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR"
msgid "My comrade in arms!"
msgstr "Moja towarzyszka przygód!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICEPACK"
msgid "I'll use this to carry delicious meats!"
msgstr "Użyję tego do przenoszenia przepysznych posiłków!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_CHILI"
msgid "Full of a fiery extract."
msgstr "Ekstrakt z płomieni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_GARLIC"
msgid "Its pungent smell offends mine nostrils."
msgstr "Ta gryząca woń lży me nozdrza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SALT"
msgid "It has the briny taste of the sea."
msgstr "Ma słony posmak morza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SUGAR"
msgid "The sweet juice of an enemy."
msgstr "Słodki smak nieprzyjaciela."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD"
msgid "Cut down in battle, like so many before it."
msgstr "Powalony w boju, jak wielu jego towarzyszy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC"
msgid "Eight legs and still no match for me!"
msgstr "Osiem nóg, a i tak nie może się ze mną równać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING"
msgid "I will give it a fair fight by waiting til it awakes."
msgstr "Walczmy honorowo. Poczekam, aż się zbudzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN"
msgid "Crush them at the source!"
msgstr "Trzeba je zgromić u źródła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK"
msgid "Squashing these would be a waste of future battles."
msgstr "Zniszczyć je to jak pozbawić się możliwości walki w przyszłości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND"
msgid "Ripped from the abdomen of a slain spider."
msgstr "Wydarty z brzucha zgładzonego pająka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT"
msgid "A perfect way to infiltrate the enemy camp."
msgstr "Znakomity sposób na infiltrację obozu wroga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE"
msgid "Webbing. Never a good sign."
msgstr "Pajęczyny. To nie może być dobry znak."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK"
msgid "Webbing. Never a good sign."
msgstr "Pajęczyny. To nie może być dobry znak."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN"
msgid "Finally, a true test of my abilities."
msgstr "Nareszcie prawdziwy sprawdzian moich zdolności!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER"
msgid "You are so sneaky!"
msgstr "Ożeż ty mały, podstępny brzydalu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER"
msgid "I'll smash you!"
msgstr "Zginiesz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.DEAD"
msgid "It has breathed its last."
msgstr "Wydał ostatnie tchnienie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "One of Hel's beasts, surely!"
msgstr "Ani chybi to jedna z bestii Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "It slumbers."
msgstr "Drzemie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER"
msgid "That one's feisty."
msgstr "Ten jest jakiś taki wściekły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Victory once again!"
msgstr "I znów - zwycięstwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "The champion of the spiders. To battle!"
msgstr "Pajęczy czempion. Do broni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "It is cowardly to attack a sleeping enemy."
msgstr "Tylko tchórze atakują kogoś we śnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FISH"
msgid "You smell of your failure."
msgstr "Czuć od ciebie smród porażki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD"
msgid "Age has only made this food gross, not wise."
msgstr "Niestety, rośliny z wiekiem nie mądrzeją."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "At peace, benevolent flame spirit."
msgstr "Odpoczywaj, dobrotliwy duchu płomienia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I'll direct this light where I please."
msgstr "Mogę skierować to światło, gdzie zechcę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "At peace, benevolent forest spirit."
msgstr "Odpoczywaj, dobrotliwy duchu lasu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Mogę skierować to światło, gdzie zechcę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC"
msgid "At peace, benevolent river spirit."
msgstr "Odpoczywaj, dobrotliwy duchu rzeki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Mogę skierować to światło, gdzie zechcę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SQUID"
msgid "It lights my voyage through murky waters."
msgstr "Oświetla mi drogę przez mętne wody."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT"
msgid "Frigid as a frost giant's heart."
msgstr "Twardy jak serce lodowego giganta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT"
msgid "Behold! A gift from Wotan!"
msgstr "Oto podarunek wielkiego Wotana!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO"
msgid "A storm of pain."
msgstr "Bolesne wiatry."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE"
msgid "Keep thy hand from out mine fires!"
msgstr "Łapa precz od mojego ognia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING"
msgid "Merely a table."
msgstr "Stół jak każdy inny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE"
msgid "Cave boulder."
msgstr "Jaskiniowy kamulec."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL"
msgid "A pointy rock of sorts."
msgstr "Dziwny zaostrzony kamień."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER"
msgid "It lives to battle once more!"
msgstr "Żyje na nowo, aby walczyć jak niegdyś!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM"
msgid "Tis no mindless beast!"
msgstr "Nie jest to bezmyślna bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION"
msgid "A fiend woven from the night!"
msgstr "Wróg utkany z ciemności!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "That wasn't very respectful."
msgstr "Mało w tym szacunku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "A curious homage to the gods."
msgstr "Przedziwny sposób wyrażania czci bogom."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP"
msgid "It must be Gunnar. The snakes took his head."
msgstr "To chyba Gunnar. Węże zabrały jego głowę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL"
msgid "The villain turns hero!"
msgstr "Łotr staje się bohaterem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Delicate appearance, but hard as stone. Admirable."
msgstr "Z pozoru delikatny, ale twardy jak kamień. Doskonały."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "What plagues you, fair maiden?"
msgstr "Cóż cię dręczy, szlachetna dziewico?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "A sturdy little warrior."
msgstr "Krzepki mały wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Tis a stone basin!"
msgstr "Kamienna misa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL"
msgid "It could easily best regular wool in combat."
msgstr "W boju nadaje się znacznie lepiej od zwykłej wełny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL"
msgid "Njord guide our journey."
msgstr "Niechaj Njord nas prowadzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "A vital piece of a glorious vessel."
msgstr "Nieodzowna część chwalebnej łodzi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER"
msgid "The sword on the back of a bee."
msgstr "Miecz z pszczelego tyłka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT"
msgid "A hat for cooling after a raucous battle."
msgstr "Dla ochłody po gorącej bitwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT"
msgid "Filling the vegetable does not make it meat."
msgstr "Napełnienie czymś warzywa nie zamieni go w mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFING"
msgid "It bears the scent of meat. I will sample a morsel."
msgstr "Pachnie mięsem. Uszczknę sobie kawałeczek."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED"
msgid "Tis not foodstuff."
msgstr "To nie pokarm."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT"
msgid "Hearty greenery."
msgstr "Soczysta zieleń."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED"
msgid "A feast for mine eyes!"
msgstr "Radość dla mych oczu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "Perhaps it was a gift from Venus?"
msgstr "Może to dar od Wenus?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "Fie! Locked tight!"
msgstr "Niech to! Zamknięte na fest!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPERTACKLECONTAINER"
msgid "A bounty of space for my bait!"
msgstr "Pełno miejsca dla mych przynęt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SURFNTURF"
msgid "Nothing goes better with meat than more meat!"
msgstr "Nic nie pasuje lepiej do mięsa, niż więcej mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST"
msgid "It is a handsome vest, but it offers no protection."
msgstr "Wygląda znakomicie, ale nie zapewnia żadnej ochrony."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETPOTATO"
msgid "Marshmallows on meat... tis an odd choice, but somehow delicious!"
msgstr "Pianki na mięsie... dziwny wybór, ale jednak smaczny!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "It's been consumed by fire."
msgstr "Pochłonęły go płomienie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "A feast table worthy of Valhalla!"
msgstr "Uczta godna Walhalli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "A feast fit for The Great Hall!"
msgstr "Uczta godna Wielkiej Sali!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "It is not worthy of a place here."
msgstr "Nie jest godne, by zająć tu miejsce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLECONTAINER"
msgid "A wise hunter treats their tools with care."
msgstr "Mądry łowca dba o swoje narzędzia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESKETCH"
msgid "This scroll bears hidden secrets of fishing!"
msgstr "Ten zwój skrywa sekrety rybołówstwa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESTATION"
msgid "I shall create a fishing weapon like no other!"
msgstr "Moja broń wędkarska nie będzie miała sobie równych!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY"
msgid "Long will the saga of this taffy be told."
msgstr "Opowieść o tych ciągutkach winna być przekazywana z pokolenia na pokolenie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD"
msgid "A fearsome bird! But I am not afraid."
msgstr "Przerażające ptaszysko. Ale ja się nie lękam!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG"
msgid "It will grow into a formidable foe."
msgstr "Wyrośnie z niego straszliwy wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It was you or me, bird."
msgstr "Albo ty, albo ja, ptaszyno."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "This egg would not survive a Norse winter."
msgstr "To jajo nie przetrwałoby zimy na Północy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Fight your way out, bird!"
msgstr "Walcz o wolność, ptaszyno!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Borne of flame! Unless it cooks to death."
msgstr "Zrodzony w płomieniach! No, chyba że się go wcześniej ugotuje."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "A time remains before this bird is to be born."
msgstr "Została ledwie chwila do narodzin nowego życia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "It will soon wake to this world."
msgstr "Wkrótce pojawi się na tym świecie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "A feathered warrior lurks inside."
msgstr "Wewnątrz czai się pierzasty wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "A young bird of war will soon be born."
msgstr "Wkrótce narodzi się młody ptasi wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAMALES"
msgid "Oh ho! This bready wrap hides a morsel of spiced meat!"
msgstr "Oho! W tym placku skrywa się mięso!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC"
msgid "You are not yet ready for battle, bird."
msgstr "Nie jesteś gotów do walki, ptaszku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY"
msgid "I hope you like vegetables... the meat is for me."
msgstr "Mam nadzieję, że lubisz warzywa. Mięso jest dla mnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.SLEEPING"
msgid "It's gathering its strength."
msgstr "Zbiera siły."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING"
msgid "To enter battle with me is your choice, bird."
msgstr "Chcesz ze mną walczyć, ptaku? To twój wybór."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS"
msgid "It requires purple gems."
msgstr "Potrzeba fioletowych klejnotów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID"
msgid "It will harness my awesome speed."
msgstr "Czy zdoła poradzić sobie z mą niezwykłą prędkością?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "To Asgard!"
msgstr "Do Asgardu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "A bridge to another world."
msgstr "Most do innego świata."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "The bridge is unstable yet."
msgstr "Most nie jest jeszcze stabilny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "The bridge is incomplete."
msgstr "Most jest niekompletny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX"
msgid "Perhaps it holds the secret to this land's Bifrost."
msgstr "Być może kryje się tu sekret Bifröstu tych ziem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK"
msgid "A sturdy crank."
msgstr "Jakiś naukowy wichajster."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO"
msgid "No decency. It's not even metal meat."
msgstr "Zero przyzwoitości. Żeby to chociaż było metalowe mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING"
msgid "It appears to be similar to the Bifrost."
msgstr "Rzecz wielce podobna do Bifröstu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF"
msgid "Ride through the air and the sea!"
msgstr "Pędź poprzez niebiosa i oceany!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT"
msgid "It has been razed."
msgstr "Został starty z powierzchni ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC"
msgid "Sleep this night, and prepare for battle on the morrow."
msgstr "Prześpij tę noc, by jutro obudzić się gotową do walki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE"
msgid "It looks fierce. Into the fray!"
msgstr "Wygląda na wściekłą. Do boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE"
msgid "Gooey, but dangerous. I like it."
msgstr "Trochę gumowy, ale niebezpieczny. Podoba mi się."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS"
msgid "A tough hide."
msgstr "Twarda skóra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN"
msgid "I will thrust my spear into that mass of tentacles!"
msgstr "Zatopię swoją włócznię w tej mackowatej masie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR"
msgid "A towering tentacled foe."
msgstr "Olbrzymi mackowaty nieprzyjaciel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "A gross, grasping appendage."
msgstr "Paskudny chwytliwy odrost."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "The lair of my tallest foe!"
msgstr "Leże najwyższego z mych wrogów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE"
msgid "This material possesses gargantuan strength!"
msgstr "Materiał o straszliwej sile!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES"
msgid "Looks like shiny popped corn."
msgstr "Wyglądają jak świecący popcorn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE"
msgid "Tis Loki's frost giant lure."
msgstr "Przynęta na lodowych gigantów Lokiego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Ha! Finally, a worthy foe!"
msgstr "Ha! Nareszcie godny przeciwnik!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE"
msgid "Give me your best shot, I'll not hold back!"
msgstr "Pokaż, na co cię stać! Nie cofnę się!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "A cleft in the earth."
msgstr "Rozpadlina w ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "You will bend to my blade, toadstool!"
msgstr "Będziesz robić, co rozkaże me ostrze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Something emerges!"
msgstr "Coś wyłazi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO"
msgid "It will not pass my lips!"
msgstr "Nie przejdzie mi to przez usta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "Flaki twe tak czerwone, a jednak nie jesteś z mięsa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT"
msgid "It doesn't match my costume."
msgstr "Nie pasuje mi do stroju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH"
msgid "Perfect for a nighttime assault."
msgstr "Doskonała na nocne najazdy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOURTIERE"
msgid "Pie hath redeemed itself!"
msgstr "To ciasto odkupiło swe winy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "By the power of the sand!"
msgstr "Na potęgę piasku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "To save my allies the journey."
msgstr "Aby oszczędzić moim towarzyszom podróży."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I shall desert this foul place!"
msgstr "Opuszczę to podłe miejsce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "A present from the mighty lion!"
msgstr "Upominek od potężnego lwa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX"
msgid "Meat of the nut is not true meat."
msgstr "Mięso orzechów nie jest prawdziwym mięsem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS"
msgid "Let us battle with honor!"
msgstr "Stańmy do boju z honorem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR"
msgid "A marvel of science."
msgstr "Cud nauki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP"
msgid "A well constructed trap. Tonight we feast!"
msgstr "Pułapka zacnej jakości. Będziemy dziś biesiadować!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_BRAMBLE"
msgid "A most clever trap for one's foes."
msgstr "Najzmyślniejsza pułapka, jaką można zastawić na wrogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "I shalln't be vanquished that easily."
msgstr "Nie można mnie tak łatwo zgładzić."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "My warrior's instinct sounds - but why!"
msgstr "Mój instynkt wojowniczki każe mi uważać, ale dlaczego?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH"
msgid "A treacherous trap."
msgstr "Zdradziecka pułapka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "An excellent mace wasted, buried in the ground."
msgstr "Jak można tak zmarnować zupełnie dobrą buławę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT"
msgid "Its walls were torn down by fire."
msgstr "Ogień strawił jej ścianki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A place to store my helm and spear whilst I rest."
msgstr "Tutaj przechowam swój hełm i włócznię w czasie odpoczynku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP"
msgid "I am always ready."
msgstr "Jestem zawsze gotowa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP"
msgid "A dead end! I must stand and fight."
msgstr "Ślepy zaułek! Muszę stanąć do walki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRIDENT"
msgid "I shall lay waste to my enemies with the weapon of Poseidon!"
msgstr "Pokonam mych przeciwników bronią Posejdona!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1"
msgid "Toys do not interest a great warrior such as I."
msgstr "Wielcy wojownicy, tacy jak ja, nie interesują się zabawkami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10"
msgid "A token of victory."
msgstr "Symbol zwycięstwa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11"
msgid "A warrior encased in armor. I'm told its name is \"Hal.\""
msgstr "Wojownik kuty w zbroję. Powiadają, iż zowie się „Hal”."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12"
msgid "Remnants of Ms. Wicker's summons? Truly a fierce woman."
msgstr "Czyżby pozostałości przywołań panny Wicker? Doprawdy, krwiożercza z niej kobieta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13"
msgid "A small, peculiar woman."
msgstr "Niewielka, osobliwa kobieta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14"
msgid "Tea is a luxury that warriors cannot afford."
msgstr "Herbata to luksus niedostępny dla wojowników."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15"
msgid "A noble fighter."
msgstr "Dzielny wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16"
msgid "A noble fighter."
msgstr "Dzielny wojownik."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17"
msgid "A poor weapon."
msgstr "Prymitywny oręż."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18"
msgid "I must mentor the young one in battle strategy."
msgstr "Muszę nauczyć młodych taktyki bitewnej."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19"
msgid "A useless toy."
msgstr "Bezużyteczna zabawka."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2"
msgid "Accompaniment for my ballad of triumphs."
msgstr "Akompaniament dla mych ballad o zwycięstwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20"
msgid "Finally, a safe weapon with which to spar with my new allies."
msgstr "Nareszcie! Broń do bezpiecznych sparringów z mymi nowymi przyjaciółmi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21"
msgid "Cooking utensils do not interest me."
msgstr "Narzędzia do gotowania nużą mnie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22"
msgid "It won't stand up to the rigors of battle."
msgstr "Nie sprosta wyzwaniom boju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23"
msgid "Not as useful as a battle horn."
msgstr "Róg bitewny jest bardziej przydatny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24"
msgid "Grant me luck on the battlefield!"
msgstr "Zapewnij mi pomyślność na polu bitwy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25"
msgid "Perhaps the stench will drive the enemy away."
msgstr "Być może odór odstraszy wrogów."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26"
msgid "My allies will appreciate the survival training I've bestowed."
msgstr "Moi sojusznicy docenią przekazane im lekcje przetrwania."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27"
msgid "This weak, flimsy wire reminds me... I must toughen Maxwell up!"
msgstr "Te słabe, żałosne kable przypomniały mi... Muszę wzmocnić Maxwella!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Nawet słabi mogą na planszy szlachetny bój."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Nawet słabi mogą na planszy szlachetny bój."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3"
msgid "Even my spear cannot undo this knot."
msgstr "Nawet moja włócznia nie zdoła go rozwiązać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30"
msgid "Tis not a unicorn."
msgstr "To nie jednorożec."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31"
msgid "Tis not a unicorn."
msgstr "To nie jednorożec."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32"
msgid "Reveal mine destiny, oh great fates!"
msgstr "Ujawnij me przeznaczenie, wielki losie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33"
msgid "The creature has been forever imprisoned upon the ring."
msgstr "Zwierzę na zawsze uwięzione w pierścieniu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34"
msgid "Begone, foul magic!"
msgstr "Przepadnij, magiczne paskudztwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35"
msgid "Twas a poison, most assuredly."
msgstr "Zapewne ongiś była w niej trucizna."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36"
msgid "Evidence of the undead. Stay wary, my allies!"
msgstr "Dowód istnienia nieumarłych. Bądźcie czujni, towarzysze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37"
msgid "For warding off Loki's minions."
msgstr "Do odpędzania sług Lokiego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38"
msgid "There is a tiny world trapped within!"
msgstr "W środku znajduje się niewielki świat!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39"
msgid "To arms! The gauntlet has been thrown down!"
msgstr "Do broni! Rękawica została rzucona!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4"
msgid "A small, peculiar man."
msgstr "Mały, śmieszny człowieczek."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40"
msgid "I have no use for such things."
msgstr "Nic mi po tym."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41"
msgid "Perhaps some sort of elixir lies within?"
msgstr "Czyżby znajdował się w środku jakiś eliksir?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42"
msgid "Tis no foe worthy of I."
msgstr "Nie jest to wróg wart mego czasu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43"
msgid "What manner of creature be this?"
msgstr "Cóż to za osobliwa bestia?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44"
msgid "It has fallen in battle."
msgstr "Śmiertelna ofiara bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45"
msgid "What stories might you tell, trapped spirit?"
msgstr "Cóż za historie możesz opowiedzieć, schwytany duchu?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46"
msgid "Tis a suspicious contraption!"
msgstr "Przedziwne ustrojstwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5"
msgid "Will it take me to Asgard?"
msgstr "Czy zabierze mnie do Asgardu?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6"
msgid "Useless technology."
msgstr "Bezużyteczna technologia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7"
msgid "No time for games! I must train my new allies!"
msgstr "Nie ma czasu na igraszki! Muszę ćwiczyć mych nowych towarzyszy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8"
msgid "It would make an okay weapon in a pinch."
msgstr "Można by z tego zrobić całkiem sensowną broń."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9"
msgid "No decent armor could be made with these."
msgstr "Nie da się zrobić z nich porządnego pancerza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "By the gods, that fishbowl's ablaze!"
msgstr "Na bogów, akwarium w płomieniach!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "Tis naught but cinders."
msgstr "Został tylko popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "I will stand victorious!"
msgstr "Odniosę zwycięstwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Waga: {weight}\nImię wędkarza: {owner}"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nA most glorious catch indeed!"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nZaiste, wspaniały połów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nTake heed of my fishing prowess!"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nPatrzcie, jakam wprawna w łowieniu ryb!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nT'was nothing for a skilled hunter!"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nTo drobnostka dla zręcznej łowczyni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It will not suffice in the frozen wastes."
msgstr "Na mroźnych pustkowiach może nie wystarczyć."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER"
msgid "The warm pelt of a bested creature. A fine garment."
msgstr "Ciepła skóra pokonanego zwierza. Znakomity element garderoby."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED"
msgid "A juicy reward after a hard battle."
msgstr "Soczysta nagroda za ciężką bitwę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER"
msgid "A powerful trunk of a fallen not-so-hairy beast."
msgstr "Potężna trąba nie aż tak włochatego zwierza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER"
msgid "A powerful trunk of a fallen hairy beast."
msgstr "Potężna trąba włochatego zwierza."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED"
msgid "Flee, bouncing coward!"
msgstr "Uciekaj, podskakujący tchórzu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR"
msgid "It soaks up the blood of battle."
msgstr "Doskonale zbiera całą krew z pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Fancy floor."
msgstr "Wymyślna podłoga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY"
msgid "A warm piece of the battlefield."
msgstr "Ciepły skrawek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_METEOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_METEOR"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MUD"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_PEBBLEBEACH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_PEBBLEBEACH"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROAD"
msgid "The road to battle leads wherever we will it."
msgstr "Droga ku bitwie wiedzie wprost przez nasze serca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ROCKY"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SANDY"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SAVANNA"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_SINKHOLE"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_UNDERROCK"
msgid "A piece of the battlefield."
msgstr "Kawałek pola bitwy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_WOODFLOOR"
msgid "Wooden flooring, a fine surface for mortal combat."
msgstr "Drewniana podłoga. Znakomita do walki na śmierć i życie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURKEYDINNER"
msgid "A true feast."
msgstr "Prawdziwa uczta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP"
msgid "I shall not consume it!"
msgstr "Nawet tego nie tknę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "Ach! Nie pożrę cię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "To jeno nasiona. Nie wyrośnie z nich mięso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURTILLUS"
msgid "Your armor shalln't stop my spear."
msgstr "Twój pancerz nie zatrzyma mej włóczni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNING"
msgid "The wood's ablaze!"
msgstr "Las płonie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Loge took that one."
msgstr "Loge zabrał go w Zaświaty."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Chopped by the warrior in the woods!"
msgstr "Ścięty przez prawdziwego wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Disease festers within its soul."
msgstr "Duszę jej toczy choroba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Triumph will accompany its many resources."
msgstr "Niechaj towarzyszy ci zwycięstwo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT"
msgid "It will one day rival Yggdrasil!"
msgstr "Któregoś dnia rzuci wyzwanie Yggdrasilowi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "Grow tall and strong."
msgstr "Rośnij w siłę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGGY_OLD"
msgid "It will soon return to the earth."
msgstr "Wkrótce obróci się w pył."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TWIGS"
msgid "Good for making spears."
msgstr "Doskonały materiał na włócznie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UMBRELLA"
msgid "Rain protection made from the trophy of a hunt."
msgstr "Deszczowa ochrona z myśliwskiego trofeum."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNAGI"
msgid "No need for food to be so fancy."
msgstr "Po co robić takie wymyślne żarcie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.UNIMPLEMENTED"
msgid "A mysterious relic, sure to contain great power."
msgstr "Tajemniczy obiekt. Na pewno skrywa potężną moc."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VEGSTINGER"
msgid "Its spiciness intrigues me not!"
msgstr "Ta ostrość mnie nie pociąga!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.VOLTGOATJELLY"
msgid "Well, it is technically made from a beast."
msgstr "W zasadzie jest zrobione z bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAFFLES"
msgid "Waffles are no way to prepare for battle!"
msgstr "Gofry to nie jedzenie dla wojownika."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALKINGPLANK"
msgid "I shall never abandon my vessel!"
msgstr "Nigdy nie porzucę swej łodzi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.BURNT"
msgid "That won't do at all."
msgstr "Zupełnie nie wystarczył."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY.GENERIC"
msgid "A minor deterrent to attackers."
msgstr "Słabej jakości środek odstraszający napastników."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_HAY_ITEM"
msgid "Perhaps my foes will get lost in this hay."
msgstr "Mam nadzieję, że nieprzyjaciele pogubią się w tej słomie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK"
msgid "Wholly impregnable, a worthy fortification!"
msgstr "Zacna fortyfikacja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "Our fortress shall be impenetrable!"
msgstr "Nasza forteca będzie niezdobyta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS"
msgid "Nigh impenetrable."
msgstr "Prawie niezniszczalny."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_RUINS_ITEM"
msgid "Only the finest barriers for my fort."
msgstr "Mój fort zasługuje na najlepsze mury."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE"
msgid "My enemies will dash themselves on these rocks."
msgstr "Moi wrogowie rozbiją się na tych kamieniach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_STONE_ITEM"
msgid "A sturdy wall, fashioned from the earth."
msgstr "Wytrzymały mur stworzony z darów ziemi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.BURNT"
msgid "Fire, wood's only weakness!"
msgstr "Ogień, jedyna słabość drewna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD.GENERIC"
msgid "It may impale a foe."
msgstr "Można by kogoś na to nadziać."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALL_WOOD_ITEM"
msgid "A mediocre fortification."
msgstr "Taka sobie fortyfikacja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS"
msgid "Those tusks could pierce even the finest armor."
msgstr "Te kły przebiją nawet najznakomitszy pancerz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUSHAT"
msgid "Highland filth!"
msgstr "Plugastwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "They have departed for a great journey."
msgstr "Wyruszyły na wielką wyprawę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "A proper winter camp."
msgstr "Dobrze przygotowany zimowy obóz."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALRUS_TUSK"
msgid "Rended from the mouth of the sea beast."
msgstr "Wyjęty z pyska morskiej bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.ATTACKER"
msgid "Consider your actions wisely, %s."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s, why do you break your cherished code?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GENERIC"
msgid "Good health to you, %s, and to your loyal beast!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.GHOST"
msgid "By my honor, I will bring you back to this world!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.MURDERER"
msgid "Have at thee, you and your wicked beast!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTER.REVIVER"
msgid "%s carries with him a true sense of honor."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WALTERHAT"
msgid "The helm of the \"Pinetree Pioneer\" clan."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNING"
msgid "No, my furs and cloaks!"
msgstr "Och, nie! Me płaszcze i futra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.BURNT"
msgid "No use crying over burnt pelts."
msgstr "Nie ma co płakać nad spalonymi skórami."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARDROBE.GENERIC"
msgid "That's where I keep my furs and cloaks."
msgstr "Trzymam tu me płaszcze i futra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARG"
msgid "Be that you, Fenrir?"
msgstr "Czy to ty, Fernirze?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "I wszystko na marne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.EMPTY"
msgid "What doth thou need?"
msgstr "Czegóż ci trzeba?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARGSHRINE.GENERIC"
msgid "The gods are pleased!"
msgstr "Bogowie są zadowoleni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.ATTACKER"
msgid "What nefarious plots doth %s stew upon?"
msgstr "Cóż to za nikczemności %s szykuje?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.FIRESTARTER"
msgid "%s's summoned Hel's flames this day!"
msgstr "%s rozkazuje dziś płomieniom Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GENERIC"
msgid "Hail, %s, blessed feast-forge!"
msgstr "Witaj, %s, chwalebny kucharzu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.GHOST"
msgid "The feast hall of Valhalla will one day welcome you. But not today."
msgstr "Któregoś dnia trafisz na ucztę do Walhalli. Ale nie dziś."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.MURDERER"
msgid "We will hold a valorous feast at your defeat!"
msgstr "Będziemy świętować twoją porażkę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WARLY.REVIVER"
msgid "%s's heart is as full as his belly."
msgstr "%s ma serce równie wielkie, co żołądek."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WASPHIVE"
msgid "Bees of war!"
msgstr "Wojenne pszczoły!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERBALLOON"
msgid "Prepare to engage in water-y battle!"
msgstr "Gotuj się do wodnej bitwy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON"
msgid "It makes a good sound when you hit it."
msgstr "Wydaje fajny dźwięk."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONHAT"
msgid "It's almost like wearing a pelt."
msgstr "Czuję się, jakbym nosiła skórę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELONICLE"
msgid "You cannot fool me by hiding in frozen fruit, stick."
msgstr "Nie wykiwasz mnie, patyku! Na nic ci się nie zda chowanie w zamrożonym owocu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_COOKED"
msgid "Warm and red, but it doesn't flow."
msgstr "Czerwony i ciepły, ale nie płynie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERMELON_SEEDS"
msgid "Seedy."
msgstr "Dużo tu nasion."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT"
msgid "Have we entered the realm of giants?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BABY"
msgid "Grow fast and strong, young one."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_BOMB"
msgid "Have at thee, plant!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPLANT_PLANTER"
msgid "Fear not, I shall return you to the sea in time."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATERPUMP"
msgid "We hath safeguarded our vessel against a fiery end."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s is tempting fate."
msgstr "%s kusi los."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "A fellow Viking, forged in flames!"
msgstr "Siostra z wikińskiego klanu! Zahartowana ogniem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hail, %s, fellow shieldmaiden!"
msgstr "Witaj %s, dzielna wojowniczko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.GHOST"
msgid "You'll not away to Valhalla yet, %s. A heart!"
msgstr "Jeszcze nie twój czas na wyprawę do Walhalli, %s. Serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.MURDERER"
msgid "There can be only one!"
msgstr "Może być tylko jeden zwycięzca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s, the perfect warrior!"
msgstr "%s, wojowniczka doskonała!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WATHGRITHRHAT"
msgid "The power of the unicorn is great."
msgstr "Poznaj potęgę jednorożca!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXPAPER"
msgid "Waxen to the touch."
msgstr "Jakiś taki woskowy w dotyku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.ATTACKER"
msgid "I sense Loki's influence in %s."
msgstr "%s zdaje się być pod wpływem Lokiego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Loki has brought %s into a world of flame."
msgstr "%s znalazł się wśród płomieni zesłanych przez Lokiego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GENERIC"
msgid "Greetings, %s, my ally!"
msgstr "Witaj, %s, mój towarzyszu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.GHOST"
msgid "A heart could return %s to this realm if we so wished."
msgstr "%s mógłby powrócić do tego świata za sprawą serca, jeśli by mu takowe ofiarować."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.MURDERER"
msgid "%s! Back to your old tricks, I see!"
msgstr "%s! Widzę, że pewne rzeczy się nie zmieniają!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELL.REVIVER"
msgid "%s has uncovered the kindness buried within his heart."
msgstr "%s odkrył, iż w głębi jego serca drzemie dobro."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WAXWELLJOURNAL"
msgid "A tragic tale of woe and misery!"
msgstr "Tragiczna opowieść o żalu i cierpieniu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.ATTACKER"
msgid "There's a new hunger in %s's eyes."
msgstr "%s... Te jego oczy. Drzemie w nich głód."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.FIRESTARTER"
msgid "His flames are as open as his heart."
msgstr "Płomienie jego dorównują żarowi jego serca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GENERIC"
msgid "Blessings upon you, spiderchild %s!"
msgstr "Pajęcze dziecię, %s! Niechaj bogowie będą ci przychylni!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.GHOST"
msgid "Return with Sleipnir's swiftness, many-legged one."
msgstr "Niechaj Sleipnir doda ci szybkości, wielonogi stworze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.MURDERER"
msgid "I've felled greater monsters than you, %s!"
msgstr "Powaliłam już potężniejsze bestie od ciebie, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER.REVIVER"
msgid "%s's spirit burns brighter than Sol."
msgstr "%s posiada duszę płonącą jaśniej niźli Sol."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBERSKULL"
msgid "He fought boldly, but his burial will not be that of a Viking."
msgstr "Walczył dzielnie, jednak nie czeka go pogrzeb godny wikinga."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "I see naught but allies."
msgstr "Widzę tu jeno sojuszników."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.ATTACKER"
msgid "Do not test me, fair maiden!"
msgstr "Nie igraj ze mną, dziewko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.FIRESTARTER"
msgid "Ah. Have you singed your dress, fair maiden?"
msgstr "Zaprawdę, śliczna jest twa suknia, piękna pani."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GENERIC"
msgid "Spirits be with you, %s!"
msgstr "Niech duchy ci sprzyjają, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "%s potrzebuje serca. To ożywi ducha i ciało."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.MURDERER"
msgid "%s, your body is weak but your heart is strong! Fight!"
msgstr "%s, twoje ciało jest słabe, lecz twe serce wypełnia moc! Walcz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WENDY.REVIVER"
msgid "%s is channeling the spirit of Eir."
msgstr "%s otrzymuje energię od pięknej Eir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_BEAVER"
msgid "Is this meant to summon your fylgja?"
msgstr "Czy to przyzywa fylgię?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_GOOSE"
msgid "It's... er... very fearsome!"
msgstr "To doprawdy... ee... straszliwe!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WEREITEM_MOOSE"
msgid "It represents a warrior's spirit!"
msgstr "Przedstawia ducha wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.ATTACKER"
msgid "Do you bite your thumb at me, mime?"
msgstr "Co to za gest kozacki pokazujesz, mimie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.FIRESTARTER"
msgid "Don't ruin your fair makeup with ashes, %s."
msgstr "Uważaj, by sadza nie skalała twego pięknego lica, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GENERIC"
msgid "Good health to you, %s!"
msgstr "Końskiego zdrowia, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.GHOST"
msgid "Meditate on Hoenir's blessings, %s. I'll find a heart."
msgstr "Niech Honir ci błogosławi, %s. Odnajdę serce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.MURDERER"
msgid "May we meet again in Valhalla!"
msgstr "Spotkamy się ponownie w Walhalli!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WES.REVIVER"
msgid "%s has Hoenir's blessing."
msgstr "%s cieszy się błogosławieństwem Honira."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETGOOP"
msgid "Slop."
msgstr "Ale breja."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPAPER"
msgid "Tis drenched."
msgstr "Przemoczone."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WETPOUCH"
msgid "A treasure lies within!"
msgstr "Wewnątrz kryją się skarby!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WHIP"
msgid "Loud and powerful!"
msgstr "Donośny i potężny dźwięk!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "If %s is looking for trouble, I shall oblige!"
msgstr "Jeśli %s szuka zwady, znajdzie ją u mnie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "I'll not question your wisdom, %s."
msgstr "Nie będę wątpić w twą mądrość, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "Good health and wisdom to you, elder %s!"
msgstr "Dobrego zdrowia i wielkiej mądrości, wiekowa %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "A heart! A heart! My base for a heart!"
msgstr "Serce! Serce! Ma forteca za serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "Murderer! Face me in battle!"
msgstr "Morderczyni! Staw mi czoła w boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "The wisdom of Wotan dwells within you, %s."
msgstr "Otacza cię mądrość Wotana, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.ATTACKER"
msgid "Should it come to blows, may the best maiden triumph."
msgstr "Gdyby miało dość do zwady, niechaj zwycięży potężniejsza dziewica."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.FIRESTARTER"
msgid "%s has more fire in her eyes than usual."
msgstr "%s ma w oczach więcej żaru niż zwykle."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GENERIC"
msgid "Greetings, %s, the Inflammable!"
msgstr "Witaj, %s! Płomienie się ciebie nie imają!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.GHOST"
msgid "A heart shall wrench %s back from the jaws of death!"
msgstr "%s! Serce przywoła cię na powrót spod wrót Śmierci!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.MURDERER"
msgid "My spear was forged in passionate fires, %s!"
msgstr "Mą włócznie zahartowały potężne płomienie, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILLOW.REVIVER"
msgid "%s has a noble heart."
msgstr "%s. Cóż za szlachetne serce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.ATTACKER"
msgid "Your honor wavers, %s."
msgstr "Twój honor jest chwiejny, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.FIRESTARTER"
msgid "Hm. I worry about you sometimes, %s."
msgstr "Hmm Czasem mnie martwisz, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GENERIC"
msgid "Wisdom guide you, %s!"
msgstr "Niechaj mądrość cię prowadzi, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.GHOST"
msgid "The fate of the Draugr is not yours, %s. A heart!"
msgstr "Los draugra nie jest ci pisany, %s. Serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.MURDERER"
msgid "%s! Let us settle this in battle!"
msgstr "%s! Rozwiążmy nasze spory w boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WILSON.REVIVER"
msgid "%s protects our people."
msgstr "%s chroni nasz lud."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.GENERIC"
msgid "The ocean is mine to pillage."
msgstr "Ocean tylko czeka, aby go złupić."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "Behold, my prize!"
msgstr "Oto moja nagroda!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "And to the victor, the spoils!"
msgstr "Łupy dla zwycięzcy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.ATTACKER"
msgid "Dost thou test me, %s?"
msgstr "Wystawiasz mnie próbie, %s?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s's flames could temper steel."
msgstr "%s roztacza wokół siebie żar gotów stopić stal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GENERIC"
msgid "Greetings, brave %s!"
msgstr "Dzielna %s! Bądź pozdrowiona!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.GHOST"
msgid "%s hath fallen! A heart!"
msgstr "%s została powalona! Serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.MURDERER"
msgid "I shall unleash Ragnarok upon thee!"
msgstr "Ześlę na cię Ragnarok!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA.REVIVER"
msgid "%s is guided by Brokkr."
msgstr "%s stąpa ścieżką wytyczoną przez Brokkra."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Pochłonęły go płomienie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "Nic nie powstrzyma płomieni Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Tis fueled by glorious magic."
msgstr "Toczy się tutaj jakaś potężna magia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "Nie wystarczy na długo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "It hath lost its incredible power!"
msgstr "Niesamowita energia! Przepadła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Pochłonęły go płomienie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "Nic nie powstrzyma płomieni Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "The tinkerer hath many tricks."
msgstr "Majsterkowiczka zna niejedną sztuczkę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "T'will not hold out much longer!"
msgstr "Nie wystarczy na długo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "It hath lost its incredible power!"
msgstr "Niesamowita energia! Przepadła!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Pochłonęły ją płomienie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "Nic nie powstrzyma płomieni Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Reinforcements hath arrived! To battle!"
msgstr "Nadeszły posiłki! Do boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "It has no fighting spirit."
msgstr "Brak jej ducha walki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Tis engulfed in flame!"
msgstr "Pochłonęły go płomienie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "Twas devoured by Hel's fire!"
msgstr "Nic nie powstrzyma płomieni Hel."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "It can't get enough of me!"
msgstr "Nie może oderwać ode mnie wzroku."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "It has no fighting spirit."
msgstr "Brak mu ducha walki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT"
msgid "Warm, but not suited for combat."
msgstr "Ciepły, lecz bezużyteczny w boju."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT"
msgid "The measuring device has been slain by Loge."
msgstr "Urządzenie miernicze zgładzone przez Loge'a."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC"
msgid "If only it measured the heat of battle."
msgstr "Gdyby tylko mierzył temperaturę bitewnej zawieruchy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL"
msgid "The essence of Jol!"
msgstr "Esencja Jol!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "The wait is almost at an end."
msgstr "Czekanie już prawie dobiegło końca."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Locked in a glorious cooking battle."
msgstr "Wspaniała kulinarna bitwa w zamknięciu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "At long last, we feast!"
msgstr "Wreszcie pora na ucztę!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "A hearth for cooking a glorious feast!"
msgstr "Palenisko do przygotowania wspaniałej uczty!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1"
msgid "How dost I free you from the bread, man of ginger??"
msgstr "Jak cię uwolnić z okowów tego chleba, piernikowy człowieku?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2"
msgid "Like a snowflake, it is a gift from the heavens!"
msgstr "Dar z niebios podobny do płatka śniegu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3"
msgid "T'would look as divine on the tree as in mine mouth!"
msgstr "Prawie jak ja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4"
msgid "Stay back, foul creation!"
msgstr "Trzymaj się z dala, paskudny tworze!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5"
msgid "We feast tonight!"
msgstr "Dzisiaj będziemy ucztować!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6"
msgid "Twas plucked straight from my nightmares!"
msgstr "Wyjęty prosto z moich koszmarów!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7"
msgid "Something so foul shall never pass my lips!"
msgstr "Coś tak paskudnego nie przejdzie przez me usta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8"
msgid "Warms the soul."
msgstr "Rozgrzewa duszę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9"
msgid "Imbibable eggs!"
msgstr "Niepijalne jaja!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT"
msgid "A fragile beauty that must be protected."
msgstr "Krucha piękność wymagająca ochrony."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Tis not a celebration without a good battle!"
msgstr "Nie ma świętowania bez porządnej bitki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Hath been forged in fires."
msgstr "Artefakt wykuty w płomieniach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "It feeds the festive spirit."
msgstr "Syci się świąteczną atmosferą."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Tis a light enchantment, trapped inside a glass ball."
msgstr "Świetliste zaklęcie uwięzione w szklanej kuli."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING"
msgid "Woe! Misery!"
msgstr "Biada! Tragedia się stała!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Jej piękno na zawsze pozostanie w naszych sercach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "A majestic pine, worthy of celebration!"
msgstr "Dostojny świerk godny prawdziwej uczty!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Grow strong, young one! It is your destiny!"
msgstr "Rośnij silny, młodziaku! To twoje przeznaczenie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Jej piękno na zawsze pozostanie w naszych sercach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "It awaits a grand tree!"
msgstr "Czeka na wspaniałe drzewo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN"
msgid "The lair of the pinchy beasts."
msgstr "Leże uszczypliwych bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS"
msgid "The little beasties have acquired new armor!"
msgstr "Małe bestyjki zyskały nowy pancerz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER"
msgid "Have at thee, morsel!"
msgstr "A masz, kąsku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Sleep in Valhalla, armored one."
msgstr "Miłych snów w Walhalli, pancerny przyjacielu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Your armor hides tasty meat."
msgstr "Twój pancerz skrywa pyszne smakołyki."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1"
msgid "Hail, beastie!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2"
msgid "Hail, beastie!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s packs a punch to rival a frost giant."
msgstr "%s ma siłę godną mroźnego giganta."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "%s seems to have mistakenly fumbled a torch."
msgstr "%s i ogień niezbyt się rozumieją."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC"
msgid "Health and strength to you, %s!"
msgstr "Zdrowia i siły, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST"
msgid "A valiant warrior should not be wasted. A heart, a heart!"
msgstr "Nie zda się, by dzielny wojownik sczezł tak marnie. Serce, serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER"
msgid "You will pay for your heinous deeds, brute!"
msgstr "Zapłacisz za swe niecne występki, oprychu!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s, son of Magni."
msgstr "%s, syn Magniego."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER"
msgid "I could fell you like so many trees, %s."
msgstr "Padniesz, %s. Tak, jak wiele drzew przed tobą."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER"
msgid "I did not know %s possessed such power!"
msgstr "Co za wielką moc posiada %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You went out in a blaze of glory, %s."
msgstr "Twe płomienne odejście będzie zapamiętane, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Did he mistake \"Loge\" for \"log\"?"
msgstr "Czyżby ogień w jego sercu spalił mu mózg?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC"
msgid "May Yggdrasil bind us as the nine worlds, %s!"
msgstr "Niechaj Yggdrasil zwiąże nas w dziewięciu światach, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST"
msgid "The worldtree watches over you, %s."
msgstr "Drzewo świata, %s. Drzewo świata czuwa nad tobą!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE"
msgid "%s, you've become a fowl beast!"
msgstr "%s jest teraz upierzoną bestią!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Worry not, I won't let you leave for Valhalla looking like that!"
msgstr "Nie bój się, nie pozwolę, byś trafił do Walhalli w takiej postaci!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE"
msgid "By the gods, I mistook you for a jötunn!"
msgstr "Na bogów, pomyliłam cię z lodowym gigantem!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Never fear, I'll return you to this realm!"
msgstr "Nie lękaj się, sprowadzę cię do świata żywych!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER"
msgid "By Yggdrasil, I will cut you down!"
msgstr "Na Yggdrasil, powalę cię!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER"
msgid "%s's heart is as mighty as his beard."
msgstr "%s. Jego serce jest równie potężne, co jego broda."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT"
msgid "What's under that dirt?"
msgstr "Cóż to się tam chowa pod tą ziemią?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT"
msgid "I smell a trap."
msgstr "Wyczuwam pułapkę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM"
msgid "A snake beast from the depths!"
msgstr "Wężowy potwór z podziemi!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC"
msgid "Does it swallow those fallen in battle?"
msgstr "Ciekawe, czy połyka poległych w bitwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN"
msgid "Its maw welcomes me."
msgstr "Jej paszcza przywita mnie z radością."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED"
msgid "It is sickly and weak."
msgstr "Jest chora i słaba."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT"
msgid "Glowing treasure, I can't resist!"
msgstr "Świecący skarb. Nie mogę się powstrzymać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER"
msgid "Glow! Glow with all your might!"
msgstr "Świeć! Świeć z całych sił!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT"
msgid "I smell a trap."
msgstr "Wyczuwam pułapkę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Rumors of %s's terrible act have spread like weeds."
msgstr "Wieści o straszliwym czynie, którego sprawcą jest %s, rozchodzą się z prędkością błyskawicy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s is sure to be scalded by Hel's flames!"
msgstr "%s z pewnością poparzy się płomieniami Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC"
msgid "Greetings, %s, touched by Yggdrasil!"
msgstr "Witaj, %s! Błogosławi ci Yggdrasil!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST"
msgid "My dear friend hath fallen in battle!"
msgstr "Mój drogi przyjaciel poległ w boju!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER"
msgid "I will root you out, monstrous plant!"
msgstr "Wykorzenię cię, przebrzydła roślino!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is a kind and formidable healer."
msgstr "%s jest potężnym uzdrowicielem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER"
msgid "Back! Back, beast!"
msgstr "Cofnij się! Cofnij się, bestio!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER"
msgid "%s stepped forth from Hel's flames!"
msgstr "%s wychodzi z płomieni Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC"
msgid "Hail, fire giant %s!"
msgstr "Witaj, gigancie ognia %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST"
msgid "An honorable Viking leaves no one behind!"
msgstr "Honorowy wiking nikogo nie opuszcza!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER"
msgid "%s will pay for his trespasses!"
msgstr "%s zapłaci za swoje występki!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER"
msgid "%s abides by a warrior's code."
msgstr "%s postępuje zgodnie z kodem wojownika."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER"
msgid "Ah, you wish to test your mettle in combat? As you wish!"
msgstr "Ach, pragniesz sprawdzić się w walce? Jak sobie życzysz!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER"
msgid "%s toys with Hel's flames!"
msgstr "%s bawi się płomieniami Hel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC"
msgid "Hail, %s, small beastie of the marshlands!"
msgstr "Witaj, %s, mała bestio z bagien!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST"
msgid "You've a warrior's spirit, but you're not ready for Valhalla yet!"
msgstr "Masz duszę wojownika, ale nie jesteś jeszcze gotowy, by trafić do Walhalli!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER"
msgid "I will not be defeated so easily, beastie!"
msgstr "Nie dam się tak łatwo pokonać, bestyjko!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER"
msgid "It seems you have a kind heart 'neath that scaly hide."
msgstr "Zdaje się, że pod tą łuską skrywasz czułe serce."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER"
msgid "%s! You insult my honor!"
msgstr "%s! Obrażasz mój honor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER"
msgid "That metal warrior would see this world burn."
msgstr "Ten zakuty w stal rycerz pragnie ujrzeć świat w płomieniach."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC"
msgid "May Thor's bolts energize you, %s!"
msgstr "Niechaj gromy Thora cię porażą, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST"
msgid "Metal warrior, it is not your time. A heart!"
msgstr "To jeszcze nie twój czas, stalowy kawalerze. Serce!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER"
msgid "We shall see whose steel is stronger, %s!"
msgstr "Zobaczmy no, czyja stal więcej ma siły, %s!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER"
msgid "%s is brimming with honor."
msgstr "%s promienieje honorem."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWAMULET"
msgid "A star, captured within an amulet."
msgstr "Gwiazda uwięziona w amulecie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWGEM"
msgid "A yellow beauty."
msgstr "Żółciuchne cudeńko."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWMOONEYE"
msgid "Odin, lend us your sight!"
msgstr "Odynie, użycz nam twego wzroku!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YELLOWSTAFF"
msgid "It summons the stars!"
msgstr "Przywołuje gwiazdy!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Tis naught but ashes now."
msgstr "Został tylko proch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "What dost thou need?"
msgstr "Czegóż ci trzeba?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "It irks me to honor a vegetable."
msgstr "Drażni mnie, że składam ofiarę jarzynie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Reduced to cinders."
msgstr "Spalone na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "I must ensure my veggie beast is quick-witted!"
msgstr "Muszę dopilnować, by moja warzywna bestia była bystra!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "You must train harder!"
msgstr "Musisz się bardziej starać!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "A trial of wit."
msgstr "Próba rozumu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Reduced to cinders."
msgstr "Spalone na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "Reflexes are key in battle, and racing!"
msgstr "Refleks to podstawa w bitwie i w gonitwie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Too slow!"
msgstr "Za wolna!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "A trial of reflexes."
msgstr "Próba refleksu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Reduced to cinders."
msgstr "Spalone na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "We shall test thine speed."
msgstr "Sprawdzimy twą szybkość."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Run! Run as if thine life depends on it!"
msgstr "Biegnij! Biegnij, jakby od tego zależało twoje życie!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "A trial of speed."
msgstr "Próba szybkości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Reduced to cinders."
msgstr "Spalone na popiół."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "This odd training ground will suffice."
msgstr "Ten dziwny teren nada się do treningu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Feel the warrior's spirit within you!"
msgstr "Poczuj w sobie ducha wojownika!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "A trial of endurance."
msgstr "Próba wytrzymałości."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "A waypoint to guide our vegetable beasts."
msgstr "Punkt orientacyjny dla jarzynowych bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "A waypoint to guide our vegetable beasts."
msgstr "Punkt orientacyjny dla jarzynowych bestii."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "Alas, it is no more."
msgstr "Niestety, skończyło się."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Who shall claim this noble victory?"
msgstr "Któż odniesie zwycięstwo?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "The day is won!"
msgstr "Zwycięstwo!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner}'s vegetable champion has seized victory."
msgstr "Zwyciężyło warzywo, którego właścicielem jest {winner}."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "This shall mark the race's end point."
msgstr "Tutaj zakończy się gonitwa."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "We shall see which vegetable beast prevails!"
msgstr "Zobaczmy, które warzywo zwycięży!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "The race cannot commence without it!"
msgstr "Gonitwa nie może się bez tego rozpocząć!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Naught but ash."
msgstr "Kupa popiołu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "You are not yet ready!"
msgstr "Nie jesteś jeszcze gotowa!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "This beast will serve me well in the coming battle."
msgstr "Ta bestia dobrze się sprawdzi w nadchodzącej bitwie."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "We shall see just how strong my veggie beast truly is."
msgstr "Zobaczmy, jak silne jest moje warzywo."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "It's time to put my veggie beast to the test."
msgstr "Pora sprawdzić moją jarzynę."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_SEEDPACKET"
msgid "I care not for growing vegetables."
msgstr "Nie dbam o hodowlę warzyw."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "The rarity of these non-meats doth not impress me."
msgstr "Niezwykłość tych warzyw nie robi na mnie wrażenia."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD1"
msgid "A meaty feast!"
msgstr "Mięsna uczta!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD2"
msgid "'Tis fit only for the beasts."
msgstr "Dobre to jeno dla zwierząt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.YOTP_FOOD3"
msgid "I shall consume it!"
msgstr "Pożrę to!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_GENERIC"
msgid "It is an artifact of this realm."
msgstr "To artefakt z tego świata."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_SMOLDERING"
msgid "Flames will soon consume it."
msgstr "Ogień wkrótce się z tym rozprawi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE_TOODARK"
msgid "Too dark, even for battle."
msgstr "Za ciemno na bitwę."

#. STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "Bones and all."
msgstr "Chyba się wykluwa."

#. STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.EAT_FOOD.WINTERSFEASTFUEL"
msgid "It doth taste just like chicken!"
msgstr "Smakuje jak kurczak!"

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_LOSE"
msgid "The god of the sky has been angered!"
msgstr "Gniew boga niebios został zbudzony!"

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Alas! If I'd only grabbed it sooner."
msgstr "Niestety! Gdybym tylko sięgnęła tu wcześniej."

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "T'were not meant to be a meal."
msgstr "Nie była pisana im rola posiłku."

#. STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.QUAGMIRE_ANNOUNCE_WIN"
msgid "We shall live to fight another day!"
msgstr "Przetrwamy, a nasz bój będzie trwać!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "I shall have to find the key."
msgstr "Nadal brakuje mi klucza."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I must wait and regain my strength."
msgstr "Muszę chwilę poczekać i odzyskać siły."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "No need to do it twice."
msgstr "Nie ma potrzeby tego powtarzać."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "I can't do that while it's covered in moon glass."
msgstr "Nie mogę tego zrobić, kiedy jest pokryte szkłem księżycowym."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.HASPET"
msgid "One pet is enough responsibility."
msgstr "Jedno zwierzę to i tak duża odpowiedzialność."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.BUILD.MOUNTED"
msgid "Even with my long arms, I still can't reach."
msgstr "Nawet moje długie ramiona tam nie sięgają."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Oh. There go all my good pocket squares."
msgstr "Och. No i tyle mam ze swoich poszetek."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "How could you improve on perfection?"
msgstr "Jak ulepszyć ideał?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CHANGEIN.INUSE"
msgid "They're in much more dire need of it."
msgstr "Zdaje się, iż inni daleko bardziej tego potrzebują."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COMPARE_WEIGHABLE.TOO_SMALL"
msgid "It's not worth my time."
msgstr "Szkoda mojego czasu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "Well I need something to build with."
msgstr "Cóż, trzeba mi do tego jakichś narzędzi."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "I don't like sharing."
msgstr "Nie lubię się dzielić."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "It needs completely different plans."
msgstr "Tu potrzeba zupełnie innych planów."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "That's the wrong part."
msgstr "To niewłaściwa część."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.GENERIC"
msgid "Nothing ever goes as planned."
msgstr "Nic nie może pójść według planu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.INUSE"
msgid "Hmph. You're adding too much salt."
msgstr "Fe. Dodajesz zbyt dużo soli."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.COOK.TOOFAR"
msgid "I must get closer."
msgstr "Muszę podejść bliżej."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.DRAW.NOIMAGE"
msgid "My memory isn't good enough to draw from it."
msgstr "Za słabą mam pamięć, by z niej rysować."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "Blast! This is hopeless."
msgstr "Szlag! To nie ma sensu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "I had to try."
msgstr "Musiałem spróbować."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.BUSY"
msgid "It's busy, currently."
msgstr "Akurat jest zajęty."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "It refuses to bend to my will."
msgstr "Odmawia nagięcia się do mej woli."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DEAD"
msgid "The dead have no need of such things."
msgstr "Martwi nie potrzebują takich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.DUPLICATE"
msgid "That can already be made here."
msgstr "Można już to zrobić."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.FOODFULL"
msgid "We've already placed something on the altar."
msgstr "Na ołtarzu już coś jest."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GENERIC"
msgid "I should think not."
msgstr "Tak myślałem."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "I don't think so. They might still be mad."
msgstr "Nie sądzę. Lepiej przeczekać burzę."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "A living log would be more suited to this."
msgstr "Żywa kłoda lepiej by się nadawała."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "A mushroom would be more suited to this."
msgstr "Grzyb lepiej by się nadawał."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOMOON"
msgid "It's not going to work in here."
msgstr "To tu nie zadziała."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTDISH"
msgid "That wouldn't be a very good sacrifice, now would it?"
msgstr "To nie byłaby stosowna ofiara, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTGEM"
msgid "Even The Amazing Maxwell couldn't wring magic from that."
msgstr "Nawet Maxwell Niesamowity nie wykrzesze z tego magii."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "That is certainly not for sculpting with."
msgstr "To zdecydowanie nie służy do rzeźbienia."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "Hm. No, that's not right."
msgstr "Hmm. Nie, tak nie może być."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "I have bigger things to worry about right now."
msgstr "Mam teraz inne zmartwienia."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Ugh. I'm not doing anything in that mess."
msgstr "Nie, w takim bałaganie nie będę pracować."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "It's much too late for that."
msgstr "Jest już na to o wiele za późno."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLEEPING"
msgid "It's thoroughly unconscious."
msgstr "Jest kompletnie nieświadomy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.SLOTFULL"
msgid "Occupied."
msgstr "Zajęte."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGGEM"
msgid "That would be an amateurish misuse of its magic."
msgstr "To byłoby kompletne amatorstwo i nieumiejętne wykorzystanie magii."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "The bones were too amateurishly assembled."
msgstr "Te kości zostały ułożone po amatorsku."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Jak będziesz mieć chwilkę."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Martwi nie potrzebują takich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "Nie należy porywać się na więcej, niźli jest to możliwe."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Hmm... Zatem odpocznij."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "When you have a moment."
msgstr "Jak będziesz mieć chwilkę."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "The dead have no need of such things."
msgstr "Martwi nie potrzebują takich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "No sense giving them more than they can carry."
msgstr "Nie należy porywać się na więcej, niźli jest to możliwe."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Err... I'll let you rest."
msgstr "Hmm... Zatem odpocznij."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "That can already be made here."
msgstr "Można już to zrobić."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "Well, that didn't quite work as I planned."
msgstr "Cóż, nie do końca poszło po mojej myśli."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "How inconvenient."
msgstr "Trochę to kłopotliwe."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "Blast it!"
msgstr "Niech to szlag!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.INUSE"
msgid "Once again the seat of power is stolen from me!"
msgstr "Kolejny raz siedzisko potęgi zostało mi skradzione!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Być może powinienem się cofnąć."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "I won't use my good fishing rod in this stagnant pond."
msgstr "Nie będę marnować mojej dobrej wędki na jakiś zatęchły staw."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.INUSE"
msgid "It's unavailable."
msgstr "Brak dostępu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "Say, pal, why don't you come work for me?"
msgstr "Może masz ochotę dla mnie pracować?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "Its allegiance lies elsewhere."
msgstr "Musi służyć komuś innemu."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I have no use of such things."
msgstr "Nie widzę w tym pożytku."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "I could have told you that wouldn't fit."
msgstr "Mogłem ci powiedzieć, że nie będzie pasować."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Clearly this is the wrong dish."
msgstr "To chyba jasne, że to danie jest niewłaściwe."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I've already put this on a dish."
msgstr "Użyłem już naczynia."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "I must time this perfectly if I'm to succeed."
msgstr "Muszę idealnie zsynchronizować to w czasie, jeśli chcę odnieść sukces."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "This isn't exactly my forte."
msgstr "To nie jest moja mocna strona."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "Hmph. Physical labor is more suited to underlings."
msgstr "Hmpf. Praca fizyczna jest dobra dla sług."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Curses."
msgstr "Motyla noga!"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.INUSE"
msgid "I'm quite adept at waiting. I've had a lot of practice."
msgstr "Jestem całkiem wprawiony w czekaniu. Miałem wiele okazji do ćwiczeń."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Mam ważniejsze rzeczy do roboty niż to."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "Perhaps I should take a step back."
msgstr "Być może powinienem się cofnąć."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SAIL.REPAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SAIL.REPAIR"
msgid "It looks fine to me as is."
msgstr "Na moje oko wygląda dobrze."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I don't think she'd take kindly to that."
msgstr "Nie sądzę, żeby mu się to spodobało."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.GENERIC"
msgid "To what end?"
msgstr "Po cóż mam to czynić?"

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SHAVE.NOBITS"
msgid "But it's already as smooth as a baby's rear end."
msgstr "Jest już gładki jak pupa niemowlaka."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "It has escaped my clutches."
msgstr "Wywinął mi się."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
msgid "This race seems to be decidedly lacking in racers."
msgstr "W tym wyścigu stanowczo brakuje zawodników."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.GENERIC"
msgid "It wouldn't fit."
msgstr "Nie zmieści się."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.INUSE"
msgid "Worry not, pal. I've the patience of a saint."
msgstr "Nie obawiaj się. Posiadam anielską cierpliwość."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTALLOWED"
msgid "That can't go in there."
msgstr "To tu nie pasuje."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.STORE.NOTMASTERCHEF"
msgid "I have more important things to do than that."
msgstr "Mam ważniejsze rzeczy do roboty niż to."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.CANTLEARN"
msgid "There's a lesson to be learned about tampering with secret knowledge."
msgstr "Lepiej nie kombinować z tajemną wiedzą."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.KNOWN"
msgid "I am far too advanced for this."
msgstr "Jestem na to za mądry."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.MESSAGEBOTTLEMANAGER_NOT_FOUND"
msgid "I'll extract its secrets once I find some suitable lighting."
msgstr "Wyciągnę z niej wszystkie sekrety, jak tylko znajdę odpowiednie oświetlenie."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I seem to be in the wrong place to use this."
msgstr "Chyba jestem w niewłaściwym miejscu, żeby tego użyć."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.TELLSTORY.GENERIC"
msgid "only_used_by_walter"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "I'll not be done in by an overgrown Krampus."
msgstr "Nie będzie ze mną zadzierać żaden przerośnięty krampus."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "It appears there's another key around here."
msgstr "Gdzieś tu musi być jakiś inny klucz."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Blast! Wrong key."
msgstr "Szlag! Zły klucz."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I don't know what to wrap."
msgstr "Nie wiem, co mam zapakować."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.GENERIC"
msgid "I'm unable to do that right now."
msgstr "Nie mogę tego teraz zrobić."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL.WRITE.INUSE"
msgid "I can wait... it's the courteous thing to do."
msgstr "Poczekam... Wymaga tego elegancja."

#. STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ACTIONFAIL_GENERIC"
msgid "That didn't work."
msgstr "Nie udało się."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT"
msgid "I need to pass the time somehow."
msgstr "Muszę jakoś zabić czas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "Ah. The satisfaction of a job well done."
msgstr "Ach. To uczucie satysfakcji z owocnej pracy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ADVENTUREFAIL"
msgid "I of all people should be able to do this."
msgstr "Jeśli ktokolwiek powinien sobie z tym poradzić, to właśnie ja."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "My world is crumbling!"
msgstr "Mój świat! Zapada się!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "I am attacked by my own world!"
msgstr "Atakuje mnie mój własny świat!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "An earthquake!"
msgstr "Trzęsienie ziemi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "May this tribute sate the beast."
msgstr "Niechże ten dar zaspokoi pragnienie bestii."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Does this entertain you, beast?"
msgstr "Czy znajdujesz w tym radość, stworze?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "What a chore."
msgstr "Cóż za wysiłek."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Dark magics are returning."
msgstr "Czarna magia na nowo nabiera mocy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Here we go again."
msgstr "Zaczynamy od początku."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "The power's growing."
msgstr "Potęga rośnie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "I'm not afraid of some fisticuffs!"
msgstr "Nie boję się rękoczynów!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "Unlimited power!"
msgstr "Nieograniczona moc!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "Finally, some respite from the dampness."
msgstr "Wreszcie odrobina wytchnienia od wilgoci."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I feel protected by an unseen force."
msgstr "Czuję, że czuwa nade mną niewidzialna siła."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "My focus feels heightened!"
msgstr "Moje skupienie wzrosło!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BECOMEGHOST"
msgid "oOooooOO!!"
msgstr "oOooooOO!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BEES"
msgid "Killing me won't bring back your honey!"
msgstr "Zabicie mnie nie zwróci wam miodu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_LEAK"
msgid "We've sprung a leak!"
msgstr "Mamy przeciek!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOAT_SINK"
msgid "Oh dear."
msgstr "O rany."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BOOMERANG"
msgid "Ow! Blasted... clumsy hands!"
msgstr "Auć! Niech to.... dwie lewe ręce!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BRAVERY_POTION"
msgid "I was never really scared of those trees anyhow."
msgstr "Tak szczerze, nigdy nie bałem się zanadto tych drzew."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_BURNT"
msgid "It burns!"
msgstr "Pali!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "\nChyba umiałabym to naprawić!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Wake up, you useless vermin!"
msgstr "Pobudka, bezużyteczny szkodniku!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "What's the matter? Get going!"
msgstr "Co jest? Ruszaj się!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Faster! Faster I say!"
msgstr "Szybciej! Szybciej mówię!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "You fool! You're going the wrong way!"
msgstr "Głupolu! Nie tędy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "No! The other way!"
msgstr "Nie! W drugą stronę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CARRAT_START_RACE"
msgid "Begin!"
msgstr "Start!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CAVEIN"
msgid "The ceiling is going to collapse!"
msgstr "Sklepienie zaraz się zawali."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE"
msgid "Charlie? It's me! Maxwell!"
msgstr "Charlie? To ja! Maxwell!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! Be gentle, Charlie!"
msgstr "Au! Ostrożnie, Charlie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD"
msgid "My heart grows cold."
msgstr "Zimno przeszywa me serce."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT"
msgid "The compass has fallen to pieces."
msgstr "Kompas rozpadł się na kawałki."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL"
msgid "Er... I can't do that."
msgstr "Eee... Nie mogę tego zrobić."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP"
msgid "Damp is not dapper."
msgstr "Wilgoć nie jest elegancka."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS"
msgid "I hear one of them coming."
msgstr "Nadchodzi jeden z nich."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN"
msgid "Say, pal, I don't look so good..."
msgstr "Hej, kolego, coś słabo wyglądasz..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength has left me."
msgstr "Siły mnie opuściły."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Shame. I was starting to enjoy that."
msgstr "Szkoda. Zaczynało mi się podobać."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I'm exposed to the elements!"
msgstr "Jestem narażony na działanie sił natury!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I've been left vulnerable!"
msgstr "Stałem się bezbronny!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "My enthusiasm for this has run dry."
msgstr "Zapał mnie opuścił."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That takes care of that."
msgstr "Oj, niedobrze."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK"
msgid "It'll be dark soon. Charlie will be waking up."
msgstr "Zaraz się ściemni i Charlie się obudzi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC"
msgid "(Gulp!)"
msgstr "**przełyka**"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID"
msgid "I won't let that anywhere near my mouth."
msgstr "Nie zbliżę tego do ust."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL"
msgid "Ow! That hurt my mouth!"
msgstr "Auć! To bolało!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED"
msgid "That was putrid."
msgstr "To było paskudne."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE"
msgid "That was past its expiration date."
msgstr "Data przydatności minęła już dawno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY"
msgid "A civilized man does not eat such things."
msgstr "Cywilizowani ludzie nie jedzą takich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I suppose it's only right to share this with the others."
msgstr "Chyba wypada podzielić się tym z innymi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1"
msgid "Reduced... to this..."
msgstr "Tak... nisko... upadłem?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2"
msgid "Huff... huff..."
msgstr "Uff... uff..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3"
msgid "This is... peasant... work..."
msgstr "Robota... dla... tragarza..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4"
msgid "Oh... my back..."
msgstr "Au... Moje plecy..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5"
msgid "I wasn't... built for this..."
msgstr "Nie zostałem... stworzony... do takich rzeczy..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6"
msgid "All my joints... are cracking!"
msgstr "Moje stawy... zaraz pękną..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7"
msgid "I... was a king, you know..!"
msgstr "Byłem kiedyś.... królem...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8"
msgid "Oof... huff..."
msgstr "Uff... puff..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9"
msgid "This... better not ruin... my suit."
msgstr "Oby... nie zniszczył mi się... garnitur od tego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK"
msgid "That smell... both nostalgic and terrifying!"
msgstr "Ten zapach... Nostalgiczny i upiorny zarazem!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT"
msgid "Thank goodness for the light."
msgstr "Dzięki niebiosom za światło."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT"
msgid "There goes my respite."
msgstr "Nie będzie mi dane odetchnąć."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN"
msgid "Am I supposed to come running every time I spot a flare?"
msgstr "Czy mam przybiegać za każdym razem, jak zobaczę flarę?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "Wolność! Nareszcie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "Ich szepty wbiają się w samo serce mego umysłu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "Mój mózg aż puchnie od mocy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "Moje serce nie zniesie tego gorąca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Ogary robią się niespokojne."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "W brzuchu mi gra."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Czuję łajno i pot bestii."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "A niech to! Uciekł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "Nie mogę tropić w tych warunkach!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Odrobinkę się ruszyło."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Mam już pełne kieszenie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING"
msgid "At last, a decent meal."
msgstr "Nareszcie jakiś porządny posiłek."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "The coward has summoned its minions."
msgstr "Tchórz przywołał swoich sługusów..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to beat a hasty retreat!"
msgstr "Czas wykonać taktyczny odwrót!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its true power has been unlocked!"
msgstr "Oto ujrzymy jego prawdziwą siłę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh. My head hurts."
msgstr "Ugh. Głowa mi wysiada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Can't touch this!"
msgstr "Nic z tego!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Niewiele się z tego dowiedziałem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED"
msgid "How disappointing."
msgstr "Rozczarowałem się."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS"
msgid "What annoying little bugs."
msgstr "Co za małe wredne robale."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Say, pal, you don't look so good."
msgstr "Coś kapkę słabo wyglądasz."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERAFK"
msgid "I must be ever vigilant!"
msgstr "Muszę być czujny!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT"
msgid "That's a terrible idea right now."
msgstr "To absolutnie fatalny pomysł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA"
msgid "They're hot on my heels!"
msgstr "Depczą mi po piętach!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP"
msgid "Not while there's danger afoot!"
msgstr "Nie teraz! Niebezpieczeństwo czyha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep during daylight hours."
msgstr "Nie mogę spać w dzień."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Sleeping now would mess up my sleep schedule!"
msgstr "Jak się teraz prześpię, rozreguluje mi się cały zegar biologiczny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA"
msgid "Traditionally, a siesta comes after eating, not before."
msgstr "Z reguły sjestę się robi po jedzeniu, nie przed."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry. I can't sleep."
msgstr "Nie mogę spać. Jestem zbyt głodny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'm not opening that on top of this thing."
msgstr "Tutaj tego nie otworzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA"
msgid "It's sleep time, not siesta time."
msgstr "Czas na sen, nie na drzemkę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "It's a bit creepy out for that."
msgstr "Trochę tu zbyt straszno na takie rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE"
msgid "That might not be the best idea."
msgstr "To chyba nie jest najlepszy pomysł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE"
msgid "You're kidding right?"
msgstr "To jest żart, tak?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP"
msgid "Odd. They forgot to set it."
msgstr "Dziwne. Zapomnieli ją zastawić."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "That was, of course, just a warm up..."
msgstr "To oczywiście była tylko rozgrzewka..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "We will meet again, mark my words..."
msgstr "Jeszcze kiedyś się spotkamy, wspomnisz moje słowa..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I must exercise patience."
msgstr "Muszę ćwiczyć cierpliwość."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I daresay, this is almost relaxing."
msgstr "Prawie czuję się zrelaksowany."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Why won't they take the bait? Perhaps I should offer secret knowledge..."
msgstr "Dlaczego nie chcą połknąć tej przynęty? Może powinienem im zaoferować tajemną wiedzę..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I am beginning to tire of all this waiting"
msgstr "Zaczyna nużyć mnie to czekanie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Blast! That cad-fish got away with my tackle!"
msgstr "Szlag! Ta ryba uciekła z moim osprzętem!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line needs more tension."
msgstr "Żyłka musi być bardziej napięta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "We're in for some trouble."
msgstr "Nadciągają kłopoty."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED"
msgid "Have patience!"
msgstr "Uspokój się!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES"
msgid "Oh, this should be good."
msgstr "Ciekawie się zapowiada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "How putrid!"
msgstr "Co za paskudztwo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE"
msgid "That rumbling can't be good."
msgstr "Ten hałas nie wróży niczego dobrego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "Cóż to za sztuczki?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH"
msgid "Knowledge is power. And power is... well, power."
msgstr "Wiedza to potęga. A potęga to... cóż, potęga."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "That was simply undignified."
msgstr "Doświadczenie, bez którego byłbym kontent."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "No need to thank me."
msgstr "Ależ nie ma potrzeby mi dziękować."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE"
msgid "Allow me to assist."
msgstr "Pozwól, że pomogę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET"
msgid "The cycle begins again."
msgstr "Cykl rozpoczyna się na nowo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO"
msgid "It's deemed me unworthy."
msgstr "Kufer rzecze, iż nie jestem godzien."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES"
msgid "Was there ever a doubt?"
msgstr "Czy kiedykolwiek były jakieś wątpliwości?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER"
msgid "Protect me, cursed tree!"
msgstr "Strzeż mnie, przeklęte drzewo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED"
msgid "How dare you!"
msgstr "Jak śmiesz?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED"
msgid "Wetter than water itself."
msgstr "Jestem bardziej mokry niż woda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED"
msgid "Quite an expert illusion."
msgstr "Ekspercka iluzja."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS"
msgid "I scratched my arms up doing that."
msgstr "Podrapałem się."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT"
msgid "A shame."
msgstr "Cóż za szkoda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED"
msgid "It fled back into the earth."
msgstr "Uciekła z powrotem do ziemi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING"
msgid "Now is the time to strike!"
msgstr "Teraz jest dogodny czas do ataku!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP"
msgid "Drat."
msgstr "Szlag."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOMANYBIRDS"
msgid "There are plenty of birds here already."
msgstr "Jest tu już całe mnóstwo ptaków."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT"
msgid "Curses. Another light down."
msgstr "A niech to! Kolejna zgasła."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "It's about time."
msgstr "Już chyba czas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF"
msgid "Ack!"
msgstr "Ajć!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED"
msgid "Hmm, not quite done."
msgstr "Hmm, jeszcze nie skończone."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE"
msgid "My suit is drenched in salt water."
msgstr "Mój garnitur nasiąkł słoną wodą."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WAYTOOMANYBIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WAYTOOMANYBIRDS"
msgid "I must wait before I summon the birds again."
msgstr "Muszę chwilę odczekać, nim będę mógł ponownie wezwać ptaki."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT"
msgid "The creature is past its prime."
msgstr "To stworzenie lata świetności ma już za sobą."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Waga: {weight}"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEr... I don't suppose anyone would help me carry this?"
msgstr "Weight: {weight}\nEe... Zakładam, że nikt mi nie pomoże tego nieść?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET"
msgid "Water'll ruin a good suit, you know?"
msgstr "Woda może zniszczyć najlepszy garnitur."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER"
msgid "I don't think I'll ever be dry again."
msgstr "Już chyba nigdy nie wyschnę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Foiled again!"
msgstr "Kolejne fiasko!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "I don't know what I expected."
msgstr "Sam już nie wiem, na co liczyłem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "That food seems to have had an odd affect on me..."
msgstr "To jedzenie zdaje się mieć na mnie dziwny wpływ..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Its power was short-lived."
msgstr "Ta potęga była krótkotrwała."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE"
msgid "Yech. It's horrible in there."
msgstr "Ech, ale tam paskudnie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS"
msgid "Oh dear. I know what's making that sound."
msgstr "Och, nie. Wiem, co jest źródłem tego dźwięku."

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER"
msgid "You do not belong in MY world!"
msgstr "Nie należysz do MOJEGO świata!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC"
msgid "To arms!"
msgstr "Do broni!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG"
msgid "Brains over brawn!"
msgstr "Umysł ponad krzepę!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY"
msgid "Sacrifice yourself for my comfort!"
msgstr "Poświęć się dla mojej wygody!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER"
msgid "I'll not be made a fool of!"
msgstr "Nie pozwolę z siebie drwić!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR"
msgid "You've forced my hand!"
msgstr "Zmuszasz mnie do tego!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC"
msgid "And stay away!"
msgstr "I trzymaj się z daleka!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG"
msgid "Next time, pig!"
msgstr "Do następnego razu, prosiaku!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY"
msgid "You're not worth my time!"
msgstr "Szkoda na ciebie mojego czasu!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER"
msgid "I won't be made a fool of... next time!"
msgstr "Nie pozwolę robić z siebie durnia... następnym razem!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time the gloves come off!"
msgstr "Następnym razem ci nie daruję!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Hm? What a familiar presence."
msgstr "Hmm? Osobliwie znajome uczucie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "It demands a sacrifice."
msgstr "Domaga się ofiary."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I should quit toying with this now."
msgstr "Lepiej, jeśli przestanę z tym igrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "I can sense strong magic within it."
msgstr "Wyczuwam potężną magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "A powerful bond tethers this spirit to our world."
msgstr "Potężna więź łączy tego ducha z naszym światem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "...I wonder how my brother is doing."
msgstr "Zastanawiam się, jak też radzi sobie mój brat..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I can sense strong magic within it."
msgstr "Wyczuwam potężną magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "This enchantment is not of my doing."
msgstr "To nie moje dzieło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Whatever it is will be arriving soon."
msgstr "Cokolwiek to jest, wkrótce się przekonamy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Even They couldn't build something so devious."
msgstr "Nawet Oni nie zdołaliby zbudować czegoś tak diabelskiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Ktoś bardziej miłujący przyrodę może byłby w stanie do czegoś ją wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED"
msgid "Over an open fire."
msgstr "Na otwartym ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Hmm, wygląda na to, że powinna być w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL"
msgid "So that's where I left that thing!"
msgstr "A więc tu go zostawiłem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET"
msgid "It channels the darkest energies of the universe."
msgstr "Pozwala przetworzyć mroczną energię wszechświata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR"
msgid "I can drop it to keep the boat in place."
msgstr "Mogę ją wyrzucić, żeby utrzymać łódź na miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM"
msgid "Can't someone else assemble it?"
msgstr "Czy ktoś inny nie może tego złożyć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR"
msgid "Where are their gods now?"
msgstr "Gdzie są teraz ich bogowie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This can be partially restored."
msgstr "Można go częściowo odbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE"
msgid "A once proud race."
msgstr "Niegdyś była to dumna rasa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK"
msgid "Some dumb beast passed through here."
msgstr "Jakiś głupi zwierz tędy przechodził."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES"
msgid "What a miserable thing."
msgstr "Co za żałosne stworzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC"
msgid "Have you no pride?"
msgstr "Czyżbyś nie miał żadnego poczucia godności?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's going to wreak havoc on my world."
msgstr "Sprowadzi zniszczenie na mój świat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We've placated it for now."
msgstr "Udało mi się go tymczasowo udobruchać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET"
msgid "I'll cross it off my bucket list."
msgstr "Jedna pozycja z listy obowiązków mniej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY"
msgid "That's some fly mail."
msgstr "Pancerz smoka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS"
msgid "Direct confrontation is quite gauche."
msgstr "Trochę surowy w dotyku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE"
msgid "That really isn't my style."
msgstr "To naprawdę nie mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS"
msgid "Thulecite meshes so well with nightmare fuel."
msgstr "Tulecyt doskonale komponuje się z koszmarnym paliwem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON"
msgid "Like all things, it craves the fuel."
msgstr "Potrzebuje paliwa. Jak wszystko inne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER"
msgid "Wet, soggy, and oddly filling."
msgstr "Wilgotny i dziwnie sycący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL"
msgid "That is not dapper at all."
msgstr "Ani krztyny klasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD"
msgid "Ugh. I'm not typically one for vulgar fisticuffs."
msgstr "Ugh. Nie w moim stylu takie barbarzyńskie rozwiązania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who's frail now?"
msgstr "I kto jest teraz delikatny?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY"
msgid "Wrap yourself in the nightmare. Embrace it."
msgstr "Owiń się w koszmar. Otwórz się na niego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "„Tamtędy”... Ech!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "„Tamtędy”... Ech!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC"
msgid "A fine powder that smells of destruction."
msgstr "Proszek pachnący zniszczeniem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Don't worry. There will be more Chesters."
msgstr "Nie martw się. Skrzynek na świecie nie zabraknie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "There's always another Glommer."
msgstr "Zawsze znajdzie się inny glomer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "My trip through the portal made it unrecognizable."
msgstr "Podróż przez portal zmieniła jego strukturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS"
msgid "We must always eat our vegetables."
msgstr "Podobno zawsze trzeba dojadać warzywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP"
msgid "I suppose you can make soup from anything."
msgstr "Przypuszczam, że zupę da się zrobić ze wszystkiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED"
msgid "Smells terrible."
msgstr "Śmierdzi niemiłosiernie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is feeding off the dark energy."
msgstr "Żywi się mroczną energią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Best not to overuse this power."
msgstr "Lepiej jej nie nadwyrężać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Now we've gone and done it."
msgstr "No to się porobiło…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It lacks a key."
msgstr "Brakuje klucza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON"
msgid "This is a most wretched idea."
msgstr "To fatalny pomysł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY"
msgid "It's strange to see it."
msgstr "Osobliwy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No fuel, no power."
msgstr "Bez paliwa nie ma energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "It feeds off the nightmare."
msgstr "Żywi się koszmarami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I can't believe I've forgotten how to read this."
msgstr "Nie chce mi się wierzyć, że zapomniałem, jak to odczytywać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of the city, before the fuel."
msgstr "Obraz miasta sprzed czasów paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "We all know what happens next."
msgstr "Wszyscy wiemy, co stanie się teraz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They gained such an enviable power..."
msgstr "Udało im się zdobyć godną pozazdroszczenia potęgę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "I know why you led me back here."
msgstr "Wiem już, czemu mnie tu sprowadziliście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "But it won't work."
msgstr "Ale to się nie uda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE"
msgid "There's a dreamlike quality to the material."
msgstr "Zdaje się być stworzona z jakiegoś sennego surowca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE"
msgid "Sometimes the direct approach is best."
msgstr "Czasem proste rozwiązania są najlepsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "They're even ugly as infants."
msgstr "Nawet jako niemowlaki są paskudne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Seems we've a few hours of reprieve."
msgstr "Chyba mamy kilka godzin wytchnienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK"
msgid "I wish there were porters around here."
msgstr "Szkoda, że nie ma w tym świecie bagażowych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS"
msgid "Now that is a proper breakfast."
msgstr "Właśnie tak powinno wyglądać śniadanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON"
msgid "This seems out of place here. Too cheery."
msgstr "Zupełnie tu nie pasuje. Za wesoło mu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY"
msgid "Those look much too jovial for my liking."
msgstr "Zanadto jowialne, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP"
msgid "Hm... I don't know what I was expecting."
msgstr "Hmm... Nie wiem, na co liczyłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE"
msgid "Sticky and gooey and good for putting on booboos."
msgstr "Klejący i rozciągliwy. Na gagę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE"
msgid "I wish they were oysters."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA"
msgid "I suppose I'll eat it if there's nothing else."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I suppose anything is \"food\" now."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI"
msgid "At least it's an attempt at sophistication."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED"
msgid "It's an acquired taste."
msgstr "Do takich rzeczy trzeba przywyknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE"
msgid "It's surprisingly delicious."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT"
msgid "I made a rock so heavy that even I can't lift it."
msgstr "Sprawiłem sobie kamień cięższy niż ze spiżu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT"
msgid "Ugh. Ugly beasts."
msgstr "Paskudne. Paskudne bestie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT"
msgid "Violence has never felt better."
msgstr "Przemoc jeszcze nigdy nie dawała tyle frajdy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE"
msgid "Ugh. It stinks."
msgstr "Uff. Śmierdzi tu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB"
msgid "It smells quite nice, if I'm honest."
msgstr "Szczerze mówiąc, zapach ma całkiem znośny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING"
msgid "I'm not eating that."
msgstr "Nie zamierzam tego jeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED"
msgid "I'm still not eating that."
msgstr "I tak nie zamierzam go zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR"
msgid "Hirsute."
msgstr "Włochata sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER"
msgid "Take whatever you want."
msgstr "Bierz, co tylko chcesz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST"
msgid "See my vest."
msgstr "Popatrz na tę kamizelę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR"
msgid "This would make a nice rug."
msgstr "Byłby z niego niezły dywanik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY"
msgid "At least they're good for something."
msgstr "Przynajmniej do czegoś się nadają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW"
msgid "I don't like sleeping rough."
msgstr "Nie przepadam za spaniem w takich warunkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC"
msgid "They work so hard, the fools."
msgstr "Tak ciężko pracują. Głupie owady."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD"
msgid "Now what do I do with it?"
msgstr "I co mam z nią zrobić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT"
msgid "Honey roasted."
msgstr "Pieczony miód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So tempting, but so full of bees."
msgstr "Oj kusi, ale niestety jest pełny pszczół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC"
msgid "It holds the bees."
msgstr "Pojemnik na pszczoły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Czemu te pszczoły nie są mymi sługami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY"
msgid "So tempting, but so full of bees."
msgstr "Oj kusi, ale niestety jest pełny pszczół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Trzeba jeszcze trochę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Honey roasted."
msgstr "Pieczony miód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Zrobiłem już dość, ta stara kobieta może sobie sama walczyć z pszczołami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "I think she made this herself."
msgstr "Chyba sama to zrobiła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Czemu te pszczoły nie są mymi sługami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Zrobiłem już dość, ta stara kobieta może sobie sama walczyć z pszczołami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Trzeba jeszcze trochę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like a creature that knows its place."
msgstr "Lubię, gdy zwierzęta znają swoje miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Aw nuts, it's following me."
msgstr "A niech to. Idzie za mną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC"
msgid "Just look at that stupid beast."
msgstr "Popatrz tylko na to głupie zwierzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED"
msgid "Now it looks dumb AND pathetic."
msgstr "Teraz wygląda nie tylko głupio, ale do tego żałośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY"
msgid "Yes, you understand how this works."
msgstr "Tak, ty rozumiesz, jak to działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY"
msgid "I suppose some people might find that charming."
msgstr "Zdaje się, że dla niektórych jest to uroczy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER"
msgid "I'd only ride you if I was desperate."
msgstr "Musiałbym być pod ścianą, by na tobie jeździć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's only marginally less stupid when it's asleep."
msgstr "Jak śpi, jest tylko marginalnie mniej głupi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT"
msgid "How unfashionable."
msgstr "Wyczuciem smaku bym tego nie nazwał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL"
msgid "It smells like a barn."
msgstr "Śmierdzi oborą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD"
msgid "Keep your backside to yourself, madam!"
msgstr "Trzymaj swój odwłok z dala ode mnie, madam!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT"
msgid "I'll wear it if I have to."
msgstr "Jak będzie trzeba, to założę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE"
msgid "Not the bees!"
msgstr "Tylko nie pszczoły!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE"
msgid "They wait so patiently."
msgstr "Ależ są cierpliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL"
msgid "Maybe I shouldn't have put that there."
msgstr "Może nie powinienem był jej tu umieszczać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN"
msgid "I didn't make that one! Really!"
msgstr "Ja tego nie stworzyłem, poważnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I am not getting that on my shoes."
msgstr "Nie zamierzam w to wdepnąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Now what are those bees up to?"
msgstr "Co te pszczoły kombinują?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "I don't see what all the buzz is about."
msgstr "Nie wiem, o co ten szum."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX"
msgid "I miss sealing a good letter."
msgstr "Brakuje mi prawdziwych listów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR"
msgid "Back to the dungeons with you!"
msgstr "Wracaj do swego obmierzłego lochu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL"
msgid "More bell."
msgstr "Będzie hałas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE"
msgid "Just what am I looking at here?"
msgstr "Na co ja właściwie patrzę?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG"
msgid "How truly unnerving."
msgstr "Jakże niepokojący widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It's seen better days."
msgstr "Nie jest w najlepszej formie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It makes me a little nostalgic."
msgstr "Sprawia, iż ogarnia mnie nostalgia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES"
msgid "Sigh. If I have to."
msgstr "Ech. Jakoś się zmuszę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY"
msgid "Delightfully sweet with a subtle hint of tartness."
msgstr "Wybornie słodkie. Z subtelną nutką cierpkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're quite delicious, actually."
msgstr "Tak naprawdę są całkiem pyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs manure."
msgstr "Potrzeba nawozu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING"
msgid "It better not start talking to me."
msgstr "Mam nadzieję, że nie zacznie do mnie rozmawiać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Reduced to eating berries. Sigh."
msgstr "Że też przyszło mi jeść jakieś dzikie owoce..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED"
msgid "And now we wait."
msgstr "No to teraz czekamy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot for that little bush."
msgstr "Za ciepło dla tego krzaczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It looks to be in need of assistance. Fertilizer, perhaps?"
msgstr "Potrzebne substancje odżywcze. Może nawóz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It better not start talking to me."
msgstr "Mam nadzieję, że nie zacznie do mnie rozmawiać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The berries will stay fresh as long as I leave them there."
msgstr "O ile zostawię je tutaj, te jagody powinny zachować świeżość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "I fear I'll have to wait."
msgstr "Obawiam się, że muszę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I know the feeling."
msgstr "Znam to uczucie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE"
msgid "This seems like a lot of fuss for some mashed berries."
msgstr "Za dużo zachodu jak na rozgniecione porzeczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA"
msgid "It has a unique spongy texture."
msgstr "Ma wyjątkową, gąbczastą konsystencję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT"
msgid "Now that is surely fuel for nightmares."
msgstr "To jest dopiero paliwo dla koszmarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE"
msgid "A nut with legs! How terrifying!"
msgstr "Orzech z nogami! Straszna rzecz!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD"
msgid "That's a deep sleep."
msgstr "Śpi bardzo, bardzo głęboko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC"
msgid "You'll never get me behind bars again."
msgstr "Nie dam się już więcej zamknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about, feathers?"
msgstr "O co tyle krzyku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "I feel for ya, feathers."
msgstr "Rozumiem twój ból, pierzasty przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Maybe he wasn't sleeping."
msgstr "Może wcale nie spał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You'll still be in there when you wake up."
msgstr "I tak tu będziesz, jak się obudzisz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh, come on. I fed you last week."
msgstr "Nie wygłupiaj się, karmiłem cię w zeszłym tygodniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP"
msgid "They keep falling for it!"
msgstr "Wciąż się nabierają na te same sztuczki!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG"
msgid "I like to think of it as baby bird prison."
msgstr "Zawsze sobie tłumaczę, że to więzienie dla małego ptaszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side up."
msgstr "Sadzone najlepsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP"
msgid "I'm especially proud of that piece."
msgstr "Jestem z niego szczególnie dumny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "How DARE you!"
msgstr "Jak ŚMIESZ?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE"
msgid "They degrade without proper upkeep."
msgstr "Bez odpowiedniej opieki zaczynają wariować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE"
msgid "Just make sure to breathe out."
msgstr "Tylko pamiętaj, żeby zrobić wydech."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA"
msgid "That is not my style."
msgstr "To nie w moim stylu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2"
msgid "I'm no blowhard."
msgstr "Jedno dmuchnięcie i po kłopocie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE"
msgid "A glorious tube of pain!"
msgstr "Wspaniała tuba bólu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP"
msgid "Call me \"Mr. Sandman\"."
msgstr "Aaa, kotki dwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr "Nigdy nie uderza dwa razy w to samo miejsce. No chyba że akurat tak się trafi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "Jest cały pokryty szronem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "Niebieski symbolizuje lód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr "Przypomina się, że muszę poćwiczyć swoje zimne spojrzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "Wiem wszystko na ten temat. Po prostu wyleciało mi z głowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr "Zaiste unikatowy plan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "Czy coś mogłoby pójść nie tak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
msgid "Umami!"
msgstr "Umami!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "The blue ones are good for, uh, something."
msgstr "Niebieskie nadają się do... hmm... czegoś."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's not ready."
msgstr "Jeszcze nie jest gotowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Another time, maybe?"
msgstr "Może innym razem?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS"
msgid "Roughly hewn."
msgstr "Grubo ciosane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON"
msgid "Begone, swine."
msgstr "Odejdźże, knurze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR"
msgid "Well he's certainly no slouch."
msgstr "Kawał chłopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH"
msgid "I detest such work."
msgstr "Nie cierpię takiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM"
msgid "I've been reduced to a common shipyard laborer."
msgstr "Stałem się zwykłym robolem w stoczni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK"
msgid "Oh, great. Now we're going to drown."
msgstr "Świetnie. Teraz zatoniemy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD"
msgid "Grind them bones."
msgstr "Wielokrotne złamanie otwarte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP"
msgid "It's hearty and filling."
msgstr "Tłuste i pożywne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW"
msgid "Leave no scrap unused."
msgstr "Nic nie może się zmarnować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS"
msgid "What a wasteful misuse of magic."
msgstr "Cóż za smutne marnotrawstwo magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE"
msgid "I've had enough fire and brimstone for one eternity."
msgstr "Starczy mi ognia i siarki, jak na jedną wieczność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL"
msgid "The words within evoke an unknown force."
msgstr "Zawarte weń słowa są kluczem do niezmierzonej potęgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL"
msgid "I could stop a fiend in its tracks with this."
msgstr "Mógłbym powstrzymać tym niejednego wroga."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "Niemądrze igrać z mocami przekraczającymi twe pojmowanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP"
msgid "I haven't had a real sleep in... ages."
msgstr "Nie spałem porządnie od... lat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES"
msgid "What horrors shall be summoned from the depths?"
msgstr "Cóż za nieopisane koszmary da się przywołać z głębin?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG"
msgid "Beats getting your hands dirty."
msgstr "Nie brudzi rąk."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH"
msgid "It's like showing affection, without actually touching it."
msgstr "Pozwala okazać zaangażowanie bez konieczności dotyku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET"
msgid "Good for capturing defenseless insects."
msgstr "Do łapania bezbronnych owadów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Disgusting. I'll have someone else pick it."
msgstr "Obrzydlistwo. Niech ktoś inny to zbierze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "We already took the food parts."
msgstr "Zebraliśmy już to, co da się zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT"
msgid "For keeping the peasantry in line."
msgstr "To żeby chłopstwo nie wychodziło przed szereg."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE"
msgid "Nice and snug."
msgstr "Przyjemna i foremna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP"
msgid "I guess we could wrap a few things up."
msgstr "Moglibyśmy coś zapakować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN"
msgid "It reminds me of my old act."
msgstr "Przypomina mi się, jak grałem w teatrzyku szkolnym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Utterly destroyed."
msgstr "Akt kompletnej destrukcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT"
msgid "There's room in there for me."
msgstr "Znajdzie się tam dla mnie miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER"
msgid "Some puns are irresistible."
msgstr "Osełka masełka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It's a flying flower."
msgstr "Latający kwiatek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD"
msgid "It would be a shame if someone ripped the wings off of it."
msgstr "Szkoda by było, jakby mu ktoś urwał skrzydła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN"
msgid "That should stop its incessant flapping."
msgstr "Dość tego trzepotania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS"
msgid "Ha ha ha. I got him!"
msgstr "Ha, ha, ha! Dorwałem go!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD"
msgid "Carrion connoisseur."
msgstr "Koneser mięsa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS"
msgid "Meat rolled in cabbage. How exciting."
msgstr "Mięso zawinięte w kapustę. Doprawdy ekscytujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC"
msgid "Puffer plant."
msgstr "Jeżoroślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED"
msgid "Cactus? More like flat-tus!"
msgstr "Kaktus platfus!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER"
msgid "This part of the cactus is always nice."
msgstr "Ta część kaktusa jest fantastyczna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT"
msgid "It would be unwise to put that in my mouth."
msgstr "Włożenie tego do ust nie byłoby rozsądne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Cactus comestible."
msgstr "Kaktus w wersji jadalnej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL"
msgid "I don't think I truly appreciated those sunny shores."
msgstr "Chyba nie doceniałem tych słonecznych wybrzeży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Zaraz będzie po ptokach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC"
msgid "How comforting."
msgstr "Bardzo przyjemne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Charlie przez jakiś czas się nie pokaże."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs fuel."
msgstr "Potrzeba paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Fiery."
msgstr "Ognista sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT"
msgid "That's not coming back."
msgstr "Skończyło się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC"
msgid "How do these things keep getting into my world?"
msgstr "Jak te dziwadła dostają się do mojego świata?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD"
msgid "Bait."
msgstr "Mam cię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED"
msgid "You look atrocious."
msgstr "Wyglądasz okropnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG"
msgid "That's our sugar-sack."
msgstr "Nasza torba słodkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE"
msgid "It has pictures of fast things carved into it."
msgstr "Jest cała pokryta wyobrażeniami szybkich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD"
msgid "Disgusting."
msgstr "Obrzydliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC"
msgid "That carrot is revolting!"
msgstr "Ta marchew się buntuje!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD"
msgid "You thought you could fool me?"
msgstr "Myślałaś, że mnie oszukasz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING"
msgid "I'm sure it is diseased."
msgstr "Na pewno jest chora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Starting to feel left out?"
msgstr "Czujesz się opuszczona?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT"
msgid "I'm not a fan of vegetables."
msgstr "Nie przepadam za warzywami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED"
msgid "How mundane."
msgstr "Nie dla mnie takie przyziemne sprawy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Such directionless destruction."
msgstr "Niepotrzebna strata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Useless."
msgstr "Bezużyteczny śmieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Mapmaking is a soothing pastime. Methodical."
msgstr "Rysowanie map to bardzo uspokajające zajęcie. Metodyczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON"
msgid "Catty vermin."
msgstr "Przebiegły szkodnik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Well, I guess that's that."
msgstr "Cóż, to by chyba było na tyle."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Vermin housing."
msgstr "Dom szkodnika."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT"
msgid "Dead head."
msgstr "W sumie to jest trupia głowa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Well it's not going to move itself."
msgstr "No cóż. Sam się nie ruszy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must deal with the others first."
msgstr "Wpierw musimy zająć się pozostałymi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA"
msgid "Ashes in one's mouth."
msgstr "Smakuje jak popiół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I refuse to be held responsible for that."
msgstr "Nie ponoszę za to odpowiedzialności. Protestuję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Even worse than raw."
msgstr "Pieczony jest jeszcze gorszy.."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE"
msgid "It looks like a banana, but I'm not buying it."
msgstr "Wygląda na banana, ale jakoś mnie nie przekonuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE"
msgid "I plugged it a long time ago."
msgstr "Zatkałem je wieki temu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "When it's less claustrophobic, perhaps."
msgstr "Może gdy zrobi się trochę mniej klaustrofobicznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "That was not a good idea!"
msgstr "To nie był dobry pomysł!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Off to plunder the depths."
msgstr "Ku baśniowym bogactwom otchłani!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Probably shouldn't venture any deeper."
msgstr "Chyba lepiej nie zapuszczać się głębiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'd rather stay here than mingle with the crowds above."
msgstr "Wolę chyba poczekać, aż tłum na górze nieco się przerzedzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Get me out of here!"
msgstr "Zabierzcie mnie stąd!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Onward to the next thing."
msgstr "Ku nowym przygodom."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN"
msgid "I'd like to step on it."
msgstr "Chciałbym ją rozdeptać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE"
msgid "A delightful, cultured dish."
msgstr "Wyborny, kulturalny posiłek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL"
msgid "Nothing will steal my carbon!"
msgstr "Nie pozwolę ukraść mojego węgla!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1"
msgid "There's a reason I never finished that."
msgstr "Nie bez powodu nigdy ich nie dokończyłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2"
msgid "That one was a jerk."
msgstr "Wredny drań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3"
msgid "Didn't like that one's face."
msgstr "Ale paskudna morda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "How kitsch."
msgstr "Ale kicz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Is there a sinkhole I can bury this in?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER"
msgid "A brute."
msgstr "Brutal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Does she really need a statue?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Could use a few more mechanical bits in my opinion."
msgstr "Przydałoby mu się trochę więcej mechanicznych części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Jego elementy zaczęły się poruszać!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Rather elegant, I'd say."
msgstr "Rzekłbym, że nawet eleganckie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I had a mantle to set it on."
msgstr "Gdybym tylko miał gdzie to wyeksponować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It's quite fetching."
msgstr "Chętnie państwu łapę poda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "What a gruesome maw."
msgstr "Ależ straszliwa paszcza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING"
msgid "I am not that crabby!"
msgstr "Wcale nie jestem taki znowuż uszczypliwy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I don't like winters."
msgstr "Nie lubię zimy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "It never stood a chance."
msgstr "Nie miał najmniejszych szans."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "What a well-dressed figure!"
msgstr "Doskonale ubrana figura!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "This seems cruel."
msgstr "To chyba lekka przesada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Why bother?"
msgstr "Po co się trudzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A dreadful lack of accordions."
msgstr "A gdzie akordeon?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "And I thought chivalry was dead!"
msgstr "A myślałem, że rycerstwo to przeżytek!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Such a fowl-tempered bird."
msgstr "Ależ paskudny charakter ma ten ptak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON"
msgid "I'm fairly partial to this one."
msgstr "Mam do tego lekką słabość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "What an imbecilic expression."
msgstr "Cóż za debilny fizys."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE"
msgid "Must everything be about my shortcomings?"
msgstr "Czy wszystko musi się odnosić do moich niedociągnięć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN"
msgid "I have no idea what that is."
msgstr "Nie mam pojęcia, co to jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE"
msgid "Ceci n'est pas une pipe. Pity."
msgstr "Ceci n'est pas une pipe. A szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's nice, but where's the rust? The exhaust pipes?"
msgstr "Fajnie, ale gdzie rdza? Gdzie wydech?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Jego elementy zaczęły się poruszać!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER"
msgid "I do like this one."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least the statue doesn't smell as bad as the original."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER"
msgid "Annoying little monster. Has his uses, though."
msgstr "Mały, denerwujący przybłęda. Jest jednak całkiem użyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Stop looking at me!"
msgstr "Nie gap się tak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "What is it waiting for?"
msgstr "Na co ona czeka?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM"
msgid "Say, that chum doesn't look so good."
msgstr "Nie wygląda najlepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I was wise to be suspicious."
msgstr "Warto było być podejrzliwym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE"
msgid "I don't trust it."
msgstr "Nie ufam mu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC"
msgid "This earthen beast's all fired up."
msgstr "Strasznie się zapala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE"
msgid "How delightfully disconcerting."
msgstr "Olśniewająco niepokojące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Zaraz będzie po ptokach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC"
msgid "How comforting."
msgstr "Bardzo przyjemne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Charlie przez jakiś czas się nie pokaże."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW"
msgid "It needs fuel."
msgstr "Potrzeba paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL"
msgid "Cold and fiery."
msgstr "Płomienny, ale zimny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT"
msgid "That's not coming back."
msgstr "Skończyło się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Someone should attend to that."
msgstr "Ktoś powinien się tym zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Palenisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A roaring, cold fire."
msgstr "Szalejący, zimny ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Zaczyna przygasać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's cold."
msgstr "Zimne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT"
msgid "It's gone warm."
msgstr "Zrobiło się ciepłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC"
msgid "I've lost my way."
msgstr "Zgubiłem drogę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Północ"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Północny wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Północny zachód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Południe"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Południowy wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Południowy zachód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Zachód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP"
msgid "I'm utterly dung with all of this."
msgstr "Mam już tego po dziurki w nosie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I suppose I should build this."
msgstr "Chyba muszę to zbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE"
msgid "It has lost a lot of its power."
msgstr "Straciła wiele ze swej mocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT"
msgid "It smells less like barnyard, now."
msgstr "Trochę mniej śmierdzi oborą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still filthy."
msgstr "Nadal jest brudne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT"
msgid "Well, at least it's not moving anymore."
msgstr "Cóż, przynajmniej już się nie rusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER"
msgid "Stay back, you!"
msgstr "Trzymaj się z dala!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT"
msgid "This doesn't look dapper at all."
msgstr "Nie wygląda to szykownie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL"
msgid "Hmph. I suppose this could be useful."
msgstr "Hmpf. Przypuszczam, że się przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Trochę za długo stał na ogniu, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Trzeba zaczekać..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "Już niedługo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Nareszcie, jakieś porządne jadło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY"
msgid "Just the thought makes my mouth water."
msgstr "Na samą myśl cieknie mi ślinka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL"
msgid "Tale of tails."
msgstr "Ogon straszliwego zwierza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN"
msgid "High in fructose."
msgstr "Bogata w fruktozę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC"
msgid "Say, pal, why don't we try to work this out?"
msgstr "Może uda nam się to jakoś załatwić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT"
msgid "I suppose we can't just leave well enough alone, can we?"
msgstr "Nie możemy tego po prostu zostawić w spokoju?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW"
msgid "Best to avoid that."
msgstr "Lepiej tego unikać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB"
msgid "Am I being watched by that rock?"
msgstr "Czy ten kamień mnie obserwuje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING"
msgid "Just like old times."
msgstr "Jak za dawnych czasów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING"
msgid "You are much too trusting, friend."
msgstr "Jesteś zadecydowanie zbyt ufny, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN"
msgid "A wholly agreeable animal."
msgstr "Bardzo przyjemny zwierzak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB"
msgid "Quit nibbling my coattails."
msgstr "Przestań obgryzać mi płaszcz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "You had better not chew holes in my suit."
msgstr "Lepiej, żebyś mi nie wygryzła dziur w garniturze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING"
msgid "You're as fowl as I am!"
msgstr "Jesteś całkiem przyjemny jak na drób!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY"
msgid "You're a slobbery little chap, aren't you?"
msgstr "Jesteś małym śliniaczem, prawda?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC"
msgid "I don't know how they got here."
msgstr "Nie wiem, jak się tu dostały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD"
msgid "Shhhh... My pretty."
msgstr "Cichaj... Mój śliczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS"
msgid "It's falling apart."
msgstr "Rozpada się na kawałki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS"
msgid "The mundane stuff of the earth."
msgstr "Przyziemne sprawy przyrody."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN"
msgid "Dry, crumbly, sustaining."
msgstr "Suchy, łamliwy, ale krzepiący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS"
msgid "I think I could build something useful from this."
msgstr "Chyba mógłbym zrobić z tego coś przydatnego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE"
msgid "The building blocks of civilization."
msgstr "To na nich zbudowano cywilizację."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST"
msgid "It smells... noxious."
msgstr "Pachnie... niebezpiecznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES"
msgid "Adapt or perish."
msgstr "Przystosuj się lub giń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Bathed in fire."
msgstr "Skąpane w ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "That's not about to grow back."
msgstr "Raczej nie odrośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "An acquaintance of mine describes them as \"leafy\"."
msgstr "Pewien mój znajomy zwykłe nazywać je jako „liściakami”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Shut your maw!"
msgstr "Zamknij paszczę!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER"
msgid "What a staggering sight!"
msgstr "Cóż za imponujący widok!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC"
msgid "Well it's certainly not deer to me."
msgstr "Ale z ciebie jeleń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS"
msgid "Even I'm afraid of that guy."
msgstr "Nawet ja boję się tego typa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Deerclops are so myopic."
msgstr "Jeleklopy są strasznie krótkowzroczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED"
msgid "The gem imbues its attacks with a fearsome power."
msgstr "Klejnot przepełnia jego ataki straszliwą siłą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "That's not doing anyone any good."
msgstr "Nic dobrego już z tego nie będzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT"
msgid "Function over form."
msgstr "Funkcjonalność ponad formą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE"
msgid "That looks out-of-place."
msgstr "Tego chyba nie powinno tu być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD"
msgid "Mostly just background noise."
msgstr "Same zakłócenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC"
msgid "I can use this to find my missing parts."
msgstr "Mogę z jej pomocą znaleźć brakujące części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT"
msgid "It must be right under my nose!"
msgstr "Musi być gdzieś blisko!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM"
msgid "This is the right direction."
msgstr "Dobry kierunek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER"
msgid "I should keep my eyes peeled."
msgstr "Muszę mieć oczy szeroko otwarte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It's the starting mechanism."
msgstr "Mechanizm startowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY"
msgid "I need to insert the divining rod."
msgstr "Muszę włożyć tu różdżkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Progress!"
msgstr "Mamy postęp!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART"
msgid "The portals lead to the next rod."
msgstr "Portale prowadzą do kolejnej różdżki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT"
msgid "I'm no middleman."
msgstr "Nie lubię stać pośrodku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD"
msgid "I'll permit him to stay so long as he keeps cooking."
msgstr "Pozwolę mu zostać, dopóki będzie gotował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY"
msgid "A fiery fly."
msgstr "Ognista mucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST"
msgid "Those scales sure are nifty."
msgstr "Te łuski są naprawdę szykowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Such a spiffy design!"
msgstr "Doskonałe wzornictwo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "How undignified."
msgstr "Toż to niegodne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The red gems are producing a sweltering heat."
msgstr "Czerwone klejnoty dają mnóstwo ciepła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "With only one gem it is only moderately scorching."
msgstr "Z jednym klejnotem pali się umiarkowanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT"
msgid "Exotic and delicious."
msgstr "Egzotyczny i przepyszny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT"
msgid "Quite formidable looking."
msgstr "Wygląda onieśmielająco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE"
msgid "Simply exquisite."
msgstr "Po prostu wyborne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT"
msgid "The back end of a terrible beast."
msgstr "Tyłek niegdyś straszliwej bestii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES"
msgid "Fiery."
msgstr "Ognista sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oh good. More wood."
msgstr "Znakomicie. Więcej drewna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "It seems to be burning."
msgstr "Zdaje się, że płonie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It's in utter ruin."
msgstr "Zostały po nim tylko resztki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "We've chopped it up already."
msgstr "Już jest porąbane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "It appears to be a piece of drifted wood."
msgstr "Wygląda na kawałek drewna unoszącego się na wodzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK"
msgid "It tastes strangely like berries."
msgstr "Smakuje trochę porzeczkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED"
msgid "Still tastes like berries."
msgstr "Wciąż smakuje porzeczkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I could find a much better place for it."
msgstr "Można by znaleźć mu lepsze miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING"
msgid "I can't believe I'm reduced to this."
msgstr "Nie wierzę, że to robię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH"
msgid "What would be the most devilish place to put it?"
msgstr "Gdzie najlepiej to umieścić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN"
msgid "It's an acquired taste."
msgstr "Do takich rzeczy trzeba przywyknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT"
msgid "They are at least warm."
msgstr "Przynajmniej są ciepłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL"
msgid "It slithers all the way down."
msgstr "Ślisko ślizga się ciałem obślizgłym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED"
msgid "Still rather grotesque."
msgstr "Wciąż zgoła groteskowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT"
msgid "Just another boring plant."
msgstr "Kolejna nudna roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT"
msgid "That was uncalled for."
msgstr "To nie było potrzebne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Puste naczynie czekające na dekorację lub światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Tymczasowy odpoczynek od mroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC"
msgid "Purely decorative."
msgstr "Ma walory czysto dekoracyjne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Teraz kolej Wilsona, żeby zdobyć żarówki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Każdy kwiat, nawet najpiękniejszy, kiedyś więdnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT"
msgid "Bathed in fire."
msgstr "Skąpane w ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED"
msgid "That's not about to grow back."
msgstr "Raczej nie odrośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC"
msgid "An acquaintance of mine describes them as \"piney\"."
msgstr "Pewien mój znajomy zwykłe nazywać je jako „iglakami”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Dust to dust."
msgstr "Z prochu powstałeś i w proch się obrócisz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "I put it out of its misery."
msgstr "Skróciłem jego męki na tym świecie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Nie wygląda zdrowo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT"
msgid "Eye to the sky."
msgstr "Zwróć oko ku niebu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT"
msgid "The Meat Bulb's pawns."
msgstr "Sługa mięśniaka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET"
msgid "Some of my better work."
msgstr "Jedno z moich lepszych dzieł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM"
msgid "Now it just needs to be set up."
msgstr "Teraz trzeba ją tylko rozstawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT"
msgid "A harvest of ashes."
msgstr "Ognisty plon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC"
msgid "Do I look like a farmer?"
msgstr "Wyglądam na rolnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING"
msgid "I have better things to do than watch plants grow."
msgstr "Mam lepsze rzeczy do roboty niż patrzenie, jak rosną rośliny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs to be... refreshed."
msgstr "Trzeba je trochę... odświeżyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN"
msgid "Is it windy out or is it just this fan?"
msgstr "Tak bardzo wieje, czy to tylko przez ten wiatrak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT"
msgid "I always considered myself the peacock of people."
msgstr "Zawsze widziałem się jako pawia pośród mego ludu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL"
msgid "Not as elegant as a quill and inkwell, but it'll do."
msgstr "Nie tak elegancki jak pióro i atrament, ale może być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY"
msgid "Yellow is the color of naivety."
msgstr "Żółty to kolor naiwności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW"
msgid "Black is the color of sleep."
msgstr "Czerń to kolor snu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN"
msgid "Red is the color of fire."
msgstr "Czerwony to kolor ognia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Grey is the color of pain."
msgstr "Szary to kolor cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET"
msgid "Better her than me."
msgstr "Lepiej ona niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE"
msgid "My life is one obstacle after another."
msgstr "Moje życie jest pełne przeszkód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE"
msgid "When one gate closes..."
msgstr "Gdy jedna brama się zamyka..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM"
msgid "A gate for your pocket."
msgstr "Kieszonkowa furtka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM"
msgid "A fence for your pocket."
msgstr "Kieszonkowy płot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER"
msgid "It's not gentlemanly to carry manure in one's hands."
msgstr "Noszenie w rękach łajna nie przystoi dżentelmenom."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH"
msgid "I don't know what's so festive about it."
msgstr "Nie rozumiem, co w niej takiego świątecznego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF"
msgid "A staff after my own heart!"
msgstr "To to ja rozumiem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS"
msgid "Great for magic tricks."
msgstr "Doskonałe do magicznych sztuczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC"
msgid "How pretty."
msgstr "Przepiękne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD"
msgid "I could squish them if I wanted to."
msgstr "Mógłbym je rozgnieść, gdybym tylko chciał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND"
msgid "I put fire gems in there as a joke."
msgstr "Dodałem do nich ogniste klejnoty, tak dla żartu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS"
msgid "I should attend to that."
msgstr "Powinienem się nim zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Palenisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH"
msgid "A roaring fire."
msgstr "Szalejący ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Zaczyna przygasać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL"
msgid "It's hot."
msgstr "Gorące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT"
msgid "It's gone cold."
msgstr "Zgasło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF"
msgid "A basic enchantment, but effective."
msgstr "Podstawowe zaklęcie, ale bardzo skuteczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Not much fuel left."
msgstr "Zostało mało paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet before the storm."
msgstr "Cisza przed burzą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Begone, fire!"
msgstr "Przepadnij, ogniu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH"
msgid "Fresh from the murky depths."
msgstr "Prosto z mokrych otchłani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET"
msgid "Not my preferred way to ensnare enemies."
msgstr "Nie jest to mój ulubiony sposób chwytania wrogów w sidła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD"
msgid "I will eat for a lifetime."
msgstr "Najem się po wsze czasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT"
msgid "Ugh, it's still twitching."
msgstr "Uch, wciąż się rusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED"
msgid "Bland... but acceptable."
msgstr "Mdłe... ale do zaakceptowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL"
msgid "I'm reduced to scavenging scraps."
msgstr "Zostalem zmuszony do grzebania w resztkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "That was barely an appetizer."
msgstr "To była ledwie przystawka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS"
msgid "These should tide me over."
msgstr "Niewyrafinowane, ale bardzo przyzwoite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS"
msgid "Cooked fish in a crunchy shell."
msgstr "Smaczna rybka w chrupiącym kocyku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX"
msgid "Ugh, the smell... the things I do for a decent meal."
msgstr "Uch, ten smród... Czego się jednak nie robi dla porządnego posiłku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED"
msgid "It still stinks."
msgstr "Wciąż śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT"
msgid "Ow! I cut my finger!"
msgstr "Auć! Zaciąłem się w palec!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC"
msgid "I am filled with the irrational urge to stomp upon it."
msgstr "Czuję niewytłumaczalną potrzebę zadeptania go na śmierć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE"
msgid "This is wrong."
msgstr "To nie w porządku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT"
msgid "Definitely not my style."
msgstr "Zdecydowanie nie moje klimaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD"
msgid "Leafy goodness."
msgstr "Liściaste błogosławieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE"
msgid "It's so dark down here."
msgstr "Ależ tu ciemno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL"
msgid "I like that flower."
msgstr "Podoba mi się ten kwiat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED"
msgid "It got what it deserved."
msgstr "Zasłużył sobie na to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE"
msgid "A meal fit for a peasant."
msgstr "Posiłek dla prostaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT"
msgid "Ready for the scrimmage."
msgstr "Gotów do szarpaniny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE"
msgid "Perhaps it is best left in pieces."
msgstr "Może lepiej zostawić w kawałkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Was it wise to unleash this upon the world?"
msgstr "Rozsądnym było wypuszczenie go na świat?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "It will be the laughingstock of the demon community."
msgstr "Będzie pośmiewiskiem w demoniej społeczności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "The beginnings of some demonic beast."
msgstr "Początek jakiejś demonicznej bestii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES"
msgid "Deserves to be eaten with fine silverware. Sadly, I've just my hands."
msgstr "Zasługują na to, żeby zjeść je sztućcami. Niestety mam tylko ręce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Już jej nie do śmiechu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC"
msgid "It jumps and licks things."
msgstr "Skacze i liże wszystko dokoła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING"
msgid "It looks tired."
msgstr "Wygląda na zmęczoną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL"
msgid "At the end of the day, it's still frog."
msgstr "Ostatecznie żaba pozostała żabą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH"
msgid "Has a bit of a kick to it."
msgstr "Potrafi dać niezłego kopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS"
msgid "Muscular."
msgstr "Nieźle umięśnione."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED"
msgid "Stringy."
msgstr "Trochę żylaste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They aren't very sociable."
msgstr "Nie są zbyt towarzyskie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I bet it's delicious."
msgstr "Założę się, że jest przepyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Sen to tylko chwilowa ucieczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
msgid "This would be great with a simple cheese plate."
msgstr "Świetnie pasowałyby do deski serów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT"
msgid "Not quite enough for a rug."
msgstr "Na chodnik nie starczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND"
msgid "Try and get me now. Ha!"
msgstr "Spróbuj mnie teraz dorwać. Ha!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Not so tough."
msgstr "Jednak nie taki z ciebie twardziel!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Zakładam, że to dlatego nie ma tu żadnych wampirów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Ciekawe, czy nadal ma moc odpędzania umarłych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO"
msgid "It smells much nicer going in than coming back out."
msgstr "Pachnie lepiej, jak wchodzi do układu pokarmowego, niż jak go opuszcza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS"
msgid "My pets! What has become of you?"
msgstr "Moi drodzy! Cóż się z wami stało?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS"
msgid "The fuel needs a focus."
msgstr "Paliwo potrzebuje skupienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID"
msgid "This one's ready."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT"
msgid "It communes with us through them."
msgstr "Porozumiewa się z nami przez nie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST"
msgid "It remembers me!"
msgstr "Pamięta mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER"
msgid "I hope they found peace."
msgstr "Mam nadzieję, że spoczywa w pokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFT"
msgid "An elegantly wrapped social obligation."
msgstr "Elegancko opakowane zobowiązanie społeczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GIFTWRAP"
msgid "For wrapping odds and ends..."
msgstr "Do pakowania różnych takich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADHOUSE"
msgid "Entirely too gaudy."
msgstr "Zupełnie bez gustu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADPIG"
msgid "Must you make me chase you?"
msgstr "Muszę cię ganiać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GINGERBREADWARG"
msgid "Pretty brash for something so edible."
msgstr "To dość bezczelne zachowanie jak na coś tak jadalnego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSBLOCK"
msgid "Not the castle I had in mind for myself."
msgstr "Nie o takiej fortecy myślałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSCUTTER"
msgid "Sharp like my wit."
msgstr "Ostre niczym mój dowcip."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLASSSPIKE"
msgid "I hope I'm not so transparent."
msgstr "Mam nadzieję, że ja nie jestem aż tak transparentny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER.GENERIC"
msgid "A flying goop factory."
msgstr "Latająca fabryka śluzu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMER.SLEEPING"
msgid "It's drooling in its sleep."
msgstr "Ślini się we śnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Flower power forever."
msgstr "Flower power na wieki wieków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "Flower power."
msgstr "Flower power."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERFUEL"
msgid "Well, that's rank."
msgstr "Ale śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOMMERWINGS"
msgid "They're sticky."
msgstr "Trochę się kleją."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GLOWBERRYMOUSSE"
msgid "What a nice change it is to know someone who cooks."
msgstr "Miła odmiana poznać wreszcie kogoś, kto potrafi gotować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "It seems you've lost something, pal."
msgstr "Chyba coś zgubiłeś, kolego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "Shame about your horn, pal."
msgstr "Szkoda, że tak wyszło z twoim rogiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "We've come to an agreement."
msgstr "Doszliśmy do porozumienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL.GENERIC"
msgid "Perhaps it could be reasoned with."
msgstr "Może da mu się przemówić do rozsądku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GNARWAIL_HORN"
msgid "Impressive."
msgstr "Imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOATMILK"
msgid "It's charged with nutrients."
msgstr "Pełne składników odżywczych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOGGLESHAT"
msgid "Not my sort of fashion."
msgstr "To nie mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENAXE"
msgid "It gets sharper with every cut."
msgstr "Z każdym ciosem robi się ostrzejsza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPICKAXE"
msgid "This must be game logic."
msgstr "To jakaś logika z gier."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENPITCHFORK"
msgid "I'm not sure this was a good investment."
msgstr "Nie jestem pewien, czy to dobra inwestycja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDENSHOVEL"
msgid "This shovel is worth a princely sum."
msgstr "Ta łopata warta jest ładną sumkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOLDNUGGET"
msgid "This was important to me once."
msgstr "Kiedyś było to dla kogoś bardzo cenne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GOOSE_FEATHER"
msgid "I could use a pillow filled with these."
msgstr "Przydałaby mi się poduszka z takimi piórami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BARREN"
msgid "Needs manure."
msgstr "Potrzeba obornika."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.GENERIC"
msgid "Tufty."
msgstr "Trawka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.PICKED"
msgid "Nothing to harvest."
msgstr "Nie ma czego zbierać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS.WITHERED"
msgid "You'd think grass could withstand this heat..."
msgstr "Spodziewałbym się, że trawa przetrwa takie temperatury..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It's sickly and frail."
msgstr "Słabowity i mizerny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "I'm sure its tail grows back."
msgstr "Ciekawe, czy odrasta mu ogon..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRASS_UMBRELLA"
msgid "It's more \"pretty\" than \"dapper\"."
msgstr "Raczej ładna niż wytworna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GRAVY"
msgid "I have a tendency to overdo it on the gravy."
msgstr "Mam tendencję do przesadzania z sosem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENAMULET"
msgid "A crutch for pitiful mortals without godlike powers. What?"
msgstr "Podpora dla żałosnych śmiertelników bez mocy godnych bogów. Co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENGEM"
msgid "Only the nightmare fuel will unlock its true potential."
msgstr "Jedynie koszmarne paliwo może uwolnić jego prawdziwy potencjał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENMOONEYE"
msgid "It's useful for keeping in contact with my... acquaintances."
msgstr "Pomoże mi utrzymać kontakt z moimi... znajomymi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREENSTAFF"
msgid "It is a focusing tool."
msgstr "Narzędzie skupiające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP"
msgid "I should eat it."
msgstr "Powinienem go zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_CAP_COOKED"
msgid "Salty!"
msgstr "Słony!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Green fungus."
msgstr "Zielony grzyb."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "When do those ones come up?"
msgstr "Kiedy one wyłażą?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Been there. Done that."
msgstr "Załatwiony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUACAMOLE"
msgid "There's a mole in the mix."
msgstr "Co za kretyn to wymyślił."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUANO"
msgid "Disgusting!"
msgstr "Obrzydliwe!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GUNPOWDER"
msgid "Now THIS I like."
msgstr "TO mi się podoba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_1"
msgid "Oh good, it's solid candy. I feared something healthy had snuck in."
msgstr "Och, porządny cukierek. Już się bałem, że wkradło się tu coś zdrowego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_10"
msgid "No one is above enjoying a good lollipop."
msgstr "Wszyscy lubią lizaki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_11"
msgid "Eating them makes me feel powerful."
msgstr "Dzięki nim rosnę w siłę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_12"
msgid "Ah, maggots... how novel."
msgstr "Ach, robactwo... Jakże zaskakujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_13"
msgid "It's not terrible."
msgstr "To nie takie straszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_14"
msgid "Only ruffians enjoy torturing themselves like this."
msgstr "Li tylko awanturnicy zwykli torturować się w ten sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_2"
msgid "Waxy, just like me."
msgstr "No to hop."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_3"
msgid "Who is making all this candy, exactly?"
msgstr "Kto robi te wszystkie słodycze?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_4"
msgid "Black licorice, my favorite."
msgstr "Lukrecja. Moja ulubiona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_5"
msgid "Almost endearing. Almost."
msgstr "Prawie uroczy. Prawie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_6"
msgid "A mystery I'm not keen on solving."
msgstr "Tajemnica, której nie mam ochoty odkrywać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_7"
msgid "I am much more disappointed than I thought I'd be."
msgstr "Jestem dużo bardziej rozczarowany, niż się spodziewałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_8"
msgid "No one is above enjoying a good lollipop."
msgstr "Wszyscy lubią lizaki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENCANDY_9"
msgid "How the tables have turned, worm."
msgstr "Popatrz, jak los może się odwrócić, robaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Takes away the horrors. But who would want that?"
msgstr "Odgania koszmary. Ale kto by chciał coś takiego?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Ah. This'll do the trick."
msgstr "Ach, to powinno pomóc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Could be a little stronger."
msgstr "Przydałoby się coś mocniejszego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Might as well throw it in the fire."
msgstr "Można równie dobrze cisnąć nimi w ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "A fine pot of tea, with a side of mutation."
msgstr "Aromatyczna herbata z lekką nutą mutacji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Oh joy. Is there really need for decoration?"
msgstr "Och, radości. Czy naprawdę musimy uciekać się do dekoracji?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Such a burden to carry it. If only there were a place to leave it."
msgstr "Jakaż to szkoda, aby nosić taką ozdobę ze sobą. Gdybym tylko mógł gdzieś ją zostawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "I like the real ones better."
msgstr "Wolę prawdziwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Shouldn't it be hanging from somewhere."
msgstr "Nie powinnaś gdzieś wisieć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Ugh. These guys again."
msgstr "No nie. Znowu oni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Why do I hear \"Nevermore\"?"
msgstr "Czemu słyszę „Kres i krach”?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMBAT"
msgid "An undignified weapon for a less refined time."
msgstr "Nieelegancka broń na mniej cywilizowane czasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER"
msgid "It feels good to undo the work of others."
msgstr "Niweczenie pracy innych daje całkiem sporo satysfakcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAMMER_MJOLNIR"
msgid "I would never resort to something so brutish."
msgstr "Nigdy nie odważyłbym się na taką toporność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HAWAIIANSHIRT"
msgid "The dapperest of them all."
msgstr "Najwytworniejsza ze wszystkich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSALVE"
msgid "Just a bit of venom and some dirty old ash."
msgstr "Trochę jadu i starego popiołu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEALINGSTAFF"
msgid "I could be persuaded to dabble in white magicks."
msgstr "W sumie nie mam tak wiele przeciwko białej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.COLD"
msgid "Pleasantly cool."
msgstr "Przyjemnie chłodny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.FROZEN"
msgid "It's almost too cold to hold."
msgstr "Jest tak zimny, że ledwo mogę go utrzymać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.GENERIC"
msgid "A pocketful of stone and temperature."
msgstr "Kieszonkowa grzałka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.HOT"
msgid "It's almost too hot to hold."
msgstr "Jest tak gorący, że ledwo mogę go utrzymać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HEATROCK.WARM"
msgid "Comfortably lukewarm."
msgstr "Przyjemnie ciepły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITCRAB"
msgid "I have better things to do than being berated by an old crab."
msgstr "Mam lepsze rzeczy do roboty niż bycie strofowanym przez kraba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "It's an improvement."
msgstr "Jest to jakiś postęp."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "What a sad little hovel."
msgstr "Co za nędzna rudera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "Ah. I thought I'd run out of people to disappoint."
msgstr "Ach. Myślałem, że już nie mam kogo zawieść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HERMIT_PEARL"
msgid "It's... strange to be so trusted."
msgstr "To... dziwne uczucie, że ktoś darzy mnie zaufaniem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HIVEHAT"
msgid "Makes one feel like royalty."
msgstr "Czuję się normalnie jak król."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOME"
msgid "There's no place like it."
msgstr "Wszędzie dobrze, ale tam najlepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.GENERIC"
msgid "\"You are here\"... I wish I wasn't!"
msgstr "„Jesteś tutaj”... No więc wolałbym tu nie być!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEY"
msgid "Sticky and sweet."
msgstr "Słodki i klejący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYCOMB"
msgid "It's full of bee maggots."
msgstr "Pełny pszczelich larw."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYHAM"
msgid "Tender."
msgstr "Kruchutka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HONEYNUGGETS"
msgid "These look childish, but they're delicious."
msgstr "Wyglądają dziecinnie, ale są przepyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HORN"
msgid "Call forth the beasts!"
msgstr "Wezwijcie bestie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTCHILI"
msgid "Hot as heck!"
msgstr "Gorąco jak w garnku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.BOMBED"
msgid "How posh."
msgstr "Trochę pretensjonalne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.EMPTY"
msgid "It's of no use to me like this."
msgstr "W tym stanie na nic mi się nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.GENERIC"
msgid "I miss a good long bath."
msgstr "Tęsknię za długą, gorącą kąpielą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOTSPRING.GLASS"
msgid "I could make use of that glass."
msgstr "To szkło może mi się do czegoś przydać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUND"
msgid "They don't recognize me!"
msgstr "Nie rozpoznają mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDBONE"
msgid "Hungry devils, aren't they?"
msgstr "Głodne z nich bestie, co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Good riddance."
msgstr "Do widzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "I wish we'd get rid of that."
msgstr "Wolałbym, żebyśmy się tego pozbyli."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "It's coming alive again!"
msgstr "Wraca do życia!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDMOUND"
msgid "It's a tunnel down to the hounds' nest."
msgstr "Tunel prowadzący do nory ogarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDSTOOTH"
msgid "It could be used for fashion."
msgstr "Można by go wykorzystać z modzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HOUNDWHISTLE"
msgid "Howl I ever find a use for this?"
msgstr "Na co mogłoby mi się to kiedykolwiek przydać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH"
msgid "Stick your tongue in. You're getting slobber on my pantlegs."
msgstr "Schowaj język. Chlapiesz mi na nogawki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Better him in that bowl than me."
msgstr "Lepiej on niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "His spirit is free now."
msgstr "Jego dusza jest wreszcie wolna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICE"
msgid "Baby glaciers."
msgstr "Małe lodowce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG.GENERIC"
msgid "Ice, ice, maybe."
msgstr "Przybysz z Krainy Lodu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG.MELTED"
msgid "It's melted."
msgstr "Roztopiła się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBERG_MELTED"
msgid "It's melted."
msgstr "Roztopiła się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEBOX"
msgid "A little piece of winter in a box."
msgstr "Kawałek zimy w pudełku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICECREAM"
msgid "Sundae, sundae, sundae!"
msgstr "Na poprawę humoru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHAT"
msgid "Strap some ice on your head."
msgstr "Przytwierdź sobie lód do głowy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEHOUND"
msgid "I had a lot of surplus gems!"
msgstr "Miałem sporą nadwyżkę klejnotów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICEPACK"
msgid "Its contents are hibernating."
msgstr "Komora hibernacyjna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ICESTAFF"
msgid "Cool staff."
msgstr "Wieje chłodem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "I can see its true nature now!"
msgstr "Teraz dostrzegam jego prawdziwą naturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It only half-exists on this plane."
msgstr "Tak naprawdę w tej płaszczyźnie istnieje tylko w połowie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.INSPECTSELF"
msgid "I still look dapper, right? As if I need to check."
msgstr "Wciąż wyglądam wytwornie, prawda? Jakbym się w ogóle musiał upewniać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JAMMYPRESERVES"
msgid "It's soiled my good gloves."
msgstr "Pobrudziłem najlepsze rękawiczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.JELLYBEAN"
msgid "I think there's seventeen in there."
msgstr "Jest ich chyba z siedemnaście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KABOBS"
msgid "Cooked to perfection."
msgstr "Przyrządzony wręcz idealnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP"
msgid "Can I eat something that's not slimy for once?"
msgstr "Czy mógłbym chociaż raz zjeść coś, co nie będzie oślizgłe?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELPHAT"
msgid "You really expect me to wear this?"
msgstr "Naprawdę sądzisz, że to założę?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP_COOKED"
msgid "This was not an improvement."
msgstr "Nie pomogło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KELP_DRIED"
msgid "Sadly, I've eaten worse out here."
msgstr "Niestety jadałem gorsze..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.GENERIC"
msgid "What is that bee so angry about?"
msgstr "O co ten szerszeń się tak wścieka?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KILLERBEE.HELD"
msgid "I've caught a tiger by the tail."
msgstr "Złapałem tygrysa za ogon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS"
msgid "My, what a magnificently horrific creature."
msgstr "Ależ cudownie straszliwe stworzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUSSACKKEY"
msgid "Magic has done things to this beast's horn."
msgstr "W porożu tego stworzenia widać wyraźne ślady działania magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KLAUS_SACK"
msgid "What dark treasures lie within?"
msgstr "Ciekawe, jakież mroczne skarby czekają w środku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT"
msgid "Such quality workmanship!"
msgstr "Fachowa robota!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks beyond repair."
msgstr "Tego nie da się już naprawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_SUMMER"
msgid "A distant cousin of the beefalo."
msgstr "Daleki kuzyn wołka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KOALEFANT_WINTER"
msgid "It has its winter coat on."
msgstr "Ma na sobie zimowe wdzianko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS"
msgid "You won't catch me!"
msgstr "Nie złapiesz mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.KRAMPUS_SACK"
msgid "It's really light."
msgstr "Jest naprawdę lekki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LANTERN"
msgid "I hope it keeps Them away."
msgstr "Mam nadzieję, że to Ich powstrzyma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LATKES"
msgid "They're acceptable."
msgstr "Ujdzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Quite a clunky looking thing."
msgstr "Jakieś to takie nieporęczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Seems heavy."
msgstr "Ciężka rzecz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "It is nearly useless."
msgstr "W zasadzie bezużyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Swiftly useless."
msgstr "Błyskawicznie bezużyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It offers a serviceable amount of protection."
msgstr "Oferuje ochronę na znośnym poziomie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "This was intended for someone physically-inclined."
msgstr "Okrycie zaprojektowane z myślą o kimś o dużej sile."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Decent protection that will enhance my power."
msgstr "Znośna ochrona, która wzmacnia moją moc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "A little extra armor never hurt."
msgstr "Nieco pancerza jeszcze nikomu nie zaszkodziło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "We must destroy that Battle Standard."
msgstr "Musimy zniszczyć tę chorągiew."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BERNIE"
msgid "That thing's still shambling about, I see."
msgstr "Widzę, że to coś wciąż miota się w tę i nazad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_BOARLORD"
msgid "You seem severely deluded, good sir."
msgstr "Zdaje się, że nie masz wszystkich w domu, dobry człowieku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "You'd need a thick neck to wear such a thing."
msgstr "Noszenie tego dodatku wymagałoby naprawdę grubej szyi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "You shall serve us."
msgstr "Będziesz nam służyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I must have it."
msgstr "Muszę to zdobyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Horsefeathers."
msgstr "Końskie pióra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Not really my style."
msgstr "To nie do końca mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "I could use the invigoration."
msgstr "Przydałoby mi się nieco energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Self sufficiency in wreath form."
msgstr "Samowystarczalność w formie wieńca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "Too brutish for my tastes."
msgstr "Zbyt brutalne narzędzie jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "A key is key."
msgstr "Klucz to klucz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Right as rain."
msgstr "Co ma nie pasować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "That is not suited to me."
msgstr "To nie dla mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_LUCY"
msgid "I have no desire to use that."
msgstr "Nie mam najmniejszej ochoty brać w tym udziału."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Meddling with it will only cause further trouble."
msgstr "Dalsze kombinacje mogą wyłącznie pogorszyć sprawę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Let us end this chapter of our journey."
msgstr "Zakończmy więc ten rozdział naszej podróży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "It will quickly restore my powers."
msgstr "Szybko odzyskam w nim siły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_SPAWNER"
msgid "It's a one-way portal."
msgstr "To portal w jedną stronę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'd never wear such an undapper thing."
msgstr "W życiu nie włożyłbym czegoś równie nieeleganckiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "A decent wreath, should I feel like healing."
msgstr "Niezgorszy wieniec, gdybym potrzebował leczenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE"
msgid "Foul beast! Know your place!"
msgstr "Podła bestia! Znaj swoje miejsc!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_COCOON"
msgid "It's no threat in this state."
msgstr "W takiej formie nie stanowi zagrożenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "It's alive in there."
msgstr "W środku jest coś żywego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "I knew I would make a terrible pa-pa."
msgstr "Wiedziałem, że byłby ze mnie fatalny opiekun."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "I can say with pride that it is comfy and cozy."
msgstr "Mogę z dumą stwierdzić, iż jest mu wygodnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It's happy with me, and I with it."
msgstr "On lubi mnie, a ja lubię jego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.GENERIC"
msgid "You're not a hellbeast, are you? Nooo. Just misunderstood!"
msgstr "Wcale nie jesteś bestią z piekła rodem, prawda? Nieee. Nikt cię po prostu nie rozumie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "It's hungry. Why is it hungry?"
msgstr "Jest głodny. Dlaczego jest głodny?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_PET.STARVING"
msgid "I think it's going to die!"
msgstr "Chyba zaraz sczeźnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVAE_TOOTH"
msgid "The lavae's baby tooth."
msgstr "Ząb małego lawowca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.COOL"
msgid "It's cold and dry now."
msgstr "Zimna i sucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVASPIT.HOT"
msgid "Spitfire."
msgstr "Ogień z pyska."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND"
msgid "A touch hot, but it could cook my food in a pinch."
msgstr "Kapkę gorąca, ale w mig ugotuję na niej jedzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LAVA_POND_ROCK"
msgid "With each day I get a little boulder."
msgstr "Każdego dnia stajemy się twardsi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFLOAF"
msgid "Exceptionally mediocre."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFYMEATBURGER"
msgid "How pedestrian."
msgstr "Cóż za brak fantazji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "I appreciate the attempt at presentation."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF"
msgid "Disgusting creature!"
msgstr "Odrażające stworzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LEIF_SPARSE"
msgid "Disgusting creature!"
msgstr "Odrażające stworzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LICHEN"
msgid "This fungus survived the downfall."
msgstr "Ten grzyb przetrwałby nawet kataklizm."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIFEINJECTOR"
msgid "Who would put this filth in their veins?"
msgstr "Któż chciałby wtłoczyć to ścierwo w swe żyły?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTBULB"
msgid "It will run out eventually."
msgstr "W końcu się wypali."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTER"
msgid "It does the job, I suppose."
msgstr "Działa adekwatnie do rozmiaru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Chaaarge!"
msgstr "Ataaaak!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "What's it always chewing on?"
msgstr "Co on tak ciągle przeżuwa?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It'd make a nice horn."
msgstr "Można by na nim zagrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Energy flows through it."
msgstr "Przepływa przez nią strumień energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "A little bit of protection."
msgstr "Odrobina ochrony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LITTLE_WALRUS"
msgid "A chip off the old block."
msgstr "Pomiot szatańskiego stworzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGLOG"
msgid "I like the noise they make when you burn them."
msgstr "Lubię dźwięki, które wydają, jak się palą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE"
msgid "It's got a face."
msgstr "To drzewo ma twarz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_ROOT"
msgid "Ah. A chance to grow something horrible."
msgstr "Ach. Szansa na wyhodowanie czegoś okropnego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Just days away from dreadful."
msgstr "Ledwie dni dzielą cię od pełnej okropności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERBISQUE"
msgid "Ah, I do enjoy the finer things."
msgstr "Ach, jednak prawdziwą przyjemność dają mi rzeczy wyrafinowane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOBSTERDINNER"
msgid "Finally, something to suit my refined palate."
msgstr "Wreszcie coś dla mojego wysublimowanego podniebienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.BURNING"
msgid "Well. That was fun while it lasted."
msgstr "Cóż. Było fajnie, ale się skończyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOG.GENERIC"
msgid "It's a piece of wood. What more is there to say?"
msgstr "Kawałek drewna. Co tu więcej gadać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_1"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_10"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_11"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_14"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_18"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_19"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_2"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_42"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_43"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LOST_TOY_7"
msgid "I'd better leave that be."
msgstr "Lepiej zostawię to w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Gold's gold as far as I'm concerned."
msgstr "Złoto jak złoto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUCY"
msgid "Ah. How have you been, Lucy?"
msgstr "Ach. Gdzie też się podziewałaś, Lucy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUMPY_SAPLING"
msgid "Where did this appear from?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANT"
msgid "A vicious plant."
msgstr "Złośliwa roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I can use this to my advantage."
msgstr "Chyba mógłbym ją jakoś wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.LUTEFISK"
msgid "It has an odd, yet strangely mouthwatering aroma."
msgstr "Ma dziwny, lecz apetyczny aromat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MADSCIENCE_LAB"
msgid "How maddening."
msgstr "Oszaleć można."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS"
msgid "I've no desire to do battle with that thing."
msgstr "Nie mam ochoty walczyć z tym czymś."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_BEAK"
msgid "Ugh, I don't want to touch that."
msgstr "Uch, nie chcę tego nawet dotykać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_FEATHER"
msgid "This would be a nice feather in my cap."
msgstr "To piórko pasowałoby mi do kapelusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "Hopefully it catches the wind as well as the eye."
msgstr "Mam nadzieję, że chwyta wiatr równie mocno, co za serce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MALE_PUPPET"
msgid "Better him than me."
msgstr "Lepiej on niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE"
msgid "My ears are still ringing."
msgstr "W uszach wciąż mi dzwoni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKESOUP"
msgid "There'll be no more crying out of you."
msgstr "Koniec tego darcia papy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Oh shut UP, will you?"
msgstr "Może się już zamkniesz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_COOKED"
msgid "Looks like I got the last meep."
msgstr "Już się więcej nie odezwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANDRAKE_PLANTED"
msgid "What a disturbing root."
msgstr "Co za wnerwiający korzeń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MANRABBIT_TAIL"
msgid "Silly rabbit."
msgstr "Głupi królik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAPSCROLL"
msgid "There's nothing to be gleaned from this."
msgstr "Nic się z tego nie dowiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLE"
msgid "It's strong stuff."
msgstr "Wytrzymałe to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN"
msgid "Let me guess, it grows a marble stalk?"
msgstr "Niech zgadnę – wyrasta z niej marmurowa łodyga?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "Stone cold growth."
msgstr "Zimna jak głaz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLEPILLAR"
msgid "I've always wondered who built those."
msgstr "Zawsze się zastanawiałem, kto to zbudował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLESHRUB"
msgid "I've found a shrubbery."
msgstr "Dobrze, że nie ma kolców."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARBLETREE"
msgid "How whimsical."
msgstr "Ale dziwne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNING"
msgid "I should ask it questions."
msgstr "Powinienem zadawać mu pytania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.BURNT"
msgid "It is finished."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "It's twisted and prickly, just like me!"
msgstr "Pokręcony i ostry. Zupełnie jak ja!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_BUSH.PICKED"
msgid "That was painful."
msgstr "To bolało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_PLANT"
msgid "What a generic little plant."
msgstr "Zupełnie zwyczajna roślinka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNING"
msgid "There it goes."
msgstr "I po drzewie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.BURNT"
msgid "It's no use to anyone now."
msgstr "Teraz już się nikomu nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Tree 0, Maxwell 1."
msgstr "Drzewo 0, Maxwell 1."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A tree with a foul demeanor."
msgstr "Niegrzeczne drzewo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASHEDPOTATOES"
msgid "I do love mashed potatoes."
msgstr "Uwielbiam purée ziemniaczane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST"
msgid "Every vessel mast have one."
msgstr "Każdy okręt musi go mieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Far more practical than setting a fire on our boat."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Very prudent."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_ITEM"
msgid "Do I look like a shipyard laborer?"
msgstr "Wyglądam na robola ze stoczni?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS"
msgid "A warning to any waterfowl that cross us."
msgstr "Ostrzeżenie dla ptactwa wodnego, żeby z nami nie zadzierało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Must I do everything?"
msgstr "Czy muszę wszystko robić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL"
msgid "Looking good!"
msgstr "Przystojniak!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD"
msgid "Hey, handsome."
msgstr "Hej, przystojniaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT"
msgid "Aw, it remembers me."
msgstr "Ach, pamięta mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK"
msgid "It keeps the master in the chair."
msgstr "Trzyma mistrza na jego miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "That accursed thing!"
msgstr "Przeklęte pudło!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE"
msgid "It's less painful than it looks. Barely."
msgstr "Jest mniej bolesny, niż wygląda. Ale tylko odrobinę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT"
msgid "I'm used to much finer fare."
msgstr "Przywykłem do trochę większych porcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS"
msgid "My compliments to the chef!"
msgstr "Wyrazy uznania dla kucharza!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT"
msgid "It's too brittle to hang meat on now."
msgstr "Trochę za krucha, żeby powiesić na niej mięso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE"
msgid "Like the desert."
msgstr "Lepsze niż deser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Like the desert."
msgstr "Lepsze niż deser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING"
msgid "Still moist."
msgstr "Jeszcze wilgotne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Moist and staying that way."
msgstr "Jest wilgotne i na razie takie zostanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Moist and staying that way."
msgstr "Jest wilgotne i na razie takie zostanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Still moist."
msgstr "Jeszcze wilgotne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC"
msgid "It can dry meats so they'll last longer."
msgstr "Można suszyć tu mięso, dzięki czemu na dłużej pozostanie przydatne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It's too brittle to hang meat on now."
msgstr "Trochę za krucha, żeby powiesić na niej mięso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Does she even have teeth?"
msgstr "Ona ma w ogóle zęby?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Like the desert."
msgstr "Lepsze niż deser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Still moist."
msgstr "Jeszcze wilgotne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "Moist and staying that way."
msgstr "Jest wilgotne i na razie takie zostanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "Moist and staying that way."
msgstr "Jest wilgotne i na razie takie zostanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Still moist."
msgstr "Jeszcze wilgotne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Perhaps if she were fed, she'd be less ill-tempered."
msgstr "Może jak się ją nakarmi, to będzie mniej drażliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATYSALAD"
msgid "This seems suspect."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM"
msgid "They were already here when I arrived."
msgstr "Byli tu, gdy się tu znalazłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMGUARD"
msgid "I'd best try to stay on their good side."
msgstr "Lepiej nie wchodzić im w paradę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHAT"
msgid "This seems rather... fishy."
msgstr "Wygląda trochę... podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.BURNT"
msgid "Roasted merm head. Delicious."
msgstr "Pieczona głowa merma. Pychota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHEAD.GENERIC"
msgid "The eyes follow you around."
msgstr "Ciężko się uwolnić od ich wzroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.BURNT"
msgid "Well, it burns just as well as the pigs' version."
msgstr "Pali się podobnie do chat prosiaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE.GENERIC"
msgid "They copied the pigs, but they're even less intelligent."
msgstr "Starają się naśladować świnie, ale są jeszcze głupsi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "It's been burned to the ground."
msgstr "Wypalony do gołej ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "It's slightly less offensive to my eyes than the others."
msgstr "Trochę mniej razi moje oczy niż pozostałe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMKING"
msgid "A crown can be a heavy burden..."
msgstr "Korona bywa ciężkim brzemieniem..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE.BURNT"
msgid "Someone finally took care of that hideous throw rug."
msgstr "Ktoś wreszcie zajął się tym ohydnym dywanikiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Not especially impressive for a \"throne\"."
msgstr "Niezbyt imponujące, jak na \"tron\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Such a waste of time and energy."
msgstr "Co za strata czasu i energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "What is that little creature up to?"
msgstr "Cóż to stworzonko planuje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "A kingdom without a king."
msgstr "Królestwo bez króla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "They're flying the royal banner."
msgstr "Wywiesili sztandar królewski."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MERM_PRINCE"
msgid "Kings are easily made around here."
msgstr "Łatwo zostać królem w tej okolicy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MESSAGEBOTTLE"
msgid "Someone sensibly bottled up their feelings and tossed them out to sea."
msgstr "Ktoś całkiem sensownie zdusił w sobie emocje, spakował je do butelki i wrzucił do morza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "It's empty inside."
msgstr "Pusta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINERHAT"
msgid "Eventually the firefly will starve."
msgstr "Świetliki kiedyś umrą z głodu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIBOATLANTERN"
msgid "It's oddly beautiful."
msgstr "Zaskakująco piękna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFAN"
msgid "This pathetic device... gets the job done."
msgstr "Żałosne ustrojstwo... Ale może być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINIFLARE"
msgid "For those with a flare for the dramatic."
msgstr "Szał flar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.GENERIC"
msgid "It was drawn in a steady hand."
msgstr "Widać pewną rękę autora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN.UNDRAWN"
msgid "There's nothing on it, currently."
msgstr "Nic tu jeszcze nie ma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINISIGN_ITEM"
msgid "A sign is useless if it has nothing to mark."
msgstr "Znak musi coś zaznaczać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAUR"
msgid "My my, the fuel has changed you."
msgstr "Proszę, proszę, paliwo zupełnie cię odmieniło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURCHEST"
msgid "It's almost like he's still alive."
msgstr "Czuję się, jakby wciąż żył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MINOTAURHORN"
msgid "A regrettable end, my old friend."
msgstr "Smutny koniec, stary przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.ABOVEGROUND"
msgid "I'll take that as a \"yes\"."
msgstr "Rozumiem, że odpowiedź brzmi „tak”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.HELD"
msgid "End of the line."
msgstr "Koniec tego grzebania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLE.UNDERGROUND"
msgid "Are you picking up what I'm putting down? Do you dig it?"
msgstr "Wykopujesz to, co ja zakopię?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHAT"
msgid "No wonder they can dig for hours."
msgstr "Nic dziwnego, że potrafią kopać godzinami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOLEHILL"
msgid "Burrow deep, I'm coming for you."
msgstr "Skryj się głęboko. Idę po ciebie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEY"
msgid "I don't have time for you!"
msgstr "Nie mam czasu na wygłupy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONKEYBARREL"
msgid "What a disgusting home."
msgstr "Ale paskudne mieszkanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERLASAGNA"
msgid "It would be unwise to ingest this."
msgstr "Włożenie tego do ust nie byłoby rozsądne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT"
msgid "How revolting."
msgstr "Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERMEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MONSTERTARTARE"
msgid "It's less than appetizing."
msgstr "Niezbyt zachęcające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.BROKEN"
msgid "Ruins of an ancient relic."
msgstr "Pozostałość po pradawnym relikcie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.GENERIC"
msgid "I had thought these all destroyed eons ago."
msgstr "Myślałem, że wszystkie zostały zniszczone już wieku temu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The staff is powered by the \"moon's\" energy."
msgstr "Kostur czerpiący energię z „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.STAFFED"
msgid "Something magic-y needs to happen, I think."
msgstr "Chyba powinna wydarzyć się coś magicznego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Waste of a good staff."
msgstr "Szkoda dobrego kostura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "How wretchedly graceful."
msgstr "Żałosna, acz pełna gracji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "You can't escape my villainous grasp!"
msgstr "Nie wywiniesz mi się!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "What am I supposed to do with these?"
msgstr "I co mam z tym niby zrobić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It's a small moon tree."
msgstr "Małe księżycowe drzewko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.CAVE"
msgid "The cave provides sanctuary from the \"moon's\" prying eyes."
msgstr "Jaskinia zapewnia schronienie przed wścibskimi oczami „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.GENERIC"
msgid "The gem conjures water springs in conjunction with the \"moon's\" cycles."
msgstr "Klejnot korzysta z energii strumieni i cykli „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "The \"moon\" is full in the sky."
msgstr "„Księżyc” jest dziś w pełni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "The... \"moon\"... has retreated for now."
msgstr "„Księżyc”... na razie się schował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The \"moon\" is on the wane."
msgstr "„Księżyc” się zmniejsza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The \"moon\" is waxing."
msgstr "„Księżyc „się powiększa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS"
msgid "But does it look as sharp as me?"
msgstr "Ale czy jest tak ostry, jak mój dowcip?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASSAXE"
msgid "Go on. Axe me what the moon's made of."
msgstr "W którą stronę się kieruje księżyc?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS_ROCK"
msgid "\"Moon\" detritus."
msgstr "\"Księżycowy\" odpad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "I suppose life finds a way."
msgstr "Życie radzi sobie w każdych warunkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKCRATER"
msgid "This will make a decent magical vessel."
msgstr "Będzie z niego doskonały nośnik magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKIDOL"
msgid "They always need an offering."
msgstr "Zawsze potrzebna jest jakaś ofiara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKNUGGET"
msgid "\"Moon\" rock."
msgstr "Kawałek „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCKSEED"
msgid "Oooh, some new knowledge."
msgstr "Oooch, nowa wiedza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONROCK_PIECES"
msgid "This might be bad."
msgstr "To się może źle skończyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOONSPIDERDEN"
msgid "I'd rather not peek inside."
msgstr "Wolałbym tam nie zaglądać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Yes. I desire the knowledge of the moon."
msgstr "Tak. Pożądam wiedzy księżyca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "There is powerful energy pouring out of it."
msgstr "Wylewa się z niego potężna energia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "It is not yet time?"
msgstr "Jeszcze nie pora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_CROWN"
msgid "This powerful energy... I've seen it before."
msgstr "Ta potężna energia... Gdzieś już ją widziałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_GLASS"
msgid "This is not its desired destination."
msgstr "To nie jest jego ostateczny cel podróży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Let me know your wishes, and I will oblige."
msgstr "Wyraź swe życzenie, a ja je spełnię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "The thing inside wants out."
msgstr "To, co jest w środku, pragnie się wydostać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "The thing inside wants out."
msgstr "To, co jest w środku, pragnie się wydostać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "The thing inside wants out."
msgstr "To, co jest w środku, pragnie się wydostać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_ALTAR_SEED"
msgid "Where shall I take you?"
msgstr "Gdzie mam cię zabrać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "It's not shadow magic."
msgstr "To nie jest magia cienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "I've more important things to deal with than holes in the ground."
msgstr "Mam ważniejsze rzeczy na głowie, niż zajmowanie się dziurami w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "It's almost genius in its simplicity... but it does smell."
msgstr "Genialne w swej prostocie... ale trochę śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.BURNING"
msgid "It's burning."
msgstr "Płonie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.BURNT"
msgid "A burnt tree stump."
msgstr "Spalony pieniek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Someone's chopped it down already."
msgstr "Ktoś już je porąbał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE.GENERIC"
msgid "It's a moon tree."
msgstr "Księżycowe drzewo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "It came from that odd tree."
msgstr "Pochodzi z tego dziwnego drzewa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE"
msgid "It's definitely from the North, whatever that is."
msgstr "Ma północny rodowód, cokolwiek to jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSEEGG"
msgid "Ride the lightning, you big egg."
msgstr "Elektryzujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOQUECA"
msgid "I've never had it before."
msgstr "Nigdy nie jadłem czegoś takiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.GENERIC"
msgid "Bloody bloodsucking bloodsuckers."
msgstr "Przeklęci krwiopijcy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITO.HELD"
msgid "I got him."
msgstr "Mam go!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSQUITOSACK"
msgid "A bloody sack. With blood in it."
msgstr "Krwawy pęcherz. Pełen krwi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOSSLING"
msgid "That's a fluffy... thing."
msgstr "Puchate... coś."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.DUG"
msgid "That one's already been done in."
msgstr "Nic tu się więcej nie da zrobić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MOUND.GENERIC"
msgid "What lies beneath?"
msgstr "Cóż się tam kryje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULLEDDRINK"
msgid "It brings a small respite from this wretched cold."
msgstr "Daje trochę wytchnienia od tego przeklętego ziąbu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Always did have a flair for the dramatic..."
msgstr "Zawsze uwielbiałem dramatyzm..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "A bit ominous looking."
msgstr "Nieco złowieszczo wygląda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "The duality of mine."
msgstr "Ach. Dwoistość rzeczy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMBOMB"
msgid "It's gonna blow!"
msgstr "Zaraz wybuchnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMHAT"
msgid "It possesses a spritely magic."
msgstr "Jest przepełniony zarodnikową magią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Singing it released the toxic cloud!"
msgstr "Uwolniła się jakaś toksyczna chmura!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "I don't like how much magic is collecting in that."
msgstr "Nie podoba mi się ilość magii, która się w tym gromadzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Only ash and ruin remain here."
msgstr "Został jedynie popiół i szczątki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Smells... \"piney\"."
msgstr "Śmierdzi jakoś tak... iglaście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "The mushrooms have really taken to the log."
msgstr "Grzybki nie próżnowały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Rotten, all the way through. I relate."
msgstr "Przegniła na wskroś. Wiem coś o tym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Nothing grows in these frigid wastes."
msgstr "Nic nie urośnie na tym mroźnym pustkowiu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "They seem to be doing well."
msgstr "Chyba nieźle sobie radzą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "It's so full it's almost obscene."
msgstr "Jest tak pełna, że to aż nieprzyzwoite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "C'est la vie."
msgstr "C'est la vie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "I suppose we're decorating with fungus now."
msgstr "Grzyby są teraz trendy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "A rather pale light."
msgstr "Trochę słabe to światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Who ordered the mushroom flambe?"
msgstr "Ktoś zamawiał pieczone grzyby?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I'm partial to the lavender shade, myself."
msgstr "Wolę odcienie lawendy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "A light to repel the encroaching shadow."
msgstr "Światło, które odegna skradający się mrok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "I hope I'm not standing next to it when it goes off."
msgstr "Mam nadzieję, że będę daleko, gdy wybuchnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Where's Waldo?"
msgstr "Gdzie jest Wally?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Oh fine, do what you like."
msgstr "Cokolwiek. Rób, co chcesz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Ugh, it smells bad."
msgstr "Ugh. Nie pachnie zbyt dobrze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "It's spawning."
msgstr "Mnoży zarodniki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "It smells of rot and failure."
msgstr "Śmierdzi zgnilizną i porażką."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "Could it get any less appealing?"
msgstr "Czy mogłoby wyglądać choć trochę mniej nieprzyjaźnie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "That is probably for the best."
msgstr "Może tak będzie lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "If anything ever looked evil, it's that."
msgstr "Jeśli cokolwiek kiedykolwiek wyglądało jak zło wcielone, to właśnie to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "I don't desire to rouse it."
msgstr "Nie mam najmniejszej ochoty go zbudzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Good riddance."
msgstr "Do widzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "What an atrocious beast."
msgstr "Cóż za potworna bestia!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "May you never wake."
msgstr "Obyś nigdy się nie zbudził."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTLIGHT"
msgid "It burns with a beautiful glow."
msgstr "Tworzy piękną poświatę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREFUEL"
msgid "Ahhh. Refreshing."
msgstr "Aaach. Odświeżające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARELIGHT"
msgid "The overuse of fuel was their downfall."
msgstr "Ich największą wadą było duże zapotrzebowanie na paliwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMAREPIE"
msgid "I'm going to have dreams about this pie nightmare."
msgstr "Będę mieć po tym koszmary."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "The heart of the city is still."
msgstr "Serce miasta jest spokojne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "It calms once more."
msgstr "Znów się uspokaja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The pulse has no influence here."
msgstr "Puls nie ma wpływu na to miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The pulse is holding steady."
msgstr "Puls jest wyrównany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "The pulse is waning."
msgstr "Puls słabnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It beats once again."
msgstr "Znów zaczyna bić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The pulse is quickening."
msgstr "Puls zaczyna rosnąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSTICK"
msgid "Good morning."
msgstr "Dzień dobry."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NIGHTSWORD"
msgid "Snicker-snack!"
msgstr "Na pohybel draniom!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.NITRE"
msgid "One third of the way there..."
msgstr "Brakuje jeszcze dwóch składników..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OAR"
msgid "I have no desire to toil like a common sailor."
msgstr "Nie mam najmniejszej ochoty trudzić się niczym jakiś pospolity marynarz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OAR_DRIFTWOOD"
msgid "Hmph. I've never been one for manual lab-oar."
msgstr "Hmpf. Nigdy mnie nie niosło, aby brać się za wiosło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE.EMPTY"
msgid "It's not in season."
msgstr "To nie ta pora roku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OASISLAKE.GENERIC"
msgid "Didn't think I'd ever come back here."
msgstr "Nie myślałem, że kiedykolwiek tu wrócę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Disappointing."
msgstr "Rozczarowałem się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "I used to see quill floats like this back in England."
msgstr "Widywałem takie spławiki w Anglii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "I used to see quill floats like this back in England."
msgstr "Widywałem takie spławiki w Anglii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "A bit of extra flair goes a long way."
msgstr "Dłuższe pióro to i dalej leci."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "A bit of extra flair goes a long way."
msgstr "Dłuższe pióro to i dalej leci."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "It seems to be missing something."
msgstr "Zdaje się, że czegoś brakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "It's made of tougher stuff."
msgstr "Twardy orzech do zgryzienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "I used to see quill floats like this back in England."
msgstr "Widywałem takie spławiki w Anglii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "I used to see quill floats like this back in England."
msgstr "Widywałem takie spławiki w Anglii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "I think Higgsbury already got too close to one of these."
msgstr "Higgsbury chyba już kogoś zanudził."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "I'm reluctant to see what manner of fish would bite THAT."
msgstr "Nie mam ochoty patrzeć, jakie ryby się na TO złapią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "Go fishing in the rain? And ruin my last good suit?"
msgstr "Mam iść łowić ryby w deszczu? I zniszczyć swój ostatni dobry garnitur?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "Why would anyone want to fish while it's snowing?"
msgstr "Dlaczego ktokolwiek chciałby łowić ryby, kiedy pada śnieg?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "At least I don't have to use worms."
msgstr "Przynajmniej nie potrzebuję robaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISHINGROD"
msgid "A more in-depth approach to fishing."
msgstr "Bardziej dogłębne podejście do wędkarstwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "It looks positively revolting."
msgstr "Wygląda wstrętnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "It has a rather unsettling stare."
msgstr "Ma dość niepokojące spojrzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "I'd best take care to avoid those spines."
msgstr "Lepiej nie dotykać tych kolców."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "I'm not sure it was worth the effort."
msgstr "Nie wiem, czy warto było się tak wysilać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "What an odd creature."
msgstr "Co za przedziwne stworzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Don't be koi with me."
msgstr "Nie karp się tak na mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Don't be koi with me."
msgstr "Nie karp się tak na mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "Stay frosty, pal."
msgstr "Zachowaj zimną krew, kolego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_1"
msgid "This was barely worth my time."
msgstr "Szkoda było mojego czasu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_2"
msgid "Hardly bigger than a minnow."
msgstr "Niewiele większa od planktonu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_3"
msgid "I was hoping for something bigger."
msgstr "Nieco mniejszy rozmiar niż można byłoby się spodziewać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_4"
msgid "Just a cold fish."
msgstr "Zwykła płotka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Its smell oddly reminds me of the theater house..."
msgstr "Dziwne, jej zapach przywodzi mi na myśl kino..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_6"
msgid "What an ugly thing."
msgstr "Co za brzydactwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_7"
msgid "It seems more plant than fish."
msgstr "Bardziej roślina niż ryba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_8"
msgid "The sunfish! It burns!"
msgstr "Samogłów słoneczny! Parzy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OCEANFISH_SMALL_9"
msgid "How vulgar."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONEMANBAND"
msgid "It has a good beat, and you can dance to it."
msgstr "Dobry bit! Zapraszam do tańca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION"
msgid "It's a pungent onion."
msgstr "Śmierdząca cebula."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION_COOKED"
msgid "Take that, onion."
msgstr "A masz, cebulo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ONION_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALPRECIOUSGEM"
msgid "A sizable magic gem."
msgstr "Całkiem sporawy klejnot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.OPALSTAFF"
msgid "The charge has made it incredibly powerful."
msgstr "Ładunek sprawił, że jest niezwykle potężny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEAMULET"
msgid "Simple magic is often the best."
msgstr "Prosta magia często najlepiej zdaje egzamin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEGEM"
msgid "This will be quite powerful with some fuel."
msgstr "Odrobina paliwa i będzie naprawdę potężny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGEMOONEYE"
msgid "I have a feeling of being watched, even from a considerable distance away."
msgstr "Czuję, że coś mnie obserwuje, i to nawet z bardzo daleka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ORANGESTAFF"
msgid "It's a focusing tool."
msgstr "Służy do skupiania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANDORASCHEST"
msgid "It's a trap."
msgstr "To pułapka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANETTONE"
msgid "Fruitcake's more agreeable cousin."
msgstr "Smaczniejsza kuzynka keksu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PANFLUTE"
msgid "I'm going to sing a song of madness."
msgstr "Zaniosę pieśń szaleństwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAPYRUS"
msgid "A blank canvas."
msgstr "Czyste płótno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PAVLOVA"
msgid "It has a certain elegance to it."
msgstr "Ma w sobie trochę elegancji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEGHOOK"
msgid "I should like to avoid a pinch from that, I think."
msgstr "Lepiej będzie chyba, jeśli będę trzymał się z dala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PENGUIN"
msgid "Nice tux."
msgstr "Niezgorszy smoking."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER"
msgid "Looks like the spicy kind."
msgstr "Wygląda na ostrą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPERPOPPER"
msgid "Pops right into my mouth!"
msgstr "Same lecą do gąbki!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER_COOKED"
msgid "Slightly more exciting than the usual vegetable."
msgstr "Trochę bardziej ekscytujące niż nieprzyrządzone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEPPER_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERD"
msgid "It is addicted to fermented berries."
msgstr "Jest uzależniony od sfermentowanych porzeczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDFAN"
msgid "Now I'll have no problem keeping my cool."
msgstr "Teraz upały mi nie straszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.BURNT"
msgid "It's no use to anyone now."
msgstr "Teraz już się nikomu nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Something else seems to be required."
msgstr "Chyba trzeba tu czegoś jeszcze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PERDSHRINE.GENERIC"
msgid "It seems my fortune's changing."
msgstr "Mój los zdaje się odmieniać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PEROGIES"
msgid "They look superb."
msgstr "Smakowicie się prezentują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS"
msgid "I've a habit of destroying beautiful things, don't I?"
msgstr "Mam chyba nawyk niszczenia ładnych rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETALS_EVIL"
msgid "It's dripping with nightmare essence."
msgstr "Aż spływa z nich esencja koszmaru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PETRIFIED_TREE"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PHLEGM"
msgid "I need to put on gloves for this."
msgstr "Potrzebne mi będę do tego rękawiczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKAXE"
msgid "Everybody loves a little mining."
msgstr "Każdy lubi czasem trochę pokopać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PICKLEDHERRING"
msgid "I suppose I can't be picky."
msgstr "Chyba nie mogę zbyt wybrzydzać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE1"
msgid "He's a slippery fellow."
msgstr "Śliski typ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE2"
msgid "A fiery one."
msgstr "Jakiś taki zapalczywy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE3"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITE4"
msgid "Rotten to the core."
msgstr "Skażony do cna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER1"
msgid "He's a slippery fellow."
msgstr "Śliski typ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER2"
msgid "A fiery one."
msgstr "Jakiś taki zapalczywy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER3"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGELITEFIGHTER4"
msgid "Rotten to the core."
msgstr "Skażony do cna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGUARD"
msgid "Blech. Disgusting brute."
msgstr "Bleee. Odrażający typ."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGGYBACK"
msgid "Oh, that's just demeaning."
msgstr "Poniżające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.BURNT"
msgid "Pig roast!"
msgstr "Pieczona wieprzowina!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHEAD.GENERIC"
msgid "Er... charming."
msgstr "Eee... urocze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.BURNT"
msgid "Let's see you hide in there now."
msgstr "Zobaczmy, czy teraz się schowasz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.FULL"
msgid "I'd go inside too, if I was him."
msgstr "Też bym się schował, gdybym był na jego miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.GENERIC"
msgid "It is not a sound structure."
msgstr "Nie imponuje odpornością."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "I'll huff and I'll puff!"
msgstr "Będę chuchał i dmuchał!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGKING"
msgid "That's a man with his priorities in order!"
msgstr "Ten to się umie ustawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.DEAD"
msgid "I dub thee, \"Bacon\"."
msgstr "Nazwę cię „Bekon”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.FOLLOWER"
msgid "He's simple, but he's mine."
msgstr "Jest prymitywny, ale jest mój."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GENERIC"
msgid "What a slobbering fool."
msgstr "Co za uśliniony głupiec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.GUARD"
msgid "They're starting to organize."
msgstr "Zaczynają się organizować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGMAN.WEREPIG"
msgid "That one's gone feral."
msgstr "Ten trochę zdziczał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.BURNT"
msgid "Not useful like this."
msgstr "Na nic nie przyda się w tym stanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs some kind of meat."
msgstr "Potrzeba tu jakiegoś mięsa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSHRINE.GENERIC"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGSKIN"
msgid "It was him or me."
msgstr "Albo on, albo ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTENT"
msgid "That's just nasty."
msgstr "Okropieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIGTORCH"
msgid "Great. Now they have fire."
msgstr "Świetnie. Teraz maja ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_COIN"
msgid "Perfect. I'll try not to spend it all in one place."
msgstr "Wspaniale. Postaram się nie wydać go od razu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PIG_TOKEN"
msgid "Those pigs are getting more and more clever."
msgstr "Te świnie stają się coraz bardziej przebiegłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Ktoś bardziej miłujący przyrodę może byłby w stanie do czegoś ją wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PINECONE_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Hmm, wygląda na to, że powinna być w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PITCHFORK"
msgid "The tool of choice for perfectionists."
msgstr "Narzędzie perfekcjonisty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT"
msgid "A feeble attempt to trick the weak minded."
msgstr "Marna próba oszukania mniej wprawnego umysłu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANTMEAT_COOKED"
msgid "The heat has made this a suitable meal."
msgstr "Ciepło sprawiło, że nada się do spożycia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "That is a generic plant."
msgstr "Zupełnie zwyczajna roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It's growing."
msgstr "Jeszcze rośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.READY"
msgid "It's ready."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It wasn't hardy enough for the heat."
msgstr "Upał zwyciężył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.ATTACKER"
msgid "%s seems untrustworthy..."
msgstr "%s to chyba nie jest ktoś, komu można zaufać..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s has been lighting fires."
msgstr "%s sporo tu podpala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GENERIC"
msgid "Greetings, %s."
msgstr "Witaj, %s."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.GHOST"
msgid "%s needs heart-shaped assistance."
msgstr "%s cierpi na niedobór serca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.MURDERER"
msgid "Murderous fiend! I'll stop at nothing!"
msgstr "Złowrogi morderca! Dopadnę cię!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PLAYER.REVIVER"
msgid "%s tethers lost spirits to this world."
msgstr "%s przywołuje zagubione dusze na powrót do świata żywych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POCKET_SCALE"
msgid "I keep it next to my pocket watch and my pocket comb."
msgstr "Trzymam ją obok zegarka i grzebienia kieszonkowego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POLISHCOOKIE"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE"
msgid "Usually I'd get someone to seed this for me."
msgstr "Normalnie dałbym go komuś, żeby mi wydłubał nasiona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND"
msgid "I can see my face reflected off the top."
msgstr "Widzę swoje odbicie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PONDEEL"
msgid "It slithers all the way down."
msgstr "Ślisko ślizga się ciałem obślizgłym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PONDFISH"
msgid "Fresh from the murky depths."
msgstr "Prosto z mokrych otchłani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POND_ALGAE"
msgid "It's some algae."
msgstr "Jakieś algi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POOP"
msgid "It's the way of all mortal life."
msgstr "Takie są uroki życia śmiertelników."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "Does it have to make such a horrible racket?"
msgstr "Czy musi tak okropnie hałasować?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "I must exercise patience..."
msgstr "Muszę ćwiczyć cierpliwość..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "It will be finished shortly."
msgstr "Zaraz będzie gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Let's hope something palatable has come of it."
msgstr "Miejmy nadzieję, że wyjdzie z tego coś nadającego się do przełknięcia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Dismally devoid of foodstuffs."
msgstr "Przeraźliwie pusty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "An instrument of the dark culinary arts."
msgstr "Narzędzie mrocznej sztuki kulinarnej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Finally something with some taste."
msgstr "Wreszcie coś o jakimkolwiek smaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Ah. The daily grind."
msgstr "Ach. Codzienny młynek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLETENT"
msgid "Oh, how I miss sleeping indoors."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PORTABLETENT_ITEM"
msgid "Surely someone else can set it up."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO"
msgid "It is in the nightshade family, you know."
msgstr "Należy do rodziny psiankowatych. Warto wiedzieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATOSOUFFLE"
msgid "It's so delicate."
msgstr "Jest taki delikatny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATOTORNADO"
msgid "What an odd way to serve potatoes."
msgstr "Przedziwny sposób na serwowanie ziemniaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO_COOKED"
msgid "The potato may be eaten now."
msgstr "Ziemniak może zostać skonsumowany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POTTEDFERN"
msgid "How quaint."
msgstr "Po prostu urocza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.POWCAKE"
msgid "What foul manifestation of evil is this?"
msgstr "Zło przybiera najróżniejsze formy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.GENERIC"
msgid "It's a puffin."
msgstr "Maskonur."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.HELD"
msgid "I'm gonna turn you into puffin' stuff."
msgstr "Czy jak zdejmę ci maskę, to dasz nura?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUFFIN.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Sen to tylko chwilowa ucieczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN"
msgid "Hallowe'en was always my favorite."
msgstr "Zawsze uwielbiałem Halloween."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINCOOKIE"
msgid "It's been eons since I had a good biscuit."
msgstr "Wieki minęły, od kiedy jadłem dobre ciastko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKINPIE"
msgid "Well... perhaps just a slice."
msgstr "No... Może tylko kawałeczek..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_LANTERN"
msgid "Why hello, Mr. Crane."
msgstr "Witam pana, panie dynio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PUMPKIN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEAMULET"
msgid "It speaks with the shadow."
msgstr "Pozwala rozmawiać z krainą cienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEGEM"
msgid "Purple brings great power."
msgstr "Fiolet jest źródłem potężnej mocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.PURPLEMOONEYE"
msgid "A decent enough use of the gem's power, I suppose."
msgstr "Całkiem sensowne wykorzystanie potęgi klejnotu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "I'm not sure how it draws magic from this."
msgstr "Nie wiem, skąd bierze magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Best offer it something if we enjoy living."
msgstr "Najlepiej złożyć w ofierze coś, co chcemy, aby żyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "It's a post."
msgstr "To słupek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Creeping ivy."
msgstr "Bluszcz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A bit excessive..."
msgstr "Trochę za mocne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "I do like a good statue."
msgstr "Nie ma to jak dobra statua."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Misdirected dedication."
msgstr "Niewłaściwie ukierunkowane poświęcenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "It's seen better days."
msgstr "Nie jest w najlepszej formie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those are never growing back."
msgstr "Już nigdy nie odrosną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Refined dishware."
msgstr "Wyrafinowane nakrycie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "Homey."
msgstr "Jak w domu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "A tiny bit of domestication."
msgstr "Niewielka porcja nostalgii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN1"
msgid "Well, well, well..."
msgstr "Proszę, proszę, proszę..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN2"
msgid "I'll have use for this."
msgstr "Wiem, jak tego użyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN3"
msgid "On my way up in the world."
msgstr "Pnę się w górę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_COIN4"
msgid "We may wyrm our way out of this predicament yet."
msgstr "Może jeszcze da się okupić jakoś przetrwanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Ah, how refined."
msgstr "Ach, jakże wykwintne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Perfect with a bit of butter."
msgstr "Doskonałe z odrobiną masła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Dinner should be arriving any moment."
msgstr "Kolacja powinna być gotowa za moment."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FERN"
msgid "Perhaps it has some flavor to it."
msgstr "Być może nieźle smakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I suppose one could make baked goods with this."
msgstr "Chyba może posłużyć do wypieków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "I ought to mix it in with something else."
msgstr "Muszę to z czymś wymieszać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's see how the wyrm likes this."
msgstr "Zobaczmy, co powie na to głodna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This is exactly what the wyrm wants."
msgstr "Oto, czego życzy sobie głodna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Well, I suppose it will tide the wyrm over."
msgstr "Cóż, miejmy nadzieję, że głodna bestia tym nie wzgardzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Nope. It won't eat that."
msgstr "Nie. To się nie nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "I didn't cook that one."
msgstr "To nie moja wina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Zakładam, że to dlatego nie ma tu żadnych wampirów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Ciekawe, czy nadal ma moc odpędzania umarłych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATKID"
msgid "He has no future ahead of him. A shame."
msgstr "Nie ma dlań przyszłości. Co za szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "My bones are naturally fragile, I'm afraid."
msgstr "Obawiam się, że moje kości są z natury łamliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "May I peruse your wares, ma'am?"
msgstr "Czy mogę tak przejrzeć pani towary?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL"
msgid "I believe I can barbeque."
msgstr "Sądzę, że potrafię grillować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "No use to me here."
msgstr "Nie ma tu zeń pożytku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "I'd prefer a larger grill."
msgstr "Wolę większe grille."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "At least it's portable."
msgstr "Przynajmniej jest przenośny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_HOE"
msgid "This is so very beneath me."
msgstr "To naprawdę poniżej mojego poziomu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY"
msgid "And they thought their things were safe."
msgstr "A myśleli, że ich rzeczy są bezpieczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "This should open some doors."
msgstr "To powinno otworzyć kilka drzwi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "A touch of civility."
msgstr "Odrobina kultury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "A little civility."
msgstr "Odrobina kultury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "This looks like it requires hard labor."
msgstr "Wygląda, jakby wymagał ciężkiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "The stinking abode of those filthy fish creatures."
msgstr "Obleśne domostwo obmierzłych rybo-stworzeń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Let's see what they have today."
msgstr "Zobaczmy, co dziś tu mamy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Well what do we have here?"
msgstr "Co my tu mamy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Fungus has its uses."
msgstr "Grzyb ma swoje zastosowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "I could, perhaps, produce a makeshift garnish."
msgstr "Mógłbym zmajstrować zeń szybkie przybranie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "It's as hollow as this withered world."
msgstr "Nie ma tu nic ciekawego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION"
msgid "It's a pungent onion."
msgstr "Śmierdząca cebula."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Take that, onion."
msgstr "A masz, cebulo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN"
msgid "This makes things much more convenient."
msgstr "To wiele ułatwia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "It's an oven. For cooking."
msgstr "To piecyk. Do gotowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Spikey. Like me."
msgstr "Ma ostre końce. Jak ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Some kind of gargoyle."
msgstr "To jakiś gargulec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Well that's attractive."
msgstr "Bardzo uroczy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Just useless rubble now."
msgstr "Bezużyteczna sterta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Seems we've got it open."
msgstr "Stoi otworem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It needs a key."
msgstr "Wymaga klucza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's a monument to death."
msgstr "Monument ku czci śmierci."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Yes yes, ashes to ashes and all that."
msgstr "Tak, tak. Z prochu w proch i tak dalej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "You can't hide from me."
msgstr "Nie uciekniesz przede mną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It is no more."
msgstr "Było i nie ma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "How are birds getting in here?"
msgstr "Jak te ptaki się tutaj dostają?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Fast asleep."
msgstr "Twardo śpi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Suitable lavishness."
msgstr "Stosowny przepych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Brackish."
msgstr "Słonawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Nobody listens to me."
msgstr "Nikt mnie nie słucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Good. I can get out of here."
msgstr "Dobrze. Mogę się stąd wydostać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT"
msgid "Magic could bring it to a boil faster, you know."
msgstr "Magia mogłaby sprawić, że szybciej by się zagotowało. Tylko mówię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO"
msgid "It is in the nightshade family, you know."
msgstr "Należy do rodziny psiankowatych. Warto wiedzieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "The potato may be eaten now."
msgstr "Ziemniak może zostać skonsumowany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "I can put this to good use."
msgstr "Może być zeń pożytek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Well I'M not setting it up."
msgstr "No cóż, JA nie będę tego rozstawiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "I shalln't let it speak with the kettle."
msgstr "Nie pozwolę, aby przyganiał kotłowi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "I need to sweeten the pot."
msgstr "Czas tu trochę osłodzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Foul."
msgstr "Paskudztwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "A bicycle built askew."
msgstr "Rower nędznej roboty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Carriage carnage."
msgstr "Kraksa karocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "They didn't pray hard enough."
msgstr "Nie modlili się dość żarliwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Something has happened here."
msgstr "Coś tu zaszło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Nobody has kept up with repairs."
msgstr "Nikt tu nic nie naprawiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Time's up."
msgstr "Czas minął."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "A late clocktower."
msgstr "Spóźnia się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "No one's living there anymore."
msgstr "Nikt już tu nie mieszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Such destruction."
msgstr "Co za zniszczenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Nothing like the decline of a civilization."
msgstr "Nie ma to jak upadek cywilizacji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "If only it lead somewhere."
msgstr "Gdyby jeszcze gdzieś tak wiodły..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It's no longer over anyone's head."
msgstr "Już nikt pod nim nie mieszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Now for some expert-level rummaging."
msgstr "Czas zabrać się za szperanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I cannot open it."
msgstr "Nie mogę go otworzyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON"
msgid "Foul smelling, but delicious."
msgstr "Śmierdzi okrutnie, ale jest pyszny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "I do enjoy a good smoked salmon."
msgstr "Przepadam za wędzonym łososiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT"
msgid "Adding too much is an a-salt on the senses."
msgstr "Lepiej nie przesolić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It must be ground down before we use it."
msgstr "Trzeba ją wpierw zetrzeć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Any method to improve the food around here is welcome."
msgstr "Każdy sposób na ulepszenie lokalnej żywności jest wart wypróbowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Ah. It's ready."
msgstr "Ach. Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "Just useless sticks until we assemble it."
msgstr "Do chwili, gdy nie zostaną zmontowane, to jedynie sterta patyków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP"
msgid "I would rather not get that on my gloves."
msgstr "Wolałbym nie uwalać sobie rękawic."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's already sticky."
msgstr "Już się lepi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I don't have time to watch twigs grow."
msgstr "Nie mam czasu patrzeć, jak rosną gałązki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Bittersweet."
msgstr "Słodko-gorzki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Instruments of toil."
msgstr "Element ciężkiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't mind getting my hands dirty with this."
msgstr "Nie mam nic przeciwko temu, aby pobrudzić sobie ręce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spicy."
msgstr "Ostre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Aromatic."
msgstr "Aromatyczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back anytime soon."
msgstr "Nie odrośnie zbyt szybko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "That will spice things up."
msgstr "To powinno dodać nieco smaku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "A sickly sweet aroma wafts from its branches."
msgstr "Jego gałązki rozsiewają słodki zapach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It won't produce sap now."
msgstr "Nie ma co liczyć teraz na żywicę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Well it's ruined now."
msgstr "No cóż. Już się nie uratuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It is filling. Ever so slowly."
msgstr "Napełnia się. Kropla po kropli."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "The sap is ready for collection."
msgstr "Żywica gotowa do zebrania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "This tree has seen better days."
msgstr "To drzewo pamięta lepsze dni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Don't touch the suit."
msgstr "Nie pognieć mi garnituru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Charmed, I'm sure."
msgstr "Mi też jest bardzo miło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Fast asleep."
msgstr "Twardo śpi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It could use renovations."
msgstr "Przydałby się tu remont."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "It's been a long time since this stood properly."
msgstr "Już od dawna nie stoi prosto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Cooking syrup. Of course."
msgstr "Syrop do gotowania. Oczywiście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's a red, red tomato."
msgstr "Czerwony. Czerwony jak pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It's a red, red roasted tomato."
msgstr "To czerwony, smażony pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Good day to you, sir."
msgstr "Dzień dobry panu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "I tip my hat to you sir."
msgstr "Kłaniam się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a big, bulbous turnip."
msgstr "Wielka, nabrzmiała rzepa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Hardly improves the taste."
msgstr "Wciąż podle smakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT"
msgid "This would be more useful as flour."
msgstr "Chyba lepiej przerobić je na mąkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.GENERIC"
msgid "I've been here too long... it actually looks tasty."
msgstr "Za długo tu jestem.... Wyglądają nawet smacznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBIT.HELD"
msgid "Don't worry, rabbit. Everything is under control."
msgstr "Nie martw się, króliczku. Wszystko pod kontrolą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.GENERIC"
msgid "There's a world going on under there."
msgstr "To jak wejście do nowego świata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOLE.SPRING"
msgid "The entrance has collapsed in on itself."
msgstr "Wejście samo się zapadło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Cleverness killed the carrot."
msgstr "Spryt zgładził marchewkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Oh, isn't that clever."
msgstr "Och, bardzo sprytne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINCOAT"
msgid "Out, out rain!"
msgstr "Precz! Precz, deszczu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINHAT"
msgid "Not the most dapper of hats, but quite necessary."
msgstr "Może nie najwytworniejszy, ale nie można się bez niego obyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.BURNT"
msgid "The rain did not come in time."
msgstr "Deszcz nie nadszedł na czas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAINOMETER.GENERIC"
msgid "I could just look up and learn the same thing."
msgstr "Wystarczy spojrzeć w górę, żeby stwierdzić to samo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RATATOUILLE"
msgid "Roughage."
msgstr "Kto wymyśla te nazwy?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RAZOR"
msgid "If only the world had a single neck."
msgstr "Gdybyż tylko świat miał szyję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDGEM"
msgid "Red brings fire."
msgstr "Czerwień zwiastuje ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDLANTERN"
msgid "Not having a light would certainly be unlucky."
msgstr "Bez światła byłaby bieda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDMOONEYE"
msgid "Its aura can be felt from anywhere. Quite useful."
msgstr "Jego aurę da się wyczuć wszędzie. Użyteczna rzecz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REDPOUCH"
msgid "A spot of luck."
msgstr "Miejsce pełne szczęścia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP"
msgid "I forget what this one does."
msgstr "Zawsze zapominam, który jak działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_CAP_COOKED"
msgid "Kind of bitter."
msgstr "Trochę gorzki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a red mushroom."
msgstr "Czerwony grzyb."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It'll have to come back for it."
msgstr "Będę musiał po niego wrócić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "It's all used up."
msgstr "Zupełnie zużyty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.GENERIC"
msgid "There's wind in them there willows."
msgstr "Pamiętasz miła, tę noc w tataraku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REEDS.PICKED"
msgid "No more tubes."
msgstr "Użyteczne rurki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REFLECTIVEVEST"
msgid "Safety before dapperness."
msgstr "Bezpieczeństwo ponad elegancję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RELIC"
msgid "Remnants of an extinct civilization."
msgstr "Pozostałości po starożytnej cywilizacji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.BURNT"
msgid "The fire learned how to burn it down."
msgstr "Ogień nauczył się, jak puścić ją z dymem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I can't believe I forgot how to build those things."
msgstr "Nie mogę wręcz uwierzyć, że zapomniałem, jak to wszystko zbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Flames have swallowed it whole."
msgstr "Ogień go pochłonął."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "It unlocks recipes of middling utility."
msgstr "Odblokowuje receptury o średniej przydatności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Research complete."
msgstr "Badanie zakończone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "This is where I do my own personal research."
msgstr "Tutaj prowadzę swoje badania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "That was its final act."
msgstr "To już koniec."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Quite a dapper machine."
msgstr "Całkiem elegancka maszyna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESKIN_TOOL"
msgid "Presto change-o! Ahem... old habit."
msgstr "Hokus pokus! Ekhem... stare nawyki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "No one will be using that any longer."
msgstr "Nikt już więcej z ciebie nie skorzysta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "I'm not above using this."
msgstr "Mógłbym tego użyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RESURRECTIONSTONE"
msgid "There's a story behind that..."
msgstr "Do dłuższa historia..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.REVIVER"
msgid "I'm not sure I really want to give this up."
msgstr "Nie jestem pewien, czy jestem gotów przestać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RHINODRILL"
msgid "Brutish grotesquerie."
msgstr "Brutalistyczna groteska."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROASTTURKEY"
msgid "I myself will carve this roast beast."
msgstr "Własnoręcznie pokroję tę pieczoną bestię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.GENERIC"
msgid "The redbird comes from the fire lands."
msgstr "Kardynały pochodzą z ognistych krain."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN.HELD"
msgid "Silence, bird!"
msgstr "Cisza, ptaku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "You're new."
msgstr "My się chyba nie znamy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Nothing up my sleeve..."
msgstr "Nie wiem, co powiedzieć..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROBOT_PUPPET"
msgid "Better them than me."
msgstr "Lepiej on, aniżeli ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK"
msgid "It's a rock."
msgstr "Kamień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKS"
msgid "Hmmm. Now what do I do with them?"
msgstr "Hmm. I co mam z nimi zrobić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCKY"
msgid "I banished these guys down here for a reason."
msgstr "Nie bez powodu umieściłem je w tym miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It is fruitless and useless now."
msgstr "Bezowocny i bezużyteczny krzak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Well that's a shame."
msgstr "Szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It's ill."
msgstr "Choruje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "I think it's sick or something."
msgstr "Chyba jest chore albo coś takiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It labors to make my dinner."
msgstr "Haruje na mój obiad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "What use are you to me if you don't have fruit?"
msgstr "Jaki mam z ciebie pożytek, jeśli nie dajesz owoców?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It resembles Woodie, does it not?"
msgstr "Przypomina Woodie'go, prawda?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "I'd rather not shatter my teeth on that."
msgstr "Wolałbym nie połamać sobie na tym zębów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "It's ripe enough to eat now."
msgstr "Dość dojrzałe, by nadawać się do zjedzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It looks almost appetizing."
msgstr "Wygląda prawie smacznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "How off-putting. It's grown a sprout."
msgstr "Odrażające. Puściło pędy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.GENERIC"
msgid "I could get a chip of ice off the old block."
msgstr "Ofiara efektu cieplarnianego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE.MELTED"
msgid "It's just a puddle."
msgstr "Zwykła kałuża."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_ICE_MELTED"
msgid "It's just a puddle."
msgstr "Zwykła kałuża."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The top of this lava pit has cooled into a fine crust."
msgstr "Powierzchnia wystygła, tworząc równą skorupę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The fires are cooling."
msgstr "Te płomienie zdają się być chłodne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "It's hot."
msgstr "Gorące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks harmless."
msgstr "Wygląda niegroźnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_MOON"
msgid "\"Moon\" rock."
msgstr "Kawałek „księżyca”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "I think it looks much better this way."
msgstr "Teraz wygląda o wiele lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK"
msgid "A castle for my home."
msgstr "Kawałek zamku. Mógłbym w nim zamieszkać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROOK_NIGHTMARE"
msgid "The builders have left it in a state of abandonment."
msgstr "Budowniczy zostawili ją tu na pastwę koszmarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROPE"
msgid "You'd think this would have more uses."
msgstr "Spodziewałbym się, że będzie miała więcej zastosowań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROTTENEGG"
msgid "Disgusting. Why keep this around?"
msgstr "Obrzydliwość? Po co to trzymać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ROYAL_JELLY"
msgid "Unsettlingly wobbly."
msgstr "Strasznie się trzęsie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUBBLE"
msgid "Everything eventually turns to dust."
msgstr "Wszystko obraca się z czasem w pył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINSHAT"
msgid "Fuel must flow."
msgstr "Coś w sam raz dla mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_BAT"
msgid "The fuel runs deep in this."
msgstr "Paliwo jest w nim silne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.RUINS_RUBBLE"
msgid "A broken relic."
msgstr "Zepsuty relikt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "A relic best forgotten."
msgstr "Relikt, o którym najlepiej będzie zapomnieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It seems I am to be judged."
msgstr "Zdaje się, iż jestem oceniany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLEHORN"
msgid "And I may never put it back on."
msgstr "I już nigdy więcej go nie założę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_BASIC"
msgid "But that means I'd have to touch the smelly thing."
msgstr "Ale to by znaczyło, że musiałbym się babrać z tą śmierdzącą bestią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_RACE"
msgid "But is it fast enough to escape the judgmental stares?"
msgstr "Ale czy jest dość szybkie, by umknąć przed oskarżycielskimi spojrzeniami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SADDLE_WAR"
msgid "At least it affords some dignity to the rider."
msgstr "Zapewnia swemu użytkownikowi choć odrobinę godności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALSA"
msgid "A bit spicy for my delicate palate."
msgstr "Nieco zbyt pikantna dla mojego delikatnego podniebienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTBOX"
msgid "This will extend the life of our supplies somewhat."
msgstr "Wydłuża przydatność do spożycia naszych zapasów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTLICK"
msgid "So salty."
msgstr "Ale słone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTROCK"
msgid "Am I to be a salt miner now?"
msgstr "Mam być teraz górnikiem w kopalni soli?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GENERIC"
msgid "Odd..."
msgstr "Dziwne..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.GROWING"
msgid "It seems to be growing back..."
msgstr "Chyba odrasta..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "It's been mined down to nothing."
msgstr "Wybrane do zera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDBLOCK"
msgid "Impressive."
msgstr "Imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANDSPIKE"
msgid "That was quite impolite."
msgstr "Było to raczej nieeleganckie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I can see its true nature now!"
msgstr "Teraz dostrzegam jego prawdziwą naturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SANITYROCK.INACTIVE"
msgid "There are two ways to see that obstacle."
msgstr "Są dwa sposoby patrzenia na tą przeszkodę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.GENERIC"
msgid "A supple, woody stem."
msgstr "Miękka, drewniana łodyżka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.PICKED"
msgid "It'll grow back."
msgstr "Odrośnie"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SAPLING.WITHERED"
msgid "Nothing survives in this heat."
msgstr "Nic nie przetrwa w tym upale."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNING"
msgid "Nothing is safe."
msgstr "Nikt nie jest bezpieczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow has gone to a place where there is no fear."
msgstr "Udał się do miejsca, gdzie strach nie istnieje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCARECROW.GENERIC"
msgid "It's an empty shell of a man."
msgstr "Pusta skorupa człowieka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCORCHED_SKELETON"
msgid "At least the fire cut down on the smell."
msgstr "Przynajmniej ogień zdusi nieco ten odór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "How I've missed the act of creation."
msgstr "Brakowało mi pracy stwórczej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "To sculpt, to carve, no more."
msgstr "Koniec rzeźbienia, koniec tworzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A block of marble might suffice."
msgstr "Kawałek marmuru powinien wystarczyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Ah, yes. Not terrible."
msgstr "Ach, tak.. Nie najgorzej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Hmph. I was never a fan of the Grecian look."
msgstr "Hmm. Greckie rysy nigdy mnie nie przekonywały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "That looks much better."
msgstr "Wygląda znacznie lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Come now! I liked that one."
msgstr "No proszę! Wygląda całkiem nieźle."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I've seen that head before... but never in marble."
msgstr "Widziałem już kiedyś tę głowę... ale nigdy w marmurze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Waste of good marble if you ask me."
msgstr "Moim zdaniem szkoda dobrego marmuru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Back as intended."
msgstr "No, tak jak miało być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "My creations! How rude."
msgstr "Moje dzieła! Ale toporne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That looks... familiar..."
msgstr "Wygląda jakoś... znajomo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Some truly questionable taste in decor."
msgstr "Ktoś ma bardzo dziwny gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Doesn't that feel better now?"
msgstr "Tak chyba lepiej, co?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "We'll get you out in a tick, friend."
msgstr "Wydostaniemy cię z tej opresji, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Why would anyone want to cover this up?"
msgstr "Dlaczego ktoś chciałbym to zakrywać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "That's quite the schnozz."
msgstr "Ale kinol!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Well, it's useless now."
msgstr "Cóż, do niczego się już nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Now to see if Higgsbury's ideas hold water."
msgstr "Zaraz zobaczymy, czy pomysły Higgsbury'ego trzymają się wody."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEAFOODGUMBO"
msgid "It looks passable."
msgstr "Wygląda całkiem przyzwoicie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEASTACK"
msgid "It would be easy to wreck a vessel on one of those."
msgstr "Nietrudno rozbić statek na czymś takim."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS"
msgid "I suppose these won't plant themselves."
msgstr "Same się pewnie nie zasieją."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEEDS_COOKED"
msgid "Broiled the life out of 'em."
msgstr "Wygotowałem z nich wszelkie życie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SENTRYWARD"
msgid "This is a conduit for strong revelatory magicks."
msgstr "To przekaźnik silnej, nowatorskiej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_KIT"
msgid "A fine and noble endeavor."
msgstr "Zaprawdę szlachetna czynność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SEWING_TAPE"
msgid "The wilderness is tough on a tailor made suit."
msgstr "Dzikie ostępy nie pomagają elegancji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWDIGGER"
msgid "I'm a shadow of myself. Ha-ha!"
msgstr "Jestem cieniem samego siebie. Ha-ha!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHADOWHEART"
msgid "A pulse of malice and betrayal beats within."
msgstr "Wewnątrz słychać puls zła i zdrady."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHARK"
msgid "What a nasty creature. I wish I'd thought of it."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHELL_CLUSTER"
msgid "That was not worth the effort."
msgstr "Szkoda było wysiłku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHOVEL"
msgid "This is some real advanced technology."
msgstr "To jakaś zaawansowana technologia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SHROOM_SKIN"
msgid "I hope the warts are not contagious."
msgstr "Mam nadzieję, że te brodawki nie są zaraźliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.BURNT"
msgid "So much for the shade thing."
msgstr "No i nie ma cienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Rustic, but excellent shade."
msgstr "Trochę prymitywne wykonanie, ale działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SILK"
msgid "Despite its origin, it could make some fine garments."
msgstr "Pomimo parszywego pochodzenia może posłużyć do stworzenia naprawdę przyzwoitych ubrań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "Hm?"
msgstr "Hm?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "No, go on, keep playing that same note. It's not irritating at all."
msgstr "Ależ nie krępuj się, nie zmieniaj nuty. Wcale mnie to nie irytuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "I've quite lost my taste for music."
msgstr "Trochę straciłem serce do muzyki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.GENERIC"
msgid "I can't help but wonder... no, it couldn't be."
msgstr "Zastanawiam się, czy... nie, to niemożliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "It has a strangely calming effect."
msgstr "Działa dziwnie uspokajająco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Perhaps I should pay my respects as well."
msgstr "Może też powinienem oddać hołd."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON"
msgid "Ha! I remember that one."
msgstr "Ha! Pamiętam go."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETONHAT"
msgid "A most tragic and unfitting end."
msgstr "Tragiczny i niestosowny kres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "A pity, %s. So ill-prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "A pity, %s. She was not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "A pity, %s. He was not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "A pity, %s. They were not prepared for %s."
msgstr "Ach, %s. Co za szkoda. %s to źródło strasznego cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKETCH"
msgid "I'll need somewhere to sculpt it."
msgstr "Potrzebuję jakiegoś miejsca do rzeźbienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SKULLCHEST"
msgid "That chest is calling to me."
msgstr "Ta skrzynia mnie wzywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLEEPBOMB"
msgid "It appears to be a sleeping bag."
msgstr "Jakby śpiwór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOT"
msgid "A rather childish weapon, but quite effective in the right hands."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "Ah, now that might be interesting."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "Ah, now that might be interesting."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "Not particularly creative."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "Must he leave that lying around? I nearly ruined my shoes."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "Not particularly creative."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "Ah, now that might be interesting."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Ah, now that might be interesting."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER"
msgid "Simple creatures. They exist only to sleep and feed."
msgstr "Prymitywne istoty. Żyją tylko po to, by jeść i spać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPERPELT"
msgid "In death, this creature will serve me!"
msgstr "Nawet po śmierci to stworzenie gotowe jest mi służyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURPER_PELT"
msgid "In death, this creature will serve me!"
msgstr "Nawet po śmierci to stworzenie gotowe jest mi służyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE"
msgid "I don't remember those..."
msgstr "Nie pamiętam ich..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHAT"
msgid "This will keep me standing, if I need to fight."
msgstr "Postawi mnie na nogi. Muszę walczyć!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLEHOLE"
msgid "That's revolting."
msgstr "Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLESLIME"
msgid "There must be a better way."
msgstr "Musi być jakiś lepszy sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Some cracks can't be mended."
msgstr "Niektóre rany nigdy się nie zabliźnią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.GENERIC"
msgid "What!? What do you want?"
msgstr "Co? Czego chcesz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You want some food?"
msgstr "Chcesz jeść?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "He's finally asleep."
msgstr "Wreszcie zasnął."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLBIRD.STARVING"
msgid "He's so hungry!"
msgstr "Jest strasznie głodny!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLGHOST"
msgid "I'm so sorry."
msgstr "Bardzo mi przykro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT"
msgid "This is barely a mouthful."
msgstr "Ledwo wystarczy na jednego gryza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SMALLMEAT_DRIED"
msgid "My teeth are getting too old for this."
msgstr "Moje zęby są już na to za stare."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNAPPER"
msgid "I don't fear you, scoundrel."
msgstr "Nie lękam się ciebie, szujo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SNURTLE"
msgid "That's strange. They must be new."
msgstr "Dziwne. Są chyba jakieś nowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPAT"
msgid "Ornery and tough as nails."
msgstr "Twarde i wytrzymałe zwierzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR"
msgid "It's a spear. Yup."
msgstr "Dzida składa się z przeddzidzia dzidy, śróddzidzia dzidy i zadzidzia dzidy. Przeddzidzie dzidy składa się z przeddzidzia przeddzidzia dzidy, śróddzidzia przeddzidzia dzidy i zadzidzia przeddzidzia dzidy. I tak dalej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_GUNGNIR"
msgid "I would never stoop to such things."
msgstr "Nie zniżyłbym się do takich działań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_LANCE"
msgid "How churlish."
msgstr "Jakież to prostackie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPEAR_WATHGRITHR"
msgid "I can appreciate a finely crafted weapon."
msgstr "Potrafię docenić solidny oręż."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICEPACK"
msgid "I've been reduced to hauling my own foodstuffs."
msgstr "Sam sobie teraz muszę nosić jedzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_CHILI"
msgid "Bit of a kick in the pants."
msgstr "Daje kopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_GARLIC"
msgid "Keeps everyone from getting too close."
msgstr "Trzyma wszystkich na dystans."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_SALT"
msgid "My doctor said I shouldn't have too much."
msgstr "Lekarz zabronił mi jej nadużywać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPICE_SUGAR"
msgid "I never was one for syrupy mush."
msgstr "Nigdy nie lubiłem słodyczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.DEAD"
msgid "Splat."
msgstr "Pac."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.GENERIC"
msgid "It's mostly digestive system."
msgstr "W większości składa się z układu trawiennego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER.SLEEPING"
msgid "Shhhh! It will wake up hungry."
msgstr "Ciii! Obudzi się głodny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERDEN"
msgid "They grow big here."
msgstr "Dobrze im tutaj."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDEREGGSACK"
msgid "Squishy."
msgstr "Ale mięciutkie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERGLAND"
msgid "Distasteful."
msgstr "Paskudztwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHAT"
msgid "Spiders have such malleable wills."
msgstr "Pająki mają tak łatwo formowalną wolę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE"
msgid "How did that get down here?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERHOLE_ROCK"
msgid "How did that get down here?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDERQUEEN"
msgid "Maybe I'll just get out of her way."
msgstr "Może po prostu zejdę jej z drogi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_DROPPER"
msgid "Creatures in this world evolve at a terrifying rate."
msgstr "Stworzenia w tym świecie ewoluują w zastraszającym tempie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_HIDER"
msgid "It's a tricky one."
msgstr "Sprytny jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Good riddance."
msgstr "Do widzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "How monstrous."
msgstr "Potworne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "I'd rather not wake it."
msgstr "Wolałbym go nie budzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_SPITTER"
msgid "Aggressive little thing, isn't it?"
msgstr "Agresywny typ, co nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Splat."
msgstr "Pac."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "It's a specialized form."
msgstr "Wyspecjalizowany podgatunek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "I don't want to wake that one."
msgstr "Nie chcę go obudzić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FISH"
msgid "How vile."
msgstr "Wstrętne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPOILED_FOOD"
msgid "That used to be food until I wasted it."
msgstr "Kiedyś było jedzeniem, ale się sfilcowało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Magical red, and yet it holds no power of use to me."
msgstr "Ta magiczna czerwień jest tak intensywna, a jednak pozostaje dla mnie wciąż bezużyteczna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surduta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "Hateful, ambulatory whimsy."
msgstr "Nienawistny, laboratoryjny kaprys."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_SMALL.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surduta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.GENERIC"
msgid "How can a seed be so cheerful?"
msgstr "Jakiż powód do zadowolenia może mieć nasiono?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SPORE_TALL.HELD"
msgid "I hope it doesn't stain my jacket."
msgstr "Mam nadzieję, że nie poplami mi surduta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SQUID"
msgid "I hope they stay close. But not too close."
msgstr "Mam nadzieję, że będą trzymać się blisko. Ale nie zbyt blisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFCOLDLIGHT"
msgid "An impressively condensed point of freezing magic."
msgstr "Niesamowicie skoncentrowany ośrodek mroźnej magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFFLIGHT"
msgid "That should chase the shadows away."
msgstr "Teraz cienie powinny się stąd wynieść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAFF_TORNADO"
msgid "Wind power."
msgstr "Potęga wiatru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.AWAKE"
msgid "Hmph. Impressive sleight of hand."
msgstr "Hmm. Ktoś tu ma dobrą rękę do wystroju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STAGEHAND.HIDING"
msgid "This must be the work of an unseen hand."
msgstr "To sprawka jakiej niewidzialnej dłoni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE"
msgid "Rocks. How dull."
msgstr "Kamienie. Co za nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALAGMITE_TALL"
msgid "Stalagmite. How dull."
msgstr "Stalagmit. Co za nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER"
msgid "There is no limit to the power of shadows."
msgstr "Potęga cieni jest niezmierzona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_ATRIUM"
msgid "The Atrium's power restored his mind."
msgstr "Potęga serca przywróciła mu zmysły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STALKER_MINION"
msgid "A being of living fuel."
msgstr "Twór z żyjącego paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "The fewer statues the better, I say."
msgstr "Myślę, że im mniej pomników, tym lepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "Thank goodness, I thought it was another wretched statue of me."
msgstr "Cóż za ulga. Bałem się to kolejny, przeklęty pomnik mojego imienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEHARP"
msgid "Not my best work."
msgstr "Jedno z moich mniej udanych dzieł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUEMAXWELL"
msgid "It seems silly now..."
msgstr "Teraz zdaje się to takie śmieszne..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Hm. Stately."
msgstr "Hmm. Robi wrażenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Her tragedy does not define her."
msgstr "Jej tragedia nie stanowi o jej charakterze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "She's still in there somewhere. I know it."
msgstr "Wciąż gdzieś tam jest. Wiem to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Needs something. Perhaps some long-stemmed roses..."
msgstr "Potrzeba mu czegoś. Może kilku róż o długich łodyżkach..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEELWOOL"
msgid "Someone should use this to clean something."
msgstr "Można by nią coś wyczyścić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEERINGWHEEL"
msgid "Why yes, you may call me the \"Captain\"."
msgstr "Ależ oczywiście, że możesz do mnie mówić per \"Kapitanie\"."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "Hard labor? Isn't that Winona's forte?"
msgstr "Ciężka praca? Czy to nie specjalność Winony?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STINGER"
msgid "It's dripping with venom."
msgstr "Aż ocieka toksynami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STRAWHAT"
msgid "A hat fit for a peasant."
msgstr "Kapelusz godny wieśniaka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFEDEGGPLANT"
msgid "A meal fit for a king... or at least someone with a throne."
msgstr "Posiłek godny króla... A przynajmniej kogoś, kto ma tron."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.STUFFING"
msgid "Something to fill the void in my stomach."
msgstr "Coś, żeby zapełnić pustkę w żołądku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PICKED"
msgid "It didn't put up much of a fight."
msgstr "Niezbyt chwacko się broniło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_PLANT"
msgid "Doesn't look that succulent to me."
msgstr "Nie wygląda mi na zbyt soczyste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUCCULENT_POTTED"
msgid "You're hard to kill. I respect that."
msgstr "Ciężko cię zabić. Szanuję to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "How whimsical."
msgstr "Ale dziwne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "How annoying. It's locked."
msgstr "Zamknięte. Ależ to denerwujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SUPERTACKLECONTAINER"
msgid "Not the most refined design, but it's functional."
msgstr "Może nie wygląda zbyt wytwornie, ale jest praktyczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SURFNTURF"
msgid "A very balanced meal, I suppose."
msgstr "Zbilansowany posiłek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEATERVEST"
msgid "It's no three-piece, but it's dapper enough."
msgstr "Garnitur to to nie jest, ale daje radę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.SWEETPOTATO"
msgid "How very... rustic."
msgstr "Ależ... rustykalne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Humbug."
msgstr "Duby smalone."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "Must we go through this production for a little food?"
msgstr "Naprawdę trzeba się tyle narobić dla odrobiny jedzenia?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "I suppose I'll have to share."
msgstr "Chyba muszę się podzielić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "The wrong place for this."
msgstr "To nieodpowiednie miejsce dla tego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLECONTAINER"
msgid "Can I really even call it a \"box\"?"
msgstr "Można to w ogóle nazwać przybornikiem?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLESKETCH"
msgid "What forbidden fishing knowledge do you hold?"
msgstr "Jaką zakazaną wiedzę na temat wędkowania skrywasz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TACKLESTATION"
msgid "I suppose I could use a relaxing day of fishing."
msgstr "Przydałby mi się dzień relaksu z wędką."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAFFY"
msgid "It's almost entirely sugar."
msgstr "Sto procentu cukru."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRD"
msgid "These were a failed experiment."
msgstr "Nie udał mi się ten eksperyment."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG"
msgid "Tallbirds are territorial because of these things."
msgstr "Przez nie duptaki są bardzo terytorialne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It tastes like broken dreams."
msgstr "Smakuje zrujnowanymi marzeniami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "It's getting tepid."
msgstr "Zaczyna się wychładzać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "We've got a live one here."
msgstr "Coś się tu rusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Hot enough for ya?"
msgstr "Dość ciepło?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "It's going to be a while."
msgstr "Trochę to potrwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Any moment now..."
msgstr "Już za chwileczkę..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "Well. That's tempting."
msgstr "Cóż... kuszące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "It's made of dirty beefalo hair."
msgstr "Uplecione z brudnych kłaków wołka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TAMALES"
msgid "They've got a bit of kick to them."
msgstr "Dają lekkiego kopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.GENERIC"
msgid "It's less cute now that it's grown up."
msgstr "Wyrośnięty już nie jest taki uroczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.HUNGRY"
msgid "They sure do eat a lot."
msgstr "Potrafią nieźle zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.SLEEPING"
msgid "It's much easier to deal with like this."
msgstr "Teraz znacznie łatwiej się nim zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TEENBIRD.STARVING"
msgid "A hungry beast is a dangerous beast."
msgstr "Głodna bestia to niebezpieczna bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.GEMS"
msgid "The fuel needs more focal points."
msgstr "Paliwo potrzebuje więcej punktów skupienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEBASE.VALID"
msgid "That should do the trick."
msgstr "To powinno wystarczyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "It's alive!"
msgstr "Działa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "My beautiful machine is in pieces!"
msgstr "Moja piękna maszyna w kawałkach!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Now to turn it on."
msgstr "Teraz trzeba go włączyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "It is still incomplete."
msgstr "Wciąż czegoś brakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_BOX"
msgid "This is a box full of sadness and woe."
msgstr "Pudełko pełne smutku i rozpaczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_CRANK"
msgid "This is used to agitate the humors."
msgstr "Można by tym coś nakręcić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_POTATO"
msgid "The gears in here are so small they turn the fabric of reality."
msgstr "Zębatki są tu tak małe, że zakrzywiają powłokę rzeczywistości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELEPORTATO_RING"
msgid "This is the quantum field guard band."
msgstr "Pas ochronny pola kwantowego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TELESTAFF"
msgid "Magic can do amazing things, when funneled through the right channels."
msgstr "Magia potrafi dokonać wielkich rzeczy, jeśli się ją odpowiednio ukierunkuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.BURNT"
msgid "That's a bit burned for my taste."
msgstr "Trochę zbyt przypieczony, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENT.GENERIC"
msgid "That's a bit rustic for my taste."
msgstr "Trochę zbyt rustykalny, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE"
msgid "I'm glad the rest of it is still down there."
msgstr "Dobrze, że reszta jest wciąż pod ziemią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPIKE"
msgid "Ugh. This is so revolting."
msgstr "Ugh. Odrażające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLESPOTS"
msgid "This is how they reproduce."
msgstr "Tak się rozmnażają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_GARDEN"
msgid "This one is odd."
msgstr "Dziwny twór."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR"
msgid "How deep does this go?"
msgstr "Ciekawe, jak głęboko sięga."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Babies?"
msgstr "Młode?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Ugh! How can it live down there?"
msgstr "Uff! Jak tutaj można żyć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE"
msgid "An exceedingly rare but useful material."
msgstr "Niezwykle rzadki, ale użyteczny materiał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THULECITE_PIECES"
msgid "Several of these piles could be combined to form a bigger piece."
msgstr "Można by tak zgarnąć te kupki na jedną stertę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.THURIBLE"
msgid "Curious. It smells like roses."
msgstr "Osobliwe. Wyczuwam woń róży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.GENERIC"
msgid "What an abomination!"
msgstr "Co za paskudztwo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL.RAGE"
msgid "It is coursing with fungal power!"
msgstr "Emanuje grzybną mocą!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "It's a dirt hole."
msgstr "Dziura w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Pitiful. I'll make short work of that 'shroom."
msgstr "Żałosne. Załatwię tego grzyba w mgnieniu oka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "That looks filthy."
msgstr "Wygląda obrzydliwie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO"
msgid "It's a red, red tomato."
msgstr "Czerwony. Czerwony jak pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO_COOKED"
msgid "It's a red, red roasted tomato."
msgstr "To czerwony, smażony pomidor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOMATO_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOPHAT"
msgid "Some fine haberdashery."
msgstr "Fachowa robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TORCH"
msgid "It keeps Charlie at bay."
msgstr "Charlie będzie trzymać się z dala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOURTIERE"
msgid "I haven't had a meat pie since I left Liverpool."
msgstr "Nie jadłem zapiekanki mięsnej odkąd opuściłem Liverpool."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "The magic beckons!"
msgstr "Magia wzywa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Walking gets tiresome, you know."
msgstr "Wędrówki potrafią być męczące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "The magic beckons!"
msgstr "Magia wzywa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "An impure orange gem."
msgstr "Uszkodzony pomarańczowy klejnot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILMIX"
msgid "Nuts and berries. No bolts."
msgstr "Owoce i orzechy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAILS"
msgid "What a brute!"
msgstr "Co za siłacz!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRANSISTOR"
msgid "I don't understand how it works, but it does."
msgstr "Nie wiem, jak to działa, ale działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP"
msgid "Only the dumbest animals will fall for this."
msgstr "Tylko najgłupsze zwierzaki dadzą się na to nabrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_BRAMBLE"
msgid "Best laid traps."
msgstr "To najlepsze pułapki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "Devious thing."
msgstr "Przebiegła rzecz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "It's just a silly starfish."
msgstr "To tylko głupia rozgwiazda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH"
msgid "This one packs a wallop."
msgstr "Potrafi zaboleć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "I'm... sure I had my reasons when I placed this."
msgstr "Jestem... Hmm. Na pewno miałem swe powody, gdy to rozstawiłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.BURNT"
msgid "It won't store anything now."
msgstr "Teraz niczego już nie przechowa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A place to store loot."
msgstr "Miejsce na łupy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREASURECHEST_TRAP"
msgid "Hmmm. Looks suspicious."
msgstr "Hmm. Wygląda podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TREECLUMP"
msgid "I can't get through there."
msgstr "Tędy nie przejdę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRIDENT"
msgid "It seems to have struck a chord."
msgstr "Porusza we mnie jakąś strunę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_1"
msgid "These must have been heated to an incredible temperature."
msgstr "Musiały się rozgrzać do niewyobrażalnej temperatury."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_10"
msgid "Is that a crack about my age?"
msgstr "To aluzja do mego wieku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_11"
msgid "I'm not listening."
msgstr "Nie słucham cię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_12"
msgid "I'm not touching that without several pairs of gloves."
msgstr "Nie dotknę tego bez kilku par rękawiczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_13"
msgid "Don't look at me like that."
msgstr "Nie patrz na mnie w ten sposób."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_14"
msgid "Perhaps I'll invite the librarian for a nice mandrake tea."
msgstr "Może by tak zaprosić bibliotekarkę na herbatkę z mandragory?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_15"
msgid "Charlie was the only one who ever kept me in check."
msgstr "Tylko Charlie potrafiła utrzymać mnie w ryzach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_16"
msgid "Charlie was the only one who ever kept me in check."
msgstr "Tylko Charlie potrafiła utrzymać mnie w ryzach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_17"
msgid "The product of a very immature magician, perhaps."
msgstr "Czyżby dzieło niedojrzałego magika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_18"
msgid "A metaphor, perhaps."
msgstr "Czyżby metafora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_19"
msgid "Admittedly, it's difficult to maintain balance when you're on top."
msgstr "Prawdą jest, iż ciężko zachować równowagę, gdy jest się na szczycie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_2"
msgid "A complete and utter fraud..."
msgstr "Totalne fałszerstwo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_20"
msgid "Eliminates the use of the phrase \"You scratch my back, I'll scratch yours.\""
msgstr "Sprawia, iż to, co dotąd nieosiągalne, może zostać podrapane!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_21"
msgid "I know when I've been beaten."
msgstr "Dobitnie ubita."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_22"
msgid "The monster child gets tangled in this frequently."
msgstr "Potworne dziecię często się w to zaplątuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_23"
msgid "I was looking for that."
msgstr "Właśnie tego szukałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_24"
msgid "It's been beheaded."
msgstr "Dekapitacja dokonana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_25"
msgid "The strongman's wardrobe is brimming with them, judging from the odor."
msgstr "Sądząc po odorze, to coś wprost z szafy siłacza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_26"
msgid "This was important to one very specific person once."
msgstr "Onegdaj był dla pewnego szczególnego kogoś bardzo ważny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_27"
msgid "Finally. My suits were getting wrinkles. Wrinkles!"
msgstr "Nareszcie. Moje garnitury zaczynały się gnieść. Gnieść!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28"
msgid "It is still beholden to the king."
msgstr "Wciąż należy do króla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29"
msgid "It is still beholden to the king."
msgstr "Wciąż należy do króla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3"
msgid "A tangled mess. Like life."
msgstr "Pomieszanie z poplątaniem. Metafora ludzkiego życia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30"
msgid "Not a pawn, but still a minion."
msgstr "Nie pionek, ale jednak wciąż sługa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31"
msgid "Not a pawn, but still a minion."
msgstr "Nie pionek, ale jednak wciąż sługa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32"
msgid "Amateur magic for children."
msgstr "Jarmarczne sztuczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33"
msgid "The opposite of dapper."
msgstr "Przeciwieństwo elegancji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34"
msgid "I'm done tampering with magical oddities, thank-you."
msgstr "Mam już dość magicznych sztuczek. Dzięki bardzo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35"
msgid "I'm not in the habit of imbibing strange liquids."
msgstr "Nie mam w zwyczaju spijać nieznanych płynów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36"
msgid "Permanently bared."
msgstr "Zawsze na wierzchu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_37"
msgid "I told you people, I am *not* a vampire!"
msgstr "Ciągle powtarzam ludziom, że *nie jestem* wampirem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_38"
msgid "You are all ants in my eyes already."
msgstr "W mych oczach jesteście wszyscy mrówkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_39"
msgid "What a tacky glove."
msgstr "Co za tandeta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_4"
msgid "Don't look at me like that."
msgstr "Nie patrz tak na mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_40"
msgid "One hundred percent to scale."
msgstr "Rozmiary w stu procentach zgodne z oryginałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_41"
msgid "I've no idea what that is."
msgstr "Pojęcia nie mam, na co tu patrzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_42"
msgid "It looks cheap."
msgstr "Ale taniocha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_43"
msgid "What use would I have of such a thing?"
msgstr "Co mi po tym?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_44"
msgid "Rosebud."
msgstr "Pąk róży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_45"
msgid "At least it's not ragtime."
msgstr "Tyle dobrego, że to nie ragtime."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_46"
msgid "Some harebrained invention of the scientist's, perhaps?"
msgstr "Czyżby jakiś chory produkt akademickiego umysłu?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_5"
msgid "A toy for a child's mind."
msgstr "Zabawka dla małego geniusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_6"
msgid "I might hide those in the robot's bedroll if I get bored."
msgstr "Może schowam je w śpiworze robota, gdy najdzie mnie nuda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_7"
msgid "Not something a grown man should be caught playing with."
msgstr "Wolałbym, żeby mnie z tym nie widziano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_8"
msgid "I'd prefer a pocketwatch on a chain."
msgstr "Wolałbym zegarek kieszonkowy na łańcuszku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_9"
msgid "My suits don't deserve to be defaced with these tacky atrocities."
msgstr "Mój garnitur nie zasługuje na takie okropieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "No! NOO!"
msgstr "Nie! NIEE!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "All my ambitions go up in smoke."
msgstr "Moje ambicje poszły z dymem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Perhaps I might reign again... as the king of fishing!"
msgstr "Może znów mógłbym rządzić... jako król wędkarzy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Waga: {weight}\nImię wędkarza: {owner}"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nEnjoy your moment while it lasts..."
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nCiesz się chwilą sławy, póki trwa..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nBow down before your fishing master!"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nPokłońcie się przed królem wędkarstwa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nImpressive, isn't it?"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nImponująca, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It's more of a fall vest."
msgstr "Bardziej nadaje się na jesień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNKVEST_WINTER"
msgid "It's so hard to look fashionable in the winter."
msgstr "Ciężko ubrać się modnie zimą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_COOKED"
msgid "At least the mucus burned off."
msgstr "Przynajmniej śluz się wypalił."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_SUMMER"
msgid "Full of summer mucus."
msgstr "Pełna letniego śluzu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRUNK_WINTER"
msgid "The trunk thickens in the winter to hold more mucus."
msgstr "Trąba rozszerza się zimą, żeby pomieścić więcej śluzu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TUMBLEWEED"
msgid "Tumble on, weed."
msgstr "Kręć się z nami, kręć w kółeczko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_BADLANDS"
msgid "Turf."
msgstr "Gleba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_CARPETFLOOR"
msgid "That's a quality, high-pile carpet sample!"
msgstr "Wysokiej jakości długowłosy dywan!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TURF_CAVE"
msgid "Turf."
