msgstr "Nareszcie, porządny piekarnik!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTER_FOOD1"
