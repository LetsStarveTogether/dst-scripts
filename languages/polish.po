#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.GENERIC"
msgid "Do you think me too silly, %s?"
msgstr "Jestem dla ciebie zbyt głupiutki, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.GHOST"
msgid "Just a nibble? You don't need all that soul."
msgstr "Może chociaż gryza? Nie trzeba ci tyle tej duszy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.MURDERER"
msgid "Eep! I'm but a helpless imp!"
msgstr "Ojej! Ale ja jestem tylko bezbronnym chochlikiem!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA.REVIVER"
msgid "%s, you generous soul!"
msgstr "%s, tyś najszczodrzejszą z dusz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Hoohoohoo!"
msgstr "Ohohohohoho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "How hilarious!"
msgstr "Przezabawne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Ooohoohoo! The mortal learned magic!"
msgstr "Ooohoohoo! Śmiertelnicy nauczyli się magii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "Winding down, waning."
msgstr "Powoli gaśnie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Playtime's over!"
msgstr "Koniec zabawy!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Hoohoohoo!"
msgstr "Ohohohohoho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "How hilarious!"
msgstr "Przezabawne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Hyuyu. Mortals don't know magic."
msgstr "Hyuyu. Śmiertelnicy jednak nie nauczyli się magii."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Winding down, waning."
msgstr "Powoli gaśnie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "Playtime's over!"
msgstr "Koniec zabawy!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Hoohoohoo!"
msgstr "Ohohohohoho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "How hilarious!"
msgstr "Przezabawne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "It's sure to entertain our guests!"
msgstr "Nasi goście będą zachwyceni!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "Doesn't look too lively!"
msgstr "Coś niemrawo wygląda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Hoohoohoo!"
msgstr "Ohohohohoho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "How hilarious!"
msgstr "Przezabawne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "What a funny thing!"
msgstr "Co za osobliwa rzecz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Doesn't look too lively!"
msgstr "Coś niemrawo wygląda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERHAT"
msgid "It'll keep my horns warm."
msgstr "Pomoże mi ogrzać rogi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTEROMETER.BURNT"
msgid "I do suppose it's hot out today!"
msgstr "Odnoszę wrażenie, że całkiem dziś ciepło!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTEROMETER.GENERIC"
msgid "What do you say of the weather today?"
msgstr "I jakaż to pogoda czeka nas dzisiaj?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTFUEL"
msgid "Ah, are you the source of this magic?"
msgstr "Aha, to ty jesteś źródłem tej magii?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "It's nearly time."
msgstr "Już prawie gotowe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Just what are you cooking up?"
msgstr "Co tam się gotuje?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Culinary alchemy!"
msgstr "Kulinarna alchemia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "Oh ho! What magic conjured you up?"
msgstr "Oho! A co to za magia cię tak urządziła?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD1"
msgid "It looks like a little mortal! Hyuyu!"
msgstr "Wygląda jak mały śmiertelnik! Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD2"
msgid "I might try one today."
msgstr "Może odważę się dziś spróbować."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD3"
msgid "The children hang them on my horns."
msgstr "Dzieci wieszają takie na moich rogach."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD4"
msgid "How deliciously evil!"
msgstr "Co za zniewalające zło!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD5"
msgid "Mortal food shaped like a log! How silly."
msgstr "Śmiertelne pożywienie w formie pniaka! Jakże to niemądre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD6"
msgid "Hyuyu! The mortals liquefied these plums!"
msgstr "Hyuyu! Śmiertelnicy zupełnie upłynnili te śliwki!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD7"
msgid "I believe I can stomach liquids."
msgstr "Chyba mógłbym to wypić."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD8"
msgid "Maybe just a sip."
msgstr "Może mały łyczek."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_FOOD9"
msgid "I might try this mortal treat."
msgstr "Może spróbuję tego przysmaku śmiertelników."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENT"
msgid "Bibblity baublety boo."
msgstr "Taki tam rupieć."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Memories of a fun time."
msgstr "Pamiątka miłych chwil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "I remember when we played there!"
msgstr "Pamiętam, gdy się tam bawiliśmy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "Adornment from the land of goats!"
msgstr "Ozdoba z krainy kóz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "A light to shine bright in the night."
msgstr "Blask rozświetlający mroki nocy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.BURNING"
msgid "I don't think this is part of the festivities."
msgstr "Tego chyba nie było w planie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.BURNT"
msgid "This will make the mortals sad."
msgstr "Śmiertelnicy będą bardzo zasmuceni."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "So I just place the baubles right on it?"
msgstr "Wystarczy, że umieszczę na gałęziach bombki?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Mortal tradition says it's much too small."
msgstr "Według tradycji śmiertelników jest wciąż za małe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "This will make the mortals sad."
msgstr "Śmiertelnicy będą bardzo zasmuceni."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "A tree is meant to be inside."
msgstr "Brakuje nam teraz wyłącznie drzewka."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_DEN"
msgid "Even crustaceans need a place to sleep now and den."
msgstr "Każdy skorupiak o dobrej porze zapada w sen w swojej własnej norze."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_MOONGLASS"
msgid "That will be a hard shell to crack, hyuyu!"
msgstr "To będzie twardy pancerz do zgryzienia, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER"
msgid "Hyuyu, it's a creature I shelldom care to sea!"
msgstr "Hokus pokus, czary mary, chciałbym spotkać nocomary!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "It is quite thoroughly dead."
msgstr "Jest całkowicie martwy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Oh dear, the best part's already gone."
msgstr "Ojej, najlepszej części już nie ma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYBIG.1"
msgid "Hyuyu! I must say, she's growing on me!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYBIG.2"
msgid "Hyuyu! I must say, she's growing on me!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYSMALL.1"
msgid "Hello, my small furry friend!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOBYSMALL.2"
msgid "Hello, my small furry friend!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.ATTACKER"
msgid "Hoohoo, %s knows how to throw a punch!"
msgstr "Ohohoho! %s potrafi mocno przywalić!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Hyuyu, %s is so funny!"
msgstr "Hyuyu! %s jest przezabawny!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.GENERIC"
msgid "Hello, hello my giant friend!"
msgstr "Witaj, witaj, mój gigantyczny przyjacielu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.GHOST"
msgid "Can I just get a taste?"
msgstr "Mogę spróbować?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.MURDERER"
msgid "%s, you've got a taste for souls!"
msgstr "A więc zasmakowałeś w duszach, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOLFGANG.REVIVER"
msgid "What a sweet soul %s is!"
msgstr "Jakże to miłe, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.ATTACKER"
msgid "I'll stop hiding your axe, promise! Hyuyu!"
msgstr "Przestanę chować twoją siekierę, przysięgam! Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVER"
msgid "Hyuyu, you're so funny, %s!"
msgstr "Hyuyu, ale jesteś zabawny, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "What a funny soul! I wonder what it tastes like."
msgstr "Przezabawna dusza! Ciekaw jestem, jak smakuje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.FIRESTARTER"
msgid "%s has been a bit of a prankster!"
msgstr "%s to dopiero dowcipniś!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GENERIC"
msgid "That axe of his sure can tell a joke."
msgstr "Ta jego siekiera to dopiero zna się na żartach."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GHOST"
msgid "You wouldn't even noticed if I took a bite."
msgstr "Nawet byś nie zauważył, gdybym kawałek ugryzł."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSE"
msgid "What's got your feathers in a bunch? Hyuyu!"
msgstr "Co tak stroszysz piórka? Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Do goose souls taste like chicken?"
msgstr "Czy dusza gęsi smakuje jak kurczak?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSE"
msgid "The curse is growing, your antlers are showing!"
msgstr "Ta klątwa to nie żart błogi, naprawdę rosną ci rogi!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "You wouldn't mind if I sneak a bite, would you?"
msgstr "Nie będziesz miał nic przeciwko, jeśli uszczknę sobie gryzka?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.MURDERER"
msgid "Don't kill me, hyuyuyu!"
msgstr "Nie morduj mnie, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WOODIE.REVIVER"
msgid "%s is oh so helpful!"
msgstr "Och, %s! To wielce pomocne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.DIRT"
msgid "A simple pile of dirt and muck."
msgstr "Zwykła kupka ziemi i błota."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.PLANT"
msgid "The shimmer of a soul lurks below."
msgstr "W otchłani wyczuwam delikatny blask duszy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORM.WORM"
msgid "Hyuyu! What do I do??"
msgstr "Hyuyu, co zrobię tu?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like it could be my ride!"
msgstr "Chyba mógłbym się tędy zabrać!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE.OPEN"
msgid "Watch my impression of mortal food."
msgstr "Oto, co myślę o pożywieniu śmiertelników."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMHOLE_LIMITED"
msgid "I think its throat is getting sore."
msgstr "Chyba zaczyna drapać mnie w gardle."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT"
msgid "A glowing fruit. I am astute."
msgstr "Owoc, który lśni. Chyba mi się śni."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_LESSER"
msgid "This glowy fruit is going bad."
msgstr "Świecący owoc zaczyna się psuć."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMLIGHT_PLANT"
msgid "The shimmer of a soul lurks below."
msgstr "W otchłani wyczuwam delikatny blask duszy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.ATTACKER"
msgid "What a cruel trick you've played! Hyuyu!"
msgstr "A to okrutny psikus! Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "Ooo, there's an ember of fun in you yet."
msgstr "Oho, widzę, że iskierka dobrej zabawy jeszcze w tobie nie zgasła!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GENERIC"
msgid "Heard any good jokes lately, %s?"
msgstr "%s, znasz jakieś dobre dowcipy?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.GHOST"
msgid "Finally, a break from his poop jokes."
msgstr "Wreszcie chwila oddechu od ciągłych żartów o kupie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.MURDERER"
msgid "You've really gone and dung it this time, hyuyu!"
msgstr "Tym razem sobie nawarzyłeś piwa, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is just too kind a soul, I suppose."
msgstr "%s ma naprawdę dobrą duszyczkę."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.ATTACKER"
msgid "Hey! What's with that impish grin?"
msgstr "Hej! Co to za psikusy?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Hyuyu! What pranks have you been playing?"
msgstr "Hyuyu! Jakież to psikusy robisz?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GENERIC"
msgid "Oh! What a handsome devil."
msgstr "Och, ależ przystojny diaboł!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.GHOST"
msgid "Are you gonna eat that?"
msgstr "Czyżby bufet był już otwarty?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.MURDERER"
msgid "He's stealing all the good souls!"
msgstr "Kradnie wszystkie dobre dusze!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX.REVIVER"
msgid "Hyuyu, I would have eaten that soul were I you."
msgstr "Hyuyu, na twoim miejscu zjadłbym tę duszę."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX_SOUL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WORTOX_SOUL"
msgid "Hyuyu! It looks tasty."
msgstr "Hyuyu! Wygląda apetycznie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.ATTACKER"
msgid "%s has a fiendish look in her eye."
msgstr "%s ma w oku szatański błysk."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.FIRESTARTER"
msgid "Hyuyuyu, brilliant!"
msgstr "Hyuyuyu, wyśmienicie!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GENERIC"
msgid "Gotten into any trouble yet today, %s?"
msgstr "%s, zdarzyło ci się ostatnio wpaść w jakieś tarapaty?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.GHOST"
msgid "Don't fret, I won't eat you!"
msgstr "Nie bój żaby, przecież cię nie zjem!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.MURDERER"
msgid "Surely we can sort this out, imp to shrimp?"
msgstr "Na pewno możemy się jakoś dogadać, jak chochlik z płazem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WURT.REVIVER"
msgid "You have a good soul, %s. I promise not to eat it."
msgstr "Masz dobrą duszę, %s. Obiecuję, że jej nie zjem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.ATTACKER"
msgid "Hoohoo, I'll stop grinding your gears! Promise!"
msgstr "Ohohoho! Obiecuję, że przestanę cię drażnić!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.FIRESTARTER"
msgid "Ooo, the tin can has a sense of humor!"
msgstr "No proszę! Ta puszka ma poczucie humoru!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GENERIC"
msgid "Hyuyu %s, do you have an off button?"
msgstr "Hyuyu %s! Gdzie masz wyłącznik?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.GHOST"
msgid "Not so soulless after all, hyuyu!"
msgstr "Wcale nie jesteś taki bezduszny, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.MURDERER"
msgid "Don't kill the poor little imp!"
msgstr "Nie morduj biednego chochlika!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78.REVIVER"
msgid "What a kind and noble deed!"
msgstr "Cóż to za dostojny i zacny czyn!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWAMULET"
msgid "I'll give my brain a slight refrain."
msgstr "Pozwolę mojemu mózgowi chwilę odpocząć."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWGEM"
msgid "From lava floes bellow this glimmering yellow."
msgstr "Blask niczym od rzek lawy bijący."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWMOONEYE"
msgid "To make our mark once we embark."
msgstr "Pozostawimy po sobie jakiś ślad dzięki tobie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YELLOWSTAFF"
msgid "It calls the sun from out the sky!"
msgstr "Przyzywa słońce wprost z niebios!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Well, that's that."
msgstr "To już jest koniec, nie ma już nic."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "What is it you need? Perhaps carrots and seeds?"
msgstr "Czego ci trzeba? Może marchewek i nasion?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "Hyuyu, I know a trickster when I see one!"
msgstr "Hyuyu, z daleka potrafię rozpoznać żartownisia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "That prank went a bit too far."
msgstr "Ten psikus troszkę się wymknął spod kontroli."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "North, South, East, West, your sense of direction we'll put to the test!"
msgstr "Północ, południe, wschód, zachód, kto zgubi drogę, ten idzie do piachu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "Clever creature."
msgstr "Sprytne stworzonko."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "Troszkę trzeba pogłówkować, by myszomarchew wytrenować!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "That prank went a bit too far."
msgstr "Ten psikus troszkę się wymknął spod kontroli."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "I just wanted to see how you'd react, hyuyu!"
msgstr "Chciałem tylko zobaczyć, jak zareagujesz, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "Your reflexes are quite good, for a vegetable."
msgstr "Masz naprawdę dobry refleks, jak na warzywo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "Troszkę trzeba pogłówkować, by myszomarchew wytrenować!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "That prank went a bit too far."
msgstr "Ten psikus troszkę się wymknął spod kontroli."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "Spin, spin, spin the wheel of fate!"
msgstr "Kręć, kręć kołem fortuny!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "You're getting fast, indeed!"
msgstr "Robisz się naprawdę szybka!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "Troszkę trzeba pogłówkować, by myszomarchew wytrenować!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "That prank went a bit too far."
msgstr "Ten psikus troszkę się wymknął spod kontroli."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "My, that looks strenuous."
msgstr "O mamo, to wygląda jak niezła katorga."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Such determination for one so small!"
msgstr "Taka mała, a taka zawzięta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "A bit of this, a bit of that, all to train my dear Carrat!"
msgstr "Troszkę trzeba pogłówkować, by myszomarchew wytrenować!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "I make a point of checking checkpoints, hyuyu."
msgstr "Sprawdzenie punktów kontrolnych stawiam sobie za punkt honoru, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "Mark the way!"
msgstr "Wskaż drogę!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "How silly!"
msgstr "Ale głupio!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "Surely the cleverest will win."
msgstr "Z pewnością wygra najsprytniejsza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "We won with wit and cunning (and a little bit of running)."
msgstr "Wygraną zapewnił nam spryt nie do okiełznania (i trochę biegania)."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} put us to the test, and it turns out they're the best."
msgstr "{winner} nas testuje i pierwsze miejsce wnet zajmuje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "Where to put the finish line..."
msgstr "Gdzie by umieścić linię mety..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Hyuyu, what fun!"
msgstr "Hyuyu, ale zabawa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Let the races begin!"
msgstr "Niech rozpocznie się wyścig!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Hyuyu, what fun!"
msgstr "Hyuyu, ale zabawa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I think we can do better than that."
msgstr "Myślę, że stać nas na więcej."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "A veritable virtuoso of a vegetable!"
msgstr "Wspaniała, warzywna wirtuozeria!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "I hope I get a high score, hyuyu!"
msgstr "Liczę na dobry wynik, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "To win the race, I need a Carrat that can keep up the pace!"
msgstr "Żeby myśleć o wygranej, potrzebuję marchwi żwawej!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET"
msgid "A packet of seeds, to do with as I please."
msgstr "Paczka nasion - co z nią zrobię? Biada temu, kto się dowie!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Perhaps it contains magic beans? Hyuyu!"
msgstr "Może są tam magiczne fasolki? Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD1"
msgid "I'll take a little tiny nibble."
msgstr "Skubnę malutki kawałeczek."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD2"
msgid "I'll try it, if you insist."
msgstr "Spróbuję, skoro nalegasz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD3"
msgid "Maybe just a little bite."
msgstr "Może tylko mały gryz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_GENERIC"
msgid "Ooo, a mystery!"
msgstr "Oooch, tajemnica!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_SMOLDERING"
msgid "Some fiery fun is about to begin!"
msgstr "Płomienna tajemnica rozwija się, by zachwycać!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_TOODARK"
msgid "I can't see the physical plane!"
msgstr "Patrzę, lecz nie widzę tego padołu!"

#. STRINGS.CHARACTERS.WORTOX.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WORTOX.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "Doing that hurt my feelings."
msgstr "To rani me uczucia."

#. STRINGS.CHARACTERS.WORTOX.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.EAT_FOOD.WINTERSFEASTFUEL"
msgid "Hyuyu, how fun!"
msgstr "Hyuyu, ale zabawa!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_LOSE"
msgid "Oh dear."
msgstr "O rany."

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Well it's not raw! Hyuyu!"
msgstr "Przynajmniej posiłek nie jest już surowy! Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "That was nothing! Nothing!"
msgstr "Nicość! Nicość!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_WIN"
msgid "Must be off now!"
msgstr "To już chyba po wszystkim!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Grrr... want in!"
msgstr "Grrr... Chcę wejść!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "Feel bad ... do later."
msgstr "Źle się czuję... zrobię to później."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "Water hot enough, florp."
msgstr "Woda już dostatecznie gorąca, florp."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "Water too hard."
msgstr "Woda za twarda."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.BUILD.HASPET"
msgid "Don't need 'nother pet, glort."
msgstr "Nie potrzebuję innego zwierzątka, glort."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.BUILD.MOUNTED"
msgid "Grrr, can't reach!"
msgstr "Grrr, nie sięgam!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Nope!"
msgstr "Nie!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "Don't wanna, florp."
msgstr "Nie chcę, florp."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Gotta wait..."
msgstr "Muszę zaczekać..."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.COMPARE_WEIGHABLE.TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.COMPARE_WEIGHABLE.TOO_SMALL"
msgid "Glurph... this fish too small!"
msgstr "Glurp... ta ryba jest za mała!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "Need some buildy things."
msgstr "Potrzebuję jakichś rzeczy do budowania."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Grrr, have to wait."
