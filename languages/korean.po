msgid "Home sweet home, eh?"
msgstr "홈 스위트 홈이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Just rocks, now."
msgstr "이제는 돌이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Not quite maple."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO"
msgid "That's a nice looking tomato."
msgstr "좋은 토마토잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Heartburn city."
msgstr "가슴아픈 도시잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "새로운 농작물종자로 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Hey there!"
msgstr "엉!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "How ya doin'?"
msgstr "잘 지내나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP"
msgid "From the community garden."
msgstr "공동체 정원에서 나왔잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooked real nice."
msgstr "요리가 잘 되었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "새로운 농작물종자로 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT"
msgid "Such a fancy shade of gold."
msgstr "고급스런 금색이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "새로운 농작물종자로 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.GENERIC"
msgid "Dang ground squirrels..."
msgstr "제기랄 땅 다람쥐..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.HELD"
msgid "I'd feel bad eating him."
msgstr "먹으면 미안하겠지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.GENERIC"
msgid "I doubt there are trees down there."
msgstr "아래에 나무가 없겠지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.SPRING"
msgid "Nothing going in or out."
msgstr "들어가는 거나 나가는 게 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Is it roasted carrot flavoured?"
msgstr "구운 당근 맛인가?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Is it carrot flavoured?"
msgstr "당근 맛인가?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINCOAT"
msgid "For chopping in the rain."
msgstr "빗속에서 도끼질할 때 쓰잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINHAT"
msgid "Always keep a dry head while chopping."
msgstr "자를 때는 언제나 머리가 젖지 않게 해야 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.BURNT"
msgid "Its knowledge of rain didn't keep it from being burned."
msgstr "비에 대한 지식이 타는 걸 방지하지 않았잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.GENERIC"
msgid "Rain makes the trees grow."
msgstr "비오면 나무가 자라지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RATATOUILLE"
msgid "It's like a forest in a bowl."
msgstr "사발 안의 숲같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAZOR"
msgid "A true lumberjack never shaves."
msgstr "진짜 벌목꾼은 면도하지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDGEM"
msgid "I see within it the fiery death of a thousand trees."
msgstr "수천 그루의 나무가 불타는 죽음이 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDLANTERN"
msgid "This little light of mine."
msgstr "나의 작은 빛이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDMOONEYE"
msgid "A true woodsman knows his own way around the forest."
msgstr "진정한 나무꾼은 숲에서 길을 잘 찾잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDPOUCH"
msgid "It's Lucy-colour."
msgstr "루시의 색이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP"
msgid "I don't know..."
msgstr "모르겠잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP_COOKED"
msgid "You'd have to be really, really hungry."
msgstr "정말 배불러야 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a red mushroom."
msgstr "빨간 버섯이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "They have their own schedule."
msgstr "자기 스케줄이 있는 놈이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "I'll have to be patient."
msgstr "인내심을 가져야 하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.BURNING"
msgid "Fire makes me nervous."
msgstr "불 보면 불안해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.GENERIC"
msgid "Reeds."
msgstr "갈대."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.PICKED"
msgid "They'll be back."
msgstr "돌아오겠지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REFLECTIVEVEST"
msgid "I'm still not convinced plaid isn't all-weather wear."
msgstr "플래드가 전천후 의류가 아니라고 하는 말은 믿을 수 없어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RELIC"
msgid "I don't plan on fixin' that."
msgstr "고칠 생각이 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.BURNT"
msgid "How did it get burned?!"
msgstr "어떻게 탄 거지?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I don't trust all this science stuff."
msgstr "과학은 믿을 수 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Well, it obeys some basic laws of physics."
msgstr "기본 물리 법칙을 따르는 것 같긴 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "This is getting strange."
msgstr "이상해지고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Nope, lost it."
msgstr "음, 사라졌잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "Okay, I kind of get it now."
msgstr "아, 이제 알겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "This is why I don't use hat warmers."
msgstr "이래서 내가 모자 보온기를 안 쓰잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I like to call it the \"Hat Machine\"!"
msgstr "\"모자 기계\"라고 부를 수 있잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "That's a shame, that."
msgstr "안타깝잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "All my buddies could be improved with wood."
msgstr "모든 친구들이 나무로 더 좋아질 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTONE"
msgid "I don't know if I should touch that."
msgstr "만져야 할지 모르겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REVIVER"
msgid "I need to share this with somebody!"
msgstr "이것을 누군가와 공유해야겠잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.GENERIC"
msgid "What a snotty little jerk."
msgstr "추잡한 못된 놈."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.HELD"
msgid "Don't get comfortable, birdie."
msgstr "편하게 있지 마."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "Go fly south or something!"
msgstr "남쪽으로 날아가던가 해라!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's stealing my warmth."
msgstr "내 온기를 빼앗고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET"
msgid "They're trapped!"
msgstr "갇혔잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK"
msgid "I could break it down if I tried hard enough."
msgstr "노력하면 부술 수 있어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKS"
msgid "Could make a decent little inukshuk with these."
msgstr "괜찮은 이눅슈크가 되겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKY"
msgid "Lobster supper time!"
msgstr "바닷가재 저녁 시간!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Home sweet home!"
msgstr "집이 최고잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.MELTED"
msgid "Back home, they never melt."
msgstr "고향에서는 안 녹잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE_MELTED"
msgid "Back home, they never melt."
msgstr "고향에서는 안 녹잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "It's looking a tad crusty."
msgstr "껍질이 느껴지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.LOW"
msgid "Needs more... wood?"
msgstr "나무가 더... 필요한가?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "A fire that needs no wood? Unnn-natural!"
msgstr "나무가 필요 없는 불? 부자연스럽잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks like it could break."
msgstr "부서질 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON"
msgid "It's uh, a moon rock."
msgstr "음, 달돌이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "So... senseless."
msgstr "아주... 무의미하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "So... senseless."
msgstr "아주... 무의미하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK"
msgid "Hmm... does the rook move in a straight line? I forget."
msgstr "흠... 루크가 직선으로 움직이던가? 까먹었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK_NIGHTMARE"
msgid "The gears are spilling out."
msgstr "기어가 튀어나고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROPE"
msgid "Good for holding stuff to other stuff."
msgstr "물건 묶을 때 쓰잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROTTENEGG"
msgid "One less bird. Good."
msgstr "새 한 마리 줄었잖아. 좋지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROYAL_JELLY"
msgid "I'm majestic enough as is."
msgstr "난 이미 충분히 제왕적이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE"
msgid "Broken furniture."
msgstr "부서진 가구잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINSHAT"
msgid "It's no toque, but it'll do."
msgstr "토크는 아니지만 쓰자."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_BAT"
msgid "Metal on a stick."
msgstr "막대기에 달린 금속이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_RUBBLE"
msgid "All busted up."
msgstr "다 망가졌잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "It makes my beard hair stand on end."
msgstr "내 수염이 곤두설 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It's thinkin' real hard."
msgstr "골똘히 생각하고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLEHORN"
msgid "Puts the critter back to how nature intended."
msgstr "자연의 섭리를 따르게 만들잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_BASIC"
msgid "Yep, that'll get us there."
msgstr "이거면 갈 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_RACE"
msgid "Makes me feel like some sorta woodland nymph, eh?"
msgstr "내가 숲의 요정이 된 것 같잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_WAR"
msgid "Makes me feel like a Mountie."
msgstr "기사가 된 느낌이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SALTLICK"
msgid "My mouth's dry just looking at it."
msgstr "보는 것만으로도 입에 마르잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDBLOCK"
msgid "Some good craftsmanship."
msgstr "뛰어난 장인의 실력이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDSPIKE"
msgid "That's something else, eh?"
msgstr "뭔가 다르잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.ACTIVE"
msgid "Something is off aboot that rock, eh?"
msgstr "바위가 이상하지, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.INACTIVE"
msgid "That makes sense."
msgstr "말 되잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.BURNING"
msgid "Aw! He barely had a chance!"
msgstr "오! 기회를 박탈당했잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "병 걸렸잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASING"
msgid "A poor excuse for wood."
msgstr "망가진 나무잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.GENERIC"
msgid "I want to see it grow so I can chop it down."
msgstr "크는 걸 본 다음에 잘라야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.PICKED"
msgid "Picking isn't as fun as chopping."
msgstr "따는 건 자르는 것만큼 재밌지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.WITHERED"
msgid "With this heat it'll never grow to chopping size!"
msgstr "이 열 때문에 자를 수 있을 정도로 자라지 않잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNING"
msgid "Glad that's not me."
msgstr "내가 아닌 게 다행이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNT"
msgid "Great, now those feathered hosers are gonna run wild."
msgstr "이제 깃털 짜식들이 난리치겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.GENERIC"
msgid "He's doing the world a service."
msgstr "세계를 돕고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCORCHED_SKELETON"
msgid "Yikes."
msgstr "앗."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "I'm really more of a whittler."
msgstr "나는 베는 게 전문이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Back to whittling."
msgstr "베는 걸로 돌아가자."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Oughta put a block of cut stone up there."
msgstr "자른 돌을 놔야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Hm. Not bad, eh?"
msgstr "흠. 나쁘지 않잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "I don't get art. Whattaya think Lucy?"
msgstr "난 미술 모르잖아. 어떻게 생각해, 루시?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Whose bright idea was it to fix this thing?"
msgstr "누가 이걸 고친다고 했냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "돌이 그렇게 움직이는 것이 맞나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Creepy."
msgstr "소름 끼치잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "That doesn't seem right."
msgstr "틀린 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Once you've seen one weird statue, you've seen'em all."
msgstr "일단 이상한 조각상 하나를 보면 다 본 것이나 마찬가지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Just needed a little duct tape."
msgstr "청테이프가 좀 필요했을 뿐이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "돌이 그렇게 움직이는 것이 맞나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "Yikes. Put it back in."
msgstr "앗. 되돌려 놔야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That's a heavy lookin' hoser."
msgstr "무거워 보이는 짜식이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Just a big hunk of stone, as far as I'm concerned."
msgstr "나한텐 큰 돌일 뿐이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "As if I didn't have enough reasons to hate full moons."
msgstr "만월을 싫어할 이유가 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "돌이 그렇게 움직이는 것이 맞나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Looks a bit like one of them chargin' hosers."
msgstr "공격하는 짜식으로 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Just a big hunk of marble, that."
msgstr "그냥 큰 대리석이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS"
msgid "Not trees."
msgstr "나무가 아냐."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS_COOKED"
msgid "We call this \"lumberjack surprise\"."
msgstr "\"벌목꾼의 깜짝선물\"이라고 부르잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SENTRYWARD"
msgid "That's an odd looking tree."
msgstr "이상해 보이는 나무잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_KIT"
msgid "I'm pretty good at sewing."
msgstr "내가 바느질 잘 하지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_TAPE"
msgid "Makes me feel right at home."
msgstr "집에 온 느낌을 주잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWDIGGER"
msgid "Are your little buddies, uh... alive?"
msgstr "친구들... 살아있나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWHEART"
msgid "Yeesh. Don't get that near me."
msgstr "읏. 가까이 가져오지 마."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHOVEL"
msgid "Dig a hole. Plant a tree!"
msgstr "구멍을 판다. 나무를 심는다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHROOM_SKIN"
msgid "That's gross."
msgstr "추잡하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.BURNT"
msgid "It's a husk."
msgstr "깍지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Naps are important during a long day of chopping."
msgstr "도끼질 하루 종일 할 때는 낮잠이 중요하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SILK"
msgid "Spiders give me the willies."
msgstr "거미는 오싹해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON"
msgid "Sorry, friend."
msgstr "미안해, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETONHAT"
msgid "That right there's a cursed object, eh?"
msgstr "저주 받은 물체잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "Poor %s. I should watch out for %s, eh?"
msgstr "불쌍한 %s. %s을(를) 조심해야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "Poor %s. %s got her, eh?"
msgstr "불쌍한 %s. %s이(가) 죽인 거잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "Poor %s. %s got him, eh?"
msgstr "불쌍한 %s. %s이(가) 죽인 거잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "Poor %s. %s got them, eh?"
msgstr "불쌍한 %s. %s이(가) 죽인 거잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKETCH"
msgid "Some plans for a fancy stone carving."
msgstr "멋진 돌 조각에 대한 몇 가지 계획이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKULLCHEST"
msgid "That's scary!"
msgstr "무시무시하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLEEPBOMB"
msgid "Some folks around here could use the shuteye."
msgstr "자면 좋은 것들이 여기에 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER"
msgid "I think it's living hair."
msgstr "살아있는 털 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPERPELT"
msgid "Where's the nearest fur trader?"
msgstr "근처에 가죽 상인이 어디에 있지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER_PELT"
msgid "Looks like a dead beaver."
msgstr "죽은 비버 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE"
msgid "He's just misunderstood."
msgstr "그냥 오해 받는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHAT"
msgid "That could sure keep a noggin safe."
msgstr "머리를 보호하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHOLE"
msgid "Are you guys doing okay in there?"
msgstr "여기서 잘 지내냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLESLIME"
msgid "Someone needs a tissue."
msgstr "화장지가 필요하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "His home is broken now. Oh."
msgstr "집이 망가졌잖아. 엉."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.GENERIC"
msgid "What do you want?"
msgstr "뭘 원하냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "It wants something."
msgstr "뭔가 원하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.STARVING"
msgid "I think it's starving."
msgstr "굶고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT"
msgid "I wish this were bigger."
msgstr "더 컸으면 좋겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT_DRIED"
msgid "Just a bite."
msgstr "한 입만."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPPER"
msgid "Keep them chompers to yourself."
msgstr "입질하지 마라."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNURTLE"
msgid "Spirals!"
msgstr "나선!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPAT"
msgid "Reminds me of momma!"
msgstr "엄마가 생각나는구나!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR"
msgid "It lacks the heft of a good solid axe."
msgstr "묵직한 게 좋은 도끼 같지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR"
msgid "I'd take a stab at it."
msgstr "찔러 봐야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE"
msgid "I could give it a whirl."
msgstr "써봐야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Who needs a spear when you got ol'Luce?"
msgstr "루시가 있는데 무슨 창이 필요하냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD"
msgid "Good!"
msgstr "좋잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.GENERIC"
msgid "That's the biggest spider I've ever seen!"
msgstr "본 거미 중에서 가장 크잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.SLEEPING"
msgid "Careful, now, eh?"
msgstr "조심해야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERDEN"
msgid "Holy Mackinaw! Look at that thing!"
msgstr "으앗! 저걸 봐라!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDEREGGSACK"
msgid "Why would I want to carry that around?"
msgstr "저걸 왜 들고 다녀?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERGLAND"
msgid "I think it's poison."
msgstr "독이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHAT"
msgid "She's a real beaut, ain't she?"
msgstr "진짜 예쁘지, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE"
msgid "I should skedaddle before they come out of there."
msgstr "다시 나오기 전 내빼야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE_ROCK"
msgid "I should skedaddle before they come out of there."
msgstr "다시 나오기 전 내빼야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEEN"
msgid "You're not MY queen!"
msgstr "넌 내 여왕이 아니잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_DROPPER"
msgid "They're smart to live away from the corruption."
msgstr "부패한 곳을 피해 사는 것이 현명하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_HIDER"
msgid "Tricky devil!"
msgstr "간사한 악마!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_SPITTER"
msgid "Spitting is rude!"
msgstr "침 뱉는 것은 무례하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Great!"
msgstr "좋아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "They come in yellow now?"
msgstr "이제 노란색도 있잖아?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "You're snoozin' fer a bruisin'."
msgstr "맞을려고 잠자잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPOILED_FOOD"
msgid "Aw, it's Diefenbakered."
msgstr "디펜베이커 꼴이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "A floating red pinecone!"
msgstr "떠 있는 빨간 솔방울이잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "One day this might be a tree."
msgstr "언젠가는 나무가 되겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "We've been visited by a forest sprite, Lucy!"
msgstr "숲의 요정이 방문했잖아, 루시!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.HELD"
msgid "One day this might be a tree."
msgstr "언젠가는 나무가 되겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.GENERIC"
msgid "A flying green pinecone!"
msgstr "나는 녹색 솔방울이잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.HELD"
msgid "One day this might be a tree."
msgstr "언젠가는 나무가 되겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFCOLDLIGHT"
msgid "At least it won't start a forest fire."
msgstr "적어도 산불을 시작하지 않을 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFLIGHT"
msgid "Well ain't that something."
msgstr "신기하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFF_TORNADO"
msgid "I prefer to chop the trees myself."
msgstr "나무는 내가 자르는 걸 선호하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.AWAKE"
msgid "I really wish I hadn't seen that."
msgstr "정말 못 봤으면 좋겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.HIDING"
msgid "Not my style."
msgstr "내 스타일이 아니잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE"
msgid "I'm not too interested in rocks."
msgstr "바위에는 별로 관심 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL"
msgid "I'm not too interested in rocks."
msgstr "바위에는 별로 관심 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER"
msgid "It's a walking anatomy lesson."
msgstr "걸어 다니는 해부학 수업이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_ATRIUM"
msgid "That fuel stuff's gone to its head."
msgstr "연료가 머리에 영향을 주었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_MINION"
msgid "Ain't no reason for that to exist."
msgstr "존재할 이유가 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "It had some cool things inside, eh?"
msgstr "안에 멋진 게 있었잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "That's a curious statue, eh?"
msgstr "이상한 조각상이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEHARP"
msgid "You lost your head, eh?"
msgstr "머리를 잃었나, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEMAXWELL"
msgid "I'm gonna make fun of him for this later, eh?"
msgstr "나중에 놀려야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "She's a real tall one, eh?"
msgstr "정말 키 크잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "I'm not sure I get it."
msgstr "이해 못 하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Could make a nice planter outta that."
msgstr "좋은 화분을 만들 수 있겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL"
msgid "That'll put the shine back on yer axe."
msgstr "도끼를 다시 빛나게 해주겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STINGER"
msgid "Ouch! It's pointy."
msgstr "앗! 뾰족하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STRAWHAT"
msgid "It'll keep the sun off yer head."
msgstr "해를 가려 주잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STUFFEDEGGPLANT"
msgid "I'm getting better at cooking."
msgstr "요리 실력이 늘고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PICKED"
msgid "There's a lot of water in there for such a tiny plant."
msgstr "작은 식물인데 물이 많이 들어있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PLANT"
msgid "That's a plant, eh?"
msgstr "식물이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_POTTED"
msgid "Ain't a tree, but ain't bad."
msgstr "나무가 아니지만, 나쁘지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKBOAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKBOAT"
msgid "That wood has seen better days."
msgstr "저 나무도 좋은 시절이 있었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEATERVEST"
msgid "It's not plaid, but it'll do."
msgstr "플래드는 아니지만 입겠어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TAFFY"
msgid "Sugary good."
msgstr "설탕이 잔뜩 들어서 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRD"
msgid "I don't trust birds that can't fly, either."
msgstr "나도 나는 새는 믿지 못하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG"
msgid "What's in here?"
msgstr "안에 뭐가 들었지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It tastes like justice."
msgstr "정의의 맛이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Too cold for you?"
msgstr "너에겐 너무 춥나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "It's hatching."
msgstr "부화하고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Is it crying?"
msgstr "울고 있나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "Birds are never prompt."
msgstr "새는 시간을 안 지키잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Anytime now."
msgstr "빨리."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "I should steal its egg to teach it a lesson."
msgstr "알을 훔쳐서 혼내 줘야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Nothing there."
msgstr "아무 것도 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.GENERIC"
msgid "It's growing up to be a jerk, just like its parents."
msgstr "그 부모처럼 커서 못된 놈이 되려고 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Are you ALWAYS hungry?"
msgstr "넌 언제나 배고프냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.STARVING"
msgid "It getting wild with hunger."
msgstr "배고파서 사나워지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.GEMS"
msgid "Needs gems, eh?"
msgstr "보석이 필요하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.VALID"
msgid "It's ready, but am I?"
msgstr "그건 준비됐는데, 나도 준비됐나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "Ready to go, eh?"
msgstr "준비됐나, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "It's a... magic thing, I think."
msgstr "마법... 물건이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "There are bits missing, eh?"
msgstr "부품이 없잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "It's almost ready, eh?"
msgstr "거의 됐잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BOX"
msgid "Box-y, eh?"
msgstr "상자, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_CRANK"
msgid "Crank-y, eh?"
msgstr "크랭크, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_POTATO"
msgid "Potato-y, eh?"
msgstr "감자, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_RING"
msgid "Ring-y, eh?"
msgstr "고리, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELESTAFF"
msgid "I wonder what this thing does."
msgstr "이게 뭘 하는 것일까."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.BURNT"
msgid "I don't think it can still be considered a tent."
msgstr "이젠 천막이 아니잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.GENERIC"
msgid "I'm used to sleeping in worse."
msgstr "더 허름한 곳에서 많이 잤지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE"
msgid "There a squid down there?"
msgstr "아래에 오징어 있나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPIKE"
msgid "It wobbles when you wave it."
msgstr "흔들면 휘어지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPOTS"
msgid "I'm blushing!"
msgstr "얼굴 빨개진다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_GARDEN"
msgid "I'm tired of these squids!"
msgstr "오징어, 짜증나잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR"
msgid "It's so big!"
msgstr "엄청 크잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Are those squid babies?"
msgstr "오징어 아기인가?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Not even a stump left behind!"
msgstr "그루터기도 안 남았잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE"
msgid "It's the wood of the caves!"
msgstr "동굴의 나무잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE_PIECES"
msgid "It's not wood but it'll do."
msgstr "나무는 아니지만 쓸 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THURIBLE"
msgid "Someone's trying to give us a leg up."
msgstr "누군가 우리를 도와주려고 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.GENERIC"
msgid "I'm gonna need a bigger axe."
msgstr "더 큰 도끼가 필요하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.RAGE"
msgid "Alright, enough playin' around! Get'em Lucy!"
msgstr "장난은 이제 그만! 잡아라, 루시!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "It's a hole."
msgstr "구멍이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "It isn't polypore-sonal, I just gotta chop you."
msgstr "버섯이 싫은 건 아니고, 잘라야 되는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Is that how trees are born?"
msgstr "나무가 그렇게 태어나는 건가?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOPHAT"
msgid "It's too fancy."
msgstr "너무 고급이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TORCH"
msgid "Trees by torchlight."
msgstr "횃불 나무."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Get a move on."
msgstr "이동하는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Some sort of sandy transportation."
msgstr "모래가 많은 운송 수단이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "Time to get a move on."
msgstr "이동할 시간이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "S'got a powerful stink, eh?"
msgstr "강력한 악취를 풍기잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILMIX"
msgid "The perfect snack for a day of chopping."
msgstr "도끼질한 다음에 먹기 좋은 간식이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILS"
msgid "Mighty powerful right hook on that hoser."
msgstr "라이트 훅이 세잖아, 짜식."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRANSISTOR"
msgid "I won't even pretend to know how that works."
msgstr "어떻게 작동하는지 추측도 하기 싫잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP"
msgid "Work smarter, eh?"
msgstr "똑똑하게 살라고, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH"
msgid "This seems a bit rough."
msgstr "이건 좀 거칠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "That's not playing fair, eh?"
msgstr "정정당당하게 싸우는 게 아니잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.BURNT"
msgid "I guess wood does have a downside..."
msgstr "나무도 단점이 있긴 하잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.GENERIC"
msgid "Wood is so handy! Look at all the things you can make!"
msgstr "나무는 유용해! 수많은 걸 만들 수 있잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST_TRAP"
msgid "Something is not quite right aboot that chest."
msgstr "궤짝이 뭔가 수상하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREECLUMP"
msgid "You're asking for a good chop, bud."
msgstr "자기를 잘라 달라는 것이지, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREEGUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREEGUARD"
msgid "The forest spirits have been angered!"
msgstr "숲의 신령이 분노했잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_1"
msgid "I used to play that game."
msgstr "그 게임을 한 적이 있었지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_10"
msgid "Choppers for old folks."
msgstr "노인을 위한 까뀌."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_11"
msgid "Quiet, you!"
msgstr "조용히 해!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_12"
msgid "It's all withered."
msgstr "다 시들었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_13"
msgid "She looks friendly."
msgstr "친구인 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_14"
msgid "Gaudy as all get-out."
msgstr "잡스럽잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_15"
msgid "And here I am just a pawn, eh?"
msgstr "내가 졸개라는 것이냐, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_16"
msgid "And here I am just a pawn, eh?"
msgstr "내가 졸개라는 것이냐, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_17"
msgid "It needs to be straightened, eh?"
msgstr "펴야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_18"
msgid "I would have liked this when I was a boy."
msgstr "내가 어렸으면 좋아했겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_19"
msgid "It keeps falling over, eh?"
msgstr "계속 쓰러지잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_2"
msgid "Much kazoo about nothing."
msgstr "허풍 치는 커주잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_20"
msgid "Wigfrid keeps using it to \"spar\" with me and Lucy. We're afraid."
msgstr "위그프리드가 나랑 루시하고 \"스파링\"할 때 쓰잖아. 무섭잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_21"
msgid "It belongs in a kitchen, not in the woods."
msgstr "숲이 아니라 부엌에 필요한 것이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_22"
msgid "I'd rather have some proper rope."
msgstr "제대로 된 밧줄이 더 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_23"
msgid "Maxwell probably needs that for his fancy shoes."
msgstr "맥스웰의 고급 구두에 필요한 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_24"
msgid "We should whip up some pumpkin cookies to put in it, eh?"
msgstr "안에 넣을 호박 쿠키를 만들어야 하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_25"
msgid "I already smell like pine and woodchips, according to Lucy."
msgstr "루시에 따르면 난 이미 소나무와 나뭇조각 냄새가 난다고 하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_26"
msgid "Genius! A cup for a proper woodsman."
msgstr "천재잖아! 진짜 나무꾼의 잔이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_27"
msgid "No point hanging clothes in the woods."
msgstr "숲에 옷을 걸 필요가 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_28"
msgid "That one moves diagonally, I think."
msgstr "대각선으로 이동하는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_29"
msgid "That's, uh, the rook piece."
msgstr "루크라고 하는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_3"
msgid "Reminds me of a story I heard once."
msgstr "전에 들었던 이야기가 생각나네."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_30"
msgid "That one can only move one square at time."
msgstr "한 번에 한 칸만 움직일 수 있는 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_31"
msgid "That's the, uh, horse piece."
msgstr "말 말이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_32"
msgid "I'd rather my future be a surprise."
msgstr "내 미래가 놀라운 것이 더 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_33"
msgid "Creepy."
msgstr "소름 끼치잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_34"
msgid "That right there's a bad time waitin' to happen."
msgstr "나쁜 일이 발생할 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_35"
msgid "Doesn't even have a label."
msgstr "라벨도 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_36"
msgid "More intimidating than beaver teeth."
msgstr "비버 이빨보다 더 흉악하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_37"
msgid "What a waste of wood, eh?"
msgstr "나무 낭비잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_38"
msgid "Looks like a pair of binoculars."
msgstr "쌍안경 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_39"
msgid "Oh, the gloves're comin' off now!"
msgstr "장갑이 벗겨지잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_4"
msgid "Wolfgang would appreciate that moustache."
msgstr "볼프강이 좋아할 콧수염이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_40"
msgid "It's a snail-shaped scale, eh?"
msgstr "달팽이 모양 저울이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_41"
msgid "Got no idea what that's for."
msgstr "뭔지 모르겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_42"
msgid "Better than meeting a real one, eh?"
msgstr "진짜와 만나는 것보다 낫잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_43"
msgid "Get along, lil gator."
msgstr "잘 지내야잖아, 작은 악어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_44"
msgid "Smashed to bits."
msgstr "조각났잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_45"
msgid "What sorta shows d'you think it gets?"
msgstr "무슨 쇼를 들려줄까?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_46"
msgid "I prefer to let mine air dry."
msgstr "난 공기로 말리잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_5"
msgid "It needs a robot arm, eh?"
msgstr "로봇 팔이 필요한 거야, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_6"
msgid "They're not good any more, eh?"
msgstr "더 이상 안 좋잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_7"
msgid "'Might take it to the kid."
msgstr "애들한테 주면 좋겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_8"
msgid "Reminds me... gotta convince Willow to take a *real* bath."
msgstr "생각났잖아... 윌로우 보고 진짜 목욕을 하라고 해야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_9"
msgid "I just sew my clothing shut around me when I put it on."
msgstr "착용하고 옷을 기워버리잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Nice and breezy."
msgstr "시원해서 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_WINTER"
msgid "This could stand up to the winters back home, eh?"
msgstr "고향 겨울도 견디겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_COOKED"
msgid "I think it boiled off all of the nose cheese."
msgstr "끓여서 콧물이 증발한 것 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_SUMMER"
msgid "It's pretty thin."
msgstr "꽤 얇잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_WINTER"
msgid "It's thick and hairy."
msgstr "두껍고 털 많잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUMBLEWEED"
msgid "I wish it was sturdier so I could chop it."
msgstr "더 튼튼하면 내가 자를 수 있을 텐데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_BADLANDS"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CARPETFLOOR"
msgid "Too classy for my tastes."
msgstr "나한텐 너무 고급이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CAVE"
msgid "Some ground."
msgstr "지면이야."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Looks like one of those city-people outhouses."
msgstr "도시 사람 화장실 바닥 같잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DECIDUOUS"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DESERTDIRT"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DIRT"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DRAGONFLY"
msgid "Fire doesn't quite take here, eh?"
msgstr "여긴 불 있어도 괜찮나, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FOREST"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS"
msgid "It's mushy, like peas."
msgstr "완두콩처럼 걸쭉하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_RED"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_GRASS"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MARSH"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MUD"
msgid "At least you don't have to clean it."
msgstr "적어도 치울 필요는 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROAD"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROCKY"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SANDY"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SAVANNA"
msgid "Just some ground, eh?"
msgstr "지면이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE"
msgid "I found this underground."
msgstr "지하에서 찾았잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK"
msgid "Rocks. Bleh."
msgstr "바위잖아. 별로."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR"
msgid "Flooring fit for a king!"
msgstr "제왕의 바닥재잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER"
msgid "Turkey day is here again!"
msgstr "칠면조 먹는 날이 돌아왔잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS"
msgid "Gotta keep that one from hiding, eh?"
msgstr "까 뒤집어야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Sorry!"
msgstr "미안하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT"
msgid "How terrible!"
msgstr "끔찍하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Another one!"
msgstr "하나 더!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "병 걸렸잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Choppin's choppin'."
msgstr "우지끈."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT"
msgid "With a little care, this could make fer some good choppin'."
msgstr "좀 신경 쓰면 잘 자를 수 있겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "One day it'll make good chopping."
msgstr "언젠가는 잘 팰 수 있겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD"
msgid "I'd be lucky to get two chops out of that thing."
msgstr "두 번도 못 패겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS"
msgid "I should build a tiny axe to chop these."
msgstr "이걸 자르려면 작은 도끼를 만들어야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA"
msgid "Something like that'd keep my beard dry, eh?"
msgstr "수염을 젖지 않게 해주잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI"
msgid "It'll fill ya up."
msgstr "날 채워주잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED"
msgid "It doesn't look safe."
msgstr "안전해 보이지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES"
msgid "I prefer flapjacks."
msgstr "난 플랩잭이 더 좋아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT"
msgid "Well that escalated quickly."
msgstr "금방 탔잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC"
msgid "You could sneeze it down."
msgstr "재채기하면 쓰러지겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM"
msgid "I could sneeze it apart."
msgstr "재채기하면 쓰러지겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK"
msgid "Looks nice'n'sturdy."
msgstr "튼튼해 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "It's not much use like that."
msgstr "이래서는 쓸모 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS"
msgid "Crumbling, but still secure, eh?"
msgstr "무너지고 있지만 안전하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM"
msgid "Heh, stoned again, eh?"
msgstr "또 돌 맞았나, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE"
msgid "Safe and secure, eh?"
msgstr "안전한가, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM"
msgid "Safe and secure, eh?"
msgstr "안전한가, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT"
msgid "I miss the old you."
msgstr "이전의 네 모습이 그립구나."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC"
msgid "I like the look of that!"
msgstr "좋잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM"
msgid "I like the look of that!"
msgstr "좋잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS"
msgid "Oh no. Walruses again!"
msgstr "안돼. 또 바다코끼리잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT"
msgid "My granddad wore a hat like that."
msgstr "할아버지께서 저런 모자를 썼지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "This won't be safe come winter."
msgstr "겨울이 되면 안전하지 않을 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Walruses are nearby, eh?"
msgstr "근처에 바다코끼리가 있잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK"
msgid "He had a cavity, eh?"
msgstr "충치 구멍 있었잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING"
msgid "Wood is the best at burning."
msgstr "나무는 타는 게 전문이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT"
msgid "Not so useful now, eh?"
msgstr "이제 유용하지 않잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC"
msgid "It's hard to stay neat and tidy in the woods."
msgstr "숲에서는 옷을 더럽힐 수 밖에 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG"
msgid "That thing could pull a sled by its lonesome."
msgstr "저건 혼자서도 썰매를 당길 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT"
msgid "Burned up."
msgstr "탔잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Gotta warm this doghouse up, eh?"
msgstr "개집을 데워야겠잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Nice and toasty."
msgstr "따뜻하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE"
msgid "Why are those bees so angry?"
msgstr "벌이 왜 화났냐?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON"
msgid "Could be fun times lobbin' these around."
msgstr "던지면 재밌겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON"
msgid "How can it be both water and melon?"
msgstr "어떻게 물이면서 멜론일 수 있지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT"
msgid "Well, points for creativity."
msgstr "엉, 창의성은 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE"
msgid "Wood AND food?!"
msgstr "나무와 식품?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED"
msgid "I'm not sure aboot grilled fruit..."
msgstr "구운 과일 맛은 믿음이 안 가..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS"
msgid "Maybe I could plant them?"
msgstr "심을 수 있겠지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s has raiding and looting on the brain..."
msgstr "%s은(는) 습격과 약탈만 생각하잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "What's with the fires lately, bud?"
msgstr "왠 불이냐 요즘, 친구?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC"
msgid "%s! Hey bud!"
msgstr "%s! 친구잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST"
msgid "With a heart you'll be feelin' like your mighty self in no time."
msgstr "심장이 있으면 원래의 강한 모습을 되찾을 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Your spear versus my axe, let's see whatcha got, eh!"
msgstr "네 창 대 내 도끼, 얼마나 센 지 봐야겠잖아, 엉!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER"
msgid "I'm glad you're on our side, %s."
msgstr "우리 편이라 다행이잖아, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT"
msgid "Pretty snappy looking."
msgstr "꽤 멋있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER"
msgid "A good place to spit out your gum."
msgstr "껌 뱉기 좋은 장소잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER"
msgid "%s'll end up on the wrong end of my axe if he's not careful..."
msgstr "조심하지 않으면 내 도끼가 %s에 박힐 거잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "You'll not want to be burning things, bud."
msgstr "태우지 마라, 짜식."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC"
msgid "Hey %s, how you doin' ya big hoser?"
msgstr "안녕, %s, 잘 지내나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST"
msgid "Lucy says I have to help you, %s. Let's get goin'."
msgstr "루시가 널 도와주라고 했잖아, %s. 가자."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER"
msgid "Yer still a hoser! Now it's choppin' time!"
msgstr "짜식! 널 팰 시간이 됐잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER"
msgid "You're growin' on me, %s. Like a fungus."
msgstr "친하게 달라붙잖아, %s. 곰팡이처럼."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL"
msgid "Trees made into... paper? How unholy!"
msgstr "나무를... 종이로 만들었잖아? 불량하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER"
msgid "Hey %s, can't we all just get a-log?"
msgstr "야, %s, 잘 지낼 수 없을까?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER"
msgid "I better not see anymore fires, little buddy."
msgstr "더 불지르지 마, 꼬마야."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s! 안녕 작은 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST"
msgid "We better get you a heart, hey kiddo?"
msgstr "꼬마, 심장이 필요하잖아?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER"
msgid "'Luce gave me the go-ahead! You're in trouble now, %s!"
msgstr "루시, 허락해 줘! 이제 넌 끝장이잖아, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER"
msgid "You're an alright spider, kiddo."
msgstr "꼬마, 넌 괜찮은 거미잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL"
msgid "The skull gives me the willies, too."
msgstr "두개골도 오싹해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Better small spiders than big, I suppose."
msgstr "작은 거미가 큰 거미보다는 낫잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER"
msgid "%s, I can't believe what I just SAW! Wait, no..."
msgstr "%s, 믿을 수 없잖아! 아니, 잠깐..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER"
msgid "Should you be setting fires, little buddy?"
msgstr "불질러야겠냐, 꼬마?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s! 안녕 작은 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST"
msgid "With a heart you'll be tip-top in no time, %s."
msgstr "심장이 있으면 좋아질 거잖아, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER"
msgid "Hereeee's Woodie!"
msgstr "우디가 널 상대해 주마!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER"
msgid "%s! You're doin' great, little buddy."
msgstr "%s! 잘 하고 있잖아, 꼬마."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER"
msgid "%s could learn some manners..."
msgstr "%s은(는) 매너부터 배워야겠잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER"
msgid "Keep those flames away from my trees!"
msgstr "불을 내 나무에서 멀리 떨어뜨려 놔!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC"
msgid "%s! How ya doin', buddy?"
msgstr "%s! 잘 지내나, 친구?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST"
msgid "First we'll get you a heart, then we'll get you some bacon, eh %s?"
msgstr "우선 심장을 구한 다음에 베이컨을 구해 주면 되잖아, 엉, %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER"
msgid "You're MIME now, %s!"
msgstr "깎아 죽일 마임, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s, 넌 괜찮잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP"
msgid "Better than some of the things I've eaten!"
msgstr "먹었던 것 중 최악은 아니잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER"
msgid "Damp."
msgstr "축축하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH"
msgid "Doesn't look useful, but I could be wrong."
msgstr "유용해 보이지 않지만 내가 틀릴 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP"
msgid "I hope that doesn't end up hurtin' any lil critters."
msgstr "작은 동물을 해치지 않았으면 좋겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s should read an etiquette book once in awhile."
msgstr "%s은(는) 매너에 대한 책도 읽어야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Careful around those open flames, Ma'am."
msgstr "불 조심해야겠잖아, 사모님."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "%s. Ma'am."
msgstr "%s 사모님."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You know where I can get a heart, %s?"
msgstr "심장을 어디에서 구할 수 있을지 아나, %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "This is gonna be a clear cut!"
msgstr "확실히 잘라야겠잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "That's some good work ya did, Ma'am."
msgstr "잘 했잖아, 사모님."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER"
msgid "You're tempting a forest fire, %s..."
msgstr "산불의 맛을 보고 싶나, %s..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Business as usual, I see."
msgstr "개버릇 남 못 주잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC"
msgid "Look who it is! %s!"
msgstr "너잖아! %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST"
msgid "Just don't haunt anything while I look for a heart, %s."
msgstr "내가 심장을 구하는 동안, 사람들을 놀래키지 마라, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER"
msgid "Here comes the wildfire!"
msgstr "요원의 불길로 상대해 주마!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER"
msgid "You're on fire today, %s. No... actually."
msgstr "오늘 불붙었구나, %s. 아니... 그런 뜻이 아니라."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER"
msgid "You haven't been very gentlemanly lately, %s."
msgstr "요즘 별로 신사적이지 않잖아, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER"
msgid "Was that blaze some sort of experiment, %s?"
msgstr "불은 실험이었나, %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC"
msgid "%s! Hey buddy!"
msgstr "%s! 안녕, 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST"
msgid "Someone should rub a heart on %s."
msgstr "누가 %s에 심장을 문질러야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER"
msgid "Enemy of the forest!"
msgstr "숲의 적이잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s, 넌 괜찮잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER"
msgid "%s is getting too big for her britches."
msgstr "%s이(가) 건방지잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s betrays the forest!"
msgstr "%s이(가) 숲을 배신하잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC"
msgid "%s! Hey there bud!"
msgstr "%s! 안녕!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST"
msgid "Yer looking a little pale, %s."
msgstr "약간 창백하잖아, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER"
msgid "You're on the chopping block now, %s!"
msgstr "널 썰어야겠잖아, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER"
msgid "I knew we were gonna get along."
msgstr "잘 지낼 줄 알았잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT"
msgid "It's a nice toque, eh?"
msgstr "좋은 모자네, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT"
msgid "The ones from home don't burn."
msgstr "고향에 있는 건 안 타잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC"
msgid "We can build these half as tall back home."
msgstr "고향에서 절반 높이로 만들 수 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1"
msgid "It's a gingerbread lumberjack."
msgstr "생강 빵 벌목꾼이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2"
msgid "Always had a soft spot for a good holiday cookie."
msgstr "항상 좋은 휴가 쿠키는 애착이 있었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3"
msgid "Satisfies the sweet tooth."
msgstr "단 것 먹고 싶을 때 만족스럽잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4"
msgid "That thing just ain't right."
msgstr "이상하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5"
msgid "All the taste and none of the splinters!"
msgstr "맛은 좋고 가시는 없잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6"
msgid "Hard to complain about this whole \"Feast\" business."
msgstr "\"잔치\"에 불평할 수는 없잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7"
msgid "Doesn't fall far from the cider tree."
msgstr "사과 나무에서 멀리 떨어지지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8"
msgid "Perfect for drinking next to a good fire, eh?"
msgstr "좋은 불 옆에서 마실 때 완벽하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9"
msgid "Psst, Lucy. Do I have a 'nog moustache?"
msgstr "어이, 루시. 내 수염에 에그노그 묻었나?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT"
msgid "For hanging on the unchopped tree with care."
msgstr "안 자른 나무에 조심스럽게 걸 때 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Y'know, I do believe that was worth it."
msgstr "그러니까 그만한 가치가 있었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "What do you think, Lucy? Decorate, or chop?"
msgstr "어떻게 생각해, 루시? 장식할까, 아니면 자를까?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING"
msgid "Such senseless violence."
msgstr "무의미한 폭력이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "참 안됐잖아. 진짜 편안한 느낌을 줬었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Must... not chop..."
msgstr "자르지... 말아야겠잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG"
msgid "All holidays should revolve around trees."
msgstr "모든 휴일은 나무를 중심으로 치러야잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "참 안됐잖아. 진짜 편안한 느낌을 줬었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "I'm sure I have an extra pine cone somewhere."
msgstr "어딘가에 솔방울이 더 있을 거잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s could be a bit more considerate..."
msgstr "%s이(가) 덜 거칠어도 되잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Don't singe your moustache, %s."
msgstr "콧수염 태우지 마라, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC"
msgid "That's my buddy, %s! Hey!"
msgstr "힘센 친구, %s! 안녕!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST"
msgid "C'mon, bud, let's get you on your feet."
msgstr "친구. 널 살리면 되잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER"
msgid "You'll not strong arm me, %s!"
msgstr "힘으로 날 쉽게 이길 수 있을까, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s has a big, squishy heart under those muscles."
msgstr "%s의 근육 덩어리 아래에는 말랑한 심장이 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER"
msgid "%s isn't a true Canadian..."
msgstr "%s은(는) 진짜 캐나다인이 아니잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER"
msgid "Been there, bud."
msgstr "나도 그랬잖아, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You're gonna have one monster headache after this, buddy."
msgstr "그게 끝나고 나면 엄청나게 머리가 아플 거잖아, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Those fires are kind of counterproductive now, eh?"
msgstr "그 불은 비생산적이잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC"
msgid "%s! Fancy seeing another Canadian here."
msgstr "%s! 캐나다 사람을 여기서 만났잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST"
msgid "Canadians gotta stick together, %s. Let's get a heart."
msgstr "캐나다 사람들은 단결해야잖아, %s. 심장을 구해오지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER"
msgid "Hey, c'mere %s! I've gotta AXE you question!"
msgstr "이리 와, %s! 할 말이 있잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER"
msgid "%s is a Canadian patriot, eh."
msgstr "%s은(는) 캐나다 애국자잖아, 엉."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT"
msgid "Be wary of the moving ground."
msgstr "움직이는 땅을 조심해야잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT"
msgid "I know a plant when I see one. This's an impostor!"
msgstr "식물이 어떻게 생겼는지는 알아. 이건 가짜잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM"
msgid "WOOORM!"
msgstr "벌레!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like a bum!"
msgstr "거지 같잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN"
msgid "I'm not sure I want to look at that, eh?"
msgstr "들여다보고 싶지 않은데, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED"
msgid "It smells a bit off, eh?"
msgstr "좀 상한 냄새 나잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT"
msgid "This thing will be useful."
msgstr "이거 유용하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER"
msgid "Wrinklier than the underside of a beaver."
msgstr "비버의 배보다 더 쭈글쭈글하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER"
msgid "%s is cruisin' for a bruisin'..."
msgstr "%s이(가) 맞으려고 환장했잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER"
msgid "You're gonna singe your chassis, %s."
msgstr "네 섀시를 태우겠잖아, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC"
msgid "It's my metal buddy, %s!"
msgstr "내 무쇠 친구잖아, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST"
msgid "Huh, I guess %s had a soul after all."
msgstr "호, %s이(가) 영혼이 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER"
msgid "It's time to power DOWN, %s!"
msgstr "전원을 내릴 시간이잖아, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER"
msgid "%s, you're an alright sort."
msgstr "%s, 넌 괜찮잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET"
msgid "I could cut wood at night with this."
msgstr "이걸로 밤에 도끼질해야지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM"
msgid "I can see the stars in it."
msgstr "안에 별이 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE"
msgid "It's rude to stare."
msgstr "뚫어지게 쳐다보는 건 무례하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF"
msgid "Useful in a pinch!"
msgstr "어쩔 수 없다면 쓸모 있잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC"
msgid "What's that, eh?"
msgstr "저게 뭐야, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING"
msgid "It's aboot to go up in flames, eh?"
msgstr "곧 불탈 거잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK"
msgid "It's too dark, eh!"
msgstr "너무 어둡잖아, 엉!"

#. STRINGS.CHARACTERS.WOODIE.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WOODIE.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "You can taste the beak, eh?"
msgstr "부리를 맛볼 수 있잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_LOSE"
msgid "It's over for us, eh."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Too long on the fire."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Guess those ingredients don't go together."
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_WIN"
msgid "We done did it."
msgstr ""

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "REQUIRES PASSKEY"
msgstr "패스키 필요함"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I MUST MAKE REPAIRS BEFORE DOING THIS"
msgstr "이것을 하기 전에 수리해야 함"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.BUILD.HASPET"
msgid "I ALREADY HAVE AN ORGANIC MINION"
msgstr "유기체 부하는 이미 있음"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.BUILD.MOUNTED"
msgid "NON-OPTIMAL ALTITUDE FOR PLACING"
msgstr "배치하기에 적합하지 않은 고도"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.BURNING"
msgid "IT'S BURNING. OH WELL"
msgstr "탄다. 어쩔 수 없음."

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "THERE ARE MORE IMPORTANT ISSUES TO ATTEND TO"
msgstr "더 중요한 문제가 있음"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.CHANGEIN.INUSE"
msgid "OCCUPIED"
msgstr "점유됨"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.COOK.GENERIC"
msgid "I DON'T WANT TO COOK"
msgstr "요리하고 싶지 않음"

#. STRINGS.CHARACTERS.WX78.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WX78.ACTIONFAIL.COOK.INUSE"
msgid "YOU MAY FEED ME, INFERIOR"
