msgstr "수염남자 %s이(가) 싸우고 싶어하는구나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER"
msgid "The beard ate %s!"
msgstr "수염이 %s을(를) 먹었구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "Still have good moustache, %s."
msgstr "콧수염이 멋지구나, %s."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Be careful! Do not burn, beard!"
msgstr "조심하자구나! 수염을 태우지 말자구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC"
msgid "Is beard! Hello!"
msgstr "수염이구나! 안녕이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST"
msgid "Wolfgang will get heart for you, beard!"
msgstr "볼프강이 자네를 위해 수염을 구하겠구나, 수염!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER"
msgid "Drop axe and fight, beardman!"
msgstr "도끼를 놓고 싸우자구나, 수염남자!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER"
msgid "%s is nice man with magnificent beard."
msgstr "%s은(는) 훌륭한 수염을 가진 착한 남자구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT"
msgid "Is dirt moving?"
msgstr "흙이 움직이는구나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.PLANT"
msgid "Pretty light."
msgstr "꽤 가볍구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.WORM"
msgid "Did not expect this!"
msgstr "이것을 기대하지 않았구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.GENERIC"
msgid "Like soft pillow, growing on ground."
msgstr "부드러운 베개처럼 지면에서 자라는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE.OPEN"
msgid "It can not harm this man!"
msgstr "이 남자를 해칠 수 없구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMHOLE_LIMITED"
msgid "Is not looking very good."
msgstr "그리 좋아 보이지 않는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT"
msgid "Pretty light."
msgstr "꽤 가볍구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT_LESSER"
msgid "Nice little light."
msgstr "좋은 작은 빛이잖아."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMLIGHT_PLANT"
msgid "Pretty light."
msgstr "꽤 가볍구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.ATTACKER"
msgid "Ha! Metal can is want to rock'em and sock'em!"
msgstr "하! 깡통이 싸우고 싶어하는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.FIRESTARTER"
msgid "Robot trying to kill fleshypeople again, maybe?"
msgstr "로봇이 살덩어리 사람을 또 죽이려는구나, 아마도?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.GENERIC"
msgid "Is tiny robot, %s! Hello!"
msgstr "작은 로봇이구나, %s! 안녕하구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.GHOST"
msgid "Robot %s is broken! Wolfgang rub heart on problem."
msgstr "로봇 %s이(가) 망가졌구나! 볼프강이 심장으로 문지르겠구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.MURDERER"
msgid "%s is killer robot!"
msgstr "%s은(는) 살인 로봇이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WX78.REVIVER"
msgid "%s is nice person. Deep down."
msgstr "%s은(는) 사실은 마음씨가 좋구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWAMULET"
msgid "Is glowing yellow."
msgstr "노란색으로 빛나는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWGEM"
msgid "Pretty rock."
msgstr "예쁜 돌이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWMOONEYE"
msgid "Hmm, maybe Wolfgang try shotput?"
msgstr "흠, 어쩌면 볼프강이 투포환 던지기를 시도할까나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.YELLOWSTAFF"
msgid "Pretty gem sits in stick."
msgstr "예쁜 보석이 막대기에 앉아 있구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_GENERIC"
msgid "What is this thing?"
msgstr "이것이 무엇일까나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_SMOLDERING"
msgid "Is almost fire."
msgstr "거의 불붙었구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE_TOODARK"
msgid "Help friends! Save Wolfgang from dark!"
msgstr "도와주자구나, 친구들! 볼프강이 어두운 곳에 있구나!"

#. STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "This egg too crunchy."
msgstr "알이 너무 바삭바삭하구나."

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_LOSE"
msgid "Sky beast is mad!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Little meal cooked too long."
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "That was not good recipe!"
msgstr ""

#. STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.QUAGMIRE_ANNOUNCE_WIN"
msgid "Is time to leave. Goodbye, good food!"
msgstr ""

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Guess we need a key."
msgstr "열쇠가 필요하잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "I feel worse than a used roll of duct tape. Maybe later?"
msgstr "내가 정말 쓸모 없잖아. 나중이라면?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.HASPET"
msgid "I need to take care of the pet I have."
msgstr "있는 애완동물에 관심 가져야겠잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.BUILD.MOUNTED"
msgid "Not as tall as a moose, but still too high to place that."
msgstr "말코손바닥사슴만큼 크지 않지만, 높은 곳에 있어서 못 놓겠잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Better it than a tree."
msgstr "나무가 타는 것보다는 낫겠지."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "Ouch. Do I not look skookum enough already?"
msgstr "앗."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Could you hand me my plaid shirt while you're in there?"
msgstr "그 안에서 내 플래드 셔츠를 찾아줄 수 있을까?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.GENERIC"
msgid "That's not really in my wheelhouse, sorry."
msgstr "내 특기가 아니잖아, 미안."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.INUSE"
msgid "Careful now, don't burn it."
msgstr "조심, 태우면 안 되잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.COOK.TOOFAR"
msgid "I gotta get closer, eh?"
msgstr "더 가까이 가야 하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.DRAW.NOIMAGE"
msgid "I won't get it right unless I have the item in front of me."
msgstr "내 앞에 아이템이 있지 않으면 제대로 할 수 없잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "I'd never hear the end of it from 'Luce if I didn't try."
msgstr "시도하지 않으면 루시가 계속 불평하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try again in a mo'."
msgstr "나중에 다시 해보겠어."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Didn't work. Probably for the best."
msgstr "안 되잖아, 엉? 상관없잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.DEAD"
msgid "I don't think they... um..."
msgstr "그들이... 음..."

