msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY"
msgid "Ugly monkey man!"
msgstr "못생긴 원숭이 사람이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYBARREL"
msgid "This... thing. It smells not so good."
msgstr "물건... 이구나. 냄새가 안 좋구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERLASAGNA"
msgid "Taste like hairs and meats with noodle."
msgstr "털과 고기가 있는 국수 맛 같구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT"
msgid "It is not looking like food."
msgstr "음식처럼 안 보이는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Look like leather, taste like leather."
msgstr "가죽처럼 보이고 가죽 맛이 나는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.BROKEN"
msgid "Tiny platform is broken!"
msgstr "조그만 판이 부서졌구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.GENERIC"
msgid "Little platform is still missing pieces."
msgstr "작은 판의 조각들이 아직 비어 있구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Sickly little light is not run out."
msgstr "아픈 작은 빛이 아직 다 꺼지지 않았구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.STAFFED"
msgid "Is ready for good fight!"
msgstr "좋은 싸움을 할 준비가 되었구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Feels wrong to Wolfgang."
msgstr "볼프강이 잘못 느끼는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.CAVE"
msgid "Moon is shy in cave!"
msgstr "달이 동굴에서는 수줍어하는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GENERIC"
msgid "Wolfgang see moon reflection, but not his mighty self!"
msgstr "볼프강은 달의 반영을 보지만 위대한 자신은 못 보는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Moon is very mighty!"
msgstr "달이 아주 힘세구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Moon is hiding."
msgstr "달이 숨어 있구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "Moon is get sleepy."
msgstr "달이 좀 졸리구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "Tiny moon is get bigger!"
msgstr "조그만 달이 커지는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKCRATER"
msgid "Rock from moon has hole. Like a cheese!"
msgstr "달바위에 구멍이 있구나. 치즈 같구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET"
msgid "But is not cheese?"
msgstr "치즈가 아니구나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCK_PIECES"
msgid "Is little pieces from moon!"
msgstr "달에서 온 작은 조각이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE"
msgid "Very strange creature."
msgstr "아주 이상한 동물이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSEEGG"
msgid "Breakfast for whole family!"
msgstr "온 가족을 위한 아침 식사구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Is big bird baby bed!"
msgstr "큰 새 아기 침대구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.GENERIC"
msgid "Reminds me of uncle!"
msgstr "아저씨가 생각나는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.HELD"
msgid "No more blood for you!"
msgstr "너를 위한 피는 없구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK"
msgid "Uncle did not have gut like this."
msgstr "아저씨는 이런 배를 가지고 있지 않았구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSSLING"
msgid "Mmmm. Is still breakfast, I think."
msgstr "흠. 그래도 어쩌면 아침 식사구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.DUG"
msgid "Sorry, dead peoples."
msgstr "미안하구나, 죽은 사람들."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.GENERIC"
msgid "Scary! Is probably full of bones!"
msgstr "무시무시하구나!뼈가 가득 들어있을 것 같구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Why door not crumble under mighty Wolfgang punches?!"
msgstr "힘센 볼프강이 쳤는데 왜 문이 안 부서지는구나?!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Chop and dig! I can do that all day."
msgstr "자르고 파는구나! 내가 하루 종일 할 수 있는 것이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMBOMB"
msgid "Is dangerous mushy-boom!"
msgstr "위험한 버섯이 쾅이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMHAT"
msgid "Is mushy-room... for head!"
msgstr "머리를 위한... 버어서엇이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Tall mushy-room is burnt now!"
msgstr "큰 버어서엇이 이제 탔구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Tall mushy-room looks very bad!"
msgstr "키 큰 버어서엇이 나빠 보이는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Log is not looking mighty!"
msgstr "통나무가 힘세 보이지 않는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Is nothing."
msgstr "없구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "So many little mushy-rooms!"
msgstr "작은 버어서엇이 너무 많구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Dead log is need to be replaced."
msgstr "죽은 통나무를 바꿀 필요가 있구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Mushy-rooms not mighty enough to fight snow!"
msgstr "버어서엇이 눈과 싸울 만큼  힘세지 않구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "Little mushy-rooms is start to grow."
msgstr "작은 버어서엇이 성장을 시작하는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Is no more room for more mushy-rooms!"
msgstr "버어서엇을 위한 공간이 더 이상 없구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Little light burnt too bright?"
msgstr "작은 빛이 너무 밝게 탔구나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Big mushy-room make little light, maybe."
msgstr "큰 버어서엇이 어쩌면 약간 빛을 만드는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Is nice light. Soft."
msgstr "좋은 빛이구나. 부드럽구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "No more little lights."
msgstr "작은 빛이 더 이상 없구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "How Wolfgang turn on mushy-room light?"
msgstr "어떻게 볼프강이 버어서엇 빛을 켜나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Tall mushy-room make very pretty light!"
msgstr "키 큰 버어서엇이 매우 예쁜 빛을 만드는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "It's having fun!"
msgstr "즐기고 있구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Mushy bush."
msgstr "물컹한 덤불이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Even smell is strong!"
msgstr "냄새도 세구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Mushy shrub."
msgstr "물컹한 관목이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Woah! It's even bigger!"
msgstr "이야! 더 크구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "Big mushtree is big."
msgstr "큰 버섯나무가 크구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "Aw, cheer up!"
msgstr "어, 힘내자구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT"
msgid "Is strange glow."
msgstr "이상한 빛이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL"
msgid "Scary stuff."
msgstr "무서운 거구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARELIGHT"
msgid "Is light, but not good light."
msgstr "빛이지만 좋은 빛이 아니구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "No bad light."
msgstr "나쁜 빛이 없구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Good time is soon."
msgstr "좋은 시간이 곧 오는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "Is safe from bad light."
msgstr "나쁜 빛으로부터 안전하구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "I think bad light not get stronger."
msgstr "나쁜 빛이 더 강해지지 않았구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Bad light time is ending."
msgstr "나쁜 빛 시간이 끝나는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "The bad light comes soon."
msgstr "나쁜 빛이 곧 오는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The bad light is here and getting stronger."
msgstr "나쁜 빛이 와서 점점 강해지는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSTICK"
msgid "Wolfgang like fists better."
msgstr "볼프강은 주먹을 더 좋아하는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSWORD"
msgid "Is real? Is not real? Is sharp!"
msgstr "진짜구나? 진짜 아니구나? 날카롭구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE"
msgid "Is rock, but different."
msgstr "바위지만 다르구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE"
msgid "Splishes and splashes."
msgstr "찰팍철퍽이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONEMANBAND"
msgid "Is big and loud. I like!"
msgstr "크고 시끄럽구나. 좋구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALPRECIOUSGEM"
msgid "Is very nice little stone."
msgstr "매우 좋은 작은 돌이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALSTAFF"
msgid "Tiny stick make big cold!"
msgstr "작은 막대가 큰 추위를 만드는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEAMULET"
msgid "For wearing around strong necks."
msgstr "힘센 목에 거는 것이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEGEM"
msgid "Pretty rock."
msgstr "예쁜 돌이구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEMOONEYE"
msgid "Tiny rock watches Wolfgang wherever he go."
msgstr "어디를 가든 작은 바위가 볼프강을 보는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGESTAFF"
msgid "Better to walk I think."
msgstr "걷는 것이 낫겠구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PANDORASCHEST"
msgid "Fancy box!"
msgstr "고급스러운 상자구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PANFLUTE"
msgid "You want Wolfgang play folk song?"
msgstr "볼프강이 포크송을 연주할까나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PAPYRUS"
msgid "Is like paper."
msgstr "종이 같구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PEGHOOK"
msgid "Wolfgang will beat you with fists!"
msgstr "볼프강이 널 주먹으로 때릴 것이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PENGUIN"
msgid "Funny walking birds!"
msgstr "이상하게 걷는 새구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PERD"
msgid "Dumb bird is take all berries!"
msgstr "멍청한 새가 베리를 모두 가져가는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.PERDFAN
