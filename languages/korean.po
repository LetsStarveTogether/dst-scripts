msgstr "깃털 달린 풀 갑옷"

#. STRINGS.SKIN_NAMES.armor_grass_woven
msgctxt "STRINGS.SKIN_NAMES.armor_grass_woven"
msgid "Woven Grass Armor"
msgstr "짠 풀 갑옷"

#. STRINGS.SKIN_NAMES.armor_marble_chainmail
msgctxt "STRINGS.SKIN_NAMES.armor_marble_chainmail"
msgid "Marble Splint Mail"
msgstr "대리석 미늘 갑옷"

#. STRINGS.SKIN_NAMES.armor_marble_rockabs
