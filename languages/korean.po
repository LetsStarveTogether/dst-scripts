msgstr "뿅뿅!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_12"
msgid "Feels leathery."
msgstr "가죽 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_13"
msgid "It's watching us."
msgstr "우리를 보고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_14"
msgid "We want some hot cocoa."
msgstr "핫 코코아 있으면 좋겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_15"
msgid "We don't know how to play this game."
msgstr "어떻게 노는 것인지 모르겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_16"
msgid "We don't know how to play this game."
msgstr "어떻게 노는 것인지 모르겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_17"
msgid "Spork. Spork. Spork. Hahaha!"
msgstr "스포크. 스포크. 스포크. 하하하!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_18"
msgid "We like toys."
msgstr "우리는 장난감을 좋아한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_19"
msgid "This toy doesn't work very well."
msgstr "장난감이 고장났다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_2"
msgid "A voiceless instrument."
msgstr "목소리가 없는 기구다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_20"
msgid "Can we dig in the dirt with this?"
msgstr "이걸로 흙을 팔 수 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_21"
msgid "Mom had one of these."
msgstr "엄마도 이런 거 가지고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22"
msgid "It's kinda like our webbing!"
msgstr "우리 거미줄 같다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_23"
msgid "Are we supposed to blow on it?"
msgstr "여기에 불어야 되나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_24"
msgid "No cookies. Yet!"
msgstr "쿠키가 없다. 아직은!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25"
msgid "It's stinky."
msgstr "냄새가 구리다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26"
msgid "You're our cuppy cup!"
msgstr "우리 컵이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_27"
msgid "This is stupid."
msgstr "바보 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_28"
msgid "Maybe Maxwell will teach us how to play."
msgstr "맥스웰이 노는 법을 가르쳐 줄지도 모르겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29"
msgid "Maybe Maxwell will teach us how to play."
msgstr "맥스웰이 노는 법을 가르쳐 줄지도 모르겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3"
msgid "It won't come undone!"
msgstr "안 풀어진다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_30"
msgid "We can't follow the rules if we don't know them."
msgstr "알지 못 하면 규칙을 따를 수 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_31"
msgid "We can't follow the rules if we don't know them."
msgstr "알지 못 하면 규칙을 따를 수 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_32"
msgid "It's not bouncy. What's the point?"
msgstr "안 튄다. 무슨 소용일까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_33"
msgid "It's a friend for our finger!!"
msgstr "우리 손가락의 친구다!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_34"
msgid "The monkey probably needed that."
msgstr "원숭이가 원하는 것이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_35"
