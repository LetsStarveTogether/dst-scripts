msgstr "동일한 제조법 두 개는 무의미하잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.FOODFULL"
msgid "There's already something there."
msgstr "그 안에 이미 뭔가 있잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GENERIC"
msgid "Nah, that ain't right."
msgstr "저건 아니잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.GHOSTHEART"
