#. STRINGS.SKIN_NAMES.bedroll_furry_quilt_blue_frost
msgctxt "STRINGS.SKIN_NAMES.bedroll_furry_quilt_blue_frost"
msgid "Patchwork Quilt"
msgstr "패치워크 퀼트"

#. STRINGS.SKIN_NAMES.bedroll_furry_quilt_white_ivory
msgctxt "STRINGS.SKIN_NAMES.bedroll_furry_quilt_white_ivory"
