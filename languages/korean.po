msgstr "가려운 짚이구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_MOONROCK"
