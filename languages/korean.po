msgstr "내 도구 상자가 되고 싶니?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Who left you out here all alone, hey?"
msgstr "누가 널 여기에 내버려 둔 걸까?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Yeesh. Fishfry."
msgstr "흠. 생선튀김."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE"
