msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "That needs a magic log, eh?"
msgstr "마법 통나무가 필요하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "That needs a mushroom spore, eh?"
msgstr "버섯 포자가 필요하잖아, 엉?"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTDISH"
msgid "That doesn't seem smart."
msgstr "영리해 보이지 않잖아."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTGEM"
