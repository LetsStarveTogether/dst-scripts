msgstr "É algum tipo de cogumelo azul."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Cogumelo preguiçoso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Got'er done."
msgstr "Peguei."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS"
