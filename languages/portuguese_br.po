msgstr "Só outra pedra pra mim."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED"
