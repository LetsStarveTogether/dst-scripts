msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
