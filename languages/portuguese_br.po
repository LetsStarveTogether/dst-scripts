msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It looks sick. More so than usual."
msgstr "Parece doente. Mais do que o normal."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "It's all stick-y."
msgstr "É meio grudento demais."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_NUT"
msgid "There's a stick-y tree inside it that wants to get out."
msgstr "Tem uma árvore grudenta lá dentro querendo sair."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It doesn't need any help to grow."
msgstr "Não precisa de ajuda pra crescer."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGGY_OLD"
msgid "That tree looks pretty wimpy."
msgstr "Essa árvore parece bem babaca."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TWIGS"
