msgstr "Parece que poderia quebrar."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON"
