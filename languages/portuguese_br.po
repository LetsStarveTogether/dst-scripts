msgstr "E agora?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
