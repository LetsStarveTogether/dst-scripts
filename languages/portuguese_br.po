msgstr "A lua está lá fora!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing, unlike me."
msgstr "A lua está crescendo, diferente de mim."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER"
