msgstr "Torrado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF"
