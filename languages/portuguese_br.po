msgstr "Eu poderia fazer coisas legais mais rápido com isso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP"
