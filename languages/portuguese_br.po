msgstr "É afiado. Eu gosto!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE"
