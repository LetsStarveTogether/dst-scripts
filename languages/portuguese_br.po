msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_27"
msgid "Finally. My suits were getting wrinkles. Wrinkles!"
msgstr "Finalmente. Minhas roupas estavam ficando amassadas. Amassadas!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_28"
msgid "It is still beholden to the king."
msgstr "Ainda pertence ao rei."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_29"
msgid "It is still beholden to the king."
msgstr "Ainda pertence ao rei."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_3"
msgid "A tangled mess. Like life."
msgstr "Um emaranhado. Como a vida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_30"
msgid "Not a pawn, but still a minion."
msgstr "Não é um peão, mas ainda é um lacaio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_31"
msgid "Not a pawn, but still a minion."
msgstr "Não é um peão, mas ainda é um lacaio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_32"
msgid "Amateur magic for children."
msgstr "Magia amadora para crianças."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_33"
msgid "The opposite of dapper."
msgstr "O oposto de elegante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_34"
msgid "I'm done tampering with magical oddities, thank-you."
msgstr "Estou farto de mexer com estranhezas mágicas, obrigado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_35"
msgid "I'm not in the habit of imbibing strange liquids."
msgstr "Não tenho o costume de sorver líquidos estranhos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.TRINKET_36"
