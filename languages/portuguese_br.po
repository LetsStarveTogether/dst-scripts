msgstr "Tem cheiro de jantar de domingo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BIRDS"
