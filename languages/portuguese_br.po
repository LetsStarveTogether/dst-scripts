msgstr "Isso parece anti-higiênico!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER"
msgid "Stop! It's time! To hammer things!"
msgstr "Pare! Chegou a hora! De martelar as coisas!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAMMER_MJOLNIR"
msgid "It's a heavy hammer for hitting things."
msgstr "É um martelo pesado para bater na coisas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HAWAIIANSHIRT"
msgid "It's not lab-safe!"
msgstr "Não é seguro para laboratórios!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSALVE"
msgid "The stinging means that it's working."
msgstr "As pontadas significam que está funcionando."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEALINGSTAFF"
msgid "It conducts regenerative energy."
msgstr "Conduz energia regenerativa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.COLD"
msgid "That's a cold stone."
msgstr "Mas que pedra mais fria."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.FROZEN"
msgid "It's colder than ice."
msgstr "É mais frio que gelo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.GENERIC"
msgid "I could manipulate its temperature."
msgstr "Eu poderia manipular sua temperatura."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.HOT"
msgid "Nice and toasty hot!"
msgstr "Ah, bem quentinha!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HEATROCK.WARM"
msgid "It's quite warm and cuddly... for a rock!"
msgstr "É bem quentinha e aconchegante... para uma pedra!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HIVEHAT"
msgid "The world seems less a little crazy when I wear it."
msgstr "O mundo parece um pouco menos louco quando eu uso isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOME"
msgid "Someone must live here."
msgstr "Alguém deve morar aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.BURNT"
msgid "\"Don't play with matches.\""
msgstr "\"Não brinque com fósforos.\""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.GENERIC"
msgid "It says \"You are here\"."
msgstr "Está escrito: \"Você chegou.\""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "The sign is currently blank."
msgstr "A placa está em branco no momento."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEY"
msgid "Looks delicious!"
msgstr "Parece delicioso!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYCOMB"
msgid "Bees used to live in this."
msgstr "Abelhas costumavam viver aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYHAM"
msgid "Sweet and savory."
msgstr "Doce e suculento."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HONEYNUGGETS"
msgid "Tastes like chicken, but I don't think it is."
msgstr "Tem gosto de frango, mas acho que não é."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HORN"
msgid "It sounds like a beefalo field in there."
msgstr "Esse parece um campo de bífalos."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOTCHILI"
msgid "Five alarm!"
msgstr "Incêndio bucal!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUND"
msgid "You ain't nothing, hound dog!"
msgstr "Você não é nada, cão de caça!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDBONE"
msgid "Creepy."
msgstr "Bizarro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDMOUND"
msgid "I've got no bones to pick with the owner. Really."
msgstr "Seus ossos do ofício, acho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDSTOOTH"
msgid "It's sharp!"
msgstr "Afiado!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HOUNDWHISTLE"
msgid "This'd stop a dog in its tracks."
msgstr "Isso pararia um cão rapidinho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT"
msgid "Flesh is flesh. Where do I draw the line?"
msgstr "Carne humana é carne humana. Onde fica o limite?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_COOKED"
msgid "Cooked nice and pink, but still morally gray."
msgstr "Cozido bem até ficar rosa, mas ainda moralmente cinza."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUMANMEAT_DRIED"
msgid "Letting it dry makes it not come from a human, right?"
msgstr "Deixar secar faz com que não tenha vindo de um humano, certo?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH"
msgid "Hutch Danglefish, P.I."
msgstr "Hutch Danglefish, investigador particular."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "I always wanted one of these."
msgstr "Sempre quis um desses."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Maybe he needs some science?"
msgstr "Talvez ele precise de um pouco de ciência?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICE"
msgid "Ice to meet you."
msgstr "Freezer em conhecê-lo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEBOX"
msgid "I have harnessed the power of cold!"
msgstr "Consegui controlar o poder do frio!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICECREAM"
msgid "I scream for ice cream!"
msgstr "Meu mundo por um sorvete!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHAT"
msgid "Stay cool, boy."
msgstr "Fica frio, cara."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEHOUND"
msgid "Are there hounds for every season?"
msgstr "Existem cães para todas as estações?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICEPACK"
msgid "The fur keeps the temperature inside stable."
msgstr "A pele mantém a temperatura interna estável."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ICESTAFF"
msgid "It's cold to the touch."
msgstr "É frio ao toque."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "TAKE THAT, SANE SELF!"
msgstr "TOMA ESSA, EU SÃO!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It's more of a pyramid than an obelisk."
msgstr "É mais tipo uma pirâmide que um obelisco."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.INSPECTSELF"
msgid "Am I still in one piece?"
msgstr "Tudo certo ainda?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JAMMYPRESERVES"
msgid "Probably should have made a jar."
msgstr "Provavelmente deveria ter feito um pote."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.JELLYBEAN"
msgid "One part jelly, one part bean."
msgstr "Metade ju, metade juba."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KABOBS"
msgid "Lunch on a stick."
msgstr "Refeição no palito."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.GENERIC"
msgid "Oh no! It's a killer bee!"
msgstr "Ah, não! É uma abelha assassina!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KILLERBEE.HELD"
msgid "This seems dangerous."
msgstr "Isso parece perigoso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS"
msgid "What on earth is that thing!"
msgstr "Mas que diabos é isso!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUSSACKKEY"
msgid "It's really fancy for a deer antler."
msgstr "É bem sofisticada pra uma galhada de cervo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KLAUS_SACK"
msgid "We should definitely open that."
msgstr "Deveríamos definitivamente abrir isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT"
msgid "Check it out!"
msgstr "Olha só isso!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It's a knightmare!"
msgstr "Que pesadelo cavalar!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_SUMMER"
msgid "Adorably delicious."
msgstr "Adoravelmente delicioso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KOALEFANT_WINTER"
msgid "It looks warm and full of meat."
msgstr "Parece quente e carnudo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS"
msgid "He's going after my stuff!"
msgstr "Ele está atrás das minhas coisas!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.KRAMPUS_SACK"
msgid "Ew. It has Krampus slime all over it."
msgstr "Eca. Tem meleca de Krampus por tudo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LANTERN"
msgid "A more civilized light."
msgstr "Uma luz mais civilizada."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "This armor has been petrified for maximum protection."
msgstr "Essa armadura foi petrificada para proporcionar o máximo de proteção."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That's as good as it gets."
msgstr "Esse é o melhor possível."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Light, but not very durable."
msgstr "Leve, mas não muito durável."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Lightweight and designed for mobility."
msgstr "Leve e projetado para proporcionar mobilidade."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It offers a decent amount of protection."
msgstr "Oferece uma quantidade decente de proteção."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "That could help me hit a little harder."
msgstr "Poderia me ajudar a golpear um pouco mais forte."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I'd have energy for a few more stunts wearing that."
msgstr "Eu teria energia para mais alguns truques usando isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "That should keep me safe."
msgstr "Isso deve me proteger."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Everyone, break the Battle Standard!"
msgstr "Pessoal, destruam o estandarte de batalha!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BERNIE"
msgid "He might make a good distraction for us."
msgstr "Ele pode criar uma boa distração para nós."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_BOARLORD"
msgid "That's the guy in charge here."
msgstr "Esse é o cara que comanda as coisas por aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "That could cause some major destruction."
msgstr "Isso poderia causar grande destruição."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "It's a rock monster!"
msgstr "É um monstro de pedra!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "It has a gaze full of science."
msgstr "Tem um olhar cheio de ciência."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Those fluffy feathers make me want to run!"
msgstr "Essas penas fofinhas me dão vontade de correr!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "It smells like brimstone."
msgstr "Tem cheiro de enxofre."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "The blossom interacts well with healing magic."
msgstr "A flor interage bem com magia curativa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "This garland will restore a bit of my vitality."
msgstr "Essa guirlanda vai restaurar um pouco da minha vitalidade."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A sharp looking instrument."
msgstr "Um instrumento que parece afiado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It needs a key."
msgstr "É necessário uma chave."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "That should do it."
msgstr "Essa deve funcionar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "My strikes would hurt a little more wearing that."
msgstr "Meus golpes doeriam um pouco mais se eu usasse isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_LUCY"
msgid "That weapon's for throwing."
msgstr "Essa arma serve para arremessar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "That's how we got here. Hopefully how we get back, too."
msgstr "Foi assim que chegamos aqui. Espero que voltemos por aí também."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "I'll just be going now."
msgstr "Já está na minha hora."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Those crystals will quickened my abilities."
msgstr "Esses cristais vão acelerar minhas habilidades."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_SPAWNER"
msgid "This is where those enemies are coming from."
msgstr "É daí que estão saindo esses inimigos."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "It looks like it packs a wallop."
msgstr "Parece que esse é forte."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Looks like it amplifies healing expertise."
msgstr "Parece que amplifica a experiência de cura."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE"
msgid "Too hot to handle."
msgstr "Está muito quente pra pegar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_COCOON"
msgid "Cooled off and chilled out."
msgstr "Esfriou e tá de boas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "There's a faint warmth coming from inside."
msgstr "Tem um leve calor vindo de dentro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "I don't think that egg is warm enough."
msgstr "Não acho que esse ovo esteja quente o suficiente."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "I never thought I would see a happy egg."
msgstr "Nunca pensei que veria uma ovo feliz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It seems happy."
msgstr "Parece feliz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.GENERIC"
msgid "Aww. Who's a good monster?"
msgstr "Oun. Cadê o monstrinho querido?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "I hear a tiny stomach grumbling."
msgstr "Estou ouvindo uma barriguinha roncando."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_PET.STARVING"
msgid "Poor thing must be starving."
msgstr "Pobrezinho deve estar faminto."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVAE_TOOTH"
msgid "It's an egg tooth!"
msgstr "É um dente de ovo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.COOL"
msgid "I like to call it \"Basaliva\"."
msgstr "Eu gosto de chamá-lo de \"basaliva\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVASPIT.HOT"
msgid "Hot spit!"
msgstr "Cuspe quente!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND"
msgid "Magmificent!"
msgstr "Magmífico!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LAVA_POND_ROCK"
msgid "As gneiss a place as any."
msgstr "Esse lago está meio seco."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF"
msgid "He's huge!"
msgstr "Ele é enorme!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LEIF_SPARSE"
msgid "He's huge!"
msgstr "Ele é enorme!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LICHEN"
msgid "Only a cyanobacteria could grow in this light."
msgstr "Só uma cianobactéria poderia crescer nessa luz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIFEINJECTOR"
msgid "A scientific breakthrough! The cure!"
msgstr "Um avanço científico! A cura!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTBULB"
msgid "It's strangely tasty looking."
msgstr "Tem um visual estranhamente saboroso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTER"
msgid "It's her lucky lighter."
msgstr "É o isqueiro da sorte dela."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "I don't think it liked being struck by lightning."
msgstr "Acho que não gostou de ter sido atingido por um raio."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "\"Baaaah\" yourself!"
msgstr "\"Béééé\" pra você também!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's like a miniature lightning rod."
msgstr "Parece um para-raios em miniatura."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "The power is mine!"
msgstr "O poder é meu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "To harness the heavens!"
msgstr "Domando os céus!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LITTLE_WALRUS"
msgid "He won't be cute and cuddly forever."
msgstr "Ele não vai ser fofinho e bonitinho para sempre."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGLOG"
msgid "It looks worried."
msgstr "Parece preocupada."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE"
msgid "Is it watching me?"
msgstr "Isso está me observando?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_ROOT"
msgid "Something's in there! I'll have to root it out."
msgstr "Tem alguma coisa aí! Vou ter que arrancar pela raiz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It'll grow up big and horrifying."
msgstr "Vai crescer pra ficar grande e horripilante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.BURNING"
msgid "That's some hot wood!"
msgstr "Essa madeira é quente!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LOG.GENERIC"
msgid "It's big, it's heavy, and it's wood."
msgstr "É grande, é pesada e é de madeira."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "What a lucky find!"
msgstr "Que descoberta afortunada!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUCY"
msgid "That's a prettier axe than I'm used to."
msgstr "Esse machado é mais bonito que os que já usei até hoje."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUMPY_SAPLING"
msgid "How did this tree even reproduce?"
msgstr "Como é que essa árvore se reproduziu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUREPLANT"
msgid "It's so alluring."
msgstr "Como é atraente."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.LUREPLANTBULB"
msgid "Now I can start my very own meat farm."
msgstr "Agora posso começar minha própria criação de gado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MADSCIENCE_LAB"
msgid "Sanity is a small price to pay for science!"
msgstr "A sanidade é um preço pequeno a se pagar pela ciência!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MALE_PUPPET"
msgid "He's trapped!"
msgstr "Ele está preso!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE"
msgid "Mandrake roots have strange properties."
msgstr "As raízes de mandrágora têm propriedades estranhas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKESOUP"
msgid "Well, he won't be waking up again."
msgstr "Bem, acho que não vai acordar mais."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Cut it out!"
msgstr "Para com isso!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_COOKED"
msgid "It doesn't seem so strange anymore."
msgstr "Não parece mais tão estranho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANDRAKE_PLANTED"
msgid "I've heard strange things about those plants."
msgstr "Ouvi coisas estranhas sobre essas plantas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MANRABBIT_TAIL"
msgid "I feel a lil better when I hold one."
msgstr "Me sinto um pouco melhor quando seguro um."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAPSCROLL"
msgid "A blank map. Doesn't seem very useful."
msgstr "Um mapa em branco. Não parece muito útil."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLE"
msgid "Fancy!"
msgstr "Fino!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEBEAN"
msgid "I traded the old family cow for it."
msgstr "Eu troquei a velha vaca da família por isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "It looks carved."
msgstr "Parece entalhado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLEPILLAR"
msgid "I think I could use that."
msgstr "Acho que eu poderia usar isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLESHRUB"
msgid "Makes sense to me."
msgstr "Faz sentido pra mim."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARBLETREE"
msgid "I don't think an axe will cut it."
msgstr "Acho que um machado não vai cortar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.BURNING"
msgid "That's burning fast!"
msgstr "Está queimando muito rápido!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "It looks thorny."
msgstr "Parece espinhoso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Ouch."
msgstr "Autch."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_PLANT"
msgid "It's a plant."
msgstr "É uma planta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.BURNING"
msgid "Spikes and fire!"
msgstr "Espinhos e fogo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.BURNT"
msgid "Now it's burnt and spiky."
msgstr "Agora está queimada e espinhenta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Not so spiky now!"
msgstr "Não está tão espinhenta agora!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MARSH_TREE.GENERIC"
msgid "Those spikes look sharp!"
msgstr "Esses espinhos parecem afiados!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELL"
msgid "I hate that guy."
msgstr "Odeio esse cara."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLHEAD"
msgid "I can see into his pores."
msgstr "Consigo ver em seus poros."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLLIGHT"
msgid "I wonder how they work."
msgstr "Como será que funciona?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLLOCK"
msgid "Looks almost like a key hole."
msgstr "Até parece um buraco de fechadura."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "So that's where the music was coming from."
msgstr "Então era daí que a música estava vindo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLTHRONE"
msgid "That doesn't look very comfortable."
msgstr "Isso não me parece muito confortável."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAT"
msgid "It's a bit gamey, but it'll do."
msgstr "É meio cacento, mas vai servir."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATBALLS"
msgid "It's just a big wad of meat."
msgstr "É só um grande naco de carne."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.BURNT"
msgid "The rack got dried."
msgstr "O cavalete secou."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DONE"
msgid "Jerky time!"
msgstr "Hora do charque!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYING"
msgid "Meat takes a while to dry."
msgstr "A carne demora um pouco para secar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Meat takes even longer to dry in rain."
msgstr "A carne demora ainda mais para secar com chuva."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.GENERIC"
msgid "I should dry some meats."
msgstr "É melhor eu secar um pouco de carne."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEAT_DRIED"
msgid "Just jerky enough."
msgstr "Charqueado o suficiente."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERM"
msgid "Smells fishy!"
msgstr "Tem um cheiro estranho!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHEAD.BURNT"
msgid "Burnt merm flesh somehow smells even worse."
msgstr "Carne de sereio queimada de alguma forma tem um cheiro ainda pior."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHEAD.GENERIC"
msgid "The stinkiest thing I'll smell all day."
msgstr "A coisa mais fedida que vou cheirar hoje."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHOUSE.BURNT"
msgid "Nothing to live in, now."
msgstr "Não sobrou nada agora."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Who would live here?"
msgstr "Quem será que vive aqui?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.FULL"
msgid "It seems to be popular over there."
msgstr "Parece ser popular por aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.GENERIC"
msgid "If I had any friends, this could take me to them."
msgstr "Se eu tivesse amigos, isso poderia me levar a eles."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.OPEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MIGRATION_PORTAL.OPEN"
msgid "If I step through, will I still be me?"
msgstr "Se eu atravessar, ainda serei eu mesmo?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINERHAT"
msgid "A hands-free way to brighten your day."
msgstr "Uma maneira de melhorar seu dia sem as mãos."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINIFAN"
msgid "Somehow the breeze comes out the back twice as fast."
msgstr "De alguma forma a brisa sai por trás duas vezes mais rápido."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN.GENERIC"
msgid "I could draw better than that!"
msgstr "Eu desenho melhor que isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN.UNDRAWN"
msgid "We should draw something on there."
msgstr "Devíamos desenhar algo aí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINISIGN_ITEM"
msgid "It's not much use like this. We should place it."
msgstr "Não tem muita utilidade desse jeito. Deveríamos colocá-la."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAUR"
msgid "That thing doesn't look happy."
msgstr "Esse cara não parece feliz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAURCHEST"
msgid "It may contain a bigger something fantastic! Or horrible."
msgstr "Pode conter um algo fantástico maior! Ou horrível!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MINOTAURHORN"
msgid "Wow! I'm glad that didn't gore me!"
msgstr "Uau! Que bom que isso não me espetou!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.ABOVEGROUND"
msgid "I'd sure like to whack that mole... thing."
msgstr "Eu adoraria acertar essa toupeira."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.HELD"
msgid "Nowhere left to dig, my friend."
msgstr "Não há mais nada para cavar, meu amigo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLE.UNDERGROUND"
msgid "Something's under there, searching for minerals."
msgstr "Tem algo ali embaixo, procurando por minerais."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLEHAT"
msgid "A wretched stench, but excellent visibility."
msgstr "Tem um cheiro horrível, mas a visibilidade é ótima."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOLEHILL"
msgid "What a nice, homey hole in the ground!"
msgstr "Que buraco lindo e aconchegante no chão!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONKEY"
msgid "Curious little guy."
msgstr "Carinha curioso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONKEYBARREL"
msgid "Did that just move?"
msgstr "Aquilo se moveu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERLASAGNA"
msgid "It's an affront to science."
msgstr "É uma afronta á ciência."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERMEAT"
msgid "Ugh. I don't think I should eat that."
msgstr "Eca. Não acho que eu deva comer isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Strange-smelling jerky."
msgstr "Esse charque tem um cheiro estranho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.BROKEN"
msgid "It's all smashed up."
msgstr "Está toda destruída."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.GENERIC"
msgid "There's a hole in the middle for something to go in."
msgstr "Tem um buraco no meio pra colocar algo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The stone lit it up somehow."
msgstr "A rocha a acendeu de alguma forma."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.STAFFED"
msgid "Now what?"
msgstr "E agora?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "I have a distinct feeling this isn't right."
msgstr "Tenho a nítida impressão de que isso não está certo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.CAVE"
msgid "There's no moon down here to measure."
msgstr "Não há lua aqui embaixo pra medir."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.GENERIC"
msgid "Water amplifies the science, allowing us to measure the moon."
msgstr "A água amplifica a ciência, nos permitindo que meçamos a lua."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "It's a full moon."
msgstr "É uma lua cheia."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "It's a new moon."
msgstr "É uma lua nova."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is waning."
msgstr "A lua está minguando."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing."
msgstr "A lua está crescendo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKCRATER"
msgid "I should stick something shiny in it. For research."
msgstr "Eu devia enfiar algo brilhante lá. Para fins de pesquisa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKIDOL"
msgid "I only worship science."
msgstr "Venero apenas a ciência."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKNUGGET"
msgid "That rock came from the moon."
msgstr "Essa rocha veio da Lua."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCKSEED"
msgid "There's science inside!"
msgstr "Tem ciência no interior!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOONROCK_PIECES"
msgid "I could probably break that."
msgstr "Talvez eu devesse quebrar isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSE"
msgid "I don't exactly know what that thing is."
msgstr "Não sei exatamente o que é isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSEEGG"
msgid "The babies are like excited electrons trying to escape."
msgstr "Seus filhotes são como elétrons ativos tentando fugir."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "It puts its babies there."
msgstr "Ela coloca os bebês ali."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITO.GENERIC"
msgid "Disgusting little bloodsucker."
msgstr "Sugadorzinho de sangue nojento."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITO.HELD"
msgid "Hey, is that my blood?"
msgstr "Ei, esse sangue é meu?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSQUITOSACK"
msgid "It's probably someone else's blood..."
msgstr "Provavelmente é o sangue alheio..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOSSLING"
msgid "Aaah! You are definitely not an electron!"
msgstr "Arrá! Você definitivamente não é um elétron!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOUND.DUG"
msgid "He probably deserved it."
msgstr "Ele provavelmente mereceu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MOUND.GENERIC"
msgid "I bet there's all sorts of good stuff down there!"
msgstr "Aposto que tem um monte de coisa legal lá embaixo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "This ought to be a scientific impossibility."
msgstr "Isso só pode ser uma impossibilidade científica."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "I'm sure there's some scientific explanation for this."
msgstr "Tenho certeza que há uma explicação científica para isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It's brilliant!"
msgstr "É brilhante!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMBOMB"
msgid "A mushroom cloud in the making!"
msgstr "Uma nuvem de cogumelos em preparação!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMHAT"
msgid "Makes the wearer look like a fun guy."
msgstr "Deixa o usuário engraçado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "How im-morel!"
msgstr "Que estupidez!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "How scientific!"
msgstr "Que científico!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "The power of science compelled it."
msgstr "O poder da ciência o compeliu."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It could use a spore. Or a mushroom transplant."
msgstr "Um esporo seria útil. Ou um transplante de cogumelo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "The mushrooms have really taken to the log."
msgstr "Os cogumelos gostaram mesmo do tronco."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "The log is dead. We should replace it with a live one."
msgstr "O tronco está morto. Deveríamos substituí-lo por um novo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "I don't think it can grow in this cold."
msgstr "Acho que não consegue crescer nesse frio."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "It should keep growing now."
msgstr "Deveria continuar a crescer agora."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "That's a lot of mushrooms!"
msgstr "São muitos cogumelos!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Comboletely burnt."
msgstr "Comboletamente queimado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "It's a big, science-y 'shroom."
msgstr "É um grande cogumelo da ciência."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Science makes it light up."
msgstr "A ciência o faz brilhar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "I didn't mildew it, I swear."
msgstr "Aposto que está só fungindo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "We could make a prime light source with some primary colors."
msgstr "Poderíamos criar uma fonte de luz eficiente com algumas cores primárias."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Blue is obviously the most scientific color."
msgstr "Azul é obviamente a cor mais científica."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "I'm mildly offended by this."
msgstr "Me sinto levemente ofendido com isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "These used to grow in my bathroom."
msgstr "Isso costumava aparecer no meu banheiro."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "It's trying to reproduce."
msgstr "Está tentando reproduzir."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "A magic mushroom?"
msgstr "Um cogumelo mágico?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "You can't tell from far away, but it's quite smelly."
msgstr "Não dá pra dizer de longe, mas é bem fedorento."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "That mushroom got too big for its own good."
msgstr "Esse cogumelo é muito grande para o seu próprio bem."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "The spiders thought this one was important."
msgstr "As aranhas pensaram que esse era importante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTLIGHT"
msgid "It gives off a spooky light."
msgstr "Ela emite uma luz assustadora."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMAREFUEL"
msgid "This stuff is crazy!"
msgstr "Que bagulho doido!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARELIGHT"
msgid "I wonder what function this served."
msgstr "Para que será que servia isso?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "All is well."
msgstr "Tudo está bem."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "The nightmare is almost gone!"
msgstr "O pesadelo está quase terminando!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "There's no magic around here."
msgstr "Não tem magia por aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It seems to be staying steady."
msgstr "Parece que está estabilizando."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Feels like it's receding."
msgstr "Parece que está diminuindo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "Getting pretty magical around here."
msgstr "As coisas estão ficando bem mágicas por aqui."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "It's becoming more concentrated!"
msgstr "Está ficando mais concentrado!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTSTICK"
msgid "It's electric!"
msgstr "É elétrico!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NIGHTSWORD"
msgid "Why would anyone make this? It's terrifying."
msgstr "Por que alguém faria isso? É assustador."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.NITRE"
msgid "I'm not a geologist."
msgstr "Não sou geólogo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.OASISLAKE"
msgid "Is that a mirage?"
msgstr "É uma miragem?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONEMANBAND"
msgid "We should add a beefalo bell."
msgstr "Devíamos colocar um sino de bífalo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.OPALPRECIOUSGEM"
msgid "This gem seems special."
msgstr "Esta pedra preciosa parece ser especial."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.OPALSTAFF"
msgid "It's scientifically proven that gems look better on top of sticks."
msgstr "Está cientificamente provado que pedras preciosas ficam melhores na ponta de gravetos."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEAMULET"
msgid "Teleportation can be so useful."
msgstr "O teletransporte pode ser muito útil."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEGEM"
msgid "It's an orange gem."
msgstr "É uma pedra preciosa laranja."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGEMOONEYE"
msgid "No one could get lost with that thing looking out for them."
msgstr "Ninguém poderia se perder com essa coisa de olho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ORANGESTAFF"
msgid "This beats walking."
msgstr "É melhor que caminhar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PANDORASCHEST"
msgid "It may contain something fantastic! Or horrible."
msgstr "Pode conter algo fantástico! Ou horrível."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PANFLUTE"
msgid "To serenade the animals."
msgstr "Posso encantar os animais."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PAPYRUS"
msgid "Some sheets of paper."
msgstr "Algumas folhas de papel."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEGHOOK"
msgid "That spit is corrosive!"
msgstr "Esse cuspe é corrosivo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PENGUIN"
msgid "Must be breeding season."
msgstr "Deve ser temporada de procriação."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERD"
msgid "Stupid bird! Stay away from those berries!"
msgstr "Pássaro idiota! Fique longe das minhas bagas!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDFAN"
msgid "It's inordinately large."
msgstr "É desmedidamente grande."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.BURNT"
msgid "That won't do at all."
msgstr "Isso não vai servir pra nada."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.EMPTY"
msgid "I've got to plant something there."
msgstr "Preciso plantar alguma coisa aí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I feel like it wants something."
msgstr "Sinto que está querendo algo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PEROGIES"
msgid "These turned out pretty good."
msgstr "Esses ficaram muito bons."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETALS"
msgid "Sure showed those flowers who's boss!"
msgstr "Com certeza mostrou praquelas flores quem manda!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETALS_EVIL"
msgid "I'm not sure I want to hold those."
msgstr "Não tenho certeza se quero segurar isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PETRIFIED_TREE"
msgid "It looks scared stiff."
msgstr "Quase morreu de susto."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PHLEGM"
msgid "It's thick and pliable. And salty."
msgstr "É grosso e flexível. E salgado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PICKAXE"
msgid "Iconic, isn't it?"
msgstr "Icônico, não?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE1"
msgid "What are you looking at?"
msgstr "O que está olhando?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE2"
msgid "He's got gold fever!"
msgstr "Ele está com a febre de ouro!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE3"
msgid "Here's mud in your eye!"
msgstr "Tem lama no seu olho!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGELITE4"
msgid "Wouldn't you rather hit someone else?"
msgstr "Você não prefere acertar outra pessoa?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGGUARD"
msgid "He doesn't look as friendly as the others."
msgstr "Ele não parece tão amistoso quanto os outros."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGGYBACK"
msgid "This little piggy's gone... \"home\"."
msgstr "Esse porquinho foi... pra \"casa\"."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHEAD.BURNT"
msgid "Crispy."
msgstr "Crocante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHEAD.GENERIC"
msgid "Looks like an offering to the beast."
msgstr "Parece uma oferenda à fera."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.BURNT"
msgid "Not so fancy now, pig!"
msgstr "Não é tão bacana agora, né, porco?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.FULL"
msgid "I can see a snout pressed up against the window."
msgstr "Estou vendo uma fuça grudada na janela."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.GENERIC"
msgid "These pigs have pretty fancy houses."
msgstr "Esses porcos têm umas casas bem chiques!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Come ON! I know you're home!"
msgstr "Qual é!? Eu sei que você está em casa!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGKING"
msgid "Ewwww, he smells!"
msgstr "Eca, que fedido!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.DEAD"
msgid "Someone should tell its family."
msgstr "Alguém deveria contar pra sua família."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.FOLLOWER"
msgid "You're part of my entourage."
msgstr "Você faz parte dos meus seguidores."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.GENERIC"
msgid "They kind of creep me out."
msgstr "Eles meio que me dão um frio na espinha."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.GUARD"
msgid "Looks serious."
msgstr "Parece sério!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGMAN.WEREPIG"
msgid "Not a friendly pig!!"
msgstr "Esse porco não é amistoso!!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.BURNT"
msgid "Burnt out."
msgstr "Carbonizado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It's hungry for meat."
msgstr "Está com fome de carne."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSHRINE.GENERIC"
msgid "More stuff to make."
msgstr "Mais coisas pra fazer."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGSKIN"
msgid "It still has the tail on it."
msgstr "Ainda está com a cauda."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGTENT"
msgid "Smells like bacon."
msgstr "Tem cheiro de bacon."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIGTORCH"
msgid "Sure looks cozy."
msgstr "Parece bem aconchegante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PIG_TOKEN"
msgid "This looks important."
msgstr "Isso parece importante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PINECONE"
msgid "I can hear a tiny tree inside it, trying to get out."
msgstr "Posso ouvir uma arvorezinha lá dentro, tentando sair."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PINECONE_SAPLING"
msgid "It'll be a tree soon!"
msgstr "Em breve será uma árvore!"

