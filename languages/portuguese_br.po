#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_SNACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_SNACK"
