msgstr "\"Siga as instruções\", a mamãe sempre dizia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.RARE"
