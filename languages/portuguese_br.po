msgstr "Parece uma boa safra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN"
