msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_PASTA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_PASTA"
msgid "Morte bene."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_PLATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_PLATE"
