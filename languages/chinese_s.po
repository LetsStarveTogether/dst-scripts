msgstr "他再也威胁不了任何人了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Dead as a doornail."
msgstr "死翘翘。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "You seen one, you seen'em all."
msgstr "看见一只，就能看见一群。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Sleeping on the job."
msgstr "干活时睡觉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Little too fancy for my tastes."
msgstr "精美过头了，我不太喜欢。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It's a bit salty, hey?"
msgstr "有点咸，是吧？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL"
msgid "I might not be good at rescue missions."
msgstr "我可能不擅长拯救。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Looks like it unlocks somethin' big."
msgstr "它好像能打开什么大东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT"
msgid "Could make a real big stew in that pot."
msgstr "用那个锅可以煮好大一份炖肉菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO"
msgid "I just think they're neat."
msgstr "我觉得它们挺不错的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "I've always been a meat and potatoes gal."
msgstr "本姑娘一直爱吃肉和土豆。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "我完全不知道它们会长成什么。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "Needs a pot in there or somethin'."
msgstr "那里要放个锅子什么的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Ready for assembly."
msgstr "可以组装了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "I only ever made stew before this."
msgstr "我以前从没做过炖肉菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Syrup makes me sappy. Ha!"
msgstr "糖浆让我多愁善感。哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "I am not a good farmer."
msgstr "我不擅长务农。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "It's busted."
msgstr "破了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Never thought I'd say this, but it's beyond repair."
msgstr "我没想到我会这样说，但这个确实修不了了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Well I sure ain't goin' in it now."
msgstr "反正我现在不会进去。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It's broken. I can't fix it."
msgstr "它坏了。我能修好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Needs a lot more love than I got to give it."
msgstr "它需要很多很多的爱，可我给不了那么多。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Something muddled this clockwork real good."
msgstr "什么东西把这座时钟整惨了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "Looks like something destroyed it."
msgstr "好像是什么东西把它摧毁了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Something happened here."
msgstr "这里发生过什么事情。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Ain't no one here anymore."
msgstr "这里空无一人了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Something busted this town."
msgstr "什么东西毁了这个小镇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "Even I can't fix it."
msgstr "连我都修不好它。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "I've repaired roofs before but this is a lost cause."
msgstr "我以前也修过屋顶，但这修不了了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Wouldn't mind a peek inside."
msgstr "我不介意往里面瞧一眼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "My lockpicking skills are a bit rusty."
msgstr "我的开锁技术有点生锈了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALMON"
msgid "It ain't pink. It's salmon! Ha!"
msgstr "它不是粉色的。是三文鱼色！哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Fancy dining."
msgstr "精致的美餐。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALT"
msgid "But where's the pepper?"
msgstr "胡椒粉呢？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It's a big ol' eatin' rock."
msgstr "这是一块能吃的巨石。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
