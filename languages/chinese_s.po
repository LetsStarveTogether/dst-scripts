msgstr "你是个大块头嘛。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
