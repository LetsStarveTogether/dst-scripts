msgstr "下次我再来收拾你！"

#. STRINGS.CHARACTERS.WILLOW.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WILLOW.COMBAT_QUIT.SPIDER"
