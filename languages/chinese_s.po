msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Anything interesting going on lately? Right, nope. Because you're a plant."
msgstr "最近有什么有趣的事吗？对，没有。因为你只是植物。"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Hey, rustle twice if you want to take a closer look at my lighter!"
msgstr "嘿，如果你想仔细看看我的打火机，就沙沙响两声吧!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THORNS"
msgid "Ouch!"
msgstr "哎哟！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_THURIBLE_OUT"
msgid "Awww! I liked that thing."
msgstr "呜呜呜！我喜欢那个。"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOADESCAPED"
msgid "Ughh! But I was winning!"
msgstr "啊啊！但是我快赢了！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOADESCAPING"
msgid "Don't even think about running, toad!"
msgstr "别想逃跑，蟾蜍！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOOL_SLIP"
msgid "Still got my lighter!"
msgstr "幸好打火机还没掉！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TORCH_OUT"
msgid "My precious light is gone!"
msgstr "我宝贵的光消失了！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Didja miss me?! Haha!"
msgstr "你想我吗？！哈哈！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_TRAP_WENT_OFF"
msgid "Aah!"
msgstr "啊！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! That stung ya jerk!"
msgstr "嗨！它刺痛了你这个混蛋！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WASHED_ASHORE"
msgid "Great, now I'm all wet."
msgstr "太好了，这下我全湿了。"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEAK_RAT"
msgid "That thing's looking kinda rough."
msgstr "那东西看起来有点不行。"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "重量：{weight}"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nUgh, this thing's heavy!"
msgstr "重量: {weight}\n啊, 这东西真重!"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WET"
msgid "This could be bad!"
msgstr "这可不是好事！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WETTER"
msgid "I hate it!"
msgstr "我讨厌这样子！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Aw, come on! I was close enough!"
msgstr "噢，可惜！我就差一点点！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Looks like I caught a whole lot of nothing."
msgstr "好像什么都没抓到。"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "It's like there's little sparks flying around me!"
msgstr "我的周围仿佛飞舞着火花！"

#. STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WILLOW.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Aw man. Guess it's time to get some real sparks flying!"
msgstr "嗷。也许我该弄点真的火花飞舞一下了！"

