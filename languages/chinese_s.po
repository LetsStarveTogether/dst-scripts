msgstr "哈！闻起来就像下班时的我！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA"
