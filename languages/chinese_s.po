msgstr "对，我们大概能吃那个。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
