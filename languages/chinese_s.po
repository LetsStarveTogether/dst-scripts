msgstr "这是有人雕刻过吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
