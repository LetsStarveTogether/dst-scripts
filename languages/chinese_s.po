msgstr "\"恶魔。现在你表里如一了。\""

#. STRINGS.SKIN_QUOTES.wx78_survivor
msgctxt "STRINGS.SKIN_QUOTES.wx78_survivor"
msgid "\"RUSTED AND BUSTED\""
msgstr "\"又锈又破\""

#. STRINGS.SKIN_QUOTES.wx78_victorian
msgctxt "STRINGS.SKIN_QUOTES.wx78_victorian"
msgid "\"PREPARING TO DIVE\""
msgstr "\"准备潜水\""

#. STRINGS.SKIN_QUOTES.wx78_wip
