msgstr "这个更像是我的风格！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHT"
