msgstr "那已经是历史了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN"
