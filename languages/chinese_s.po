msgstr "那个……这个地图一点也不对！"

#. STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "But that big ugly thing is on my tail!"
msgstr "但是那个又大又丑的东西追着我后面跑！"

#. STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
