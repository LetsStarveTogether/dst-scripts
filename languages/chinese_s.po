msgstr "粗制滥造的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
