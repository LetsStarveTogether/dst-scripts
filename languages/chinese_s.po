msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "This'll do the trick."
msgstr "那会成功的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "I'll be extra careful with that one."
msgstr "那个东西我会格外小心。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "If I'm gonna catch fish, I may as well catch the biggest one!"
msgstr "非要我抓鱼，我就抓最大的鱼！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "Sure wish it rained fish, not just cats and dogs."
msgstr "我也希望天上能下鱼，别下太多应该就没事。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "At least fishing is more productive than taking a snow day."
msgstr "钓鱼至少比下雪天请假要有意义。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "Not that lifelike, but it fools the fish."
msgstr "做工有点粗糙，但是能骗过鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGROD"
msgid "The right tool for the job!"
msgstr "干活利器！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Here's hoping it tastes better than it looks."
msgstr "看着丑，希望味道好吃点吧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "Now that's a nice fat fish!"
msgstr "钓上一条肥美的鱼！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "Yeesh, I'd better watch the spines on that thing!"
msgstr "咦，我要小心它身上的脊椎！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "Never been much for superstition."
msgstr "从来不迷信。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Never had to shuck a fish before."
msgstr "以前从来没刮过鳞。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Looks like one of those fish rich people put in ponds."
msgstr "看着像有钱人池塘里养的鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Looks like one of those fish rich people put in ponds."
msgstr "看着像有钱人池塘里养的鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It's an ice fish if I do say so myself. Ha!"
msgstr "这是一条冰鱼。哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_1"
msgid "A little on the puny side, ain't it?"
msgstr "有点小了，是不是？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_2"
msgid "Not a lot of meat on that one."
msgstr "没什么肉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3"
msgid "It's just a teeny thing!"
msgstr "就是一个小家伙！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_4"
msgid "My fish dinner might be a bit lean..."
msgstr "晚餐吃这条鱼肉有点少……"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Not sure that fish is healthy."
msgstr "不确定那条鱼健不健康。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_6"
msgid "Huh. Never heard a fish rustle before."
msgstr "哈。从来没听过沙沙作响的鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Aww, it's kinda cute!"
msgstr "噢，有点可爱呢！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_8"
msgid "That thing's a fire hazard!"
msgstr "这东西是火灾隐患啊！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_9"
msgid "That thing sure can spit!"
msgstr "那东西真会吐口水！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND"
msgid "I ain't musically inclined."
msgstr "我不通乐理。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION"
msgid "I hate chopping vegetables."
msgstr "我讨厌切蔬菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_COOKED"
msgid "Done and done."
msgstr "被砍倒了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_OVERSIZED"
msgid "Who's gonna draw the short straw and have to cut that thing?"
msgstr "谁会抽出短签，然后把那东西切掉？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "我完全不知道它们会长成什么。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM"
msgid "Pretty! Pretty useless."
msgstr "好看！但不中用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF"
msgid "Did it just get chillier?"
msgstr "是不是变冷了？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET"
msgid "For those with a lackluster work ethic."
msgstr "适合那些缺乏工作热情的人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM"
msgid "I don't like it."
msgstr "我不喜欢它。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE"
msgid "You lookin' at me?"
msgstr "你在看我？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF"
msgid "For people who fear good, honest work."
msgstr "适合那些不愿意踏实工作的人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST"
msgid "Best not open that."
msgstr "最好不要打开它。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANETTONE"
msgid "Huh. Some kinda fancy-shmancy holiday bread?"
msgstr "哈。花里胡哨的假日面包？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE"
msgid "Let's see if I can't play a little ditty."
msgstr "让我来试试能不能奏个小曲儿。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS"
msgid "I don't have much use for that, personally."
msgstr "它对我个人没什么用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PAVLOVA"
msgid "Is cake supposed to crunch? Not that I'm complainin!"
msgstr "蛋糕碎裂是正常的么？我不是抱怨！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK"
msgid "That acid stuff burns!"
msgstr "那家伙的酸液有腐蚀性！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN"
msgid "I don't mix well with the upper class."
msgstr "我跟上流社会的家伙处不来。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER"
msgid "Ye-hooo! They gotta a kick to 'em."
msgstr "耶呼！这个东西味道很足。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPERPOPPER"
msgid "My mouth's havin' a party!"
msgstr "我的嘴巴欢腾开了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_COOKED"
msgid "Just the smell is making my eyes water."
msgstr "闻闻我的眼睛都湿了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_OVERSIZED"
msgid "I'd bet that pepper packs a punch!"
msgstr "我敢打赌它一定很辣！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_SEEDS"
msgid "Wonder what these'll make."
msgstr "好奇会长出什么呢。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD"
msgid "The light's on but no one's home."
msgstr "灯亮着，但家里没人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN"
msgid "It's a big fan made of tailfeathers."
msgstr "用尾羽做的扇子。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT"
msgid "Smells like burnt gobbler."
msgstr "闻起来像烧焦的火鸡。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We oughta put a bush in there."
msgstr "我们该在那放些灌木。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I feel luckier already."
msgstr "我已经感觉到好运降临了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES"
msgid "You work up a mighty appetite at the factory."
msgstr "在工厂里工作，胃口会很大的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS"
msgid "Don't see a whole lotta use for these."
msgstr "看不出这东西有多少用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL"
msgid "They seem mean-spirited."
msgstr "看起来挺邪恶的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE"
msgid "Solid stone."
msgstr "坚硬的石头。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM"
msgid "Please. I hock bigger loogies in my sleep."
msgstr "拜托，我睡觉时咳出来的痰都比这多。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE"
msgid "Not my preferred kind of manual labor."
msgstr "不是我喜欢的那种劳动。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKLEDHERRING"
msgid "It's actually not bad!"
msgstr "味道真不赖！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1"
msgid "Swell tattoos you got there."
msgstr "你的纹身很好看。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2"
msgid "Chill out, red."
msgstr "冷静下来，红毛猪。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3"
msgid "He's giving me a dirty look."
msgstr "他给了我一个狠狠的眼神。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4"
msgid "Stand still so I can hit you with a sign."
msgstr "站着别动，这样我就可以用牌子打你了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER1"
msgid "Swell tattoos you got there."
msgstr "你的纹身很好看。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER2"
msgid "Chill out, red."
msgstr "冷静下来，红毛猪。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER3"
msgid "He's giving me a dirty look."
msgstr "他给了我一个狠狠的眼神。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER4"
msgid "Stand still so I can hit you with a sign."
msgstr "站着别动，这样我就可以用牌子打你了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD"
msgid "You don't look so tough."
msgstr "你看起来也没多厉害。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK"
msgid "Makes everything smell like pig."
msgstr "让里面的东西都染上猪的气味。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT"
msgid "What a waste of materials."
msgstr "真是浪费材料。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC"
msgid "I should hammer down that eyesore."
msgstr "我最好要去掉那个丑瞎了的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT"
msgid "That's a shame."
msgstr "真可惜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL"
msgid "Fuller than a downtown tenement house."
msgstr "比市中心的群租房还挤。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC"
msgid "No way that's up to code."
msgstr "一看就不合规格。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Hey! I just want some light!"
msgstr "嘿！给我一点光！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING"
msgid "Those hooves've never seen a day of work."
msgstr "这些家伙从没干过一天活。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD"
msgid "That threw a wrench into his plans."
msgstr "看来他的计划完不成了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Chummy fellow!"
msgstr "友好的同伴！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC"
msgid "Hey there, ya lug!"
msgstr "你好啊，傻大个！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD"
msgid "Don't want no trouble."
msgstr "我可不想惹事。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG"
msgid "I have no idea what's going on!"
msgstr "我完全不知道怎么回事！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT"
msgid "No good now."
msgstr "现在没什么用了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY"
msgid "I gotta find some meat for it."
msgstr "我得为它找些肉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A bunch of things to build."
msgstr "一堆东西要建造。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN"
msgid "The backside of an oinker."
msgstr "猪猪的皮。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTENT"
msgid "Yeesh, smells ripe in there."
msgstr "咦，闻起来真臭。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH"
msgid "Kitschy."
msgstr "俗气。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_COIN"
msgid "Not bad payment for a good wrassle."
msgstr "摔跤赢来的不赖的奖品。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN"
msgid "Too big for me to wear."
msgstr "太大了，我戴不上。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE"
msgid "That's a pine cone."
msgstr "一颗松果。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING"
msgid "It can handle itself from here."
msgstr "它可以自力更生的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK"
msgid "It's so... rural."
msgstr "真是……乡土味十足。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT"
msgid "This is beyond confusing."
msgstr "好让人困惑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED"
msgid "It cooked up pretty good."
msgstr "烹饪过后显得很不错。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTREGISTRYHAT"
msgid "Better fill my noggin' with some planting know-how."
msgstr "赶紧往脑子里塞一点种植技巧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "It's a plant."
msgstr "这是一株植物。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It's hard at work."
msgstr "它在努力生长。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY"
msgid "Good to go."
msgstr "长成了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's a bit hot out."
msgstr "有点被热坏了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER"
msgid "Hands to yourself, bucko!"
msgstr "老实点，老兄！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER"
msgid "You better not have singed any of my projects, %s."
msgstr "你最好没有烧掉我的计划项目，%s。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC"
msgid "Hey, %s! How ya doin'?"
msgstr "嘿，%s！你好吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST"
msgid "Stop whinin', %s, it's just a scratch!"
msgstr "别抱怨了，%s，皮肉伤而已！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! Get'em!"
msgstr "凶手！别跑！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER"
msgid "You're good people, %s."
msgstr "你是好人，%s。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POCKET_SCALE"
msgid "What a handy doo-hickey!"
msgstr "多么方便的工具！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POLISHCOOKIE"
msgid "Tasty!"
msgstr "好吃！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE"
msgid "Eat that and you're stuck here forever!"
msgstr "把它吃了，你就永远困在这了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_COOKED"
msgid "It does look pretty tempting."
msgstr "看起来非常诱人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "That's one pumped up pomegranate."
msgstr "膨胀了的石榴。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POMEGRANATE_SEEDS"
msgid "A handful of seeds."
msgstr "一把种子。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POND"
msgid "I can't see the bottom."
msgstr "我看不到底。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDEEL"
msgid "You're looking a little eel. Ha!"
msgstr "你看起来“鳗”悠悠的。哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PONDFISH"
msgid "I'd rather eat for a day than not at all."
msgstr "我宁愿一天吃到晚，也不愿意啥都没的吃。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POND_ALGAE"
msgid "Ha! Gross."
msgstr "哈！恶心。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POOP"
msgid "Nothing to be ashamed of."
msgstr "没什么好难为情的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "I like the way that machine dances."
msgstr "我喜欢那个机器的舞步。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "All good things take time."
msgstr "慢工出细活。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "This'll be done lickety-split!"
msgstr "很快就能做好！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Let's see if all that fuss was worth it."
msgstr "我们来看看费那么的大力气值不值。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Could use some ingredients in there."
msgstr "巧妇难为无米之炊。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "A fancy pot for some fancy cookin'."
msgstr "花哨的锅，适合做花哨的菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Well worth all that work."
msgstr "也算没白辛苦。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Probably a whole lot of interesting gears in there."
msgstr "里面应该有不少有趣的机关。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT"
msgid "Aw, this reminds me of campin' with Charlie when we were little..."
msgstr "哦，这让我想起了我们小时候和查理一起露营的情景……"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PORTABLETENT_ITEM"
msgid "Need any help settin' that up?"
msgstr "要帮你搭起来吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO"
msgid "I just think they're neat."
msgstr "我觉得它们挺不错的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOSOUFFLE"
msgid "Looks great, Warly!"
msgstr "看起来很棒，沃利！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATOTORNADO"
msgid "Count on Warly's cookin' to always make my day."
msgstr "沃利做的东西吃一下"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_COOKED"
msgid "I've always been a meat and potatoes gal."
msgstr "本姑娘一直爱吃肉和土豆。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POTATO_OVERSIZED"
