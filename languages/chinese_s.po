msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING"
msgid "Yuck!"
msgstr "呸！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING_COOKED"
msgid "Still yuck!"
msgstr "还是令人生厌！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARDHAIR"
msgid "Clean up your gross hair guys! Ugh!"
msgstr "整理下你的长毛，朋友！啊呸！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER"
msgid "Whoa! Niiiice bear..."
msgstr "哇哦！好...大的熊..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERVEST"
msgid "It's like swimming in fur."
msgstr "就像在软软的毛皮里面游泳一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER_FUR"
msgid "It's fur all the way down."
msgstr "全都是毛皮。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_FURRY"
msgid "It's too frilly."
msgstr "褶边太多了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_STRAW"
msgid "Musty."
msgstr "一股霉臭味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.GENERIC"
msgid "It's fat, but that stinger looks dangerous."
msgstr "很肥的蜜蜂，不过它的刺看起来很危险。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.HELD"
msgid "Pocket full of bees!"
msgstr "满袋子的蜜蜂！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.BURNT"
msgid "Smoked you out!"
msgstr "用烟把你熏出来！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Yay! Let's steal honey!"
msgstr "耶！让我们偷蜂蜜吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.GENERIC"
msgid "Come on fat bees, make honey!"
msgstr "赶紧的，肥蜜蜂，赶紧给产蜂蜜！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.NOHONEY"
msgid "Nothing to see here."
msgstr "这儿什么也没有。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.READY"
msgid "Yay! Let's steal honey!"
msgstr "耶！让我们偷蜂蜜吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Patience."
msgstr "耐心点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "It's lost the fire from its heart."
msgstr "它失去了心头的火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Er, are you following me?"
msgstr "呃，你在跟着我吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.GENERIC"
msgid "What a disgusting, hairy beast!"
msgstr "多么恶心的长毛野兽！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.NAKED"
msgid "Ha! He's all naked now!"
msgstr "哈！他身上一根毛也没有了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.ORNERY"
msgid "I can see fire in its eyes."
msgstr "我在它的眼睛里可以看到火焰！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.PUDGY"
msgid "You need to burn some calories."
msgstr "你需要燃烧点卡路里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.RIDER"
msgid "Let's go!"
msgstr "出发！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.SLEEPING"
msgid "They look even dumber when they're sleeping."
msgstr "它们睡着的时候样子更傻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOHAT"
msgid "Beast hair to go over people hair!"
msgstr "野兽毛发变成人类头发！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOWOOL"
msgid "Ha! Its owner is probably naked somewhere. Or dead."
msgstr "哈！它的主人要么在哪光着身子呢，要么就死掉了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD"
msgid "Puffy flying jerk!"
msgstr "讨厌的飞行蠢货！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT"
msgid "This will keep the pokeys off of me."
msgstr "这可以防止那些蜇人的蜜蜂接近我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE"
msgid "It's full of bees!"
msgstr "里面全是蜜蜂！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE"
msgid "Bees inside. Should've put some fire in there for good measure."
msgstr "里面有蜜蜂。应该再往那里放点火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL"
msgid "Mosquitoes inside. They don't sound happy."
msgstr "里面有蚊子。它们听起来可不太高兴。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN"
msgid "No amount of honey is worth THAT!"
msgstr "即使是再多的蜂蜜也值得！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "It all came from a bee's butt."
msgstr "它都来自蜜蜂的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Ew, burn it before it gets any bigger!"
msgstr "呃，在它变得更大前把它烧掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Dare you guys to smack it with a hammer."
msgstr "你们这些家伙居然敢用锤子敲击它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX"
msgid "That's none of my beeswax."
msgstr "那不是我的蜂蜡。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEETLETAUR"
msgid "Bet you think you're safe in all that armor."
msgstr "你穿着这身盔甲肯定很安全吧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BELL"
msgid "Is it New Year's Eve? Are there FIREWORKS?!"
msgstr "这是除夕吗？会有焰火吗？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_ACTIVE"
msgid "Help me, Bernie!"
msgstr "伯尼，帮我！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "I need to fix Bernie up."
msgstr "我得把伯尼修理好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "My childhood buddy - Bernie!"
msgstr "我的小兄弟——伯尼！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES"
msgid "Red berries taste the best."
msgstr "红色浆果最好吃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_COOKED"
msgid "Red berries with fire somehow taste even better."
msgstr "烤过之后的红色浆果味道更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY"
msgid "Mmm. They pop in your mouth."
msgstr "嗯。它们很快进到嘴巴里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Fire improves everything."
msgstr "有了火，一切都变好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BARREN"
msgid "Eat poop, stupid plant!"
msgstr "吃屎吧，愚蠢的植物！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BURNING"
msgid "Yes!! Burn!!"
msgstr "就是这样！烧吧!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Burn the sick!"
msgstr "烧掉患病的这些！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Blech. You smell."
msgstr "胡说。你闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Mmmmm. Berries."
msgstr "嗯。浆果。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.PICKED"
msgid "But I want more berries!"
msgstr "但我想要更多的浆果！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.WITHERED"
msgid "All dried out. Primed for fire!"
msgstr "全部干枯了。正好用来点火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Did I say you could stop growing?!"
msgstr "我说过你可以停止生长吗？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Yes!! Burn!!"
msgstr "就是这样！烧吧!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Burn the sick!"
msgstr "烧掉患病的这些！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Blech. You smell."
msgstr "胡说。你闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Ready for picking!"
msgstr "可以采摘了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Make mooooore!"
msgstr "再多点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It's burning up."
msgstr "它烧起来了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT"
msgid "What in the world!"
msgstr "那究竟是个什么鬼！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE"
msgid "Aaah! Set it on fire!"
msgstr "啊！烧死它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD"
msgid "At least he's quiet now."
msgstr "至少他现在安静了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Bird prison!"
msgstr "鸟的牢笼！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about?"
msgstr "闹腾什么呢？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Ha! Gotcha now!"
msgstr "哈！抓到你了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That should probably be cleaned up."
msgstr "那个应该可以被清理干净。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Stupid bird. Wake up!"
msgstr "蠢鸟。醒醒！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.STARVING"
msgid "He won't be quiet!"
msgstr "它不肯安静！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP"
msgid "Gonna catch those creepy birds."
msgstr "要抓住那些臭鸟的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG"
msgid "It smells like a bird's butt."
msgstr "闻起来像鸟屁股一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED"
msgid "Yuck. The yellow part is all runny."
msgstr "呸。黄色的部分还没凝固。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP"
msgid "It's a bishop!"
msgstr "是主教！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Owwww!"
msgstr "哎哟！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Ahhh!"
msgstr "啊——！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE"
msgid "That's my favorite thing in the whole wide world."
msgstr "那是全世界我最喜欢的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA"
msgid "Ptoo! Now you're dead!"
msgstr "卟突！这下你死翘翘了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2"
msgid "Ooh, the firepower!"
msgstr "喔，火的力量！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE"
msgid "Good practice for blowing into a fire."
msgstr "练好这个，给火吹风就不费劲了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP"
msgid "Tranquilized things are easier to light on fire."
msgstr "被催眠的东西容易点火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW"
msgid "Lightning is sort of like fire."
msgstr "闪电有点儿像火焰。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET"
msgid "Boo to this."
msgstr "切。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM"
msgid "Ugh. This one is ugly."
msgstr "呃，这玩意儿好丑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE"
msgid "That's not an eyeball! It's a rock!"
msgstr "那不是一个眼球！它是岩石！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON"
msgid "This will save some experimentation."
msgstr "这可以省去一些实验。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE"
msgid "Woah. It doesn't burn!!"
msgstr "哇。它没有燃烧！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP"
msgid "It smells like a gym sock!"
msgstr "一股运动后的臭袜子的味道！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED"
msgid "Transformed by fire!"
msgstr "通过火来变形！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Dumb mushroom."
msgstr "愚蠢的蘑菇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hey! You! Get up here!"
msgstr "喂！你！给我出来！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也许有一天它会再长回来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS"
msgid "Boards. They'll burn, same as other wood."
msgstr "木板。它们也会燃烧，就和其他木材一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON"
msgid "Keep that snout to yourself!"
msgstr "收起你那个鼻子！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR"
msgid "He looks pretty haggard."
msgstr "他看起来挺憔悴的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT"
msgid "Must. Resist. Urge. To. Burn."
msgstr "必须抵抗烧了它的冲动。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD"
msgid "I don't think they make good tinder."
msgstr "我不相信它们可以做成引火物。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW"
msgid "Just add fire to food and voila!"
msgstr "只需要给食物加把火，瞧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS"
msgid "Less reading, more burning!"
msgstr "少读！多烧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE"
msgid "That's my favorite book!"
msgstr "这是我最喜欢的书！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL"
msgid "Looks interesting, for a book."
msgstr "这本书好像挺有趣的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL"
msgid "Looks like kindling to me."
msgstr "在我看来好像点火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING"
msgid "Ughh, who cares?"
msgstr "哦，谁在乎？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP"
msgid "Bo-oring!"
msgstr "无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES"
msgid "Looks like kindling to me!"
msgstr "在我看来好像点火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG"
msgid "It's not the most exciting weapon."
msgstr "它不是最让人兴奋的武器。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH"
msgid "It smells like burnt hair."
msgstr "它闻起来像头发烧焦的味道。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET"
msgid "Doesn't fit over Webber's big head."
msgstr "不适合韦伯那个大脑袋。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE"
msgid "Now I can burn a bunch of things in one go!"
msgstr "现在我一次可以烧一捆东西了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP"
msgid "We could hide some gross things, I guess."
msgstr "我们可以把一些糟糕的东西藏起来，我猜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN"
msgid "Ugh. They look so stupid."
msgstr "呃，它们看起来好蠢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT"
msgid "Too passive!"
msgstr "太被动了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER"
msgid "Tasty, and just a little bit insecty."
msgstr "很美味，只是有点昆虫的味道。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter away, butterfly!"
msgstr "飞走吧，蝴蝶！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD"
msgid "I want to squish it."
msgstr "我想捏它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Heehee, look at that butterfly stuck in the muffin."
msgstr "嘻嘻，看起来像蝴蝶被困在松饼里面一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS"
msgid "No more flying for that butterfly!"
msgstr "那只蝴蝶不会再飞了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD"
msgid "Your neck is gross."
msgstr "你的脖子太难看了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC"
msgid "Spines! My weakness! How did you know?"
msgstr "尖刺！这是我的弱点！你是怎么知道的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED"
msgid "We'll call it a tie."
msgstr "我们扯平了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER"
msgid "Yet another flower."
msgstr "又是一种花。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT"
msgid "It still looks dangerous."
msgstr "它看起来还是很危险。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "It seems fine now."
msgstr "现在闻起来还不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "啊哦。就快要熄灭了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I like fire."
msgstr "我喜欢火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "烧吧！烧得再旺点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW"
msgid "This fire is small and boring."
msgstr "火太小了，真无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Burn!"
msgstr "烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT"
msgid "Awww. It's all over."
msgstr "呜呜呜。一切都结束了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC"
msgid "If it kicks the bucket I'm outta here."
msgstr "如果它踢桶，我就从这里出去。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD"
msgid "You still breathing? Just checking."
msgstr "你还活着？检查一下。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED"
msgid "Is that infectious? We should burn it."
msgstr "那会传染吗？我们应该烧了它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG"
msgid "I'm gonna stuff so much candy in there!"
msgstr "我要把那里面塞满这么多的糖果！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE"
msgid "It's way easier to cover ground with this!"
msgstr "用这个更容易盖住地面！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT"
msgid "Yuck. It's all vegetabley."
msgstr "呸。全是蔬菜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_COOKED"
msgid "Still vegetabley, but better for having been in fire."
msgstr "虽然还是一股蔬菜味，但经火烤过的味道要好些。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_PLANTED"
msgid "Maybe its special carrot friend is in the ground."
msgstr "也许地下有它特别的胡萝卜朋友。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARROT_SEEDS"
msgid "Seeds for a yucky orange vegetable."
msgstr "难吃的橙色蔬菜的种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Yes!!"
msgstr "是！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Scouts don't need maps, anyway."
msgstr "无论如何侦查军不需要地图。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I guess I could show everyone where I've been."
msgstr "我想我可以告诉大家我去过哪里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOON"
msgid "Here, kitty!"
msgstr "这里，猫咪！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.EMPTY"
msgid "It's all dried up and ready for burning."
msgstr "它已经完全干枯了，可以烧了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I wouldn't burn it while someone lives there."
msgstr "有东西住在那里时，我是不会烧掉它的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CATCOONHAT"
msgid "Cuddly hat."
msgstr "好可爱的帽子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Let's just smash it up."
msgstr "让我们砸掉它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't get up there!"
msgstr "我爬不上去！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA"
msgid "Bananas!"
msgstr "香蕉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_BURNT"
msgid "That's all I wanted!"
msgstr "那就是我想要的一切！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Yum!"
msgstr "好吃！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_BANANA_TREE"
msgid "Looks burnable!"
msgstr "看起来可以燃烧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE"
msgid "Who plugged that hole?"
msgstr "谁把那个洞给堵上的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people down there."
msgstr "那里人太多了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I don't want to go in that gross hole!"
msgstr "我不想进去那个讨厌的洞！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "I hope there's lava down there somewhere."
msgstr "我希望下面某个地方会有熔岩。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Who plugged that hole?"
msgstr "谁把那个洞给堵上的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people up there."
msgstr "那里人太多。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "It's cooler down here, anyway."
msgstr "反正这里更阴凉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_EXIT.OPEN"
msgid "It's too dark and stuffy down here."
msgstr "这下面太黑又太闷。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_FERN"
msgid "Looks flammable."
msgstr "看上去可以燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHARCOAL"
msgid "Mmmm. Smells like fire."
msgstr "嗯。火的味道。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK1"
msgid "Dead windup horsey."
msgstr "上发条的马，已经死了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK2"
msgid "Dead windup priest."
msgstr "死去的发条主教。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSJUNK3"
msgid "Dead windup castle."
msgstr "上发条的城堡，已经死了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Those are some pointy teeth."
msgstr "那些是一些尖利的牙齿。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Just some dumb bishop piece."
msgstr "只是有些愚蠢的主教。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "我不想看到从那出来的东西！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It almost looks friendly."
msgstr "它看起来很友好的样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It doesn't look so tough now."
msgstr "它现在看起来没那么厉害了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "We kicked its butt."
msgstr "我们踢了它的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "I think... I think I understand art."
msgstr "我觉得……我觉得我理解艺术。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_FORMAL"
msgid "I'm not afraid of that guy. He doesn't even have arms!"
msgstr "我不害怕那家伙。他甚至都没有手臂！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Ouchhh! I think I chipped a tooth."
msgstr "哎哟！我想我咬碎了一颗牙齿。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A horse with no butt."
msgstr "没有屁股的马。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "我不想看到从那出来的东西！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOOSEGOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MOOSEGOOSE"
msgid "Looks as dumb as the real thing."
msgstr "看起来像原件一样不能说话。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_MUSE"
msgid "Ewww, she doesn't have a head!"
msgstr "呃呃呃，她没有脑袋！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PAWN"
msgid "What sort of peasant doesn't have a torch?!"
msgstr "什么样的农民会没有火把呢？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_PIPE"
msgid "I prefer smokey fires."
msgstr "我更喜欢冒烟的火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "That one looks like it could do some damage."
msgstr "那东西看起来会做些破坏。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "I don't wanna see what comes outta that!"
msgstr "我不想看到从那出来的东西！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER"
msgid "He's so fuzzy!"
msgstr "他毛茸茸的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's rude to stare."
msgstr "盯着人看是很没礼貌的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "At least it's not looking at me anymore."
msgstr "至少它不再盯着我了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.GENERIC"
msgid "This dog is stone cold!"
msgstr "这只狗像石头一样冰冷！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYHOUND.STATUE"
msgid "Welp, that's a weird shape for a rock."
msgstr "好吧，这石头的形状太怪了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.GENERIC"
msgid "How'd you get your eyes to do that?!"
msgstr "你的眼睛这个样子，是怎么弄得？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CLAYWARG.STATUE"
msgid "Did someone carve this thing?"
msgstr "这个东西是谁雕刻出来的吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "啊哦。就快要熄灭了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.GENERIC"
msgid "I like fire of all kinds."
msgstr "不管什么类型的火我都喜欢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.HIGH"
msgid "BURN! BURN FASTER! AND BLUER!"
msgstr "烧吧！烧得再旺点！再蓝点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.LOW"
msgid "This fire is small and boring."
msgstr "火太小了，真无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.NORMAL"
msgid "Burn!"
msgstr "烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIRE.OUT"
msgid "Awww. It's all over."
msgstr "呜呜呜。一切都结束了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "啊哦。就快要熄灭了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "I could watch it for hours, even though it's cold."
msgstr "即使它是冷的火，我也可以盯着它几个小时。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.HIGH"
msgid "BURN! BURN FASTER! AND BLUER!"
msgstr "烧吧！烧得再旺点！再蓝点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.LOW"
msgid "This fire is small and boring. And blue."
msgstr "火太小了，真无聊。而且还是蓝色的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Burn!"
msgstr "烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COLDFIREPIT.OUT"
msgid "Make the fire come back!"
msgstr "重新把火点燃！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.E"
msgid "East!"
msgstr "东！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC"
msgid "Can't get a reading."
msgstr "看不懂。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "北！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "东北！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "西北！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "南！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "东南！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "西南！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W"
msgid "West..."
msgstr "西..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'd rather burn things down than build them up."
msgstr "我宁愿把东西烧掉，也不愿意把它们建起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE"
msgid "The fire didn't get rid of its face. Gives me the willies."
msgstr "火都没能把它的脸烧掉。这让我有点不安。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT"
msgid "Unseasoned meat... great."
msgstr "没有调味的肉...好极了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still gross."
msgstr "还是很恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT"
msgid "Gonna need a lot of appetizers to survive out here!"
msgstr "需要很多开胃菜，才能在这里存活下去。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.BURNT"
msgid "At least it went out in a blaze of glory."
msgstr "至少它是在荣耀的火焰中毁灭的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "The fire still has quite a bit of work to do."
msgstr "火要做的工作还很多。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "The fire is doing its thing!"
msgstr "火的工作就快完成了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.DONE"
msgid "Fire makes everything better. Mmm!"
msgstr "火可以让一切东西变得更好。嗯！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKPOT.EMPTY"
msgid "All food must be cleansed with fire."
msgstr "所有食物要用火清理下。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COONTAIL"
msgid "I've kept stranger things than that."
msgstr "我收藏过比那奇怪的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN"
msgid "A sweet vegetable, yum!"
msgstr "甜甜的蔬菜，好吃！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_COOKED"
msgid "Ooh, this one explodes when it goes in fire!"
msgstr "哦，这东西丢进火里会爆！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CORN_SEEDS"
msgid "Seeds for my favorite explosive vegetable."
msgstr "玉米种子，会爆炸的玉米可是我最爱的蔬菜了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTERLAB"
msgid "Is there anything cute in there??"
msgstr "那里面有什么可爱的东西吗？？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_DRAGONLING"
msgid "We were made for each other."
msgstr "我们是为彼此而生的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_GLOMLING"
msgid "Aww, I could just squish your gross lil face!"
msgstr "噢，我可以挤扁你恶心的小脸！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_KITTEN"
msgid "You're the perfect lapwarmer."
msgstr "你是完美的腿部取暖器。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_LAMB"
msgid "Look at those creepy little eyes. Aww."
msgstr "看那些诡异的小眼睛。噢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PERDLING"
msgid "I could just eat you up."
msgstr "我可以就把你吃了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CRITTER_PUPPY"
msgid "Hah, you don't even know you're smelly."
msgstr "哈，你甚至都不知道自己发臭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.GENERIC"
msgid "I think it's waiting for me to die."
msgstr "我猜它是在等我死掉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CROW.HELD"
msgid "Not so smart now, are you?"
msgstr "聪明不起来了，对吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTGRASS"
msgid "Cut grass, ready for burning. Or maybe crafting."
msgstr "干草是很好的燃料，也可以用来合成其他东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTLICHEN"
msgid "Blah, tastes like sawdust."
msgstr "呸，一股锯屑的味道。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTREEDS"
msgid "Cut reeds, ready for burning. Or maybe crafting."
msgstr "采下的芦苇是很好的燃料。也可以用来合成其他东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CUTSTONE"
msgid "Perfectly squared for maximum enjoyment."
msgstr "完全是四四方方的，看着真舒服。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEADLYFEAST"
msgid "Fire didn't cure this dish of being nasty."
msgstr "连火也治不了这盘菜的卑鄙本性。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "YES! BURN!"
msgstr "就是这样！烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "I wish it was still burning."
msgstr "真希望火还没灭。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "One less tree in the world."
msgstr "世上又少了一棵树。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It looks like it would burn well."
msgstr "看起来它会烧得很旺。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "A fire would set'em straight."
msgstr "一把火就能让它们老实。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.ANTLER"
msgid "Don't think that horn makes you special, deer."
msgstr "不要认为那个角让你显得比较特别，鹿。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER.GENERIC"
msgid "I wish everyone'd stop fawning over that smelly thing!"
msgstr "我希望大家不要再对那个发出臭味的东西皱眉了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS"
msgid "Holy crap!"
msgstr "哇靠！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Stop staring at me!"
msgstr "不准再盯着我！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_ANTLER"
msgid "It's a big, weird antler."
msgstr "这是个又大又怪异的鹿角。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEER_GEMMED"
msgid "Marginally better smelling than most animals here."
msgstr "至少比这里的大部分动物的味道好一点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "What a sorry looking piece of... grass?"
msgstr "样子多么凄惨的...草？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DESERTHAT"
msgid "Not very stylish."
msgstr "不是非常时髦。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIRTPILE"
msgid "Who just leaves dirt lying around in the forest?"
msgstr "是谁走的时候在森林里留下了这一堆泥土？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.COLD"
msgid "It's making some kind of noise."
msgstr "它在发出某种噪声。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.GENERIC"
msgid "It's full of electrical junk."
msgstr "它全身上下都是电子垃圾。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.HOT"
msgid "Gah! Enough with the beeping!"
msgstr "讨厌！别再哔哔哔地叫了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARM"
msgid "This thing is getting noisier."
msgstr "这东西越来越吵了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be close!"
msgstr "一定很近了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Not sure what this does. Doesn't seem like it's fiery things."
msgstr "不知道这是用来干嘛的。看起来不像是能够燃烧的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.READY"
msgid "Just needs to be unlocked with a key. Not fire, unfortunately."
msgstr "只需要用钥匙解锁就可以了。很遗憾，不是用火来解锁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It's whirring now!"
msgstr "它在发出呼呼的声音！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DIVININGRODSTART"
msgid "I'll make something out of it."
msgstr "我要用它搞点名堂出来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONBODYHAT"
msgid "Aww, I always get caught in the middle!"
msgstr "噢，我总是卡在中间！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLY"
msgid "It's filled with fire!"
msgstr "它肚子里面都是火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYCHEST"
msgid "I'm not sure why you'd want something that DOESN'T burn..."
msgstr "我搞不懂，你为什么想要不能燃烧的东西..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Let's turn it back on!"
msgstr "让我们重新把它打开！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "That's certainly a look."
msgstr "那当然是一个目光。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "I think I'm in love."
msgstr "我想我陷入爱情了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Stick another gem in there!"
msgstr "把另一个宝石放进那里！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT"
msgid "It looks sort of like a fire!"
msgstr "它看上去有几分像火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It looks more like a fruit that's been in a fire now."
msgstr "现在看起来更像是把水果放在烈火中一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Seeds for that fire-looking fruit."
msgstr "那个看起来像火一样的水果的种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONHEADHAT"
msgid "Sooo ferocious!"
msgstr "太太太残忍了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONPIE"
msgid "Fire fruit in a pie? Oh boy!"
msgstr "做成派的火龙果？我的乖乖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGONTAILHAT"
msgid "I wanna be the caboose!"
msgstr "我想要成为守车！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRAGON_SCALES"
msgid "Oooooooh! I LIKE those."
msgstr "哇哦！这些我都喜欢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK"
msgid "Bang on the drum all day!"
msgstr "整天都在砰砰砰击鼓！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hmm... Satisfy hunger, or bang on the drum?"
msgstr "嗯...填饱肚子呢还是用它来敲鼓？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH"
msgid "What's the matter, got no dirt?"
msgstr "怎么了，没有土了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "What's the matter, got no dirt?"
msgstr "怎么了，没有土了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_GRASS"
msgid "What's the matter, got no dirt?"
msgstr "怎么了，没有土了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_MARSH_BUSH"
msgid "What's the matter, got no dirt?"
msgstr "怎么了，没有土了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUG_SAPLING"
msgid "What's the matter, got no dirt?"
msgstr "怎么了，没有土了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN"
msgid "Ew, stinky!"
msgstr "呃，好臭！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_COOKED"
msgid "Yuck, it smells just as bad cooked!"
msgstr "呸，闻起来就像是东西煮坏了一样！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DURIAN_SEEDS"
msgid "Smelly seeds for a smelly fruit."
msgstr "臭水果的臭种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFS"
msgid "Smells like rabbit butt."
msgstr "闻上去像是兔子的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EARMUFFSHAT"
msgid "Smells like rabbit butt."
msgstr "闻上去像是兔子的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL"
msgid "I don't like the look it's giving me!"
msgstr "我不喜欢它的表情！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EEL_COOKED"
msgid "Fire improves everything."
msgstr "有了火，一切都变好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT"
msgid "Definitely not a bird."
msgstr "绝对不是鸟。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_COOKED"
msgid "Using fire on it made it a tastier eggplant."
msgstr "火让茄子变得更美味了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EGGPLANT_SEEDS"
msgid "Will these seeds make a plant or baby bird?"
msgstr "这些种子会长成一株植物还是一只小鸟？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.BURNT"
msgid "Alright, alright, so I was wrong about the hand!"
msgstr "好吧，好吧，在手这方面是我错了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.EMPTY"
msgid "I'm telling you, there's a monsterhand under that thing!"
msgstr "我是告诉你，那东西下面有一只怪物的手！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Not as good as a fire, but at least we won't be in the dark."
msgstr "不像火焰那么好，但至少我们不会处于黑暗中。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.GENERIC"
msgid "Just a bunch of dumb flowers."
msgstr "只是一束愚蠢的花朵。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We're gonna be in the dark soon."
msgstr "我们很快就要处于黑暗之中了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ENDTABLE.WILTED"
msgid "Those need replacing."
msgstr "那些需要替换。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNING"
msgid "YES! BURN!"
msgstr "就是这样！烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.BURNT"
msgid "I wish it was still burning."
msgstr "真希望火还没灭。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.CHOPPED"
msgid "One less tree in the world."
msgstr "世上又少了一棵树。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN.GENERIC"
msgid "It looks like it would burn well."
msgstr "看起来它会烧得很旺。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "YES! BURN!"
msgstr "就是这样！烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "I wish it was still burning."
msgstr "真希望火还没灭。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "One less tree in the world."
msgstr "世上又少了一棵树。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Die in a fire!"
msgstr "在火中结束吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEBRELLAHAT"
msgid "Keeps the rain out your eyes and in someone else's."
msgstr "不要让自己和别人流眼泪。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYEPLANT"
msgid "They spread like fire."
msgstr "它们像火一样迅速扩散。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET"
msgid "I wish it lit stuff on fire."
msgstr "我希望它能让东西点燃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.EYETURRET_ITEM"
msgid "It's no good until it's been placed."
msgstr "它安置妥当后才有好处。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.BURNT"
msgid "It was a nice finale."
msgstr "这是个不错的结局。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GENERIC"
msgid "Sigh. It's a pile of dirt."
msgstr "唉，这是一堆土。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.GROWING"
msgid "Hurry up, dirtpile. Feed me!"
msgstr "加把劲，土堆。给我提供食物！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "Stupid thing needs poop."
msgstr "蠢东西又需要施肥了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERFAN"
msgid "I dunno... it could put out some fires..."
msgstr "我不知道...它可以灭火..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERHAT"
msgid "A phoenix reborn!"
msgstr "浴火重生！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHERPENCIL"
msgid "So what does the feather do again?"
msgstr "所以羽毛又做了什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CANARY"
msgid "Canary feather. It probably smells terrible on fire."
msgstr "金丝雀羽毛。它燃烧起来也许很难闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_CROW"
msgid "Crow feather. It probably smells terrible on fire."
msgstr "乌鸦羽毛。它燃烧起来也许很难闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN"
msgid "Redbird feather. It probably smells terrible on fire."
msgstr "红雀羽毛。它燃烧起来也许很难闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Snowbird feather. It probably smells terrible on fire."
msgstr "雪雀羽毛。它燃烧起来也许很难闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FEM_PUPPET"
msgid "She looks scared half to death."
msgstr "她看起来已经被吓得半死。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE"
msgid "I'm not painting that."
msgstr "我不给那个涂漆。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE"
msgid "I guess we could pen stuff in with it."
msgstr "我猜我们可以用它把东西关起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_GATE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "把它留在地面上没有什么意义。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FENCE_ITEM"
msgid "No point just leaving it on the ground."
msgstr "把它留在地面上没有什么意义。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FERTILIZER"
msgid "A bucket full of nasty."
msgstr "满满的一桶脏东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREBALLSTAFF"
msgid "So I just wave it and FIRE APPEARS?"
msgstr "只要我挥一挥它，就会出现火吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRECRACKERS"
msgid "Light'em up!"
msgstr "把它们点燃！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish they didn't run away!"
msgstr "真希望它们没有跑掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREFLIES.HELD"
msgid "They're like little fires in my pocket!"
msgstr "它们就像是装在我口袋里的小火苗！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREHOUND"
msgid "I actually kind of like that one."
msgstr "实际上我还挺喜欢那家伙的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "啊哦。就快要熄灭了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.GENERIC"
msgid "I could watch it for hours."
msgstr "我可以几个小时一直盯着它看。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "烧吧！烧得再旺点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.LOW"
msgid "This fire is small and boring."
msgstr "火太小了，真无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.NORMAL"
msgid "Burn!"
msgstr "烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIREPIT.OUT"
msgid "Make the fire come back!"
msgstr "重新把火点燃！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESTAFF"
msgid "That's my absolute favorite toy."
msgstr "那绝对是我最喜爱的玩具。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Almost out."
msgstr "燃料就快用完了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "And stay off!"
msgstr "就保持这样！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I wish you'd shut your lid and stop putting out fires."
msgstr "真希望你赶紧关上盖子，不要再把火扑灭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH"
msgid "Slippery fishy!"
msgstr "滑不溜秋的鱼！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHINGROD"
msgid "Fishing for the answer with a hook, line and sinker."
msgstr "用鱼钩、钓鱼线和坠子来钓鱼。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHSTICKS"
msgid "What you see is what you get. Sticks of fish."
msgstr "所见即所得。瞧，炸鱼排。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISHTACOS"
msgid "Convenient taco-grip."
msgstr "真是方便好拿的鱼肉玉米卷。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FISH_COOKED"
msgid "Less slippery now that it's found fire."
msgstr "烤过之后的鱼没之前那么滑溜溜了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLINT"
msgid "The poor man's fire-starter."
msgstr "可怜人的打火石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.GENERIC"
msgid "I don't have time to waste on flowers."
msgstr "我可没有时间浪费在花朵上。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER.ROSE"
msgid "I'd like to burn this flower in particular."
msgstr "我特别想烧掉这朵花。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERHAT"
msgid "A halo of flowers. Too bad it's not a burning halo of flowers."
msgstr "花环。可惜不是正在燃烧的花环。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWERSALAD"
msgid "I'd rather a bowl of flames."
msgstr "我宁愿是一碗火苗。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_CAVE"
msgid "It's burning inside."
msgstr "它里面在燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL"
msgid "Ugh, that smells terrible."
msgstr "呃，太难闻了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED"
msgid "Looks like good kindling."
msgstr "看起来点火不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE"
msgid "Fuel for the fire."
msgstr "不错的燃料。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "运动可不是那么容易。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_PIECE"
msgid "It's just nasty old bits of bones!"
msgstr "它只是肮脏的老骨头碎片！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Looks passable."
msgstr "看起来还过得去。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That looks absolutely ridiculous."
msgstr "那看起来荒唐透顶。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Needs more gross old bits."
msgstr "需要更多老碎片。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.DEAD"
msgid "Showed him!"
msgstr "给他看看！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.GENERIC"
msgid "He's too damp to burn."
msgstr "他太潮湿了，烧不起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROG.SLEEPING"
msgid "They're cute when they're sleeping."
msgstr "他们睡着的时候好可爱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGGLEBUNWICH"
msgid "If you close your eyes it's a little easier to get it down."
msgstr "闭上眼睛，会更容易把它弄下来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS"
msgid "It still twitches every now and then. Freaky."
msgstr "它时不时的还在抽搐。太奇怪了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FROGLEGS_COOKED"
msgid "The fire made it stop twitching. Fire is the best."
msgstr "是火让它停止抽搐的。火最好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FRUITMEDLEY"
msgid "Yum, fruit!"
msgstr "好吃的水果！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FURTUFT"
msgid "Black and white and fuzzy all over!"
msgstr "黑白色的毛皮，上面全是毛！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_HOUND"
msgid "Lookit this big dumb lawn ornament!"
msgstr "看看这个又大又蠢的草坪装饰品！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GARGOYLE_WEREPIG"
msgid "At least it doesn't smell anymore."
msgstr "至少它不再发臭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEARS"
msgid "These must make them move."
msgstr "这些会让它们动起来的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.GEMS"
msgid "It's so empty!"
msgstr "上面是空的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GEMSOCKET.VALID"
msgid "I wonder how they hover?"
msgstr "它们究竟是如何浮在空中的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GHOST"
msgid "You can't kill what's already dead."
msgstr "你没法杀死一个本来就已经死了的人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GIFT"
msgid "It's for me right?!"
msgstr "这是给我的，对吗？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GIFTWRAP"
msgid "Ribbons burn real good!"
msgstr "缎带烧得真好！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLASSBLOCK"
msgid "See? Fire solves everything."
msgstr "看见了吗？一把火解决所有问题。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLASSSPIKE"
msgid "I can't believe that worked!"
msgstr "我不相信这有用！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMER"
msgid "It's fuzzy! And slimy..."
msgstr "好毛茸茸啊！而且很黏..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "I wonder if it burns..."
msgstr "不知道它可不可以燃烧..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "Why does everything have to be a flower?!"
msgstr "为什么不管什么东西身上都长着一朵花？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFUEL"
msgid "It's goopy and weird."
msgstr "又滑又腻，怪怪的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERWINGS"
msgid "They're so small!"
msgstr "它们太小了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOATMILK"
msgid "It's fuzzy with electricity. Yuck."
msgstr "它被电给弄得不纯了。真讨厌。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOGGLESHAT"
msgid "What a great look!"
msgstr "看起来多棒！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENAXE"
msgid "It won't light trees on fire, but at least it's shiny."
msgstr "虽然它没法让树着火，但至少它会闪闪发光。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENPICKAXE"
msgid "It won't light rocks on fire, but at least it's shiny."
msgstr "虽然它没法让石头着火，但至少它会闪闪发光。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENPITCHFORK"
msgid "It won't light the ground on fire, but at least it's shiny."
msgstr "虽然它没法让地面着火，但至少它会闪闪发光。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDENSHOVEL"
msgid "It won't make flaming pits, but at least it's shiny."
msgstr "虽然它没法用来挖火坑，但至少它会闪闪发光。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOLDNUGGET"
msgid "What should we spend it on??"
msgstr "我们应该怎么花？？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GOOSE_FEATHER"
msgid "So snuggly!"
msgstr "好暖和！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.BARREN"
msgid "It needs poop."
msgstr "它需要施肥。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.BURNING"
msgid "Fire! Wooo!"
msgstr "烧吧！哇！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.DISEASED"
msgid "Burn the sick!"
msgstr "烧掉患病的这些！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.DISEASING"
msgid "Blech. You smell."
msgstr "胡说。你闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.GENERIC"
msgid "It's a flammable tuft of grass."
msgstr "一丛易燃的草。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.PICKED"
msgid "Grass stubble is kind of useless."
msgstr "草茬没什么用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS.WITHERED"
msgid "Nice, dry, and ready to burn!"
msgstr "好，干燥，正好烧掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "Double ew!"
msgstr "两个哦！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Ew."
msgstr "哦。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GRASS_UMBRELLA"
msgid "Pretty as can be!"
msgstr "太漂亮了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENAMULET"
msgid "I feel my mind opening when I wear it."
msgstr "戴着它我感觉自己的思维都开阔了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENGEM"
msgid "This one feels really light."
msgstr "这个宝石感觉真的好亮。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENMOONEYE"
msgid "A big dumb rock."
msgstr "一块又大又愚蠢的岩石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREENSTAFF"
msgid "It won't start a fire but I guess it's still useful."
msgstr "虽然它没法用来生火，但我猜它还是很有用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP"
msgid "Boring!"
msgstr "真乏味！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP_COOKED"
msgid "It's been transformed by fire!"
msgstr "它通过火完成了变形！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Stupid mushroom."
msgstr "愚蠢的蘑菇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Hey! You! Get up here!"
msgstr "喂！你！给我出来！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也许有一天它会再长回来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUACAMOLE"
msgid "Holy moley, that's tasty!"
msgstr "天啊，太好吃了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUANO"
msgid "It burns like normal poop."
msgstr "它烧起来和普通粪便没什么区别。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GUNPOWDER"
msgid "Oooooooooh! Shiny!"
msgstr "哇哦！好闪亮！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_1"
msgid "That's wayyyy better than a regular apple!"
msgstr "那比一个普通的苹果好多了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_10"
msgid "Yesssss! Lollipops!"
msgstr "太棒了！棒棒糖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_11"
msgid "I'm gonna need about a dozen of these."
msgstr "我大概需要一打的这些东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_12"
msgid "Yuck! That's disgusting!"
msgstr "讨厌！真恶心！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_13"
msgid "It's sorta tangy."
msgstr "有点重口味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_14"
msgid "Mmm! It burns my mouth so good!"
msgstr "喔！火辣辣的感觉真好！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_2"
msgid "Do people actually eat these or are they just a bad joke?"
msgstr "人们真的吃这些东西吗或是它们只是不怎么样的笑话？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_3"
msgid "Ewwww it's corn flavored!"
msgstr "呃呃呃，是玉米口味！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_4"
msgid "Eww! I hate black licorice!"
msgstr "呃！我不喜欢黑色的甘草糖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_5"
msgid "These are a meow-uthful."
msgstr "这些是猫叫声。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_6"
msgid "Hey Wolfgang, eat one and tell us what it is!"
msgstr "嘿沃尔夫冈，吃一个，然后告诉我们那时什么！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_7"
msgid "Burn them!!!"
msgstr "烧了它们！！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_8"
msgid "Yesssss! Lollipops!"
msgstr "太棒了！棒棒糖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_9"
msgid "Why does something so yummy have to look so gross!"
msgstr "为什么这么美味的东西看起来非得这么恶心！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "It's like there's a fire in my belly."
msgstr "感觉就像肚子里有一团火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Ah. The strong stuff."
msgstr "啊。厉害的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "I wish it was a little stronger."
msgstr "我希望它能稍微强一点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "I didn't think it was possible to make fire better."
msgstr "我没想到火还能更棒。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Can I set it on fire?"
msgstr "我能不能放火烧它？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "I should decorate for Halloween."
msgstr "我该为万圣节装饰一下。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "Ugh. I hate those jerks."
msgstr "唉，我讨厌那些混蛋。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Wish it was flammable."
msgstr "真希望它是易燃的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "I should hang it somewhere and scare people."
msgstr "我应该把它挂在某个地方吓一吓人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "I'm gonna stick you in a tree."
msgstr "我要把你弄到树上。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMBAT"
msgid "Pleased to meat you!"
msgstr "很高兴认识你，我的肉友！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMMER"
msgid "I prefer sharp implements."
msgstr "我喜欢锋利的工具。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAMMER_MJOLNIR"
msgid "That weapon looks boring."
msgstr "那个武器看起来很没意思。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HAWAIIANSHIRT"
msgid "I wonder if it'd burn as nicely as actual flowers do."
msgstr "不知道它会不会和真花一样那么易燃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEALINGSALVE"
msgid "It burns! But, where's the fire?"
msgstr "它烧着了！但是火在哪里？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEALINGSTAFF"
msgid "I could take a crack at it."
msgstr "我倒可以试试这个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.COLD"
msgid "It's stone cold."
msgstr "已经冷冰冰的了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.FROZEN"
msgid "Frozen solid."
msgstr "冰冷刺骨的石头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.GENERIC"
msgid "A fire would liven this thing up!"
msgstr "火会让这东西变暖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.HOT"
msgid "Look at how it glows!"
msgstr "看看它是怎么发光的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEATROCK.WARM"
msgid "No flame, no real heat... what fun is that?"
msgstr "既没有火焰，也没有真正的热量...有什么好玩的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HIVEHAT"
msgid "That bee's head looks kinda tasty, doesn't it?"
msgstr "蜜蜂的脑袋看起来有些可口，不是吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOME"
msgid "I'm gonna burn it."
msgstr "我要烧掉它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.BURNT"
msgid "Hahaha, yesss!"
msgstr "哈哈哈，没错，就是这样！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.GENERIC"
msgid "Less reading! More burning!"
msgstr "少读！多烧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "I should burn something into it."
msgstr "我该在它上面烧出点什么记号。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEY"
msgid "Sweet and delicious!"
msgstr "甜蜜而美味！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYCOMB"
msgid "It's waxy."
msgstr "像蜡一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYHAM"
msgid "Fire, ham and honey go well together."
msgstr "烈火、火腿和蜂蜜是绝配。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HONEYNUGGETS"
msgid "Honey-covered morsels that have met my friend, fire."
msgstr "蜂蜜和肉块遇到最可爱的火，就成了蜂蜜包肉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HORN"
msgid "I can hear those hairy beasts inside."
msgstr "我可以听到里面有那些多毛动物的声音。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOTCHILI"
msgid "Now that's my kind of heat!"
msgstr "这才是我要的那种火辣！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUND"
msgid "What a jerk!"
msgstr "真是个混蛋！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDBONE"
msgid "Gross."
msgstr "恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDMOUND"
msgid "Uh oh, I don't like the look of that."
msgstr "啊哦，我不喜欢那东西的样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDSTOOTH"
msgid "It's sharp. I like it!"
msgstr "好锋利。我喜欢！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HOUNDWHISTLE"
msgid "Heh heh. STAY."
msgstr "嘿嘿。待着。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH"
msgid "What's your angle?"
msgstr "你在打什么主意？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It's too wet to burn."
msgstr "太潮湿了，烧不起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It's still too wet to burn."
msgstr "这东西太潮，烧不起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICE"
msgid "Chilly."
msgstr "好冰。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEBOX"
msgid "That is the opposite of fire."
msgstr "这是火的对立面。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICECREAM"
msgid "Well, soooometimes cold things are okay."
msgstr "嗯，有时候冷的东西也挺好的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHAT"
msgid "It's a real mood dampener."
msgstr "真是个扫兴的家伙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEHOUND"
msgid "Gross! Cold!"
msgstr "可恶！好冷！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICEPACK"
msgid "Fuzzy backpack!"
msgstr "毛茸茸的背包！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ICESTAFF"
msgid "Booooring."
msgstr "太太太太无趣了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Am I seeing things?"
msgstr "是我看花眼了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "Doesn't look flammable. How boring."
msgstr "看上去不像是能燃烧的。太无趣了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.INSPECTSELF"
msgid "Why didn't anyone tell me I had ashes on my face?"
msgstr "怎么没有人告诉我我脸上有灰呢？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.JAMMYPRESERVES"
msgid "Wham, bam, jam! Thank you, ma'am."
msgstr "舔，舔，舔！五秒搞定。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.JELLYBEAN"
msgid "Nothing better than a handful of jellybeans."
msgstr "没有什么比一把彩虹软糖更好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KABOBS"
msgid "Meat and fire, now with a stick!"
msgstr "火烤的肉，用签子串起！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.GENERIC"
msgid "I like the cut of that bee's jib."
msgstr "我喜欢那只蜜蜂的样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KILLERBEE.HELD"
msgid "Buzz!"
msgstr "嗡嗡！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS"
msgid "A lump of coal would be really useful, actually!"
msgstr "事实上，一块煤炭真的会很有用！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUSSACKKEY"
msgid "Ha! I wouldn't wanna get smacked with that thing!"
msgstr "哈！我不会想被那东西掴一掌！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KLAUS_SACK"
msgid "Nothing says \"Open Me\" quite like a lock!!"
msgstr "没有什么会像锁一样说“把我打开”！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT"
msgid "It's a pony!"
msgstr "是马儿耶！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "It looks pretty worn down."
msgstr "它看上去很破旧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER"
msgid "We will be great friends!"
msgstr "我们会成为很好的朋友的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER"
msgid "He sure looks warm..."
msgstr "毫无疑问，他看上去很暖和..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS"
msgid "Stay back, you big jerk!"
msgstr "退后，你这个大混蛋！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KRAMPUS_SACK"
msgid "The holidays came early this year!"
msgstr "今年提前过圣诞！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LANTERN"
msgid "Fire is not meant to be contained like this!"
msgstr "烈火不应该受到这样的束缚！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Nothing's gonna get through that!"
msgstr "什么都刺不穿那个！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "That armor looks pretty safe."
msgstr "那个盔甲看起来很安全。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "This armor isn't very good."
msgstr "这个盔甲不太好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "It barely does anything."
msgstr "它几乎没什么作用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "This armor will stop a blow or two."
msgstr "这个盔甲的抗击打能力还可以。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Good for smackin' stuff."
msgstr "抗击打能力不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "I could do neat stuff more often with that."
msgstr "我用这个可以多耍一些漂亮招数。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Woohoo! I should put that on."
msgstr "哦吼！我应该穿那个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Kill that flag!"
msgstr "灭了那面旗！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE"
msgid "You're always there for me, Bernie."
msgstr "你总是在我身边支持我，伯尼。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Pfft, I bet he can't even fight."
msgstr "啐，我敢打赌他根本没有战斗力。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Dibs!"
msgstr "我要了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Woah! I love it!"
msgstr "哇哦！我喜欢！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, gimme!"
msgstr "噢，给我！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "It's a feather crown!"
msgstr "是羽毛头冠！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "FIRE! FIRE! FIRE!"
msgstr "火！火！火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "That's a great wreath!"
msgstr "那个花环太棒了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "I don't even wanna burn it!"
msgstr "我甚至舍不得烧掉它了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "No way I can use that!"
msgstr "我绝不可能用它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "There's no key in it."
msgstr "里面没钥匙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Looks good."
msgstr "看上去一切就绪。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "So pointy!"
msgstr "好尖啊！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_LUCY"
msgid "That's Woodie's axe."
msgstr "那是伍迪的斧头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "This is WAY better than our gate back home!"
msgstr "这个比我们家里的门好多了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Time to go."
msgstr "该走了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Ohh, I want it!"
msgstr "噢，我想要这个！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Jerks come out of it."
msgstr "坏蛋就是从这儿出来的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'd wear it if I felt like hitting stuff."
msgstr "我想敲打什么时候就会戴它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "Comes with a matching staff!"
msgstr "还有一根配套的魔杖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE"
msgid "Why can't we be friends?"
msgstr "为什么我们不能做朋友？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_COCOON"
msgid "Aw, it lost its fiery personality."
msgstr "哦，它失去了暴躁的个性。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "I think a fire is trying to escape."
msgstr "我感觉有火焰想要逃出来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "It has a chill."
msgstr "它在打寒颤。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "That egg looks happy."
msgstr "那只蛋看起来很快乐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.CONTENT"
msgid "My own little burninator."
msgstr "我自家的小火龙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.GENERIC"
msgid "She's... perfect."
msgstr "她...太完美了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "I think she wants some burnings."
msgstr "我觉得她想要点着火的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_PET.STARVING"
msgid "I can see her ribs!"
msgstr "我能看到她的肋骨！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAE_TOOTH"
msgid "I hope she's not a biter."
msgstr "希望她不会咬人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.COOL"
msgid "Cool drool, literally."
msgstr "喷火坑变冷了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVASPIT.HOT"
msgid "The coolest drool!"
msgstr "全世界最酷的喷火坑！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND"
msgid "Yes! Yessss!"
msgstr "好！太好了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVA_POND_ROCK"
msgid "Oh great, another stinkin' rock!"
msgstr "哦，太好了，另一块臭石头！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF"
msgid "He looks flammable!"
msgstr "他看上去一点就着！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LEIF_SPARSE"
msgid "He looks flammable!"
msgstr "他看上去一点就着！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LICHEN"
msgid "A gross, crusty plant."
msgstr "一种令人恶心的、有硬皮的植物"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIFEINJECTOR"
msgid "Don't you dare stick that in me!"
msgstr "你居然敢把它插到我身上！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTBULB"
msgid "It's called a \"lightbulb\" but it's kinda heavy."
msgstr "这个灯泡有点重。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTER"
msgid "It's my lucky lighter!"
msgstr "它是我的幸运打火机！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "You're crazy!"
msgstr "你疯了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "Bouncy goat."
msgstr "好快活的山羊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNINGGOATHORN"
msgid "I heard lightning when I held it to my ear."
msgstr "当我拿着它靠近我耳朵时就听到了雷声。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Aww, all glow but no fire."
msgstr "哇，通体发光但没有火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "All the lightning goes here!"
msgstr "所有闪电都汇集到这里！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LITTLE_WALRUS"
msgid "He looks tasty."
msgstr "他看上去很美味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGLOG"
msgid "It looks upset."
msgstr "它看起来很烦躁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE"
msgid "It might be alive, but it'll still burn."
msgstr "它也许是活的，不过它还是会燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE_ROOT"
msgid "It's a stick. But I can't even set it on fire."
msgstr "它是根棍子。可是我竟然烧不着它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Should I wait until it gets bigger to set it on fire?"
msgstr "我是不是该等它长大一些再放火烧它？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LOG.BURNING"
msgid "Burn, log, buuuurn!"
msgstr "烧吧，木头，烧烧烧烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LOG.GENERIC"
msgid "Wood! So flammable! Hooray!"
msgstr "木头！容易燃烧的木头！太好了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "I don't think I'm supposed to spend this."
msgstr "我认为我不应该来浪费这东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUCY"
msgid "We could be good friends, you and I."
msgstr "我们会成为好朋友的，你和我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUMPY_SAPLING"
msgid "I should burn that thing before it reaches full ugliness."
msgstr "我应该在它变得丑陋不堪之前烧了那东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUREPLANT"
msgid "I bet a quick fire would take care of this."
msgstr "我打赌一把火就可以解决它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LUREPLANTBULB"
msgid "Gross! It's so meaty!"
msgstr "恶心！这么多肉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MADSCIENCE_LAB"
msgid "I like the fire!"
msgstr "我喜欢那团火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MALE_PUPPET"
msgid "He looks scared half to death."
msgstr "他看起来已经被吓得半死。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE"
msgid "Why did this plant have a face?"
msgstr "为什么这植物长着一张脸？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKESOUP"
msgid "The face doesn't wash away!!"
msgstr "脸没有洗掉！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Now that's just creepy!"
msgstr "太吓人了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_COOKED"
msgid "The fire made this plant guy a lot quieter."
msgstr "火焰让这个植物家伙安静多了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANDRAKE_PLANTED"
msgid "That's not a normal plant."
msgstr "那株植物不太正常。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MANRABBIT_TAIL"
msgid "The rabbits lost that argument."
msgstr "那次争论兔子输了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAPSCROLL"
msgid "Nothing's on it? I can burn it then, right?"
msgstr "上面什么也没有？那么我可烧了它了，对吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLE"
msgid "It's heavy!"
msgstr "它很重！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEBEAN"
msgid "I guess we just... plant it? In the dirt?"
msgstr "我看就把它栽种一下？在泥土里？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "That makes no sense!"
msgstr "这是没有意义的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLEPILLAR"
msgid "I wonder if the rest burnt down."
msgstr "不知道其余的烧毁了没。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLESHRUB"
msgid "What sort of bush doesn't burn?!"
msgstr "什么种类的灌木不会燃烧？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARBLETREE"
msgid "The worst kind of tree. The non-flammable kind."
msgstr "世上最糟糕的树，居然不能燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Burn, thorns!"
msgstr "燃烧吧，刺木！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "It looks sharp."
msgstr "它看上去很尖锐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Those thorns hurt!"
msgstr "这些刺木扎得人很痛！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_PLANT"
msgid "It's all plant-y."
msgstr "彻头彻尾的植物。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNING"
msgid "YES! BURN!"
msgstr "就是这样！烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.BURNT"
msgid "I wish it was still burning."
msgstr "真希望火还没灭。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Not so spiky now, are you?"
msgstr "现在没那么扎手了，对吧？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MARSH_TREE.GENERIC"
msgid "It looks dangerous!"
msgstr "它看起来很危险！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELL"
msgid "He's so condescending."
msgstr "他太傲慢了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLHEAD"
msgid "He sure likes to talk."
msgstr "他显然很爱讲话。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLIGHT"
msgid "These are no fun. They light themselves."
msgstr "一点都不好玩。它们可以自己把自己点亮。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLLOCK"
msgid "It just needs a key."
msgstr "只需要一把钥匙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "I like more exciting music."
msgstr "我喜欢更刺激的音乐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MAXWELLTHRONE"
msgid "Looks sticky."
msgstr "看上去很黏。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT"
msgid "This could be made better with FIRE!"
msgstr "用火肯定会更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATBALLS"
msgid "Meat made into spheres and improved with fire."
msgstr "将肉做成丸子，用火烹饪一下就成了美味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.BURNT"
msgid "Maybe the fire wasn't the best drying method..."
msgstr "也许火不是把肉弄干的最好方法..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DONE"
msgid "It's ready!"
msgstr "已经干了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYING"
msgid "Come on meat, dry already!"
msgstr "拜托，肉块，快点干吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Forget the rain! Dry!"
msgstr "走开，讨厌的雨！晾干！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC"
msgid "I want to hang some meat!"
msgstr "我想要晾些肉干！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEAT_DRIED"
msgid "Chewy, but satisfying."
msgstr "虽然有点难嚼，但还不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERM"
msgid "Eww, it's all swampy."
msgstr "又软又湿，真恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.BURNT"
msgid "Double whammy!"
msgstr "给你双重打击！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHEAD.GENERIC"
msgid "That's what you get for being so stinky!"
msgstr "让你这么臭，这就是你的下场！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.BURNT"
msgid "It's true, no one cares."
msgstr "真的没有人在意。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MERMHOUSE.GENERIC"
msgid "No one would care if this burned down."
msgstr "没人会在意它是否被烧毁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINERHAT"
msgid "It's not real fire, but it's still pretty fun."
msgstr "虽然不是真正的火光，但还是很有趣。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINIFAN"
msgid "No fun, making me exercise to stay cool!"
msgstr "不好玩，让我锻炼怎么保持冷酷！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.GENERIC"
msgid "Haha oh man, who drew THAT?"
msgstr "哈哈哦人类，谁画了那东西？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Looks kinda bare."
msgstr "看上去有点光秃秃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINISIGN_ITEM"
msgid "It's like a sign, but smaller."
msgstr "看起来像个木牌，但是更小。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAUR"
msgid "Poor thing. Trapped in this maze."
msgstr "可怜的家伙。被困在了这个迷宫里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURCHEST"
msgid "I want big horns like that!"
msgstr "我想要那样的大角！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MINOTAURHORN"
msgid "I wonder if the rings are an indication of age."
msgstr "我想知道这些圈圈是否代表年龄。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Coming up for a peek!"
msgstr "钻出地面偷瞄一眼！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.HELD"
msgid "Out of the ground, into the fire."
msgstr "离开地面，投身火中。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLE.UNDERGROUND"
msgid "Hiding from the light, huh?"
msgstr "不敢见光，嗯哼？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHAT"
msgid "I'm not sure about this..."
msgstr "我不太确定这个..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOLEHILL"
msgid "It burrows away from the sun's skyfire. Unnatural."
msgstr "它挖洞逃避烈日。违背自然规律。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEY"
msgid "Joke's on you! I can burn this poo."
msgstr "开个玩笑！我可以点燃这坨便便。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONKEYBARREL"
msgid "What a wonderfully flammable home."
msgstr "多么棒的家，一下子就能烧起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERLASAGNA"
msgid "Noodles, meat and clumps of hair. Nasty."
msgstr "面条、肉和一团一团的毛发。真恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT"
msgid "Gross. It's full of hairs."
msgstr "恶心。到处都是毛。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MONSTERMEAT_DRIED"
msgid "It's dry and smells strange."
msgstr "干的，闻起来怪怪的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.BROKEN"
msgid "Oh look, a bunch of smashed up rocks!"
msgstr "哦看，一堆稀烂的岩石！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.GENERIC"
msgid "It's expecting something from me."
msgstr "它期待从我身上获得什么。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Ughh! It's doing the exact opposite of burning!"
msgstr "啊啊！它的燃烧完全反了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.STAFFED"
msgid "Hurry up already, stupid rock!"
msgstr "已经赶紧了，愚蠢的岩石！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "That's obviously completely wrong."
msgstr "那明显完全是错误的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.CAVE"
msgid "Doesn't work down here."
msgstr "在这里没有用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.GENERIC"
msgid "What the heck? I can still see the moon!"
msgstr "搞什么鬼！我仍然还看得到月亮！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "That's as full as it gets."
msgstr "那和它变圆的时候一样圆。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A new moon! Great, I hated the old one!"
msgstr "一轮新月！太棒了，我讨厌原来那个！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon's outta here!"
msgstr "月亮在外面！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing, unlike me."
msgstr "月亮正再渐渐变圆，不像我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKCRATER"
msgid "Great. A rock with a hole in it."
msgstr "太棒了。里面有个洞的岩石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKIDOL"
msgid "Looks like a jerk."
msgstr "看起来像个混蛋。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKNUGGET"
msgid "Just another rock to me."
msgstr "对我来说只是另一块石头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCKSEED"
msgid "Well I can't burn it."
msgstr "好吧，我不能把它烧掉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOONROCK_PIECES"
msgid "Oh look! ROCKS! Ughhhhh!"
msgstr "哦看！岩石！啊啊啊啊！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE"
msgid "What in the world..."
msgstr "那究竟是个什么鬼..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSEEGG"
msgid "It's huuuuge!"
msgstr "真的好大——！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Ugh, it smells like bird butts!"
msgstr "呃，它闻起来像鸟屁股！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.GENERIC"
msgid "So annoying!"
msgstr "真烦人！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITO.HELD"
msgid "Keep that mouth away from me!"
msgstr "让你那张嘴离我远点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSQUITOSACK"
msgid "Blood must bubble in currents muggy and thick."
msgstr "在沉闷厚重的气流中，血液必须沸腾起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOSSLING"
msgid "Its feathers are frazzled."
msgstr "它的羽毛看上去破破烂烂的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.DUG"
msgid "Better it than me."
msgstr "幸好是它不是我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MOUND.GENERIC"
msgid "It's full of dead stuff, I bet."
msgstr "我打赌里面全是死去的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "The vines coil away from my lighter... weird!"
msgstr "葡萄藤绕圈远离我的打火机…好诡异！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "It's made of some kind of jerk rock I can't burn."
msgstr "它是由某种无法燃烧的混蛋岩石做成的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It's so useful!"
msgstr "这东西太有用了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMBOMB"
msgid "She's gonna blow!"
msgstr "她要吹气了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMHAT"
msgid "I don't like having my head messed with."
msgstr "我不喜欢思维混乱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "How could that not work?!"
msgstr "那怎么会没有用呢？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "A big gross mushroom! Burn it!"
msgstr "一个令人讨厌的蘑菇！烧了它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Mold problem's taken care of."
msgstr "霉菌问题被处理好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It's just a dumb log."
msgstr "只是一块愚蠢的木头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Gross, they're taking over!"
msgstr "显而易见，它们占了上风了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Nasty. Let's burn the rot out."
msgstr "真肮脏，我们把腐烂的东西烧了吧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "I'm sure fire would fix that."
msgstr "我相信火焰会修好的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "There's mushrooms growing in it now."
msgstr "现在蘑菇正在那里面生长。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Geez, who even needs that many mushrooms?"
msgstr "天啊，谁需要那么多蘑菇呢？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "C'mon, you saw that coming."
msgstr "快点，你看见那东西来了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "This dumb mushroom's not lighting up."
msgstr "这个愚蠢的蘑菇不亮了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Not as nice as a warm fire."
msgstr "不像温暖的火焰那样好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Now what?"
msgstr "现在该怎么办？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I've got a few ideas on how to light it. Heh heh."
msgstr "我想出几个点燃它的办法了。嘿嘿。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Pfft, well that was a bright idea."
msgstr "啐，好吧，那是一个好主意。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "It's spreading junk everywhere."
msgstr "垃圾喷得到处都是。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Gross. It smells like leprechaun butt."
msgstr "恶心。闻起来像小妖精的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Ew, I don't want to get too close."
msgstr "呃，我不想靠太近。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Gross. It's all mushroomy."
msgstr "恶心。它从头到尾都像蘑菇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Ack! It stinks!"
msgstr "没错！它令人讨厌！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "Gross. This tree is sick all over."
msgstr "恶心。这棵树已经病入膏肓了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "That one got what it deserves."
msgstr "那一棵罪有应得。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT"
msgid "It's like fire, but purple!"
msgstr "像火焰一样，不过是紫色的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL"
msgid "Eww, it's still warm!"
msgstr "恶心，还是温热的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT"
msgid "Light without fire is unnatural."
msgstr "不用火就可以照明实在是不正常。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Looks normal to me."
msgstr "感觉没什么异常。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "I guess it's nearly over."
msgstr "我猜一切快结束了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "I don't think it's working."
msgstr "它好像停止工作了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It's almost humming."
msgstr "它几乎在嗡嗡作响。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "I think it's turning off."
msgstr "魔法能量正在平静下来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's warning me."
msgstr "它在警告我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The fuel is coming to life!"
msgstr "魔法能量苏醒了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK"
msgid "It'd be way cooler if it was on fire..."
msgstr "如果它下面有火的话，那会更酷的..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD"
msgid "It's like dreams that can hurt real things!"
msgstr "好像梦境会对现实事物造成伤害！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NITRE"
msgid "There are tiny explosions trapped inside."
msgstr "里面有一些小爆炸。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OASISLAKE"
msgid "It's a bunch of water."
msgstr "这是一堆水。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ONEMANBAND"
msgid "I can do the pyrotechnics too!"
msgstr "我还可以制作烟火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OPALPRECIOUSGEM"
msgid "It's glittery and mesmerizing, like a fire!"
msgstr "它像火焰一样闪烁着，令人着迷！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.OPALSTAFF"
msgid "Gotta hold it with my sleeve so my hands don't get cold."
msgstr "必须用袖子兜住它，这样我的双手就不会变凉了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEAMULET"
msgid "It picks up burning materials!"
msgstr "它在捡燃料！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEGEM"
msgid "It'll make your fingers tingle."
msgstr "这会刺痛你的手指。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGEMOONEYE"
msgid "It's a rock. Ugh!"
msgstr "是块岩石。啊！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ORANGESTAFF"
msgid "It gives me a headache."
msgstr "它让我头疼。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PANDORASCHEST"
msgid "Kind of tacky."
msgstr "有点俗气。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PANFLUTE"
msgid "Music is boring."
msgstr "音乐很无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PAPYRUS"
msgid "I bet it'd burn!"
msgstr "我肯定它能够燃烧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PEGHOOK"
msgid "It's got a weaponized butt!"
msgstr "它的屁股也是武器！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PENGUIN"
msgid "Run away, tiny dancers."
msgstr "快跑，小小舞蹈家。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERD"
msgid "Evil bird! Get away from those yummy berries!"
msgstr "臭鸟！别靠近那些美味的浆果！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDFAN"
msgid "It's a big ol' fan."
msgstr "是个超级老粉丝。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.BURNT"
msgid "Well, that's burned now."
msgstr "好吧，现在被烧掉了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.EMPTY"
msgid "What do we have to do now?"
msgstr "我们现在必须做什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I don't even like gobblers!"
msgstr "我甚至都不喜欢火鸡！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PEROGIES"
msgid "Tasty things, sealed with fire."
msgstr "用火来封口的美味饺子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETALS"
msgid "Stupid flowers. They're almost useless."
msgstr "愚蠢的花。几乎是毫无用处。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETALS_EVIL"
msgid "Ew, they're sticky."
msgstr "好恶心，太黏了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PETRIFIED_TREE"
msgid "How am I supposed to burn it now?"
msgstr "我现在该如何烧掉它？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PHLEGM"
msgid "Gross! Let's burn it."
msgstr "恶心！让我们烧了它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PICKAXE"
msgid "It's very pointy."
msgstr "它很尖锐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE1"
msgid "All washed up."
msgstr "水冲来的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE2"
msgid "You, I like."
msgstr "你，我喜欢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE3"
msgid "Eat dirt!"
msgstr "吃土！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGELITE4"
msgid "Sure does like using those signs."
msgstr "很喜欢使用这些符号。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGGUARD"
msgid "I like his attitude!"
msgstr "我喜欢他的态度！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGGYBACK"
msgid "It's a backpack made out of butts!"
msgstr "用猪屁股做的背包！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHEAD.BURNT"
msgid "It can always get worse, I guess."
msgstr "人生不如意，十有八九。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHEAD.GENERIC"
msgid "I guess I have it alright."
msgstr "比起那家伙，我的处境还不算太糟。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.BURNT"
msgid "Nice redecorating job!"
msgstr "装修工作做得不错！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.FULL"
msgid "He's doing pig things in there."
msgstr "他在里面干一些猪的事情。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.GENERIC"
msgid "These pigs have questionable taste in architecture."
msgstr "这些猪在建筑方面的品味真的很有问题。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "You jerk! Let me in!"
msgstr "你个蠢货！让我进去！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGKING"
msgid "Blech. What a slob."
msgstr "呸，懒汉一个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.DEAD"
msgid "I wonder how they taste."
msgstr "真想尝尝它们的味道如何。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Ick. It's following me."
msgstr "讨厌。它在跟着我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.GENERIC"
msgid "Ugh. They're fragrant."
msgstr "呃，真是臭死了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.GUARD"
msgid "He's not the boss of me!"
msgstr "他可不是我的Boss！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGMAN.WEREPIG"
msgid "Bring it on, piggie!"
msgstr "出招吧，小猪！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.BURNT"
msgid "Burnt. I like it."
msgstr "烧焦了。我喜欢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Needs meat."
msgstr "需要肉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSHRINE.GENERIC"
msgid "Where's the shrine to me?"
msgstr "怎么就没人给我修个庙供起来？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGSKIN"
msgid "Ha ha. A pig's butt."
msgstr "哈哈。猪屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGTENT"
msgid "It smells terrible!"
msgstr "太难闻了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIGTORCH"
msgid "These pigs sure know how to have a good time."
msgstr "这些猪可真知道享受。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PIG_TOKEN"
msgid "I'd burn it, but it might be worth something."
msgstr "我要烧了它，但它可能有价值。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PINECONE"
msgid "Hey there, tree seed."
msgstr "嘿，你好啊，大树种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PINECONE_SAPLING"
msgid "You'll be a real tree soon."
msgstr "你很快就会长成一棵真正的树的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PITCHFORK"
msgid "Three times the pointiness."
msgstr "三倍那么尖。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANTMEAT"
msgid "Eww, it's all slimy."
msgstr "真恶心，又黏又滑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANTMEAT_COOKED"
msgid "Fire makes everything better."
msgstr "火可以让一切东西变得更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "I'd eat it if I had to."
msgstr "我不得已才吃它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Hurry up, you stupid plant!"
msgstr "快点长，你个愚蠢的植物！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.READY"
msgid "Oh boy. Vegetables."
msgstr "我的乖乖。新鲜的蔬菜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's crackly and dry. Good kindling!"
msgstr "它已经干枯而且裂开了。真是不错的引火柴！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.ATTACKER"
msgid "Why, %s... that fire in your eyes!"
msgstr "%s，为什么你眼里燃烧着火焰？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.FIRESTARTER"
msgid "BUUURN!"
msgstr "烧吧烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.GENERIC"
msgid "Hi %s!"
msgstr "你好 %s！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.GHOST"
msgid "I better get a heart for %s."
msgstr "我最好为 %s 拿到心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.MURDERER"
msgid "Burn the murderer!"
msgstr "烧死那个杀人凶手！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PLAYER.REVIVER"
msgid "Who do ghosts call? %s!"
msgstr "鬼魂在召集谁？%s！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE"
msgid "Is it supposed to have this many parts?"
msgstr "为什么它有这么多部分？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE_COOKED"
msgid "Fire always makes things better."
msgstr "火总是让东西变得更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Looks like the part from inside the fruit."
msgstr "看上去和果实里面的东西很像。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POND"
msgid "This pond will definitely not ignite. How dull."
msgstr "这片池塘肯定烧不起来。太无趣了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POND_ALGAE"
msgid "It must need a lot of water."
msgstr "它肯定需要大量的水。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POOP"
msgid "Ew. Nasty. But useful."
msgstr "呕...真恶心。不过很有用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POTTEDFERN"
msgid "I'd rather burn them."
msgstr "我宁愿烧掉它们。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POWCAKE"
msgid "I wonder if it is flammable."
msgstr "我想知道它能不能燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN"
msgid "I wonder what would happen if I applied fire."
msgstr "我很好奇它用火烤后会变成什么样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKINCOOKIE"
msgid "Cookies!!!"
msgstr "小甜饼！！！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_COOKED"
msgid "Fire on the outside turned out pretty well."
msgstr "在外面用火烤出来的东西真的挺不错的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_LANTERN"
msgid "Fire on the inside is amazing!"
msgstr "里面的火真是太神奇了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PUMPKIN_SEEDS"
msgid "Seeds for fire's best vegetable-friend... the pumpkin."
msgstr "在蔬菜里，南瓜是火最好的朋友，而这就是南瓜种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEAMULET"
msgid "Has science gone too far?"
msgstr "这科技是不是有点走偏了？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEGEM"
msgid "Weird!"
msgstr "好奇异！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.PURPLEMOONEYE"
msgid "Some sort of weird rock."
msgstr "某种奇怪的岩石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "I wonder where all the food goes. Probably somewhere gross."
msgstr "我想知道那些好东西都到哪儿去了。也许是某个恶心的地方。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Don't. Look. Up."
msgstr "不要、往上、看。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Boring."
msgstr "真乏味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Yawn."
msgstr "打哈欠。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "What's so great about her?"
msgstr "她有什么伟大的？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Haha! Look at this dumb goat statue."
msgstr "哈哈！瞧这傻乎乎的山羊雕塑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Ew. It's ugly."
msgstr "呃，很丑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Haha. You're old."
msgstr "哈哈。你真老。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "But I want more berries!"
msgstr "但我想要更多的浆果！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Now I don't have to use my hands."
msgstr "现在我不需要用手了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "Fancy."
msgstr "真漂亮。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "It's kinda small."
msgstr "有点儿小。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN1"
msgid "Wow. A coin. Pfft."
msgstr "哇，一枚硬币。啐！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN2"
msgid "I can probably buy something good with this."
msgstr "也许我可以用这个买点什么好东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN3"
msgid "I'm rich!"
msgstr "发财了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN4"
msgid "Guess that thing liked what we gave it."
msgstr "我猜它喜欢我们给它的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Needs more fire."
msgstr "火需要再旺点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "I bet it's tasty."
msgstr "我敢肯定这个很好吃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "That'll show those crabs."
msgstr "这个能引来螃蟹。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FERN"
msgid "I can take my pick of them."
msgstr "我可以摘它们。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Can you just eat flour?"
msgstr "你能不能直接吃面粉？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Leaf this to a professional."
msgstr "把它交给专业人士吧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Maybe that thing up there'll eat it."
msgstr "也许上面的那个东西会吃掉它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This should shut that thing up for a while."
msgstr "这应当会让那东西安静一阵子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "This won't shut it up for long."
msgstr "这不会让它安静多长时间。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "It doesn't want that. Might as well burn it."
msgstr "它不想那样，还不如烧焦它呢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Looks good to me."
msgstr "在我看来还不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC"
msgid "It's just a couple cloves of garlic."
msgstr "只是几头大蒜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Fire made it better."
msgstr "火让它变得更美妙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATKID"
msgid "He'll eat just about anything."
msgstr "她简直什么都吃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "What? We needed milk."
msgstr "什么？我们需要牛奶。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Her eyes creep me out."
msgstr "她的眼睛让我毛骨悚然。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL"
msgid "Fire it up!"
msgstr "给它点火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "Ugh, I guess I should set it up."
msgstr "呃，我应当把它安装好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "If it was bigger I could use more fire."
msgstr "它要是大一点，我就能动用更多火力了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "I should set it up over the firepit."
msgstr "我应当把它放在火坑上。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_HOE"
msgid "You mean I gotta do work?"
msgstr "你的意思是，我得干活？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY"
msgid "I'll use this if I can't burn it open."
msgstr "如果我不能烧开它，那我就用这个吧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "There's more stuff to burn in the park."
msgstr "公园里有更多东西可以拿来烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Just an old lamp post."
msgstr "只是一根旧灯柱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Whatever. It's a lamp."
msgstr "谁在乎呢？它是一盏灯。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I can smash stuff down with it."
msgstr "我可以用它来粉碎东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "That's what passes for a village around here, I guess."
msgstr "我猜就是这个东西被人们误看成附近的一个村子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "There's a lot of stuff to burn in there."
msgstr "这里有好多可以烧的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "I'd burn it, but I need the things in there."
msgstr "我倒是想烧了它，可我需要里面的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "It's totally raw. Fire could fix that!"
msgstr "它完全是生的。用火就能解决这个问题！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "They're so hideous they're almost cute."
msgstr "它们的样子真可笑，几乎算得上可爱了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "Hey! Give me more mushrooms!"
msgstr "嘿！再给我一些蘑菇！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION"
msgid "It's so bulbous."
msgstr "它可真是圆鼓鼓的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Roasting. My favorite cooking method."
msgstr "烤。我最爱的烹饪方式。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN"
msgid "Now we're cooking."
msgstr "这才是烹饪。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "I can't wait to use it!"
msgstr "我等不及要用它了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "That looks sharp."
msgstr "它看起来很锋利。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Gross."
msgstr "恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Ugly."
msgstr "真丑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "A fountain with no water. Maybe that's a metaphor?"
msgstr "没有水的喷泉。也许是个隐喻？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Didn't even have to melt the locks."
msgstr "甚至不要熔化门锁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "I can't even burn it open!"
msgstr "我根本没法烧到它打开！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's stone. I can't burn it."
msgstr "它是石头。我没法烧掉它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Cremation is the only way to do it."
msgstr "火化是唯一的做法。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Don't worry, I won't kick you."
msgstr "别担心。我不会踢你。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It's dead."
msgstr "它死了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I haven't got any crumbs for you."
msgstr "我没有面包屑给你。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's taking a nap."
msgstr "它在打盹。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Ohh. Look who's fancy now!"
msgstr "哦哦。这下够精美了吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Blech! Tastes like ocean."
msgstr "呸。尝起来像海水。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL"
msgid "I'm just gonna keep jumping through portals til I figure out a way home."
msgstr "我就一直穿越传送门，直到我找到回家的路为止。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Fancy key."
msgstr "精美的钥匙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT"
msgid "I should light a fire under its butt."
msgstr "我应该在它屁股底下点火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO"
msgid "We grew it in that gross muck."
msgstr "这是我们在那个恶心的马厩里种出来的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Cooking just means sticking stuff in fire."
msgstr "烹饪就是把东西塞进火里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "I set it up. Now what?"
msgstr "我装好了。现在要怎么做？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "It needs to be set up in a firepit."
msgstr "它需要装在火坑中。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "It goes with the fire."
msgstr "它和火很配。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Sweet stuff goes in there."
msgstr "甜蜜的反应。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "That one stayed in the ground too long."
msgstr "它在地里待得太久了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Metal doesn't burn well."
msgstr "金属不好烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "It's so busted, I don't even wanna light it on fire."
msgstr "它破损不堪，我甚至不想点燃它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "What a waste. It could've burned down."
msgstr "真浪费。本来可以烧毁它的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "What's a chimney without a fireplace?"
msgstr "没有壁炉的烟囱，算什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Ugh! It won't even burn."
msgstr "哎！烧都烧不着了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "I'd love to burn that to ashes."
msgstr "我想把它烧成灰烬。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "That would look better on fire."
msgstr "它着火之后会好看得多。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "It's like there was a Great Fire, without the fire."
msgstr "就像发生过一场大火，但是没有火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "There's no one here. Boring."
msgstr "空无一人。真无聊。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "I wish this would burn."
msgstr "真希望它能烧起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It'd be better if it was burnt."
msgstr "如果它已经被烧毁了，那还好一些。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "The roof isn't on fire."
msgstr "屋顶没有着火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Ha! Cracked it."
msgstr "哈！破解了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I can't get it to open."
msgstr "我没法打开它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON"
msgid "Look at it, flopping around like that."
msgstr "瞧瞧它，翻过来的那个样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "All it needed was some fire."
msgstr "只不过需要一些火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT"
msgid "I need a pinch or two on all my food."
msgstr "在我的所有食物上都要撒一点儿。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "I licked one. Had to."
msgstr "我舔了一块。没办法。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Grow faster, salt crystals!"
msgstr "长得快点吧，盐晶！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Gotta dredge the salt up."
msgstr "要把盐捞上来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "We can use it to get some cooking salt."
msgstr "我们可以用它弄些食盐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP"
msgid "Mmm! Pure sugar!"
msgstr "唔！纯糖！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "Now we can get sap out of the trees."
msgstr "现在我们可以从树上弄点汁液了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPLING"
msgid "Well. Might as well burn it now."
msgstr "好吧。不如现在就烧了它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Well that's dumb."
msgstr "好吧，真蠢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Aw...I won't know what these are until I plant them."
msgstr "啊啊啊...我必须把它们种出来了才知道它们是什么。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I'd rather burn things."
msgstr "我宁愿烧东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spices... the true spice of life."
msgstr "香料...生活中的真正调味料。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It smells kind of pepper-y."
msgstr "闻起来有点像胡椒味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back."
msgstr "它不会重新长出来了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It's a piece of that pepper-y bush."
msgstr "那种胡椒味灌木丛的一根小枝。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "Aw! It's impervious to fire."
msgstr "啊啊啊！它不怕火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It's kinda useless now."
msgstr "它现在没什么用了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Stupid bugs."
msgstr "臭虫子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It's taking forever!"
msgstr "慢的要命！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sap's ready!"
msgstr "汁液好了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "You don't look so hot, tree."
msgstr "你看起来不烫嘛，树木。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Not the prettiest face."
msgstr "这张脸真的称不上好看。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "They're not so different from the pigs back at our place."
msgstr "它们跟我们家那边的猪没多大区别。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's taking a nap."
msgstr "它在打盹。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It's just asking to be burned down."
msgstr "它简直是求着别人把它烧毁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Hey pigs! Your house blew down!"
msgstr "嘿，猪猪！你们的房子被吹倒了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Mmmm..."
msgstr "唔..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Cutting these is a pain."
msgstr "切这些东西真痛苦。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It just needed a couple minutes on the fire."
msgstr "只需要把它放在火上几分钟就好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Hey, what'dya got for me?"
msgstr "嘿，你有什么东西可以给我？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Nice hat. Are you selling that, too?"
msgstr "帽子挺漂亮的。那个也是卖的吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP"
msgid "Haha gross, I hate turnips."
msgstr "哈哈，真恶心，我讨厌大萝卜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Take that, turnip."
msgstr "接招吧，大萝卜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT"
msgid "How on earth do you eat this?"
msgstr "这到底要怎么吃啊？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "这只是一把种子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBIT.GENERIC"
msgid "He looks tasty."
msgstr "他看上去很美味。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBIT.HELD"
msgid "I have him right where I want him!"
msgstr "想抓住他的时候就得手了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Stupid rabbits. Come out so I can eat you."
msgstr "蠢兔子，快出来，我要吃了你。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOLE.SPRING"
msgid "Stupid rabbits must be stuck down there."
msgstr "那些蠢兔子肯定被困在下面了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Ha! Good result."
msgstr "哈！干得好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Ugh. Stupid rabbits."
msgstr "呃，愚蠢的兔子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINCOAT"
msgid "That'll do the trick."
msgstr "那会成功的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINHAT"
msgid "Anything to keep the water away."
msgstr "可以让我不被雨淋的东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINOMETER.BURNT"
msgid "Take that, rain!"
msgstr "尝到我的厉害了吧，臭雨！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAINOMETER.GENERIC"
msgid "Rain is the anti-fire. Boo!"
msgstr "雨火不两立。切！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RATATOUILLE"
msgid "Vegetables. So many vegetables."
msgstr "蔬菜。好多的蔬菜。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RAZOR"
msgid "What's it even for?"
msgstr "那是为了什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDGEM"
msgid "So pretty!"
msgstr "真漂亮！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDLANTERN"
msgid "Anything with a fire in it is okay by me."
msgstr "任何有火焰的东西对我来说都是可以的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDMOONEYE"
msgid "This one's got fire in its eye!"
msgstr "这家伙眼睛里冒着火焰！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REDPOUCH"
msgid "What a great color!"
msgstr "好棒的颜色！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_CAP"
msgid "I like the color."
msgstr "我喜欢这颜色。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_CAP_COOKED"
msgid "It's been transformed by fire!"
msgstr "它通过火完成了变形！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Pretty!"
msgstr "好漂亮！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "Hey! You! Get up here!"
msgstr "喂！你！给我出来！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "也许有一天它会再长回来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.BURNING"
msgid "Burn! Yeah!"
msgstr "烧吧！耶！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.GENERIC"
msgid "It's a burnable clump of reeds."
msgstr "这是一丛可以烧着的芦苇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REEDS.PICKED"
msgid "It's just reed stubble."
msgstr "这只是根芦苇残枝而已。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REFLECTIVEVEST"
msgid "Vests are so in."
msgstr "这背心太时髦了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RELIC"
msgid "Old furniture."
msgstr "老古董。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB.BURNT"
msgid "There's no learning from that now."
msgstr "现在再也没法从那里学习新东西了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "Even I don't know everything... yet."
msgstr "即使有些东西我不知道...这也只是暂时的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "There's no learning from that now."
msgstr "现在再也没法从那里学习新东西了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Even I don't know everything... yet."
msgstr "即使有些东西我不知道...这也只是暂时的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Now it's dark and not very powerful."
msgstr "现在它只是黑，谈不上强大了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "A dark and powerful energy radiates from it."
msgstr "它散发着黑暗而强大的能量。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Double, double toil and... oh. It's burned."
msgstr "不惮辛劳，不惮...哎呀，不好。它烧掉了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I can use the hat like a cauldron!"
msgstr "我可以把那个帽子当作巫师施符咒的大锅！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Our policy was canceled."
msgstr "我们的保险单作废了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "That's our insurance policy."
msgstr "那是我们的保险单。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RESURRECTIONSTONE"
msgid "I'll touch it when I'm good and ready."
msgstr "当我完全准备好了，我会触摸它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.REVIVER"
msgid "I expected it to be blacker."
msgstr "我希望它更黑一点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RHINODRILL"
msgid "Pfft. Whatever Rhinocebros."
msgstr "呵呵。随便吧，犀牛兄弟。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN.GENERIC"
msgid "A redbird. The color of fire, but not a phoenix."
msgstr "一只红雀。火一样的颜色，但不是凤凰。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN.HELD"
msgid "It's cozy in my pocket."
msgstr "它在我口袋里很舒服。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "It looks cold out here. I bet it wants a fire."
msgstr "它看起来好冷。我猜它肯定想烤火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's so fluffy."
msgstr "它的羽毛好软。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROBOT_PUPPET"
msgid "They look scared half to death."
msgstr "它看起来已经被吓得半死。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK"
msgid "It's, like, a rock."
msgstr "这个，像是一块石头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCKS"
msgid "What's the point of collecting these again?"
msgstr "又收集这些有什么意义？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCKY"
msgid "We don't have much in common."
msgstr "我们可没有多少共同点。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE.GENERIC"
msgid "I don't think there's any way it'd burn."
msgstr "我觉得无论用什么方法都不可能把它点燃。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE.MELTED"
msgid "As useless as water ever was."
msgstr "就和水一样毫无用处。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_ICE_MELTED"
msgid "As useless as water ever was."
msgstr "就和水一样毫无用处。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "There's heat in there, just waiting to get out!"
msgstr "那里面有热量，就等着出来呢！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava is cooling."
msgstr "熔岩在冷却。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "A pool of fire!"
msgstr "一个火塘！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Aww, it's cooled off."
msgstr "噢，它凉下来了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_MOON"
msgid "Just another rock to me."
msgstr "对我来说只是另一块石头。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "How am I supposed to burn it now?"
msgstr "我现在该如何烧掉它？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "How am I supposed to burn it now?"
msgstr "我现在该如何烧掉它？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROOK"
msgid "It's a castle!"
msgstr "这是一个城堡！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROOK_NIGHTMARE"
msgid "It has a nasty smile."
msgstr "它的笑容很猥琐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROPE"
msgid "What should we tie up??!"
msgstr "我们要绑住什么？？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROTTENEGG"
msgid "Ew! Why? Oh Why?!"
msgstr "好恶心！为什么？为什么会这样？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROYAL_JELLY"
msgid "It's so sweet!"
msgstr "你真是太好了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUBBLE"
msgid "Broken furniture."
msgstr "残破的家具。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINSHAT"
msgid "It seems like there's something flowing through it."
msgstr "似乎有什么东西在其中流动。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINS_BAT"
msgid "This will keep the nasties at bay."
msgstr "这可以让那些坏蛋不敢靠近我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RUINS_RUBBLE"
msgid "That could probably be fixed up."
msgstr "那个可能可以修好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "A very very old chest."
msgstr "非常非常古老的箱子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "I think it's judging me."
msgstr "我觉得它在评判我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLEHORN"
msgid "I bet it stinks under the saddle."
msgstr "我打赌鞍具下面肯定很臭。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_BASIC"
msgid "It's so uncomfortable."
msgstr "真不舒服。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_RACE"
msgid "Was it worth it? I think it was worth it."
msgstr "值吗？我认为值。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SADDLE_WAR"
msgid "I'm going to raze some villages!"
msgstr "我要将把好多座村庄都夷为平地！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SALTLICK"
msgid "It's a big block of slobbery salt."
msgstr "一大堆潮湿的盐。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANDBLOCK"
msgid "Buuurn!"
msgstr "烧吧烧吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANDSPIKE"
msgid "Burn it!"
msgstr "烧了它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I wonder what these markings mean."
msgstr "我想知道这些标记有什么含义。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Where'd it go?"
msgstr "它去了哪里？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.BURNING"
msgid "Burn! Yeah!"
msgstr "烧吧！耶！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.DISEASED"
msgid "Burn the sick!"
msgstr "烧掉患病的这些！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.DISEASING"
msgid "Blech. You smell."
msgstr "胡说。你闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.GENERIC"
msgid "It'd be worth it to pick that."
msgstr "我会让摘那个东西成为有价值的事情。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.PICKED"
msgid "Poor little limp tree."
msgstr "可怜的小树苗。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SAPLING.WITHERED"
msgid "It's so dry, it's like it WANTS to be on fire."
msgstr "它都干枯了，似乎想要着火一样。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.BURNING"
msgid "It's a burning man."
msgstr "这是一个火人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.BURNT"
msgid "Just burnt straw."
msgstr "只管烧稻草。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCARECROW.GENERIC"
msgid "Ha! He thinks he's people!"
msgstr "哈！他还认为自己是个人呢！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCORCHED_SKELETON"
msgid "Ewwwwwwwwwww!"
msgstr "吓死人了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "I'm gonna carve a stone butt."
msgstr "我要雕刻出一个石头做的屁股。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Haha!"
msgstr "哈哈！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Hm... I could make things that DON'T burn?"
msgstr "嗯……我可以制造出不着火的东西？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "I guess that's good, too."
msgstr "我想那也很好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Not burnable. Not interested."
msgstr "烧不起来，不感兴趣。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Humpty Dumpty's back together again."
msgstr "矮胖子又一起回来了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Ew! It's wriggling!"
msgstr "呃唔！它在蠕动！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "The crank doesn't even turn!"
msgstr "怪人甚至都没有转身！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "Gross. I don't think that was supposed to come off."
msgstr "恶心，那个不应该掉下来吧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "It's a marble statue, I guess."
msgstr "我猜是个大理石雕像。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "He didn't even say \"thank you\"."
msgstr "他甚至都没有说“谢谢”。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Ew! It's wriggling!"
msgstr "呃唔！它在蠕动！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "That thing looks terrible."
msgstr "这东西看起来很可怕。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Great, now we've irritated some marble crime boss!"
msgstr "这下好了，我们激怒了大理石犯罪案的幕后黑手！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Looks like a bunch of rubble to me."
msgstr "我看它就是一堆碎石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "I'm more used to destroying things than fixing them."
msgstr "比起修理东西，我更习惯破坏东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Ew! It's wriggling!"
msgstr "呃唔！它在蠕动！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "What a creepy load of junk!"
msgstr "这么多垃圾，真是太诡异了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Ha, falling to pieces. Rookie mistake."
msgstr "哈，摔成碎片了。菜鸟才会犯的错误。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS"
msgid "Farming is boring."
msgstr "耕种最无聊了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEEDS_COOKED"
msgid "No good for farming now."
msgstr "现在不能用来耕种了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SENTRYWARD"
msgid "Pfft. It'll burn like the rest."
msgstr "啐，它会像剩下的一样燃烧起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEWING_KIT"
msgid "But destruction is so much more fun!"
msgstr "但是搞破坏要有趣得多！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SEWING_TAPE"
msgid "At least something around here can hold it together."
msgstr "至少附近有东西可以把它固定起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOWDIGGER"
msgid "Eww, it's even creepier than the real one."
msgstr "呃，这比真的还吓人。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHADOWHEART"
msgid "Oh, ewww! Who would ever touch that?!"
msgstr "哦，呃呃呃唔！谁会去碰它？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHOVEL"
msgid "Not great for fighting."
msgstr "不太适合用来战斗。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SHROOM_SKIN"
msgid "Ew! Burn that!"
msgstr "呃！把它烧掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SIESTAHUT.BURNT"
msgid "I always set them on fire."
msgstr "我总是会让它们着火。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SIESTAHUT.GENERIC"
msgid "They taught us how to make these in Girl Scouts."
msgstr "我在参加女童子军的时候，学会了怎么做这些东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SILK"
msgid "Mmmmmm. Smooth."
msgstr "嗯。好光滑。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON"
msgid "I hope you at least went out in a blaze of glory."
msgstr "我希望你至少是在荣耀的火焰中死去的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETONHAT"
msgid "I've got a headache just looking at it."
msgstr "看着它我就头疼。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "The fire of %s's life was extinguished by %s."
msgstr "%s 生命之火被 %s 熄灭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "The fire of %s's life was extinguished by %s."
msgstr "%s 生命之火被 %s 熄灭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "The fire of %s's life was extinguished by %s."
msgstr "%s 生命之火被 %s 熄灭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "The fire of %s's life was extinguished by %s."
msgstr "%s 生命之火被 %s 熄灭了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKETCH"
msgid "Trading diagrams is for dorks."
msgstr "笨蛋才用交易图。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SKULLCHEST"
msgid "Ooooh, spooky!"
msgstr "哦哦哦，太可怕了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLEEPBOMB"
msgid "Who's ready for a nap!"
msgstr "谁准备好打盹儿了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPER"
msgid "Do they have little fires in their bellies?"
msgstr "它们肚子里有火吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPERPELT"
msgid "Eeewwwww, it's still alive!"
msgstr "咦，它还是活的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURPER_PELT"
msgid "Eeewwwww, it's still alive!"
msgstr "咦，它还是活的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLE"
msgid "I want to blow it up!"
msgstr "我想要把它炸飞！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLEHAT"
msgid "It's perfectly head-shaped."
msgstr "完美的头型。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLEHOLE"
msgid "I should burn them out."
msgstr "我应该把它们都烧掉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLESLIME"
msgid "I love this stuff!"
msgstr "我爱死这玩意儿了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Heh. It broke."
msgstr "嗬嗬。它碎了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Not quite a phoenix, but still cute. I guess."
msgstr "我觉得吧，虽然不太像凤凰，但还是很可爱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Are you hungry?"
msgstr "你饿了吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.STARVING"
msgid "Okay, okay! I get it, you're hungry."
msgstr "好吧，好吧！我知道了，你饿了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT"
msgid "This could be made better with FIRE!"
msgstr "火烤一下会更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT_DRIED"
msgid "Chewy, but satisfying."
msgstr "虽然有点难嚼，但还不错。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNAPPER"
msgid "Jeez, what's his crocodeal?"
msgstr "呀，他是什么来头？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNURTLE"
msgid "Kaboom!"
msgstr "砰！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPAT"
msgid "I don't like your face!"
msgstr "我不喜欢你的脸！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR"
msgid "That looks good for jabbin'!"
msgstr "用这个戳肯定不错！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_GUNGNIR"
msgid "I don't want to use that."
msgstr "我不想用那个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_LANCE"
msgid "Looks cumbersome."
msgstr "看起来很笨拙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPEAR_WATHGRITHR"
msgid "I prefer a flame, but to each her own."
msgstr "我更喜欢火焰，不过萝卜青菜，各有所爱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.DEAD"
msgid "Ha! Showed you!"
msgstr "哈！尝到我的厉害了吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.GENERIC"
msgid "He's nasty. I should kill him."
msgstr "他很讨厌。我应该杀了他。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER.SLEEPING"
msgid "I could take him."
msgstr "我可以干掉他。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERDEN"
msgid "That's just nasty."
msgstr "真脏。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDEREGGSACK"
msgid "Tons of tiny disgusting spiders."
msgstr "一大堆让人恶心的小蜘蛛。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERGLAND"
msgid "Eeeeew, it's slimy and stinky!"
msgstr "好恶心，又黏又臭！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHAT"
msgid "Who's your mommy!"
msgstr "谁是你妈妈！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHOLE"
msgid "It's full of spiders."
msgstr "里面全是蜘蛛。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERHOLE_ROCK"
msgid "It's full of spiders."
msgstr "里面全是蜘蛛。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERQUEEN"
msgid "Kill it with fire!"
msgstr "用火烧死它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_DROPPER"
msgid "They come from above."
msgstr "它们是从上面下来的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_HIDER"
msgid "What a frustrating jerk!"
msgstr "真是个难搞的家伙！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_SPITTER"
msgid "Get over here!"
msgstr "放马过来！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "He had it coming."
msgstr "他活该。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "Maybe I could kill it... with FIRE."
msgstr "也许我可以...用火烧死它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "Maybe I should just leave that one alone."
msgstr "也许我不应该去打扰那家伙。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPOILED_FOOD"
msgid "At least it's still flammable."
msgstr "至少它仍然是可以燃烧的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "It's like floating fire!"
msgstr "就像浮动的火焰！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "It feels flammable."
msgstr "它很容易点燃的感觉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "It has no idea where it's going."
msgstr "它不知道它要去哪里。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_SMALL.HELD"
msgid "It feels flammable."
msgstr "它很容易点燃的感觉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_TALL.GENERIC"
msgid "It's like colorful sparks!"
msgstr "它像五颜六色的火花！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPORE_TALL.HELD"
msgid "It feels flammable."
msgstr "它很容易点燃的感觉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFFCOLDLIGHT"
msgid "Boo! Hissss!"
msgstr "嘘！嘘丝丝！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFFLIGHT"
msgid "It's so beautiful!"
msgstr "太漂亮了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAFF_TORNADO"
msgid "Always whirling! Swirling towards destruction!"
msgstr "永远在旋转！旋向毁灭！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAGEHAND.AWAKE"
msgid "Gross! I told you we shoulda burned it!"
msgstr "恶心！我告诉过你我们应该把它烧掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STAGEHAND.HIDING"
msgid "What's a weird table doing out here? Let's burn it!"
msgstr "把那么诡异的桌子放在那边做什么？我们把它烧掉吧！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALAGMITE"
msgid "Rocks are boring."
msgstr "石头真无趣。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALAGMITE_TALL"
msgid "More boring rocks."
msgstr "又是无趣的岩石。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER"
msgid "I brought you back so I could beat you up!"
msgstr "我带你回来了，这样我才能打你一顿！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER_ATRIUM"
msgid "It's just bones and shadow."
msgstr "它只是骨头和影子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STALKER_MINION"
msgid "Yuck, it's barely even alive."
msgstr "恶心，它已经奄奄一息了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "Looks about the same."
msgstr "看上去好像是一样的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "Is that supposed to be something?"
msgstr "它应该是什么东西吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEHARP"
msgid "Such a nice statue. Shame if something were to happen to it."
msgstr "多么漂亮的雕像。弄坏了就可惜了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUEMAXWELL"
msgid "A big stone nerd."
msgstr "一个大石头呆子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "It's an okay statue, I guess."
msgstr "我猜这是一个不错的雕像。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Yikes. I'd cover that up too if I were her."
msgstr "呀！如果我是她，我还会把它盖起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "She hasn't put her face on for the day yet."
msgstr "她今天还没有换上伪装。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "A brazier would be nicer."
msgstr "用火盆会更好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STEELWOOL"
msgid "Make a spark, it'll still burn."
msgstr "来个火花，它还是会燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STINGER"
msgid "It's pokey!"
msgstr "好扎手！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STRAWHAT"
msgid "A hat made of straw. To think, it could've been tinder."
msgstr "一顶稻草做的帽子。但是我觉得，它本来可以成为引火物的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.STUFFEDEGGPLANT"
msgid "It's still not a bird, but it's sure stuffed like one!"
msgstr "它仍然不是鸟，不过里面塞了东西，看起来就像一只鸟！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PICKED"
msgid "It's been picked."
msgstr "它被选中了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_PLANT"
msgid "It's a small, unburned plant."
msgstr "它是一个未燃烧过的小植物。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUCCULENT_POTTED"
msgid "We're keeping it."
msgstr "我们会保存它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUNKBOAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SUNKBOAT"
msgid "It's too far out, I can't even burn it!"
msgstr "它太远了，我都烧不到它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SWEATERVEST"
msgid "Not as nice as a flaming vest, but it'll do."
msgstr "虽然没有火焰背心那么好，但还凑合。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TAFFY"
msgid "Sugary things burn great, but best not waste food."
msgstr "含糖的东西很好烧，但最好不要浪费食物。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRD"
msgid "I don't think it wants to be friends."
msgstr "我觉得它不想和我交朋友。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG"
msgid "Does it like fire?"
msgstr "它喜欢火吗？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Fire makes them so much better."
msgstr "经火烤之后好多了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Needs more fire!"
msgstr "火需要再旺点！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Arise, my phoenix!"
msgstr "现身吧，我的凤凰！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Is there such a thing as too much fire?"
msgstr "火是不是太旺了？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "How long is this going to take?"
msgstr "这需要多长时间？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "I'm getting tired of waiting."
msgstr "我都等得不耐烦了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "That egg could use some fire!"
msgstr "可以用火来烤那个蛋！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "The nest is empty."
msgstr "巢是空的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.GENERIC"
msgid "I feel like he understands."
msgstr "我感觉他能理解我。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.HUNGRY"
msgid "He sure eats a lot."
msgstr "他的确吃得多。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TEENBIRD.STARVING"
msgid "Don't look at me! Get your own food."
msgstr "不要看我！自己去找吃的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.GEMS"
msgid "It needs something more."
msgstr "它还需要一些东西。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEBASE.VALID"
msgid "I can feel the magic!"
msgstr "我可以感觉到魔力的存在！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "I just want to see this world burn."
msgstr "我只想看着这个世界烧起来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "I like the way the symbols glow."
msgstr "我喜欢这些符号发亮的样子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Needs to be unlocked somehow."
msgstr "需要以某种方式解锁。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "I'm making a monstrosity!"
msgstr "我在创造怪物！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_BOX"
msgid "It feels warm."
msgstr "感觉暖暖的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_CRANK"
msgid "What's this part good for?"
msgstr "这部分有什么用？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_POTATO"
msgid "Perhaps it could be melted into a more pleasing shape."
msgstr "也许它可以熔化成更漂亮的形状。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELEPORTATO_RING"
msgid "This is too precious to burn!"
msgstr "这么珍贵的东西不能烧啊！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TELESTAFF"
msgid "It's quite a rush to use."
msgstr "它用起来就像一阵风。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENT.BURNT"
msgid "Well, I've still got my badges."
msgstr "没关系，我还有我的勋章。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENT.GENERIC"
msgid "I got all the badges in Girl Scouts."
msgstr "我可是获得过所有勋章的女童子军。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE"
msgid "Not at all cuddly."
msgstr "一点都不讨人喜欢。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLESPIKE"
msgid "It's pointy and slimy."
msgstr "它又尖又黏。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLESPOTS"
msgid "Ewwwww."
msgstr "呃，好恶心。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_GARDEN"
msgid "I hear little digging sounds."
msgstr "我听到有轻微的挖土的声音。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR"
msgid "It's quivering."
msgstr "它在颤抖。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Awwww, they want hugs!"
msgstr "啊，它们想要拥抱！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "What a smell! Light a match next time!"
msgstr "什么鬼味道！下次划根火柴！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.THULECITE"
msgid "I don't think it would burn."
msgstr "我觉得它应该不会燃烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.THULECITE_PIECES"
msgid "This Thulecite crumbled to pieces."
msgstr "这块铥矿已经成了碎片。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.THURIBLE"
msgid "It smells like burnt hair!"
msgstr "它闻起来像头发烧焦的味道！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL.GENERIC"
msgid "It's covered in nasty warts and fungus!!"
msgstr "它长满肮脏的肉瘤和蘑菇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL.RAGE"
msgid "Woah! It's packing a punch now!"
msgstr "哇！现在击出高水平了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "It's a hole, what do you want from me?"
msgstr "这是一个洞，你想从我这里得到什么呢？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "A mutant mushroom! I want it!"
msgstr "一个变异的蘑菇！我要它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "What is that? It's smelly."
msgstr "那是什么？真难闻。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOPHAT"
msgid "A top hat and a lighter, a perfect combination."
msgstr "高礼帽和打火机，真是绝配。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TORCH"
msgid "Fire is so pretty."
msgstr "火焰太漂亮了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Walking's for suckers."
msgstr "行走是为了吸吮。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Magic stuff."
msgstr "魔法材料。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I didn't wanna walk, anyway."
msgstr "反正我不想走了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "Yuck. It smells like sulfur."
msgstr "真讨厌。 它闻起来像硫磺。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAILMIX"
msgid "Crunch crunch crunch."
msgstr "嘎嘣嘎嘣嘎嘣。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAILS"
msgid "You can't push me around."
msgstr "我可不会任你摆布。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRANSISTOR"
msgid "Electrical doo-dah, doo-dah."
msgstr "电子元件—元件—。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP"
msgid "It's a bit passive aggressive, but it'll work."
msgstr "虽然有点被动，但有用就行。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP_TEETH"
msgid "It would be better with fire."
msgstr "有火就更好了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "I know exactly what kind of jerk leaves this lying around!"
msgstr "我完全知道什么样的混蛋会在地上放这东西！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST.BURNT"
msgid "The trunk burned nicely."
msgstr "箱子已经彻底烧毁了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST.GENERIC"
msgid "It's a trunk for my junk."
msgstr "可以帮我装东西的箱子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREASURECHEST_TRAP"
msgid "Dirty trick!"
msgstr "卑鄙的诡计！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREECLUMP"
msgid "Moooooooooooooove."
msgstr "让开。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREEGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TREEGUARD"
msgid "You'll burn like the rest!"
msgstr "你可以像其他人一样烧掉！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_1"
msgid "That's how you play marbles, right? By burning them?"
msgstr "你们就这么玩弹珠？烧掉？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_10"
msgid "Hey Maxwell, I think you dropped these!"
msgstr "嘿，麦斯威尔，这些是你掉的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_11"
msgid "Ooh, I wonder if he has a flamethrower!"
msgstr "哦，不知道他有没有火焰喷射器！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_12"
msgid "I bet Wilson would enjoy dissecting this."
msgstr "我肯定威尔逊会想要解剖这个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_13"
msgid "She looks like she was forged in flame."
msgstr "她看起来像是经过烈火锻造的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_14"
msgid "They put a bird on it."
msgstr "他们在它身上放了一只鸟。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_15"
msgid "What is it with megalomaniacs and chess?"
msgstr "自大狂加上象棋，会是什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_16"
msgid "What is it with megalomaniacs and chess?"
msgstr "自大狂加上象棋，会是什么？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_17"
msgid "Metal bends when it gets nice and hot."
msgstr "金属精密发热的时候会弯曲。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_18"
msgid "I bet Wigfrid would be into this."
msgstr "我肯定薇格弗德会喜欢这个。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_19"
msgid "Useful only for kindling."
msgstr "只对点火有用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_2"
msgid "A cheap fake. It probably doesn't even burn properly."
msgstr "廉价的假玩意儿。它也许都不能当柴火烧。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_20"
msgid "This looks a little like a fire iron."
msgstr "这看起来有点像个火炉用具。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_21"
msgid "When I crank it Wes pretends to ride unicycle circles around me."
msgstr "我转动曲柄的时候，韦斯假装在我周围骑独轮车。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_22"
msgid "I could use this as a very long fuse..."
msgstr "我能将这个当成一个很长的导火索……"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_23"
msgid "It looks like it might melt in a fire."
msgstr "似乎它可以在火里熔掉。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_24"
msgid "I don't want Ms. Wickerbottom to be sad. Let's burn it!"
msgstr "我不想让薇克巴顿女士难过。让我们烧了它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_25"
msgid "I stuck one down Wolfgang's unitard when he wasn't looking. Haha."
msgstr "我趁他没注意的时候粘了一个东西在沃尔夫冈的弹力紧身衣上面。哈哈。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_26"
msgid "I would have roasted it."
msgstr "我真希望烤烤它。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_27"
msgid "I want to stick it in a fire!"
msgstr "我想把它放在火里烧了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_28"
msgid "Chess is for pompous dorks."
msgstr "象棋只适用于自大的笨蛋。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_29"
msgid "Chess is for pompous dorks."
msgstr "象棋只适用于自大的笨蛋。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_3"
msgid "Why use a knife when you can use fire?"
msgstr "可以用火，为什么你却用刀？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_30"
msgid "Probably the most boring game ever invented."
msgstr "可能是发明出来的最无聊的游戏了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_31"
msgid "Probably the most boring game ever invented."
msgstr "可能是发明出来的最无聊的游戏了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_32"
msgid "Just a big dumb ball."
msgstr "只是一个又大又愚蠢的球。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_33"
msgid "Ewww! Who would ever wear that!"
msgstr "呃呃呃唔！谁会去穿它！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_34"
msgid "Ughhh! That's so nasty!"
msgstr "啊啊啊！太讨厌了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_35"
msgid "Hey Wes! Dare you to drink the last bit!"
msgstr "嘿，韦斯！你敢喝最后一口吗！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_36"
msgid "Pfft, they're not even sharp."
msgstr "啐，它们甚至都不锋利。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_37"
msgid "Looks like firewood to me."
msgstr "在我看来好像木材。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_38"
msgid "It makes stuff look small no matter which way I turn it."
msgstr "无论我怎么转动，它都会让东西看上去更小。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_39"
msgid "Who needs just one glove?"
msgstr "谁只需要一只手套？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_4"
msgid "He looks like he was forged in flame."
msgstr "他看起来像是经过烈火锻造的。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_40"
msgid "Snails are gross!"
msgstr "蜗牛好恶心！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_41"
msgid "Ooo, it's warm."
msgstr "哦，很温暖。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_42"
msgid "I don't like snakes."
msgstr "我不喜欢蛇。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_43"
msgid "Yeesh. I can feel the nostalgia dripping off it."
msgstr "呀，我可以感觉到怀旧的气息迎面而来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_44"
msgid "It's just junk."
msgstr "不过是垃圾而已。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_45"
msgid "It's got kind of a dumb face, huh?"
msgstr "它有一张愚笨的面孔，是吧？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_46"
msgid "I never take my pigtails out anyway."
msgstr "反正我不会露出我的辫子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_5"
msgid "Check out those tiny thrusters. Such explosive power!"
msgstr "看看那些迷你推进器。真是惊人的爆发力！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_6"
msgid "These wires get WX all frazzled. Heh heh."
msgstr "这些线让 WX 疲惫不堪。呵呵。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_7"
msgid "Spinning the stick in the hole could start a fire. Thanks Girl Scouts!"
msgstr "把权杖旋进空洞可以起火。感谢女童军！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_8"
msgid "I've never liked bathing with water."
msgstr "我从来不喜欢用水洗澡。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRINKET_9"
msgid "Cute as Wendy's lil nose."
msgstr "和温蒂的小鼻子一样可爱。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Now my friend will never leave."
msgstr "现在，我的朋友将再也不会离开。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNKVEST_WINTER"
msgid "Not as warm as a good fire, but still pretty good!"
msgstr "虽然不像火焰那样温暖，但还不错！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNK_COOKED"
msgid "It still doesn't look totally edible."
msgstr "它还是看起来不可以完全食用。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.TRUNK_SUMMER"
