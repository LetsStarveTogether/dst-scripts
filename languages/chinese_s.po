msgstr "哇哦！好大的桅杆！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
