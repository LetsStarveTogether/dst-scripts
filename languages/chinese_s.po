msgstr "它的质感怪怪的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
