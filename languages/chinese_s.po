msgstr "不要指望我会吃这东西！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
