msgstr "我真没想到它还能发出更糟糕的味道……"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.COMPOSTINGBIN.DRY"
