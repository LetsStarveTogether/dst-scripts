msgstr "他们忙着呢。"

#. STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.ACTIONFAIL.GIVETOPLAYER.DEAD"
