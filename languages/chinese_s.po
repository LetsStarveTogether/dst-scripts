#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78.GHOST"
msgid "I better get a heart for %s."
msgstr "我最好为 %s 拿到心。"

