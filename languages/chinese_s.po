msgstr "现在不能做了。天就要黑了。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.SLEEPING"
msgid "It's sleeping."
msgstr "它在睡觉。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.SLOTFULL"
msgid "I should probably use what's up there first."
msgstr "我应该可能先用在上面的东西。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.WRONGGEM"
msgid "I don't think that one'll work here."
msgstr "我不认为那个东西在这里会有用。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "That's gotta be rebuilt, eh?"
msgstr "那需要重建，呃？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "I've something for you when you've got a mo'."
msgstr "当你有空的时候我有东西要给你。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "I don't think they... um..."
msgstr "我觉得它们不会...嗯..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "They need to make room for my present, eh?"
msgstr "他们得给我的礼物腾出点空间，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Let them get some shut eye."
msgstr "让他们小睡一下。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "I've something for you when you've got a mo'."
msgstr "当你有空的时候我有东西要给你。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "I don't think they... um..."
msgstr "我觉得它们不会...嗯..."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "They need to make room for my present, eh?"
msgstr "他们得给我的礼物腾出点空间，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Let them get some shut eye."
msgstr "让他们小睡一下。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.INUSE"
msgid "Maybe I can find a caribou to ride instead."
msgstr "或许我能找到驯鹿来代替。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "I should wait for the dust to settle, eh?"
msgstr "我应该等到一切尘埃落定，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.INUSE"
msgid "Oops! Sorry. Someone's using that."
msgstr "哎呀！抱歉，有人在用。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I ain't too keen on that, eh?"
msgstr "我对那个不太感兴趣，知道吧？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "That piece ain't right."
msgstr "那个棋子不对。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Whoops. I used the wrong dish."
msgstr "哎呦，我用错餐具了。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "This food is already on a dish."
msgstr "这道菜已经装盘了。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "I can't right now. Sorry!"
msgstr "我现在不行。不好意思！"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.RUMMAGE.INUSE"
msgid "Sorry! I'll wait til you're finished there."
msgstr "对不起！我会等你做完那里的事情。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "I should wait for the dust to settle, eh?"
msgstr "我应该等到一切尘埃落定，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I don't think she'd like that."
msgstr "我觉得她不喜欢剃毛。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.GENERIC"
msgid "You can't shave what's not hair."
msgstr "你不能剃掉不是毛发的东西。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.NOBITS"
msgid "It's already shorn, eh?"
msgstr "已经剃过了，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.REFUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.SHAVE.REFUSE"
msgid "I like my beard."
msgstr "我喜欢我的胡子。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.GENERIC"
msgid "It's already packed tighter than a Toronto streetcar."
msgstr "已经比大城市的公交还挤了。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.INUSE"
msgid "Oh, sorry. I didn't mean to hover over your shoulder."
msgstr "噢，对不起。我不是故意停在你肩膀上的。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.STORE.NOTALLOWED"
msgid "I could probably find a better place to put that."
msgstr "或许我能找到更好的地方放那个东西。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.CANTLEARN"
msgid "Err... do you understand this one, 'Luce?"
msgstr "呃...你懂这个吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.KNOWN"
msgid "I know that already, eh?"
msgstr "我已经知道这个了，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I don't think I'm in the right place for this."
msgstr "对这件事，我想自己立场错了。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "Now's not the time, eh?"
msgstr "现在时机不对，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "You see another key around here, Lucy?"
msgstr "露西，你看到附近有其他钥匙吗？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "That was the wrong key, eh?"
msgstr "那把钥匙不对，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I need some things to wrap first, eh?"
msgstr "首先我需要一些东西来包起来，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.GENERIC"
msgid "No thanks. I have terrible writing."
msgstr "不用了，谢谢。我的字写得很糟糕。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.WRITE.INUSE"
msgid "If I could just... scooch in there after you..."
msgstr "要是我能在你之后在那也写上一些…"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC"
msgid "Sorry, I can't do that."
msgstr "对不起，我做不到。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT"
msgid "Lucy is going to be so proud of me!"
msgstr "露西肯定会为我感到骄傲的！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "That's a wrap, eh!"
msgstr "我太厉害了，是吧！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL"
msgid "Oh well. I gave it a good try."
msgstr "唉，好吧。至少我尝试过了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Pothole incoming."
msgstr "快到坑里了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Take cover!"
msgstr "寻找掩护！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "Dangerous 'round here."
msgstr "这附近危险。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Maybe put the sinkholes on pause, eh?"
msgstr "可能暂停安置污水坑，呃？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "I got a tribute for you, eh?"
msgstr "我为你带来了贡品，呃？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "This here's for you, eh?"
msgstr "在这里献给你，呃？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "We better hightail it out of here."
msgstr "你最好迅速离开这里。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Let's skedaddle!"
msgstr "我们快逃走吧！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "There'll be trouble if we don't leave."
msgstr "我们再不走就有麻烦了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BECOMEGHOST"
msgid "oOooOOOO!!"
msgstr "呜呜呜呜呜！！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BEES"
msgid "Bees! Bees!"
msgstr "蜜蜂！蜜蜂！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BOOMERANG"
msgid "Sorry! Clumsy me!"
msgstr "抱歉！我真是笨死了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BRAVERY_POTION"
msgid "Glad that's over. Never thought I'd be scared of trees."
msgstr "很高兴终于结束了。真没想到我会怕树。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_BURNT"
msgid "Ouch, that's hot!"
msgstr "哎哟，太热了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CANFIX"
msgid "\nI think I can fix this!"
msgstr "\n我觉得我能修好这个！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CAVEIN"
msgid "Sounds like some trouble up above."
msgstr "听起来上面有些麻烦。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE"
msgid "Who's there, eh?"
msgstr "谁在那儿，嗯？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CHARLIE_ATTACK"
msgid "Yeouch! That was rough!"
msgstr "哎哟！太粗暴了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COLD"
msgid "It's a bit chilly out here!"
msgstr "这里有点冷！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_COMPASS_OUT"
msgid "I'll always have the North in my heart."
msgstr "北方永远在我心中。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_CRAFTING_FAIL"
msgid "I can't do that right now."
msgstr "我现在没法做那个。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DAMP"
msgid "A bit damp, eh?"
msgstr "有点潮湿，是吗？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DEERCLOPS"
msgid "What was that?"
msgstr "那是什么？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DESPAWN"
msgid "This feels strangely familiar..."
msgstr "有种奇怪的熟悉感......"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Fixed'r right up."
msgstr "完全恢复了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_DUSK"
msgid "It's almost my bedtime."
msgstr "快到我的睡觉时间了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.GENERIC"
msgid "Tasty!"
msgstr "好吃！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.INVALID"
msgid "I don't think my teeth could cut through that."
msgstr "我的牙齿应该咬不动那个。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.PAINFUL"
msgid "That was past the expiry date."
msgstr "已经过了保质期了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.SPOILED"
msgid "That was a wee bit manky."
msgstr "有一点点坏了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.STALE"
msgid "I got to that one just in time."
msgstr "我要赶紧把它吃掉。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_EAT.YUCKY"
msgid "I'd rather chew on blubber balls."
msgstr "我宁愿嚼鲸脂丸子。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.1"
msgid "Hnff..."
msgstr "哼..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.10
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.10"
msgid "Huff... huff..."
msgstr "呼...呼..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.2"
msgid "No... Don't get up... Lucy..."
msgstr "不...别起来...露西..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.3"
msgid "Heavy... Eh...?"
msgstr "这么重...呀...？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.4"
msgid "...oof..."
msgstr "...见鬼..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.5"
msgid "I'll keep... lumberin' along..."
msgstr "我会继续...伐木..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.6"
msgid "No point... complainin'..."
msgstr "抱怨...没意义..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.7"
msgid "Work's... gotta get done..."
msgstr "工作...总得完成..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.8"
msgid "Nothin' like... honest work..."
msgstr "老实干活...最有意义..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENCUMBERED.9"
msgid "I'm more of a chopper than a lifter..."
msgstr "我比较擅长砍东西，而不是扛东西..."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_DARK"
msgid "Who turned out the lights?"
msgstr "谁关的灯？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ENTER_LIGHT"
msgid "Brilliance!"
msgstr "世界亮了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FAN_OUT"
msgid "I guess I'll just have to suffer now."
msgstr "我猜现在我不得不忍受高温的折磨了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_FREEDOM"
msgid "I got out!"
msgstr "我出来了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_GHOSTDRAIN"
msgid "I'm goin', like, nutso over here..."
msgstr "我在这边快要疯掉了…"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HIGHRESEARCH"
msgid "Informative."
msgstr "增长知识。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOT"
msgid "It's so hot out here!"
msgstr "这里太热了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HOUNDS"
msgid "There's something out there."
msgstr "那边有什么东西。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNGRY"
msgid "I'm getting peckish."
msgstr "越来越饿了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "The beastie is nearby."
msgstr "动物就在附近。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I'm more of a woodsman than a hunter anyway."
msgstr "不管怎样，我更擅长伐木，而不是狩猎。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The beastie's tracks washed away."
msgstr "动物的踪迹已经被雨冲掉了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Need more poop, eh?"
msgstr "需要更多便便，是吗？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_INV_FULL"
msgid "I can't carry any more kit."
msgstr "我拿不了更多的东西了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Monster hosers, incoming."
msgstr "傻子怪兽，来了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_ENRAGE"
msgid "I think it's time to run."
msgstr "我想逃跑的时候到了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KLAUS_UNCHAINED"
msgid "You shoulda stayed down."
msgstr "你应该留下来。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_KNOCKEDOUT"
msgid "Ow. What was that?"
msgstr "噢。这是怎么回事？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "That tickled a bit, eh?"
msgstr "有点麻，是吗？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_LOWRESEARCH"
msgid "That was barely even worth it, eh?"
msgstr "几乎没什么价值，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOSQUITOS"
msgid "Skeeters!"
msgstr "蚊子！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast looks in a bad way, eh."
msgstr "这个野兽看起来很糟糕，呃。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERAFK"
msgid "I better deal with these hosers first."
msgstr "我最好先对付这些傻子。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERGIFT"
msgid "Now's definitely the wrong time to be celebratin' Christmas."
msgstr "现在绝对不是庆祝圣诞节的时候。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSIESTA"
msgid "Can't siesta, something's chasing me."
msgstr "没法午休，有东西在追我。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODANGERSLEEP"
msgid "It's too scary out to sleep."
msgstr "野外睡觉太可怕了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP"
msgid "Only a hoser sleeps during the day."
msgstr "只有失败者才在白天睡觉。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not feelin' too restful right now."
msgstr "我现在感觉不太平静。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSIESTA"
msgid "My belly is rumbling. I'd never be able to relax."
msgstr "我的肚子已经咕咕叫了。饿得我没法放松睡觉。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOHUNGERSLEEP"
msgid "My belly is too empty to fall asleep."
msgstr "我的肚子太饿了，睡不着。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'd rather open that with my feet on the ground."
msgstr "我宁愿脚踏实地地打开那个。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA"
msgid "I prefer to siesta between chopping sessions, not at night."
msgstr "我宁愿在砍树的间隙午休，也不要在晚上睡觉。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I prefer to siesta between chopping sessions, not at night."
msgstr "我宁愿在砍树的间隙午休，也不要在晚上睡觉。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOSLEEPONFIRE"
msgid "Not sure that's entirely safe."
msgstr "不确定是不是一定安全。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NOWARDROBEONFIRE"
msgid "That's okay. I just need a good flannel, anyway."
msgstr "没关系。反正我只要有一件不错的法兰绒衬衫就够了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_NO_TRAP"
msgid "Close one!"
msgstr "好险！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PECKED"
msgid "Sorry! I'll try harder!"
msgstr "对不起！我会更努力的！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PETRIFED_TREES"
msgid "No! Not the wood!"
msgstr "不！不是木头！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Well that's not right."
msgstr "嗯，那是不对的。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_QUAKE"
msgid "The ground is heaving!"
msgstr "大地在晃！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REPELLED"
msgid "That's just impolite, eh."
msgstr "只是不礼貌，呃。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RESEARCH"
msgid "Learnin' keeps your mind sharp. Like an axe."
msgstr "学习会让你的思想保持敏锐。就像斧子一样。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Lucy'll never let me live that down."
msgstr "露西绝不会让我沉睡那么久的。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There we go."
msgstr "好啦！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_REVIVING_CORPSE"
msgid "You fell like a tree, eh?"
msgstr "你像树一样倒下了呀？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_RUINS_RESET"
msgid "All that hard work gone to waste."
msgstr "所有努力都白白浪费了。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_NO"
msgid "We didn't cut it, Lucy."
msgstr "我们没能劈开它，露西。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SACREDCHEST_YES"
msgid "Thanks'm."
msgstr "谢谢。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SHELTER"
msgid "Thanks for the shelter, buddy. I'm still gonna chop you."
msgstr "感谢你为我遮荫挡雨，伙计。我还是要砍掉你。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SNARED"
msgid "You'll have to do better than that."
msgstr "你必须做得更好。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SOAKED"
msgid "Better hold on tight, Lucy."
msgstr "最好抓紧点，露西。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_SPOOKED"
msgid "You see that, Lucy?"
msgstr "你看见了吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THORNS"
msgid "Ouch!"
msgstr "哎哟！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_THURIBLE_OUT"
msgid "No more luring, I guess."
msgstr "没有诱饵了，我猜。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPED"
msgid "The warty hoser ran away!"
msgstr "长瘤的傻子跑掉了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOADESCAPING"
msgid "It's gonna turn tail soon."
msgstr "它会很快躲开。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOOL_SLIP"
msgid "The stuff of nightmares!"
msgstr "真是一场噩梦！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TORCH_OUT"
msgid "My light ran out!"
msgstr "火炬灭了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "I got sand in my beard."
msgstr "我的胡子里都是沙子。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oops!"
msgstr "哎呀！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_UNIMPLEMENTED"
msgid "Ouch! That wasn't very polite."
msgstr "哎哟！它不是非常礼貌。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WET"
msgid "Plaid's warm, even when wet."
msgstr "格子衣服就算湿了，也还是暖和的。"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WETTER"
msgid "I'm getting quite wet, eh?"
msgstr "我身上很湿，是不是？"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMHOLE"
msgid "It was gross in there!"
msgstr "里面太可怕了！"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_WORMS"
msgid "Oh geez. I hope you're ready, Lucy."
msgstr "哦，天啊。我希望你准备好了，露西。"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.DEER"
msgid "Hunting season's open!"
msgstr "狩猎季节开始了！"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.GENERIC"
msgid "Get over here, eh!"
msgstr "放马过来吧，哈！"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.PIG"
msgid "I'll make bacon of you yet!"
msgstr "我会把你做成培根！"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.PREY"
msgid "This here's the end for you!"
msgstr "你就要完蛋了！"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER"
msgid "For the North!"
msgstr "向北方前进！"

#. STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.BATTLECRY.SPIDER_WARRIOR"
msgid "Prepare for a choppin'!"
msgstr "准备好砍砍砍！"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.GENERIC"
msgid "I think that's enough."
msgstr "差不多够了。"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PIG"
msgid "I thought that would go better."
msgstr "我原以为情况会好转的。"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.PREY"
msgid "Sorry, sorry!"
msgstr "对不起，对不起！"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER"
msgid "Sorry!"
msgstr "抱歉！"

#. STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Same time again tomorrow, eh?"
msgstr "明天同一时间再战，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL"
msgid "That ain't right."
msgstr "那样不对。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "It's a flower? I guess."
msgstr "是一朵花？我猜的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Maybe we should split, eh?"
msgstr "或许我们该分开，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I'm not comfortable with this."
msgstr "我对这不是很舒服。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Yup. It's a flower."
msgstr "是的。是一朵花。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "That flower's acting funny..."
msgstr "那朵花的行为太好笑…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Did it just move?"
msgstr "它刚刚是不是动了？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It seems a bit show-offy to me."
msgstr "对我来说似乎有点炫耀的意味。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN"
msgid "I should grow it and then chop it down!"
msgstr "我应该把它种出来，然后再砍倒它！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_COOKED"
msgid "What a waste of a perfectly good tree."
msgstr "真是浪费了这么好的树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ACORN_SAPLING"
msgid "Here comes a tree!"
msgstr "又来了一棵树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ADVENTURE_PORTAL"
msgid "I wonder if that's the way out of here."
msgstr "我怀疑那是不是离开这里的路。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.AMULET"
msgid "Always have a backup plan."
msgstr "应该总是准备一个备用计划。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR.BROKEN"
msgid "Looks a little worn out."
msgstr "好像有点坏了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR.WORKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR.WORKING"
msgid "There's axe marks on these altar stones."
msgstr "祭坛的石头上有斧头标记。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Looks a little worn out."
msgstr "好像有点坏了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANCIENT_STATUE"
msgid "Another hoser."
msgstr "又一个失败者。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANIMAL_TRACK"
msgid "A large woodland creature passed this way!"
msgstr "有一只大型林地生物从这走过！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.GENERIC"
msgid "They grow'em big out here, eh?"
msgstr "它们越长越大，往这里来了，呃？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.UNHAPPY"
msgid "That critter's in a real bad mood."
msgstr "家畜的心情很糟糕。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It seems agreeable."
msgstr "看起来和蔼可亲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ANTLIONTRINKET"
msgid "Could give it to some sandy hoser."
msgstr "可以把它送给有沙的傻子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORDRAGONFLY"
msgid "Plaid is all the armour I need."
msgstr "格子图案是我唯一需要的护甲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORGRASS"
msgid "It's better than nothing."
msgstr "总比什么都没有好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORMARBLE"
msgid "It's hard to swing an axe while wearing this."
msgstr "穿着这个很难挥动斧子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORRUINS"
msgid "That'll stop the hurt."
msgstr "这可以防止伤害。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSKELETON"
msgid "Sticks to yer ribs."
msgstr "刺穿你的肋骨。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSLURPER"
msgid "It tickles. I think it's still alive."
msgstr "好痒，我觉得它还是活的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORSNURTLESHELL"
msgid "You can never be too safe."
msgstr "永远要小心为上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMORWOOD"
msgid "It fits me so well!"
msgstr "它太适合我了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARMOR_SANITY"
msgid "It makes me queasy to look at."
msgstr "看见它我就想吐。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Wood is the best at burning."
msgstr "木头可是最好的燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "Let the wood guide the way."
msgstr "让树引路吧."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Let's give our neighbours some guidance."
msgstr "让我们给邻居一点指引。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Wood is the best at burning."
msgstr "木头可是最好的燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Let the wood guide the way."
msgstr "让树引路吧."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Let's give our neighbours some guidance."
msgstr "让我们给邻居一点指引。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.GENERIC"
msgid "It's all burnt up."
msgstr "被烧得精光。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "This used to be an eyebone."
msgstr "这曾经是个眼骨。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "This used to be a slimy flower."
msgstr "这曾经是一朵黏滑的花。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Well that's a shame."
msgstr "嗯，可惜了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It's soaking up energy, hey?"
msgstr "它在吸收能量，喂？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Don't wanna overdo it."
msgstr "别想画蛇添足。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "That'd be my cue to leave."
msgstr "这是我提示离开的暗示。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Where d'you think it goes, Lucy?"
msgstr "你觉得它去哪了，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_GATE.ON"
msgid "That oughta do it."
msgstr "应该试一试。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_KEY"
msgid "Got it from that big bony hoser."
msgstr "从那个瘦瘦的大傻子那里得到的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "Gotta be a way to turn it on."
msgstr "肯定有方法打开它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "What a nightmare."
msgstr "真是个噩梦。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It probably said something important. Oh well."
msgstr "它可能说了什么重要的事。噢，好啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It's an old drawing of strange creatures."
msgstr "这是一副古老的图画，画着奇怪的生物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Nothin' of interest left here."
msgstr "这里没留下什么有兴趣的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Black muck is covering everything in this drawing."
msgstr "图画里，黑色的淤泥覆盖了一切。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Don't look at this one, Lucy."
msgstr "不要看这个，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "Looks like a bustling city."
msgstr "看起来像是熙熙攘攘的城市。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ATRIUM_STATUE"
msgid "Was it supposed to be holding something?"
msgstr "它本应该握着什么吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.AXE"
msgid "It's not as nice as Lucy."
msgstr "没有我的露西斧好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "A face only a mother could love."
msgstr "长得这么丑，估计只有亲妈才不会嫌弃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "I enjoy sleeping outside, too."
msgstr "我也喜欢睡在外面。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACKPACK"
msgid "That's a decent looking rucksack."
msgstr "那是个好看的帆布背包。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BACONEGGS"
msgid "Awww. It's just front bacon."
msgstr "呜呜呜。只有五花培根。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOON"
msgid "It's squeaky. Just like a real woodland creature."
msgstr "它咯咯响。就像真正的林地生物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BALLOONS_EMPTY"
msgid "Are those balloons?"
msgstr "那些是气球吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BANDAGE"
msgid "At least I didn't have to pay for it."
msgstr "至少我不必付钱买它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BASALT"
msgid "That rock ain't going to move."
msgstr "那块岩石是不会移动的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BAT"
msgid "Who taught that rat to fly?"
msgstr "是谁教会那只老鼠飞的？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATBAT"
msgid "A mouse with wings?"
msgstr "长着翅膀的老鼠？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATCAVE"
msgid "Full of the little critters!"
msgstr "里面住满了小生物！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING"
msgid "Gross!"
msgstr "好恶心！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BATWING_COOKED"
msgid "Gross! And tasty! So confusing!"
msgstr "好恶心！但又很好吃！好为难啊！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARDHAIR"
msgid "My hair's not that colour. Not my beard, anyway."
msgstr "我的毛发不是这个颜色。总之这不是我的胡子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER"
msgid "That's a big bear!"
msgstr "好大一头熊！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGERVEST"
msgid "Now this is some proper winter gear."
msgstr "终于找到合适的冬装了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEARGER_FUR"
msgid "It's as thick as my head!"
msgstr "就跟我的头发一样厚！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_FURRY"
msgid "I love camping."
msgstr "我喜欢露营。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEDROLL_STRAW"
msgid "I slept on worse back at the lumber camp."
msgstr "想当初在伐木场的时候，我还睡过更糟糕的地方呢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.GENERIC"
msgid "She's making the flowers grow."
msgstr "她在给花授粉，让花开得更艳。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEE.HELD"
msgid "Now what do I do with her?"
msgstr "现在我拿她怎么办？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.BURNT"
msgid "No, not the bees!"
msgstr "不，不要烧我的蜜蜂！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Maple syrup substitute!"
msgstr "枫糖浆替代品！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.GENERIC"
msgid "Buzzers!"
msgstr "蜂群！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.NOHONEY"
msgid "I'm getting hungry just looking at it."
msgstr "只是看着它我就饿了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.READY"
msgid "Maple syrup substitute!"
msgstr "枫糖浆替代品！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I could get more if I waited."
msgstr "如果再等等，我可以收获更多的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like this one's attitude."
msgstr "我欣赏这个的态度。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.FOLLOWER"
msgid "I think he likes me."
msgstr "我觉得他喜欢我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.GENERIC"
msgid "He smells like a sod house."
msgstr "他闻起来像草房一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.NAKED"
msgid "Cheer up, eh?"
msgstr "瞬间有精神了，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.ORNERY"
msgid "Why so glum, chum?"
msgstr "兄弟，为何闷闷不乐？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.PUDGY"
msgid "You're almost as big as a moose!"
msgstr "你几乎跟驼鹿一样大！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.RIDER"
msgid "I'm sorry, want to go for a ride?"
msgstr "打扰了，想要出去骑一下吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALO.SLEEPING"
msgid "He's catching some zeds."
msgstr "他在睡觉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOHAT"
msgid "Now I'm the king of the beefalo!"
msgstr "现在我是牦牛王！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEFALOWOOL"
msgid "It feels like my beard."
msgstr "感觉像我的胡子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEGUARD"
msgid "Hopefully no one's allergic, eh?"
msgstr "希望没有人过敏，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHAT"
msgid "That'll keep the bees out of yer eyes."
msgstr "这个可以防止蜜蜂蜇你的眼睛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEHIVE"
msgid "They're all comfy-cozy in there."
msgstr "它们在里面又舒适又惬意。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE"
msgid "I don't know if the bees like this."
msgstr "不知道蜜蜂喜不喜欢这个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEMINE_MAXWELL"
msgid "Hey! That's just mean!"
msgstr "喂！这太卑鄙了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEEN"
msgid "Bees got no business getting that big."
msgstr "蜜蜂没有道理变得那么大。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I'm not eating honey off the ground."
msgstr "我没有从地上捡蜂蜜吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "The bees are planning something."
msgstr "蜜蜂们在计划着什么。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Nature is something else, eh?"
msgstr "自然是别的东西，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEESWAX"
msgid "Yeesh, that's waxy."
msgstr "咦嘘，像蜡一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BEETLETAUR"
msgid "Gotta chop that armor up."
msgstr "要把那盔甲劈开。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BELL"
msgid "I'm amazed it makes such a crisp sound."
msgstr "它居然能发出这么清脆的声音，太让我惊讶了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_ACTIVE"
msgid "I guess I should be used to weird stuff by now."
msgstr "我想如今我得适应那些怪东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "Poor lil guy."
msgstr "可怜的小东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "Cute, isn't it 'Luce?"
msgstr "可爱，那不是露西吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES"
msgid "I have a heartier appetite than that."
msgstr "它们填不饱我的胃口。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_COOKED"
msgid "Tastes like warm berries."
msgstr "像热浆果的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY"
msgid "That's good eatin', eh?"
msgstr "好吃吧，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Mmm. These'd be perfect with some syrup."
msgstr "嗯。加点糖浆就完美了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs a good poopin'."
msgstr "它需要有充足养分的粪便肥料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.BURNING"
msgid "Can't save it now."
msgstr "现在救不了它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "它染上病毒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Lookin' a bit down."
msgstr "再往下看一点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Saskatoon berries?"
msgstr "萨斯卡通浆果？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.PICKED"
msgid "No berries left!"
msgstr "没有浆果了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It's perished from the heat, eh?"
msgstr "它快要被热死了，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Lookin' pretty barren."
msgstr "看起来很荒芜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Can't save it now."
msgstr "现在救不了它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "它染上病毒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Lookin' a bit down."
msgstr "再往下看一点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I see a snack."
msgstr "我看到零食。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Eh, they'll be back."
msgstr "嗯，他们会回来的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Dry as the Alberta plains."
msgstr "和艾伯塔平原一样干燥。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIGFOOT"
msgid "Watch where you're stepping!"
msgstr "看着点儿踩！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRCHNUTDRAKE"
msgid "I'll chop you too!"
msgstr "我要把你也砍掉！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.DEAD"
msgid "I'm sorry. I failed you."
msgstr "很抱歉。我辜负了你。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Where I try to make birds reform their evil ways."
msgstr "我用来让臭鸟们反省自己恶行的地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "I'll get you something to eat soon, buddy."
msgstr "我很快就会给你搞点吃的，伙计。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Think aboot what you've done, bird!"
msgstr "想想你都做过些什么吧，臭鸟！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That's starting to smell."
msgstr "这个开始散发臭味了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "They look so innocent when they dream."
msgstr "它们睡着了之后倒是看起来很无辜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDCAGE.STARVING"
msgid "He's got a hankering for some poutine!"
msgstr "他渴望来点肉汁奶酪薯条！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRDTRAP"
msgid "I'll show those birds yet!"
msgstr "臭鸟们，等着吧！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG"
msgid "There's a bird in there, thinking evil bird thoughts."
msgstr "那里面有只满脑子邪恶思想的鸟。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BIRD_EGG_COOKED"
msgid "Well, at least it never became a bird."
msgstr "很好，至少它永远不会变成讨厌的鸟。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP"
msgid "It's been a while since my last confession."
msgstr "离我上一次忏悔已经有一阵子了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Hey now!"
msgstr "喂！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BISHOP_NIGHTMARE"
msgid "I can see the internal workings!"
msgstr "我可以看到它内部的零件！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_FIRE"
msgid "This seems a bit aggressive."
msgstr "这好像有点攻击性。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA"
msgid "I'm not much of a shot."
msgstr "我扔飞镖的技术一般般。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_LAVA2"
msgid "Someone else'll make better use of it."
msgstr "它对别人比较有用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_PIPE"
msgid "Anyone want a demonstration of my impressive lungpower?"
msgstr "有人想要演示一下我那令人难忘的肺活量吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_SLEEP"
msgid "A couple blows on that and you can escape just aboot anything!"
msgstr "对着那个打击两次，然后你就可以逃避任何事情了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLOWDART_YELLOW"
msgid "Gross bird parts made an okay weapon, I guess."
msgstr "我猜恶心的小鸟各部分会制成一个不错的武器。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEAMULET"
msgid "Just need a tasty beverage to cool now, eh?"
msgstr "现在只需要美味的饮品就可以冷静下来，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEGEM"
msgid "It's very cold."
msgstr "它好冷。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEMOONEYE"
msgid "It sees all with the cold sight of the North."
msgstr "它看到了一切，包括北部寒冷的景象。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.COMMON"
msgid "I'm not one for book learning."
msgstr "我可不是爱读书的人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUEPRINT.RARE"
msgid "Looks real complicated, that one."
msgstr "那东西看起来实在是复杂。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP"
msgid "That's not meat."
msgstr "那可不是肉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_CAP_COOKED"
msgid "That's not meat."
msgstr "那可不是肉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "I can never remember which ones you can eat."
msgstr "我不记得哪些蘑菇是可以吃的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "I'll come back later."
msgstr "我会再回来的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Well, that's over."
msgstr "噢，已经采完了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARDS"
msgid "So smooth. You can really see the grain."
msgstr "好光滑。你真的可以看到它上面的纹理。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARON"
msgid "I feel bad beatin' up such a little thing."
msgstr "揍这些个小东西，我都有点过意不去。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOARRIOR"
msgid "Tough guy, eh?"
msgstr "是个狠角色，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOAT"
msgid "Must have hit a Nor'easter."
msgstr "一定是碰到东北风暴了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESHARD"
msgid "I wish I knew how to make bread."
msgstr "真希望我知道如何做面包。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BONESTEW"
msgid "Sticks to your ribs."
msgstr "这可以填饱肚子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BIRDS"
msgid "I already know more than enough aboot those things."
msgstr "我已经知道这些事情的太多内幕了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_BRIMSTONE"
msgid "I know better than to mess with that, eh."
msgstr "我才没有蠢到去惹那东西，嗯。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_ELEMENTAL"
msgid "I'd rather stick with my axe, thanks."
msgstr "算了，我还是只用我的斧头就好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_FOSSIL"
msgid "I'm leaving that to the experts."
msgstr "那个就留给专家吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_GARDENING"
msgid "Does it grow trees?"
msgstr "它会长树吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_SLEEP"
msgid "The perfect book for a full moon."
msgstr "满月时适合看的书。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOK_TENTACLES"
msgid "They don't have tentacles in Canada."
msgstr "他们在加拿大没有触手。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BOOMERANG"
msgid "That looks hard to throw."
msgstr "看起来很难扔。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BRUSH"
msgid "You could debark a log with this thing."
msgstr "你可以用这个东西削去树皮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUGNET"
msgid "It can collect skeeters."
msgstr "可以用它来捕蚊子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLE"
msgid "What's inside? Hope it's logs."
msgstr "里面有什么？希望是木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNDLEWRAP"
msgid "The paper's brown. Like wood."
msgstr "纸张是棕色的。像木头一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUNNYMAN"
msgid "He looks friendly enough."
msgstr "他看起来很友善。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Done for."
msgstr "完蛋了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUSHHAT"
msgid "It's good for hiding from nature."
msgstr "这是与大自然融为一体的好办法。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTER"
msgid "I prefer margarine."
msgstr "我更喜欢人造黄油。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.GENERIC"
msgid "I never trusted those things, eh?"
msgstr "我从来不相信那些东西，你说呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLY.HELD"
msgid "Where are you going to run?"
msgstr "你还想往哪儿飞啊？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Crunchy! ...But soft?"
msgstr "嘎嘣脆！...但是又很松软？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUTTERFLYWINGS"
msgid "Sorry! Sorry. How awful!"
msgstr "对不起！对不起！好糟糕！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.BUZZARD"
msgid "Stay away from those meat snacks!"
msgstr "离那些肉点心远点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.GENERIC"
msgid "That's gonna hurt."
msgstr "会被扎到的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS.PICKED"
msgid "Called it."
msgstr "抓到了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_FLOWER"
msgid "It's a wonder anything grows in this climate at all."
msgstr "这种鬼气候下还能长出东西简直就是个奇迹。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT"
msgid "Would you put nails in your mouth?"
msgstr "你会把钉子往自己嘴巴里塞吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Much better."
msgstr "这下好多了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.EMBERS"
msgid "It's almost gone."
msgstr "快要熄灭了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Where's my guitar?"
msgstr "我的吉他哪儿去了？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.HIGH"
msgid "Uh oh! It's bit high!"
msgstr "哇哦！烧得好旺！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.LOW"
msgid "I should probably do something aboot that, eh?"
msgstr "我是不是应该做点什么，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.NORMAL"
msgid "I love a fire in the evening."
msgstr "我喜欢在晚上点一堆营火。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAMPFIRE.OUT"
msgid "It was good while it lasted."
msgstr "它还是燃着的时候比较好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.GENERIC"
msgid "Degenerate."
msgstr "退化。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY.HELD"
msgid "Want a peek at our prisoner, Lucy?"
msgstr "想要看一眼我们的犯人吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANARY_POISONED"
msgid "Diseased vermin."
msgstr "患病的害虫。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANDYBAG"
msgid "That there bag could hold a whole heap of candy."
msgstr "那里的袋子可能装着一大堆糖果。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CANE"
msgid "It's good for the back country."
msgstr "这可以帮助我重返故土。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT"
msgid "That's rabbit food."
msgstr "那是兔子吃的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_COOKED"
msgid "That's cooked rabbit food."
msgstr "那是烤熟的兔子食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_PLANTED"
msgid "I'm not one for vegetables, eh?"
msgstr "我可不是素食主义者，你说呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARROT_SEEDS"
msgid "Tiny carrots."
msgstr "迷你胡萝卜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Looks like the map ends here."
msgstr "地图在这里似乎就结束了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Eh, I prefer to just wander around the woods anyway."
msgstr "呃，我更喜欢绕着木头徘徊就好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Heh. Has a little compass and everything."
msgstr "嘿。有一些指南针和所有东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOON"
msgid "Pests."
msgstr "讨厌的动物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Good riddance."
msgstr "不在了就好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Ugh, how many more lives do you have?"
msgstr "呃，你还有几条命啊？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CATCOONHAT"
msgid "The traditional garb of the woodsman."
msgstr "樵夫的传统打扮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Some elbow grease'll move those, easy."
msgstr "用手推可以移动这些，简单。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "Can't reach that one."
msgstr "够不到那个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA"
msgid "It tastes tropical."
msgstr "热带水果的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Such a waste."
msgstr "太浪费了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Now it's a warm mush."
msgstr "现在它成了温暖的粥。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_BANANA_TREE"
msgid "They don't have those back home."
msgstr "在家乡看不到这种树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE"
msgid "It's all bunged up."
msgstr "堵得严严实实的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "More crowded than a Toronto subway!"
msgstr "比多伦多的地铁还拥挤！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "There're probably no trees down there anyway."
msgstr "不管怎样，那下面可能没有任何树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "It looks like Sudbury down there."
msgstr "下面看起来好像加拿大的萨德伯里。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "It's all bunged up."
msgstr "堵得严严实实的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.FULL"
msgid "Sorry! I'll wait til you're all done up there!"
msgstr "对不起！我会等到你在那边做完所有的事！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Maybe later. I've gotten cozy down here."
msgstr "可能过会儿。我在这下面待得很舒服。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_EXIT.OPEN"
msgid "There are probably trees up there."
msgstr "那上面也许有树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CAVE_FERN"
msgid "Hey! It's a fern!"
msgstr "嘿！是蕨类植物！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHARCOAL"
msgid "This makes me a bit sad."
msgstr "这让我有点儿难过。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK1"
msgid "Dead metal."
msgstr "废金属。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK2"
msgid "Dead metal."
msgstr "废金属。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSJUNK3"
msgid "Dead metal."
msgstr "废金属。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Good use of stone."
msgstr "有效利用石头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "That's not really my sort of thing, eh?"
msgstr "那真不是我干的事情，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "准备好，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "All the dog, none of the smell."
msgstr "全是狗，一点气味也没有。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "Not a wood sculpture, but it'll do."
msgstr "不是木雕像呀，但是还行。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "Fine detail on that base."
msgstr "在那基础上细节精致。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Good stonework."
msgstr "不错的石雕工艺。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Looks like a bit of a hoser."
msgstr "看起来有点像傻子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Well, I did say I had a hankering for \"stone fruit\"."
msgstr "好吧，我确实说我渴望“石头水果”。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "I miss horses."
msgstr "我想念马了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "准备好，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOOSEGOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MOOSEGOOSE"
msgid "Looks sturdy."
msgstr "看起来很坚固。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_MUSE"
msgid "I don't tend to trust anyone without a face. Lucy excluded, of course."
msgstr "我不会信任没有脸的人。当然不包括露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PAWN"
msgid "Just a humble peasant, really."
msgstr "实际上只是个谦卑的乡下人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_PIPE"
msgid "Kitschy. Just how Lucy and I like it."
msgstr "低级庸俗。就是我和露西喜欢的地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Pfft, tacky."
msgstr "啐，厚颜无耻。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Get ready, Lucy."
msgstr "准备好，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER"
msgid "He's doing his best!"
msgstr "它已经尽力了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "No one ever told him it was rude to stare."
msgstr "从来没有人告诉过他，盯着别人看是不礼貌的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "I wonder if it will ever wake up again."
msgstr "不知道它还会不会再醒过来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Earth hounds!"
msgstr "泥土狗！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYHOUND.STATUE"
msgid "Someone carved each individual hair."
msgstr "连狗毛都雕得很细致。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.GENERIC"
msgid "Look at the size of you."
msgstr "你可真大啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CLAYWARG.STATUE"
msgid "Wonder where that sculpture came from."
msgstr "不知道那是哪来的雕像。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.EMBERS"
msgid "It's almost gone."
msgstr "快要熄灭了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.GENERIC"
msgid "This'll make it feel more like home."
msgstr "有了这个，这里就更像家乡了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.HIGH"
msgid "Uh oh! It's bit high!"
msgstr "哇哦！烧得好旺！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.LOW"
msgid "I should probably do something aboot that, eh?"
msgstr "我是不是应该做点什么，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.NORMAL"
msgid "I love a cold fire in the evening."
msgstr "我喜欢在晚上点一堆冰火。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIRE.OUT"
msgid "It was good while it lasted."
msgstr "它还是燃着的时候比较好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I should go chop some wood for that, eh?"
msgstr "我应该去砍点木头来，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "It uses wood."
msgstr "它要用木头当燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.HIGH"
msgid "That's too much wood too fast!"
msgstr "那太多木头，速度太快了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.LOW"
msgid "There should be some wood around here somewhere."
msgstr "这附近应该有木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Mmmm. Smells woody."
msgstr "嗯。木头的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COLDFIREPIT.OUT"
msgid "If only I had some wood."
msgstr "要是我有木头就好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "东。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.GENERIC"
msgid "Points to the True North."
msgstr "指向正北方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.N"
msgid "True North."
msgstr "正北。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "东北。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "西北。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "南。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "东南。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "西南。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Well, better get building."
msgstr "好吧，最好开始建造了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMANDRAKE"
msgid "Was that a bad thing to do?"
msgstr "我是不是不应该那样做？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMEAT"
msgid "Just like my dear old ma used to make."
msgstr "跟老妈以前做的一模一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I still don't want to eat it."
msgstr "我还是不想吃它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKEDSMALLMEAT"
msgid "That'll just make me hungrier!"
msgstr "那只会让我觉得更饿！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.BURNT"
msgid "Burned to a crisp."
msgstr "都烧焦了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It'll be a bit longer, eh?"
msgstr "还要好一会儿，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Oh boy! Here it comes!"
msgstr "我的乖乖！马上就好了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.DONE"
msgid "Time for supper!"
msgstr "晚餐时间到！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COOKPOT.EMPTY"
msgid "It seems a waste to just leave it sitting there, empty."
msgstr "就这样把它放在这儿，也不煮东西，好像挺浪费的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.COONTAIL"
msgid "That's the end of that cat's tale."
msgstr "猫的尾巴。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN"
msgid "I like it, but not in everything that I eat."
msgstr "我喜欢玉米，但它不是我最爱的食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_COOKED"
msgid "Cooked with the goodness of corn."
msgstr "充分保留了玉米的精华。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CORN_SEEDS"
msgid "I'm more of a hewer of wood than a tiller of soil."
msgstr "我更多的是一名伐木工而不是农民。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTERLAB"
msgid "Anyone home?"
msgstr "有人在家吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_DRAGONLING"
msgid "Don't start no forest fires now, buddy."
msgstr "哥们，先别开始，现在没有森林火焰。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_GLOMLING"
msgid "Charmingly chubby."
msgstr "胖乎乎的，真迷人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_KITTEN"
msgid "Giving it pats is relaxing."
msgstr "轻轻拍它真是令人放松。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_LAMB"
msgid "Heh, it feels like a beard."
msgstr "嘿，感觉像胡子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PERDLING"
msgid "Look, it's not you. It's me."
msgstr "注意一下，不是你，而是我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CRITTER_PUPPY"
msgid "Man and robot's best friend."
msgstr "人类和机器人最好的伙伴。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.GENERIC"
msgid "He's planning something. I can tell."
msgstr "他正在谋划些什么。我看得出来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CROW.HELD"
msgid "You'll pay for your crimes, crow!"
msgstr "乌鸦，你遭到了报应！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTGRASS"
msgid "I think I might be allergic to this."
msgstr "我想我可能对这东西过敏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTLICHEN"
msgid "Yum! Tastes woody!"
msgstr "好吃！味道像木头一样！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTREEDS"
msgid "Want to hear my loon call?"
msgstr "想听听我学潜鸟叫吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CUTSTONE"
msgid "Part of the Canadian shield."
msgstr "加拿大地盾的一部分。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEADLYFEAST"
msgid "That doesn't smell quite right, eh."
msgstr "闻起来有点不对劲，是吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Nooo! I could have chopped it!"
msgstr "不！我本来可以把它砍掉的！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "What a waste."
msgstr "真是浪费。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Ahhhh!"
msgstr "啊——！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's calling to me!"
msgstr "它在召唤我！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "You're due for a chopping."
msgstr "是时候把你给砍了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.ANTLER"
msgid "Something's different aboot you..."
msgstr "你有点不对劲……"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER.GENERIC"
msgid "That's a creature of the woods, eh?"
msgstr "那是一个木头生物，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS"
msgid "That's a big moose!"
msgstr "好大一只驼鹿！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Now what is this good for?"
msgstr "这可以用来干什么？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_ANTLER"
msgid "Wish I still had a cabin I could mount these things in."
msgstr "真希望我还有一个小屋能把这些东西装进去。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEER_GEMMED"
msgid "That ain't natural."
msgstr "那不是天生的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's probably a tuft of grass."
msgstr "它可能是一丛草。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DESERTHAT"
msgid "That's easy on the eyes."
msgstr "真是赏心悦目。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DEVTOOL"
msgid "I'm not commenting on that."
msgstr "我选择不发表意见。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIRTPILE"
msgid "Hey! A clue!"
msgstr "嘿！一条线索！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.COLD"
msgid "It's really fuzzy from here."
msgstr "这里太不明显了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.GENERIC"
msgid "I wonder if it gets the hockey game."
msgstr "不知道可不可以用它来玩曲棍球比赛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.HOT"
msgid "Loud and clear! Something's near!"
msgstr "肯定没错！这附近有东西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARM"
msgid "I think I'm getting closer."
msgstr "我觉得越来越近了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGROD.WARMER"
msgid "Woah, careful there, bud."
msgstr "哇哦，仔细点儿，老兄。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It looks like something should plug in."
msgstr "看来它上面应该插有东西的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.READY"
msgid "It's ready to be unlocked."
msgstr "解锁准备就绪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Now all it needs is to be turned on."
msgstr "现在只需要启动它就可以了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DIVININGRODSTART"
msgid "That's a weird looking rod."
msgstr "那根棒子看起来好奇怪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONBODYHAT"
msgid "Nice needlework."
msgstr "好赞的针线活。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLY"
msgid "She'll burn all the trees before I can chop them!"
msgstr "在我把这些树砍倒之前，她会把它们全部烧掉的！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYCHEST"
msgid "Gaudy if you ask me."
msgstr "要我说这东西太华而不实了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Tacky taxidermy."
msgstr "厚颜无耻的动物标本剥制术。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It got even tackier, eh?"
msgstr "我变得更厚颜无耻了，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "I'm sweaty enough without help from a furnace."
msgstr "没有火炉的帮助，我出了够多的汗了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Just bask in that warm glow."
msgstr "只管在那温暖的光辉中晒晒太阳。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT"
msgid "I've never seen one of those before."
msgstr "我以前从来没见过这东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It tastes like maple syrup."
msgstr "味道有点像枫糖浆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Maybe I can grow more."
msgstr "也许我可以再多种些。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONHEADHAT"
msgid "That's a sight, eh?"
msgstr "那是一个景象，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONPIE"
msgid "Almost as good as butter tarts!"
msgstr "几乎和奶油蛋挞一样好吃！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGONTAILHAT"
msgid "Well, somebody's gotta do it."
msgstr "好吧，总有人要做这事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRAGON_SCALES"
msgid "I still don't believe in dragons."
msgstr "我还是不相信飞龙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK"
msgid "October food."
msgstr "十月份的食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DRUMSTICK_COOKED"
msgid "Thanks, turkey."
msgstr "谢谢你，火鸡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH"
msgid "Time for a little landscaping."
msgstr "是时候进行点园林绿化了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "This would be more useful somewhere else, eh?"
msgstr "这个在其他的地方更有用，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_GRASS"
msgid "It makes my eyes water."
msgstr "它把我的眼泪都弄出来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_MARSH_BUSH"
msgid "I should plant this."
msgstr "我应该种下这个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DUG_SAPLING"
msgid "Mmmmm. It's all twiggy."
msgstr "嗯。都是小树枝。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN"
msgid "It smells bad."
msgstr "好臭。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_COOKED"
msgid "It smells even worse."
msgstr "没有最臭，只有更臭。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.DURIAN_SEEDS"
msgid "Why would I want to grow more of those things?"
msgstr "我才不想多种那东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EARMUFFSHAT"
msgid "Where I'm from these'd only work in the fall."
msgstr "在我的家乡，这种东西只在秋天管用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL"
msgid "This should cook up nicely."
msgstr "这烹饪出来应该挺不错的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EEL_COOKED"
msgid "This cooked up nicely."
msgstr "烤得真不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT"
msgid "I bet the birds have something to do with this."
msgstr "我打赌这些鸟肯定和这有关系。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_COOKED"
msgid "Suspiciously birdy."
msgstr "像鸟一样，太可疑了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EGGPLANT_SEEDS"
msgid "Hmmm. I'm not sure."
msgstr "嗯。我不是很确定。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.BURNT"
msgid "A burnt wood table."
msgstr "一个燃烧着的木头桌子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.EMPTY"
msgid "Such a beaut of a wood table shouldn't be hidden by a cloth."
msgstr "这样一张漂亮的木头桌子不应该被布所覆盖。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Aboot time we brightened this place up, eh?"
msgstr "大概是我们点亮这个地方的时间了，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.GENERIC"
msgid "A little bit of nature makes everything nicer."
msgstr "一点点的自然本性让一切变得更美好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "We need bulbs, eh."
msgstr "我们需要灯泡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ENDTABLE.WILTED"
msgid "Well, that's that."
msgstr "好吧，该熄的总是会熄。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNING"
msgid "Nooo! I could have chopped it!"
msgstr "不！我本来可以把它砍掉的！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.BURNT"
msgid "What a waste."
msgstr "真是浪费。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Ahhhh!"
msgstr "啊——！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN.GENERIC"
msgid "It's calling to me!"
msgstr "它在召唤我！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Sorry!"
msgstr "抱歉！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "How terrible!"
msgstr "好恐怖！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Another one!"
msgstr "又砍倒一棵！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Lucy would want me to chop it down."
msgstr "露西会希望我把它砍倒的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEBRELLAHAT"
msgid "Always good to have something watching over you."
msgstr "有东西看着你总归是好事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYEPLANT"
msgid "It needs to mind its own business."
msgstr "它应该管好自己的事情。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET"
msgid "That'll drive the hosers off."
msgstr "它会把其他家伙击退的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.EYETURRET_ITEM"
msgid "This needs to be installed properly."
msgstr "这需要正确安装。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.BURNT"
msgid "If it was a tree farm, I'd be sad."
msgstr "如果这是一片林场的话，那我肯定伤心死了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GENERIC"
msgid "I prefer larger plants."
msgstr "我更喜欢大型植物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.GROWING"
msgid "They'll never reach chopping size."
msgstr "它们永远长不到适合砍伐的大小。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "I think it needs some poop."
msgstr "我想应该给它加点肥料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERFAN"
msgid "A traditional Canadian fan."
msgstr "传统的加拿大羽扇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERHAT"
msgid "I want nothing to do with that... thing."
msgstr "我不想跟那...东西扯上任何关系。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHERPENCIL"
msgid "The bird murder wasn't even necessary. Heh."
msgstr "猎杀鸟的人甚至都没必要。嘿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CANARY"
msgid "A grody feather."
msgstr "令人讨厌的羽毛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_CROW"
msgid "A gross feather."
msgstr "令人厌恶的羽毛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN"
msgid "A disgusting feather."
msgstr "让人恶心的羽毛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A stupid feather."
msgstr "愚蠢的羽毛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FEM_PUPPET"
msgid "She's trapped!"
msgstr "她被困住了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE"
msgid "That's a good lookin' fence."
msgstr "那栅栏看起来不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE"
msgid "Some nice woodwork there."
msgstr "那儿有些漂亮的木制品。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_GATE_ITEM"
msgid "A good project for a lazy afternoon."
msgstr "慵懒的午后的一个不错的项目。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FENCE_ITEM"
msgid "A good project for a lazy afternoon."
msgstr "慵懒的午后的一个不错的项目。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FERTILIZER"
msgid "Poop belongs in a bucket, not on the ground."
msgstr "粪便应该放在桶里，而不是留在地上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREBALLSTAFF"
msgid "I'll leave it to someone more magic-inclined."
msgstr "我还是把它留给比较喜欢魔法的人吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRECRACKERS"
msgid "Let's not set them off in the forest."
msgstr "我们别让它们在森林里面离开。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.GENERIC"
msgid "Reminds me of Algonquin park."
msgstr "让我想起了阿冈昆公园。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREFLIES.HELD"
msgid "I've got a pocket full of sunshine!"
msgstr "我口袋里面装满了阳光！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREHOUND"
msgid "Hot hound!"
msgstr "火猎犬！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.EMBERS"
msgid "I should go chop some wood for that, eh?"
msgstr "我应该去砍点木头来，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.GENERIC"
msgid "It uses wood."
msgstr "它要用木头当燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.HIGH"
msgid "Too much wood, too fast!"
msgstr "太多木头，速度太快了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.LOW"
msgid "There should be some wood around here somewhere."
msgstr "这附近应该有木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.NORMAL"
msgid "Mmmm. Smells woody."
msgstr "嗯。木头的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIREPIT.OUT"
msgid "If only I had some wood."
msgstr "要是我有木头就好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESTAFF"
msgid "I don't trust any sort of magic business."
msgstr "我不相信任何类型的魔法事情。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It craves wood."
msgstr "它急需木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Lazy thing."
msgstr "懒东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Save the trees!"
msgstr "拯救树木！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH"
msgid "Looks like a cod."
msgstr "看起来像鳕鱼。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHINGROD"
msgid "I should spend some time at the lake."
msgstr "我应该去湖边待一会儿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHSTICKS"
msgid "Elegant dining in a box."
msgstr "优雅又有型的食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISHTACOS"
msgid "Tastes like the sea, eh?"
msgstr "海的味道，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FISH_COOKED"
msgid "Could use some chips."
msgstr "可以使用一些薯片。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLINT"
msgid "This could be an axe head."
msgstr "这可以做成斧头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.GENERIC"
msgid "That's nice."
msgstr "很好看。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER.ROSE"
msgid "Not very satisfying chopping, that."
msgstr "这次砍树不是很满意。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERHAT"
msgid "I think wildflowers look nice with my red hair."
msgstr "我觉得野花和我的红头发很配。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWERSALAD"
msgid "Healthy, but not very hardy."
msgstr "很健康，但不是很耐饿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_CAVE"
msgid "Shiny!"
msgstr "好闪亮！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_EVIL"
msgid "Something is wrong with that flower."
msgstr "那朵花有问题。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOWER_WITHERED"
msgid "Someone's got a brown thumb."
msgstr "有人不擅长园艺。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOLIAGE"
msgid "Looks like a salad."
msgstr "看起来像沙拉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOOTBALLHAT"
msgid "Will this give me hockey hair?"
msgstr "这玩意儿会弄乱我的发型吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_PIECE"
msgid "Brittle."
msgstr "脆弱易碎。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "One hundred percent assembled beastie."
msgstr "百分百组装的野兽。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Eh... Should we try again, Lucy?"
msgstr "呃……我们应该再试一次吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still got some work to do, looks like."
msgstr "看起来还有些工作要做。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.DEAD"
msgid "Ex-frog."
msgstr "曾经的青蛙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.GENERIC"
msgid "I don't trust anything that can't decide between air and water."
msgstr "我不相信任何不能决定在水里还是在陆地上生活的生物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROG.SLEEPING"
msgid "It's tired."
msgstr "它累了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGGLEBUNWICH"
msgid "You can really taste the swamp."
msgstr "你可以尝到沼泽的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS"
msgid "They're still jumping!"
msgstr "它们还在跳！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FROGLEGS_COOKED"
msgid "At least they stopped moving."
msgstr "至少它们不动了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FRUITMEDLEY"
msgid "In syrup!"
msgstr "浸了枫糖浆的！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FURTUFT"
msgid "Shh! The creature might still be around."
msgstr "嘘！那个东西还在附近。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_HOUND"
msgid "That's unfortunate there, buddy."
msgstr "那真是不幸，哥们。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Hmph. Maybe I don't got it so bad."
msgstr "哼。可能我做得还不够狠。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEARS"
msgid "I never could figure these things out."
msgstr "我永远都不可能把这些东西弄清楚的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEMSOCKET.GEMS"
msgid "It'll need a gem."
msgstr "它需要一个宝石。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GEMSOCKET.VALID"
msgid "Looks ready."
msgstr "看起来准备就绪了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GHOST"
msgid "Boo! Ha ha!"
msgstr "嘣！哈哈！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GIFT"
msgid "They're just as fun to give as they are to receive."
msgstr "它们被给予或被接受都很有趣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GIFTWRAP"
msgid "Should we do something nice today, Lucy?"
msgstr "我们今天来做些好事吧，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLASSBLOCK"
msgid "Well it ain't wood."
msgstr "好吧，这不是木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLASSSPIKE"
msgid "I wonder if it chops."
msgstr "我想知道它能否切碎。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMER"
msgid "Keep flapping, little guy!"
msgstr "继续拍打翅膀不要停，小家伙！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Dead and still slimy."
msgstr "死了之后还是黏黏的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "Even the flower is slimy."
msgstr "就连花都是黏黏的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERFUEL"
msgid "Yep, his slime is slimy too."
msgstr "没错，他的黏液也黏乎乎的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GLOMMERWINGS"
msgid "Unsurprisingly, the wings are slimy."
msgstr "不出所料，翅膀也是黏黏的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOATMILK"
msgid "I think the electricity curdled it."
msgstr "我觉得是电让它凝结的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOGGLESHAT"
msgid "Seems pretty useless."
msgstr "看起来很没用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENAXE"
msgid "It's almost as nice as Lucy."
msgstr "几乎赶得上露西了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENPICKAXE"
msgid "It's pretty, but it can't chop down trees."
msgstr "它确实很漂亮，但不能用来砍树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENPITCHFORK"
msgid "Welp. I can't unmake it, so..."
msgstr "好吧。既然我没法让它消失，那么..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDENSHOVEL"
msgid "Time to dig golden holes."
msgstr "是时候去挖点金矿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOLDNUGGET"
msgid "You can't make a coffee table out of gold.\nWell, maybe you can. But you shouldn't."
msgstr "你没法用黄金做成咖啡桌。\n好吧，也许你可以。但是你不应该那样做。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GOOSE_FEATHER"
msgid "Pillowy plumage."
msgstr "好软的羽毛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.BARREN"
msgid "I need to poop on it."
msgstr "我需要在上面施肥。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.BURNING"
msgid "I hope that doesn't spread to the trees."
msgstr "希望这火不会蔓延到树上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "它染上病毒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.DISEASING"
msgid "Lookin' a bit down."
msgstr "再往下看一点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.GENERIC"
msgid "Looks like kindling."
msgstr "看起来可以用来点火。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.PICKED"
msgid "It's gone all nubbly."
msgstr "表面好粗糙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS.WITHERED"
msgid "Maybe it'd thrive if it was cooler out?"
msgstr "如果温度再低些，它也许会长得很好？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It's lookin' pretty unhealthy."
msgstr "它看起来很不健康。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Where's the log lizard?"
msgstr "木头蜥蜴在哪？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GRASS_UMBRELLA"
msgid "That there could keep my beard moderately dry, eh?"
msgstr "这可以让我的胡子保持适度干燥，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENAMULET"
msgid "I get a bit of a weird feeling around these things."
msgstr "我觉得这些事情很奇怪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENGEM"
msgid "How flashy."
msgstr "好闪亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENMOONEYE"
msgid "That should help everyone get the lay of the land."
msgstr "那应该能帮助每个人了解地形。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREENSTAFF"
msgid "This'll help me dismantle stuff!"
msgstr "这可以帮我把现有的东西拆解和还原！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_CAP"
msgid "I've eaten stranger things in the woods."
msgstr "我曾经在森林里吃过更奇怪的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_CAP_COOKED"
msgid "I don't trust it."
msgstr "我不相信它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It's a green mushroom."
msgstr "是绿蘑菇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "They have their own schedule."
msgstr "它们有自己的作息规律。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "I'll have to be patient."
msgstr "我必须有耐心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUACAMOLE"
msgid "I'm not sure I trust it."
msgstr "我不确定这玩意能不能吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUANO"
msgid "It stinks less than the other kind."
msgstr "它不像其他的那么臭。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GUNPOWDER"
msgid "Never did like this stuff."
msgstr "从来没有做过这种东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_1"
msgid "Even the stick is delicious."
msgstr "连棍子都很美味。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_10"
msgid "I'll tell you what it tastes like, Lucy."
msgstr "我会告诉你它尝起来怎么样，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_11"
msgid "Melts in your mouth, not in your hand."
msgstr "融化在你的嘴里，而不是在你的手里。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_12"
msgid "Not the biggest fan of bugs."
msgstr "对虫子没有好感。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_13"
msgid "It's pretty good stuff."
msgstr "这是很好的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_14"
msgid "Lucy doesn't like it when I eat spice."
msgstr "露西不喜欢我吃辣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_2"
msgid "Don't worry, I'll eat enough for the both of us, Lucy."
msgstr "不要担心，我会把你那份也一起吃了，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_3"
msgid "Just a regular ol' cob of corn."
msgstr "只是普通的老玉米棒。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_4"
msgid "Yeesh. That's a lot of candy legs."
msgstr "咦嘘。好多糖果腿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_5"
msgid "These ones don't puke. I like 'em."
msgstr "这些不会呕吐。我喜欢它们。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_6"
msgid "Not sure that's food, eh?"
msgstr "不确定那是不是食物，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_7"
msgid "Eh. I don't mind 'em."
msgstr "呃。我不在意它们。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_8"
msgid "I'll tell you what it tastes like, Lucy."
msgstr "我会告诉你它尝起来怎么样，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENCANDY_9"
msgid "Not too bad, eh?"
msgstr "还不错，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "A good hardy drink."
msgstr "有用的勇气饮料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "That's a lot, eh."
msgstr "太多了，呃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Not bad."
msgstr "还不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "It'll never replace a good hunk of wood."
msgstr "它绝不能代替一大块木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "It's just fake, eh."
msgstr "是假的，嗯。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "That's nice. I should hang it somewhere."
msgstr "真漂亮。我应该把它挂在某个地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "This would look good in a tree somewhere."
msgstr "把它挂在树上会很好看。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "You wanna decorate, Lucy?"
msgstr "你想装饰吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Hang in there, eh."
msgstr "挂在那儿，坚持住啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Argh! I'd sure like to hang a real one like that."
msgstr "唉！要是有个真的那种东西让我挂起来就好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMBAT"
msgid "What a waste of good ham."
msgstr "真是浪费了美味的火腿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMMER"
msgid "Everyone makes mistakes, eh?"
msgstr "是人都会犯错，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAMMER_MJOLNIR"
msgid "Packs a wallop."
msgstr "很有冲击力。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HAWAIIANSHIRT"
msgid "I really prefer plaid."
msgstr "我更喜欢格子衬衫。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEALINGSALVE"
msgid "Healthiness in goo form."
msgstr "黏黏的药膏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEALINGSTAFF"
msgid "Someone else'd put that to better use."
msgstr "那个在别人手里会比较有用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.COLD"
msgid "It's gone cold, eh?"
msgstr "它变冷了，感觉到了吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.FROZEN"
msgid "Brrr! It's frozen."
msgstr "嘶~~~！它结冰了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.GENERIC"
msgid "We call those \"night rocks\" back home."
msgstr "在家乡，我们管这种东西叫“夜石”。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.HOT"
msgid "I could chop all winter with that in my pocket!"
msgstr "有这东西在我口袋里，我可以砍一整个冬天的树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HEATROCK.WARM"
msgid "It's getting a bit... tepid."
msgstr "它正变得越来越...暖和。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HIVEHAT"
msgid "Hmph. Real regal."
msgstr "哼。真豪华。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOME"
msgid "Who's there?"
msgstr "谁在那儿？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.BURNT"
msgid "Wood is the best at burning."
msgstr "木头可是最好的燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.GENERIC"
msgid "Is there anything wood can't do?"
msgstr "有什么东西是木头不能做成的吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Let's give our neighbours some guidance."
msgstr "让我们给邻居一点指引。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEY"
msgid "Mmmmmm-mmmm. Bee syrup."
msgstr "嗯——嗯。蜂王浆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYCOMB"
msgid "The poor bees probably worked their stingers off on this."
msgstr "可怜的蜜蜂或许把它们的蜂刺从这个清除。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYHAM"
msgid "But it's not a holiday..."
msgstr "但现在并不是什么节假日..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HONEYNUGGETS"
msgid "That's one of my favourite meals!"
msgstr "那是我最喜欢的食物之一！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HORN"
msgid "I don't know if anyone should put their mouth on that."
msgstr "我不确定人们是否应该把嘴放到那上面。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOTCHILI"
msgid "Good after a long day of chopping in the cold."
msgstr "在冷天里砍了一天树之后来点辣椒真不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUND"
msgid "They'd be good at pulling a sled."
msgstr "它们应该很擅长拉雪橇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDBONE"
msgid "It's covered with dog spit, eh?"
msgstr "上面都是狗狗唾液，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDMOUND"
msgid "I know better than to mess with that."
msgstr "我才没有蠢到去惹那东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDSTOOTH"
msgid "It's a beaut."
msgstr "漂亮的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HOUNDWHISTLE"
msgid "I usually do my own animal calls."
msgstr "我通常会自己召唤动物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH"
msgid "Friendly lil guy, eh?"
msgstr "友好的小朋友，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "I've never had one of these before."
msgstr "我以前从来没有过这东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "It was bound to happen."
msgstr "它必然发生。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICE"
msgid "A tiny reminder of home."
msgstr "家里的小小纪念品。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEBOX"
msgid "Ahhhh. Reminds me of home."
msgstr "啊—— 让我想起了家乡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICECREAM"
msgid "Only after I've chopped enough!"
msgstr "我砍了足够的树后才会吃！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEHAT"
msgid "I could chop it if I had to."
msgstr "如果有必要的话，我可以把这个也剁碎。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEHOUND"
msgid "Arctic hounds?"
msgstr "北极猎犬？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICEPACK"
msgid "Good for long hikes."
msgstr "很适合用来远足旅行。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ICESTAFF"
msgid "It reminds me of home."
msgstr "它让我想起了家乡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Where did it go?!"
msgstr "它去哪儿了？！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "I don't know how to move that."
msgstr "我不知道该怎么把那玩意儿移开。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.INSPECTSELF"
msgid "Beard's growing out nicely."
msgstr "胡子长得很漂亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.JAMMYPRESERVES"
msgid "Now to find peanut butter."
msgstr "现在就差花生酱了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.JELLYBEAN"
msgid "You can barely taste the bean!"
msgstr "你几乎尝不到豆子的味道！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KABOBS"
msgid "The stick really adds to the flavour."
msgstr "树枝确实让肉变得更香了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KILLERBEE.GENERIC"
msgid "That bee doesn't seem as friendly."
msgstr "那只蜜蜂好像不太友好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KILLERBEE.HELD"
msgid "She's none too pleased with her situation."
msgstr "她对自己的处境很不满意。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUS"
msgid "Thing's got no eyes, eh?"
msgstr "没有眼睛的东西，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUSSACKKEY"
msgid "Gotta be some use for that."
msgstr "对那来说会有些用处。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KLAUS_SACK"
msgid "Something good's in there, eh?"
msgstr "那里面有些好东西，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KNIGHT"
msgid "Never did care for horses."
msgstr "从来没有照顾过马。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Doesn't look to be in the best of shape."
msgstr "好像并不是它最好的状态。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOALEFANT_SUMMER"
msgid "He looks tasty."
msgstr "他看上去很美味。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KOALEFANT_WINTER"
msgid "They get tastier in the winter."
msgstr "冬天里的它们更美味。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KRAMPUS"
msgid "Back off, hoser!"
msgstr "退后，蠢材！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.KRAMPUS_SACK"
msgid "Seems wrong to take someone else's sack."
msgstr "带走其他人的背包是不对的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LANTERN"
msgid "Well that's enlightening, eh?"
msgstr "嗯，这很有启发性，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "No one'd push you around in that."
msgstr "你要是穿上这个，就没人能把你怎么样了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Looks pretty safe, eh?"
msgstr "看起来很安全，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Won't do anyone much good."
msgstr "对谁都没有多大用处。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Does nothing fast."
msgstr "对速度没多大帮助。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Better wood armor than nothin'."
msgstr "木盔甲总比啥也没有的强。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Looks sharp, eh?"
msgstr "看起来很锋利，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Good for a little recharge."
msgstr "有一点充能作用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Better armor up."
msgstr "最好穿上盔甲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Let's chop that Battle Standard!"
msgstr "让我们切碎那面战斗旗帜！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BERNIE"
msgid "Hey there little fella."
msgstr "嘿，你好呀小家伙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_BOARLORD"
msgid "He seems confused, eh?"
msgstr "他看起来很懵，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Get a loada that hat!"
msgstr "瞧那顶帽子！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "What an odd little fellow."
msgstr "古怪的小家伙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I don't see much use for that."
msgstr "我觉得那个对我没什么用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "I don't think agility is my thing, eh?"
msgstr "我觉得敏捷不是我的风格，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "I'll leave that for someone else."
msgstr "我把这个留给别人吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "That flower'd look nice with my beard."
msgstr "那朵花跟我的胡子很配。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "That'll make ya quick on yer feet."
msgstr "那个能让你的脚步变得轻快。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "I could use that."
msgstr "我能用得上那个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "Needs another piece."
msgstr "它需要另一件东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Looks good."
msgstr "看上去一切就绪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "I'd swing an axe a little harder with that."
msgstr "有了那个，我挥斧头都能更有劲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_LUCY"
msgid "Something's different aboot you, Lucy."
msgstr "你有些不一样了，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Don't trust that as far as I can throw it."
msgstr "只要我能扔，就别相信那个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Let's head back to camp, Lucy."
msgstr "我们回营地吧，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "They're reinvigorating rocks."
msgstr "这些宝石有恢复活力的作用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Better keep an eye on that."
msgstr "最好小心那个东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I could do some real damage with that."
msgstr "有了那个东西，我可以大肆破坏了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "I oughta leave that for someone else."
msgstr "我应该把这个留给别人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE"
msgid "Death by axe!"
msgstr "一斧劈死！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_COCOON"
msgid "Lil buddy cooled right off."
msgstr "小伙伴马上冷静下来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "There's a fire burning in there."
msgstr "它里面在燃烧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "She could use a parka."
msgstr "她需要一件派克大衣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "Cozier than a moose wrapped in duct tape!"
msgstr "比用管道胶带裹起来的鹿鸭还舒服！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.CONTENT"
msgid "Look how happy she is!"
msgstr "看她多高兴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.GENERIC"
msgid "That's my lil critter."
msgstr "这是我的小虫子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Poor gal's getting hungry."
msgstr "可怜的姑娘饿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_PET.STARVING"
msgid "Skinnier than a blue heron's legs."
msgstr "比青鹭的腿还瘦。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVAE_TOOTH"
msgid "Not as sharp as Lucy!"
msgstr "不像露西那么锋利！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVASPIT.COOL"
msgid "My trees are safe now."
msgstr "现在我的树安全了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVASPIT.HOT"
msgid "Aaaah! Tree killer!"
msgstr "啊啊啊啊！树木杀手！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVA_POND"
msgid "I wouldn't get too close to that, eh?"
msgstr "我不会靠那个太近的，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LAVA_POND_ROCK"
msgid "Boulder-dash."
msgstr "推石小子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LEIF"
msgid "I'm sorry aboot all of those trees!"
msgstr "我很抱歉我对那些树做的事！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LEIF_SPARSE"
msgid "I'm sorry aboot all of those trees!"
msgstr "我很抱歉我对那些树做的事！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LICHEN"
msgid "Looks barely edible."
msgstr "看起来几乎不能吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIFEINJECTOR"
msgid "This should cure those sniffles."
msgstr "这应该能治愈鼻塞。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTBULB"
msgid "It looks chewy."
msgstr "它看起来很耐嚼。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTER"
msgid "Keep it away from the trees!"
msgstr "不要让它靠近树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Nice goat, nice goat!"
msgstr "好山羊，好山羊！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "That's a nice pair of horns you've got there."
msgstr "你的羊角挺不错的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNINGGOATHORN"
msgid "I'm sure the goat didn't need it."
msgstr "我相信山羊不需要这个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "It's pretty as the Northern lights."
msgstr "像北极光一样漂亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Weather's not going to get the drop on me now."
msgstr "现在我不会被闪电劈了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LITTLE_WALRUS"
msgid "Why are they so far south?"
msgstr "它们为什么要住在这么偏南的地方？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGLOG"
msgid "I want to keep you, and call you \"Frank\"."
msgstr "我要留着你，以后你就叫“弗兰克”吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE"
msgid "I feel conflicted, eh?"
msgstr "我觉得很矛盾，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE_ROOT"
msgid "Hey there's a piece of wood in there."
msgstr "嘿，里面有木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Yep. That'll be a fine tree one day."
msgstr "对。有一天它会长成漂亮的大树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LOG.BURNING"
msgid "Oh no! Don't put another log on the fire!"
msgstr "噢，不要！别把另一根木头放在火上！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LOG.GENERIC"
msgid "It makes it all worthwhile."
msgstr "一切都值得了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "I could use a bit of luck."
msgstr "我可以用点运气。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUCY"
msgid "I love Lucy!"
msgstr "我爱露西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUMPY_SAPLING"
msgid "Shucks, I'm gonna have to chop it again."
msgstr "哼，我又得再次把它砍掉了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUREPLANT"
msgid "Is that meat?"
msgstr "那是肉吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.LUREPLANTBULB"
msgid "It's warm and lumpy."
msgstr "它真暖和，而且是块状的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MADSCIENCE_LAB"
msgid "I prefer simpler things."
msgstr "我比较喜欢简单的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MALE_PUPPET"
msgid "Do you need help?"
msgstr "你需要帮助吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE"
msgid "Sorry, little buddy."
msgstr "对不起，小家伙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKESOUP"
msgid "It's a tiring soup."
msgstr "是喝了让人困倦的汤。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_ACTIVE"
msgid "This is the worst thing."
msgstr "这是最糟糕的事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_COOKED"
msgid "Sorry!"
msgstr "抱歉！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANDRAKE_PLANTED"
msgid "It's looking at me."
msgstr "它在看着我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MANRABBIT_TAIL"
msgid "I feel sorry for it."
msgstr "我为此感到抱歉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAPSCROLL"
msgid "Is it still a map if nothing's on it?"
msgstr "如果上面没有任何东西，它还算是一张地图吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLE"
msgid "Feels like a government building."
msgstr "感觉像是政府大楼。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEBEAN"
msgid "The magical fruit."
msgstr "魔法水果。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "Well lookit that. It sprouted."
msgstr "好吧，看那东西。发芽了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLEPILLAR"
msgid "Somebody must have built that."
msgstr "一定是有人建造的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLESHRUB"
msgid "Defo can't chop that."
msgstr "当然没有办法切碎那东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARBLETREE"
msgid "Even Lucy can't chop that one down."
msgstr "即使是露西也砍不倒那个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Foomph!"
msgstr "该死！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "That's a bramble."
msgstr "是荆棘。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Was that worth it?"
msgstr "这样做值得吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_PLANT"
msgid "Plant."
msgstr "是植物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNING"
msgid "That's what you get for being spiky!"
msgstr "让你到处刺人，这就是你的下场！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNT"
msgid "It deserved it."
msgstr "活该。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "It was a hard battle, but I won."
msgstr "虽然是一场很艰苦的战斗，但最终我赢了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.GENERIC"
msgid "Trees shouldn't fight back!"
msgstr "是树就不应该反击！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELL"
msgid "Why does he hate me?"
msgstr "他为什么要恨我呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLHEAD"
msgid "Just a head, eh?"
msgstr "只是一个头，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLLIGHT"
msgid "That's unnatural."
msgstr "这有点违反自然规律。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLLOCK"
msgid "Where is the key?"
msgstr "钥匙在哪儿？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Better than most of the stuff on the radio."
msgstr "比收音机上听到的大多数东西都要好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MAXWELLTHRONE"
msgid "I've seen nicer chairs."
msgstr "我见过比它好的椅子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAT"
msgid "Tastes like moose."
msgstr "味道像鹿鸭。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATBALLS"
msgid "All the meats!"
msgstr "全都是肉！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.BURNT"
msgid "Its usefulness has dried up."
msgstr "它已经没有利用价值了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DONE"
msgid "That looks done."
msgstr "看起来已经晾好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DRYING"
msgid "This is like watching meat dry."
msgstr "这就像看着肉慢慢变干。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "This is like watching meat dry... in the rain."
msgstr "这就像看着肉变干...在雨天里慢慢变干。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEATRACK.GENERIC"
msgid "It's all set up. Just add meat."
msgstr "都安装好了。只要加肉就好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MEAT_DRIED"
msgid "It tastes like survival."
msgstr "感觉像野外求生一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERM"
msgid "What foul sea did that crawl out of?"
msgstr "那东西是从多肮脏的大海里面爬出来的啊？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.BURNT"
msgid "Amazingly, it smells even worse now."
msgstr "太奇怪了，现在甚至更难闻了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.GENERIC"
msgid "Smells like a factory trawler."
msgstr "闻起来像拖网渔船。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHOUSE.BURNT"
msgid "Couldn't even build a fireproof house."
msgstr "连建造一间防火的房子都不会。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHOUSE.GENERIC"
msgid "They're not the handiest."
msgstr "它们不是最好使的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINERHAT"
msgid "Down deep in a coal mine."
msgstr "下煤矿干活儿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINIFAN"
msgid "I'm not used to the heat in this place!"
msgstr "我不习惯这地方的高温！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN.GENERIC"
msgid "Is there anything wood can't do?"
msgstr "有什么东西是木头不能做成的吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN.UNDRAWN"
msgid "What is this... some sort of sign?"
msgstr "这是什么……某种记号？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINISIGN_ITEM"
msgid "Good, sturdy wood."
msgstr "很好，坚固的木头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAUR"
msgid "Another poor soul with a curse."
msgstr "又一个被诅咒的可怜生物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAURCHEST"
msgid "That's a nice chest with horns, eh."
msgstr "很不错的带角箱子，是吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MINOTAURHORN"
msgid "That's a nice horn, eh."
msgstr "很漂亮的犀牛角，是吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.ABOVEGROUND"
msgid "It feels aboot rocks the way I feel aboot trees."
msgstr "石头对于它就像是树木对于我一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.HELD"
msgid "Want some rocks?"
msgstr "想来些石头吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLE.UNDERGROUND"
msgid "Dig, dig, dig."
msgstr "挖，挖，挖。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLEHAT"
msgid "Now featuring night-time chopping!"
msgstr "现在就算是夜间我也能砍树了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOLEHILL"
msgid "I bet it's just a pile of rocks inside."
msgstr "我敢打赌里面只是一堆石头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONKEY"
msgid "Well then. That's a new one."
msgstr "很好。又来一只。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONKEYBARREL"
msgid "What a fine choice of building material."
msgstr "很不错的建筑材料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERLASAGNA"
msgid "This is cat food!"
msgstr "这是猫食！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERMEAT"
msgid "I'm not hungry enough for that."
msgstr "我还没有饿到吃怪物肉的地步。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MONSTERMEAT_DRIED"
msgid "I still don't want to eat it."
msgstr "我还是不想吃它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.BROKEN"
msgid "That'll need more than a roll of duct tape to fix."
msgstr "那需要不止一卷的牛皮胶布来修理。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.GENERIC"
msgid "I'd rather not muck with that if I can help it."
msgstr "如果我能帮忙，我宁愿不弄脏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "That oughta keep us cool."
msgstr "那应该会让我们凉快。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.STAFFED"
msgid "I'm happy to just leave it there for now."
msgstr "现在我很开心自己把它留在那里。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Looks a little off."
msgstr "看起来有点不友好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.CAVE"
msgid "We're free from the moon's reach down here."
msgstr "在这里，月亮够不到我们。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.GENERIC"
msgid "Do I really need to be reminded of the moon during the day?"
msgstr "在白天，我真的需要被提醒月亮的存在吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Not a good night to have a curse, but then when's it ever?"
msgstr "不是被诅咒的好夜晚，但以前有过吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "The moon's gone for now. Phew."
msgstr "月亮暂时走了。唷。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon's waning. Time for some peace and quiet."
msgstr "月亮在亏损了。是时候休息平静一下了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon's waxing again."
msgstr "月亮再次变圆了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.WEREBEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONDIAL.WEREBEAVER"
msgid "Just aboot time again, Lucy."
msgstr "大概又到时候了，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKCRATER"
msgid "I think it's missing something."
msgstr "我想它缺少一些东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKIDOL"
msgid "Looks kinda loonie."
msgstr "看起来有点呆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKNUGGET"
msgid "It's uh, a moon rock."
msgstr "呃，它是一块月亮石。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCKSEED"
msgid "I should probably put this down somewhere, eh?"
msgstr "我应该把它放在什么地方，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOONROCK_PIECES"
msgid "That's in a pretty sorry state, eh?"
msgstr "那是一个非常悲惨的状态，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSE"
msgid "Whatever it is, it's definitely Canadian."
msgstr "不管它是什么，它肯定是加拿大的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSEEGG"
msgid "Well, it lays eggs, apparently."
msgstr "呃，很显然，它会下蛋。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Where's the pyromaniac? This needs to burn."
msgstr "放火狂在哪里？得把这个烧掉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITO.GENERIC"
msgid "That'll take a pint out of me!"
msgstr "那东西吸了我一品脱的血！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITO.HELD"
msgid "What do I do with this, eh?"
msgstr "你说我该怎么处置这小东西呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSQUITOSACK"
msgid "Blood and guts, eh?"
msgstr "很血腥野蛮，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOSSLING"
msgid "Feathery moose baby!"
msgstr "长着羽毛的鹿鸭宝宝！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOUND.DUG"
msgid "Don't be mad!"
msgstr "别生气！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MOUND.GENERIC"
msgid "I should probably leave that alone."
msgstr "也许我应该离它远点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "That'd be the thing I fell through, eh."
msgstr "那事我肯定做不成，额。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Wonder where it goes."
msgstr "想知道要把它放在什么地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It's... it's beautiful."
msgstr "它...它真漂亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMBOMB"
msgid "I don't like the look of that."
msgstr "我不喜欢那个样子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMHAT"
msgid "That there'll make you one with the forest."
msgstr "那会让你成为森林的一员。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Don't breathe it in, Lucy!"
msgstr "不要把它吸进去，露西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Mushrooms don't have no reason to be that big."
msgstr "蘑菇有理由变得那么大。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "If a log burns in the forest does it hurt my feelings? Yes. It does."
msgstr "如果一块木头在森林里燃烧，这会伤害我的感情吗？是的，会。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It needs a bit of help getting started."
msgstr "需要一点助力来开始。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It's doing real well on its own."
msgstr "就它而言，真的做得不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "That rotten log needs replacing."
msgstr "那块腐烂的木头需要替换。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Everybody's got hardships, eh?"
msgstr "每个人都有困难的时候，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "There we go. Everyone needs a bit of help sometimes."
msgstr "这就好。大家有时候都需要别人搭把手。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Doesn't need us no more."
msgstr "不再需要我们了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Whose bright idea was it to kill the lights?"
msgstr "是谁想出灭掉亮光这个好主意的？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "My kind of decor."
msgstr "我的风格的装饰。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Soak in that all-natural light, Lucy."
msgstr "沉浸在那完全天然的亮光中，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "That got charred real good."
msgstr "那东西被很好地烧焦了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "It oughta be green like a lush, choppable forest."
msgstr "它应该像郁郁葱葱的可以劈砍的森林一样的绿色的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "It illuminates with all the colours of the wind."
msgstr "它和风的所有颜色一样发着光了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "I like the colour of this one."
msgstr "我喜欢它的颜色。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "Maybe I should chop it."
msgstr "也许我应该砍了它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Well, I can't cut it down now..."
msgstr "嗯，我现在不能砍倒它..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "It's made of wood."
msgstr "它是木头做的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Chop it down before it spreads!"
msgstr "在它散播开之前砍倒它！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "I can't let that stand."
msgstr "我不能放任它不管。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "This one needs pruning, at least."
msgstr "至少这一棵需要修剪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTLIGHT"
msgid "What kind of darkness is that?"
msgstr "那是什么样的黑暗啊？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMAREFUEL"
msgid "All of my fears in liquid form, eh?"
msgstr "我的所有恐惧都汇成了液体，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARELIGHT"
msgid "They should have used wood."
msgstr "这盏灯应该使用木材的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "I think it's off."
msgstr "我想它已经关了吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "It's nearly still."
msgstr "它几乎没动。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "I think it's off."
msgstr "我想它已经关了吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It's going crazy!"
msgstr "太疯狂了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "It's settling down."
msgstr "它稳定下来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "This thing just turned on!"
msgstr "这东西又打开了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "It's vibrating!"
msgstr "它在振动！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTSTICK"
msgid "That's mighty nifty."
msgstr "漂亮又强大。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NIGHTSWORD"
msgid "Nightmares can't hurt ya!"
msgstr "噩梦没法伤害你！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.NITRE"
msgid "It's how we built the railway."
msgstr "我们就是用这个建造铁路的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE"
msgid "That's a whole lotta wet."
msgstr "全都湿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ONEMANBAND"
msgid "I stand on guard for thee!"
msgstr "啊，我为你站岗！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OPALPRECIOUSGEM"
msgid "You're fond of it, aren'tcha Lucy?"
msgstr "你喜欢它，不是吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OPALSTAFF"
msgid "Err, moon magic isn't really... my thing... Heh."
msgstr "呃，月亮魔法真心不是……我的菜……嘿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEAMULET"
msgid "This'll make the chores go by quicker!"
msgstr "这可以让家务活完成得更快！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEGEM"
msgid "It's shimmering."
msgstr "它在闪闪发光。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGEMOONEYE"
msgid "Makes the hairs on the back of my neck stand up."
msgstr "让我脖子后面的毛发都竖立起来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ORANGESTAFF"
msgid "This will help me get around quickly."
msgstr "它可以帮我快速移动。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PANDORASCHEST"
msgid "What's in the box?!"
msgstr "箱子里装的是什么？！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PANFLUTE"
msgid "I only sing for Lucy."
msgstr "我只给露西唱歌。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PAPYRUS"
msgid "I'd rather chop than write."
msgstr "我宁愿砍树也不要写字。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PEGHOOK"
msgid "That acid'll be a problem, eh?"
msgstr "那个酸液很麻烦，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PENGUIN"
msgid "Doesn't matter if you're from the Great White North. Still a bird."
msgstr "你是否来自加拿大并不重要。不论怎样你都是只鸟。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERD"
msgid "More birds! Why is it always birds?"
msgstr "又是鸟！为什么总是鸟呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDFAN"
msgid "It had to be birds, didn't it?"
msgstr "应该是鸟，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.BURNT"
msgid "It's all burnt up."
msgstr "被烧得精光。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Could use a touch of green."
msgstr "可以使用一抹绿色。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I'm not giving anything to those birds!"
msgstr "我不会把任何东西给那些鸟！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PEROGIES"
msgid "I call them \"yum pockets\"."
msgstr "我称它们为“好吃的饺子”。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETALS"
msgid "I wonder if Lucy would like these."
msgstr "不知道露西喜不喜欢这些。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETALS_EVIL"
msgid "They're frowning at me with little evil faces."
msgstr "它们正用邪恶的小脸朝我皱眉头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PETRIFIED_TREE"
msgid "So... senseless."
msgstr "太…愚蠢了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PHLEGM"
msgid "I wouldn't want that in my moustache."
msgstr "我不想它黏在我的小胡子上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PICKAXE"
msgid "Almost an axe, but not quite."
msgstr "和斧子差不多，但不完全是斧子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE1"
msgid "Looks a little blue."
msgstr "看起来有点蓝。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE2"
msgid "Too hot-headed if you ask me."
msgstr "头脑发热，如果你问我的话。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE3"
msgid "Sure likes that gold."
msgstr "当然喜欢那块金子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGELITE4"
msgid "Something about that guy I like."
msgstr "那个家伙有什么特别的地方让我很喜欢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGGUARD"
msgid "I don't want to make him mad."
msgstr "我可不想让他发疯。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGGYBACK"
msgid "Used all the parts of the pig."
msgstr "使用猪身上的任何部分。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHEAD.BURNT"
msgid "I'd like to complain to the chef. Politely."
msgstr "我要向厨师投诉。我会注意礼貌的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHEAD.GENERIC"
msgid "What a waste of good pork."
msgstr "真是浪费了这么好的猪肉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.BURNT"
msgid "A mere shell of its former glory."
msgstr "昔日的辉煌如今烧的只剩外壳了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.FULL"
msgid "It's bacon-stuffed."
msgstr "里面塞满了培根。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.GENERIC"
msgid "A little duct tape would fix that right up."
msgstr "只需要一点管道胶带就可以把它修好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Sorry! I'm not peeping, I swear!"
msgstr "对不起！我没有偷窥，我发誓！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGKING"
msgid "He's not MY king."
msgstr "他不是我的国王。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.DEAD"
msgid "Not a pig anymore."
msgstr "不再是猪了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.FOLLOWER"
msgid "We're a team! Yah!"
msgstr "我们是一个团队！耶！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.GENERIC"
msgid "Walking back bacon!"
msgstr "回来，培根！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.GUARD"
msgid "That one looks like he means business."
msgstr "那家伙看上去不是闹着玩玩的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGMAN.WEREPIG"
msgid "Happens to the best of us."
msgstr "真不幸。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.BURNT"
msgid "Burnt."
msgstr "烧焦了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.EMPTY"
msgid "I think it needs meat, Lucy."
msgstr "我想它需要肉，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSHRINE.GENERIC"
msgid "Would ya look at that."
msgstr "你自己看看。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGSKIN"
msgid "Bacon with a tail."
msgstr "带尾巴的培根。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGTENT"
msgid "Looks to be some sort of tent."
msgstr "看起来是某种帐篷。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIGTORCH"
msgid "How did they do that without thumbs?"
msgstr "它们是怎么不用拇指就做到的？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PIG_TOKEN"
msgid "Looks like something those pigs would make."
msgstr "看起来像是那些猪会做的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PINECONE"
msgid "I should grow it and then chop it down!"
msgstr "我应该把它种出来，然后再砍倒它！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PINECONE_SAPLING"
msgid "Here comes a tree!"
msgstr "又来了一棵树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PITCHFORK"
msgid "That really isn't my style."
msgstr "这真的不是我的风格。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANTMEAT"
msgid "That's gross!"
msgstr "太恶心了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANTMEAT_COOKED"
msgid "Cooking it didn't help much."
msgstr "烤熟了之后也没有多好吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "I wonder what it will be."
msgstr "我想知道它会长成什么。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "A watched plant never grows."
msgstr "你看着它的话就会感觉它一点都没长。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.READY"
msgid "Time for grub."
msgstr "可以收获了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's got no life left, eh?"
msgstr "它已经活不了了，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.ATTACKER"
msgid "%s isn't very polite..."
msgstr "%s 不是很礼貌…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Knock off the fire starting there, bud."
msgstr "兄弟，灭掉从这里开始烧起的火吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.GENERIC"
msgid "Look who it is! %s!"
msgstr "看看是谁！%s！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.GHOST"
msgid "Someone should rub a heart on %s."
msgstr "应该有人擦下 %s 的心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.MURDERER"
msgid "Enemy of the forest!"
msgstr "森林的敌人！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PLAYER.REVIVER"
msgid "%s, you're an alright sort."
msgstr "%s，你是个好人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE"
msgid "That's too fancy for me."
msgstr "这东西对我来说太复杂了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE_COOKED"
msgid "This would go good on flapjacks."
msgstr "把这个放在煎饼上应该会很好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Seedy."
msgstr "好多种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POND"
msgid "I can't swim!"
msgstr "我不会游泳！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POND_ALGAE"
msgid "Doesn't look edible."
msgstr "好像不能吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POOP"
msgid "Don't poop in camp!"
msgstr "不要在营地里拉大便！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POTTEDFERN"
msgid "I do love me some plant life."
msgstr "我确实喜欢某些植物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.POWCAKE"
msgid "I like the ones made with real sugar better."
msgstr "我更喜欢用真正的糖做成的蛋糕。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN"
msgid "I don't like to eat things that grow on the ground."
msgstr "我讨厌吃长在地上的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKINCOOKIE"
msgid "This will keep me chopping."
msgstr "吃了这个，就有力气一直砍树了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_COOKED"
msgid "Pies are good."
msgstr "我喜欢南瓜派。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_LANTERN"
msgid "It'd better not tip over."
msgstr "最好不要把它打翻。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PUMPKIN_SEEDS"
msgid "It's a seed."
msgstr "这是一颗种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEAMULET"
msgid "The sparkle is gone from the gem."
msgstr "宝石上的光芒消失了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEGEM"
msgid "It's nothing a good chopping wouldn't fix."
msgstr "没什么是优秀伐木工解决不了的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.PURPLEMOONEYE"
msgid "A pretty useful guide in this neck of the woods."
msgstr "在附近一带一个非常有用的向导。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "It hasn't finished the food we gave it."
msgstr "它还没吃完我们给它的食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "We gotta load it up with good eats."
msgstr "我们要给它摆满好吃的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Can't chop that."
msgstr "它是砍伐不了的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Pretty enough."
msgstr "还算好看。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "That must have taken some time to make."
msgstr "制作它肯定花了不少时间。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "I'm not huge on art."
msgstr "我对艺术没多大兴趣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Sure are a lot of statues around here."
msgstr "这里显然有很多雕像。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Take it easy, eh?"
msgstr "放轻松，好吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "No more berries."
msgstr "没有浆果了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "That's a fancy way to eat."
msgstr "这样吃东西可真考究。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "It's good for the oven."
msgstr "适合用烤箱。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "I'll just make something small."
msgstr "我就做点小菜吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN1"
msgid "This coin could use a polish."
msgstr "这枚硬币需要擦亮了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN2"
msgid "I'm gonna buy something nice for Lucy."
msgstr "我要给露西买点好东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN3"
msgid "Not a Looney but I guess it works around here."
msgstr "不算什么大钱，但是在这儿也能派上用场。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_COIN4"
msgid "Nothin' like being owed a favour."
msgstr "没人喜欢被欠人情。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "That'll cook up real good."
msgstr "这可够做一顿大餐了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "I wouldn't mind a taste of that."
msgstr "我很乐意尝一尝。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Let's trap some crabs."
msgstr "我们来诱捕螃蟹吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FERN"
msgid "Fresh underbrush."
msgstr "鲜绿的草丛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Don't look like no flower to me."
msgstr "我看面粉一点也不像花粉呀。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Probably won't taste great on its own."
msgstr "光是它，恐怕不会有好味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I'd say it looks good enough to offer."
msgstr "我觉得它看上去是足够好的供品。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Yep. That's what it wants."
msgstr "没错，这就是它想要的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Is this gonna be enough food?"
msgstr "这么点食物够吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "I don't think it wants this."
msgstr "它应该不想要这种食物吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Heh, whoops."
msgstr "呃，糟糕。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Homegrown."
msgstr "自家种植的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Lucy helped."
msgstr "露西也帮忙了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GATEWAY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GATEWAY"
msgid "It was worth the risk, eh?"
msgstr "冒险是值得的，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATKID"
msgid "How ya doing, kid?"
msgstr "你好吗，小羊？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Builds your bones."
msgstr "能让你的骨骼更强壮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "We're in for a baa'd time."
msgstr "我们将要迎来羊羊不得意的时期。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL"
msgid "Ready for the May two-four."
msgstr "准备隆重庆祝。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "Better set this up."
msgstr "得把这个安装好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Wanna BBQ, Lucy?"
msgstr "要不要来 BBQ 呀，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "Better set this up."
msgstr "得把这个安装好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_HOE"
msgid "It's a farmer's life for me."
msgstr "我的农夫生活。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_KEY"
msgid "Think it's for a safe."
msgstr "我猜这是保险箱的钥匙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "Oh beauty, now we can open the gate."
msgstr "哦，美人，我们现在可以开门了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "It don't have an off switch."
msgstr "它没有可以关掉的按钮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Just wastes electricity."
msgstr "浪费电而已。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "We just gotta grind and bear it."
msgstr "我们只能磨磨忍受。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Those scaly folks live in there."
msgstr "那些可怕的半人类就住在那里面。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "What's for sale today?"
msgstr "今天有什么卖？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Need some supplies, Lucy?"
msgstr "要日用品吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "We're gonna eat you."
msgstr "我们要吃掉你。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Those mushrooms look mighty tasty."
msgstr "那些蘑菇看起来超好吃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "Thank you for your sacrifice, tree."
msgstr "谢谢你的牺牲，大树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION"
msgid "I only cry tears of joy."
msgstr "我只会流出喜悦的泪水。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Perfectly roasted."
msgstr "烤得完美。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN"
msgid "That better not run on trees."
msgstr "最好别把它架在树木上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Be careful around that fire, Lucy."
msgstr "在火旁边可要小心呀，露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Yeesh."
msgstr "哎呀呀。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Not as pretty as Lucy."
msgstr "没有露西那么漂亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "To each his own."
msgstr "各有所爱吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "This fountain's really old."
msgstr "这座喷泉真的很旧了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "In we go."
msgstr "进去了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "We need a key to open it."
msgstr "我们要有钥匙才能打开它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "A fine monument to something."
msgstr "挺好的，不知道是什么纪念碑。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Aw. Sorry, eh."
msgstr "啊，很遗憾，嗯。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "I don't see any reason to bother the poor fella."
msgstr "我觉得没什么理由去折腾那可怜的家伙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It ain't living no more."
msgstr "它活到头了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "It's a filthy pigeon."
msgstr "是一只臭鸽子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's getting some shut-eye."
msgstr "它要睡会儿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Kinda fancy eh, Lucy?"
msgstr "挺精美的，对吧露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Wouldn't wanna swim in it, that's fer sure."
msgstr "我肯定不想在里面游泳。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Looks important."
msgstr "看起来很重要。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT"
msgid "What do ya wanna make, Lucy?"
msgstr "你想煮点什么，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO"
msgid "I love good local produce."
msgstr "我爱吃优质的本地农产品。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "It cooked up real nice."
msgstr "做得真不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "It's all set up."
msgstr "都装好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Gotta hang the pot on the fire somehow."
msgstr "要想办法把锅子架在火上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "I only know a handful of recipes, but I'm real good at them."
msgstr "我只会做那么几道菜，但是手艺不太好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "You have to have sap to make syrup."
msgstr "得有汁液才能做糖浆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "The soil ain't right here."
msgstr "这里的土壤不对劲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "It's not gonna work like that."
msgstr "那样是不行的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Huh. Wonder what happened here?"
msgstr "嗯，我想知道这里发生了什么事？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Kinda scary, eh?"
msgstr "有点可怕，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Nothing left of a fireplace."
msgstr "丝毫没留下壁炉的痕迹。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Too bad, eh?"
msgstr "太糟糕了，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Is that the right time?"
msgstr "时间是对的吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "That's a shame."
msgstr "真可惜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Somethin' happened here, Lucy."
msgstr "露西，这里出过事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "I wonder what they did wrong."
msgstr "我想知道他们做错了什么。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Gotta be pretty angry to destroy someone's home."
msgstr "一定是有很大的怒气，才会把人家的房子都毁了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "Such a shame."
msgstr "真可惜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "That doesn't look right."
msgstr "看起来不对劲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "No one'll miss it."
msgstr "没人会想念它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Locked tight."
msgstr "锁得牢牢的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALMON"
msgid "Need a good cedar plank to cook it on."
msgstr "需要把它放在一块不错的杉木板上烤。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Tastes like home."
msgstr "家的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT"
msgid "It's salty."
msgstr "它是咸的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Maybe I could chop it into smaller bits."
msgstr "也许我可以把它劈成小块。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Gonna be a bit longer."
msgstr "还需要好一阵子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "It's ready."
msgstr "可以收获了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "Gotta set'er up."
msgstr "要把它安装好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP"
msgid "Tree sap. From a tree."
msgstr "树木汁液。来自树木。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "Didn't I tell everybody trees were delicious?"
msgstr "难道我没告诉大家，这些树很美味？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAPLING"
msgid "It's not growing back."
msgstr "它不会重新长出来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "That's a shame, eh?"
msgstr "很可惜，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "This will keep us busy for a while."
msgstr "这个够我们忙活一阵子了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "No use gettin' Lucy dirty."
msgstr "没必要弄脏露西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "You only need a pinch to get the flavour."
msgstr "只要一点点，味道就会出来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Looks real flavourful."
msgstr "看起来风味十足啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's been picked already."
msgstr "已经被摘掉了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It makes my fingers smell like pepper."
msgstr "它弄得我的手指都有胡椒味了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It's beautiful!"
msgstr "真美啊！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Cut down in its prime."
msgstr "在它最茁壮的时候割下。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Hey, get away from that tree will ya!"
msgstr "嘿，你们离那棵树远点儿！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Fillin' up, slow as molasses."
msgstr "慢慢装着，像糖蜜那么慢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Thanks for the sap, tree."
msgstr "谢谢你的汁液，大树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "What troubles you, sister?"
msgstr "你碰上什么麻烦了呀，姐妹？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "They seem like an alright sort."
msgstr "它们看上去不像坏蛋。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Every society's gotta have a leader, I guess."
msgstr "每个社团都有老大，我猜的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's getting some shut-eye."
msgstr "它要睡会儿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Home sweet home, eh?"
msgstr "家，甜蜜的家，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Just rocks, now."
msgstr "现在只有石头了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Not quite maple."
msgstr "“枫”味不足。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO"
msgid "That's a nice looking tomato."
msgstr "好漂亮的一只番茄。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Heartburn city."
msgstr "烧熟了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Hey there!"
msgstr "你好呀！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "How ya doin'?"
msgstr "你好吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP"
msgid "From the community garden."
msgstr "来自社区园子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooked real nice."
msgstr "煮的真不错。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT"
msgid "Such a fancy shade of gold."
msgstr "好美的金黄色。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "我看像是新的农作物种子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.GENERIC"
msgid "Dang ground squirrels..."
msgstr "讨厌的地松鼠..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBIT.HELD"
msgid "I'd feel bad eating him."
msgstr "吃掉他会让我感觉很糟糕。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.GENERIC"
msgid "I doubt there are trees down there."
msgstr "我很怀疑那下面到底有没有树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOLE.SPRING"
msgid "Nothing going in or out."
msgstr "既没有东西进去也没有东西出来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Is it roasted carrot flavoured?"
msgstr "这是烤胡萝卜的味道吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Is it carrot flavoured?"
msgstr "这是胡萝卜的味道吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINCOAT"
msgid "For chopping in the rain."
msgstr "为了能在雨中砍树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINHAT"
msgid "Always keep a dry head while chopping."
msgstr "在砍树的时候始终保持头部干燥。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.BURNT"
msgid "Its knowledge of rain didn't keep it from being burned."
msgstr "气候专家也躲不过被烧毁的命运。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAINOMETER.GENERIC"
msgid "Rain makes the trees grow."
msgstr "下雨会让树长得快。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RATATOUILLE"
msgid "It's like a forest in a bowl."
msgstr "它就像碗里的一片森林。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RAZOR"
msgid "A true lumberjack never shaves."
msgstr "真正的伐木工永远不会剃胡子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDGEM"
msgid "I see within it the fiery death of a thousand trees."
msgstr "我在它里面看到了成千棵树在熊熊烈火中死去。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDLANTERN"
msgid "This little light of mine."
msgstr "我的小亮光。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDMOONEYE"
msgid "A true woodsman knows his own way around the forest."
msgstr "真正的樵夫知道他在森林里的路。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REDPOUCH"
msgid "It's Lucy-colour."
msgstr "这是露西喜欢的颜色。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP"
msgid "I don't know..."
msgstr "我不知道..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_CAP_COOKED"
msgid "You'd have to be really, really hungry."
msgstr "你应该是很饿很饿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "It's a red mushroom."
msgstr "是红蘑菇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "They have their own schedule."
msgstr "它们有自己的作息规律。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "I'll have to be patient."
msgstr "我必须有耐心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.BURNING"
msgid "Fire makes me nervous."
msgstr "火让我紧张。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.GENERIC"
msgid "Reeds."
msgstr "芦苇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REEDS.PICKED"
msgid "They'll be back."
msgstr "它们会再长出来的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REFLECTIVEVEST"
msgid "I'm still not convinced plaid isn't all-weather wear."
msgstr "我还是不相信会有不适合穿格子图案衣服的时候。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RELIC"
msgid "I don't plan on fixin' that."
msgstr "我没打算把它修好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.BURNT"
msgid "How did it get burned?!"
msgstr "它怎么会烧着呢？！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I don't trust all this science stuff."
msgstr "我不相信所有这些科学的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Well, it obeys some basic laws of physics."
msgstr "没错，它也得遵守某些基本的物理定律。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "This is getting strange."
msgstr "这越来越奇怪了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Nope, lost it."
msgstr "没了，什么都没了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "Okay, I kind of get it now."
msgstr "好吧，我好像明白了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "This is why I don't use hat warmers."
msgstr "这就是我不喜欢用帽子保暖的原因。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "I like to call it the \"Hat Machine\"!"
msgstr "我喜欢叫它“帽子机器”！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "That's a shame, that."
msgstr "可惜了那个，真的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "All my buddies could be improved with wood."
msgstr "我所有的伙伴可以用木材改善体质。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RESURRECTIONSTONE"
msgid "I don't know if I should touch that."
msgstr "我不确定是不是应该去碰那个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.REVIVER"
msgid "I need to share this with somebody!"
msgstr "这东西得分享！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RHINODRILL"
msgid "They really like bumping chests like that, eh?"
msgstr "他们还真喜欢那样捶胸口，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.GENERIC"
msgid "What a snotty little jerk."
msgstr "真是下贱的小混蛋。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN.HELD"
msgid "Don't get comfortable, birdie."
msgstr "不要觉得太舒适了，臭鸟。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "Go fly south or something!"
msgstr "飞到南方去不就行了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's stealing my warmth."
msgstr "它在偷取我身体的热量。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET"
msgid "They're trapped!"
msgstr "它被困住了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK"
msgid "I could break it down if I tried hard enough."
msgstr "如果足够用劲的话，我应该可以把它凿碎。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKS"
msgid "Could make a decent little inukshuk with these."
msgstr "用这些东西可以做成一个不错的小因努伊特石堆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCKY"
msgid "Lobster supper time!"
msgstr "龙虾餐时间！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Home sweet home!"
msgstr "感觉像回到家乡一样！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE.MELTED"
msgid "Back home, they never melt."
msgstr "在家乡，它们绝不会融化的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_ICE_MELTED"
msgid "Back home, they never melt."
msgstr "在家乡，它们绝不会融化的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "It's looking a tad crusty."
msgstr "它看上去带着点壳。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.LOW"
msgid "Needs more... wood?"
msgstr "需要加点...木材？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "A fire that needs no wood? Unnn-natural!"
msgstr "不需要木材的营火？太太太违反自然规律了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks like it could break."
msgstr "它看起来像要碎掉一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_MOON"
msgid "It's uh, a moon rock."
msgstr "呃，它是一块月亮石。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "So... senseless."
msgstr "太…愚蠢了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "So... senseless."
msgstr "太…愚蠢了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK"
msgid "Hmm... does the rook move in a straight line? I forget."
msgstr "嗯...象棋里的车是直线移动的吗？我忘记了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROOK_NIGHTMARE"
msgid "The gears are spilling out."
msgstr "齿轮都散落出来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROPE"
msgid "Good for holding stuff to other stuff."
msgstr "可以用来把不同的东西捆在一起。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROTTENEGG"
msgid "One less bird. Good."
msgstr "这世上将少一只鸟。很好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROYAL_JELLY"
msgid "I'm majestic enough as is."
msgstr "我本来就够威严了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUBBLE"
msgid "Broken furniture."
msgstr "残破的家具。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINSHAT"
msgid "It's no toque, but it'll do."
msgstr "虽然不是无边帽，但还凑合。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_BAT"
msgid "Metal on a stick."
msgstr "金属串在棍子上。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RUINS_RUBBLE"
msgid "All busted up."
msgstr "一切都毁了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "It makes my beard hair stand on end."
msgstr "这让我寒毛都立起来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It's thinkin' real hard."
msgstr "它还在很努力地想。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLEHORN"
msgid "Puts the critter back to how nature intended."
msgstr "把这家畜放回到自然状态。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_BASIC"
msgid "Yep, that'll get us there."
msgstr "是的，那个会帮助我们到那里。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_RACE"
msgid "Makes me feel like some sorta woodland nymph, eh?"
msgstr "让我有森林女神的感觉，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SADDLE_WAR"
msgid "Makes me feel like a Mountie."
msgstr "让我感觉像个加拿大骑警。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SALTLICK"
msgid "My mouth's dry just looking at it."
msgstr "只是看着它我的嘴巴就干了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDBLOCK"
msgid "Some good craftsmanship."
msgstr "一些不错的技艺。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANDSPIKE"
msgid "That's something else, eh?"
msgstr "那是一些别的事，呃？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.ACTIVE"
msgid "Something is off aboot that rock, eh?"
msgstr "那块石头有点奇怪，你说呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SANITYROCK.INACTIVE"
msgid "That makes sense."
msgstr "可以理解。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.BURNING"
msgid "Aw! He barely had a chance!"
msgstr "唉！他都没机会长大！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "它染上病毒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.DISEASING"
msgid "A poor excuse for wood."
msgstr "给木头的一个蹩脚的借口。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.GENERIC"
msgid "I want to see it grow so I can chop it down."
msgstr "我想要看它长大，那样我就可以砍掉它了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.PICKED"
msgid "Picking isn't as fun as chopping."
msgstr "采摘与砍树相比真是太没意思了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SAPLING.WITHERED"
msgid "With this heat it'll never grow to chopping size!"
msgstr "在这么炎热的天气下，它永远也不会长到适合砍伐的大小！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNING"
msgid "Glad that's not me."
msgstr "很高兴那不是我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.BURNT"
msgid "Great, now those feathered hosers are gonna run wild."
msgstr "太好了，现在那些有羽毛的傻子要到处乱跑了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCARECROW.GENERIC"
msgid "He's doing the world a service."
msgstr "他在服务这个世界。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCORCHED_SKELETON"
msgid "Yikes."
msgstr "呀。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "I'm really more of a whittler."
msgstr "我真的不只是一个削木者。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Back to whittling."
msgstr "回去削木吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Oughta put a block of cut stone up there."
msgstr "应该在那里搭起一批雕刻的石头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Hm. Not bad, eh?"
msgstr "嗯。不错，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "I don't get art. Whattaya think Lucy?"
msgstr "我不懂艺术。你怎么想，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Whose bright idea was it to fix this thing?"
msgstr "是谁想出修理这东西的好主意？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "石头应该像那样移动吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Creepy."
msgstr "真吓人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "That doesn't seem right."
msgstr "那似乎不对。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Once you've seen one weird statue, you've seen'em all."
msgstr "一旦你看到一个怪异的雕像，你就看到它们所有了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Just needed a little duct tape."
msgstr "只需要一点牛皮胶布。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "石头应该像那样移动吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "Yikes. Put it back in."
msgstr "呀！把它重新放进去。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "That's a heavy lookin' hoser."
msgstr "那是一个看上去很沉的傻子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Just a big hunk of stone, as far as I'm concerned."
msgstr "依我看，只是一大块石头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "As if I didn't have enough reasons to hate full moons."
msgstr "好像我没有足够的理由来讨厌满月。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Is stone supposed to move like that?"
msgstr "石头应该像那样移动吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Looks a bit like one of them chargin' hosers."
msgstr "看起来他们中有人在攻击傻子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Just a big hunk of marble, that."
msgstr "那只是一大块大理石。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS"
msgid "Not trees."
msgstr "不是树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEEDS_COOKED"
msgid "We call this \"lumberjack surprise\"."
msgstr "我们把它叫做“伐木工的惊喜”。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SENTRYWARD"
msgid "That's an odd looking tree."
msgstr "那棵树长得真奇怪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_KIT"
msgid "I'm pretty good at sewing."
msgstr "缝缝补补是我的长项。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SEWING_TAPE"
msgid "Makes me feel right at home."
msgstr "在家我感觉很好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWDIGGER"
msgid "Are your little buddies, uh... alive?"
msgstr "你的小伙伴，嗯哈…还活着吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOWHEART"
msgid "Yeesh. Don't get that near me."
msgstr "咦嘘。不要让它靠近我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHOVEL"
msgid "Dig a hole. Plant a tree!"
msgstr "挖洞。种树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHROOM_SKIN"
msgid "That's gross."
msgstr "太恶心了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.BURNT"
msgid "It's a husk."
msgstr "只剩下外壳了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Naps are important during a long day of chopping."
msgstr "长时间砍树之后，打个盹儿是很有必要的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SILK"
msgid "Spiders give me the willies."
msgstr "看到蜘蛛我就心惊胆战。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON"
msgid "Sorry, friend."
msgstr "抱歉，朋友。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETONHAT"
msgid "That right there's a cursed object, eh?"
msgstr "没错，那里有被诅咒的物体，呃？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "Poor %s. I should watch out for %s, eh?"
msgstr "可怜的 %s。我该提防 %s，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "Poor %s. %s got her, eh?"
msgstr "可怜的 %s。%s 抓到她了吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "Poor %s. %s got him, eh?"
msgstr "可怜的 %s。%s 抓到他了吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "Poor %s. %s got them, eh?"
msgstr "可怜的 %s。%s 抓到他们了吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKETCH"
msgid "Some plans for a fancy stone carving."
msgstr "用于别致的石头雕刻的一些计划。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SKULLCHEST"
msgid "That's scary!"
msgstr "太吓人了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLEEPBOMB"
msgid "Some folks around here could use the shuteye."
msgstr "周围的一些人可以利用睡着的人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER"
msgid "I think it's living hair."
msgstr "我觉得这团毛球是活的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPERPELT"
msgid "Where's the nearest fur trader?"
msgstr "离这最近的毛皮交易商在哪里？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURPER_PELT"
msgid "Looks like a dead beaver."
msgstr "看上去像一只死去的海狸。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE"
msgid "He's just misunderstood."
msgstr "他只是被误解了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHAT"
msgid "That could sure keep a noggin safe."
msgstr "那个确定能确保脑瓜安全。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLEHOLE"
msgid "Are you guys doing okay in there?"
msgstr "你们在那地方没问题吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLESLIME"
msgid "Someone needs a tissue."
msgstr "看来有人需要一张纸巾。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "His home is broken now. Oh."
msgstr "现在他的家毁了。噢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.GENERIC"
msgid "What do you want?"
msgstr "你想要什么？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "It wants something."
msgstr "它想要什么东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLBIRD.STARVING"
msgid "I think it's starving."
msgstr "我想它应该是很饿了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT"
msgid "I wish this were bigger."
msgstr "真希望它再大点儿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SMALLMEAT_DRIED"
msgid "Just a bite."
msgstr "一口就没了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNAPPER"
msgid "Keep them chompers to yourself."
msgstr "收起你的长牙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SNURTLE"
msgid "Spirals!"
msgstr "螺旋形的东西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPAT"
msgid "Reminds me of momma!"
msgstr "让我想起了妈妈！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR"
msgid "It lacks the heft of a good solid axe."
msgstr "比起一把坚实的好斧子，它的重量还轻了点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR"
msgid "I'd take a stab at it."
msgstr "我来试试它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE"
msgid "I could give it a whirl."
msgstr "我可以试试它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Who needs a spear when you got ol'Luce?"
msgstr "有了老露西时，谁还需要长矛？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD"
msgid "Good!"
msgstr "很好！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.GENERIC"
msgid "That's the biggest spider I've ever seen!"
msgstr "这是我见过的最大的蜘蛛！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.SLEEPING"
msgid "Careful, now, eh?"
msgstr "现在应该小心点儿，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERDEN"
msgid "Holy Mackinaw! Look at that thing!"
msgstr "好家伙！看那个东西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDEREGGSACK"
msgid "Why would I want to carry that around?"
msgstr "我为什么要带着那个东西到处走？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERGLAND"
msgid "I think it's poison."
msgstr "我觉得它有毒。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHAT"
msgid "She's a real beaut, ain't she?"
msgstr "这帽子真漂亮，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE"
msgid "I should skedaddle before they come out of there."
msgstr "我应该在它们出来之前赶紧离开这地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERHOLE_ROCK"
msgid "I should skedaddle before they come out of there."
msgstr "我应该在它们出来之前赶紧离开这地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEEN"
msgid "You're not MY queen!"
msgstr "你可不是我的女王！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_DROPPER"
msgid "They're smart to live away from the corruption."
msgstr "它们很聪明，知道要远离腐烂物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_HIDER"
msgid "Tricky devil!"
msgstr "狡猾的魔鬼！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_SPITTER"
msgid "Spitting is rude!"
msgstr "乱吐东西太没礼貌了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Great!"
msgstr "太好了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "They come in yellow now?"
msgstr "它们现在变成黄色了？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "You're snoozin' fer a bruisin'."
msgstr "你睡着的时候会被揍得鼻青脸肿的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPOILED_FOOD"
msgid "Aw, it's Diefenbakered."
msgstr "呀，就像约翰·迪芬贝克一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "A floating red pinecone!"
msgstr "一颗漂浮着的红色松果！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "One day this might be a tree."
msgstr "有一天它可能会长成一棵树的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "We've been visited by a forest sprite, Lucy!"
msgstr "我们收到了一位森林精灵的邀请，露西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_SMALL.HELD"
msgid "One day this might be a tree."
msgstr "有一天它可能会长成一棵树的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.GENERIC"
msgid "A flying green pinecone!"
msgstr "一颗漂浮着的绿色松果！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPORE_TALL.HELD"
msgid "One day this might be a tree."
msgstr "有一天它可能会长成一棵树的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFCOLDLIGHT"
msgid "At least it won't start a forest fire."
msgstr "至少它不会引起森林大火。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFFLIGHT"
msgid "Well ain't that something."
msgstr "太厉害了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAFF_TORNADO"
msgid "I prefer to chop the trees myself."
msgstr "我更喜欢用自己的双手去砍树。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.AWAKE"
msgid "I really wish I hadn't seen that."
msgstr "我真希望我没有看到那东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STAGEHAND.HIDING"
msgid "Not my style."
msgstr "不是我的风格。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE"
msgid "I'm not too interested in rocks."
msgstr "我对岩石没多大兴趣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALAGMITE_TALL"
msgid "I'm not too interested in rocks."
msgstr "我对岩石没多大兴趣。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER"
msgid "It's a walking anatomy lesson."
msgstr "这是一堂行走的解剖课。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_ATRIUM"
msgid "That fuel stuff's gone to its head."
msgstr "那些燃料材料都跑到它头上了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STALKER_MINION"
msgid "Ain't no reason for that to exist."
msgstr "那个没有理由存在。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "It had some cool things inside, eh?"
msgstr "里面肯定有过很酷的东西，是不是？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "That's a curious statue, eh?"
msgstr "好奇怪的雕像，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEHARP"
msgid "You lost your head, eh?"
msgstr "你的头不见了，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUEMAXWELL"
msgid "I'm gonna make fun of him for this later, eh?"
msgstr "稍后我要用这个逗一下他，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "She's a real tall one, eh?"
msgstr "她实在高，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "I'm not sure I get it."
msgstr "我不确定我是否理解了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Could make a nice planter outta that."
msgstr "可以从那东西种出一棵不错的植物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STEELWOOL"
msgid "That'll put the shine back on yer axe."
msgstr "用这个可以让你的斧子重新变得闪亮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STINGER"
msgid "Ouch! It's pointy."
msgstr "哎哟！扎到我了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STRAWHAT"
msgid "It'll keep the sun off yer head."
msgstr "我会让你的头不会被太阳晒到。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.STUFFEDEGGPLANT"
msgid "I'm getting better at cooking."
msgstr "我的厨艺越来越好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PICKED"
msgid "There's a lot of water in there for such a tiny plant."
msgstr "这样微小的一株植物居然有很多水。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_PLANT"
msgid "That's a plant, eh?"
msgstr "那是一株植物，呃？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUCCULENT_POTTED"
msgid "Ain't a tree, but ain't bad."
msgstr "不是一棵树，但也不坏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKBOAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SUNKBOAT"
msgid "That wood has seen better days."
msgstr "那些木头以前是有过好日子的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SWEATERVEST"
msgid "It's not plaid, but it'll do."
msgstr "虽然不是格子图案的，但还凑合。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TAFFY"
msgid "Sugary good."
msgstr "甜食很好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRD"
msgid "I don't trust birds that can't fly, either."
msgstr "即使是不会飞的鸟，我也不相信。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG"
msgid "What's in here?"
msgstr "这里面是什么？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It tastes like justice."
msgstr "正义得以彰显的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Too cold for you?"
msgstr "你觉得太冷了吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "It's hatching."
msgstr "它在孵化。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Is it crying?"
msgstr "它在哭吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "Birds are never prompt."
msgstr "鸟类从来都是不慌不忙的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Anytime now."
msgstr "就快好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "I should steal its egg to teach it a lesson."
msgstr "我应该去偷它的蛋，给它点儿教训。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Nothing there."
msgstr "什么也没有。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.GENERIC"
msgid "It's growing up to be a jerk, just like its parents."
msgstr "它将来也会长成一个混球，就像它的父母一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Are you ALWAYS hungry?"
msgstr "你一天到晚都很饿吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TEENBIRD.STARVING"
msgid "It getting wild with hunger."
msgstr "饥饿会让它变得野蛮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.GEMS"
msgid "Needs gems, eh?"
msgstr "需要装上宝石，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEBASE.VALID"
msgid "It's ready, but am I?"
msgstr "它是准备好了，但我呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "Ready to go, eh?"
msgstr "准备好了，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "It's a... magic thing, I think."
msgstr "我想这应该是个...有魔法的东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "There are bits missing, eh?"
msgstr "好像少了点什么，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "It's almost ready, eh?"
msgstr "就快准备好了，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_BOX"
msgid "Box-y, eh?"
msgstr "四四方方的，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_CRANK"
msgid "Crank-y, eh?"
msgstr "弯弯扭扭的，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_POTATO"
msgid "Potato-y, eh?"
msgstr "看起来像土豆，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELEPORTATO_RING"
msgid "Ring-y, eh?"
msgstr "环状的，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TELESTAFF"
msgid "I wonder what this thing does."
msgstr "我很好奇这东西干什么用的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.BURNT"
msgid "I don't think it can still be considered a tent."
msgstr "我觉得它现在已经称不上是帐篷了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENT.GENERIC"
msgid "I'm used to sleeping in worse."
msgstr "我已经习惯在糟糕的环境中睡觉。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE"
msgid "There a squid down there?"
msgstr "那下面有一条鱿鱼？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPIKE"
msgid "It wobbles when you wave it."
msgstr "这玩意挥舞起来还在左摇右摆呢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLESPOTS"
msgid "I'm blushing!"
msgstr "我脸红了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_GARDEN"
msgid "I'm tired of these squids!"
msgstr "我厌倦了这些鱿鱼！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR"
msgid "It's so big!"
msgstr "好大啊！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Are those squid babies?"
msgstr "那些是小鱿鱼吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Not even a stump left behind!"
msgstr "就连桩子也没留下！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE"
msgid "It's the wood of the caves!"
msgstr "它可以说是洞穴里的木头！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THULECITE_PIECES"
msgid "It's not wood but it'll do."
msgstr "虽然不是木制的，但还凑合。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.THURIBLE"
msgid "Someone's trying to give us a leg up."
msgstr "有人正在尝试助我们一臂之力。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.GENERIC"
msgid "I'm gonna need a bigger axe."
msgstr "我需要一把更大的斧头。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL.RAGE"
msgid "Alright, enough playin' around! Get'em Lucy!"
msgstr "好吧，玩够了！抓住它们，露西！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "It's a hole."
msgstr "是个洞。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "It isn't polypore-sonal, I just gotta chop you."
msgstr "不是私人恩怨，但我要砍了你。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Is that how trees are born?"
msgstr "那就是树木如何长出来的吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOPHAT"
msgid "It's too fancy."
msgstr "太花哨了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TORCH"
msgid "Trees by torchlight."
msgstr "火炬让我又能看到树了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Get a move on."
msgstr "赶快。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Some sort of sandy transportation."
msgstr "某种沙地运输工具。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "Time to get a move on."
msgstr "赶紧点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "S'got a powerful stink, eh?"
msgstr "气味真臭，呃？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILMIX"
msgid "The perfect snack for a day of chopping."
msgstr "一天劳作之后的完美零食。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAILS"
msgid "Mighty powerful right hook on that hoser."
msgstr "给那傻子一记厉害的右勾拳。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRANSISTOR"
msgid "I won't even pretend to know how that works."
msgstr "我甚至都不会假装明白它的工作原理。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP"
msgid "Work smarter, eh?"
msgstr "变聪明了，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH"
msgid "This seems a bit rough."
msgstr "做工似乎有点粗糙。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "That's not playing fair, eh?"
msgstr "那不公平，他耍诈，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.BURNT"
msgid "I guess wood does have a downside..."
msgstr "我猜木头也有不好的一面..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST.GENERIC"
msgid "Wood is so handy! Look at all the things you can make!"
msgstr "木头太有用处了！看看所有这些用木头做的东西就知道了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREASURECHEST_TRAP"
msgid "Something is not quite right aboot that chest."
msgstr "那个箱子有点不太对劲。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREECLUMP"
msgid "You're asking for a good chop, bud."
msgstr "老兄，这可是你自己找砍。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREEGUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TREEGUARD"
msgid "The forest spirits have been angered!"
msgstr "森林精灵已经被激怒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_1"
msgid "I used to play that game."
msgstr "我以前玩过那个游戏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_10"
msgid "Choppers for old folks."
msgstr "老年人的牙齿。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_11"
msgid "Quiet, you!"
msgstr "你，给我安静点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_12"
msgid "It's all withered."
msgstr "它完全萎缩了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_13"
msgid "She looks friendly."
msgstr "她看上去很友好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_14"
msgid "Gaudy as all get-out."
msgstr "非常华丽。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_15"
msgid "And here I am just a pawn, eh?"
msgstr "在这里我只是个一颗棋子？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_16"
msgid "And here I am just a pawn, eh?"
msgstr "在这里我只是个一颗棋子？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_17"
msgid "It needs to be straightened, eh?"
msgstr "它需要矫正，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_18"
msgid "I would have liked this when I was a boy."
msgstr "我还是孩子的时候应该会喜欢这个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_19"
msgid "It keeps falling over, eh?"
msgstr "它一直往下掉，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_2"
msgid "Much kazoo aboot nothing."
msgstr "无事生芦笛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_20"
msgid "Wigfrid keeps using it to \"spar\" with me and Lucy. We're afraid."
msgstr "薇格弗德一直用它来“对抗”我和露西。我们害怕。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_21"
msgid "It belongs in a kitchen, not in the woods."
msgstr "它属于厨房，而不是树林。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_22"
msgid "I'd rather have some proper rope."
msgstr "我宁愿有一件合身的长袍。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_23"
msgid "Maxwell probably needs that for his fancy shoes."
msgstr "麦斯威尔的漂亮鞋子或许要用到这个。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_24"
msgid "We should whip up some pumpkin cookies to put in it, eh?"
msgstr "我们该抓些南瓜饼干放进去吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_25"
msgid "I already smell like pine and woodchips, according to Lucy."
msgstr "露西说我闻起来有松树和木片的味道。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_26"
msgid "Genius! A cup for a proper woodsman."
msgstr "天才！给樵夫用的杯子做好了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_27"
msgid "No point hanging clothes in the woods."
msgstr "把衣服挂在树林里毫无意义。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_28"
msgid "That one moves diagonally, I think."
msgstr "我认为那个成对角线移动。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_29"
msgid "That's, uh, the rook piece."
msgstr "那是战车，呃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_3"
msgid "Reminds me of a story I heard once."
msgstr "让我想起了我曾经听到的一个故事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_30"
msgid "That one can only move one square at time."
msgstr "那个一次只能移动一个方格。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_31"
msgid "That's the, uh, horse piece."
msgstr "那是马，呃。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_32"
msgid "I'd rather my future be a surprise."
msgstr "我宁愿我的未来是个惊喜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_33"
msgid "Creepy."
msgstr "真吓人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_34"
msgid "That right there's a bad time waitin' to happen."
msgstr "对的，那不是等待事情发生的好时机。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_35"
msgid "Doesn't even have a label."
msgstr "甚至没有标签。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_36"
msgid "More intimidating than beaver teeth."
msgstr "比海狸的牙齿更吓人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_37"
msgid "What a waste of wood, eh?"
msgstr "额，真是浪费木材？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_38"
msgid "Looks like a pair of binoculars."
msgstr "看起来像一只望远镜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_39"
msgid "Oh, the gloves're comin' off now!"
msgstr "啊，手套要掉了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_4"
msgid "Wolfgang would appreciate that moustache."
msgstr "沃尔夫冈会喜欢那个胡须的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_40"
msgid "It's a snail-shaped scale, eh?"
msgstr "蜗牛造型的秤，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_41"
msgid "Got no idea what that's for."
msgstr "不知道那是干嘛用的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_42"
msgid "Better than meeting a real one, eh?"
msgstr "比遇到真的要好，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_43"
msgid "Get along, lil gator."
msgstr "走吧，小鳄鱼。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_44"
msgid "Smashed to bits."
msgstr "粉身碎骨。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_45"
msgid "What sorta shows d'you think it gets?"
msgstr "你觉得它会放什么样的节目？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_46"
msgid "I prefer to let mine air dry."
msgstr "我更愿意让我的自然晾干。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_5"
msgid "It needs a robot arm, eh?"
msgstr "它需要一个机器臂，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_6"
msgid "They're not good any more, eh?"
msgstr "它们再也变不回原来的样子了，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_7"
msgid "'Might take it to the kid."
msgstr "可能把它带给孩子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_8"
msgid "Reminds me... gotta convince Willow to take a *real* bath."
msgstr "提醒我…说服薇洛*真正地洗一次澡。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRINKET_9"
msgid "I just sew my clothing shut around me when I put it on."
msgstr "我刚才在穿衣服的时候已经把衣服扣子缝死了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Nice and breezy."
msgstr "好看又透气。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNKVEST_WINTER"
msgid "This could stand up to the winters back home, eh?"
msgstr "这应该可以抵御家乡的寒冬，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_COOKED"
msgid "I think it boiled off all of the nose cheese."
msgstr "我想所有鼻涕应该都煮掉了吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_SUMMER"
msgid "It's pretty thin."
msgstr "真的好薄。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TRUNK_WINTER"
msgid "It's thick and hairy."
msgstr "又厚实又毛茸茸的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TUMBLEWEED"
msgid "I wish it was sturdier so I could chop it."
msgstr "真希望它再坚固些，这样我就可以砍它了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_BADLANDS"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CARPETFLOOR"
msgid "Too classy for my tastes."
msgstr "太对我的口味了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CAVE"
msgid "Some ground."
msgstr "一些地皮。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Looks like one of those city-people outhouses."
msgstr "看起来像城市里户外厕所的地板。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DECIDUOUS"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DESERTDIRT"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DIRT"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_DRAGONFLY"
msgid "Fire doesn't quite take here, eh?"
msgstr "火在这地方不太容易烧起来，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FOREST"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS"
msgid "It's mushy, like peas."
msgstr "黏糊糊的，像豌豆泥一样。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_FUNGUS_RED"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_GRASS"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MARSH"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_MUD"
msgid "At least you don't have to clean it."
msgstr "至少不需要你打扫。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROAD"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_ROCKY"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SANDY"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SAVANNA"
msgid "Just some ground, eh?"
msgstr "只是一些地皮，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE"
msgid "I found this underground."
msgstr "我是在地下发现这个的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK"
msgid "Rocks. Bleh."
msgstr "是岩石。废话。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR"
msgid "Flooring fit for a king!"
msgstr "适合国王的地板！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER"
msgid "Turkey day is here again!"
msgstr "又到火鸡节了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS"
msgid "Gotta keep that one from hiding, eh?"
msgstr "要组织那家伙躲藏，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Sorry!"
msgstr "抱歉！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT"
msgid "How terrible!"
msgstr "好恐怖！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Another one!"
msgstr "又砍倒一棵！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "它染上病毒了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Choppin's choppin'."
msgstr "砍啊砍啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT"
msgid "With a little care, this could make fer some good choppin'."
msgstr "稍加留意，树可以更好砍断。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "One day it'll make good chopping."
msgstr "有一天它会优秀伐木工。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD"
msgid "I'd be lucky to get two chops out of that thing."
msgstr "很幸运我能够从那个东西身上拿到两块排骨。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS"
msgid "I should build a tiny axe to chop these."
msgstr "我应该做个小斧子来砍这些。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA"
msgid "Something like that'd keep my beard dry, eh?"
msgstr "那样的东西可以让我的胡子保持干燥，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI"
msgid "It'll fill ya up."
msgstr "它会填饱你的肚子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED"
msgid "It doesn't look safe."
msgstr "看起来不太安全。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES"
msgid "I prefer flapjacks."
msgstr "我更喜欢煎饼。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT"
msgid "Well that escalated quickly."
msgstr "嗯，事情太突然了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC"
msgid "You could sneeze it down."
msgstr "你打个喷嚏都能把它弄倒。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM"
msgid "I could sneeze it apart."
msgstr "它打个喷嚏都能把它弄倒。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK"
msgid "Looks nice'n'sturdy."
msgstr "看起来美观又坚固。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "It's not much use like that."
msgstr "那样用处不大。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS"
msgid "Crumbling, but still secure, eh?"
msgstr "虽然破碎了，但还是安全的，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM"
msgid "Heh, stoned again, eh?"
msgstr "呵，又是石头做成的，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE"
msgid "Safe and secure, eh?"
msgstr "相当安全，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM"
msgid "Safe and secure, eh?"
msgstr "相当安全，不是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT"
msgid "I miss the old you."
msgstr "我好想念以前的你。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC"
msgid "I like the look of that!"
msgstr "我喜欢它的样子！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM"
msgid "I like the look of that!"
msgstr "我喜欢它的样子！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS"
msgid "Oh no. Walruses again!"
msgstr "不是吧，又是海象！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT"
msgid "My granddad wore a hat like that."
msgstr "我爷爷也有一顶这样的帽子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "This won't be safe come winter."
msgstr "这在冬天会变得不安全。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Walruses are nearby, eh?"
msgstr "海象就在附近，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK"
msgid "He had a cavity, eh?"
msgstr "他有蛀牙，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING"
msgid "Wood is the best at burning."
msgstr "木头可是最好的燃料。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT"
msgid "Not so useful now, eh?"
msgstr "现在没那么有用了，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC"
msgid "It's hard to stay neat and tidy in the woods."
msgstr "在树林里要保持干净整洁并非易事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG"
msgid "That thing could pull a sled by its lonesome."
msgstr "那东西仅凭一己之力就可以拉动雪橇。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT"
msgid "Burned up."
msgstr "烧毁了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Gotta warm this doghouse up, eh?"
msgstr "这个狗屋需要暖和暖和，对吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Nice and toasty."
msgstr "舒服又暖和。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE"
msgid "Why are those bees so angry?"
msgstr "那些蜜蜂为什么这么生气？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON"
msgid "Could be fun times lobbin' these around."
msgstr "把这些东西抛来抛去应该挺好玩的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON"
msgid "How can it be both water and melon?"
msgstr "一个瓜怎么能含那么高的水分呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT"
msgid "Well, points for creativity."
msgstr "好吧，有点儿创意。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE"
msgid "Wood AND food?!"
msgstr "木头和食物？！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED"
msgid "I'm not sure aboot grilled fruit..."
msgstr "不知道烤水果怎么样..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS"
msgid "Maybe I could plant them?"
msgstr "或许我可以把它们种起来？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s has raiding and looting on the brain..."
msgstr "%s 迷恋袭击和掠夺…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "What's with the fires lately, bud?"
msgstr "伙计，最近那些火是怎么回事？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC"
msgid "%s! Hey bud!"
msgstr "%s！嘿，伙伴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST"
msgid "With a heart you'll be feelin' like your mighty self in no time."
msgstr "有了心，你会很快感受到强大的自我。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Your spear versus my axe, let's see whatcha got, eh!"
msgstr "你的长矛对抗我的斧子，看看你有什么本领，嗯！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER"
msgid "I'm glad you're on our side, %s."
msgstr "很高兴你站在我们这边，%s。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT"
msgid "Pretty snappy looking."
msgstr "很时髦的样子。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER"
msgid "A good place to spit out your gum."
msgstr "吐出你嘴里的口香糖的好地方。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER"
msgid "%s'll end up on the wrong end of my axe if he's not careful..."
msgstr "要是 %s 不小心就会死在我斧子的另一端..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "You'll not want to be burning things, bud."
msgstr "伙计，你不会想要烧东西。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC"
msgid "Hey %s, how you doin' ya big hoser?"
msgstr "嘿 %s，你好吗？傻子？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST"
msgid "Lucy says I have to help you, %s. Let's get goin'."
msgstr "露西说我必须帮助你，%s。我们开始吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER"
msgid "Yer still a hoser! Now it's choppin' time!"
msgstr "你还是傻子一个。是时候砍砍砍了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER"
msgid "You're growin' on me, %s. Like a fungus."
msgstr "%s，你在对我施加影响。像真菌。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL"
msgid "Trees made into... paper? How unholy!"
msgstr "树做成…纸？好罪恶！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER"
msgid "Hey %s, can't we all just get a-log?"
msgstr "嘿，%s，我们不能每个人都拿一块木材吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER"
msgid "I better not see anymore fires, little buddy."
msgstr "小伙伴，最好不要再让我看到火了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s！嗨，小伙伴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST"
msgid "We better get you a heart, hey kiddo?"
msgstr "我们最好给你弄来一颗心，对吧小伙伴？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER"
msgid "'Luce gave me the go-ahead! You're in trouble now, %s!"
msgstr "露西叫我行动。%s，你现在有麻烦了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER"
msgid "You're an alright spider, kiddo."
msgstr "小家伙，你是一只好蜘蛛。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL"
msgid "The skull gives me the willies, too."
msgstr "这个头骨也让我心惊胆战。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Better small spiders than big, I suppose."
msgstr "小蜘蛛比大蜘蛛好，我猜。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER"
msgid "%s, I can't believe what I just SAW! Wait, no..."
msgstr "%s，我无法相信我刚看到的！等等，不…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER"
msgid "Should you be setting fires, little buddy?"
msgstr "小兄弟，你该点火了？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s！嗨，小伙伴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST"
msgid "With a heart you'll be tip-top in no time, %s."
msgstr "%s，有了心，你马上就可以达到巅峰了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER"
msgid "Hereeee's Woodie!"
msgstr "伍迪来了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER"
msgid "%s! You're doin' great, little buddy."
msgstr "%s！你做的很棒，小伙伴。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER"
msgid "%s could learn some manners..."
msgstr "%s 可以学点礼仪..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER"
msgid "Keep those flames away from my trees!"
msgstr "不要让那些火焰靠近树！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC"
msgid "%s! How ya doin', buddy?"
msgstr "%s！你好吗，小家伙？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST"
msgid "First we'll get you a heart, then we'll get you some bacon, eh %s?"
msgstr "我们先给你拿到心，然后给你一些培根，好吧%s？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER"
msgid "You're MIME now, %s!"
msgstr "%s，你现在哑口无言了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s，你是个好人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP"
msgid "Better than some of the things I've eaten!"
msgstr "比我吃过的一些东西要好！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER"
msgid "Damp."
msgstr "湿湿的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH"
msgid "Doesn't look useful, but I could be wrong."
msgstr "看起来没用，但我可能是错的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP"
msgid "I hope that doesn't end up hurtin' any lil critters."
msgstr "我希望这东西最后不会伤害任何小生物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s should read an etiquette book once in awhile."
msgstr "%s 应该偶尔看看关于礼仪的书。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Careful around those open flames, Ma'am."
msgstr "女士，请小心这些明火。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "%s. Ma'am."
msgstr "%s。女士。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You know where I can get a heart, %s?"
msgstr "%s，你知道哪里可以拿到心吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "This is gonna be a clear cut!"
msgstr "一切将会清楚！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "That's some good work ya did, Ma'am."
msgstr "女士，你做了点好事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER"
msgid "You're tempting a forest fire, %s..."
msgstr "%s，你在引发森林火灾…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Business as usual, I see."
msgstr "我看一切正常。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC"
msgid "Look who it is! %s!"
msgstr "看看是谁！%s！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST"
msgid "Just don't haunt anything while I look for a heart, %s."
msgstr "%s，我在找心的时候你不要捣乱。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER"
msgid "Here comes the wildfire!"
msgstr "野火来了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER"
msgid "You're on fire today, %s. No... actually."
msgstr "%s，今天你状态非常好。实际上...不是。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER"
msgid "You haven't been very gentlemanly lately, %s."
msgstr "%s，你最近不够绅士。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER"
msgid "Was that blaze some sort of experiment, %s?"
msgstr "%s，那场大火是某种实验吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC"
msgid "%s! Hey buddy!"
msgstr "%s！嘿，朋友！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST"
msgid "Someone should rub a heart on %s."
msgstr "应该有人擦下 %s 的心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER"
msgid "Enemy of the forest!"
msgstr "森林的敌人！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s，你是个好人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER"
msgid "%s is getting too big for her britches."
msgstr "%s 快穿不下她的裤子了."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s betrays the forest!"
msgstr "%s 背叛了森林!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC"
msgid "%s! Hey there bud!"
msgstr "%s！嘿，伙伴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST"
msgid "Yer looking a little pale, %s."
msgstr "你的脸色有点苍白，%s。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER"
msgid "You're on the chopping block now, %s!"
msgstr "%s，你现在就是砧板上的肉啦！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER"
msgid "I knew we were gonna get along."
msgstr "我就知道我们会相处得很好的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "哇！露西，小心点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "That's a right shame."
msgstr "令人扼腕啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Pretty odd looking gadget there."
msgstr "那玩意看着真古怪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "Just about dead."
msgstr "马上就没电了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Plum tuckered."
msgstr "油尽灯枯了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "哇！露西，小心点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "That's a right shame."
msgstr "令人扼腕啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Looks like Winona's work."
msgstr "看着像薇诺娜做的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Just about dead."
msgstr "马上就没电了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "Plum tuckered."
msgstr "油尽灯枯了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "哇！露西，小心点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "That's a right shame."
msgstr "令人扼腕啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Looks kinda fun if I'm honest."
msgstr "老实说看着挺好玩。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "Does it look like it's working, Lucy?"
msgstr "露西，这东西是在工作么？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "哇！露西，小心点！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.BURNT"
msgid "That's a right shame."
msgstr "令人扼腕啊。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Fine, as long as it don't start no forest fires."
msgstr "好吧，别点着山火就行。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Does it look like it's working, Lucy?"
msgstr "露西，这东西是在工作么？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT"
msgid "It's a nice toque, eh?"
msgstr "很不错的无边帽，是吧？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT"
msgid "The ones from home don't burn."
msgstr "我家乡的温度计就不会被烧坏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC"
msgid "We can build these half as tall back home."
msgstr "在家乡，我们只需要一半的刻度就够了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1"
msgid "It's a gingerbread lumberjack."
msgstr "是个华而不实的伐木工人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2"
msgid "Always had a soft spot for a good holiday cookie."
msgstr "好吃的节日饼干，我都喜欢。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3"
msgid "Satisfies the sweet tooth."
msgstr "满足喜欢甜食的人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4"
msgid "That thing just ain't right."
msgstr "那事就是不对。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5"
msgid "All the taste and none of the splinters!"
msgstr "所有的味道却没有碎片！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6"
msgid "Hard to complain aboot this whole \"Feast\" business."
msgstr "很难抱怨“盛会”这整件事。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7"
msgid "Doesn't fall far from the cider tree."
msgstr "不会从远离苹果树的地方掉下来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8"
msgid "Perfect for drinking next to a good fire, eh?"
msgstr "更喜欢坐在不错的火焰旁喝酒，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9"
msgid "Psst, Lucy. Do I have a 'nog moustache?"
msgstr "喂，露西，我的胡子像木垛一样吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT"
msgid "For hanging on the unchopped tree with care."
msgstr "挂在没有被劈砍的树上要小心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Y'know, I do believe that was worth it."
msgstr "你知道，我相信那是值得的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Kinda familiar eh, Lucy?"
msgstr "挺熟悉的，对吧露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "That's nice."
msgstr "很好看。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "What do you think, Lucy? Decorate, or chop?"
msgstr "你怎么想，露西？装饰一下或者砍掉？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING"
msgid "Such senseless violence."
msgstr "毫无意义的暴力行为。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "太糟糕了，让这地方感觉真安逸。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Must... not chop..."
msgstr "不能……劈砍……"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG"
msgid "All holidays should revolve around trees."
msgstr "所有的假日应该以树木为中心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "太糟糕了，让这地方感觉真安逸。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "I'm sure I have an extra pine cone somewhere."
msgstr "我确信我在其他地方还有一个松果。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s could be a bit more considerate..."
msgstr "%s 可以考虑得更加周全点…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Don't singe your moustache, %s."
msgstr "%s，别把胡子给点着了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC"
msgid "That's my buddy, %s! Hey!"
msgstr "%s，那是我的兄弟！嘿！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST"
msgid "C'mon, bud, let's get you on your feet."
msgstr "少来了，兄弟，让我们帮你重新站起来。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER"
msgid "You'll not strong arm me, %s!"
msgstr "%s，你无法很好地掩护我！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s has a big, squishy heart under those muscles."
msgstr "%s 的肌肉下有一颗大大柔软的心。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER"
msgid "%s isn't a true Canadian..."
msgstr "%s 不是真正的加拿大人…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER"
msgid "Been there, bud."
msgstr "伙伴，去过那里。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You're gonna have one monster headache after this, buddy."
msgstr "伙伴，你之后将会遇到怪兽纠缠。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Those fires are kind of counterproductive now, eh?"
msgstr "那些火现在有点在帮倒忙，额？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC"
msgid "%s! Fancy seeing another Canadian here."
msgstr "%s！真没想到会在这里看到另一个加拿大人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST"
msgid "Canadians gotta stick together, %s. Let's get a heart."
msgstr "加拿大人团结一致，%s。让我们拿到心吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER"
msgid "Hey, c'mere %s! I've gotta AXE you question!"
msgstr "嘿，来这里 %s。我有问题要问你！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER"
msgid "%s is a Canadian patriot, eh."
msgstr "%s 是个加拿大爱国者，额。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT"
msgid "Be wary of the moving ground."
msgstr "小心移动的地面。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT"
msgid "I know a plant when I see one. This's an impostor!"
msgstr "是不是植物，我一看就知道。这很明显是个冒充植物的家伙！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM"
msgid "WOOORM!"
msgstr "哇哦，蠕虫！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like a bum!"
msgstr "看起来像屁股！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN"
msgid "I'm not sure I want to look at that, eh?"
msgstr "我不确定自己是否真的想进去看看，你说呢？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED"
msgid "It smells a bit off, eh?"
msgstr "闻起来有点不是味儿，对吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT"
msgid "This thing will be useful."
msgstr "这东西应该会有用。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER"
msgid "Wrinklier than the underside of a beaver."
msgstr "比海狸的下面还要皱。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER"
msgid "Trust me, you ain't got the chops, %s."
msgstr "相信我, 就你那两把板斧不行的 %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER"
msgid "You better not burn any of my precious trees!"
msgstr "你可注意点别烧着了我宝贵的树木。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC"
msgid "%s, buddy, hey!"
msgstr "%s, 伙计, 你好啊!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST"
msgid "That soul sapper's lookin' like a real sap now."
msgstr "这下消停了吧。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER"
msgid "I'll hang those horns on the wall of my cabin!"
msgstr "我要把这对角挂在我柜子上面的墙上！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER"
msgid "That was mighty kind of you, %s."
msgstr "十分感谢你啊, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.ATTACKER"
msgid "%s is cruisin' for a bruisin'..."
msgstr "%s 在查看有没有擦伤…"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.FIRESTARTER"
msgid "You're gonna singe your chassis, %s."
msgstr "%s，你快要把自己的身躯烤焦了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GENERIC"
msgid "It's my metal buddy, %s!"
msgstr "%s，那是我的金属伙伴！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.GHOST"
msgid "Huh, I guess %s had a soul after all."
msgstr "哈！我想 %s 应该有灵魂。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.MURDERER"
msgid "It's time to power DOWN, %s!"
msgstr "%s，该关掉了！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WX78.REVIVER"
msgid "%s, you're an alright sort."
msgstr "%s，你是个好人。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWAMULET"
msgid "I could cut wood at night with this."
msgstr "有了这个东西，晚上我也可以砍树了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWGEM"
msgid "I can see the stars in it."
msgstr "我可以看到它里面有星星在闪。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWMOONEYE"
msgid "It's rude to stare."
msgstr "盯着人看是很没礼貌的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YELLOWSTAFF"
msgid "Useful in a pinch!"
msgstr "在紧要关头很有用！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD1"
msgid "Want some, Lucy?"
msgstr "要来点吗，露西？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD2"
msgid "Doesn't look to appetizing. Sorry."
msgstr "看起来不是让人很有胃口。对不起。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTP_FOOD3"
msgid "I don't need nothin' fancy."
msgstr "我不需要花里胡哨的食物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_GENERIC"
msgid "What's that, eh?"
msgstr "那是什么，嗯？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_SMOLDERING"
msgid "It's aboot to go up in flames, eh?"
msgstr "它要烧起来了，是吗？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE_TOODARK"
msgid "It's too dark, eh!"
msgstr "额，太暗了！"

#. STRINGS.CHARACTERS.WOODIE.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WOODIE.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "You can taste the beak, eh?"
msgstr "你可以尝出鸟嘴的味道，对吗？"

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_LOSE"
msgid "It's over for us, eh."
msgstr "呃，我们完了。"

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Too long on the fire."
msgstr "火上烧得太久了。"

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Guess those ingredients don't go together."
msgstr "那些配料的味道看来不相配。"

#. STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WOODIE.QUAGMIRE_ANNOUNCE_WIN"
msgid "We done did it."
msgstr "我们做到了。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Am I locked out, or in?"
msgstr "我是被锁在外面，还是里面呢？"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "My body would surely die."
msgstr "我的肉身肯定会死去。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.BUILD.HASPET"
msgid "I've made my pact with a beast already."
msgstr "我已经和一个野兽定下了契约。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.BUILD.MOUNTED"
msgid "Either I must get down, or the world must come up."
msgstr "要么我下去，要么世界上来。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.BURNING"
msgid "I'm not big on clothes, anyway."
msgstr "反正我也不在意服饰。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "I prefer my current form."
msgstr "我更喜欢我现在的样子。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CHANGEIN.INUSE"
msgid "Another soul has use of it right now."
msgstr "另一具灵魂正在使用中。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "I can't create from nothing."
msgstr "巧妇难为无米之炊"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "Another soul has use of it right now."
msgstr "另一具灵魂正在使用中。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "I've made an error."
msgstr "我犯了个错误。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "Oh I simply couldn't."
msgstr "在下办不到。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.GENERIC"
msgid "I'd rather snack on a soul no one's using."
msgstr "我还是吃一个没人在用的灵魂比较好。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.INUSE"
msgid "Mortals need physical food more than I do."
msgstr "凡人们比我更需要实体食物。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.COOK.TOOFAR"
msgid "I could hop over, I suppose."
msgstr "好吧，我应该可以跳过去。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.DRAW.NOIMAGE"
msgid "I have no imagination."
msgstr "我没有想象力。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "This soul's already been sucked! Hyuyu!"
msgstr "哎呀！魂已经被勾走了！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.BUSY"
msgid "I will try again at a different point in time."
msgstr "等换个时间再试试。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "Its soul is prevented from returning here."
msgstr "灵魂遇到了障碍，不能归来。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.DEAD"
msgid "Their soul's not in right now."
msgstr "他们的魂魄还没回来。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We cannot learn what we already know!"
msgstr "已经知道了，不用再学了。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.FOODFULL"
msgid "There's already a dish, and it looks delish!"
msgstr "已经有一盘菜了，看起来很美味！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.GENERIC"
msgid "No, no, no."
msgstr "不，不，不。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "There's no body for it to return to."
msgstr "找不到让它能返回的身体。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "Its tummy rumbles for the soul of a log."
msgstr "它的肚子咕咕叫，想吃木头的灵魂。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "There is only room... for a 'shroom!"
msgstr "只能容纳一颗蘑菇。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOMOON"
msgid "The light of the moon, I hope it comes soon!"
msgstr "希望月光早点出来！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTDISH"
msgid "It would be in our best interest to not."
msgstr "考虑到我们的利益，还是不要比较好。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTGEM"
msgid "It couldn't fit if it wanted to!"
msgstr "就算它想，也不合适啊！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "I do not think so, no no no!"
msgstr "不行，就不行！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "That's quite wrong, yes, yes!"
msgstr "没错，没错，这就是个错误！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "Our souls are in mortal danger right now!"
msgstr "我们的灵魂处于极大的危险中！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "This beautiful chaos inhibits me."
msgstr "这团美丽的混乱不许我这么做。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "The night is upon us!"
msgstr "黑夜降临了！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.SLEEPING"
msgid "Their mind inhabits another plane right now."
msgstr "他们的心智现在位于另一个世界。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.SLOTFULL"
msgid "It is full already."
msgstr "已经满了。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.WRONGGEM"
msgid "Its color is wrong, wrong, wrong."
msgstr "颜色不对，不对，不对。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "It looks downright silly, hyuyu!"
msgstr "哎呀，看着很傻！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "First I must gain their focus."
msgstr "首先，我必须成为他们注意的焦点。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "Their soul's not in right now."
msgstr "他们的魂魄还没回来。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "Their brim is bursting!"
msgstr "他们收不下了！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Their mind inhabits another plane right now."
msgstr "他们的心智现在位于另一个世界。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "First I must gain their focus."
msgstr "首先，我必须成为他们注意的焦点。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "Their soul's not in right now."
msgstr "他们的魂魄还没回来。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "Their brim is bursting!"
msgstr "他们收不下了！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Their mind inhabits another plane right now."
msgstr "他们的心智现在位于另一个世界。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.MOUNT.INUSE"
msgid "It has made a pact with another."
msgstr "它已经和其他人制定了契约。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "Its focus is elsewhere."
msgstr "它注意的焦点在别的地方。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.INUSE"
msgid "Another soul has use of it."
msgstr "另一具灵魂正在使用中。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I am cautious about touching it."
msgstr "要碰它么？还是谨慎点好。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "That is incorrect!"
msgstr "这不对！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Hyuyu! They all look the same to me!"
msgstr "嗯，在我看来这些都一个样。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I cannot redo what's already been done!"
msgstr "在下做不到啊！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Oh I simply couldn't."
msgstr "在下办不到。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.INUSE"
msgid "It is making a pact with another."
msgstr "它已经和其他人制定了契约。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
msgid "Its focus is elsewhere."
msgstr "它注意的焦点在别的地方。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.AWAKEBEEFALO
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.AWAKEBEEFALO"
msgid "I may only do that while it sleeps."
msgstr "我要等它睡着了才敢去给它刮。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.GENERIC"
msgid "I can't, I won't, I shan't."
msgstr "不能，不要，就不。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.NOBITS
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.NOBITS"
msgid "Instead of hair, there's nothing there!"
msgstr "除了一堆毛，别的什么都没。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.GENERIC"
msgid "It's full, full, full."
msgstr "满了，满了，满了。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.INUSE"
msgid "Another soul has use of it right now."
msgstr "另一具灵魂正在使用中。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.STORE.NOTALLOWED"
msgid "Oh I simply couldn't."
msgstr "在下办不到。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.CANTLEARN
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.CANTLEARN"
msgid "My poor imp head cannot contain this knowledge."
msgstr "我可怜的小脑瓜装不下这么多知识。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.KNOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.KNOWN"
msgid "You cannot learn what you already know."
msgstr "已经知道了，不用再学了。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.WRONGWORLD
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.TEACH.WRONGWORLD"
msgid "I'm on the wrong plane of existence for this."
msgstr "在这个世界这样行不通。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.UNLOCK.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.UNLOCK.WRONGKEY"
msgid "Either the key is wrong, or the lock is."
msgstr "要么是钥匙错了，要么是锁不对。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.KLAUS"
msgid "Hyuyu!"
msgstr "哼！"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "I believe there is another way."
msgstr "肯定还有别的路。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Either the key is wrong, or the lock is."
msgstr "要么是钥匙错了，要么是锁不对。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I need something to bind within."
msgstr "我需要一些捆绑材料。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.GENERIC"
msgid "What is written cannot be unwrote!"
msgstr "既已写下的东西再也不能抹去。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.INUSE"
msgid "Someone else has command of it."
msgstr "有其他人在用。"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL_GENERIC"
msgid "No, no, no."
msgstr "不，不，不。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT"
msgid "I feel excellent about myself!"
msgstr "我好优秀！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "I've done the thing!"
msgstr "我做到了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ADVENTUREFAIL"
msgid "I've had enough plane hopping."
msgstr "够了，不要再穿梭在不同的世界了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Tremors and trembles!"
msgstr "震动，抖动！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Crumbles and cracks!"
msgstr "崩塌，碎裂！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "Seismic shivers, seismic shakes!"
msgstr "地震了，大地在摇晃！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Tidings and tithings to you!"
msgstr "请接受我的献礼吧！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Chin up!"
msgstr "下巴抬起来！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "Gifts all around! Or for you, at least."
msgstr "到处都是礼物！都是给你的。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BECOMEGHOST"
msgid "ooOooooO!"
msgstr "呜～呜～呜！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BEES"
msgid "Fiddle dee dee, HERE COMES A BEE!"
msgstr "小蜜蜂，嗡嗡嗡！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOOMERANG"
msgid "Hyuyu!"
msgstr "哼！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BRAVERY_POTION"
msgid "Okay, let's play!"
msgstr "好吧，咱们来玩玩！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BURNT"
msgid "Too hot for my impish paws!"
msgstr "烫着我的赤焰魔爪了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANFIX"
msgid "\nI could restore it."
msgstr "我能修好它。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN"
msgid "I'd best hop on out of here!"
msgstr "我最好还是跳离这里！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE"
msgid "What manner of imp was that??"
msgstr "那是什么形态的恶魔？？"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK"
msgid "OWIE-HEE-HEE!"
msgstr "嗷-额-啊！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD"
msgid "It's finally frozen over!"
msgstr "终于冻住了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT"
msgid "My compass has pass-ed out!"
msgstr "我的指南针晕过去了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL"
msgid "My hands are truly cursed."
msgstr "我这手是真的被诅咒了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP"
msgid "The world is giving me a shower!"
msgstr "这个世界在给我洗淋浴！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS"
msgid "Clipping and clopping, here comes a stomping!"
msgstr "滴沥咣当，大鹿要跺脚了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN"
msgid "Hyuyu, fare thee well!"
msgstr "哼，再见了您！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "I've helped it!"
msgstr "我帮助了它！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK"
msgid "The night soon approaches. Hyuyu!"
msgstr "夜幕马上就要降临了。哼！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC"
msgid "Mmm! Soul free!"
msgstr "嗯！没有灵魂！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID"
msgid "Not even I could eat that."
msgstr "我都下不了口啊。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL"
msgid "Ouch! Hyuyu!"
msgstr "嗷！哼！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED"
msgid "Blech! At least souls never spoil."
msgstr "额！好吧，至少灵魂永远不变质。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE"
msgid "How unpleasant!"
msgstr "真讨厌！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY"
msgid "I'd rather eat my own tail!"
msgstr "我宁愿吃自己的尾巴！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1"
msgid "Huff... puff..."
msgstr "呼...呼..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2"
msgid "Hoof..."
msgstr "唔..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3"
msgid "What... a terrible burden..."
msgstr "真是个可怕的负担..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4"
msgid "Hyu... yu... yu...."
msgstr "哞..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5"
msgid "Hff!"
msgstr "呵！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6"
msgid "Imps were not... made for this!"
msgstr "怎么能让我一个恶魔来弄这个呢！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7"
msgid "Puff... huff..."
msgstr "呼...呼..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK"
msgid "I've been banished to the darkness plane!"
msgstr "我被放逐到了黑暗的世界！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT"
msgid "I return to this plane of existence!"
msgstr "我回到了这个存在的世界！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT"
msgid "I've lost a fan!"
msgstr "我又失去了一把扇子！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM"
msgid "I am unbound!"
msgstr "我挣脱了束缚！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN"
msgid "Ghosts play... strange games..."
msgstr "鬼魂玩的游戏真古怪..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH"
msgid "My brain's grown three sizes this day!"
msgstr "我的大脑今天膨胀了三倍！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT"
msgid "Hot, hot, hot!"
msgstr "热热热！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS"
msgid "The beasts are baying!"
msgstr "野兽在咆哮。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY"
msgid "Oh no, I'm hungry again."
msgstr "哎呦喂，我怎么又饿了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I love a game of hide and seek!"
msgstr "我太喜欢捉迷藏了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "You win this round!"
msgstr "这轮你赢了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Sabotaged by this realm's mushiness."
msgstr "这个世界软绵绵的，破坏了我的大计。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It needs some plant food."
msgstr "需要一点植物食品。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL"
msgid "I only have two paws."
msgstr "我只有两只爪子。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Well that's no fun, friend!"
msgstr "朋友，那一点都不好玩！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to hop out of here!"
msgstr "是时候跳出去了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Shall we dance?"
msgstr "可以请你跳支舞吗？"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT"
msgid "Oh, good morning!"
msgstr "哦，早上好！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Hyuyu! Can't catch me!"
msgstr "哼！你抓不到我！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very enlightening."
msgstr "没什么启发性。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS"
msgid "Mosquitos! Do I even have blood??"
msgstr "蚊子！我身体里有血吗？？"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Its soul hangs by a thread."
msgstr "它的灵魂悬于一线。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERAFK"
msgid "I am in grave danger right now!"
msgstr "我的处境极其危险！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT"
msgid "Presents later, playtime now!"
msgstr "礼物等会再说，现在是游戏时间！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA"
msgid "Why sleep when there's fun afoot?"
msgstr "有好玩的还睡什么觉？"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP"
msgid "Who could sleep when there's fun to be had?"
msgstr "都知道了有好玩的，谁还能睡得着？"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP"
msgid "I wouldn't want to mess up my sleep schedule."
msgstr "我不要打乱规律的作息时间。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "身处地下，必须时刻警惕。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'm too soul-famished to siesta."
msgstr "灵魂过度饥饿，难以小憩。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too soul-famished to sleep."
msgstr "灵魂过度饥饿，难以入眠。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I must depart this sweet beast first."
msgstr "暂且作别这只甜蜜的野兽。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA"
msgid "No honorable imp would siesta at night."
msgstr "我这么有荣誉感，怎么会在夜晚小憩呢。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "身处地下，必须时刻警惕。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "莫要烧焦了我的皮草。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "莫要烧焦了我的皮草。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP"
msgid "Can't catch me!"
msgstr "哼！你抓不到我！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED"
msgid "But why!"
msgstr "但为什么呢!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are playing a funny prank!"
msgstr "这些树木的恶作剧真有意思。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Its soul has not left its body, yet still it stinks."
msgstr "它的灵魂还没离开身体，但闻起来还是很臭。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE"
msgid "Shiver and shake, that's a quake!"
msgstr "在抖，在晃，地震了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH"
msgid "My mind has expanded!"
msgstr "思维更开阔了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "The imp returns!"
msgstr "我牛汉三又回来了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Up and at'em!"
msgstr "起来，都给我起来！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE"
msgid "C'mon back, silly goose."
msgstr "回来，你这只蠢鹅。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER"
msgid "Ah, much better!"
msgstr "啊，好多了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED"
msgid "I've been bound!"
msgstr "我被困住了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED"
msgid "I AM DRENCHED!"
msgstr "我湿透了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1"
msgid "Woe be to a soul-starved imp!"
msgstr "用光了灵魂的恶魔将要遭遇不幸！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2"
msgid "I don't want to suck anymore souls!"
msgstr "我不想再吸取更多的灵魂了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3"
msgid "What gruesome things I must do to live!"
msgstr "为了生存，我要做多么可怕的事情！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1"
msgid "I'll need more souls soon."
msgstr "灵魂不多了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2"
msgid "I feel the soul hunger stirring."
msgstr "我感到了对灵魂的渴望。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1"
msgid "I've enough souls to sustain me."
msgstr "灵魂够多了，可以生存下去了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2"
msgid "I hope I was not too greedy."
msgstr "这不算太贪婪吧。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1"
msgid "I can't handle that much soul power!"
msgstr "我驾驭不了那么多的灵魂力量！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2"
msgid "That was one soul too many!"
msgstr "太多灵魂了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED"
msgid "What a s-silly prank!"
msgstr "好蠢的恶作剧！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS"
msgid "It pricked me!"
msgstr "扎到我了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED"
msgid "It's gone home."
msgstr "它跑回家了。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING"
msgid "Don't flee! Play with me!"
msgstr "别跑！跟我玩！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP"
msgid "Whoops-a-doodle, hyuyu!"
msgstr "跑的真快啊，哼哼！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT"
msgid "Farewell, sweet flame!"
msgstr "再见了，甜蜜的火焰！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Never fear, the imp is here!"
msgstr "别害怕，老牛在此！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oh dear, oh dear."
msgstr "哎呀，哎呀。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED"
msgid "What on earth could it be!"
msgstr "究竟会是什么东西呢！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET"
msgid "There is wet imp smell in my future."
msgstr "湿哒哒的将来会不会有霉味。"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER"
msgid "I am the soggiest imp!"
msgstr "成落汤鸡了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE"
msgid "Hyuyu, how grotesque that was!"
msgstr "哼，太丑了！"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS"
msgid "Something approaches from beneath!"
msgstr "下面有东西在接近！"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER"
msgid "You look like fun, dear."
msgstr "亲爱的，你看起来很好玩。"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC"
msgid "Let's have some fun."
msgstr "来玩玩吧。"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG"
msgid "Dance with me, piggy pig!"
msgstr "小猪，来跳支舞吧！"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY"
msgid "I want to play!"
msgstr "我想玩！"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER"
msgid "Let's play, let's play!"
msgstr "来玩吧，来玩吧！"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR"
msgid "Do you dance?"
msgstr "你跳舞么？"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC"
msgid "I am the wimp imp!"
msgstr "本牛好弱鸡！"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG"
msgid "Nevermind, I've forgotten my dancing shoes."
msgstr "算了，我忘带舞鞋了。"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY"
msgid "You no longer entertain me."
msgstr "不跟你玩了。"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER"
msgid "I am the wimp imp!"
msgstr "本牛好弱鸡！"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "I'll take my leave. Hyuyu!"
msgstr "俺老牛去也。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL"
msgid "Poor soul."
msgstr "可怜的灵魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "I think it eats souls, too."
msgstr "估计它也吃灵魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Ohh, you're hungry too."
msgstr "哦，你也饿了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Sadly, it is not mine to keep."
msgstr "可惜，不是我的，不能留。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It's very sad. Full of regrets."
msgstr "非常伤感，充满遗憾。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "Waking up, are we?"
msgstr "咱们是醒着的吧？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It seems the fun will soon begin."
msgstr "好玩的马上就要来了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I did indeed do that!"
msgstr "的确是我干的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN"
msgid "It's nutty, like me!"
msgstr "坚果啊，像我一样坚强！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED"
msgid "I'll only eat it if I have to."
msgstr "没得选我才会吃这玩意。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING"
msgid "You know how to grow!"
msgstr "你长得还挺快的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL"
msgid "I want to play a game with you!"
msgstr "想跟你玩个游戏！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET"
msgid "A glimmering jewel that's rife with life."
msgstr "充盈着生命的闪烁珠宝。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR"
msgid "A fun place to do some naughty magic."
msgstr "施展淘气魔法的好地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Oh dear oh dear, that will not do."
msgstr "哎呀，哎呀，那不行的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE"
msgid "Hyuyu, how spooky!"
msgstr "哼，好阴森！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK"
msgid "Those aren't my hoofprints!"
msgstr "这些不是我的蹄印子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC"
msgid "You need only tell me what you desire."
msgstr "你只需要告诉我你想要什么。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY"
msgid "Apologies, dear beast! I am but a worm!"
msgstr "抱歉，亲爱的野兽！我只是一只虫子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Are you not pleased, my friend?"
msgstr "我的朋友，你不高兴吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET"
msgid "Better get a bucket!"
msgstr "有只桶会比较好！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY"
msgid "Ooo, I've always wanted to be scaly."
msgstr "哦，我也一直想批鳞带甲。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS"
msgid "Protect oneself with a swish and a wish!"
msgstr "吹口气，许个愿，保护自己！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE"
msgid "Stone cold!"
msgstr "石头般冰冷！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS"
msgid "This thulecite sure is a delight!"
msgstr "铥矿真是个好东西！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON"
msgid "This fashion's all the rage... it's an external rib cage!"
msgstr "充满了愤怒的时尚风格，肋骨架霸气外露！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER"
msgid "If it means I eat less often, count me in!"
msgstr "如果能让我少吃点，我肯定愿意！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL"
msgid "Little bits of snurtle, yes."
msgstr "圆壳蜗牛的壳，嗯。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD"
msgid "Knock on wood, they say, they say!"
msgstr "敲敲木头，他们说会有好运！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY"
msgid "Keeps the flesh body safe! The mind's another story."
msgstr "能保护肉身！心灵的话就不知道了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "A silly prank to be sure."
msgstr "绝对是个愚蠢的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "我走那条路都没区别！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "恐怕这什么"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "A silly prank to be sure."
msgstr "绝对是个愚蠢的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "我走那条路都一样！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "恐怕这里没什么好看的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC"
msgid "Cinders, cinders, cinders."
msgstr "炉灰，炉灰，炉灰。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The planar hop has destroyed this bone!"
msgstr "空间跳跃毁坏了这块骨头！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The planar hop has destroyed this flower!"
msgstr "空间跳跃毁坏了这朵花！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "It could not exist on this plane."
msgstr "它在这个空间不能存活。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Oh, we're going to have some fun!"
msgstr "哦，我们能好好玩玩了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Playtime's over."
msgstr "游戏时间结束。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Hyuyu, it's getting weird!"
msgstr "哼，越来越奇怪了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF"
msgid "The thing I hopped through!"
msgstr "曾经跳跃穿过这东西！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's how you get imps. Hyuyu!"
msgstr "恶魔就是这样来的。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY"
msgid "An imp could do mischievous things with this."
msgstr "有了这个就可以恶作剧了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I'm not sure how to play with this."
msgstr "不知道这个怎么玩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Ooo, it turned on!"
msgstr "喔，开了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Ooo, there's some naughty magic at play here!"
msgstr "喔，这里流淌着顽皮的魔法！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A bunch of mortals. They look very bored."
msgstr "一群凡夫俗子。看着无所事事。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "There's some magic residue on the stone. Not much else."
msgstr "石头上残留了些魔法，除此之外，别无他物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Ooo, it's about to get good!"
msgstr "哦，要变得有趣了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "What a hoot! The mortals are slithering out their skins!"
msgstr "真好笑！凡人们像蛇一样在爬行！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "They probably shouldn't have used that much magic."
msgstr "本不该施这么多魔法的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE"
msgid "Hyuyu, did you lose a game?"
msgstr "哼，你输了一场游戏吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE"
msgid "To whack and to chop."
msgstr "能劈也能砍。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "It belongs with its momma."
msgstr "它应该跟妈妈待在一起。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Sleep softly sweet soul."
msgstr "温柔的入睡吧，甜美的灵魂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK"
msgid "Behold this burden on my back!"
msgstr "瞧瞧我背上的负担！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS"
msgid "A mortal favorite."
msgstr "凡人们的最爱。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON"
msgid "I often feel like I might float away. Hyuyu!"
msgstr "我总觉得自己随时要飘走。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY"
msgid "Stores one's breath for later spells."
msgstr "呼吸储存器。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE"
msgid "A wrap for wounds."
msgstr "用于包扎伤口。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT"
msgid "Big, big rock, for sure, for sure."
msgstr "真是一块大石头啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT"
msgid "I'm quite batty myself! Hyuyu!"
msgstr "我也跟蝙蝠一样古怪！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT"
msgid "Extra batty!"
msgstr "更加古怪！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE"
msgid "Where the bats lie in wait."
msgstr "蝙蝠们伺机而动的地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING"
msgid "Look at that! The wing of a bat."
msgstr "看啊！蝙蝠翅膀。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED"
msgid "Perhaps I'll find a hungry mortal to give it to."
msgstr "兴许能碰着个饿了的凡人以后送给他。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR"
msgid "Mortal fur."
msgstr "凡人的皮草。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER"
msgid "Do not eat me, oh please, oh please!"
msgstr "别吃我，求你了，求你了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST"
msgid "Sometimes you want to wear someone else's fur."
msgstr "有时候你想穿穿其他人的皮草。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR"
msgid "You won't be eating me today!"
msgstr "你今天吃不了我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY"
msgid "Fur upon fur!"
msgstr "皮草上面加皮草！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW"
msgid "To lay my sweet little head down."
msgstr "可以把头轻轻的躺下。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC"
msgid "Buzz buzz buzz, tiny bee!"
msgstr "小蜜蜂，嗡嗡嗡！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD"
msgid "Careful now, little mortal."
msgstr "当心了，小小的凡人。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT"
msgid "Mayhaps it's caramelized within!"
msgstr "也许里面变成焦糖了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "好多蜂蜜！这下凡人们要乐坏了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC"
msgid "A box full of bees would make a great prank."
msgstr "装一盒子的蜜蜂，然后来个伟大的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY"
msgid "Nothing inside but bees, oh yes!"
msgstr "太好了，里面全是蜜蜂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "好多蜂蜜！这下凡人们要乐坏了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "We could scrape a bit of honey out."
msgstr "我们可以挖点蜂蜜出来。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I believe we've made a friend!"
msgstr "交到了朋友！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Hyuyu! Are we playing follow the leader?"
msgstr "哼！我们是在玩跟随领袖的游戏么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC"
msgid "Hello, hello, dear beefalo!"
msgstr "你好，你好，亲爱的牦牛！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED"
msgid "Hyuyuyu! That's too good!"
msgstr "哼！太好了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY"
msgid "Don't you feel just hopping mad?"
msgstr "你在疯狂蹦跶什么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY"
msgid "It's soul is chubby too, hyuyu!"
msgstr "它的灵魂也肥肥的吧，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER"
msgid "Don't you want to carry me?"
msgstr "你难道不想驮着我么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING"
msgid "Shhh."
msgstr "嘘。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT"
msgid "Horn replacements."
msgstr "可以用这个取代牛角。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL"
msgid "Ex-beefalo."
msgstr "前牦牛。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD"
msgid "Beeee gentle with me!"
msgstr "温柔待我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT"
msgid "What if my horns get stung?"
msgstr "我的牛角被叮了怎么办？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE"
msgid "One swift kick and it becomes a great prank."
msgstr "快速的踢一脚，就是一个很棒的恶作剧了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE"
msgid "This will be a funny prank."
msgstr "会是一个好玩的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL"
msgid "That's not a funny prank at all!"
msgstr "那个恶作剧一点不好玩！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN"
msgid "Tweeheehe! You're a big bee!"
msgstr "呵呵！你是只大蜜蜂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "My hooves would get stuck in it."
msgstr "我的牛蹄子会卡在里面。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Ooo, a new mystery!"
msgstr "喔，一个新的谜题！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "The mystery grows!"
msgstr "谜题在长大！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX"
msgid "None of mine!"
msgstr "蜂蜡与我无关！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR"
msgid "My oh my, you're a big guy!"
msgstr "哎呀呀，你是个大家伙！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL"
msgid "I believe it might bring forth delight."
msgstr "应该能带来快乐。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL_BLUEPRINT"
msgid "What might it make? Oh let us see!"
msgstr "能做出什么？我们来看看！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE"
msgid "Good sir, are you aware you've no soul?"
msgstr "这位先生，你知道自己没有灵魂吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He seemed a fine chap."
msgstr "曾经是个好小伙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "What a pity."
msgstr "真可惜啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES"
msgid "A handful of mortal treats."
msgstr "凡人们的美味佳肴。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED"
msgid "I hear they last longer this way."
msgstr "听说这么处理可以保存的久一点。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY"
msgid "Mortals eat them as a snack."
msgstr "发明人们把它们当零食吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I hear they last longer this way."
msgstr "听说这么处理可以保存的久一点。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN"
msgid "It won't be returning to this plane."
msgstr "它不会再回这个世界了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING"
msgid "Whoops-a-doodle."
msgstr "哎呀呀。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Now it stinks really good!"
msgstr "闻着有阵阵恶臭！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It's started to stink."
msgstr "开始发臭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Mortals say they're sweet to eat."
msgstr "凡人们说这些吃起来很甜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Feeling down, are you?"
msgstr "感觉有点失落，你呢？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Salted earth, none will return."
msgstr "土地盐碱化，什么也长不出了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Whoops-a-doodle."
msgstr "哎呀呀。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Now it stinks really good!"
msgstr "闻着有阵阵恶臭！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It's started to stink."
msgstr "开始发臭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The humans like them, yes indeed."
msgstr "人类的确喜欢这些。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Feeling down, are you?"
msgstr "感觉有点失落，你呢？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT"
msgid "Do not step on little old me!"
msgstr "可别踩到本宝宝了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE"
msgid "Tiny forest children of hate!"
msgstr "微小的森林之子，充满仇恨！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD"
msgid "It seems you went and met your end."
msgstr "逝者如斯夫，不舍昼夜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC"
msgid "A place where little birds are penned."
msgstr "囚禁小鸟的牢笼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "No worries, lunch is right around the bend."
msgstr "不着急，午餐马上就要有了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Hello my singing, feathered friend."
msgstr "你好啊，挥着翅膀的歌唱家朋友。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON"
msgid "I don't think she's exactly on the mend."
msgstr "她身体没有要好转的迹象。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "No more sleepless nights you'll spend."
msgstr "不会再让你失眠了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING"
msgid "Does no one have some seeds to lend?"
msgstr "有没有人能借点种子给我？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP"
msgid "The birds will find this so funny!"
msgstr "鸟儿们看到会觉得很好玩的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG"
msgid "An egg from a bird, or so I've heard."
msgstr "一颗鸟蛋，反正我听说是。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED"
msgid "Probably a mortal thing."
msgstr "凡人们也许爱吃吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP"
msgid "You sure look mean, you nasty fiend!"
msgstr "你看着很凶啊，你这个糟糕的小鬼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Hyuyu! Owie!"
msgstr "哼！嗷！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "咦！别跟我胡来！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE"
msgid "Ptt!"
msgstr "噗！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA"
msgid "A gust of breath means flaming death!"
msgstr "一口气就吹出来燃烧的死亡。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2"
msgid "A gust of breath means flaming death!"
msgstr "一口气就吹出来燃烧的死亡。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "卟突！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP"
msgid "Pph!"
msgstr "噗！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW"
msgid "Prrp!"
msgstr "嗤！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET"
msgid "The cold won't get through my chest tuft, hyuyu."
msgstr "冷风穿不过我的胸毛，哼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM"
msgid "Somber blue from seabeds grew."
msgstr "海床上长出的忧郁深蓝。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE"
msgid "It's visible from any nook or crook."
msgstr "每个角落都能看到。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT"
msgid "What might it make? Oh let us see!"
msgstr "能做出什么？我们来看看！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP"
msgid "Funny tricks it tries to play."
msgstr "它还想玩个可笑的把戏。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED"
msgid "That changed it somehow."
msgstr "似乎改变了它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Found you!"
msgstr "找到你了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "它在玩捉迷藏！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS"
msgid "It's a board. How untoward!"
msgstr "就是块木头。真没劲！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON"
msgid "Who invited a pig to this shindig?"
msgstr "谁请了头猪来？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR"
msgid "Catch me if you can!"
msgstr "能抓住我就来！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD"
msgid "Fragmented, like my thoughts!"
msgstr "支离破碎，如同我的思绪！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW"
msgid "Mortals like drinking goop like this."
msgstr "凡人们就喜欢喝这种粘稠的东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS"
msgid "Humans share their knowledge so freely."
msgstr "人类如此自由的分享着知识。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE"
msgid "Who would leave such precious knowledge lying here?"
msgstr "这么宝贵的知识，是谁丢在这的？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL"
msgid "Well, it won't summon an imp!"
msgstr "好吧，召唤不出恶魔！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL"
msgid "Rock their socks off."
msgstr "万千生灵都做了土。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING"
msgid "Secret knowledge of vegetables."
msgstr "蔬菜的秘密知识。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP"
msgid "Knowledge is power. Literally."
msgstr "知识就是力量。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES"
msgid "Imps don't disseminate precious knowledge so carelessly."
msgstr "宝贵的知识啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG"
msgid "What goes around comes around, they say, they say!"
msgstr "扔出去还能飞回来。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH"
msgid "Keeps imp chest tufts plush."
msgstr "用来梳理我有型的胸毛。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET"
msgid "I'll bind those bugs."
msgstr "我会逮住那些虫子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE"
msgid "Does a nice surprise await inside?"
msgstr "里面是不是有惊喜等着我？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP"
msgid "Bind all cursed objects!"
msgstr "抓住所有被诅咒的物体！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN"
msgid "You hop just like me!"
msgstr "你跳的跟我一样！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Farewell, little bristles."
msgstr "再见了，以后不会扎到人了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT"
msgid "Now you see me, now you don't! Hyuyu!"
msgstr "戴上这个你就看不见我了吧！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER"
msgid "Essence of slipperiness."
msgstr "滑滑的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter, flutter, dearest butter!"
msgstr "爽滑的黄油！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD"
msgid "I'll try not to suck your soul out."
msgstr "我努力不把你的魂勾出来。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Muffin to see here, my dear."
msgstr "松饼啊，亲爱的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS"
msgid "Fly away, sweet soul."
msgstr "飞走吧，可爱的灵魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD"
msgid "It doesn't want to feed on death. It just has to."
msgstr "你以为它想吃腐肉，它别无选择。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC"
msgid "Spiny and mean, just how I like them."
msgstr "锋利的尖刺，就喜欢这样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED"
msgid "To pick a cactus, you just need some prac-tus!"
msgstr "采摘仙人球需要点手艺的!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER"
msgid "How pretty! I fear to touch it."
msgstr "真美！可远观而不可亵玩焉。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT"
msgid "I don't want to eat anything prickly."
msgstr "我不想吃带刺的东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "The prickles are gone, but I still don't want to eat it."
msgstr "虽然没刺了，但是我还是不想吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "马上就熄灭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "这团火能满足我对温暖的渴望。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH"
msgid "Those are some spicy flames."
msgstr "熊熊烈火。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "火越来越小了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "营火给我家的温暖。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT"
msgid "And out it goes."
msgstr "火焰熄灭。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC"
msgid "Let's look out for each other, you and I."
msgstr "你和我咱们相互照顾吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD"
msgid "Mind my paws now."
msgstr "当心我的利爪。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED"
msgid "Mortals don't usually look like that."
msgstr "凡间的动物一般不长这样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG"
msgid "It's a Wortox Sack!"
msgstr "这是我的专属包！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE"
msgid "Is it walking me, or am I walking it?"
msgstr "是我在拄拐杖，还是拐杖在拄我？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT"
msgid "Non-imps like to eat things like this."
msgstr "非恶魔族的都喜欢吃这个。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED"
msgid "I think non-imps like it better cooked."
msgstr "非恶魔族的更喜欢做熟吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED"
msgid "There's a plant underneath."
msgstr "下面有颗植物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "春种一粒粟，秋收万颗子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Someone's been up to some mischief."
msgstr "有人在闹鬼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "That's all she wrote."
msgstr "写的东西全烧了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I could make maps to anywhere and nowhere."
msgstr "我能制作出任何地方，任何世界的地图。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON"
msgid "I prefer playing with smarter mortals."
msgstr "我喜欢和聪明点的凡间生物玩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Yoohoo! Anybody home?"
msgstr "你好！家里有人吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC"
msgid "A home for friends."
msgstr "友人之家。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT"
msgid "It's a stripey horn concealer."
msgstr "条纹款的，能遮住牛角。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I could move it if I pleased!"
msgstr "我想搬就能搬动！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "A hop, skip and a jump too far!"
msgstr "蹦，跳，跃，太远了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA"
msgid "One of the least offensive mortal food flavors."
msgstr "可以说是最容易接受的凡间食品了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I don't think anyone wants it now."
msgstr "成这样估计没人要了吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED"
msgid "It's cooked now."
msgstr "做熟了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE"
msgid "What do I see? An underground tree!"
msgstr "我看到什么了？地下居然长出了树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE"
msgid "Clear the way I say!"
msgstr "给我开路！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "A party rages down below!"
msgstr "下面热闹着呢！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "No spelunking for this little imp!"
msgstr "宝宝可不想洞穴探险！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Away I go, hyuyu!"
msgstr "我走了，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Let me have a peek inside!"
msgstr "我往里面瞧一眼吧..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL"
msgid "A party rages up above!"
msgstr "上面热闹着呢！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I like it here in the deep dark."
msgstr "我喜欢漆黑一片。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Away I go, hyuyu!"
msgstr "我走了，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN"
msgid "It prefers the dark."
msgstr "黑暗的环境非常适合它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL"
msgid "Pre-burnt tree."
msgstr "提前烧了的树。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1"
msgid "It looks quite broke, and that's no joke!"
msgstr "破烂玩意！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2"
msgid "It looks quite broke, and that's no joke!"
msgstr "破烂玩意！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3"
msgid "It looks quite broke, and that's no joke!"
msgstr "破烂玩意！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER"
msgid "I'll say a prayer for this slain bear."
msgstr "我会为这只倒下的熊祈祷。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Bishop made of polished stone."
msgstr "光亮的石头做的主教。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "对，对，来玩吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A clay hound made from that sketch we found!"
msgstr "一只黏土做的猎犬！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "So scary, rendered still in stone."
msgstr "真可怕，石头制成，静静伫立。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "That was such a fun day!"
msgstr "多么有趣的一天！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Bye bye, dear dragonfly."
msgstr "再见，亲爱的蜻蜓。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL"
msgid "You've a much too competitive spirit, sir."
msgstr "这位先生你太争强好胜了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "What a funny use for a horn!"
msgstr "把角用来做这个真好笑！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Let's play a game, you and I!"
msgstr "咱俩来玩个游戏！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "对，对，来玩吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "We've established a stone goose truce."
msgstr "和石头鹅休战。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2"
msgid "We've established a stone moose truce."
msgstr "和石头鹿休战。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE"
msgid "How whimsically elegant."
msgstr "离奇却优雅。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN"
msgid "Would you like to play?"
msgstr "要不要玩？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE"
msgid "Bubble, bubble, no such trouble."
msgstr "泡泡没有烦恼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "We carved this from the rock ourselves."
msgstr "我们自己拿石头刻的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "对，对，来玩吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER"
msgid "Greetings! Sorry, I can't pet you."
msgstr "你好！抱歉，我不能爱抚你。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "My, my, what do you see?"
msgstr "老天，你能看到什么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "There's no soul attuned to it."
msgstr "没有匹配的灵魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Yip yap yelp, I need help!"
msgstr "我需要帮助！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE"
msgid "Petrified from toe to tip!"
msgstr "从头到尾石化了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC"
msgid "Growl and bark, teeth like a shark!"
msgstr "能吼能叫，牙齿像鲨鱼一样尖！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE"
msgid "Petrified from toe to tip!"
msgstr "从头到尾石化了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "马上就熄灭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC"
msgid "Brrrning brrrright."
msgstr "明亮耀眼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH"
msgid "Chilly! So chilly."
msgstr "冷！好冷。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "火越来越小了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL"
msgid "Brisk fire. That's new."
msgstr "寒冷的火焰。新奇啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT"
msgid "And out it goes."
msgstr "火焰熄灭。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "马上就熄灭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Brrrning brrrright."
msgstr "明亮耀眼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Chilly! So chilly."
msgstr "冷！好冷。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "火越来越小了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Brisk fire. That's new."
msgstr "寒冷的火焰。新奇啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT"
msgid "And out it goes."
msgstr "火焰熄灭。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E"
msgid "East!"
msgstr "东！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC"
msgid "For when up is down and down is out."
msgstr "东西南北中，转转转。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "北！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "东北！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "西北！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "南！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "东南！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "西南！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W"
msgid "West!"
msgstr "西！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS"
msgid "But it's more fun to wing it!"
msgstr "与其按图索骥，不如随心所欲！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE"
msgid "It's at peace now."
msgstr "它找到安宁了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT"
msgid "I don't really like having food in my stomach."
msgstr "我不喜欢胃里留有食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I'd still rather not eat it."
msgstr "我宁愿不吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT"
msgid "At least it smells better now."
msgstr "至少闻着好点了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT"
msgid "I don't understand how to make mortal food."
msgstr "我不知道怎么做凡间的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It will take quite some time."
msgstr "会花些时间的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "I'm shivering with anticipation!"
msgstr "期待啊，激动的都颤抖了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE"
msgid "Looks like my treat is ready to eat!"
msgstr "我的没事快要做好了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY"
msgid "Can souls simmer?"
msgstr "灵魂能炖熟么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL"
msgid "Better yours than mine."
msgstr "吃你的好过吃我的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN"
msgid "I prefer not to ingest food."
msgstr "我喜欢反刍食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED"
msgid "I thought it was supposed to pop."
msgstr "我以为会做成爆米花呢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "春种一粒粟，秋收万颗子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB"
msgid "Ooo, I'd like a partner in pranks."
msgstr "嘿嘿，给我找个恶作剧的伙伴吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING"
msgid "Look at you, little firebreather!"
msgstr "瞧瞧你，喷火的小家伙！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING"
msgid "What a cute little munchkin you are."
msgstr "亲爱的，你小小的，真惹人爱。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN"
msgid "What should our next prank be, little kitty?"
msgstr "我们接着去捉弄谁好呢，我的小猫咪？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB"
msgid "Just know that I'm petting you in my mind."
msgstr "亲爱的，我在内心爱抚你呢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING"
msgid "You're so sweet, I could just gobble you up."
msgstr "你这么可爱，真的忍不住想吞你下去。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY"
msgid "Sorry I can't pet you, little friend."
msgstr "抱歉我不能收你做宠物，亲爱的小朋友。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC"
msgid "Clever trickster."
msgstr "狡诈的骗子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD"
msgid "Careful, don't touch my hands."
msgstr "小心，别碰到我的手。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS"
msgid "Oh, what I could weave!"
msgstr "喔，能用来编织东西了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN"
msgid "I'd really rather not eat it."
msgstr "我宁愿不吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS"
msgid "One swift yank was all it took."
msgstr "用力一拉就到手了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE"
msgid "Brick by brick, they say, they say."
msgstr "一块又一块的砖头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST"
msgid "I desire this even less than regular food."
msgstr "普通食物我都不喜欢，更别说这玩意了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "噼里啪啦，一棵烧着的树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Well, that was fun."
msgstr "好吧，那个有点意思。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "A funny tree prank."
msgstr "好玩的树恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Fanciful tree of papery bark."
msgstr "花哨的树，长着纸一样的树皮。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It is no longer bound to the earth!"
msgstr "它已不受土地的束缚！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER"
msgid "My, what a lovely horn you have!"
msgstr "天啊，你的角多么的可爱！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC"
msgid "Greetings, dearest!"
msgstr "亲爱的，你好！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS"
msgid "So large, so rude, so full of 'tude!"
msgstr "庞大，粗鲁，有态度！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Apologies, dear sir."
msgstr "亲爱的先生，十分抱歉。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER"
msgid "I like mine better."
msgstr "我更喜欢自己的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED"
msgid "That's a good look for you!"
msgstr "你这造型很酷炫！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's gone away for now."
msgstr "已不在。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT"
msgid "I do so dislike having sand in my face fur."
msgstr "我讨厌被吹的满脸都是沙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL"
msgid "It's a prank-maker."
msgstr "是个恶作剧工具。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV"
msgid "Whoops-a-doodle!"
msgstr "哎呀呀！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE"
msgid "I could get my claws in there."
msgstr "我可以伸爪子进去。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD"
msgid "The trail's gone cold, I feel cajoled."
msgstr "变冷了，我感到上当了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC"
msgid "It will guide me where I wish to go."
msgstr "会指引我去往想去的地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT"
msgid "Red hot! We're near the spot!"
msgstr "又红又热！我们在附近了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM"
msgid "Hey, hey, hey! We're on our way!"
msgstr "好！我们的方向是对的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER"
msgid "I have to boast, we're getting close!"
msgstr "不是我吹，我们越来越接近了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "How very, very curious!"
msgstr "真是让人好奇啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY"
msgid "Let's hop, skip and jump out of here!"
msgstr "我们蹦蹦跳跳的离开这里吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ooo, my fur's standing on end in anticipation!"
msgstr "唔，我期待的毛发都立起来了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART"
msgid "And now begins a thrilling game!"
msgstr "一个刺激的游戏要开始了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT"
msgid "Let's play imp in the middle!"
msgstr "咱们在中间玩恶魔游戏吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY"
msgid "Fear me! I'm a scary imp!"
msgstr "畏惧我把！我是可怕的恶魔！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST"
msgid "Chest to impress."
msgstr "华丽的箱子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "A cage to hold the dragon's rage."
msgstr "里面充斥着龙的愤怒。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It lost its glamor to the hammer."
msgstr "被锤过后不好看了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It burns so bright both day and night."
msgstr "熊熊烈火，日夜燃烧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "It burns the right amount, I'd say."
msgstr "燃烧程度刚刚好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT"
msgid "Plucked fresh from the dragon. Hyuyu!"
msgstr "从火龙身上新鲜摘下的。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It's been cooked in dragonfire."
msgstr "龙焰中烹饪而成。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "春种一粒粟，秋收万颗子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT"
msgid "Me and my horns should be the head!"
msgstr "为什么是龙头，不是牛头！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE"
msgid "Chock full of genuine dragon."
msgstr "这可是真龙做的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT"
msgid "Put my tail at the tail end!"
msgstr "为什么是龙尾不是我的牛尾！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES"
msgid "I prefer fur to scales."
msgstr "比起皮毛，我更喜欢鳞甲。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK"
msgid "Ba-dum-chhh!"
msgstr "分量够足！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED"
msgid "It's been cooked now."
msgstr "做熟了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH"
msgid "A bush out of dirt is like a fish out of water."
msgstr "离了土的灌木就像离了水的鱼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "A bush out of dirt is like a fish out of water."
msgstr "离了土的灌木就像离了水的鱼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "赶紧栽回土里，不然小草要受伤了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "赶紧栽回土里，不然小草要受伤了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "赶紧栽回土里，不然小草要受伤了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN"
msgid "I love a good stink!"
msgstr "闻着臭，吃着香！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED"
msgid "Don't mind if I do-rian."
msgstr "让人留恋的榴莲啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "赶紧埋土里种起来，不然坏了怎么办。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT"
msgid "They weren't made for floppy ears."
msgstr "我的耳朵不但大，而且还老晃，这个怕不适合吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL"
msgid "A slippery soul, that one."
msgstr "那玩意的灵魂都是滑溜溜的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED"
msgid "I'd rather not put that in my flesh body."
msgstr "我不想把这玩意放到我的肉体里。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT"
msgid "I've never seen such a thing before!"
msgstr "我以前从来没见过这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED"
msgid "My favourite treat... it can't be beat!"
msgstr "我最爱的美食！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "赶紧埋土里种起来，不然坏了怎么办。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT"
msgid "That was hardly necessary."
msgstr "真美必要。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY"
msgid "Now now, let's set the table."
msgstr "来来，咱们把桌子布置好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A light so bright I might still see at night!"
msgstr "灯光璀璨耀眼，夜晚都能看到！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC"
msgid "I never learned my table manners."
msgstr "我就从来没学会过餐桌礼仪。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I'll try not to pout when that light soon goes out."
msgstr "灯光估计一会就熄灭了，我到时尽量不噘嘴吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED"
msgid "Tiny flower on the table... you aren't looking very stable."
msgstr "桌上的小花啊，你看着不太稳。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "噼里啪啦，一棵烧着的树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT"
msgid "Well, that was fun."
msgstr "好吧，那个有点意思。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED"
msgid "A funny tree prank."
msgstr "好玩的树恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC"
msgid "A hearty tree of dark green leaves."
msgstr "粗壮的大树长满了墨绿的叶子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "噼里啪啦，一棵烧着的树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Well, that was fun."
msgstr "好吧，那个有点意思。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "A funny tree prank."
msgstr "好玩的树恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A mournful tree full of lumps and bumps."
msgstr "悲恸的大树长满了肿块和疙瘩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT"
msgid "A cyclops' sight stretched mighty thin."
msgstr "独眼巨人看的不远。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT"
msgid "My oh my, what a lovely eye."
msgstr "瞧瞧，多么可爱的眼睛啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET"
msgid "Oh me oh my, look at that eye!"
msgstr "乡亲们，都来看看那只眼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM"
msgid "To build it would be all it took to fell my foes by deadly look."
msgstr "建好了以后，就可以用致命的凝视击败我的对手了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT"
msgid "A silly prank to be sure."
msgstr "绝对是个愚蠢的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC"
msgid "Mortal food maker."
msgstr "凡间的烹饪用品。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING"
msgid "The mortals are making mortal food."
msgstr "凡人们在做凡人的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "The semi-formed food is hungry."
msgstr "半成型的食物饿了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN"
msgid "It makes a big gust. What's all the fuss?"
msgstr "能刮出一阵大风。有什么了不起的？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT"
msgid "Feathers and horns go well together."
msgstr "羽毛和我的牛角十分搭配。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL"
msgid "Use this quill, I will, I will."
msgstr "我要用这支羽毛笔。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY"
msgid "A token, to remember its sweet song by."
msgstr "谨以此纪念它美妙的歌声。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW"
msgid "A memento of my jet feathered friend."
msgstr "我乌黑羽毛的朋友留下的纪念品。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN"
msgid "To remind myself of its sweet beaky face."
msgstr "让我想起它美丽的喙和动人的容颜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A keepsake of a gentle blue friend."
msgstr "一位温柔的蓝色朋友留下的纪念。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET"
msgid "Greetings and salutations, ma'am."
msgstr "尊敬的女士，您好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE"
msgid "To keep you out, or keep me in?"
msgstr "把别人挡在外面也就把自己关在了里面。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE"
msgid "For temporary visiting."
msgstr "供临时探望用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM"
msgid "It's of no use there on the ground."
msgstr "单单这个放在地上没用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM"
msgid "It's of no use there on the ground."
msgstr "单单这个放在地上没用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER"
msgid "Hyuyu! That's some poo!"
msgstr "哼！有粪便！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF"
msgid "Ooohoo, how delightfully chaotic!"
msgstr "哎呀，多么令人愉悦的混乱啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS"
msgid "Pop, pop!"
msgstr "啪，啪！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC"
msgid "Some natural light to grant me sight."
msgstr "自然光源，让我能看见点东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD"
msgid "Little jittery, fluttery souls."
msgstr "小小的灵魂不安着，扑腾着。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND"
msgid "Hyuyu, fiery!"
msgstr "哼，炽热的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "马上就熄灭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "这团火能满足我对温暖的渴望。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH"
msgid "Those are some spicy flames."
msgstr "熊熊烈火。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "火越来越小了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "营火给我家的温暖。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT"
msgid "And out it goes."
msgstr "火焰熄灭。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF"
msgid "It makes fire by its own magic."
msgstr "它能用魔法制造火焰。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It hungers for souls! Or fuel."
msgstr "它需要灵魂，或者燃料。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Dead to the world."
msgstr "死翘翘了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "It is ready to fling at a moment's notice."
msgstr "随时做好投掷准备。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH"
msgid "You are quite fragrant."
msgstr "你身上好香。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD"
msgid "A mortal pastime."
msgstr "凡人的娱乐项目。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS"
msgid "No thank-you."
msgstr "不用了，谢谢！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS"
msgid "More mortal food."
msgstr "又是凡人的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED"
msgid "At least it isn't suffering anymore."
msgstr "至少它不再受苦了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT"
msgid "My eye was caught by its dull glint."
msgstr "暗淡的散射吸引了我的目光。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC"
msgid "Perfumed petals to pick and pluck."
msgstr "芳香的花瓣供君采摘。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE"
msgid "It's as red as I am."
msgstr "跟我一样红。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT"
msgid "I'll place a crown upon my head to ward away the growing dread."
msgstr "我要头戴皇冠，赶走绝望和恐惧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD"
msgid "I don't really like eating."
msgstr "我不太喜欢吃东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE"
msgid "How kind of you to light my way."
msgstr "谢谢你为我照亮前路。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_DOUBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_DOUBLE"
msgid "How kind of you to light my way."
msgstr "谢谢你为我照亮前路。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_TRIPLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_TRIPLE"
msgid "How kind of you to light my way."
msgstr "谢谢你为我照亮前路。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL"
msgid "It's not its fault it's evil."
msgstr "它虽然是坏的，但不是它的错。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED"
msgid "Farewell sweet petals."
msgstr "再见了，甜蜜的花瓣！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE"
msgid "Purpled leaves from down below."
msgstr "发紫的叶子，来自下面。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT"
msgid "I hope I don't get helmet horns."
msgstr "希望别给我长角的帽子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE"
msgid "A little piece of a great big beast."
msgstr "一位伟大的猪类猛兽留下的一块化石。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "That looks right at rain, it does it does!"
msgstr "它在盯着看下雨，真的，真的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "A silly look, that's to be sure!"
msgstr "看起来蠢透了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still could use a piece or two."
msgstr "好像还差一两块，不全啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD"
msgid "I am sorry! So sorry!"
msgstr "我很抱歉！真的抱歉！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC"
msgid "I hop, you hop. Friends til the end!"
msgstr "我跳，你也跳。一生一世做朋友！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING"
msgid "Sleep fast little hopper."
msgstr "蹦蹦跳跳的小家伙睡的真快。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH"
msgid "Mortals are weird."
msgstr "这些凡间的生物真是奇怪啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS"
msgid "To hop no more."
msgstr "蹦跶不起来了吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely no more hopping."
msgstr "肯定跳不动了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY"
msgid "The mortals threw a bunch of plants together."
msgstr "凡人们来了个植物大杂烩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FURTUFT"
msgid "Not from my chest!"
msgstr "不是从我胸膛上拔下来的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_HOUND"
msgid "I hope that hellhound's in on the prank."
msgstr "我希望地狱犬会参与恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Let's not be here when that wakes up!"
msgstr "醒来的时候咱们最好不要在这里。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEARS"
msgid "Grind them and grind them well."
msgstr "来压碎它们。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.GEMS"
msgid "It could use some shine, if you ask me."
msgstr "可以抛光一下。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.VALID"
msgid "Magic always does provide!"
msgstr "强大的魔法！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOST"
msgid "An unclaimed soul!"
msgstr "无人认领的灵魂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFT"
msgid "Presents! How fun!"
msgstr "礼物！真有趣！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFTWRAP"
msgid "That's a wrap!"
msgstr "我太厉害了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSBLOCK"
msgid "A pretty spire, made of glass."
msgstr "漂亮的螺旋塔，玻璃做的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSSPIKE"
msgid "Sharp and pointy as my tooth!"
msgstr "跟我的牙齿一样锋利！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC"
msgid "What thoughts lurk within that curious noggin?"
msgstr "那个小脑袋在想什么呢？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.SLEEPING"
msgid "If only I were a sleep demon."
msgstr "如果我是一个沉睡的恶魔多好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Oh no, oh dear!"
msgstr "哎呀，不妙！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "A flower that attracts a friend."
msgstr "能引来伙伴的花朵。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFUEL"
msgid "This stuff's so funny!"
msgstr "这东西真好玩！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERWINGS"
msgid "How dainty!"
msgstr "真讲究！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOATMILK"
msgid "Please, no thanks."
msgstr "谢谢，真的不用了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOGGLESHAT"
msgid "I have to keep up appearances."
msgstr "我得跟上时尚潮流。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENAXE"
msgid "Now where's my golden fiddle?"
msgstr "我的黄金小提琴放哪啦？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPICKAXE"
msgid "The mortals say you have to spend gold to make gold."
msgstr "凡人们说得用黄金才能制作出黄金。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPITCHFORK"
msgid "Fancy mob gear. Hyuyu!"
msgstr "花哨的暴民用品。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENSHOVEL"
msgid "Luxuriously unnecessary! Hyuyu!"
msgstr "奢侈成这样，完全没必要！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDNUGGET"
msgid "Money is soulless."
msgstr "金钱没有灵魂。！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOOSE_FEATHER"
msgid "This feather may help one brave hot weather."
msgstr "羽毛能帮助我们渡过炎夏。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BARREN"
msgid "Salted earth, none will return."
msgstr "土地盐碱化，什么也长不出了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BURNING"
msgid "Whoops-a-doodle."
msgstr "哎呀呀。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASED"
msgid "Now it stinks really good!"
msgstr "闻着有阵阵恶臭！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASING"
msgid "It's started to stink."
msgstr "开始发臭了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.GENERIC"
msgid "Grass that grows from richest earth."
msgstr "从最肥沃的土地里长出的青草。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.WITHERED"
msgid "Feeling down, are you?"
msgstr "感觉有点失落，你呢？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "I can see the disease creeping into your soul."
msgstr "我能看到疾病正在侵蚀你的灵魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Hello dear friend! No need to drop your tail."
msgstr "你好亲爱的朋友！尾巴多好，干嘛丢掉呢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS_UMBRELLA"
msgid "A tool to keep the rain away."
msgstr "可以让我不被雨淋的工具。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENAMULET"
msgid "So I'll be more skilled when I rebuild."
msgstr "重建的时候我就更娴熟了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENGEM"
msgid "Gentlest green from lush vales gleaned."
msgstr "如同茂密的峡谷中树木温柔的绿色。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENMOONEYE"
msgid "This eye of green wishes to be seen!"
msgstr "这只绿色的眼睛希望被看到！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENSTAFF"
msgid "Do not treat it like a toy. Its purpose is to destroy."
msgstr "这可不是玩具，它具有强大的破坏力。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP"
msgid "These mushrooms play all sorts of tricks."
msgstr "这些蘑菇会耍各种花样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP_COOKED"
msgid "That changed it somehow."
msgstr "似乎改变了它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Found you!"
msgstr "找到你了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "它在玩捉迷藏！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUACAMOLE"
msgid "I don't like to eat, unless I have to."
msgstr "除非不得已，不然我不喜欢吃东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUANO"
msgid "It came from a bat, and that is that."
msgstr "来自蝙蝠，肯定是。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUNPOWDER"
msgid "I'll spell your doom with a mighty BOOM!"
msgstr "强力的火药炸到毁灭！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_1"
msgid "Something to sink my fangs into!"
msgstr "我要用獠牙好好咬住糖果！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_10"
msgid "First time for everything, they say, they say."
msgstr "凡是都有第一次。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_11"
msgid "Harumpf, it melts all over my claws."
msgstr "额，融化在我的爪子上了，粘的到处都是。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_12"
msgid "How delightfully disgusting!"
msgstr "讨厌，但却令人愉快！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_13"
msgid "I'll try a nibble, I will, I will."
msgstr "我就吃一小口，就一小口。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_14"
msgid "Ooo hoo hoo, spicy!"
msgstr "哦呦，好辣！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_2"
msgid "I suppose I could eat a delightful treat."
msgstr "好吧，我也能美美吃一顿了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_3"
msgid "It's just human corn."
msgstr "这就是人造玉米。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_4"
msgid "I could be persuaded to try a taste."
msgstr "好吧，要是大家都劝我，那我就勉强尝一尝。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_5"
msgid "Fweehee! Little kitties!"
msgstr "喵喵！可爱的小猫咪！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_6"
msgid "This prank is ingenious!"
msgstr "这个恶作剧有点创意！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_7"
msgid "Hm... I don't think I'll like that."
msgstr "嗯，我可能不会喜欢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_8"
msgid "Hyuyu, a candied soul!"
msgstr "哼！一个糖心的灵魂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_9"
msgid "Hyuyu, it slithers all the way down!"
msgstr "哼！它全身都滑溜溜的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Tonic of anti-battiness!"
msgstr "带来勇气的药剂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Hyuyu! This'll put tufts on your chest!"
msgstr "哼！喝了这个你也能长胸毛！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "How tame and timid!"
msgstr "多么胆小懦弱啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Firewater!"
msgstr "火水！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "It makes me hungry, yes indeed!"
msgstr "让我感到好饿啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Absolutely batty!"
msgstr "简直是疯了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "A creepy crawler for the tree."
msgstr "古怪的动物，总爬在树上。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "A swirly whirly tentacle!"
msgstr "螺旋打结的触角！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Made to dangle from the tree."
msgstr "可以挂在树上晃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "I do believe it is quite dead!"
msgstr "死的很踏实了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMBAT"
msgid "I'll bring it down with a mighty hamTHWACK!"
msgstr "我要那它去猛击我的敌人！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER"
msgid "To drive my points home."
msgstr "威猛的战锤。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER_MJOLNIR"
msgid "Clamor for the hammer!"
msgstr "战锤的愤怒！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAWAIIANSHIRT"
msgid "Oh no, that's not really my style."
msgstr "不，那不是我的风格。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE"
msgid "To remove the pain of this weary world!"
msgstr "为这个萎靡的世界缓解疼痛！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSTAFF"
msgid "A little heal will improve how you feel."
msgstr "来点治疗，会让你感觉好一点。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.COLD"
msgid "Slightly chilled, to be sure."
msgstr "微微有点凉了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.FROZEN"
msgid "Frozen hard as a rock! Hyuyu."
msgstr "冻的像石头一样硬了！哼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.GENERIC"
msgid "My goodness! A rock!"
msgstr "我的天！一块石头！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.HOT"
msgid "So cozy it's almost unpleasant."
msgstr "好舒服，简直有点让人不愉快啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.WARM"
msgid "Quite cozy!"
msgstr "好舒服！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HIVEHAT"
msgid "Hyuyu! I'm the king!"
msgstr "哼！我是王！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOME"
msgid "Yoohoo! Anyone home?"
msgstr "你好！家里有人吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.BURNT"
msgid "A silly prank to be sure."
msgstr "绝对是个愚蠢的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.GENERIC"
msgid "\"You are here\" it says, it says."
msgstr "\\”你在这里\\” 上面写着。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "恐怕这里没什么好看的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEY"
msgid "It can help heal injuries if I use it right."
msgstr "使用得当可以治疗伤口。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYCOMB"
msgid "Former bee home. Sorry bees."
msgstr "曾是蜜蜂的家园。对不起，蜜蜂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYHAM"
msgid "Mortals have so many ways of preparing meat."
msgstr "凡人们做肉的法子真多。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYNUGGETS"
msgid "I guess they do look kind of good."
msgstr "好吧，他们确实挺好看的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORN"
msgid "Phew! Not one of mine."
msgstr "额！不是我的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTCHILI"
msgid "I don't \"digest\" well."
msgstr "我的\\“消化\\” 不太好."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUND"
msgid "Hyuyu, you're so badly behaved!"
msgstr "哼，你太淘气了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDBONE"
msgid "Short work made by gnashing teeth."
msgstr "被锋利的牙齿雕刻出的作品。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDMOUND"
msgid "It's the dog house!"
msgstr "犬舍！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH"
msgid "You cannot compete with my fangs, no, no."
msgstr "你怎么敢跟我比獠牙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDWHISTLE"
msgid "Ooo, ouch! My ears!"
msgstr "啊！我的耳朵！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH"
msgid "Hello, hello, my small cave friend."
msgstr "你好，来自洞穴的小朋友。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It is on the inside looking out."
msgstr "它在里面往外看。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Its heart is weeping for its friend."
msgstr "它的心在为朋友哭泣。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE"
msgid "It's such a novelty, hyuyu."
msgstr "真新奇，哼哼。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBOX"
msgid "Freeze mortal foods for midday feasts."
msgstr "冷藏凡间食品，用于午餐。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICECREAM"
msgid "I could probably stomach that."
msgstr "我应该可以勉强吃掉。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHAT"
msgid "Horns on ice!"
msgstr "冰是我的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHOUND"
msgid "You wouldn't want to eat an imp. Much too stringy."
msgstr "恶魔肉不好吃的。又柴又涩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEPACK"
msgid "Chilly, chilly, to be sure!"
msgstr "冰冷啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICESTAFF"
msgid "I'll freeze who I please."
msgstr "我想冰冻谁就冻谁。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "My mind's in a tizzy!"
msgstr "我的思维混乱了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It wants to see me lose my marbles!"
msgstr "它想让我弄丢我的弹珠！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTSELF"
msgid "What a handsome devil. Hyuyu!"
msgstr "多么帅气的恶魔啊。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JAMMYPRESERVES"
msgid "Oh no, it's in my fur."
msgstr "糟了，弄到我的毛发里了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JELLYBEAN"
msgid "I do not want those in my bellybean!"
msgstr "我不喜欢这些！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KABOBS"
msgid "More mortal food it seems, it seems."
msgstr "又是些凡人的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.GENERIC"
msgid "Please don't sting my delicate imp skin."
msgstr "请别叮咬我吹弹可破的恶魔肌肤。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.HELD"
msgid "My claws will sting you right back."
msgstr "我的爪子马上叮咬回你。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS"
msgid "Are we not brethren?"
msgstr "我们难道不是兄弟吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUSSACKKEY"
msgid "Now where oh where did he leave that stash."
msgstr "他把东西藏在哪了？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS_SACK"
msgid "What tasty treats lie within?"
msgstr "里面有什么好吃的东西？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT"
msgid "A knight in rusted armor!"
msgstr "穿着生锈盔甲的骑士"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "咦！别跟我胡来！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_SUMMER"
msgid "A gentle beast with tiny horns."
msgstr "长着小角的温柔野兽。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_WINTER"
msgid "How do you do? Why are you blue?"
msgstr "你好么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS"
msgid "Heh heh. No hard feelings?"
msgstr "呵呵，别放心上？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS_SACK"
msgid "He should have known I would not hold back."
msgstr "他早该知道我不会手下留情的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LANTERN"
msgid "Guide my way!"
msgstr "指引我吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I can barely move my little imp legs in it!"
msgstr "我在里面都挪不动腿。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Hyuyu, that looks heavy!"
msgstr "哼，看着好重！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "So light and breezy!"
msgstr "好轻，能感觉有风吹到！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Skittery imp!"
msgstr "疾如风！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Knock on wood for protection!"
msgstr "敲敲木头求好运！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Covered in claws!"
msgstr "利爪制成！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Better! Faster!"
msgstr "更好！更快！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Fortified imp!"
msgstr "强化的恶魔！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Break that stake!"
msgstr "奋力战斗！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BERNIE"
msgid "How do you do, fine sir?"
msgstr "你好吗，先生？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BOARLORD"
msgid "I have no real quest, I'm just here to jest!"
msgstr "我没任务，就是来放松放松！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Hyuyu, oh the magic!"
msgstr "哼，魔法啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Hyuyu, what are you!"
msgstr "哼，你是谁！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, I feel so fancy!"
msgstr "哇，我好时尚！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "It tickles my horns!"
msgstr "弄痒我的角了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Boom! Kabloom! Doom!!"
msgstr "轰轰轰！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "I don't want to die, hyuyu!"
msgstr "我还不想死，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "A bloom to do a bit of good!"
msgstr "盛放的鲜花，带来美好！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A giant sword to cut down this horde!"
msgstr "巨大的重剑！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It's a one-piece puzzle."
msgstr "缺一把解开谜题的钥匙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "And away I go!"
msgstr "我去也！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Gives me a bit of extra bite!"
msgstr "威武霸气！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LUCY"
msgid "Axe to the max!"
msgstr "斧力全开！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "A fire-powered hopper."
msgstr "火焰驱动的传送点。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Hop, skip and a jump! Hyuyu!"
msgstr "蹦，跳，跃！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "More power, faster!"
msgstr "用力，快！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Short range hoppery!"
msgstr "短距离跳跃点！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Gives me a lot of extra bite!"
msgstr "威武霸气！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "This imp is here to help!"
msgstr "这个恶魔可以帮上忙！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE"
msgid "I remember when I was that age."
msgstr "让我回想起我自己小时候。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_COCOON"
msgid "A friend is sleeping deep within."
msgstr "一位朋友在里面休息。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "Is there a sweet pet inside?"
msgstr "里面有一个可爱的宠物吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "My oh my, you're much too cold!"
msgstr "哎呀呀，你好冰冷！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "Sweet and cozy as a clam."
msgstr "好舒服好开心啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.CONTENT"
msgid "What a happy wyrm you are."
msgstr "多么开心的大蛇啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.GENERIC"
msgid "You are blessed with eternal youth! Yes you are!"
msgstr "你青春永驻！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Do you eat souls?"
msgstr "你吃灵魂么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.STARVING"
msgid "Oh gracious, it's starving!"
msgstr "哎呀呀，它在挨饿！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_TOOTH"
msgid "My mom still has mine somewhere."
msgstr "我妈妈把我换下的牙保存起来了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.COOL"
msgid "It cannot hurt my hooves now!"
msgstr "现在伤不到我的牛蹄子了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.HOT"
msgid "If I don't get bit I'll burn in spit!"
msgstr "就算咬不到我，烧到也会烧着啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND"
msgid "I won't dip my toe in."
msgstr "我才不要伸脚进去。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK2"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK3"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK4"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK5"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK6"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK7"
msgid "Cold lava."
msgstr "冷岩浆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF"
msgid "No need to fight, my great tree friend!"
msgstr "没必要打斗，我亲爱的树朋友！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_SPARSE"
msgid "No need to fight, my great tree friend!"
msgstr "没必要打斗，我亲爱的树朋友！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LICHEN"
msgid "Last resort underground foodstuffs."
msgstr "不到万不得已绝对不吃这种地下食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIFEINJECTOR"
msgid "On further reflection, I don't want an injection."
msgstr "我想了一下，还是不打针了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTBULB"
msgid "Magnificent, I do dare say."
msgstr "太棒了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTER"
msgid "A tool to set fire, if you desire."
msgstr "生火的工具。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "That one got zapped recently."
msgstr "最近被雷劈过。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "Your horns aren't so great."
msgstr "你的角不咋样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's okay."
msgstr "挺好的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "For peace of mind."
msgstr "为了内心的安宁。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "It's brimming with elemental energy."
msgstr "流淌着元素的力量。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LITTLE_WALRUS"
msgid "I could play twenty tricks on you!"
msgstr "我可以玩20个戏法捉弄你！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGLOG"
msgid "Don't look at me with those sad eyes!"
msgstr "别用悲伤的眼神看我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE"
msgid "A tree as perplexing as it is vexing."
msgstr "复杂又惹人恼火的树。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_ROOT"
msgid "Rooty toot toot!"
msgstr "盘根错节！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Hyuyu, what a cutie!"
msgstr "哼，好可爱！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.BURNING"
msgid "Oh I say, it'll burn away!"
msgstr "我说吧，它会烧完的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.GENERIC"
msgid "A piece of what was once a tree."
msgstr "它曾是一颗树。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Oh what luck I feel, I feel."
msgstr "我感到交好运了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCY"
msgid "An axe is an axe, those are the facts."
msgstr "斧头就是斧头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUMPY_SAPLING"
msgid "A tiny little baby tree!"
msgstr "小小的童子树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANT"
msgid "As the spider catches the fly."
msgstr "就跟蜘蛛一样抓苍蝇。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANTBULB"
msgid "There's hunger deep within that eye."
msgstr "它的眼神透露出饥饿。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MADSCIENCE_LAB"
msgid "A place to stew my magic brew."
msgstr "炖我魔法酿酒的好地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALE_PUPPET"
msgid "Greetings and salutations, sir."
msgstr "尊敬的先生，您好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE"
msgid "It's out of prank juice."
msgstr "没有恶作剧的汁液了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKESOUP"
msgid "Soon I'll sip a sleepy soup."
msgstr "我一会喝点安眠汤。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Stop that or I'll steal your voice."
msgstr "立刻停手，不然我就偷走你的声音。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_COOKED"
msgid "Oh, dear."
msgstr "噢，天啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_PLANTED"
msgid "It's a prank plant."
msgstr "是颗恶作剧植物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANRABBIT_TAIL"
msgid "A tail from those great big bunnies."
msgstr "大兔子的尾巴。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAPSCROLL"
msgid "It doesn't really matter which way you go."
msgstr "你走那条路都一样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLE"
msgid "Little stone slab, soon statues will be."
msgstr "小石板，马上就会变成雕像。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN"
msgid "Big bean, made of marble."
msgstr "大豆子，大理石做的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "How does it grow? I just do not know!"
msgstr "它怎么生长的？我就不知道啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEPILLAR"
msgid "A column of marble, so tall and so cold."
msgstr "大理石柱子，高大冰冷。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLESHRUB"
msgid "A shubbery!"
msgstr "简直就是艺术品！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLETREE"
msgid "And here we see... a marble tree!"
msgstr "瞧瞧，一颗大理石树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Shh, shush! I see ahead a burning bush!"
msgstr "嘘，嘘！我看到前面的灌木着火了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "Yikes! Spikes."
msgstr "啊！有刺。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_PLANT"
msgid "Move, I'm gazing here."
msgstr "走开，我在凝视着呢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNING"
msgid "It seems to be a burning tree!"
msgstr "好像是一棵在燃烧的树。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNT"
msgid "Goodbye, dear spikes."
msgstr "再见，亲爱的刺。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Taken in its prime. Hyuyu!"
msgstr "在最美好的年华被砍到。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A sickly tree, so sharp and slender."
msgstr "生过病的树，又尖又细。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELL"
msgid "You have no power over me, heehee!"
msgstr "你掌控不了我，呵呵！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLHEAD"
msgid "Hyuyu, that's a good trick!"
msgstr "哼，这戏法真不错！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLIGHT"
msgid "Ooohoohoo, it warms in my presence!"
msgstr "哦哦哦，我出现了它都暖和了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLOCK"
msgid "Now let's see, where is the key?"
msgstr "我们来找找钥匙在哪？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Ooo, music! I'm practically giddy!"
msgstr "哦，是音乐！整个人开心起来了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLTHRONE"
msgid "A precarious place to rest one's rump."
msgstr "在这个地方坐着有点不安全、"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT"
msgid "Ex-animal."
msgstr "曾经是动物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATBALLS"
msgid "Physical food is so hilarious."
msgstr "实体的食品太好笑了"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.BURNT"
msgid "A silly prank to be sure."
msgstr "绝对是个愚蠢的恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE"
msgid "The jerky is ready."
msgstr "肉干好了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING"
msgid "It's drying."
msgstr "在风干了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "It's undrying day."
msgstr "天气不适合风干。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.GENERIC"
msgid "I don't have much use for this."
msgstr "我觉得那个对我没什么用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT_DRIED"
msgid "Mortals like this more than when it's wet."
msgstr "凡人们更喜欢吃干肉。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM"
msgid "Aren't you intimidated by my massive horns?"
msgstr "看到我硕大的牛角你不感到害怕吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.BURNT"
msgid "So long, repulsive head."
msgstr "又长，又讨厌的一颗头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.GENERIC"
msgid "I guess there are more distasteful things than soul consumption."
msgstr "真是没想到还有比消耗灵魂更讨厌的事情。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.BURNT"
msgid "Goodbye, ugly domicile."
msgstr "再见了，丑陋的房子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.GENERIC"
msgid "A stinky structure, to be sure."
msgstr "这建筑恶臭扑鼻。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINERHAT"
msgid "A head light to brighten my dreary thoughts."
msgstr "头灯啊，照亮我的恐惧吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFAN"
msgid "Round and round and round it goes."
msgstr "转啊，转啊，转圈圈。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.GENERIC"
msgid "Hyuyu, draw me next!"
msgstr "哼，把我也画上去！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Time for a little doodle, yes?"
msgstr "我们来画画吧？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN_ITEM"
msgid "A bunch of wood to plant in the ground."
msgstr "一会去把这些木头栽在地里。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAUR"
msgid "Goodness gracious, aren't you fearsome."
msgstr "不怒自威，令人敬畏。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURCHEST"
msgid "Perhaps a surprise awaits inside."
msgstr "也许里面有个惊喜在等着。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURHORN"
msgid "Harumph. It doesn't even spiral."
msgstr "失望，都不是螺旋形的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.ABOVEGROUND"
msgid "The mole has left its hole!"
msgstr "田鼠离开洞了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.HELD"
msgid "Careful, I don't want to accidentally touch you."
msgstr "小心点，我可不想无意碰到你。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.UNDERGROUND"
msgid "The mole is sheltered in its hole."
msgstr "田鼠躲在洞里。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHAT"
msgid "It lets me see on every plane!"
msgstr "戴上后，在每个世界都有视野了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHILL"
msgid "Peering inside it makes my brow furrow."
msgstr "往里面看了看，我不禁皱了皱眉。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY"
msgid "How do you do, little sir?"
msgstr "你好吗，小先生？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYBARREL"
msgid "Home of the little sirs."
msgstr "小先生之家。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERLASAGNA"
msgid "Even the mortals dislike it."
msgstr "凡人们都不喜欢它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT"
msgid "I hope *I* don't look like that inside."
msgstr "希望我的肉不是这样的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT_DRIED"
msgid "I still do not wish to eat it."
msgstr "我还是不想吃这个。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.BROKEN"
msgid "We can't perform the ritual like this."
msgstr "都坏了，进行不了仪式。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.GENERIC"
msgid "What are the conditions for this ritual?"
msgstr "仪式有哪些条件？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "It is done!"
msgstr "完成了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.STAFFED"
msgid "It's time! Call upon the moon!"
msgstr "时辰到！召唤月亮！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hyuyu. That's just silly."
msgstr "哼。好傻。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.CAVE"
msgid "It was so silly to build it down here!"
msgstr "建在这里不切实际。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GENERIC"
msgid "What a handsome devil I see in the water!"
msgstr "多么帅气的恶魔啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Hyuyu, I feel a bit loony!"
msgstr "哼，我有疯癫的感觉！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A newest moon!"
msgstr "是新月。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's on the wane, oh yes indeed."
msgstr "月缺中。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing, yes oh yes it is."
msgstr "月盈中。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKCRATER"
msgid "It might be an eye, were gems in supply."
msgstr "可能是只眼睛，里面还有宝石。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKIDOL"
msgid "What, pray tell, do you desire?"
msgstr "来说说，你想要什么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKNUGGET"
msgid "It was hewn from solid moon."
msgstr "月亮上砍下来的一块。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKSEED"
msgid "I bet you know some fun secrets."
msgstr "我打赌你知道一些有趣的秘密。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCK_PIECES"
msgid "Smashable, crashable fun to be had."
msgstr "把这些砸烂，敲碎应该很好玩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE"
msgid "What manner of beast are you?"
msgstr "你算什么野兽？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSEEGG"
msgid "The egg of that most fearsome creature."
msgstr "恐怖生物下的蛋。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "It's a place to nest and rest."
msgstr "是个筑巢和休息的地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.GENERIC"
msgid "Please do not bite me."
msgstr "请不要咬我。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.HELD"
msgid "I have no blood for you, sweet thing."
msgstr "亲爱的，我没血给你吸。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOSACK"
msgid "It's full of mortal blood."
msgstr "存满了吸来的凡人血。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSSLING"
msgid "The whirlwind of youth."
msgstr "青春的旋风。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.DUG"
msgid "The dead had no use of it, you see."
msgstr "看吧，亡灵要它没用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.GENERIC"
msgid "I sense no souls within."
msgstr "感受不到灵魂的存在。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "I can come and go as I please."
msgstr "我来去随心。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Ooo, what delightful games we might play in there!"
msgstr "哦，我们也许能在里面好好玩一下！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It couldn't decide which to be, so it became both."
msgstr "实在决定不了要哪个，所以就兼顾了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMBOMB"
msgid "I will stay far away!"
msgstr "我会躲得远远的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMHAT"
msgid "I'll have mushroom spores in my horns for days."
msgstr "未来几天我的角里都会留下真菌孢子的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "No more mushrooms to have here!"
msgstr "再没蘑菇了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Just a log if you ask me!"
msgstr "如果你问我，就剩一根木头了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Oh good! The mortals get cranky when they're hungry."
msgstr "好吧！凡人们一饿就急了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "I don't think the mortals will eat that."
msgstr "凡人们应该不吃哪个。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Little tiny icy log."
msgstr "结了冰的小木头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "I don't want them, but the mortals might."
msgstr "我不想要，但是凡人们可能想。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "The mortals will be very, very pleased."
msgstr "凡人们会很高兴的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Now we're destined to the dark."
msgstr "我们注定要活在黑暗中了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "It could use a little spark."
msgstr "它需要点一下火。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "A spotted spotlight to chase away the dark."
msgstr "驱赶黑暗的点式照明。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "The light has long fled."
msgstr "光明逃走了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "When it's out I feel great dread."
msgstr "熄灭后，我感到深深的恐惧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "I quite like it when it's red!"
msgstr "它变红以后非常惹人爱！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "How wonderfully un-wonderful!"
msgstr "太棒了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "好大的蘑菇！我是喝了缩小药水了吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Hyuyu! How wretched!"
msgstr "哼，真糟糕！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "好大的蘑菇！我是喝了缩小药水了吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Delightfully disgusting!"
msgstr "恶心的同时又令人愉悦！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "好大的蘑菇！我是喝了缩小药水了吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "She's shy so she's wearing her veil."
msgstr "她是因为害羞才戴上面纱的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.ATTACKER"
msgid "Don't get my goat, little %s!"
msgstr "别动我的山羊, 小 %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.FIRESTARTER"
msgid "Little goat! You played pranks without me!"
msgstr "小山羊！你居然不带我玩！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.GENERIC"
msgid "Hyuyu, what are you up to %s?"
msgstr "哼, 你想干嘛 %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.GHOST"
msgid "Don't worry, I'm not hungry."
msgstr "别着急，我不饿。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.MURDERER"
msgid "Eep! Don't slaughter me!"
msgstr "哎哟！别杀我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NEXTCHARACTER.REVIVER"
msgid "Thank-you, thank-you, little goat!"
msgstr "谢谢你，谢谢你，小山羊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTLIGHT"
msgid "Goodness gracious, what excellent decorations!"
msgstr "上天啊，多么优雅的装饰！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREFUEL"
msgid "Hyuyu! It's squishy."
msgstr "哼！软软的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARELIGHT"
msgid "Beware, beware, it says to me."
msgstr "注意，注意，它跟我说。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "No games to play today."
msgstr "今天没游戏玩。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Playtime's almost over."
msgstr "游戏时间基本结束。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "A fun medallion for a more fun rapscallion!"
msgstr "一个恶棍的大圆盘！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "Hyuyu! What fun!"
msgstr "哼！真好玩！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Aw, the chaos is dissipating."
msgstr "啊，混乱在扩散。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I'm getting so excited!"
msgstr "我好激动！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "Ooo, it's picking up!"
msgstr "哦，它在变化了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSTICK"
msgid "Shed some light on any fight."
msgstr "照亮所有的战斗。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSWORD"
msgid "To slash and stab!"
msgstr "砍杀，戳刺！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE"
msgid "I've no earthly clue how to use this."
msgstr "完全不知道怎么用。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.EMPTY"
msgid "No swimming today!"
msgstr "今天不游泳！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.GENERIC"
msgid "Swimming gives me wet imp smell."
msgstr "游泳让我身上有味道。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONEMANBAND"
msgid "I'll sing a song, please hum along!"
msgstr "我会高歌一曲，请各位歌迷朋友跟我一起唱！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALPRECIOUSGEM"
msgid "A gem like this is precious indeed."
msgstr "真是一块宝石啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALSTAFF"
msgid "Chilly and bright as a moonlit night."
msgstr "明亮凄冷的月夜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEAMULET"
msgid "It nestles nicely on my chest fur."
msgstr "刚好配我的胸毛。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEGEM"
msgid "Bright and orange like a... a..."
msgstr "亮橙色，好像。。。一样"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEMOONEYE"
msgid "My oh my, what a lovely eye."
msgstr "瞧瞧，多么可爱的眼睛啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGESTAFF"
msgid "A touch of magic not my own."
msgstr "不是我的魔法。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANDORASCHEST"
msgid "Open it, open it!"
msgstr "打开，打开！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANFLUTE"
msgid "My flute!"
msgstr "我的笛子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAPYRUS"
msgid "An ancient scroll in the making."
msgstr "制作中的古老卷轴。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEGHOOK"
msgid "This will be a cinch if I don't get pinched!"
msgstr "美丽啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PENGUIN"
msgid "A bird that flies within the sea."
msgstr "海水里飞翔的小鸟。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERD"
msgid "Begone you greedy, greedy bird."
msgstr "走开，你这只贪婪的鸟。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDFAN"
msgid "A gust of luck from feathers plucked!"
msgstr "摘下的羽毛扇出好运之风。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.BURNT"
msgid "That's that."
msgstr "就这样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Rumble and grumble, it wants a bush!"
msgstr "它在咕咕叫，想要灌木！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "我们庆祝吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEROGIES"
msgid "Mortal food, this seems to be."
msgstr "好像是凡间的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS"
msgid "Evidence of flower violence."
msgstr "针对花朵暴行的证据。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS_EVIL"
msgid "A tainted beauty."
msgstr "被玷污的美好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETRIFIED_TREE"
msgid "Fweeheehee! A stone cold tree!"
msgstr "哟！一棵石头般冰冷的树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHLEGM"
msgid "How very unpleasant!"
msgstr "真让人不愉快！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE"
msgid "Heigh ho, heigh ho!"
msgstr "嗨呵，嗨呵！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE1"
msgid "You won't beat me, no siree!"
msgstr "你打不过我的，不，先生！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE2"
msgid "You won't beat me, no siree!"
msgstr "你打不过我的，不，先生！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE3"
msgid "You won't beat me, no siree!"
msgstr "你打不过我的，不，先生！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE4"
msgid "You won't beat me, no siree!"
msgstr "你打不过我的，不，先生！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGUARD"
msgid "We don't have to fight, you know."
msgstr "其实咱俩不是非打不可。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGYBACK"
msgid "So I keep my things within this little bag made of pig skin."
msgstr "我把东西都放在这个猪皮小包里。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.BURNT"
msgid "Goodbye, revolting pighead."
msgstr "再见，恶心的猪头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.GENERIC"
msgid "Yuck."
msgstr "真讨厌。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.BURNT"
msgid "Fare thee well, hideous house."
msgstr "再见，丑陋的房子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.FULL"
msgid "There's someone hiding, there, inside."
msgstr "里面藏着人。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.GENERIC"
msgid "A house that I may never enter."
msgstr "我绝不会进去这个房子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "They will not invite me across the threshold."
msgstr "他们不会邀请我迈过那个门槛。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGKING"
msgid "I don't mean to pester, but please make me your jester!"
msgstr "大王，请收下我当您的臣子吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.DEAD"
msgid "Oh my goodness, no."
msgstr "我的天，不要。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Hyuyu! Are we playing follow the leader?"
msgstr "哼！我们是在玩跟随领袖的游戏么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GENERIC"
msgid "Would you like to see a trick?"
msgstr "想看个戏法么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GUARD"
msgid "You wouldn't hit an imp, would you?!"
msgstr "你不会打我吧？！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.WEREPIG"
msgid "Goodness! How bestial!"
msgstr "啊！禽兽啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.BURNT"
msgid "That's that."
msgstr "就这样。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Rumble and grumble, it wants to eat meat!"
msgstr "它在咕咕叫，想吃肉！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "我们庆祝吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSKIN"
msgid "Not by the hair of my rumpy rump rump!"
msgstr "不行，就不行！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTORCH"
msgid "It lights a flame for all to see!"
msgstr "点一盏明灯，照亮一切！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_TOKEN"
msgid "Let's start the game, oh please, oh please!"
msgstr "开始玩吧，好不好，好不好！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE"
msgid "To plant a tree!"
msgstr "栽一棵树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE_SAPLING"
msgid "A tiny little baby tree!"
msgstr "小小的童子树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PITCHFORK"
msgid "I do believe it suits me!"
msgstr "非常适合我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT"
msgid "I don't like it, no siree."
msgstr "先生，我不喜欢它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT_COOKED"
msgid "I'll leave it to the mortals."
msgstr "我还是把那个留给凡人吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "A leafy little plant I see."
msgstr "看到一颗小树，枝繁叶茂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Grow big, grow tall, or not at all!"
msgstr "长大，长高，或者不长也行！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.READY"
msgid "The mortals want your tasty eats."
msgstr "凡人们想吃你的好吃的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It does not seem to be in the highest spirits."
msgstr "状态不太好啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.ATTACKER"
msgid "That was a mean prank, %s!"
msgstr "好犀利的恶作剧, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Ooo, who did you prank?"
msgstr "哦，你捉弄谁了？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GENERIC"
msgid "Hello, hello, good day, good day!"
msgstr "你好，你好，日安，日安！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GHOST"
msgid "Ooo, lunch is here!"
msgstr "哦，午餐到了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.MURDERER"
msgid "That wasn't a prank! That mortal's dead!"
msgstr "不是恶作剧！杀人了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.REVIVER"
msgid "What a kind soul you have there!"
msgstr "你的灵魂真善良啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE"
msgid "You need only eat one seed. Hyuyu!"
msgstr "你只需要吃一颗籽。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_COOKED"
msgid "The underworld can wait."
msgstr "先不急着种吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "赶紧埋土里种起来，不然坏了怎么办。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND"
msgid "I could gaze upon my reflection all day!"
msgstr "我可以盯着我的倒影欣赏一天！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND_ALGAE"
msgid "Little growth of winding green."
msgstr "小小绿植，弯弯生长。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POOP"
msgid "Physical digestion is very unpleasant."
msgstr "凡人们的消化系统真是恶心。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTTEDFERN"
msgid "A plant, imprisoned for eternity."
msgstr "遭到永恒囚禁的植物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWCAKE"
msgid "Hyuyu! This cake packs a wallop!"
msgstr "哼！爆发力十足的蛋糕啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN"
msgid "How nice and how spooky!"
msgstr "真好，真古怪！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCOOKIE"
msgid "Real food is a bit hard on my stomach."
msgstr "真正的食物让我有点消化不良。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_COOKED"
msgid "Slightly easier on my impish tum."
msgstr "这个稍微好消化一点。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_LANTERN"
msgid "How delightfully spooky! Hyuyu!"
msgstr "古怪，但却让人高兴！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "赶紧埋土里种起来，不然坏了怎么办。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEAMULET"
msgid "I deserve these jewels, I think."
msgstr "这些珠宝是我应得的，对吧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEGEM"
msgid "Dark amethyst wrenched from shadows' midst."
msgstr "从暗影迷雾中获得的暗色紫水晶。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEMOONEYE"
msgid "Jeepers peepers!"
msgstr "窥视着一切！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "It's full as full can be!"
msgstr "满了，满了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "A place to place a plate!"
msgstr "放盘子的地方。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Nothing of interest to me, I see."
msgstr "没什么有意思的东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Creeping ivy, growing strong."
msgstr "阴森的常春藤，越长越壮。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "My vessel is not her vassal."
msgstr "我誓不做她的奴仆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "A monumental statue! Hyuyu!"
msgstr "一座雕像！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "No relation."
msgstr "没关联。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "I'll take the beef, you keep the \"lo\"!"
msgstr "牛肉归我，剩下的归你！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Mortals like berries, I think."
msgstr "凡人好像喜欢浆果。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "The mortals like it when food looks nice."
msgstr "凡人们喜欢好看的食物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I wonder how the wyrm got a taste for mortal food."
msgstr "不知道大蛇是怎么爱上凡人食物的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "This dish is so itty bitty!"
msgstr "这倒菜太小了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN1"
msgid "Pithy pennies."
msgstr "不错的硬币。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN2"
msgid "The Gnaw expelled it from its craw."
msgstr "饕餮胃里吐出来的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN3"
msgid "The Gnaw has spoken. We've earned its token."
msgstr "饕餮发话了。我们赚到了它的硬币。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN4"
msgid "It's a big hop token."
msgstr "好大一个硬币。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "The humans like it, they do, they do!"
msgstr "人类很喜欢它！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "They like it more like this, I hear!"
msgstr "我听说他们更喜欢做熟的蟹肉！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "They'll feel so silly once I catch them!"
msgstr "等我逮住他们，他们会觉得自己很蠢！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FERN"
msgid "I wonder what it tastes like."
msgstr "不知道它是什么味道的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Mortal food powder!"
msgstr "凡间的食品粉末！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Humans have odd palates."
msgstr "人类的味蕾真奇怪。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's roll the dice with this sacrifice!"
msgstr "咱们摇筛子来决定献祭品吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This meal is splendid, just as intended!"
msgstr "美味佳肴！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Better to serve something small than nothing at all."
msgstr "零食也总比没的吃好。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "This meal looks wrong, but we don't have long."
msgstr "菜肴不对，时间不多了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Oospadoodle."
msgstr "哎呀！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Hissss!"
msgstr "嘶嘶作响！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Hissssss!"
msgstr "嘶嘶作响！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATKID"
msgid "And who might you be?"
msgstr "你是谁啊？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Hyuyu! Fresh from the source."
msgstr "哼！新鲜直供。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "I'd ask hircine, but I think it's Capricorn."
msgstr "我可以去问山羊，但我觉得它是摩羯座。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL"
msgid "Mortals have lots of different cooking things."
msgstr "凡人们各种烹饪用品真多。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "We need to build that, yes indeed."
msgstr "我们要造一个这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Mortals cook stuff on it."
msgstr "凡人们用它来煮东西的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "We need to build that, yes indeed."
msgstr "我们要造一个这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_HOE"
msgid "To turn the soil, row by row."
msgstr "一行一行的翻土。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY"
msgid "I wish to pry into hidden supplies."
msgstr "我想一窥隐藏的宝藏。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "No gate can stop a sneaky imp!"
msgstr "什么门也挡不住一个神偷恶魔！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "If it were raining I could sing!"
msgstr "要是下雨了，我就高歌一首雨中曲！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "If it were raining I could sing!"
msgstr "要是下雨了，我就高歌一首雨中曲！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I do enjoy this mortal chore."
msgstr "我还挺喜欢这个凡人的体力活。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Anything fun inside?"
msgstr "里面好玩么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Mind if I take a little peek?"
msgstr "我能偷偷看一眼吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION"
msgid "You'll see no tears from my eye. I cannot cry!"
msgstr "你不会看到我眼中的泪水。我天生不哭！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Cooked, but not into a dish."
msgstr "已烹饪，但是没做成一道菜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN"
msgid "It's a thing mortals cook with."
msgstr "凡人们做饭时用的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "We need to build that, yes indeed."
msgstr "我们要造一个这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "A wall, a wall, so very tall."
msgstr "一堵高墙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "I could draw a little moustache on it when no one's looking."
msgstr "等没人的时候，我可以偷偷给它脸上画个胡子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "This one's already got a beard."
msgstr "这个已经有胡子了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "How disappointing, it's all dried up."
msgstr "失望啊，都干了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "This way to the park!"
msgstr "这条路通向公园！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Let me out! Hyuyu, just kidding."
msgstr "让我出去！哼，开玩笑啦。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "Nothing fun to find here."
msgstr "没发现什么好玩的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "There's probably nothing fun inside."
msgstr "里面没任何好玩的东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "What a funny creature!"
msgstr "好玩的生物！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Oh goodness, oh gracious."
msgstr "啊，天啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I've heard they make good pie."
msgstr "我听说他们做的饼很好吃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Sleep and dream, little wing."
msgstr "安睡吧，小小的翅膀。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Are there any souls on the menu?"
msgstr "菜单上有什么灵魂吗？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It's very salty water."
msgstr "很咸的水。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL"
msgid "A way out or in, depending who you are."
msgstr "有来有去。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Hyuyu! Let us hop away!"
msgstr "哼！咱们跳走吧！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT"
msgid "Mortals don't like it when you burn the things inside."
msgstr "里面东西烧焦了，凡人们就不喜欢了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO"
msgid "Mortals like this in all its forms. Will a wyrm?"
msgstr "土豆，土豆泥凡人们都喜欢。大蛇呢？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Cooked, but not into a dish."
msgstr "已烹饪，但是没做成一道菜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "You can hang a pot on it."
msgstr "你可以把锅挂在上面。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "We need to build that, yes indeed."
msgstr "我们要造一个这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "A little vessel for mortal food."
msgstr "盛凡人食物的小容器。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Mortals don't like raw tree insides."
msgstr "凡人们不喜欢在里面放生的树木。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Yuck, muck."
msgstr "好恶心！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Cycles spinning round and round. Bicycles double the spinning!"
msgstr "转圈圈。自行车有两个轮子转圈圈！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Which squeaky wheel will get the grease?"
msgstr "哪个吱吱响的轮子能上到油？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "It all comes tumbling down."
msgstr "轰隆隆的就倒下了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It all comes tumbling down."
msgstr "轰隆隆的就倒下了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Tumbley, rumbley, falling right down."
msgstr "轰轰隆隆，大厦倾覆。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Hickory dickory dock, hyuyu!"
msgstr "时间的痕迹，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The hands have stopped. Time is difficult to grasp."
msgstr "时针和秒针都不走了，这下掌握不了时间了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Rubble, ruin!"
msgstr "瓦砾，遗址！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "No souls to see."
msgstr "看不到灵魂了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Huff and puff, and blow your house down!"
msgstr "呼呼，吹倒你的房子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "A door to nowhere, hyuyu!"
msgstr "穿过门却哪也去不了，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It all comes tumbling down."
msgstr "轰隆隆的就倒下了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "None can impede this imp!"
msgstr "没有什么能够阻挡我！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Oh whiskers. It's locked tight."
msgstr "锁的死死的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON"
msgid "It doesn't like the air, oh no."
msgstr "好像不喜欢空气啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "So long, sweet fish soul."
msgstr "再见了，亲爱的鱼魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT"
msgid "Mortals tongues seem to like it."
msgstr "凡人的舌头好像喜欢它。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Humans use it as a \"spice\"."
msgstr "人类喜欢把它当\\“香料\\”。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid " The mortals crave these minerals."
msgstr "凡人们特别渴望这些矿物质。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "The minerals are ready."
msgstr "矿物质好了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "It's meant to go above a pond."
msgstr "这个应该架在池塘上。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP"
msgid "Sticky, icky sap!"
msgstr "黏黏糊糊的汁液！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's for filling up with sap."
msgstr "用来灌树液的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING"
msgid "Tiny little baby tree."
msgstr "小小的童子树。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Whoops-a-doodle!"
msgstr "哎呀呀！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Plant them in a plot of land."
msgstr "找块地把它栽了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't like this sort of prank."
msgstr "我不喜欢这种恶作剧。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Mortals say grinding it brings out the flavor."
msgstr "凡人们说捣碎了更出风味。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "I bet the mortals would like some of that."
msgstr "我打赌凡人们喜欢那个。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Gone, all gone."
msgstr "没了，全没了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "Spice! ...How nice!"
msgstr "香料！太好了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "Fweehee, what a special tree!"
msgstr "啊，多么特别的一棵树！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "That's a wrap on the sap."
msgstr "树液的开关。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Those bugs are tree thugs!"
msgstr "这些虫子就是树上的恶棍！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "The tap will soon make sap!"
msgstr "这个龙头马上就能出树液！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sweet, sugary sap!"
msgstr "甜甜的，糖水输液！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "An unfortunate mishap befell the tree sap."
msgstr "输液遭遇了不幸。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Do you feel it loom? Your impending doom?"
msgstr "感觉到了吗？你的毁灭接近了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "My oh my, you look ill! Low of spirit, green 'round the gill."
msgstr "我的天，你看着生病了！没什么精神，病恹恹的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Sleeping like the fishes. Hyuyu!"
msgstr "像鱼一样的安睡。哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "A house that's cobbled from bits and bobs."
msgstr "零七八碎的东西砌成的房子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Nothing but bits and bobs left."
msgstr "只剩下些零七八碎的东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SYRUP"
msgid "For making sweet treats."
msgstr "用于制作美味的甜食。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO"
msgid "I could throw it at the wyrm!"
msgstr "我可以扔给大蛇！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Cooked, but not into a dish."
msgstr "已烹饪，但是没做成一道菜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "What a funny face you have!"
msgstr "瞧您这脸长的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Hyuyu, what a funny moustache!"
msgstr "哼，多么有喜感的胡子！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP"
msgid "That's a tiny turnip."
msgstr "小萝卜头。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooked, but not into a dish."
msgstr "已烹饪，但是没做成一道菜。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT"
msgid "The mortals grind it up with big rocks."
msgstr "凡人们用大石头磨这东西。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "真是奇怪的小种子啊。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.GENERIC"
msgid "A fellow hopper."
msgstr "跟我一样蹦蹦跳跳的。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.HELD"
msgid "Do not touch my paws or claws."
msgstr "别碰我的爪子。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Hopping wonders live within."
msgstr "里面住着许多蹦蹦跳跳的家伙。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.SPRING
