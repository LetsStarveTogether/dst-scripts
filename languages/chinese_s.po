msgstr "会管用的！哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
