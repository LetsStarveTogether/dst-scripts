msgstr "出乎沃尔夫冈的预料。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_30"
msgid "Junk from braingame!"
msgstr "脑力游戏产生的垃圾！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_31"
msgid "Junk from braingame!"
msgstr "脑力游戏产生的垃圾！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_32"
