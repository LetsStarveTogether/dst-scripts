msgstr "我们把他大卸八块吧！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03"
