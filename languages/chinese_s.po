#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04"
msgid "Busted right up, hey?"
msgstr "被拍的稀碎，哈？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05"
msgid "Busted right up, hey?"
msgstr "被拍的稀碎，哈？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH"
msgid "Never know when you might need one."
msgstr "不知道什么时候就需要这个东西了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM"
msgid "Time to roll up my sleeves!"
msgstr "是时候卷起袖子干活了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK"
msgid "That needs a fixin'!"
msgstr "那里需要修一下！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD"
