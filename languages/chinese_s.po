msgstr "不在了就好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATEDHOUND.GENERIC"
