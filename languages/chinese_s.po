#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BURNING"
msgid "Grass fire!"
msgstr "草着火啦！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASED"
msgid "You should see a doctor."
msgstr "你该去看看医生。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASING"
msgid "Not lookin' too lush."
msgstr "看起来没什么生机。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.GENERIC"
msgid "That's some tall grass."
msgstr "这草长得真高。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.PICKED"
msgid "It's on break."
msgstr "它还没长好呢。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.WITHERED"
msgid "It couldn't stand the heat."
msgstr "它受不了这样的高温。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "I didn't know lizards could wilt."
msgstr "我都不知道蜥蜴也会蔫掉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Is that lizard made of grass?"
msgstr "那是一只草做的蜥蜴吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS_UMBRELLA"
msgid "Better than nothing."
msgstr "总比什么都没有好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET"
msgid "We could be good friends, you and I."
msgstr "我们会成为好朋友的，你和我。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM"
msgid "Now that's a proper gem."
msgstr "这才是像样的宝石。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE"
msgid "You coulda been a useful necklace."
msgstr "你可以成为有用的项链。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF"
msgid "It's a hard work destroyer."
msgstr "工作成果破坏利器。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP"
msgid "Yep. Green mushroom."
msgstr "是的，绿蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED"
msgid "Doesn't look TOO deadly."
msgstr "看起来不那么致命。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It's some sorta green mushroom."
msgstr "某种绿蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "懒惰的蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "It's a mushroom hole."
msgstr "蘑菇被摘了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE"
msgid "This green mush ain't bad!"
msgstr "这份绿绿的食物也还不赖！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO"
msgid "What? We all do it."
msgstr "没什么了不起，我们也会拉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER"
msgid "For when you need a big KABOOM!"
msgstr "想要轰轰轰的时候用！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1"
msgid "A nice change from baked apples."
msgstr "吃腻了烤苹果时，拿来换换口味很好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10"
msgid "Curious flavor."
msgstr "奇特的味道。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11"
msgid "Best eaten by the handful."
msgstr "最好一把把地吃。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12"
msgid "Ha, yuck! Everyone watch me eat'em!"
msgstr "哈，讨厌！大家都在看着我吃!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13"
msgid "I ain't patient enough to eat these."
msgstr "我没有足够的耐心去吃这些东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14"
msgid "Whew! That's the kick y'need!"
msgstr "呼！这股辣劲正是你所需要的！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2"
msgid "Is this even food?"
msgstr "这是食物吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3"
msgid "That's no treat."
msgstr "这算什么点心。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4"
msgid "That gummy has too many legs for my taste."
msgstr "那块软糖的腿太多了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_5"
msgid "Not made of catcoons, thankfully."
msgstr "谢天谢地，不是用浣猫做的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6"
msgid "Not sure anyone should eat those."
msgstr "我不确定这东西可以给人吃。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7"
msgid "That's just regular food."
msgstr "普通食物而已。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8"
msgid "How spooky."
msgstr "真可怕。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9"
msgid "Real gelatinous."
msgstr "特别粘稠。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Makes ya plucky."
msgstr "让你变得大胆。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "I got lucky and got the big bottle."
msgstr "我很幸运，得到了大瓶。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Aw, I was hoping for a little more."
msgstr "啊，我期望的不只是这样而已。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Ohh. This'll make a spark."
msgstr "噢。这个可以制造出火花。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Ha! Ya almost fooled me."
msgstr "哈！我差点被你骗到了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "I should hang this somewhere."
msgstr "我应该把它挂到某个地方。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "Time to decorate."
msgstr "是时候装饰了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Time for decoratin'!"
msgstr "是时候装饰了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Hey, it's them hanging guys."
msgstr "嘿，是那些可以挂的家伙。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "It needs to be in a tree."
msgstr "它需要到树上去。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMBAT"
msgid "Good fer a smackin'."
msgstr "用来打人挺好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER"
msgid "And I know how to use it!"
msgstr "我知道怎么用！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER_MJOLNIR"
msgid "I'm most effective with a tool in hand."
msgstr "手里有工具，效率自然高。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAWAIIANSHIRT"
msgid "That's one loud shirt."
msgstr "这件衣服真够鲜艳的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE"
msgid "Soothes minor cuts and scrapes."
msgstr "可以用来治疗小伤口。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSTAFF"
msgid "I'm a bit of a Jane-of-all-trades."
msgstr "我什么都会一点。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.COLD"
msgid "It's a little chilly."
msgstr "有点凉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.FROZEN"
msgid "Brr! Like a chunk of ice."
msgstr "呃！像个冰坨子。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.GENERIC"
msgid "This is a good rock. A special rock."
msgstr "这是一块好石头，特别的石头。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.HOT"
msgid "Almost TOO hot."
msgstr "简直太热啦。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.WARM"
msgid "Tepid."
msgstr "温热。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT"
msgid "Snoot city."
msgstr "傲慢的装饰风格。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME"
msgid "They say you can't go home again."
msgstr "他们说你回不了家了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT"
msgid "Burnt to cinders."
msgstr "烧成灰烬。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC"
msgid "I'll take this as a sign."
msgstr "大概是个标识牌。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "需要谁写点东西上去。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEY"
msgid "The sweet results of honest work."
msgstr "辛勤劳动的甜蜜回报。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYCOMB"
msgid "Let's build a bee house."
msgstr "我们来制造一个蜂箱吧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYHAM"
msgid "Think I could fit that whole thing in my mouth?"
msgstr "猜猜看，我能不能把它一口吃下去？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYNUGGETS"
msgid "Not bad!"
msgstr "不错！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HORN"
msgid "Watch out for the business end!"
msgstr "小心它的关键部位！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTCHILI"
msgid "I'm tough enough to handle a little spice."
msgstr "我这么硬派，一点点辣还是受得了的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUND"
msgid "Anyone got some rolled up newspaper?"
msgstr "谁有逗狗的棍子没？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDBONE"
msgid "It's covered in tooth marks."
msgstr "满是牙印。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDMOUND"
msgid "So that's where they're comin' from."
msgstr "所以它们是从这里来的啊。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH"
msgid "Sure hope no one comes back for it."
msgstr "希望不会有谁会回来找它。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDWHISTLE"
msgid "This oughta give them paws pause."
msgstr "这个应该能让它们停下脚步。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT"
msgid "This was a terrible idea."
msgstr "真是一个可怕的想法。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_COOKED"
msgid "Who thought this was a good idea?"
msgstr "谁觉得这是个好主意？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_DRIED"
msgid "Nope."
msgstr "不不不。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH"
msgid "You wanna be my toolbox, lil guy?"
msgstr "你想当我的工具箱吗，小家伙？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Who left you out here all alone, hey?"
msgstr "谁把你一个人丢在这里了，嗯？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Yeesh. Fishfry."
msgstr "耶，煎鱼。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE"
msgid "Chilly."
msgstr "好冰。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBOX"
msgid "It's not factory standard."
msgstr "不符合工厂标准。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICECREAM"
msgid "Y'gotta eat it before it melts."
msgstr "趁它化掉之前赶紧吃了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHAT"
msgid "There must be a more practical solution."
msgstr "肯定有更加实际的方法。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHOUND"
msgid "Keep those fangs to yourself."
msgstr "别冲我龇牙咧嘴。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEPACK"
msgid "Keeps drinks cool until breaktime."
msgstr "冰镇冷饮用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF"
msgid "This doesn't seem safe."
msgstr "看起来不怎么安全。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "I can't begin to imagine how it works."
msgstr "我无法想象它的工作原理是什么。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "What on earth is that thing?"
msgstr "那究竟是什么东西？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTSELF"
msgid "Who's that good-looking gal!"
msgstr "那个漂亮的姑娘是谁呀？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JAMMYPRESERVES"
msgid "The sweet taste of good planning."
msgstr "精心准备的美味。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JELLYBEAN"
msgid "I would eat them all in one sitting."
msgstr "我一口气就能全吃光。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KABOBS"
msgid "Now that's my kind of cooking."
msgstr "这才是我的烹饪风格。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.GENERIC"
msgid "Stay back, bug!"
msgstr "退后，虫子！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.HELD"
msgid "You can just calm right down."
msgstr "你现在给我冷静一下。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS"
msgid "Get out of here ya big creep."
msgstr "滚出去，你这个可怕的家伙。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUSSACKKEY"
msgid "This must be the actual key."
msgstr "肯定就是这把钥匙。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS_SACK"
msgid "There's gotta be something good in there."
msgstr "里面肯定有什么好东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT"
