msgstr "它通过火完成了变形！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RED_MUSHROOM.GENERIC"
