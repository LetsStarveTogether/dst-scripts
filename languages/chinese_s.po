msgstr "可以采摘了！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED"
