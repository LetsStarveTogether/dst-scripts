msgstr "哼，我不管什么都能做好。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER_ITEM"
