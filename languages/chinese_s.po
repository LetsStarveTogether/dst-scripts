msgstr "那是长满毛毛的腐烂食物。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.GENERIC"
