msgstr "即将打出的弹药。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_POOP"
