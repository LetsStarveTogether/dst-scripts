msgstr "切，下次我再干掉他。"

#. STRINGS.CHARACTERS.WILLOW.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.COMBAT_QUIT.SPIDER_WARRIOR"
