msgstr "我们要点火吗？我想加入！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WX78.GENERIC"
msgid "Hi %s!"
