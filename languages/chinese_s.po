msgstr "已经成熟的新鲜大萝卜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
