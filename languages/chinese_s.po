msgstr "我在空气更糟糕的环境中干过活。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM_INV
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM_INV"
