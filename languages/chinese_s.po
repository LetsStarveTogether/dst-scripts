msgstr "另一边，我的朋友！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CARRAT_START_RACE"
msgid "Ready? Go!"
msgstr "预备？跑！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CAVEIN"
msgid "This place is crumbling like a dry cookie!"
msgstr "这地方在像脆饼干一样崩塌！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE"
msgid "What the devil!"
msgstr "这是什么鬼！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CHARLIE_ATTACK"
msgid "Gah! I do believe something bit me!"
msgstr "啊！我敢肯定有东西咬了我！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COLD"
msgid "I'm... getting freezer burn..."
msgstr "我...要被冻伤了..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COMPASS_OUT"
msgid "Oh. I believe it broke."
msgstr "哦，我认为它坏掉了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CRAFTING_FAIL"
msgid "I am lacking the required ingredients."
msgstr "我缺少必需的材料。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DAMP"
msgid "I've been lightly spritzed."
msgstr "我被水花溅湿了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DEERCLOPS"
msgid "I do not like that sound one bit!"
msgstr "我一点也不喜欢那声音！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DESPAWN"
msgid "I'm going to the kitchen in the sky."
msgstr "我要去天空的厨房。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Erm... I think I'm more of a food lover than a fighter after all."
msgstr "啊...我是美食爱好者，不是战士。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Oh well, I prefer natural gas over electric anyway."
msgstr "没事，反正我比起电来更喜欢天然气。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Is it getting a bit soggy in here?"
msgstr "是有点发潮了吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Ah... I've gone from tough to tender."
msgstr "啊...我已经从强硬变得温柔。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Oh dear, I seem to be getting a bit tired after all..."
msgstr "噢，天啊，我还是开始有点累了……"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "Ah non, I think I'm losing steam."
msgstr "啊不好，干劲没那么强了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "I hope that helps."
msgstr "我希望能有所帮助。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DUSK"
msgid "The dinner hour approaches."
msgstr "晚餐时间快到了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.COOKED"
msgid "Not very palatable."
msgstr "不是很美味。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.DRIED"
msgid "A bit dry."
msgstr "有点干。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.GENERIC"
msgid "Magnifique!"
msgstr "好棒！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.INVALID"
msgid "Clearly inedible."
msgstr "明显不能吃。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PAINFUL"
msgid "Aarg! My stomach..."
msgstr "啊！我的胃..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PREPARED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PREPARED"
msgid "Delectable!"
msgstr "很可口！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.RAW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.RAW"
msgid "Blech. Completely lacking in every way."
msgstr "呸，哪方面都差点火候。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_1"
msgid "I'd prefer some variety."
msgstr "我希望食物的口味丰富点。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_2"
msgid "So bland."
msgstr "平淡无味。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_3"
msgid "I want to eat something different."
msgstr "我想吃点别的东西。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_4"
msgid "I can't stand this food."
msgstr "我受不了这种食物了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_5"
msgid "Enough already!"
msgstr "吃腻了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SPOILED"
msgid "Blech! Why did I allow that to cross my lips?"
msgstr "呸！我怎么会吃下这种东西的？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.STALE"
msgid "That was past its best-by date..."
msgstr "这东西过了最佳食用日期..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.TASTY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.TASTY"
msgid "Tres magnifique!"
msgstr "太美味了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.YUCKY"
msgid "I'm frankly offended by the mere suggestion."
msgstr "光提议都是对我的侮辱。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EATING_NOT_FEASTING"
msgid "The others might enjoy this!"
msgstr "其他人也许会喜欢！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.1"
msgid "I'm not... built for this..."
msgstr "我不是...扛重物的料..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.2"
msgid "I bet... this is burning some calories..."
msgstr "我打赌，肯定能燃烧一些卡路里……"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.3"
msgid "Oof!"
msgstr "见鬼！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.4"
msgid "Hrrrr..."
msgstr "啊…"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.5"
msgid "Mon dieu!"
msgstr "我的天啊！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.6"
msgid "I'm working up... an appetite!"
msgstr "劳动后……胃口大增！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.7"
msgid "So... heavy!"
msgstr "好...重！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.8"
msgid "I am strong... like flour!"
msgstr "我像强筋面粉……一样强壮！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.9"
msgid "HRR!"
msgstr "哈！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_DARK"
msgid "Darkness, darkness."
msgstr "黑暗，黑暗。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_LIGHT"
msgid "A new day comes with the dawning light."
msgstr "新的一天随曙光到来。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FAN_OUT"
msgid "It fell apart in my hands!"
msgstr "它在我手中破碎！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "If it goes into the food we eat, I suppose I should know everything about it."
msgstr "如果它关于进入我们吃的食物，我想我应该知道有关它的一切。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Mon dieu, I feel as though my insides are boiling!"
msgstr "我的天啊，我觉得我的五脏六腑都在沸腾!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "This strange heat... I wonder if this is how crabs feel when they're boiled."
msgstr "这种奇怪的热量……不知道螃蟹被煮是不是就是这样的感觉。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew, I'm very glad that's over."
msgstr "呼，我很高兴这一切都结束了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLARE_SEEN"
msgid "What's this? Someone's trying to get our attention."
msgstr "这是什么？有人在试图引起我们的注意。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FREEDOM"
msgid "Freeeeeeee!"
msgstr "自——由！！！！！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOSTDRAIN"
msgid "My, I have a headache."
msgstr "哎呀，我头疼。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HIGHRESEARCH"
msgid "My brain is tingling!"
msgstr "我的大脑在嗡嗡作响！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOT"
msgid "I'm baking like a soufflé here..."
msgstr "我被这里的高温烤成了蛋奶酥..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOUNDS"
msgid "I recognize that sound. Hunger."
msgstr "我认得那个声音。饥饿的。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNGRY"
msgid "I need food..."
msgstr "我需要食物..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Game is close at hand..."
msgstr "猎物近在咫尺..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I have lost the trail."
msgstr "我失去了它的踪迹。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The trail has been washed out."
msgstr "踪迹被水冲掉了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It requires more manure."
msgstr "它需要更多肥料。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_INV_FULL"
msgid "I cannot carry another stitch."
msgstr "我带不了更多东西了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_IS_FEASTING"
msgid "Winter's Feast is served!"
msgstr "冬季盛宴已上桌！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Something's coming!"
msgstr "有东西过来了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_ENRAGE"
msgid "Our egg's been beat! Run!"
msgstr "危如累卵！快跑！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its shackles fell away!"
msgstr "它的镣铐掉下来了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KNOCKEDOUT"
msgid "My head... spinning..."
msgstr "我的脑袋...天旋地转..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "That was much too close!"
msgstr "那也太悬了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LOWRESEARCH"
msgid "I did not learn any new tricks from that."
msgstr "我从这里没学到任何新技巧。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Nearly there, mon ami!"
msgstr "快挖完了，我的朋友！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Something looks to be trapped inside."
msgstr "好像有东西困在里面。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Taste sweet freedom!"
msgstr "品尝甜蜜的自由吧！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Nearly there, mon ami!"
msgstr "就快挖完了，我的朋友！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Something looks to be trapped inside."
msgstr "好像有东西困在里面。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Taste sweet freedom!"
msgstr "品尝甜蜜的自由吧！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Nearly there, mon ami!"
msgstr "快挖完了，我的朋友！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Something looks to be trapped inside."
msgstr "好像有东西困在里面。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Taste sweet freedom!"
msgstr "品尝甜蜜的自由吧！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONPOTION_FAILED"
msgid "Perhaps that is for the best."
msgstr "也许是为了顾全大局。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOSQUITOS"
msgid "Disease with wings!"
msgstr "长翅膀的疾病传播者！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "My poor sirloin's not looking so good!"
msgstr "我可怜的西冷看起来不太好！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERAFK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERAFK"
msgid "Non, I must defend myself!"
msgstr "不，我必须保护自己！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERGIFT"
msgid "I would like to not die first."
msgstr "可以的话，我不想先死。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSIESTA"
msgid "This is no time to close my eyes!"
msgstr "没时间阖眼了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSLEEP"
msgid "In this particular instance I'd prefer not to die in my sleep!"
msgstr "在这样的特殊情况下，我才不想在睡梦中死去！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP"
msgid "It is too bright to sleep."
msgstr "太亮了，睡不着。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not tired."
msgstr "我不累。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSIESTA"
msgid "I could use a nice meal first."
msgstr "我需要先吃点像样的东西。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSLEEP"
msgid "My hunger trumps my exhaustion."
msgstr "虽然我很困，但是我更饿。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOMOUNTEDGIFT"
msgid "First I should get down from this big sirloin here."
msgstr "我得先从这个大西冷上下来。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA"
msgid "Siesta in the dark? I think not."
msgstr "在黑夜午休？还是不要了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "This does not strike me as a relaxing place for siesta."
msgstr "我并不认为这是一个能让我安心午休的地方。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPONFIRE"
msgid "I think not! That's a hotbed for danger!"
msgstr "不！那就是找死！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Fire!"
msgstr "烧着了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_TRAP"
msgid "Went off without a hitch."
msgstr "进展顺利。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Ah non, that was terrible!"
msgstr "啊不，简直太糟了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "You have escaped my crockpot for now, mon ami."
msgstr "你暂时逃过了我的锅，我的朋友。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Fishing requires lots of patience."
msgstr "钓鱼需要极大的耐心。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Fish! Wouldn't you like to sample my hook?"
msgstr "鱼儿啊！不想试吃下我的鱼钩吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Hum dum dee da..."
msgstr "哈嗒嘀嗒……"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I wonder if there's a better spot elsewhere."
msgstr "可能换个点钓比较好。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah, zut! I've lost my tackle."
msgstr "啊，不好！渔具丢了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "I should tighten my line a bit."
msgstr "我应该拉紧鱼线。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Oh? What could that be?"
msgstr "喔？是什么东西呢？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PECKED"
msgid "Gah! Enough!"
msgstr "啊！受够了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PETRIFED_TREES"
msgid "Are the trees making that sound?"
msgstr "这些树在叫么？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "It has a most un-delicious smell."
msgstr "它有一股很不美味的味道。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RANDOMSEED"
msgid "I wonder what it will turn out to be."
msgstr "我好奇它会长成什么物种。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I've learned a little something about this plant."
msgstr "我学到了一点这种植物的知识了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_QUAKE"
msgid "That is not a comforting sound..."
msgstr "这声音听起来不妙..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REPELLED"
msgid "I can't get through!"
msgstr "我过不去！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RESEARCH"
msgid "Education is a lifelong process."
msgstr "活到老，学到老。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Do I smell pie?"
msgstr "这是蛋糕的味道吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Et voilà!"
msgstr "就是这样！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, mon amie."
msgstr "等等，我的朋友。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.1"
msgid "Mon empereur!"
msgstr "吾皇万岁！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.2"
msgid "Your grace."
msgstr "向陛下致敬。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.3"
msgid "Your excellency."
msgstr "阁下好。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RUINS_RESET"
msgid "The terrible monsters are back!"
msgstr "恐怖的怪物回来了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_NO"
msgid "Apologies for my shortcomings."
msgstr "我为我的缺点道歉。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_YES"
msgid "Merci beacoup!"
msgstr "非常感谢！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHELTER"
msgid "I am thankful for this tree's protective buffer."
msgstr "我很感谢这棵树的庇护。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED"
msgid "Ouch! How rude!"
msgstr "喂！真粗鲁！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED_IVY"
msgid "You think you can come between me and my fresh ingredients, mon ami?"
msgstr "你以为你能阻挡我获得新鲜食材吗，朋友？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SOAKED"
msgid "I'm wetter than a dish rag!"
msgstr "我比抹布还湿！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SPOOKED"
msgid "Eee!"
msgstr "咦！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Bonjour! Parlez-vous francais?"
msgstr "你好！你会说法语吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "May you grow big, ripe and delicious."
msgstr "愿你长得又大又熟又好吃。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "My, you look fresh as a daisy today mon ami!"
msgstr "我的天，你今天看起来像雏菊一样清新，我的朋友!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "What a good little plant you are."
msgstr "多么优秀的小植物。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "How are you today, mon ami? Everything growing well?"
msgstr "我的朋友，你今天好吗？事情都顺利吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_THORNS"
msgid "Gah!"
msgstr "啊呀！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_THURIBLE_OUT"
msgid "Out of fuel."
msgstr "没燃料了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPED"
msgid "It's going to leave soon."
msgstr "它很快要离开了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPING"
msgid "Was it something I said?"
msgstr "是我说错了什么吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_SLIP"
msgid "Everything is slick..."
msgstr "什么东西都滑溜溜的..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TORCH_OUT"
msgid "Come back, light!"
msgstr "光明，回来吧！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Bonjour! I've arrived!"
msgstr "你好！我到了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TRAP_WENT_OFF"
msgid "Darn!"
msgstr "该死！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_UNIMPLEMENTED"
msgid "It is not operational yet."
msgstr "还没开始运转。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WASHED_ASHORE"
msgid "Land! I'm saved!"
msgstr "陆地！我得救了！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEAK_RAT"
msgid "Quel dommage, I think it's gone off."
msgstr "不甚唏嘘，恐怕它已经变质啊。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "重量：{weight}"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEnough fish to feed an entire crew!"
msgstr "重量: {weight}\n这么多鱼都够喂饱一船人了!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WET"
msgid "I am getting positively drenched."
msgstr "我要湿透了。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WETTER"
msgid "I fear I may be water soluble!"
msgstr "我害怕自己会被水溶解掉！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Ah, just missed!"
msgstr "啊，完美错过！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Perhaps I'll try again."
msgstr "也许我该再试试。"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Mon dieu, my world is aglow!"
msgstr "我的天啊，我的世界在发光！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Ah non, is it over already?"
msgstr "喔不，这就完了吗？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WORMHOLE"
msgid "I must be unhinged to travel so..."
msgstr "我一定是精神错乱了才会穿越去别处，所以..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WORMS"
msgid "Huh? What's that?"
msgstr "啊？那是什么？"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Ah, bon! A new flavor of beefalo costume!"
msgstr "啊，妙极了！全新口味的皮弗娄牛礼服！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.DEER"
msgid "Oh, it's venisON!"
msgstr "哈，有鹿肉吃了！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.GENERIC"
msgid "I'm also an accomplished butcher!"
msgstr "我还是一个熟练的屠夫！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.PIG"
msgid "No part of you will go to waste, cochon!"
msgstr "你这只猪，你身上的任何部位都不会浪费！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.PREY"
msgid "You look delicious!"
msgstr "你看起来很美味！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.SPIDER"
msgid "I hope it does not rain after I kill you!"
msgstr "希望我除掉你后，天不会下雨！"

#. STRINGS.CHARACTERS.WARLY.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WARLY.BATTLECRY.SPIDER_WARRIOR"
msgid "You will die, pest!"
msgstr "准备好被收拾吧，讨厌的虫子！"

#. STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.GENERIC"
msgid "There's no shame in running!"
msgstr "逃跑没什么可耻的！"

#. STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.PIG"
msgid "Noooo, those hocks, those chops..."
msgstr "别走，亲爱的肘子和猪扒..."

#. STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.PREY"
msgid "Whew. I'm out of breath."
msgstr "呼，我喘不过气来了。"

#. STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.SPIDER"
msgid "I hope it didn't take any bites out of me."
msgstr "我希望它没有咬到我。"

#. STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WARLY.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "That could have been worse."
msgstr "情况原本可能更糟糕的。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "你好，阿比盖尔小姐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "I don't think it's edible."
msgstr "应该不能吃。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "What now, Mademoiselle Wendy?"
msgstr "然后呢，温蒂小姐？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think it's my place to be holding this."
msgstr "我不应该拿着这个吧。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Something's stirring inside."
msgstr "里面有东西在动。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "Bonjour? Anyone there?"
msgstr "你好？有人在吗?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Ah, you are looking quite well today little flower!"
msgstr "啊，小花啊，你今天看着非常漂亮！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Something's stirring inside."
msgstr "里面有东西在动。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "I think it's waking up."
msgstr "我觉得它要醒了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "I get the feeling something will happen soon."
msgstr "我感到很快要有事发生了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I always wished to make a name for myself."
msgstr "我一直希望扬名立万。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN"
msgid "It rattles."
msgstr "里面有响动。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_COOKED"
msgid "This could use something... Anything."
msgstr "这个可以加点什么...什么都可以。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_SAPLING"
msgid "Just a petite bébé."
msgstr "是一个小宝宝。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ADVENTURE_PORTAL"
msgid "What fresh devilment is this?"
msgstr "这又是什么新鲜的恶作剧？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHAT"
msgid "It makes me hear such sweet whispers..."
msgstr "那能让我听到甜蜜的低语……"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It's been broken down to its basic ingredients."
msgstr "它已被分解成了基本成分。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's gobbling up all the energy!"
msgstr "它吃掉了所有能量！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Au revoir."
msgstr "别了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "It looks rather irritated..."
msgstr "它看起来像被惹毛了……"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "At last, it's finished. Or is it..."
msgstr "它总算玩完了。难道没有么……"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Mon dieu, a second course!"
msgstr "我的天啊，又是一道大菜！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "I will not be skewered by the likes of you!"
msgstr "我才不会被你这种货色串起来当肉烤！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "I'd rather not be fried by that fiery gaze!"
msgstr "我可不想被那火热的注视给烧焦！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Finalement, it's over."
msgstr "天下没有不散的筵席，结束了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Is there more yet in store for us?"
msgstr "还有几个菜，一起上吧？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Best to keep far away from those, non?"
msgstr "最好离那些远一点，不是吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.AMULET"
msgid "I wear safety."
msgstr "我戴着平安符。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR"
msgid "Now you stay put!"
msgstr "你就这儿待着吧！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR_ITEM"
msgid "Looks like a recipe for an anchor."
msgstr "看着像船锚的配方。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR"
msgid "A structure from antiquity."
msgstr "一座古迹。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It is broken."
msgstr "它坏掉了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_STATUE"
msgid "It gives off strange vibrations."
msgstr "它在奇怪地振动。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANIMAL_TRACK"
msgid "These tracks point to fresh game."
msgstr "这些踪迹指向野味。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTCHOVIES"
msgid "Mmmm you'd be delectable in a soup!"
msgstr "嗯，你做汤会很美味！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.GENERIC"
msgid "I think it's friendly."
msgstr "我觉得它很友好。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.UNHAPPY"
msgid "Oh no, don't be mad."
msgstr "哦，不！别生气！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Life is good right now."
msgstr "现在生活很美好。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANTLIONTRINKET"
msgid "I think I know someone who would want this."
msgstr "我应该认识想要这个的人。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "Excusez-moi, sorry to disturb you!"
msgstr "请原谅我的打扰！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Hm, it seems to be missing a key ingredient."
msgstr "嗯，它似乎缺少了一味关键原料。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Tragique."
msgstr "真是个悲剧。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "A masterpiece takes time."
msgstr "经典之作是需要时间的。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Nearly there..."
msgstr "就快好了..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Ahh, fini!"
msgstr "啊，终于出炉了！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "The ones who lived here had good taste in cookware."
msgstr "在这里住过的人对厨具的品位非常好。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Perhaps it contains an ancient recipe of some kind."
msgstr "它里面也许有古代的食谱。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "I wonder what this machine will cook up for us."
msgstr "不知道这台机器会给我们煮出什么东西来。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "This looks like it hasn't been used in a long time."
msgstr "这个好像很久没有用过了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "They seemed to think quite highly of the moon."
msgstr "这里的人似乎很崇尚月亮。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Ah, I shouldn't have gotten my hopes up."
msgstr "啊，我不应该让自己有那么高的期望。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Could this be a way home?"
msgstr "这个能带我回家吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Let's see where this takes us, non?"
msgstr "来看看它会通往哪里吧，好不好？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "C'est fini."
msgstr "完成了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "I cooked it up with a dash of ancient knowledge."
msgstr "我用古代知识来制作出了它。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "I'm afraid its meaning is lost on me."
msgstr "恐怕我不明白它的含义。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "So many secrets lost to time."
msgstr "很多秘密都被时间遗忘了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "I'm afraid its meaning is lost on me."
msgstr "恐怕我不明白它的含义。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "So many secrets lost to time."
msgstr "很多秘密都被时间遗忘了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "I'm afraid its meaning is lost on me."
msgstr "恐怕我不明白它的含义。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "How strange!"
msgstr "真是离奇！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It's quiet."
msgstr "它很安静。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "C'est beau! I wonder where it's going?"
msgstr "真漂亮！我想知道它要去哪里？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It's missing a key ingredient."
msgstr "缺少一味关键成分。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "The gems seem to be important."
msgstr "这些宝石似乎很重要。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORDRAGONFLY"
msgid "Heavy and hot."
msgstr "又热又沉。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORGRASS"
msgid "How much protection can grass really provide?"
msgstr "草究竟能提供多少保护？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORMARBLE"
msgid "Weighs a ton."
msgstr "太重了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORRUINS"
msgid "Ancient armor."
msgstr "古代的铠甲。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSKELETON"
msgid "I'm supposed to put that on?"
msgstr "要我戴这个吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSLURPER"
msgid "Ah. My appetite wanes under its protection."
msgstr "啊，在它的保护之下我的食欲下降了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORSNURTLESHELL"
msgid "It allows me to turtle."
msgstr "穿上这个，我可以假装成蜗牛。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMORWOOD"
msgid "Sturdy, but quite flammable."
msgstr "坚固，但相当易燃。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMOR_BRAMBLE"
msgid "I'll have to be very careful putting it on."
msgstr "我戴上它时，要十分谨慎。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARMOR_SANITY"
msgid "Am I crazy to wear this?"
msgstr "我穿这个是疯了吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Crisp, non?"
msgstr "脆不脆？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "This must be a sign."
msgstr "这是一个标识。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "I'll write a nice note for the next person."
msgstr "我会为下一个人好好写段提醒。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Overcooked."
msgstr "火候过头了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "This must be a sign."
msgstr "这是一个标识。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "I'll write a nice note for the next person."
msgstr "我会为下一个人好好写段提醒。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.GENERIC"
msgid "I miss ash covered cheeses. I miss cheeses, period."
msgstr "我想念抹灰奶酪，我想念奶酪。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone was sacrificed in my travels."
msgstr "眼骨在我旅行的途中化成了灰烬。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The unusual flower is but ash now."
msgstr "奇异的花现在不过是飞灰。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "It is no more."
msgstr "它不存在了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS"
msgid "Sparrow grass!"
msgstr "芦笋！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUSSOUP"
msgid "Ah, a special dish."
msgstr "啊, 一道特色菜."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_COOKED"
msgid "Roasted asparagus. What a treat!"
msgstr "烤芦笋。真是一顿美餐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Tres bon! You will make a lovely dish!"
msgstr "太好了！你可以做成一道可爱的菜！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ASPARAGUS_SEEDS"
msgid "These will grow some nice fresh vegetables."
msgstr "它会长出一些新鲜的蔬菜。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "I think it's charging up."
msgstr "我觉得它要充能完毕了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It's in a recovery period."
msgstr "处在恢复期。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Something unsafe is happening."
msgstr "不安全的事情正在发生。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.OFF"
msgid "All the pieces are back in place."
msgstr "所有部件都归位了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.ON"
msgid "It's ready."
msgstr "准备就绪了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_KEY"
msgid "This seems very precious."
msgstr "看起来十分宝贵。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "Off, for now."
msgstr "暂时灭了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "There's a strange force behind this."
msgstr "它的后面似乎有一种神秘力量。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Is this a language of some sort?"
msgstr "是一种语言吗？"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of lots of unprepared seafood. I'm hungry."
msgstr "一副画满生猛海鲜的画。我饿了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This tablet's all worn down."
msgstr "陈旧不堪。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "The world is flooded by a finely fermented black bean sauce."
msgstr "一种精致发酵的黑豆酱淹没了这个世界。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The prawns being de-shelled."
msgstr "对虾正在被去壳。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "The prawns have ascended into deliciousness."
msgstr "对虾升华成了珍馐。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_STATUE"
msgid "When I turn my back, I imagine I hear it breathing."
msgstr "蓦然回首，似乎听到了它的呼吸。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.AXE"
msgid "A trusty companion in these environs."
msgstr "在郊外，它是值得信赖的同伴。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "I have mixed feelings about veal."
msgstr "我对小牛肉的感情有些复杂。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Bonne nuit, baby steak."
msgstr "晚安，牛仔排。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BACKPACK"
msgid "It has my back."
msgstr "它在背后支持我。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BACONEGGS"
msgid "Runny eggs... crisp bacon... I could die happy now..."
msgstr "溏心蛋...香脆的培根...我现在幸福死了..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BALLOON"
msgid "How colorful!"
msgstr "五颜六色！"

