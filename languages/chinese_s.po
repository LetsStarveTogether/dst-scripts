msgstr "我个人更喜欢木头。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "Nah. Something long and thin goes there, but not this."
msgstr "不是。某样又长又细的东西去了那里，但不是这个。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "I'll wait until the danger's passed."
msgstr "我先等危险过去。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "Could use a cleaning first."
msgstr "可以先清理一下。"

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
