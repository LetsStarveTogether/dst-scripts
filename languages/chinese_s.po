msgstr "即将打出的弹药。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_MARBLE"
