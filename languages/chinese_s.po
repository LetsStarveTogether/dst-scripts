msgstr "可爱的小鸟。以前从没见过。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUFFIN.HELD"
