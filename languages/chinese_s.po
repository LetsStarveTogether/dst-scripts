msgstr "呃，我不想靠太近。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_SMALL.GENERIC"
