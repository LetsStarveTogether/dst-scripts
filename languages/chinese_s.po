msgstr "这应该够它忙活一阵了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
