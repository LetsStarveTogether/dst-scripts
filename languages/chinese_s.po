msgstr "不是我用的工具。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
