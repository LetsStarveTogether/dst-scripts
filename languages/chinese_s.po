msgstr "啊，它跑开了……"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
