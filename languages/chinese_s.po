msgstr "嗷，你是不是个小可爱啊？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SMALLMEAT"
msgid "A tiny chunk of dead animal."
msgstr "一小块动物尸体。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SMALLMEAT_DRIED"
msgid "A little jerky."
msgstr "一小块肉干。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNAPPER"
msgid "This one's got bite."
msgstr "这家伙会咬人。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SNURTLE"
msgid "He's less gross, but still gross."
msgstr "他不算太恶心，但还是恶心。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Now we wait for science to do its work."
msgstr "现在我们就等着科学来做它的工作。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "That stomach-churning smell means it's working!"
msgstr "那股令人作呕的味道说明它起作用了!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER.STALE"
msgid "It's creating what we scientists call a chemical reaction!"
msgstr "它在制造我们科学家所说的化学反应!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "That's some strong science!"
msgstr "这可是很强的科学！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPAT"
msgid "What a crusty looking animal."
msgstr "看起来脾气暴躁的动物。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR"
msgid "That's one pointy stick."
msgstr "好尖的一根棍子。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_GUNGNIR"
msgid "I could do a quick charge with that."
msgstr "我可以用它快速充电。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_LANCE"
msgid "It gets to the point."
msgstr "它直击要害。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPEAR_WATHGRITHR"
msgid "It feels very stabby."
msgstr "它看起来很能戳。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICEPACK"
msgid "A breakthrough in culinary science!"
msgstr "烹饪科学的突破！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_CHILI"
msgid "A flagon of fiery fluid."
msgstr "一壶液体火焰。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_GARLIC"
msgid "A powerfully potent powder."
msgstr "威力强大的粉末。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_SALT"
msgid "A little sodium's good for the heart."
msgstr "适量的钠对心脏有好处。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPICE_SUGAR"
msgid "Sweet! It's sweet!"
msgstr "甜！真甜！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.DEAD"
msgid "Ewwww!"
msgstr "恶心！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.GENERIC"
msgid "I hate spiders."
msgstr "我讨厌蜘蛛。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER.SLEEPING"
msgid "I'd better not be here when he wakes up."
msgstr "他醒来的时候我最好不要在这里。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERDEN"
msgid "Sticky!"
msgstr "真黏！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDEREGGSACK"
msgid "I hope these don't hatch. Period."
msgstr "我希望这些不会孵化。仅此而已。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERGLAND"
msgid "It has a tangy, antiseptic smell."
msgstr "它有一股强烈的防腐剂的味道。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHAT"
msgid "I hope I got all of the spider goo out of it."
msgstr "我希望把蜘蛛的黏性物质都弄掉了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHOLE"
msgid "It's encrusted with old webbing."
msgstr "它外面盖满了蛛网。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERHOLE_ROCK"
msgid "It's encrusted with old webbing."
msgstr "它外面盖满了蛛网。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERQUEEN"
msgid "AHHHHHHHH! That spider is huge!"
msgstr "啊啊啊！那只蜘蛛真巨大！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_DROPPER"
msgid "Note to self: Don't look up."
msgstr "自我提醒：别向上看。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_HIDER"
msgid "Gah! More spiders!"
msgstr "哇！更多蜘蛛！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Is it really dead?"
msgstr "真的死了吧？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "Oh good. The moon mutated it."
msgstr "好的，月亮让它产生了变异。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "Thank science, it stopped moving."
msgstr "感谢科学，终于不动了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_SPITTER"
msgid "I hate spiders!"
msgstr "我讨厌蜘蛛！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Good riddance!"
msgstr "终于摆脱了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "Looks even meaner than usual."
msgstr "看起来比平常的蜘蛛更凶恶。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "I should keep my distance."
msgstr "我应当保持距离。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FISH"
msgid "I'm not terribly curious about the smell."
msgstr "我不太想知道那种气味是怎么来的。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FOOD"
msgid "It's a furry ball of rotten food."
msgstr "那是长满毛毛的腐烂食物。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Hasn't a care in the world."
msgstr "在这世上已了无牵挂。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I'll keep a little light in my pocket."
msgstr "我要在口袋里装一点光。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_MOON"
msgid "I'll keep as mushroom between me and those spores as I can."
msgstr "我要尽量离这些孢子远一点。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "That's a sight for spore eyes."
msgstr "那是孢子的眼睛看到的景象。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_SMALL.HELD"
msgid "I'll keep a little light in my pocket."
msgstr "我要在口袋里装一点光。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_TALL.GENERIC"
msgid "It's just drifting around."
msgstr "它四处飘荡。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPORE_TALL.HELD"
msgid "I'll keep a little light in my pocket."
msgstr "我要在口袋里装一点光。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SQUID"
msgid "I have an inkling they'll come in handy."
msgstr "我有预感会派上用场。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFFCOLDLIGHT"
msgid "Brr! Chilling."
msgstr "呃！令人寒心。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFFLIGHT"
msgid "That seems really dangerous."
msgstr "那似乎非常危险。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAFF_TORNADO"
msgid "Spinning doom."
msgstr "旋转的毁灭之力。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAGEHAND.AWAKE"
msgid "Just keep your hand to yourself, alright?"
msgstr "总之不要伸出你的手，好吗？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STAGEHAND.HIDING"
msgid "Something's odd here, but I can't put my finger on it."
msgstr "这里有些古怪，但我说不出所以然。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALAGMITE"
msgid "Looks like a rock to me."
msgstr "我看它就是块石头。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALAGMITE_TALL"
msgid "Rocks, rocks, rocks, rocks..."
msgstr "石头，石头，石头，石头..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER"
msgid "The skeleton fused with the shadows!"
msgstr "骨架和暗影融合在一起！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER_ATRIUM"
msgid "Why'd it have to be so big?"
msgstr "为什么它必须这么大呢？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STALKER_MINION"
msgid "Anklebiters!"
msgstr "会咬到脚踝！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "I broke it. For science."
msgstr "打碎了，那是为了科学。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "I'm not sure what that's supposed to be."
msgstr "我不确定那是什么东西。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEHARP"
msgid "What happened to the head?"
msgstr "他的头怎么了？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUEMAXWELL"
msgid "He's a lot shorter in person."
msgstr "他本人还要矮一点。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "It's a fancy marble statue."
msgstr "高级的大理石雕像。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Don't lose your head now!"
msgstr "不要失去理智！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "Statuesque."
msgstr "雕像般的。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "I wonder who the artist is."
msgstr "我想知道是哪个艺术家的作品。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEELWOOL"
msgid "Scratchy metal fibers."
msgstr "粗糙的金属纤维。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEERINGWHEEL"
msgid "I could have been a sailor in another life."
msgstr "来世要做一名水手。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "That's going to be the steering wheel."
msgstr "它能做成方向舵。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STINGER"
msgid "Looks sharp!"
msgstr "看起来很尖锐！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STRAWHAT"
msgid "Hats always ruin my hair."
msgstr "帽子总是会弄乱我的发型。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STUFFEDEGGPLANT"
msgid "It's really stuffing!"
msgstr "真的塞满了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STUFFING"
msgid "That's the good stuff!"
msgstr "都是好料！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_PICKED"
msgid "I could eat that, but I'd rather not."
msgstr "我能吃那个，但我不想吃。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_PLANT"
msgid "Aloe there."
msgstr "那里有芦荟。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUCCULENT_POTTED"
msgid "A succulent in a pot."
msgstr "盆里的多肉植物。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "The real treasure is the treasure we found along the way."
msgstr "真正的宝物是我们在寻宝过程中的成长。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "It's clammed right up!"
msgstr "贝壳闭上了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SUPERTACKLECONTAINER"
msgid "I had to shell out quite a bit to get this."
msgstr "我费了九牛二虎之力才弄到手的。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SURFNTURF"
msgid "It's perf!"
msgstr "太完美了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEATERVEST"
msgid "This vest is dapper as all get-out."
msgstr "这件背心十分体面。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEETPOTATO"
msgid "Science has created a hybrid between dinner and dessert."
msgstr "科学创造出了晚餐和甜点的完美混合物。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SWEETTEA"
msgid "A nice cup of tea to forget all my problems."
msgstr "一杯好茶，让我忘记所有的问题。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Who would do such a thing?"
msgstr "谁会做这种事？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "A feastival table."
msgstr "节庆餐桌。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "Time to eat!"
msgstr "吃饭时间到了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "It's not the season for that."
msgstr "不是吃这个的季节。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLECONTAINER"
msgid "This extra storage space has me hooked!"
msgstr "这件额外的储存工具钩住了我的注意力。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLESKETCH"
msgid "A picture of some fishing tackle. I bet I could make this..."
msgstr "某种钓具的图片。我打赌我自己就能做……"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TACKLESTATION"
msgid "Time to tackle my reel problems."
msgstr "是时候解决海钓的问题了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TAFFY"
msgid "If I had a dentist they'd be mad I ate stuff like that."
msgstr "如果我去看牙医了，他们知道我这样子吃东西的话会疯掉的。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRD"
msgid "That's a tall bird!"
msgstr "好高的一只鸟！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG"
msgid "Will it hatch?"
msgstr "它会孵化吗？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Delicious and nutritious."
msgstr "美味又营养。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Is it shivering or am I?"
msgstr "是它在哆嗦还是我在哆嗦？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Looks like it's hatching!"
msgstr "看起来它正在孵化！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Are eggs supposed to sweat?"
msgstr "蛋也会出汗吗？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "I have a feeling this is going to take a while..."
msgstr "我感觉这需要一些时间..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "It should hatch any time now."
msgstr "它现在随时要孵出来了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "That's quite an egg!"
msgstr "那真是个不一般的蛋！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "The nest is empty."
msgstr "巢是空的。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TAMALES"
msgid "If I eat much more I'm going to start feeling a bit husky."
msgstr "我要是再多吃一些，也许会变得健壮了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.GENERIC"
msgid "Not a very tall bird."
msgstr "不是很高的鸟。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.HUNGRY"
msgid "You need some food and quick, huh?"
msgstr "你想吃东西想的不行了？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.SLEEPING"
msgid "It's getting some shut-eye"
msgstr "它在眯眼休息。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TEENBIRD.STARVING"
msgid "It has a dangerous look in its eye."
msgstr "它目露凶光。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEBASE.GEMS"
msgid "It needs more purple gems."
msgstr "它需要更多紫宝石。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEBASE.VALID"
msgid "It's ready to go."
msgstr "它准备好了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "With this I can surely pass through space and time!"
msgstr "有了这个，我肯定可以穿越时空！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "This appears to be a nexus to another world!"
msgstr "这好像可以通往另一个世界！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "There's still something missing."
msgstr "还少了些什么东西。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "Soon, the invention will be complete!"
msgstr "很快，这个发明就要大功告成！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_BOX"
msgid "This may control the polarity of the whole universe."
msgstr "这可能控制着整个宇宙的极性。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_CRANK"
msgid "Tough enough to handle the most intense experiments."
msgstr "结实到足以应付最危险的实验。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_POTATO"
msgid "This metal potato contains great and fearful power..."
msgstr "这个金属土豆包含强大而又可怕的力量..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELEPORTATO_RING"
msgid "A ring that could focus dimensional energies."
msgstr "一个可以聚集空间能量的圆环。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TELESTAFF"
msgid "That could reveal the world."
msgstr "那会揭示这个世界。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENT.BURNT"
msgid "Nothing left to sleep in."
msgstr "不剩什么睡觉的东西了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENT.GENERIC"
msgid "I get sort of crazy when I don't sleep."
msgstr "我不睡觉会发疯。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE"
msgid "That looks dangerous."
msgstr "那个看起来很危险。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLESPIKE"
msgid "It's pointy and slimy."
msgstr "它又尖又黏。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLESPOTS"
msgid "I think these were its genitalia."
msgstr "我想这些是它的生殖器。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_GARDEN"
msgid "Yet another slimy pole."
msgstr "又一种黏滑的触手。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR"
msgid "A slimy pole."
msgstr "黏滑的触手。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Little slippery arms."
msgstr "滑溜溜的小触手。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Seems stinky, but worth exploring."
msgstr "似乎很臭，但值得一探。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.THULECITE"
msgid "I wonder where this is from?"
msgstr "我想知道这是哪来的？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.THULECITE_PIECES"
msgid "It's some smaller chunks of Thulecite."
msgstr "更小块的铥矿。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.THURIBLE"
msgid "It smells like chemicals."
msgstr "闻起来像化学试剂。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TILLWEED"
msgid "Out of my garden, you!"
msgstr "你给我滚出我的园子！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TILLWEEDSALVE"
msgid "My salve-ation."
msgstr "我的救赎。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Yeesh! I'm not kissing that!"
msgstr "咦嘘！我不要亲吻那东西！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL.RAGE"
msgid "He's hopping mad now!"
msgstr "它狂跳不止！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Just a hole in the ground."
msgstr "只是地上的一个洞。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "That toadstool's just asking to be cut down."
msgstr "那毒菌只是想被砍掉。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "There's something poking out."
msgstr "有东西伸出来了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO"
msgid "It's red because it's full of science."
msgstr "红色的，满满都是科学。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_COOKED"
msgid "Cooking's easy if you understand chemistry."
msgstr "懂化学的话做饭就非常简单了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_OVERSIZED"
msgid "A tomato of incredible proportions."
msgstr "一颗比例惊人的西红柿。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOMATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "一把古怪的种子。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOPHAT"
msgid "What a nice hat."
msgstr "多好的帽子。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TORCH"
msgid "Something to hold back the night."
msgstr "驱赶黑暗的东西。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOURTIERE"
msgid "Pleased to eat you."
msgstr "很高兴肉食你！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "Ready for departiculation."
msgstr "准备好分离。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "This pyramid controls the sands."
msgstr "这个金字塔控制着沙子。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "A more sane person would walk."
msgstr "更清醒的人会选择步行。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "A mini departiculator."
msgstr "迷你分离器。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAILMIX"
msgid "A healthy, natural snack."
msgstr "健康、天然的小点心。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAILS"
msgid "He's got a strong arm on him."
msgstr "他的胳膊真壮啊。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRANSISTOR"
msgid "It's whirring with electricity."
msgstr "电力让它呼呼作响。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP"
msgid "I wove it real tight."
msgstr "我把它编得很紧密。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_BRAMBLE"
msgid "It'd really poke whoever stepped on it."
msgstr "谁要是踩上去肯定会被戳到。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "It tried to chomp me!"
msgstr "它差点吞了我！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "Aw, what a cute little starfish!"
msgstr "噢，多可爱的一只小海星！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_TEETH"
msgid "This is a nasty surprise."
msgstr "真是糟糕的意外。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "I'll want to avoid stepping on that!"
msgstr "我可不想踩在那上面！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST.BURNT"
msgid "That trunk was truncated."
msgstr "那个箱子被烧掉了一截。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST.GENERIC"
msgid "It's a tickle trunk!"
msgstr "一个工具箱！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREASURECHEST_TRAP"
msgid "How convenient!"
msgstr "真方便！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TREECLUMP"
msgid "It's almost like someone is trying to prevent me from going somewhere."
msgstr "是不是有人想把我困在这里。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRIDENT"
msgid "This is going to be a blast!"
msgstr "等着轰轰轰吧！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_1"
msgid "Melted. Maybe Willow had some fun with them?"
msgstr "融化了。或许薇洛和他们相处愉快？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_10"
msgid "They've quickly become Wes' favorite prop."
msgstr "它们很快成为韦斯喜欢的道具了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_11"
msgid "Hal whispers beautiful lies to me."
msgstr "哈尔向我轻诉美丽的谎言。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_12"
msgid "That's just asking to be experimented on."
msgstr "这是求被试验啊。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_13"
msgid "It must be some kind of religious artifact."
msgstr "一定是某种宗教物品。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_14"
msgid "Now if I only had some tea..."
msgstr "现在要是能喝点茶，该多好..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_15"
msgid "...Maxwell left his stuff out again."
msgstr "...麦斯威尔又落下了他的行头。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_16"
msgid "...Maxwell left his stuff out again."
msgstr "...麦斯威尔又落下了他的行头。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_17"
msgid "A horrifying utensil fusion. Maybe science *can* go too far."
msgstr "令人恐惧的器皿融合。也许科学*会*物极必反。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_18"
msgid "I wonder what it's hiding?"
msgstr "我想知道它在隐藏什么？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_19"
msgid "It doesn't spin very well."
msgstr "结网不是很顺利。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_2"
msgid "What's kazoo with you?"
msgstr "你跟卡祖有什么关系？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_20"
msgid "Wigfrid keeps jumping out and hitting me with it?!"
msgstr "薇格弗德不断跳出去，用那东西打我？！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_21"
msgid "This egg beater is all bent out of shape."
msgstr "这个搅蛋器整个都弯曲变形了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_22"
msgid "I have a few theories about this string."
msgstr "关于这个绳子，我有几个理论。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_23"
msgid "I can put my shoes on without help, thanks."
msgstr "我可以自己穿鞋，谢谢。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_24"
msgid "I think Wickerbottom had a cat."
msgstr "我想薇克巴顿应该有只猫。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_25"
msgid "It smells kind of stale."
msgstr "闻起来有点不新鲜。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_26"
msgid "Food and a cup! The ultimate survival container."
msgstr "食物和杯子！终极生存容器。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_27"
msgid "If you unwound it you could poke someone from really far away."
msgstr "如果你解开它，你可以从远处刺到别人。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_28"
msgid "How Machiavellian."
msgstr "简直就是阴谋。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_29"
msgid "How Machiavellian."
msgstr "简直就是阴谋。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_3"
msgid "The knot is stuck. Forever."
msgstr "那是个死结。永远打不开的结。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_30"
msgid "Honestly, he just leaves them out wherever."
msgstr "他怎么到处乱丢呢。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_31"
msgid "Honestly, he just leaves them out wherever."
msgstr "他怎么到处乱丢呢。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_32"
msgid "I know someone who'd have a ball with this!"
msgstr "我认识喜欢这个的人！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_33"
msgid "I hope this doesn't attract spiders."
msgstr "希望不会引来蜘蛛。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_34"
msgid "Let's make a wish. For science."
msgstr "让我们许个愿望吧。为了科学。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_35"
msgid "Hard to find a good flask around here."
msgstr "很难在这附近找到一个好的烧瓶。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_36"
msgid "I might need these after all that candy."
msgstr "在吃完所有的糖果后我可能会需要这些东西。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_37"
msgid "I don't believe in the supernatural."
msgstr "我不相信超自然现象。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_38"
msgid "I think it came from another world. One with grifts."
msgstr "我想它来自另外一个世界，一个满是欺诈的世界。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_39"
msgid "I wonder where the other one is?"
msgstr "我想知道另一只在哪里？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_4"
msgid "It must be some kind of religious artifact."
msgstr "它一定是某种宗教物品。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_40"
msgid "Holding it makes me feel like bartering."
msgstr "拿着它让我觉得在赶集。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_41"
msgid "It's a little warm to the touch."
msgstr "摸起来有点温热。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_42"
msgid "It's full of someone's childhood memories."
msgstr "它充满了某人的童年记忆。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_43"
msgid "It's not very good at jumping."
msgstr "它不太擅长跳跃。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_44"
msgid "It's some sort of plant specimen."
msgstr "它是某种植物标本。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_45"
msgid "It's picking up frequencies from another world."
msgstr "它正在接收另一个世界的频率。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_46"
msgid "Maybe a tool for testing aerodynamics?"
msgstr "也许是测试空气动力学的工具？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_5"
msgid "Sadly it's too small for me to escape on."
msgstr "不幸的是，它太小了，我没法乘坐它逃离。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_6"
msgid "Their electricity carrying days are over."
msgstr "它们输送电力的日子结束了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_7"
msgid "There's no time for fun and games!"
msgstr "没有时间享乐和游戏！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_8"
msgid "Great. All of my tub stopping needs are met."
msgstr "太好了。堵浴缸的塞子有了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRINKET_9"
msgid "I'm more of a zipper person, myself."
msgstr "我本人更喜欢拉链。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "On a scale of 1 to on fire... that's pretty on fire."
msgstr "如果要给火爆程度打分……全烧起来了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "All my bragging rights, gone up in flames!"
msgstr "我所有吹嘘的资本全都给烧没了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "I wonder how my catch of the day will measure up!"
msgstr "来瞻仰我今天的海钓成绩吧！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "重量: {weight}\n捕获人: {owner}"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nWhat a catch!"
msgstr "重量: {weight}\n捕获人: {owner}\n所获颇丰!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Not to throw my weight around, buuut...\nWeight: {weight}\nCaught by: {owner}"
msgstr "完全没有炫技的意思，大家就随便看看……\n重量: {weight}\n捕获人: {owner}"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nIt's the one that DIDN'T get away!"
msgstr "重量: {weight}\n捕获人: {owner}\n还真抓了条大肥鱼！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Mmm, what's cooking?"
msgstr "这是烧什么菜啊？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "I suppose that wasn't the best way to cook it."
msgstr "我想这不是最好的烹饪方式。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "I can scientifically measure my harvest's heftiness."
msgstr "我可以科学地测算出收获的薄厚。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nNot bad."
msgstr "重量: {weight}\n收获日: {day}\n不赖。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nWho knew they grew that big?"
msgstr "重量: {weight}\n收获日: {day}\n谁能想到会长这么大？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "It's so average the scale isn't even bothering to tell me its weight."
msgstr "它太一般了，秤都懒得告诉我它的重量。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Wilderness casual."
msgstr "荒野休闲装。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNKVEST_WINTER"
msgid "Winter survival gear."
msgstr "冬季生存装备。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_COOKED"
msgid "Somehow even more nasal than before."
msgstr "不知怎么回事比以前更像鼻子了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_SUMMER"
msgid "A light breezy trunk."
msgstr "一根轻快通风的象鼻。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TRUNK_WINTER"
msgid "A thick, hairy trunk."
msgstr "一根肥厚多毛的象鼻。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TUMBLEWEED"
msgid "Who knows what that tumbleweed has picked up."
msgstr "谁知道那个风滚草里裹着什么。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURFCRAFTINGSTATION"
msgid "A true scientist is always breaking new ground!"
msgstr "真正的科学家永远都在开拓新天地！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_ARCHIVE"
msgid "Yet another ground type."
msgstr "又一种地皮类型。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_BADLANDS"
msgid "Yet another ground type."
msgstr "又一种地皮类型。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CARPETFLOOR"
msgid "It's surprisingly scratchy."
msgstr "非常扎人。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CAVE"
msgid "Yet another ground type."
msgstr "又一种地皮类型。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CHECKERFLOOR"
msgid "These are pretty snazzy."
msgstr "这些非常华丽。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DECIDUOUS"
msgid "Yet another ground type."
msgstr "又一种地皮类型。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DESERTDIRT"
msgid "A chunk of ground."
msgstr "一块地皮。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DIRT"
msgid "A chunk of ground."
msgstr "一块地皮。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_DRAGONFLY"
msgid "Do you want proof that it's fireproof?"
msgstr "你想证明它能防火吗？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_FOREST"
