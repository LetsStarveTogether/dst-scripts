msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.GENERIC"
msgid "Enjoying the plush life? Hyuyuyu!"
msgstr "喜欢填的满满的生活吗？哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.YOTB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FESTIVE.YOTB"
msgid "Our judge just may have something to say."
msgstr "我们的评委也许想说两句。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.GENERIC"
msgid "Enjoying the plush life? Hyuyuyu!"
msgstr "喜欢填的满满的生活吗？哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.YOTB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_FORMAL.YOTB"
msgid "Our judge just may have something to say."
msgstr "我们的评委也许想说两句。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.GENERIC"
msgid "Enjoying the plush life? Hyuyuyu!"
msgstr "喜欢填的满满的生活吗？哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.YOTB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_ICE.YOTB"
msgid "Our judge just may have something to say."
msgstr "我们的评委也许想说两句。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.GENERIC"
msgid "Enjoying the plush life? Hyuyuyu!"
msgstr "喜欢填的满满的生活吗？哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.YOTB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_BEEFALO_DOLL_NATURE.YOTB"
