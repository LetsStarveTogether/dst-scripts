msgstr "它现在没用了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SEEDPACKET"
