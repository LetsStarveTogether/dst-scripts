msgstr "没了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAP_SPOILED"
