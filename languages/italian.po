msgstr "Questo fa pompare il sangue!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ENTER_DARK"
