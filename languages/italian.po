msgstr "Solo uno stupido alfiere."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
