msgstr "Ridotto in cenere."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC"
