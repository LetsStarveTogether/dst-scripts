msgid "How do you maintain flight, dear?"
msgstr "Come fai a mantenerti in volo, caro?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_KITTEN"
msgid "Now it feels like home."
msgstr "Ora mi sento a casa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_LAMB"
msgid "I could just squish that widdle face."
msgstr "Spupazzerei quella faccina arricciata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PERDLING"
msgid "What a handsome poult you are!"
msgstr "Ma che bel pollastro che sei!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CRITTER_PUPPY"
msgid "Who's the sweetest little Canis lupus?"
msgstr "Chi è il canis lupus più tenero?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.GENERIC"
msgid "Corvus brachyrhynchos."
msgstr "Corvus brachyrhynchos."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CROW.HELD"
msgid "A perfectly handsome specimen."
msgstr "Un esemplare perfettamente bello."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTGRASS"
msgid "Some grass cuttings."
msgstr "Taglio dell'erba."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTLICHEN"
msgid "This won't last long."
msgstr "Questo non durerà a lungo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTREEDS"
msgid "Some rush cuttings."
msgstr "Dei tagli fatti in fretta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.CUTSTONE"
msgid "Some smoothed rock slabs."
msgstr "Delle lastre di roccia levigata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEADLYFEAST"
msgid "I'm not sure that's good to eat."
msgstr "Non sono sicura che sia buono da mangiare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "The tree is burning."
msgstr "L'albero è in fiamme."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "A carbonized tree."
msgstr "Un albero carbonizzato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "It has been harvested."
msgstr "È stato raccolto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Fagales of some kind. It bears fruit when fully grown."
msgstr "Fagales di qualche tipo. Porta i frutti a completo sviluppo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "That is no tree I've seen before!"
msgstr "Questo non è un albero già visto!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.ANTLER"
msgid "Its antler has grown in for winter."
msgstr "Il suo corno è cresciuto all'interno per l'inverno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER.GENERIC"
msgid "It has shed its antler for the warmer months."
msgstr "Ha perso il suo corno per i mesi più caldi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS"
msgid "Laurasiatheria!"
msgstr "Laurasiatheria!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "I feel a vague sense of accomplishment."
msgstr "Sento un vago senso di realizzazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_ANTLER"
msgid "It looks like a key, but it's quite brittle."
msgstr "Sembra una chiave, ma è piuttosto fragile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEER_GEMMED"
msgid "The poor creature has been forcibly fused to a magic gem."
msgstr "La povera creatura è stata forzatamente fusa con una gemma magica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "A tuft of a graminoid."
msgstr "Un ciuffo di una graminacea."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DESERTHAT"
msgid "Much more effective than reading glasses."
msgstr "Molto più efficace degli occhiali da lettura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIRTPILE"
msgid "Unhygienic!"
msgstr "Antigienico!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.COLD"
msgid "The dial is moving faintly."
msgstr "Il quadrante si muove debolmente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.GENERIC"
msgid "It is a magitechnical homing device."
msgstr "È un dispositivo a inseguimento magitecnico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.HOT"
msgid "Here we are!"
msgstr "Eccoci qua!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARM"
msgid "This is definitely the right track."
msgstr "Questa è sicuramente la traccia giusta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be getting close."
msgstr "Si avvicina sempre di più."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It will need some work before it can function."
msgstr "Bisogna lavorarci prima che possa funzionare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.READY"
msgid "It simply needs a key now."
msgstr "Ora ha bisogno semplicemente di una chiave."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ah. The beauty of functionality."
msgstr "Ah. La bellezza della funzionalità."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DIVININGRODSTART"
msgid "This rod could be useful!"
msgstr "Questa bacchetta potrebbe tornare utile!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONBODYHAT"
msgid "The longer the dragon, the better the luck."
msgstr "Più lungo è il drago, migliore è la fortuna."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLY"
msgid "It's some kind of mythical variant of a Diptera."
msgstr "Si tratta di un tipo di variante mitica di diptera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYCHEST"
msgid "Scales! Scales are the winner!"
msgstr "Squame! Le squame sono il vincitore!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "A very efficient, magically powered furnace."
msgstr "Una fornace molto efficiente alimentata dalla magia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Hm, that was an interesting choice of alteration."
msgstr "È  una scelta di alterazione alquanto interessante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The magic of the two gems keeps it burning at maximum strength."
msgstr "La magia delle due gemme la fa bruciare alla potenza massima."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "It is burning at half strength, presently."
msgstr "Brucia a metà della potenza, al momento."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT"
msgid "Hylocereus undatus, or pitahaya blanca."
msgstr "Hylocereus undatus, o pitahaya blanca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Pleasantly prepared pitahaya blanca."
msgstr "Pitahaya blanca piacevolmente preparata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "A seed for the magnificently mild Hylocereus undatus."
msgstr "Un seme del magnifico hylocereus undatus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONHEADHAT"
msgid "This is the head to the dragon costume."
msgstr "Questa è la testa del costume per travestirsi da drago."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONPIE"
msgid "I do love a nice fruit pie."
msgstr "Amo una bella torta di frutta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGONTAILHAT"
msgid "This is the back of the dragon costume."
msgstr "Questa è la parte posteriore del travestimento da drago."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRAGON_SCALES"
msgid "Scales from an insect? Unheard of!"
msgstr "Squame da un insetto? Inaudito!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK"
msgid "A leg of poultry."
msgstr "Una gamba di pollame."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DRUMSTICK_COOKED"
msgid "Not terribly healthy, but my is it delicious!"
msgstr "Non eccessivamente sano, ma è delizioso!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH"
msgid "It requires soil to grow."
msgstr "Richiede terreno per crescere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "It requires soil to grow."
msgstr "Richiede terreno per crescere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_GRASS"
msgid "It requires soil to grow."
msgstr "Richiede terreno per crescere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_MARSH_BUSH"
msgid "It requires soil to grow."
msgstr "Richiede terreno per crescere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DUG_SAPLING"
msgid "It requires soil to grow."
msgstr "Richiede terreno per crescere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN"
msgid "Aha, the Durio zibethinus. It really does reek."
msgstr "Aha, il durio zibethinus. È davvero puzzolente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_COOKED"
msgid "Cooking this certainly did not improve its odor."
msgstr "Il cucinarlo non ha certamente migliorato il suo odore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.DURIAN_SEEDS"
msgid "Even the seeds of the Durio zibethinus smell a bit."
msgstr "Perfino i semi del durio zibethinus puzzano un po'."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EARMUFFSHAT"
msgid "Poor Leporidae. At least it's warm."
msgstr "Povero leporidae. Almeno è caldo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL"
msgid "It's an eel."
msgstr "È un'anguilla."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EEL_COOKED"
msgid "This eel has been cooked."
msgstr "Questa anguilla è stata cotta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT"
msgid "A nightshade. Solanum melongena, specifically."
msgstr "Una belladonna. Solanum melongena, nello specifico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_COOKED"
msgid "For your enjoyment: Braised Solanum melongena."
msgstr "Per puro piacere: brasato di solanum melongena."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EGGPLANT_SEEDS"
msgid "Seed of aubergine."
msgstr "Semi di melanzana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.BURNT"
msgid "Well, such as it is."
msgstr "Ebbene, questo è quanto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.EMPTY"
msgid "Ah, could use a doily, wouldn't you say?"
msgstr "Ah, potrei metterci un centrino, che ne dici?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "The more light to read by the better, in my opinion."
msgstr "Più luce per la lettura è meglio, a mio parere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.GENERIC"
msgid "It's pleasant to see a little decor out here."
msgstr "È piacevole vedere un po' di arredamento qui."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It is Maxwell's turn to procure bulbs. I've it written down right here."
msgstr "È il turno di Maxwell di procurare le lampadine. Me lo sono segnata qui."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ENDTABLE.WILTED"
msgid "A pity. Shall we find replacements?"
msgstr "Un peccato. Proviamo a sostituirlo?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNING"
msgid "The tree is burning."
msgstr "L'albero è in fiamme."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.BURNT"
msgid "A carbonized tree."
msgstr "Un albero carbonizzato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.CHOPPED"
msgid "It has been harvested."
msgstr "È stato raccolto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN.GENERIC"
msgid "A generically coniferous tree."
msgstr "Una conifera generica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "The tree is burning."
msgstr "L'albero è in fiamme."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "A carbonized tree."
msgstr "Un albero carbonizzato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "It has been harvested."
msgstr "È stato raccolto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "This genus seems to lack reproductive capabilities."
msgstr "Questo genere sembra mancare di capacità riproduttiva."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEBRELLAHAT"
msgid "The cornea must be quite water-repellent."
msgstr "La cornea deve essere abbastanza idrorepellente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYEPLANT"
msgid "I believe they are controlled by the larger plant."
msgstr "Credo che siano controllati dalla pianta più grande."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET"
msgid "The magic of the two beasts has been concentrated by the Thulecite."
msgstr "La magia delle due bestie è stata concentrata dalla tulecite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.EYETURRET_ITEM"
msgid "I'll need to place this."
msgstr "Devo posizionarla."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.BURNT"
msgid "It shan't grow a crop again."
msgstr "Non farà crescere un altro raccolto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GENERIC"
msgid "A small cultivated patch of ground."
msgstr "Un piccolo appezzamento di terra coltivata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.GROWING"
msgid "The plants are extracting minerals from the ground."
msgstr "Le piante estraggono minerali dal suolo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It has been rendered infertile for lack of nutrients."
msgstr "È stato reso sterile per mancanza di sostanze nutritive."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERFAN"
msgid "This will induce quite an airflow!"
msgstr "Ciò provocherà un flusso d'aria notevole!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERHAT"
msgid "Not quite the genuine article, but it might fool some birds."
msgstr "Non proprio un articolo genuino, ma potrebbe ingannare certi pennuti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHERPENCIL"
msgid "Oh, how I missed proper writing implements!"
msgstr "Oh, come mi mancano i veri strumenti di scrittura!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CANARY"
msgid "Feather of Canaria."
msgstr "Piuma di canaria."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_CROW"
msgid "Feather of Corvus."
msgstr "Piuma di corvus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN"
msgid "Feather of Cardinalis."
msgstr "Piuma di cardinalis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "It looks like a feather of Cardinalis, but white."
msgstr "Sembra una piuma di cardinalis, ma bianca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FEM_PUPPET"
msgid "Poor girl."
msgstr "Povera ragazza."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE"
msgid "A simply constructed fence."
msgstr "Un recinto costruito in modo semplice."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE"
msgid "That is a wooden gate."
msgstr "È un cancello di legno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_GATE_ITEM"
msgid "All the components for a wooden gate."
msgstr "Tutti i componenti di un cancello di legno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FENCE_ITEM"
msgid "All the components for a wooden fence."
msgstr "Tutti i componenti di una staccionata di legno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FERTILIZER"
msgid "A bucket of animal feces. Pungent."
msgstr "Un secchio di feci animali. Pungente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREBALLSTAFF"
msgid "Someone experienced with magic ought to wield this. Like myself!"
msgstr "Qualcuno esperto di magia dovrebbe maneggiare questo. Come me!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRECRACKERS"
msgid "A little too noisy for my liking."
msgstr "Un po' troppo rumoroso per i miei gusti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.GENERIC"
msgid "They disperse when I approach."
msgstr "Si disperdono quando mi avvicino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREFLIES.HELD"
msgid "Their bioluminescent properties might prove useful."
msgstr "Le loro proprietà bioluminescenti potrebbero rivelarsi utili."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREHOUND"
msgid "That hound is more dangerous than the others."
msgstr "Quel segugio è più pericoloso degli altri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.EMBERS"
msgid "The fire has almost self-extinguished."
msgstr "Il fuoco si è quasi autoestinto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Una buca per il fuoco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.HIGH"
msgid "That fire is burning at an alarming rate."
msgstr "Quel fuoco sta bruciando a un ritmo allarmante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.LOW"
msgid "The fire could use some more fuel."
msgstr "Servirebbe più combustibile per il fuoco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.NORMAL"
msgid "A perfectly average fire."
msgstr "Un fuoco perfettamente nella media."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIREPIT.OUT"
msgid "It can be re-lit."
msgstr "Può essere ri-acceso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESTAFF"
msgid "Some kind of fire-throwing contraption."
msgstr "Una sorta di aggeggio lanciafuoco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Fuel's getting low."
msgstr "Il carburante si sta esaurendo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Nothing to see here."
msgstr "Niente da vedere qui."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Pitch that ice!"
msgstr "Tira quel ghiaccio!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH"
msgid "Some kind of whitefish, I believe."
msgstr "Una specie di pesce bianco, credo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHINGROD"
msgid "I've read all about fishing. It should be a snap."
msgstr "Ho letto tutto sulla pesca. Dovrebbe essere un gioco da ragazzi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHSTICKS"
msgid "Give me some tartar sauce and I'm in heaven."
msgstr "Dammi un po' di salsa tartara e sono in paradiso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISHTACOS"
msgid "Personally I relish a spot of spice on my fish."
msgstr "Personalemtne apprezzo un pizzico di spezie sul mio pesce."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FISH_COOKED"
msgid "Beautifully grilled."
msgstr "Splendidamente grigliato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLINT"
msgid "A hard nodule of quartz."
msgstr "Un nodulo duro di quarzo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.GENERIC"
msgid "It's a wildflower. I'm unfamiliar with the species."
msgstr "È un fiore selvatico. Non conosco la specie."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER.ROSE"
msgid "Ah, a Rosa Macdub... what's it doing out here?"
msgstr "Ah, una rosa macdub... cosa ci fa qui?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERHAT"
msgid "How celebratory."
msgstr "Molto celebrativo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWERSALAD"
msgid "Plenty of nutrients!"
msgstr "È pieno di sostanze nutrienti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_CAVE"
msgid "You could read by that light."
msgstr "Si potrebbe leggere con quella luce."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_EVIL"
msgid "It's not often one sees a flower with such a powerful aura."
msgstr "Non capita spesso di vedere un fiore con una tale potente aura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FLOWER_WITHERED"
msgid "This flower lacks the essentials for growth."
msgstr "A questo fiore mancano gli elementi essenziali per la crescita."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOLIAGE"
msgid "These may have some nutritional value."
msgstr "Questi possono avere qualche valore nutritivo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOOTBALLHAT"
msgid "Protective gear for full-contact endeavors."
msgstr "Indumenti di protezione per gli sforzi da pieno contatto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_PIECE"
msgid "Hardened remains preserved by taphonomic processes."
msgstr "I resti induriti conservati da processi tafonomici."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Oh! A specimen fit for a museum!"
msgstr "Oh! Un esemplare perfetto per un museo!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Paleontological incompetence has produced a sad excuse for a creature."
msgstr "L'incompetenza paleontologica ha prodotto una patetica scusa per una creatura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "There are pieces of the skeleton still yet to be assembled."
msgstr "Ci sono pezzi dello scheletro ancora da assemblare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.DEAD"
msgid "Considered a delicacy in some countries."
msgstr "È considerata una prelibatezza in alcuni paesi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.GENERIC"
msgid "A amphibian tetrapod."
msgstr "Un tetrapode anfibio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROG.SLEEPING"
msgid "It's sleeping."
msgstr "Sta dormendo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGGLEBUNWICH"
msgid "It was an interesting choice to serve it as a sandwich."
msgstr "È stata una scelta interessante prepararlo come un panino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS"
msgid "They're still twitching a bit."
msgstr "Si stanno ancora contraendo un po'."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FROGLEGS_COOKED"
msgid "Not unlike a chicken wing."
msgstr "Non molto diverso dall'ala di pollo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FRUITMEDLEY"
msgid "What a nice selection of fruit!"
msgstr "Che bella selezione di frutta!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.FURTUFT"
msgid "Fur from a Bearger."
msgstr "Pelliccia di tassorso"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GARGOYLE_HOUND"
msgid "Completely petrified as a result of lunar exposure."
msgstr "Completamente pietrificato in seguito all'esposizione alla luna."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Lunar light catalyzes a strange reaction in its skin."
msgstr "La luce della luna catalizza una strana reazione alla sua pelle."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEARS"
msgid "Various cogs and wheels."
msgstr "Vari ingranaggi e rotelle."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEMSOCKET.GEMS"
msgid "These hold gems."
msgstr "Queste contengono gemme."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GEMSOCKET.VALID"
msgid "What a strange effect."
msgstr "Che strano effetto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GHOST"
msgid "It must be fake. I don't believe it."
msgstr "Deve essere falso. Non ci credo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GIFT"
msgid "Oh goodness, how lovely!"
msgstr "Oh bontà, che carino!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GIFTWRAP"
msgid "Wrapping presents is soothing work, isn't it?"
msgstr "Incartare regali ha un potere lenitivo, vero?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLASSBLOCK"
msgid "I always loved glass sculptures."
msgstr "Ho sempre amato le sculture di vetro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLASSSPIKE"
msgid "Careful, it's sharp."
msgstr "Attenzione, è affilato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMER"
msgid "A bizarre specimen of the insecta class."
msgstr "Un bizzarro esemplare della classe insecta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "It's gone gray, but it's still dripping."
msgstr "È diventato grigio, ma è ancora gocciolante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "It's dripping with goo."
msgstr "È grondante di roba viscida."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERFUEL"
msgid "It appears to be quite volatile."
msgstr "Sembra essere piuttosto volatile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GLOMMERWINGS"
msgid "The pennons of that strange specimen."
msgstr "Le pinne di quello strano esemplare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOATMILK"
msgid "Tantalizing!"
msgstr "Allettante!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOGGLESHAT"
msgid "I can't imagine these improving visibility."
msgstr "Non posso immaginare che questi migliorino la visibilità."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENAXE"
msgid "The most malleable of metals, but let's see how this chops."
msgstr "Il più malleabile dei metalli, ma vediamo come taglia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENPICKAXE"
msgid "The most malleable of metals, but let's see how this mines."
msgstr "Il più malleabile dei metalli, ma vediamo come scava."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENPITCHFORK"
msgid "The most malleable of metals, but let's see how this tills."
msgstr "Il più malleabile dei metalli, ma vediamo come si coltiva."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDENSHOVEL"
msgid "The most malleable of metals, but let's see how this digs."
msgstr "Il più malleabile di metalli, ma vediamo come scava."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOLDNUGGET"
msgid "A small lump of gold. Atomic number 79."
msgstr "Un piccolo nodulo d'oro. Numero atomico 79."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GOOSE_FEATHER"
msgid "Soft body down! It makes me wish I could sleep."
msgstr "Piumino d'oca! Mi fa desiderare di dormire."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.BARREN"
msgid "It needs poop."
msgstr "Ha bisogno di cacca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.BURNING"
msgid "Combustion!"
msgstr "Combustione!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.DISEASED"
msgid "It's afflicted with an agrarian disease beyond my curing."
msgstr "È affetto da una malattia agraria che non sono in grado di curare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.DISEASING"
msgid "Hm... There are spots of discoloration here."
msgstr "Uhm... ci sono macchie di decolorazione qua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.GENERIC"
msgid "A cluster graminoid stalks."
msgstr "Un ciuffo di steli di graminacee."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.PICKED"
msgid "I think it will grow back."
msgstr "Penso che ricrescerà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS.WITHERED"
msgid "It can't survive in this hot climate."
msgstr "Non può sopravvivere in questo clima caldo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "It appears to be infected by some unknown pathogen."
msgstr "Sembra sia infettato da qualche agente patogeno sconosciuto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "I've never encountered this species before. Seems harmless."
msgstr "Non ho mai incontrato questa specie prima. Sembra innocua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GRASS_UMBRELLA"
msgid "A dainty parasol that will provide moderate protection."
msgstr "Un ombrellone delicato che fornirà una protezione moderata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENAMULET"
msgid "Works almost as a magical binding agent."
msgstr "Funziona quasi come un agente vincolante magico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENGEM"
msgid "Chromium impurities have colored this gem green."
msgstr "Le impurità chromium hanno colorato di verde questa gemma."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENMOONEYE"
msgid "That should help us keep our bearings."
msgstr "Dovrebbe aiutarci a mantenere le nostre postazioni."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREENSTAFF"
msgid "It appears to rewind time on an object."
msgstr "Sembra che riavvolga il tempo su un oggetto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_CAP"
msgid "Seems edible, though it may not be totally sane to consume it."
msgstr "Sembra commestibile, anche se potrebbe non essere sano di mente consumarlo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_CAP_COOKED"
msgid "Chemistry has altered it."
msgstr "La chimica lo ha alterato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It is a fungus."
msgstr "È un fungo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "It is dormant this time of day."
msgstr "In questo momento della giornata è dormiente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "It requires hydration before it can fruit again."
msgstr "Richiede idratazione prima di fruttare nuovamente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUACAMOLE"
msgid "I always made guacamole for science day at the library."
msgstr "Faccio sempre il guacamole per la giornata della scienza presso la biblioteca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUANO"
msgid "More metabolic byproduct."
msgstr "Altro sottoprodotto metabolico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.GUNPOWDER"
msgid "Knowledge is power!"
msgstr "La conoscenza è potere!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_1"
msgid "Remember to eat in moderation, children."
msgstr "Ricordatevi di mangiare con moderazione, bambini."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_10"
msgid "How darling!"
msgstr "Che tesoro!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_11"
msgid "I fear I've a terrible weakness for a spot of chocolate."
msgstr "Ho paura di avere una vera debolezza per il cioccolato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_12"
msgid "The candy itself is quite pleasant, if unappealing in appearance."
msgstr "La caramella è piuttosto piacevole, anche se di aspetto non invitante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_13"
msgid "There will be some sore jaws in the morning, I imagine."
msgstr "Ci saranno delle mascelle doloranti al mattino, immagino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_14"
msgid "A delightful ten on the Scoville scale."
msgstr "Un delizioso dieci sulla scala Scoville."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_2"
msgid "Delightfully colored kernels of high fructose corn syrup."
msgstr "Deliziose praline colorate di sciroppo di mais ad alto contenuto di fruttosio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_3"
msgid "Hmm, well, at least there's a healthy option on the table."
msgstr "Hmm, beh, almeno c'è una scelta salutare sul tavolo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_4"
msgid "I was always a fan of black licorice, myself."
msgstr "Sono sempre stata una fan della liquirizia nera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_5"
msgid "It almost seems a shame to eat them."
msgstr "Sembra quasi un peccato mangiarli."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_6"
msgid "I'd prefer none of you eat these at all."
msgstr "Preferirei che nessuno di voi li mangiasse."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_7"
msgid "I'll take the ones you don't want, dears."
msgstr "Prenderò quelli che non volete, cari."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_8"
msgid "How darling!"
msgstr "Che tesoro!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENCANDY_9"
msgid "I had best not hear of any tummy aches later."
msgstr "Sarà meglio che non senta parlare di mal di pancia più tardi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Bottled valor."
msgstr "Valore imbottigliato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "An impressive elixir."
msgstr "Un elisir notevole."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Not as potent as I would have liked."
msgstr "Non ha la potenza che avrei voluto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "It appears combustible."
msgstr "Sembra essere combustibile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "An ornamental poltergeist meant to be hung somewhere."
msgstr "Un poltergeist ornamentale da appendere da qualche parte."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "A flourish of flying mammal."
msgstr "Un florilegio di un mammifero volante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "An arborator adornment of the arachnid variety."
msgstr "Una arboreto decorativo di una specie di aracnide."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "I really should decorate."
msgstr "Dovrei davvero decorare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "An ornament such as this should be hung up."
msgstr "Una decorazione come questa andrebbe appesa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "A corvus such as this would do better in a tree."
msgstr "Un corvo come questo farebbe la sua bella figura su un albero."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMBAT"
msgid "This was perhaps not the most efficient use of resources."
msgstr "Questo forse non è stato l'uso più efficiente delle risorse."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMMER"
msgid "A worker's tool."
msgstr "Lo strumento di un lavoratore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAMMER_MJOLNIR"
msgid "That looks much too strenuous."
msgstr "Sembra troppo faticoso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HAWAIIANSHIRT"
msgid "I prefer tweed."
msgstr "Preferisco il tweed."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEALINGSALVE"
msgid "A natural disinfectant."
msgstr "Un disinfettante naturale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEALINGSTAFF"
msgid "It is thankless work."
msgstr "È un lavoro ingrato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.COLD"
msgid "It's a bit chilly."
msgstr "È un po' freddo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.FROZEN"
msgid "Its temperature is below freezing."
msgstr "La sua temperatura è sotto lo zero."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.GENERIC"
msgid "Its temperature is totally unremarkable."
msgstr "La sua temperatura è totalmente insignificante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.HOT"
msgid "It is warm enough to radiate heat and light!"
msgstr "È abbastanza caldo per irradiare calore e luce!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HEATROCK.WARM"
msgid "It is retaining thermal energy. But only a bit."
msgstr "Può mantenere l'energia termica. Ma solo un po'."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HIVEHAT"
msgid "It's exuding powerful pheromones."
msgstr "Sta trasudando potenti feromoni."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOME"
msgid "A place to kick up one's feet."
msgstr "Un posto per riposare i piedi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.BURNT"
msgid "Not much of an aid now."
msgstr "Non molto d'aiuto ora."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.GENERIC"
msgid "A navigational aid. \"You are here\"."
msgstr "Un aiuto alla navigazione. \"Tu sei qui\"."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "A chance to give direction."
msgstr "Un'occasione per dare la direzione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEY"
msgid "Sweetened plant nectar."
msgstr "Nettare di piante zuccherato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYCOMB"
msgid "Beeswax used for storing honey."
msgstr "Cera d'api utilizzata per conservare miele."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYHAM"
msgid "Honey was the only sweetener used for this lovely ham."
msgstr "Il miele è l'unico dolcificante usato per questo prosciutto delizioso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HONEYNUGGETS"
msgid "Bite-sized sweetened meat!"
msgstr "Bocconcini di carne zuccherata!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HORN"
msgid "What an excellent specimen! I can almost hear the beefalo."
msgstr "Che esemplare eccellente! Posso quasi sentire il mufalo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOTCHILI"
msgid "Chili gives me indigestion."
msgstr "Il peperoncino mi dà indigestione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUND"
msgid "That hound is not domesticated."
msgstr "Quel segugio non è addomesticato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDBONE"
msgid "The endoskeleton of Canis lupus, definitely not familiaris."
msgstr "L'endoscheletro di canis lupus, sicuramente non familiaris."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDMOUND"
msgid "Those bones are foreboding."
msgstr "Quelle ossa sono cattivi presagi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDSTOOTH"
msgid "Made of calcium and brimstone."
msgstr "È fatto di calcio e zolfo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HOUNDWHISTLE"
msgid "It emits a frequency undetectable to the human ear."
msgstr "Emette una frequenza non percepibile dall'orecchio umano."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH"
msgid "Eons of subterranean evolution went into this widdle malformed monstrosity."
msgstr "Degli eoni di evoluzione sotterranea sono entrati in questa mostruosità malformata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Pygocentrus Nattereri."
msgstr "Pygocentrus nattereri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Mortuus piscis."
msgstr "Mortuus piscis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICE"
msgid "The solid state of water."
msgstr "L'acqua allo stato solido."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEBOX"
msgid "It is a crude heat exchanger."
msgstr "È uno scambiatore di calore grezzo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICECREAM"
msgid "Nothing like a book and a bowl of ice cream."
msgstr "Niente è come un libro e una coppetta di gelato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEHAT"
msgid "A perfect cube of ice."
msgstr "Un cubo di ghiaccio perfetto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEHOUND"
msgid "What a strange, cold beast."
msgstr "Che bestia strana e fredda."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICEPACK"
msgid "Perfectly insulated."
msgstr "Perfettamente isolati."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ICESTAFF"
msgid "Some kind of ice-throwing contraption."
msgstr "Una sorta di aggeggio lanciaghiaccio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "I must be seeing things."
msgstr "Devo avere le allucinazioni."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It appears to be a tiny pyramid."
msgstr "Sembra essere una piccola piramide."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.INSPECTSELF"
msgid "I'm aging like a fine, intelligent wine, am I not?"
msgstr "Sto invecchiando come un vino buono e intelligente, non è vero?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.JAMMYPRESERVES"
msgid "I'd love some toast to put this jam on. Oh well."
msgstr "Avrei voglia di un toast su cui spalmare questa marmellata. Oh, pazienza."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.JELLYBEAN"
msgid "Sweets, emulsified with beeswax."
msgstr "Caramelline, emulsionate con cera d'api."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KABOBS"
msgid "Meat on a stick, what next?"
msgstr "Carne su un bastone, cosa ne seguirà?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KILLERBEE.GENERIC"
msgid "It is especially venomous."
msgstr "È particolarmente velenosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KILLERBEE.HELD"
msgid "It is not pleased."
msgstr "Non è contenta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUS"
msgid "It uses its powerful olfactory sense to locate prey."
msgstr "Utilizza il suo potente olfatto per individuare le prede."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUSSACKKEY"
msgid "Hmm. Quite a sturdy antler."
msgstr "Uhm. Un corno piuttosto robusto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KLAUS_SACK"
msgid "How curious."
msgstr "Che curioso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KNIGHT"
msgid "An automatic equine."
msgstr "Un equino automatico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Its nightmare fueled surroundings have corrupted its programming."
msgstr "La sua ambientazione alimentata dagli incubi sembra aver danneggiato la sua programmazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOALEFANT_SUMMER"
msgid "Koalefanta Proboscidea."
msgstr "Proboscide koalefantesca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KOALEFANT_WINTER"
msgid "Koalefanta Proboscidea in thick winter pelage."
msgstr "Koalefanta proboscidea con uno spesso pellame invernale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KRAMPUS"
msgid "It's a mythological holiday monster."
msgstr "È un mostro mitologico da vacanza."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.KRAMPUS_SACK"
msgid "It seems bigger inside than out."
msgstr "Sembra più grande dentro che fuori."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LANTERN"
msgid "A refuelable light source."
msgstr "Una fonte di luce rigenerabile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "Best for someone on the receiving end of harsh attacks."
msgstr "Molto utile a chi è bersaglio di attacchi feroci."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "I'll leave that to one of the younger folks."
msgstr "La lascio ai giovani."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "Light, but not particularly protective."
msgstr "Leggera ma non particolarmente protettiva."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "The lightweight material grants the wearer better mobility."
msgstr "Il materiale leggero concede a chi la indossa una mobilità migliore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "This ought to prevent grievous harm from befalling the wearer."
msgstr "Questa dovrebbe prevenire il verificarsi di danni severi su chi la indossa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "I can't say it would be much use to me."
msgstr "Non posso dire che sarebbe di gran uso per me."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "A weave of magic replenishes the wearer's will."
msgstr "Un'ondata di magia rifornisce la volontà di chi la indossa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Safety first."
msgstr "La sicurezza prima di tutto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "That banner is invigorating nearby enemies."
msgstr "Quello stendardo rinvigorisce i nemici nelle vicinanze."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BERNIE"
msgid "Fascinating. It is animated, even here."
msgstr "Affascinante. È animato perfino qua."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_BOARLORD"
msgid "He has a chip on his shoulder, though I couldn't say why."
msgstr "Ha la luna storta, ma non saprei dire perché."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Goodness, I've no desire to wear such a thing."
msgstr "Non ho alcun desiderio di indossare una cosa del genere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "It is bound to our service."
msgstr "È legato al nostro servizio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "An enviable magic relic, I must say."
msgstr "Una reliquia magica invidiabile, devo ammettere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "A weak enchantment is present on this wreath."
msgstr "Un incantesimo debole è presente in questa ghirlanda."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "I prefer my books."
msgstr "Preferisco i miei libri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "This will amplify the effects of incoming healing magic."
msgstr "Questo amplificherà gli effetti di una magia curativa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Proximity to the blossoms produces a restorative effect for the user."
msgstr "La vicinanza al bocciolo procura un effetto ristoratore su chi lo usa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "Goodness. I could never lift that!"
msgstr "Bontà. Non potrei mai sollevarla!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It requires a key."
msgstr "Richiede una chiave."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "All ready for activation."
msgstr "Tutto pronto all'attivazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "How brutish."
msgstr "Molto brutale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_LUCY"
msgid "Quite the unusual axe."
msgstr "Un'ascia molto insolita."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "It is linked to our Gateway, but inactive on this side."
msgstr "È collegato al nostro Portale, ma è inattivo da questa parte."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Well, this was an unexpected foray."
msgstr "È stata un'iniziativa inaspettata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "A focal point for magical energies."
msgstr "Il punto focale di energie magiche."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_SPAWNER"
msgid "It seems to facilitate local teleportation."
msgstr "Sembra facilitare il teletrasporto locale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'll leave that to someone a tad more spry."
msgstr "Lo lascerò a qualcuno più arzillo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "This strengthens the wearer's restorative magicks."
msgstr "Questo rafforza le magie ricostituenti di chi lo indossa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE"
msgid "I believe it is a larval dragonfly."
msgstr "Credo sia una larva di libellula."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_COCOON"
msgid "A domestication opportunity, I'd say."
msgstr "Un'opportunità di addomesticamento, direi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "A large macrolecithal egg."
msgstr "Un grande uovo macrolecithal."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "The temperature of this egg is below optimal."
msgstr "La temperatura di questo uovo è sotto quella ottimale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "This egg is at a suitable temperature for hatching."
msgstr "Questo uovo è ad una temperatura adatta per schiudersi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.CONTENT"
msgid "I have to admit it is rather appealing."
msgstr "Devo ammettere che è piuttosto attraente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.GENERIC"
msgid "A healthy larval dragonfly."
msgstr "Una larva di libellula sana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "This creature is hungry."
msgstr "Questa creatura è affamata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_PET.STARVING"
msgid "This creature requires sustenance immediately!"
msgstr "Questa creatura richiede sostentamento nell'immediato!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVAE_TOOTH"
msgid "An egg tooth used by a baby reptile to break out of its egg."
msgstr "Un dente di uovo usato da un rettile bambino per rompere il suo uovo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVASPIT.COOL"
msgid "It's cooled down, almost like basalt."
msgstr "Si è raffreddato, quasi come il basalto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVASPIT.HOT"
msgid "Its saliva is similar to molten lava."
msgstr "La sua saliva è simile alla lava fusa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVA_POND"
msgid "Molten rock. Best not to get too close."
msgstr "Roccia fusa. Meglio non avvicinarsi troppo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LAVA_POND_ROCK"
msgid "Recently cooled igneous rock. Dangerous."
msgstr "Roccia ignea raffreddata da poco. Pericoloso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LEIF"
msgid "I... don't even know."
msgstr "Io... non lo so nemmeno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LEIF_SPARSE"
msgid "I... don't even know."
msgstr "Io... non lo so nemmeno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LICHEN"
msgid "A symbiote! A fungus and a phycobiontic bacteria."
msgstr "Un Simbiotico! Un fungo e un batterio ficobiontico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIFEINJECTOR"
msgid "The mold appears to have medicinal properties."
msgstr "La muffa sembra avere proprietà medicinali."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTBULB"
msgid "Is this animal or vegetable?"
msgstr "Questo è un animale o un vegetale?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTER"
msgid "Ah, a mechanical tool for fire starting. How useful."
msgstr "Ah, uno strumento meccanico per appiccare incendi. Molto utile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Quite keen."
msgstr "Piuttosto appassionata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "A variant of Capra aegagrus, keen on electricity."
msgstr "Una variante della capra aegagrus, appassionata di elettricità."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNINGGOATHORN"
msgid "There must be something unnatural in the horn."
msgstr "Deve esserci qualcosa di innaturale nel corno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Radiant electrical energy!"
msgstr "Energia elettrica radiante!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Highly conductive!"
msgstr "Altamente conduttivo!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LITTLE_WALRUS"
msgid "The juvenile is not as aggressive."
msgstr "Il giovane non è così aggressivo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGLOG"
msgid "This log is special."
msgstr "Questo tronco è speciale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE"
msgid "This tree is special."
msgstr "Questo albero è speciale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE_ROOT"
msgid "The root cutting of a beastly tree."
msgstr "La radice tagliata di un albero bestiale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Ah. Its horror has taken root."
msgstr "Ah. Il suo orrore ha fatto radici."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOG.BURNING"
msgid "An axial section of tree trunk. On fire."
msgstr "Una sezione assiale del tronco d'albero. A fuoco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LOG.GENERIC"
msgid "An axial section of tree trunk."
msgstr "Una sezione assiale del tronco d'albero."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Such a curious shape."
msgstr "Ha una forma così curiosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUCY"
msgid "A perfectly fine looking axe."
msgstr "Un'ascia dall'aspetto perfettamente raffinato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUMPY_SAPLING"
msgid "Perhaps this species is surculose."
msgstr "Forse questa specie è surcolosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANT"
msgid "An invasive plant species."
msgstr "Una specie di pianta invasiva."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.LUREPLANTBULB"
msgid "Now it can be planted wherever is best."
msgstr "Può essere piantato nel posto migliore ora."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MADSCIENCE_LAB"
msgid "Mad science indeed!"
msgstr "Scienza folle, senza dubbio!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MALE_PUPPET"
msgid "Poor boy."
msgstr "Povero ragazzo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE"
msgid "Mandragora officinarum. Deceased."
msgstr "Mandragola officinarum. Defunta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKESOUP"
msgid "Mandragora officinarum, prepared as a soup in the name of discovery."
msgstr "Mandragola officinarum, preparata come una zuppa in nome della scoperta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Mandragora officinarum. But with a face."
msgstr "Mandragola officinarum. Ma con un volto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_COOKED"
msgid "Mandragora officinarum, cooked in the name of discovery."
msgstr "Mandragola officinarum, cucinata in nome della scoperta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANDRAKE_PLANTED"
msgid "Mandragora officinarum."
msgstr "Mandragola officinarum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MANRABBIT_TAIL"
msgid "They use their tails to balance."
msgstr "Usano la loro coda per bilanciarsi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAPSCROLL"
msgid "The potential of the blank page is paralyzing for some."
msgstr "Il potenziale di un foglio vuoto è paralizzante per alcuni."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLE"
msgid "A statuesque rock."
msgstr "Una roccia statuaria."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN"
msgid "Marble growth is arboriculturally impossible."
msgstr "La crescita del marmo è arboricamente impossibile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "I believe it's a perennial."
msgstr "Credo sia una pianta perenne."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLEPILLAR"
msgid "It shows the touch of a Roman artisan. How amazing."
msgstr "Si vede il tocco di un artigiano romano. Davvero stupefacente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLESHRUB"
msgid "Not ideal for topiary."
msgstr "Non è l'ideale per l'arte topiaria."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARBLETREE"
msgid "Amazing. A tree made entirely of marble."
msgstr "Incredibile. Un albero fatto interamente di marmo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Combustion!"
msgstr "Combustione!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A cluster of brambles."
msgstr "Un cespuglio di more."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Picking brambles is dangerous."
msgstr "Raccogliere le more è pericoloso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_PLANT"
msgid "A swamp-dwelling rhizome."
msgstr "Un rizoma delle paludi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNING"
msgid "Combustion!"
msgstr "Combustione!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.BURNT"
msgid "A carbonized mangrove."
msgstr "Una mangrovia carbonizzata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "It has been felled."
msgstr "È stato abbattuto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A mangal rhizophora."
msgstr "Un mangal rhizophora."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELL"
msgid "Get down from there this instant!"
msgstr "Scendi da lì proprio adesso!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLHEAD"
msgid "I wish he wouldn't do that."
msgstr "Vorrei che non lo facesse."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLIGHT"
msgid "How magical!"
msgstr "Che magico!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLLOCK"
msgid "Now I just need a key."
msgstr "Ora ho solo bisogno di una chiave."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "It appears to have no power source."
msgstr "Sembra non avere alcuna fonte di energia."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MAXWELLTHRONE"
msgid "What an intimidating chair."
msgstr "Ma che sedia minacciosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT"
msgid "It's improper to eat it raw, but if we've no choice..."
msgstr "È improprio mangiarla cruda, ma se non abbiamo altra scelta..."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATBALLS"
msgid "A pile of processed meat. Who knows what went into this."
msgstr "Un mucchio di carne trattata. Chissà che cosa ci avranno messo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.BURNT"
msgid "It doesn't seem stable."
msgstr "Non sembra stabile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DONE"
msgid "The process has completed."
msgstr "Il processo è stato completato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYING"
msgid "Dehydration is a slow process."
msgstr "La disidratazione è un processo lento."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "The rain has temporarily halted the dehydration process."
msgstr "La pioggia ha fermato momentaneamente il processo di disidratazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEATRACK.GENERIC"
msgid "Meats can be dehydrated."
msgstr "La carne può essere disidratata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MEAT_DRIED"
msgid "Salty, yet satisfying."
msgstr "Salata, ma soddisfacente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERM"
msgid "A piscean biped!"
msgstr "Un bipede dei pesci!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.BURNT"
msgid "It's neither rotting nor fermenting now."
msgstr "Non è né in putrefazione né in fermentazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHEAD.GENERIC"
msgid "I'm uncertain whether it is rotting or fermenting."
msgstr "Sono incerta se sia in putrefazione o in fermentazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.BURNT"
msgid "On beyond dilapidated."
msgstr "Oltre la fatiscenza."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Obviously dilapidated."
msgstr "Chiaramente dilapidato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINERHAT"
msgid "This would make a great reading light."
msgstr "Potrebbe essere una eccellente luce di lettura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINIFAN"
msgid "Its aerodynamic principals are astonishing."
msgstr "I suoi principi aerodinamici sono sorprendenti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.GENERIC"
msgid "An excellent diagram! Very accurate."
msgstr "Un diagramma eccellente! Molto accurato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN.UNDRAWN"
msgid "A drawn diagram might help keep things tidy."
msgstr "Un diagramma disegnato potrebbe aiutare a mantenere l'ordine."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINISIGN_ITEM"
msgid "Finally, a proper organizational tool."
msgstr "Finalmente, uno strumento organizzativo adeguato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAUR"
msgid "Get away, you beast!"
msgstr "Allontanati, bestia!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURCHEST"
msgid "That chest is absolutely marvelous."
msgstr "Quello scrigno è assolutamente meraviglioso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MINOTAURHORN"
msgid "An amazingly large horn. I wonder if the nightmare helped fuel the growth."
msgstr "Un corno incredibilmente grande. Mi chiedo se l'incubo abbia contribuito ad alimentarne la crescita."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Ah, it's a Talpidae!"
msgstr "Ah, è un talpidae!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.HELD"
msgid "I don't think my pocket is its natural habitat."
msgstr "Non credo che la mia tasca sia il suo habitat naturale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLE.UNDERGROUND"
msgid "Something is tunneling down there."
msgstr "Qualcosa sta scavando un tunnel là sotto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHAT"
msgid "Ah, to look through another creature's, uh, nose!"
msgstr "Ah, guardare attraverso, uh, il naso di un'altra creatura!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOLEHILL"
msgid "The tunnel system must be vast!"
msgstr "Il sistema di tunnel deve essere vasto!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEY"
msgid "They produce quite an odor."
msgstr "Producono un forte odore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONKEYBARREL"
msgid "This appears to be the home of several primates."
msgstr "Sembra essere la casa di molti primati."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERLASAGNA"
msgid "Lasagna or no, it would be hazardous to consume it."
msgstr "Lasagna o no, sarebbe comunque pericoloso consumarla."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT"
msgid "It would be hazardous to consume this."
msgstr "Sarebbe azzardato consumarlo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Salty, yet satisfying."
msgstr "Salata, ma soddisfacente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.BROKEN"
msgid "Ancient debris. Perhaps it can be restored?"
msgstr "Antichi detriti. Forse può essere ripristinato?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.GENERIC"
msgid "The magic of this structure ebbs in predictable cycles."
msgstr "La magia di questa struttura rifluisce in cicli prevedibili."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "The magic of the stone appears to be inexhaustible."
msgstr "La magia della pietra sembra essere inesauribile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.STAFFED"
msgid "Now we must be patient."
msgstr "Adesso dobbiamo essere pazienti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hmm... It seems the staves are not interchangeable."
msgstr "Uhm... pare che le doghe non siano intercambiabili."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.CAVE"
msgid "It appears to lose functionality in subterranean conditions."
msgstr "Sembra perdere funzionalità in condizioni di sottosuolo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.GENERIC"
msgid "Something very odd is going on here."
msgstr "Qualcosa di molto strano sta succedendo qui."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "This cycle of the moon has drawn to a close."
msgstr "Questo ciclo della luna sta volgendo al termine."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "The moon's cycle begins anew."
msgstr "Ricomincia il ciclo della luna."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is waning."
msgstr "La luna è calante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is waxing."
msgstr "La luna è crescente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKCRATER"
msgid "Would make a useful cartographic instrument with proper embellishments."
msgstr "Potrebbe essere un utile strumento di cartografia con degli ornamenti veri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKIDOL"
msgid "Curious. It rather looks like a key."
msgstr "Curioso. Assomiglia a una chiave."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKNUGGET"
msgid "Implications of a lunar body? Interesting."
msgstr "Implicazioni di un corpo lunare? Interessante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCKSEED"
msgid "A floating orb of knowledge."
msgstr "Una sfera di conoscenza fluttuante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOONROCK_PIECES"
msgid "What a perplexing transformation."
msgstr "Una trasformazione che lascia perplessi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE"
msgid "I dub it Alces canadensis."
msgstr "Lo nomino alces canadensis."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSEEGG"
msgid "What a marvel!"
msgstr "Che meraviglia!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "I should like to research its mating habits, someday."
msgstr "Mi piacerebbe fare una ricerca sulle sue abitudini di accoppiamento, un giorno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.GENERIC"
msgid "A thirsty female Haemagogus Devorator."
msgstr "Una femmina assetata di haemagogus devorator."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITO.HELD"
msgid "It is securely stored."
msgstr "È conservata in modo sicuro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSQUITOSACK"
msgid "The stomach of a Culicidae, brimming with blood."
msgstr "Lo stomaco di un culicidae, pieno di sangue."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOSSLING"
msgid "I suppose that's approximately what I expected."
msgstr "Suppongo che è all'incirca quello che mi aspettavo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.DUG"
msgid "A desecrated burial mound."
msgstr "Un tumulo profanato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MOUND.GENERIC"
msgid "A burial mound."
msgstr "Un tumulo di sepoltura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Hmm... This may require further reading."
msgstr "Hmm... questo richiede un ulteriore approfondimento."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Its design is decidedly otherworldly."
msgstr "Il suo design è decisamente dell’altro mondo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Quite functional, it operates as both an axe and a pickaxe."
msgstr "Molto funzionale, funziona come ascia e come piccone."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMBOMB"
msgid "Everyone, give the volatile Agaricus wide berth!"
msgstr "Tutti quanti: state alla larga dal volatile Agaricus!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMHAT"
msgid "Ooo. What a delightfully wizened look."
msgstr "Oooh. Ma che aspetto deliziosamente avvizzito."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "A towering, burnt Agaricus."
msgstr "Un'agaricus imponente e bruciata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "We must destroy that towering Agaricus."
msgstr "Dobbiamo distruggere quell'agaricus arrampicante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Carbonized by an exothermic chemical reaction."
msgstr "Carbonizzato da una reazione chimica esotermica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "It must first be seeded with a cut specimen or fungal spore."
msgstr "Deve prima essere inseminato con un taglio esemplare o con spora fungale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "An excellent fungal yield."
msgstr "Un'ottima resa fungina."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "The state of decomposition is too advanced to support any specimens."
msgstr "Lo stato di decomposizione è troppo avanzato per accogliere qualsiasi esemplare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Its growth has been halted by the extreme cold."
msgstr "La sua crescita è stata interrotta dal freddo estremo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The fungi are fruiting nicely."
msgstr "I funghi stanno facendo frutti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "We ought to pick them before they outgrow their planter."
msgstr "Dovremmo raccoglierli prima che diventino più grandi del tronco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "That was myco-illogical. Ho ho!"
msgstr "È stato mico-illogico. Oh oh!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "A bioluminescent fungus. Neither Agaricales nor Xylariales."
msgstr "Un fungo bioluminescente. Né agaricales e né Xylariales."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Quite enthralling, no?"
msgstr "Piuttosto avvincente, no?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Ahem. I'll be needing a new reading light."
msgstr "Ahem. Avrò bisogno di una nuova luce per la lettura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Basic color theory is a must."
msgstr "La teoria dei colori di base è d'obbligo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Red and blue spores produce lovely reading light when combined."
msgstr "Le spore rosse e blu combinate insieme producono un'incantevole luce per la lettura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "The smell is used to ward off predators."
msgstr "L'odore serve ad allontanare i predatori."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "A red variety of Mycena luxaeterna."
msgstr "Una varietà rossa di mycena luxaeterna."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "The light is caused by a chemical reaction."
msgstr "La luce è creata da una reazione chimica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "My word! A huge Mycena silvaelucens."
msgstr "Mamma mia! Un'enorme mycena silvaelucens."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Apparently it's the breeding season for this species."
msgstr "A quanto pare è la stagione riproduttiva per questa specie."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "A tree with a fungal parasite."
msgstr "Un albero con un fungo parassita."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.MUSHTREE_TALL_WEBBED"
msgid "This relationship appears symbiotic."
msgstr "Questa relazione appare simbiotica."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTLIGHT"
msgid "Curiously luminescent."
msgstr "Curiosamente luminescente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMAREFUEL"
msgid "Ectoplasmic residue."
msgstr "Residui di ectoplasma."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARELIGHT"
msgid "The ancients seem to have used nightmare fuel to power everything."
msgstr "Gli antichi sembra utilizzassero combustibile dell'incubo per alimentare tutto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "The levels of ectoplasmic residue seem to be at their lowest."
msgstr "I livelli di residuo ectoplasmatico sembrano essere al loro livello più basso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "There is very little ectoplasmic residue vapor."
msgstr "C'è davvero poco vapore contenente residuo ectoplasmatico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "There doesn't seem to be any ectoplasmic vapor around here."
msgstr "Non sembra esserci alcun vapore ectoplasmatico qui intorno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The levels of ectoplasmic residue seem to be at their peak."
msgstr "I livelli di residuo ectoplasmatico sembrano essere al loro picco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Levels of ectoplasmic residue are high but seem to be decreasing."
msgstr "I livelli di residuo ectoplasmatico sono alti ma sembrano essere in diminuzione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "There are low, but increasing levels of vapors containing ectoplasmic residue."
msgstr "Ci sono livelli bassi, ma in aumento, di vapori contenenti residuo ectoplasmatico."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "Levels of ectoplasmic residue seem to be increasing."
msgstr "I livelli di residuo ectoplasmatico sembrano essere in aumento."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSTICK"
msgid "I wonder if it's named for Venus?"
msgstr "Mi chiedo se il suo nome derivi da Venere?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NIGHTSWORD"
msgid "Transdimensional weaponry."
msgstr "Armamentario transdimensionale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.NITRE"
msgid "Also known as saltpeter."
msgstr "Anche conosciuto come salnitro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OASISLAKE"
msgid "It could support a small ecosystem."
msgstr "Potrebbe supportare un ecosistema piccolo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ONEMANBAND"
msgid "An impressive improvement to the traditional pipe and tabor."
msgstr "Un miglioramento impressionante della cornamusa tradizionale e del tamburello."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALPRECIOUSGEM"
msgid "A precious light diffracting mineraloid."
msgstr "Una luce preziosa che diffrange il mineraloide."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.OPALSTAFF"
msgid "Appears to summon a cold star into being."
msgstr "Sembra richiamare all'esistenza una stella fredda."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEAMULET"
msgid "The gem fades with each use."
msgstr "La gemma si affievolisce con ogni uso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEGEM"
msgid "It looks like a Spessartite garnet."
msgstr "Sembra un granato di spessartite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGEMOONEYE"
msgid "The fewer search parties we have to organize, the better."
msgstr "Minori sono i gruppi di ricerca da organizzare e meglio sarà."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.ORANGESTAFF"
msgid "Handy over small distances."
msgstr "Utile nelle piccole distanze."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANDORASCHEST"
msgid "An artifact which may contain other artifacts."
msgstr "Un manufatto che può contenere altri manufatti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PANFLUTE"
msgid "Hollow reeds with harmonic resonance."
msgstr "Canna vuota con risonanze armoniche."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PAPYRUS"
msgid "Thin sheets of cellulose and lignin."
msgstr "Sottili fogli di cellulosa e lignina."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEGHOOK"
msgid "A sentient Scorpiones. How odd."
msgstr "Uno scorpiones senziente. Che strano."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PENGUIN"
msgid "What a classy bird."
msgstr "Che pennuto di classe."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERD"
msgid "Nasty Meleagris, you stay away from those berries!"
msgstr "Brutto meleagris, stai lontano dalle mie bacche!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDFAN"
msgid "It's quite lovely."
msgstr "È molto grazioso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.BURNT"
msgid "A carbonized structure."
msgstr "Una struttura carbonizzata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.EMPTY"
msgid "A bush must be placed to attract the Meleagris."
msgstr "Il cespuglio deve essere piazzato per attrarre il meleagris."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PERDSHRINE.GENERIC"
msgid "The native Meleagris flock to it."
msgstr "Il meleagris nativo si riversa in massa su di esso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PEROGIES"
msgid "A wonderfully bland dumpling."
msgstr "Uno gnocco meravigliosamente insipido."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS"
msgid "Now it's a delightful handful of potpourri."
msgstr "Questa è una deliziosa manciata di pot-pourri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETALS_EVIL"
msgid "Interesting. These petals seem to have a mind of their own."
msgstr "Interessante. Questi petali sembrano avere una mente propria."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PETRIFIED_TREE"
msgid "Should make for an excellent building material."
msgstr "Sarebbe un eccellente materiale per la costruzione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PHLEGM"
msgid "The congealed mucus retains its sticky texture."
msgstr "Il muco rappreso mantiene la sua consistenza appiccicosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PICKAXE"
msgid "A specialized axe for chipping away at rocks."
msgstr "Un'ascia specializzata per scalpellare le rocce."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE1"
msgid "He's saturated with markings."
msgstr "È saturo di contrassegni."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE2"
msgid "Rather hot-tempered."
msgstr "Piuttosto irascibile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE3"
msgid "Has an earthy musk to him."
msgstr "Ha un olezzo muschiato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGELITE4"
msgid "I wonder what those green markings signify."
msgstr "Mi chiedo cosa significhino quelle marcature verdi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGUARD"
msgid "One of the warrior caste."
msgstr "Uno della casta dei guerrieri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGGYBACK"
msgid "A face only necessity could love."
msgstr "Un volto che solo il bisogno potrebbe amare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.BURNT"
msgid "It's the charred remains of a head on a stick. Tsk!"
msgstr "Sono i resti carbonizzati di una testa su uno spiedo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHEAD.GENERIC"
msgid "Tut tut. It's a head on a stick."
msgstr "Tut tut. È una testa su un bastone."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.BURNT"
msgid "The house had no fire-prevention system."
msgstr "La casa non aveva alcun sistema di prevenzione degli incendi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.FULL"
msgid "I wonder what they do in there."
msgstr "Mi chiedo che cosa fanno lì."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.GENERIC"
msgid "The pig creatures have such prosaic taste in architecture."
msgstr "Le creature suine hanno un gusto così prosaico in architettura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "That was quite rude."
msgstr "È stato piuttosto scortese."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGKING"
msgid "He appears to be the leader of the village."
msgstr "Sembra essere il capo del villaggio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.DEAD"
msgid "Don't worry, there are plenty more where that came from."
msgstr "Non preoccuparti, ce ne sono molti di più da dove proviene."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.FOLLOWER"
msgid "He seems to have bonded with me."
msgstr "Sembra che si sia affezionato a me."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GENERIC"
msgid "It's a semi-intelligent bipedal pig."
msgstr "È un maiale bipede semi-intelligente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.GUARD"
msgid "It appears to be a guardian."
msgstr "Sembra essere un guardiano."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGMAN.WEREPIG"
msgid "It's a lycanthropic pig."
msgstr "È un maiale licantropo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.BURNT"
msgid "No use to me like this."
msgstr "Non mi serve in questo stato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs a sacrifice of meat."
msgstr "Ha bisogno di un sacrificio di carne."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A Porcine tribute."
msgstr "Un tributo suino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGSKIN"
msgid "The haunch of a semi-intelligent bipedal pig."
msgstr "La coscia di maiale bipede semi-intelligente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTENT"
msgid "Filthy."
msgstr "Sudicio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIGTORCH"
msgid "I wonder how it's fueled."
msgstr "Mi chiedo come sia alimentata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PIG_TOKEN"
msgid "How did they could achieve such detail using pig hooves?"
msgstr "Come hanno fatto a raggiungere una tale minuziosità con quegli zoccoli da maiale?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE"
msgid "Conifer seeds encased in a mature strobilus."
msgstr "Semi di conifere racchiusi in uno strobilo maturo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PINECONE_SAPLING"
msgid "Conifer seeds approaching maturity."
msgstr "Semi di conifere vicini alla maturità."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PITCHFORK"
msgid "Its design is effective at loosening earth."
msgstr "Il suo design è efficace a allentare il terreno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT"
msgid "The plant produced a meaty substance."
msgstr "La pianta ha prodotto una sostanza carnosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANTMEAT_COOKED"
msgid "This looks much safer for consumption."
msgstr "Questo sembra molto più sicuro per il consumo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "It's a... plant. Of some kind."
msgstr "È una... pianta. Di qualche tipo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It is not yet ready for harvest."
msgstr "Non è ancora pronto per il raccolto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.READY"
msgid "It looks mature, now."
msgstr "Sembra maturo, ora."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It couldn't survive the heat."
msgstr "Non poteva sopravvivere al calore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.ATTACKER"
msgid "That no good %s is up to no good."
msgstr "Quel nulla di buono di %s non sta facendo nulla di buono."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.FIRESTARTER"
msgid "%s, what have I told you about lighting fires?"
msgstr "%s, cosa ti ho detto riguardo all'appiccare incendi?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GENERIC"
msgid "Ah, greetings dear %s!"
msgstr "Ah, saluti cara %s!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.GHOST"
msgid "Poor dear. %s needs a heart to anchor them to this plane."
msgstr "Povero caro. %s ha bisogno di un cuore per ancorarsi a questo piano."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.MURDERER"
msgid "I'll erase you from the history books!"
msgstr "Ti cancellerò dai libri di storia!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PLAYER.REVIVER"
msgid "I appreciate your commitment to group survival, %s."
msgstr "Apprezzo il tuo impegno per la sopravvivenza di gruppo, %s."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE"
msgid "Punica granatum. Watery, sweet and a bit sour."
msgstr "Punica granatum. Acquosa, dolce e acidula."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_COOKED"
msgid "Punica granatum is so nice when it's warmed up."
msgstr "La punica granatum è così buona quando è riscaldata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Seeds of Punica granatum, separated from their arils."
msgstr "Semi di punica granatum, separati dai loro arilli."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND"
msgid "A small but deep freshwater pond."
msgstr "Uno stagno d'acqua dolce piccolo ma profondo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POND_ALGAE"
msgid "It is a good thing this algae has no need for photosynthesis."
msgstr "È una buona cosa che queste alghe non abbiano bisogno della fotosintesi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POOP"
msgid "A quantity of animal feces. How fragrant."
msgstr "Una quantità di feci animali. Che fragranza."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POTTEDFERN"
msgid "A potted plant."
msgstr "Una pianta nel vaso."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.POWCAKE"
msgid "The crowning achievement of the agricultural-industrial complex."
msgstr "Il fiore all'occhiello del complesso agricolo-industriale."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN"
msgid "Cucurbita pepo."
msgstr "Cucurbita pepo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKINCOOKIE"
msgid "Pumpkin biscuits, goody!"
msgstr "Biscotti di zucca, buoni!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_COOKED"
msgid "Cooked Cucurbita pepo. Gooey and delicious."
msgstr "Cucurbita pepo cotta. Sdolcinata e deliziosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_LANTERN"
msgid "Carving the Cucurbita pepo is such a nice pastime."
msgstr "Intagliare la cucurbita pepo è un bel passatempo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PUMPKIN_SEEDS"
msgid "Pepitas."
msgstr "Pepite."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEAMULET"
msgid "I can almost sense it beckoning to something."
msgstr "Posso quasi sentirlo attrarre qualcosa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEGEM"
msgid "It gives off a strange aura."
msgstr "Emana una strana aura."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.PURPLEMOONEYE"
msgid "A tool to mark our whereabouts."
msgstr "Uno strumento per segnare le nostre camminate."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "That should tide it over while I prepare our next dish."
msgstr "Questo dovrebbe sistemare le cose mentre preparo il prossimo piatto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "What is this \"Gnaw\", I wonder?"
msgstr "Cos'è questo \"Masticatore\", mi chiedo?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "A nice enough bollard."
msgstr "Un paletto molto carino."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Something in the Hedera family."
msgstr "Fa parte della famiglia dell'edera."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Impressive in scope."
msgstr "Impressionante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Decrepit statuary."
msgstr "Statuario decrepito."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "A gruesome gargoyle."
msgstr "Una gargolla raccapricciante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Years past its life expectancy."
msgstr "Molti anni oltre la sua aspettativa di vita."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Those berries need time to grow back. Time I don't have."
msgstr "Quelle bacche hanno bisogno di tempo per ricrescere. Un tempo che non ho."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "There are so many uses for a bowl."
msgstr "Ci sono tanti usi per una ciotola."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Mutated seed of Daucus carota."
msgstr "Granello mutato di carota daucus."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I do love a good casserole."
msgstr "Adoro una buona casseruola."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "Enough for one."
msgstr "Abbastanza per me."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN1"
msgid "Worth a paltry sum to the locals."
msgstr "Vale una bella somma per i residenti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN2"
msgid "A coin of some denomination."
msgstr "Una moneta di qualche denominazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN3"
msgid "A coin of some value."
msgstr "Una moneta di un certo valore."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_COIN4"
msgid "It's made of a sort of condensed magic."
msgstr "È fatto di una specie di magia condensata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Raw Paralithodes meat."
msgstr "Carne di paralithodes cruda."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It no longer presents a threat of salmonellosis."
msgstr "Non presenta più una minaccia di salmonellosi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "For trapping sea creatures."
msgstr "Per intrappolare le creature del mare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FERN"
msgid "This species of fern is edible."
msgstr "Questa specie di felce è commestibile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Ground Triticum aestivum grain."
msgstr "Grano di triticum aestivum sminuzzato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "I believe we could have prepared it better."
msgstr "Credo che avremmo potuta prepararla meglio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I suppose it's ready for the altar."
msgstr "Immagino sia pronto per l'altare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "The exact thing to placate the great wyrm."
msgstr "Proprio quello che ci vuole per sfamare il grande dragone."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the correct food, although an insufficient amount."
msgstr "È il cibo giusto, malgrado la porzione sia insufficiente."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Not the proper dish for the great wyrm."
msgstr "Non esattamente il piatto adatto per il grande dragone."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Completely carbonized."
msgstr "Completamente carbonizzato."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Edible bulb of Allium cepa."
msgstr "Bulbo commestibile di allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Roast Allium cepa."
msgstr "Allium cepa arrosto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Mutated seed of Allium cepa."
msgstr "Granello mutato di allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATKID"
msgid "A sweet bipedal Bovidae adolescent."
msgstr "Un tenero adolescente bovidae bipede."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "I shan't question its origins."
msgstr "Non indagherò sulle sue origini."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Perhaps she would be willing to barter."
msgstr "Forse sarebbe disposta a contrattare."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL"
msgid "Perhaps some barbeque is in order."
msgstr "Forse qualche grigliata è di dovere."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "It needs to be on the ground."
msgstr "Deve essere a terra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Smaller than normal, but it'll do."
msgstr "Più piccolo del normale, ma andrà bene."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "I need to put it down somewhere to use it."
msgstr "Ho bisogno di metterlo da qualche parte per usarlo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_HOE"
msgid "It can be used to till fertile soil."
msgstr "Può essere utilizzato per arare il terreno fertile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY"
msgid "I shall have to see what this unlocks."
msgstr "Dovrò vedere cosa sblocca."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "I believe this is for the park."
msgstr "Credo che sia per il parco."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "What is it powered by, I wonder?"
msgstr "Da cosa è alimentato, mi chiedo?"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "It's a nice enough light."
msgstr "È una luce carina."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "For mechanically powdering our ingredients."
msgstr "Per polverizzare meccanicamente i nostri ingredienti."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Home of the local piscean bipeds."
msgstr "Casa dei bipedi piscean locali."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Reminds me of my bookmobile days."
msgstr "Mi ricorda i giorni della biblioteca mobile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "There are wares within."
msgstr "Ci sono articoli all'interno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "I'm not familiar with the species, though it is edible."
msgstr "Non ho dimestichezza con la specie, anche se è commestibile."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "A wild cluster of edible mushrooms."
msgstr "Un ammasso selvaggio di funghi commestibili."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "I don't think they'll grow back."
msgstr "Non credo che ricresceranno."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION"
msgid "Allium sativum, a close relative of Allium cepa."
msgstr "Allium sativum, un parente stretto dell'allium cepa."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Roast Allium sativum."
msgstr "Allium sativum arrostito."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Mutated seed of Allium sativum."
msgstr "Granello mutato di allium sativum."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN"
msgid "It is best suited to baking sweets."
msgstr "È più adatto a infornare dolci."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "All the parts are necessary to construct a fully functional oven."
msgstr "Tutte le parti sono necessarie per costruire un forno completamente operativo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Wrought iron, it seems."
msgstr "Ferro battuto, così sembra."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Quite an interesting sculpture."
msgstr "Una scultura piuttosto interessante."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Rather ghoulish monument."
msgstr "Monumento piuttosto macabro."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "A pity. I always enjoyed a good fountain."
msgstr "Un peccato. Apprezzo sempre una buona fontana."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "We should have full access now."
msgstr "Dovremmo avere l'accesso completo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It needs a key to open."
msgstr "Ha bisogno di una chiave per aprirsi."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "I wish I could read the writing."
msgstr "Vorrei poter leggere la scritta."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "I wonder who's ashes those are."
msgstr "Mi chiedo di chi siano queste ceneri."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "I should like to study its shell more closely."
msgstr "Vorrei studiare più da vicino il suo guscio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Deceased."
msgstr "Deceduto."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "An agreeable member of the Columbidae family."
msgstr "Un membro gradevole della famiglia columbidae."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It has entered the REM stage of sleep."
msgstr "È entrato nella fase REM."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "I did miss proper dishware."
msgstr "Mi mancano le stoviglie formali."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It is a natural spring of sodium-infused water."
msgstr "È una sorgente naturale di acqua infusa di sodio."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL"
msgid "My suspicions were correct. It has more than one destination."
msgstr "I miei sospetti erano corretti. Ha più di una destinazione."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Quite an elaborate key."
msgstr "Una chiave piuttosto elaborata."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POT"
msgid "A larger pot takes longer to boil."
msgstr "Una pentola più grande ci mette più tempo a bollire."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.QUAGMIRE_POTATO"
