msgstr "Uno di meno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.GENERIC"
msgid "Mhm. It's a tree."
msgstr "Uhm. È un albero."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELL"
msgid "Well, you're a tall piece of work."
msgstr "Beh, sei un pezzo d'uomo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLHEAD"
msgid "You don't scare me."
msgstr "Non mi spaventi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLLIGHT"
msgid "How does that even work?"
msgstr "Come fa a funzionare?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MAXWELLLOCK"
