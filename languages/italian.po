msgstr "Andato in fiamme."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.BURNT"
