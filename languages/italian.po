msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Webber."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wendy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wendy"
msgid "This Gladiator Chest contains Wendy's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Wendy."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wes
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wes"
msgid "This Gladiator Chest contains Wes' complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Wes."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wickerbottom
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wickerbottom"
msgid "This Gladiator Chest contains Wickerbottom's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Wickerbottom."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_willow
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_willow"
msgid "This Gladiator Chest contains Willow's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Willow."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wilson
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wilson"
msgid "This Gladiator Chest contains Wilson's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Wilson."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_winona
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_winona"
msgid "This Gladiator Chest contains Winona's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Winina."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wolfgang
