msgstr "Non è fatta di gattorsetti, per fortuna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6"
msgid "Not sure anyone should eat those."
msgstr "Non credo si possano mangiare."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7"
msgid "That's just regular food."
msgstr "È un cibo normale."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8"
msgid "How spooky."
msgstr "Molto inquietante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9"
msgid "Real gelatinous."
msgstr "Molto gelatinosa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY"
