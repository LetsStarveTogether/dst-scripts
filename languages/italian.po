#. STRINGS.SKIN_DESCRIPTIONS.pack_character_wortox
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_character_wortox"
msgid "This Wortox Chest contains the playable character, Wortox: The Soul Starved, as well as Wortox's complete set of Survivor skin items."
msgstr "Questo Scrigno di Wortox contiene il personaggio giocabile Wortox: il Mangia Anime così come il set completo degli articoli estetici del sopravvissuto di Wortox."

#. STRINGS.SKIN_DESCRIPTIONS.pack_factory_items
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_factory_items"
msgid "This Voxola Warehouse Chest contains the following skin items: Factory Signpost, Pipe Fencing, Factory Portrait, and Factory Signpost Icon."
msgstr "Questo Scrigno del Magazzino della Voxola contiene i seguenti articoli estetici: Insegna della fabbrica, Recinzione di tubi, Ritratto della fabbrica e l'Icona dell'insegna della fabbrica."

#. STRINGS.SKIN_DESCRIPTIONS.pack_forge_armor
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_forge_armor"
msgid "This chest contains all 16 Forge collection armor and headgear skin items."
msgstr "Questo scrigno contiene tutti e 16 gli articoli estetici della collezione della Forgia e dei copricapo."

#. STRINGS.SKIN_DESCRIPTIONS.pack_forge_weapons
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_forge_weapons"
msgid "This chest contains all 7 Forge collection weapons skin items."
msgstr "Questo scrigno contiene tutti e 7 gli articoli estetici delle armi della collezione della Forgia."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_all
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_all"
msgid "This Gladiator Chest contains every survivor's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di tutti i sopravvissuti."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wathgrithr
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_wathgrithr"
msgid "This Gladiator Chest contains Wigfrid's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Wigfrid."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_waxwell
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_waxwell"
msgid "This Gladiator Chest contains Maxwell's complete set of Gladiator skin items."
msgstr "Questo Scrigno del Gladiatore contiene il set completo degli articoli estetici del Gladiatore di Maxwell."

#. STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_webber
msgctxt "STRINGS.SKIN_DESCRIPTIONS.pack_gladiator_webber"
