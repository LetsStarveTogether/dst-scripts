msgstr "Non sembra così duro adesso."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CHESSPIECE_DEERCLOPS"
