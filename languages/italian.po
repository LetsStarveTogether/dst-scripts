msgstr "Sembra fragile."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MARSH_TREE.CHOPPED"
